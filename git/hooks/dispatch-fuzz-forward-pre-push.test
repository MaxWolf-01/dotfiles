#!/usr/bin/env bash
# Drive dispatch-fuzz-forward-pre-push through real pushes and check when it
# runs `dispatch push`, and where. Run it directly; no framework.
#
# The hook is wired as nix/home/common.nix wires it, as a config hook, in
# throwaway repos with no global or system config. `dispatch` is a fake on PATH
# that records the checkout it ran in.

set -uo pipefail

hook="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/dispatch-fuzz-forward-pre-push"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 HOME="$tmp/home"
mkdir -p "$HOME" "$tmp/bin"

record="$tmp/dispatch-ran"
cat >"$tmp/bin/dispatch" <<EOF
#!/bin/sh
echo "\$(pwd) \$*" >>"$record"
EOF
chmod +x "$tmp/bin/dispatch"
export PATH="$tmp/bin:$PATH"

repo="$tmp/repo"
git init -q --bare "$tmp/origin.git"
git init -q --bare "$tmp/host.git"
g() { git -C "$repo" "$@"; }
git init -q -b master "$repo"
g config user.name test
g config user.email test@example.com
g config hook.fuzz-forward.event pre-push
g config hook.fuzz-forward.command "$hook"
g remote add origin "$tmp/origin.git"
g remote add pc "$tmp/host.git"
g commit -q --allow-empty -m a
g branch side

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# a new commit on <branch>, pushed from <dir> to <remote>; prints the push's exit status
push() { # <dir> <remote> <branch>
    git -C "$1" commit -q --allow-empty -m "on $3"
    git -C "$1" push -q "$2" "$3" 2>"$tmp/stderr"
    echo $?
}
said() { grep -c 'fuzz run:' "$tmp/stderr"; }
# the hook forwards in the background, so a run it started may still be on its way
ran() {
    for _ in $(seq 50); do [ -s "$record" ] && break; sleep 0.1; done
    cat "$record" 2>/dev/null
    rm -f "$record"
}

# --- a repo with no fuzz run passes straight through

check "an undesignated repo pushes" 0 "$(push "$repo" origin master)"
check "and nothing is said" 0 "$(said)"

g config dispatch.fuzz.host pc
g config dispatch.fuzz.branch master

# --- the fuzzed branch to origin is forwarded, from the checkout that has it out

check "the fuzzed branch pushes to origin" 0 "$(push "$repo" origin master)"
check "and dispatch push runs in its checkout" "$repo push" "$(ran)"

g worktree add -q "$tmp/wt" side
g commit -q --allow-empty -m "on master, pushed from the worktree"
git -C "$tmp/wt" push -q origin master 2>"$tmp/stderr"
check "a push of it from a worktree on another branch" 0 $?
check "runs dispatch push where master is out" "$repo push" "$(ran)"

# --- everything else is not forwarded

check "another branch pushes to origin" 0 "$(push "$tmp/wt" origin side)"
check "and is not forwarded" 0 "$(said)"
check "the fuzzed branch pushed to the host's remote, as dispatch does" 0 "$(push "$repo" pc master)"
check "is not forwarded again" 0 "$(said)"

# --- what cannot be forwarded is said, and the push still lands

g commit -q --allow-empty -m "before the detach"
g switch -q --detach
g push -q origin master 2>"$tmp/stderr"
check "with no checkout holding the fuzzed branch, the push lands" 0 $?
check "and says so" 1 "$(grep -c 'no checkout has master out' "$tmp/stderr")"
g switch -q master

only_git=$(mktemp -d)
ln -s "$(command -v git)" "$only_git/git"
g commit -q --allow-empty -m "PATH down to git"
PATH=$only_git "$only_git/git" -C "$repo" push -q origin master 2>"$tmp/stderr"
check "with PATH down to git, the push lands" 0 $?
check "and says dispatch is missing" 1 "$(grep -c 'dispatch is not on PATH' "$tmp/stderr")"
rm -rf "$only_git"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
    exit 0
fi
echo "$failures check(s) failed"
exit 1
