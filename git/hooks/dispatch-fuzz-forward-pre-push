#!/bin/sh
# pre-push hook, for every repo on the machine: a push of a repo's fuzzed
# branch to origin goes on to its fuzz host as well, where it restarts the fuzz
# run on the new tip (`dispatch fuzz --help`). Wired as a config hook in
# nix/home/common.nix. A repo with no fuzz run designated passes straight
# through.
#
# `dispatch push` carries the branch of both repos to the host, in the
# background: a host that does not answer is written to the log and costs the
# push nothing. Nothing waits for origin to take the push first, as
# mx-plugin-update-pre-push does; the host fuzzes the tip pushed from here
# either way.
#
# To stop pushes restarting the run: `dispatch fuzz stop` removes the host's
# restart hook, so a push forwarded after it lands there and restarts nothing.
# `dispatch fuzz clean` forgets the host, and then nothing is forwarded.
#
# /bin/sh, and exit 0 whatever happens, as claude-session-trailer: a caller that
# narrows PATH still pushes.

# dispatch's own pushes go to the host's remote; forwarding those would loop.
[ "$1" = origin ] || exit 0
branch=$(git config dispatch.fuzz.branch) || exit 0
forward=
while read -r local_ref _ _ _; do
    [ "$local_ref" = "refs/heads/$branch" ] && forward=1
done
[ -n "$forward" ] || exit 0

host=$(git config dispatch.fuzz.host)
command -v dispatch >/dev/null ||
    { echo "fuzz run: dispatch is not on PATH, so $branch did not reach $host; \`dispatch push\` from $branch sends it" >&2; exit 0; }
# dispatch pushes the branch its checkout has out, which need not be this one.
checkout=$(git worktree list --porcelain |
    awk -v b="branch refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0==b{print w; exit}')
[ -n "$checkout" ] ||
    { echo "fuzz run: no checkout has $branch out, so it did not reach $host; \`dispatch push\` from $branch sends it" >&2; exit 0; }

LOG="$HOME/logs/dispatch-fuzz-forward.log"
mkdir -p "$HOME/logs"
(
    echo "=== $(date -Is) $checkout: $branch to $host ==="
    cd "$checkout" && dispatch push
) >>"$LOG" 2>&1 &
echo "fuzz run: $branch going to $host too (log: $LOG)" >&2
exit 0
