#!/bin/bash
# Pre-push hook for the agents repo: after the push lands, tell pc to pull the
# new mx plugin version, so dispatch workers there run the skills you just shipped.
#
# `claude plugin update` is version-gated — it re-copies only when
# mx/.claude-plugin/plugin.json carries a version the installed one doesn't have.
# Pushing skill edits without `make release-patch` is therefore a no-op here.

HOST=pc
LOG="$HOME/logs/mx-plugin-update.log"

[ "$(hostname)" = "$HOST" ] && exit 0

mkdir -p "$HOME/logs"

# Git has no post-push hook, so wait for the push this hook precedes to finish
# before pc fetches the marketplace. Detached: the push never waits on ssh.
(
    sleep 20
    echo "=== $(date -Is) updating mx@MaxWolf-01 on $HOST ==="
    if ! ssh -o ConnectTimeout=10 "$HOST" claude plugin marketplace update MaxWolf-01; then
        echo "marketplace update failed — is $HOST up, and is claude installed there?"
        exit 1
    fi
    ssh -o ConnectTimeout=10 "$HOST" claude plugin update mx@MaxWolf-01
) >>"$LOG" 2>&1 &
disown

echo "mx plugin update on $HOST queued (log: $LOG)"
exit 0
