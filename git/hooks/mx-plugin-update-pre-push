#!/usr/bin/env bash
# Pre-push hook for the agents repo: after the push lands, update the mx plugin
# in every profile on this machine (~/.claude and, where provisioned,
# ~/.claude-helferline), so local sessions load the version you just shipped.
#
# `claude plugin update` is version-gated: without a `make release-*` bump in
# the push, the update is a no-op.
#
# Worker hosts are deliberately not updated from here. Dispatch pulls the
# plugin itself, once, at setup -- the only point where one version can be
# pinned for a whole run. Updating on push instead mutates the plugin cache
# under workers that are already running and load their skills lazily.

set -uo pipefail

LOG="$HOME/logs/mx-plugin-update.log"
mkdir -p "$HOME/logs"

# Git has no post-push hook, so poll (with backoff) until the commit this push
# carries is live on the remote before fetching the marketplace — a fixed sleep
# races GitHub, and a rejected push should update nothing. Detached: the push
# never waits on this. Pre-push stdin: <local ref> <local sha> <remote ref>
# <remote sha> per ref; one ref per push here (master).
# Runs with the caller's CLAUDE_CONFIG_DIR: callers set or unset it per
# profile. Pinning the default profile to ~/.claude is NOT equivalent to
# unset — claude then expects its state at ~/.claude/.claude.json instead
# of ~/.claude.json and spawns a divergent stub there.
update_profile() {
    echo "=== $(date -Is) updating mx@MaxWolf-01 in ${CLAUDE_CONFIG_DIR:-~/.claude (default)} ==="
    if claude plugin marketplace update MaxWolf-01 && claude plugin update mx@MaxWolf-01; then
        version=$(claude plugin list | grep -A1 'mx@MaxWolf-01' | sed -n 's/.*Version: //p')
        echo "installed version: ${version:-UNREADABLE -- \`claude plugin list\` no longer parses}"
    else
        echo "update failed"
    fi
}

remote_url="$2"
read -r _ local_sha remote_ref _ || true

(
    if [ -z "${local_sha:-}" ] || [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        echo "=== $(date -Is) no commit pushed (ref delete?) -- skipping update ==="
        exit 0
    fi
    landed=""
    for delay in 5 10 20 40 80; do
        sleep "$delay"
        if [ "$(git ls-remote "$remote_url" "$remote_ref" | cut -f1)" = "$local_sha" ]; then
            landed=1
            break
        fi
    done
    if [ -z "$landed" ]; then
        echo "=== $(date -Is) $local_sha never appeared on $remote_url $remote_ref -- push failed or GitHub is slow; run \`claude plugin update mx@MaxWolf-01\` manually ==="
        exit 0
    fi
    ( unset CLAUDE_CONFIG_DIR; update_profile )
    [ -d "$HOME/.claude-helferline" ] && ( export CLAUDE_CONFIG_DIR="$HOME/.claude-helferline"; update_profile )
) >>"$LOG" 2>&1 &
disown

echo "mx plugin update queued (log: $LOG)"
exit 0
