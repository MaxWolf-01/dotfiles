#!/usr/bin/env bash
# Pre-push hook for the agents repo: after the push lands, update the mx plugin
# here and on the default worker host ($MX_WORKER_HOST), so dispatch workers and
# local sessions load the version you just shipped.
#
# `claude plugin update` is version-gated: without a `make release-*` bump in
# the push, both updates are no-ops.

set -uo pipefail

LOG="$HOME/logs/mx-plugin-update.log"
mkdir -p "$HOME/logs"

update_on() {
    local run=("$@")
    "${run[@]}" claude plugin marketplace update MaxWolf-01 || return 1
    "${run[@]}" claude plugin update mx@MaxWolf-01
}

# Git has no post-push hook, so wait for the push this hook precedes to land
# before fetching the marketplace. Detached: the push never waits on this.
(
    sleep 20
    echo "=== $(date -Is) updating mx@MaxWolf-01 ==="
    update_on env || echo "local update failed"
    if [ -n "${MX_WORKER_HOST:-}" ] && [ "$(hostname)" != "$MX_WORKER_HOST" ]; then
        update_on ssh -o ConnectTimeout=10 "$MX_WORKER_HOST" \
            || echo "update on $MX_WORKER_HOST failed -- is it up, with claude installed?"
    fi
) >>"$LOG" 2>&1 &
disown

echo "mx plugin update queued (log: $LOG)"
exit 0
