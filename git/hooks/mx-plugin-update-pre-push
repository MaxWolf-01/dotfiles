#!/usr/bin/env bash
# Pre-push hook for the agents repo: after the push lands, update the mx plugin
# in every profile on this machine (~/.claude and, where provisioned,
# ~/.claude-helferline), so local sessions load the version you just shipped.
#
# `claude plugin update` is version-gated: without a `make release-*` bump in
# the push, the update is a no-op.
#
# Worker hosts are deliberately not updated from here. Dispatch pulls the
# plugin itself, once, at setup -- the only point where one version can be
# pinned for a whole run. Updating on push instead mutates the plugin cache
# under workers that are already running and load their skills lazily.

set -uo pipefail

LOG="$HOME/logs/mx-plugin-update.log"
mkdir -p "$HOME/logs"

# Git has no post-push hook, so wait for the push this hook precedes to land
# before fetching the marketplace. Detached: the push never waits on this.
update_profile() {
    export CLAUDE_CONFIG_DIR="$1"
    echo "=== $(date -Is) updating mx@MaxWolf-01 in $CLAUDE_CONFIG_DIR ==="
    if claude plugin marketplace update MaxWolf-01 && claude plugin update mx@MaxWolf-01; then
        version=$(claude plugin list | grep -A1 'mx@MaxWolf-01' | sed -n 's/.*Version: //p')
        echo "installed version: ${version:-UNREADABLE -- \`claude plugin list\` no longer parses}"
    else
        echo "update failed"
    fi
}

(
    sleep 20
    update_profile "$HOME/.claude"
    [ -d "$HOME/.claude-helferline" ] && update_profile "$HOME/.claude-helferline"
) >>"$LOG" 2>&1 &
disown

echo "mx plugin update queued (log: $LOG)"
exit 0
