#!/usr/bin/env bash
# Pre-push hook for the agents repo: after the push lands, sync the mx plugin on
# the machine that runs dispatch workers ($MX_WORKER_HOST), so those workers load
# the skills you just pushed.
#
# Same trick as `ccupdate` locally: pull the agents clone there and rsync mx/
# into the plugin cache. `claude plugin update` would be the official route, but
# it compares plugin.json versions rather than commits, so it ships nothing
# unless the version moved -- and skill edits shouldn't need a release to reach
# your own machines. `make release-*` in the agents repo is for the public
# marketplace, where the version is all anyone else has to go on.

set -uo pipefail

HOST="${MX_WORKER_HOST:-}"
AGENTS=repos/github/MaxWolf-01/agents
INSTALLED=.claude/plugins/installed_plugins.json
LOG="$HOME/logs/mx-plugin-update.log"

[ -n "$HOST" ] || exit 0
[ "$(hostname)" = "$HOST" ] && exit 0

mkdir -p "$HOME/logs"

# Git has no post-push hook, so wait for the push this hook precedes to land
# before pulling it on the far side. Detached: the push never waits on ssh.
(
    sleep 20
    echo "=== $(date -Is) syncing mx to $HOST ==="

    if ! ssh -o ConnectTimeout=10 "$HOST" git -C "$AGENTS" pull --ff-only; then
        echo "pull failed -- is $HOST up, and is the agents repo cloned at ~/$AGENTS?"
        exit 1
    fi

    cache=$(ssh -o ConnectTimeout=10 "$HOST" jq -r '.plugins["mx@MaxWolf-01"][0].installPath' "$INSTALLED")
    if [ -z "$cache" ] || [ "$cache" = null ]; then
        echo "no mx install path in ~/$INSTALLED on $HOST -- run: claude plugin i mx@MaxWolf-01"
        exit 1
    fi

    ssh -o ConnectTimeout=10 "$HOST" rsync -a --delete "$AGENTS/mx/" "$cache/"
    echo "synced mx -> $cache"
) >>"$LOG" 2>&1 &
disown

echo "mx sync to $HOST queued (log: $LOG)"
exit 0
