#!/bin/sh
# prepare-commit-msg hook, for every repo on the machine: a commit written from
# inside a Claude Code session carries `Session: <id>`, so the commit can be
# traced to the session that made it. Wired as a config hook in
# nix/home/common.nix.
#
# A message that already has a Session trailer keeps it, which is what an
# amend, a squash or a rebase replaying a commit hands us. A missing trailer
# must never cost a commit, so this exits 0 whatever happens, and it is /bin/sh
# rather than a bash found on PATH: a caller that narrows PATH still commits.

[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || exit 0
git interpret-trailers --in-place --if-exists doNothing \
    --trailer "Session: $CLAUDE_CODE_SESSION_ID" "$1" 2>/dev/null
exit 0
