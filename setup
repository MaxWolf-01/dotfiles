#!/usr/bin/env bash

DOTFILES="$HOME/.dotfiles"

# Override sudo when running as root
if [ "$EUID" -eq 0 ]; then
    sudo() {
        "$@"
    }
fi

host() {
    local name="${1:-$(hostname)}"
    if [ ! -f "$DOTFILES/nix/home/hosts/$name.nix" ]; then
        echo "No config for '$name'. Available: $(ls "$DOTFILES/nix/home/hosts/" | sed 's/\.nix$//' | tr '\n' ' ')"
        return 1
    fi

    # --- Set NIX_HOST (only needed when hostname doesn't match flake config name) ---
    if [ "$name" != "$(hostname)" ]; then
        touch ~/.local_exports
        if grep -q 'NIX_HOST=' ~/.local_exports 2>/dev/null; then
            sed -i "s/export NIX_HOST=.*/export NIX_HOST=\"$name\"/" ~/.local_exports
        else
            echo "export NIX_HOST=\"$name\"" >> ~/.local_exports
        fi
        echo "NIX_HOST=$name (overrides hostname '$(hostname)')"
    else
        echo "Hostname matches config name, no NIX_HOST override needed"
    fi

    # --- NixOS: done here, use nswitch ---
    if [ -f /etc/NIXOS ]; then
        echo "Done (NixOS). Run nswitch to apply."
        return
    fi

    # --- Non-NixOS: install Nix + first HM switch ---
    mkdir -p ~/applications
    link nix/nix.conf ~/.config/nix/nix.conf

    sudo apt-get update
    sudo apt-get install -y \
      build-essential \
      curl \
      gcc

    sudo mkdir -p /usr/local/bin
    sudo ln -sf ~/bin/* /usr/local/bin/

    if ! command -v nix &> /dev/null; then
        sh <(curl -L https://nixos.org/nix/install) --daemon --yes
        echo "Nix installed. Restart your shell, then re-run: ./setup host $name"
        return
    fi

    if ! grep -q 'min-free' /etc/nix/nix.conf 2>/dev/null; then
        echo -e '\nmin-free = 16106127360\nmax-free = 32212254720' | sudo tee -a /etc/nix/nix.conf
    fi
    if ! grep -q 'trusted-users' /etc/nix/nix.conf 2>/dev/null; then
        echo "trusted-users = $USER" | sudo tee -a /etc/nix/nix.conf
    fi
    sudo systemctl restart nix-daemon

    touch ~/.zshrc
    nix run home-manager/master -- switch --flake ~/.dotfiles#"$NIX_HOST"
    if [ ! -f /etc/NIXOS ]; then
        grep -qxF "$HOME/.nix-profile/bin/zsh" /etc/shells || echo "$HOME/.nix-profile/bin/zsh" | sudo tee -a /etc/shells
        sudo chsh -s "$HOME/.nix-profile/bin/zsh" "$USER"
    fi
}

gpu() {
    local script="$HOME/.nix-profile/bin/non-nixos-gpu-setup"
    if [ -x "$script" ]; then
        sudo "$script"
    else
        echo "non-nixos-gpu-setup not found. Run hmswitch first."
    fi
}

ubuntu() {
  sudo apt-get update

  # System-level packages not available via Nix/HM
  sudo apt-get install -y \
    firejail \
    libfuse2 \
    ubuntu-drivers-common

  if ! command -v tailscale &> /dev/null; then
    curl -fsSL https://tailscale.com/install.sh | sh
  fi

  # NVIDIA drivers (auto-detects correct version)
  sudo ubuntu-drivers install

  # Codecs, fonts, restricted formats
  echo ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true | sudo debconf-set-selections
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y ubuntu-restricted-extras

  # Enable unprivileged user namespaces for Electron app sandboxing
  # Ubuntu 23.10+ uses AppArmor to restrict userns per-app; disable that restriction
  if [ ! -f /etc/sysctl.d/60-apparmor-namespace.conf ]; then
    echo 'kernel.apparmor_restrict_unprivileged_userns=0' | sudo tee /etc/sysctl.d/60-apparmor-namespace.conf
    sudo sysctl --system
  fi

  # zswap: compressed pool in RAM in front of the swapfiles. Ships disabled with
  # the lzo compressor; zstd roughly triples what the pool holds. NixOS hosts get
  # this from boot.zswap.*; here systemd-tmpfiles writes the sysfs knobs at boot.
  if [ ! -f /etc/tmpfiles.d/zswap.conf ]; then
    sudo tee /etc/tmpfiles.d/zswap.conf > /dev/null <<'EOF'
w /sys/module/zswap/parameters/compressor       - - - - zstd
w /sys/module/zswap/parameters/max_pool_percent - - - - 25
w /sys/module/zswap/parameters/shrinker_enabled - - - - Y
w /sys/module/zswap/parameters/enabled          - - - - Y
EOF
    sudo systemd-tmpfiles --create /etc/tmpfiles.d/zswap.conf
  fi

  # Disable screenshot sound
  if [ -f "/usr/share/sounds/freedesktop/stereo/camera-shutter.oga" ]; then
    sudo mv /usr/share/sounds/freedesktop/stereo/camera-shutter.oga /usr/share/sounds/freedesktop/stereo/camera-shutter-disabled.oga
  fi

  # Remove bloat (brltty grabs USB serial devices)
  sudo apt-get remove -y orca brltty

  # Disable unattended services these machines don't use. All reversible with
  # systemctl enable --now. Kept on purpose: ubuntu-insights (anonymous census,
  # worth giving back), apport (local crash dumps in /var/crash — only the
  # upload timer is disabled below).
  sudo systemctl disable --now ModemManager.service       # cellular modems; these machines have none
  sudo systemctl disable --now cups.service cups.socket cups.path cups-browsed.service  # no printers configured; enable cups the day one appears
  sudo systemctl disable --now avahi-daemon.service avahi-daemon.socket  # mDNS discovery; here it only fed cups-browsed
  sudo systemctl disable --now motd-news.timer apport-autoreport.timer
  [ -f /etc/default/motd-news ] && sudo sed -i 's/^ENABLED=1/ENABLED=0/' /etc/default/motd-news

  # fwupd metadata refresh ships hourly; firmware moves weekly at best
  sudo mkdir -p /etc/systemd/system/fwupd-refresh.timer.d
  sudo tee /etc/systemd/system/fwupd-refresh.timer.d/weekly.conf > /dev/null <<'EOF'
[Timer]
OnCalendar=
OnCalendar=weekly
EOF
  sudo systemctl daemon-reload

  # snapd: nothing left that nix doesn't provide. Purge + hold so an apt
  # dependency can't quietly bring it back.
  if command -v snap &> /dev/null; then
    # leaf snaps refuse to go before their bases' dependents do — loop until empty
    for _ in 1 2 3; do
      for s in $(snap list 2>/dev/null | awk 'NR>1 && $1!="snapd" {print $1}'); do
        sudo snap remove --purge "$s" 2>/dev/null
      done
    done
    sudo apt-get purge -y snapd
    sudo apt-mark hold snapd
    sudo rm -rf /var/cache/snapd /snap
    rm -rf ~/snap
  fi

  # Remove system Firefox install script so HM Firefox takes precedence
  if [ -d /usr/lib/firefox ]; then
    sudo mv /usr/lib/firefox /usr/lib/firefox.bak
    echo "Moved /usr/lib/firefox → /usr/lib/firefox.bak (HM Firefox takes priority)"
  fi

  # btop from source for GPU support (nixpkgs btop-cuda can't see system NVIDIA drivers)
  # Must use system compiler — Nix's c++ produces binaries with Nix's ld-linux,
  # which can't dlopen system libs like libnvidia-ml.so at runtime.
  if ! command -v btop &> /dev/null; then
    git clone --depth 1 https://github.com/aristocratos/btop.git /tmp/btop
    make -C /tmp/btop CXX=/usr/bin/g++ -j"$(nproc)"
    sudo make -C /tmp/btop install
    rm -rf /tmp/btop
  fi

  # https://github.com/ahkohd/oyo
  cargo install oyo

  # Keep systemd user timers alive after logout (backups, etc.)
  loginctl enable-linger "$USER"

  ssh_harden
  bt_sudoers

  echo "Run './setup gpu' after reboot to set up Nix GPU driver symlinks."
}

# Passwordless bluetoothd restart for bin/bt-audio-fix (recovers Bluetooth audio
# stuck without A2DP). NixOS hosts would get this via security.sudo.extraRules.
bt_sudoers() {
  echo "$USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart bluetooth" | sudo tee /etc/sudoers.d/bt-audio-fix > /dev/null
  sudo chmod 440 /etc/sudoers.d/bt-audio-fix
  sudo visudo -c -f /etc/sudoers.d/bt-audio-fix
}

# todo https://github.com/nix-community/nix-on-droid-app
android() {
  # https://android.stackexchange.com/a/185949
  pkg update && pkg upgrade
  pkg install python gh fastfetch git-lfs zsh vim htop openssh
  git lfs install

  # Key-only sshd (mirrors ssh_harden). Termux password auth would only work after
  # `passwd` anyway — never set one. Start with `sshd`, listens on 8022.
  mkdir -p "$PREFIX/etc/ssh/sshd_config.d"
  printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' > "$PREFIX/etc/ssh/sshd_config.d/10-key-only.conf"

  ln -sf ~/storage/shared/repos ~/repos  # can't do it the other way round without root
  obsidian_vault mobile shallow
  git config --global --add safe.directory ~/storage/shared/repos/obsidian/knowledge-base

  chsh -s zsh # set zsh as default shell

  # TODO: fuzzy_finder function was removed, fzf now via nix
  curl -LsSf https://astral.sh/uv/install.sh | sh

  echo "source ~/.dotfiles/zsh/android" >> ~/.zshrc
}

docker() {
    curl -fsSL https://get.docker.com -o get-docker.sh
    sudo sh ./get-docker.sh
    sudo usermod -a -G docker $USER
    rm get-docker.sh
    echo "Reboot to apply changes"
}

nvidia_container_toolkit() {
    # Enables Docker containers to use NVIDIA GPUs (--runtime=nvidia / --gpus all)
    # Requires: NVIDIA drivers installed, Docker installed
    if ! command -v nvidia-smi &> /dev/null; then
        echo "Error: NVIDIA drivers not installed (nvidia-smi not found)"
        return 1
    fi
    if ! command -v docker &> /dev/null; then
        echo "Error: Docker not installed"
        return 1
    fi

    echo "Installing NVIDIA Container Toolkit..."

    curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | \
        sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg --yes

    curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
        sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
        sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list

    sudo apt-get update
    sudo apt-get install -y nvidia-container-toolkit

    sudo nvidia-ctk runtime configure --runtime=docker
    sudo systemctl restart docker

    echo "Verifying GPU access in container..."
    docker run --rm --gpus all nvidia/cuda:12.6.3-base-ubuntu24.04 nvidia-smi
}

copyous() {
  # GNOME clipboard manager. Imperative because it downloads highlight.js + ~200
  # per-language assets at runtime via its own prefs UI; missing assets SIGSEGV
  # gnome-shell (kills Wayland session). Stays out of HM/Nix.

  sudo apt-get update
  sudo apt-get install -y gir1.2-gda-5.0 gir1.2-gsound-1.0

  # Installs from the MaxWolf-01 fork: upstream renders full entry content in
  # preview cards, freezing gnome-shell for seconds on open (boerdereinar/copyous#150).
  # Drop the fork once the preview-cap patch is merged upstream.
  local ver="2.0.1-max2"
  local zip="/tmp/copyous-${ver}.zip"
  curl -fL -o "$zip" "https://github.com/MaxWolf-01/copyous/releases/download/v${ver}/copyous@boerdereinar.dev.zip"
  gnome-extensions install -f "$zip"
  rm "$zip"

  gsettings set org.gnome.shell disable-user-extensions false

  cat <<'EOF'

Copyous installed. Next steps:
  1. Log out and back in (Wayland needs to cold-load the extension; live-loading
     before deps are downloaded crashes the shell).
  2. Run: gnome-extensions prefs copyous@boerdereinar.dev
     Click through the dependencies wizard to download highlight.js + languages.
  3. Run: gnome-extensions enable copyous@boerdereinar.dev
  4. Open clipboard with Super+Shift+V.
EOF
}

get_vibetyper() {
    # Speech-to-text app. Auto-updates and creates its own desktop entries on launch.
    wget -O "$HOME/applications/VibeTyper.AppImage" "https://cdn.vibetyper.com/releases/linux/VibeTyper.AppImage"
    chmod +x "$HOME/applications/VibeTyper.AppImage"
}

