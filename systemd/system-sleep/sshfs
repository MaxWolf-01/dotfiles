#!/usr/bin/env bash
# Drop every sshfs mount before the machine sleeps.
#
# No sshfs mount survives a suspend. NetworkManager takes the network down as
# part of entering sleep, and the ssh connection dies with it. What is left is a
# mount whose server never answers, and a process reading it waits in
# uninterruptible sleep. The kernel cannot freeze such a task, so it aborts the
# suspend after 20 seconds, and the machine stays awake with the mount still
# there for the next attempt to trip over. On 2026-09-10 a backup over sshfs
# held this laptop in a loop of failed suspends until it was powered off by hand.
#
# ServerAliveInterval (nix/home/common.nix) does not cover this on its own: ssh
# needs 45 seconds of running time to declare the peer dead, and the repeated
# freeze attempts do not leave it that long.
#
# systemd-sleep(8) runs this as root with "pre" before the freeze, and again
# with "post" after resume, which is nothing to do here.

set -uo pipefail

[ "${1:-}" = pre ] || exit 0

# The lazy unmount detaches the tree so nothing new can block on it. Only sshfs
# exiting frees the readers already waiting inside, hence both.
mapfile -t mounts < <(awk '$3 == "fuse.sshfs" { print $2 }' /proc/mounts)
for mnt in "${mounts[@]}"; do
    umount -l "$mnt" || true
done
pkill -x sshfs || true

echo "sshfs sleep hook: ${#mounts[@]} mount(s) dropped"
