{
  "permissions": {
    "allow": [
      "mcp__rime",
      "Bash(git clone *)",
      "Bash(tailscale serve *)",
      "Bash(tailscale version *)",
      "Bash(lsusb)",
      "Read(//proc/asound/**)",
      "Bash(arecord -l)",
      "Bash(wpctl status *)",
      "Bash(claude --version)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "outputStyle": "max",
  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": false
  },
  "spinnerTipsEnabled": false,
  "prefersReducedMotion": true
}
