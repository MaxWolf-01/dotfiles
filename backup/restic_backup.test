#!/usr/bin/env bash
# Drive backup/restic_backup.sh against throwaway repos and check what it does
# with a repository probe that fails. Run it directly; no framework.
#
# A failed `restic cat config` has four meanings: the target is unreachable, the
# repository is genuinely absent, the repository is fine but locked, or
# something else is wrong. Only the second may initialise a repository, only the
# fourth may wake anybody.
#
# It also checks the credential the sftp repos need before any of that: an agent
# holding no key is a precondition that has not arrived yet, not a failure.

set -uo pipefail

script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/restic_backup.sh"

work=$(mktemp -d)

# Its own agent and its own key: the sftp cases below reach ssh, and the script
# skips before it gets there when the agent is empty, so a test that borrowed
# whatever the caller's session happens to hold would pass or skip by accident.
eval "$(ssh-agent -a "$work/agent.sock" -s)" >/dev/null
agent_pid=$SSH_AGENT_PID
trap 'rm -rf "$work"; kill "$agent_pid" 2>/dev/null' EXIT
ssh-keygen -q -t ed25519 -N "" -C restic-backup-test -f "$work/key"
ssh-add "$work/key" 2>/dev/null

export HOME="$work/home"          # keeps ~/logs/backup out of the real home
export RUN_LOG_DIR="$work/runs"
export SOPS_AGE_KEY_FILE="$work/age-key.txt"
export PATH="$work/stub:$PATH"    # curl stub, so a test never sends mail
mkdir -p "$HOME" "$work/stub" "$work/src"
touch "$SOPS_AGE_KEY_FILE"
printf 'testpw\n' >"$work/pw"
head -c 100000 /dev/urandom >"$work/src/a.bin"
echo "src" >"$work/dirs.txt"

# Alerts go through the real bin/alert-send: HOME is redirected, so its default
# config path lands on this throwaway channel, and the curl underneath it is a
# stub that decodes the subject and body of what would have been submitted.
mkdir -p "$HOME/.dotfiles/secrets/monitoring"
cat >"$HOME/.dotfiles/secrets/monitoring/alert.conf" <<'CONF'
smtp_url="smtp://localhost:587"
smtp_user="test@example.invalid"
password_command="echo test-token"
mail_from="test@example.invalid"
mail_to="test@example.invalid"
CONF

cat >"$work/stub/curl" <<'STUB'
#!/usr/bin/env bash
msg="" prev=""
for a in "$@"; do
    [ "$prev" = "--upload-file" ] && msg="$a"
    prev="$a"
done
[ -n "$msg" ] && [ -f "$msg" ] || exit 0
sed -n 's/^Subject: =?UTF-8?B?\(.*\)?=$/\1/p' "$msg" | base64 -d >> "$ALERTS_SENT"
echo >> "$ALERTS_SENT"
awk '/^Content-Transfer-Encoding: base64$/{f=1;next} f&&/^$/{b=1;next} b&&/^--/{exit} b{print}' "$msg" \
    | base64 -d >> "$ALERTS_SENT"
echo "---" >> "$ALERTS_SENT"
STUB
chmod +x "$work/stub/curl"
export ALERTS_SENT="$work/alerts.log"
: >"$ALERTS_SENT"

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# Every case is a config file under its own directory, because the script names
# the run log's unit after "<directory>-<file>".
write_config() {  # $1 unit dir, $2 repo path
    mkdir -p "$work/$1"
    cat >"$work/$1/case.conf" <<CONF
repo_path="$2"
password_command="cat $work/pw"
backup_dirs_file="$work/dirs.txt"
base_path="$work"
compression="auto"
keep_last="1"
keep_daily="1"
keep_weekly="1"
keep_monthly="1"
CONF
}

# Echoes the exit code; the run's own output lands in a file, because the call
# below happens inside a command substitution and a variable would not survive it.
run_case() {  # $1 unit dir
    "$script" "$work/$1/case.conf" >"$work/out.txt" 2>&1
    echo $?
}

last_line() {  # $1 unit
    tail -1 "$RUN_LOG_DIR/$1-case.jsonl" 2>/dev/null
}

# --- 1. unreachable: nothing listening on the port

write_config unreachable "sftp://max@127.0.0.1:2222//tmp/does-not-matter"
check "refused connection exits 0" 0 "$(run_case unreachable)"
line=$(last_line unreachable)
check "refused connection is a skip" skip "$(jq -r .outcome <<<"$line")"
check "its reason names unreachability and the cause" \
    "yes" \
    "$(jq -r 'if .reason | test("^target unreachable:.*[Cc]onnection refused") then "yes" else .reason end' <<<"$line")"
check "nothing was sent" "" "$(cat "$ALERTS_SENT")"

# --- 2. unreachable: the name does not resolve

write_config dns "sftp:nosuchhost.invalid:restic-test"
check "unresolvable host exits 0" 0 "$(run_case dns)"
check "unresolvable host is a skip" skip "$(jq -r .outcome <<<"$(last_line dns)")"
check "still nothing sent" "" "$(cat "$ALERTS_SENT")"

# --- 3. reachable target, no repository yet: the init path is untouched

write_config missing "$work/fresh-repo"
check "a missing repository still runs to a green backup" 0 "$(run_case missing)"
check "it was initialised" "yes" "$([ -f "$work/fresh-repo/config" ] && echo yes || cat "$work/out.txt")"
check "the run is logged ok" ok "$(jq -r .outcome <<<"$(last_line missing)")"
check "a green run sends nothing" "" "$(cat "$ALERTS_SENT")"

# --- 4. an existing repository under an exclusive lock left by a dead run
#
# The real shape: the laptop suspends mid-check, the sftp connection dies, and
# the abandoned run's lock stays. Reproduced by keeping the lock file a real
# prune wrote and putting it back afterwards.

repo="$work/fresh-repo"
write_config locked "$repo"
restic --repo "$repo" --password-command "cat $work/pw" prune >/dev/null 2>&1 &
pruner=$!
lock=""
deadline=$(( $(date +%s) + 30 ))
while [ "$(date +%s)" -lt "$deadline" ]; do
    lock=$(ls "$repo/locks/" 2>/dev/null | head -1)
    [ -n "$lock" ] && { cp "$repo/locks/$lock" "$work/stale.lock"; break; }
done
wait $pruner
check "a lock file was captured to replay" "yes" "$([ -s "$work/stale.lock" ] && echo yes || echo no)"
cp "$work/stale.lock" "$repo/locks/$lock"

check "a locked repository backs up anyway" 0 "$(run_case locked)"
check "and is never reported as an init failure" \
    "" \
    "$(grep -o 'Failed to initialize restic repository' "$work/out.txt")"
check "the locked run is logged ok" ok "$(jq -r .outcome <<<"$(last_line locked)")"
check "a locked repository sends nothing" "" "$(cat "$ALERTS_SENT")"

# --- 5. an error of any other kind keeps its rich failure

write_config badinit "/proc/no/such/place/repo"
check "an uncreatable repository exits 1" 1 "$(run_case badinit)"
check "it is logged fail" fail "$(jq -r .outcome <<<"$(last_line badinit)")"
check "and it notifies, naming the unit in the subject" \
    "yes" \
    "$(grep -q 'badinit-case - Backup Failed' "$ALERTS_SENT" && echo yes || cat "$ALERTS_SENT")"
check "and the run log says the alert was delivered" \
    "delivered" \
    "$(jq -r .stats.alert <<<"$(last_line badinit)")"

# --- 6. the boundary: an ssh that fails for a reason of its own
#
# A reachable host that rejects the key is a person's problem, so it must come
# out the other end as a failure with its notification, not as a skip. Driven
# against this host's own sshd with a user that does not exist. The ssh config
# is the test's, because the script runs with HOME pointing here; nixpkgs' restic
# is a wrapper that puts its own openssh first on PATH, so a stub ssh cannot be
# reached and ssh has to be steered by configuration instead.

if ss -ltn 2>/dev/null | grep -q ':22 '; then
    mkdir -p "$HOME/.ssh"
    cat >"$HOME/.ssh/config" <<'SSHCONF'
Host *
    BatchMode yes
    PreferredAuthentications publickey
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
SSHCONF
    chmod 600 "$HOME/.ssh/config"
    : >"$ALERTS_SENT"
    write_config denied "sftp://nosuchuser@127.0.0.1//tmp/does-not-matter"
    check "a rejected key exits 1" 1 "$(run_case denied)"
    check "a rejected key is a failure, not a skip" fail "$(jq -r .outcome <<<"$(last_line denied)")"
    check "a rejected key notifies" \
        "yes" \
        "$(grep -q 'denied-case' "$ALERTS_SENT" && echo yes || cat "$ALERTS_SENT")"
    check "a rejected key is reported as what it is, not as a failed init" \
        "yes" \
        "$(jq -r 'if .reason | test("^could not open repository") then "yes" else .reason end' \
           <<<"$(last_line denied)")"
else
    echo "skip the rejected-key case: nothing is listening on port 22 here"
fi


# --- 7. an sftp repository while the agent holds no key
#
# The state of every fresh boot until the passphrase is typed. It must cost
# nothing: no ssh attempt, no init, no notification — just a skip that says which
# credential is missing, so backup-catchup.target can run it again later.

: >"$ALERTS_SENT"
write_config keyless "sftp://max@127.0.0.1:2222//tmp/does-not-matter"
saved_sock="$SSH_AUTH_SOCK"
empty_agent="$work/empty-agent.sock"
eval "$(ssh-agent -a "$empty_agent" -s)" >/dev/null
empty_agent_pid=$SSH_AGENT_PID

SSH_AUTH_SOCK="$empty_agent"
check "an empty agent exits 0" 0 "$(run_case keyless)"
line=$(last_line keyless)
check "an empty agent is a skip" skip "$(jq -r .outcome <<<"$line")"
check "and the skip names the key, not the network" \
    "ssh agent holds no key" "$(jq -r .reason <<<"$line")"
check "an empty agent sends nothing" "" "$(cat "$ALERTS_SENT")"
kill "$empty_agent_pid" 2>/dev/null

# --- 8. no agent at all
#
# Never expected: ssh-agent.service is unconditional on every host, and the units
# name its socket. So it is a broken session rather than a credential in transit,
# and it is the one credential case that wakes somebody.

: >"$ALERTS_SENT"
write_config noagent "sftp://max@127.0.0.1:2222//tmp/does-not-matter"
SSH_AUTH_SOCK="$work/there-is-no-agent-here"
check "a missing agent exits 1" 1 "$(run_case noagent)"
check "a missing agent is a failure" fail "$(jq -r .outcome <<<"$(last_line noagent)")"
check "a missing agent notifies" \
    "yes" \
    "$(grep -q 'noagent-case - Backup Failed' "$ALERTS_SENT" && echo yes || cat "$ALERTS_SENT")"

# --- 9. a local repository does not need an agent at all
#
# The gate keys on the repo being sftp:. Still no agent here, and the backup runs.

: >"$ALERTS_SENT"
write_config localrepo "$work/fresh-repo"
check "a local repository backs up with no agent" 0 "$(run_case localrepo)"
check "and is logged ok" ok "$(jq -r .outcome <<<"$(last_line localrepo)")"
check "and sends nothing" "" "$(cat "$ALERTS_SENT")"
SSH_AUTH_SOCK="$saved_sock"

# --- 10. a probe that fails for a reason restic cannot call "missing"
#
# An unreadable config is a repository that plainly exists. Initialising over it
# would fail and blame a cause that was never true, which is what an empty agent
# used to be reported as. It must fail on its own terms and never reach init.

: >"$ALERTS_SENT"
write_config unreadable "$work/unreadable-repo"
restic init --repo "$work/unreadable-repo" --password-command "cat $work/pw" >/dev/null 2>&1
chmod 000 "$work/unreadable-repo/config"
check "an unreadable config exits 1" 1 "$(run_case unreadable)"
check "it is logged fail" fail "$(jq -r .outcome <<<"$(last_line unreadable)")"
check "the reason names opening the repository, not initialising it" \
    "yes" \
    "$(jq -r 'if .reason | test("^could not open repository") then "yes" else .reason end' \
       <<<"$(last_line unreadable)")"
check "no init was attempted" "" "$(grep -o 'Initializing restic repository' "$work/out.txt")"
check "it notifies" \
    "yes" \
    "$(grep -q 'unreadable-case - Backup Failed' "$ALERTS_SENT" && echo yes || cat "$ALERTS_SENT")"
chmod 644 "$work/unreadable-repo/config"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
else
    echo "$failures check(s) failed"
    exit 1
fi
