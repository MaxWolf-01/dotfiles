export EDITOR="${commands[nvim]:-vim}"
export SOPS_EDITOR="$HOME/bin/sops-editor"

export PATH=~/bin:${PATH}
export PATH=~/.local/bin:${PATH}
export PATH=~/.claude/local:${PATH}
export PATH=~/.dotfiles/secrets/bin:${PATH}
export PATH=/usr/local/bin:${PATH}
export PATH=$PATH:$HOME/go/bin
export PATH=~/.cargo/bin:${PATH}
export PATH=~/.nix-profile/bin:${PATH}

export KITTY_CONFIG_DIRECTORY=~/.dotfiles/kitty

# Make Python use UTF-8 encoding for output to stdin, stdout, and stderr. (Redundant as of Python 3?)
export PYTHONIOENCODING='UTF-8'

export FZF_COMPLETION_TRIGGER='**'

export HYDRA_FULL_ERROR=1

export PYTHONBREAKPOINT=ipdb.set_trace
export PYTHONSTARTUP=~/.pythonrc

# A tmpfs page leaves RAM only by going to swap, and it holds that swap slot
# for as long as the file exists — so scratch left in a tmpfs /tmp is memory
# nothing but deletion can reclaim. /var/tmp is on the root filesystem, which
# has no size cap of its own: a runaway build fills the disk rather than the
# swap device.
#
# Guarded because /tmp is a tmpfs only where systemd's tmp.mount is enabled.
# Elsewhere the move would buy nothing and only extend retention 10d → 30d.
# Shells only; the graphical session keeps the default, and vibe-typer, the
# one GUI app that unpacks anything large, sets its own in its unit.
[[ "$(</proc/mounts)" == *" /tmp tmpfs "* ]] && export TMPDIR=/var/tmp

[[ -f ~/.local_exports ]] && source ~/.local_exports

