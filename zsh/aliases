# GPU mode switching. Logout-based switching is broken in supergfxctl <= 5.2.7
# on systemd 257+: its logind check chokes on the new "manager" session class
# ("manager is an invalid variant" spam in `journalctl -u supergfxd`) and times
# out, so the mode never changes — https://gitlab.com/asus-linux/supergfxctl/-/issues/173
# Workaround: the sed pre-seeds /etc/supergfxd.conf, which supergfxd applies at
# boot — so REBOOT (not logout) after running these.
# Note (GU603ZW): USB-C DP is wired to the iGPU, so external monitors over
# USB-C work in Integrated mode; only the HDMI port needs the dGPU (Hybrid).
alias gpu-off='supergfxctl -m Integrated && sudo sed -i '\''s/"mode": "Hybrid"/"mode": "Integrated"/'\'' /etc/supergfxd.conf'
alias gpu-on='supergfxctl -m Hybrid && sudo sed -i '\''s/"mode": "Integrated"/"mode": "Hybrid"/'\'' /etc/supergfxd.conf'

