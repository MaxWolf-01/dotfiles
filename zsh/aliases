yoink-tube() {
  local repo=~/repos/code/yapit-tts/yapit
  # YouTube blocks VPN/datacenter IPs (the reason this runs locally and not on
  # hetzner) — bypass the Mullvad exit node for the fetch, restore on any exit
  trap 'tailscale set --exit-node=auto:any --exit-node-allow-lan-access=true' EXIT
  tailscale set --exit-node=
  make -C "$repo" self-host >/dev/null
  until curl -fsS http://localhost/api/health >/dev/null 2>&1; do sleep 1; done
  YAPIT_BASE_URL=http://localhost command yapit fetch -o ~/Documents/library --ai "$@"
  make -C "$repo" self-host-down >/dev/null
}

# Mullvad exit node (via tailscale; needs operator grant, no sudo)
# vpn-on = bin/vpn-pick: auto:any, then verify the node isn't Cloudflare-blocked
# (blocked node = Discord/Electron apps 403 while browsers work); pins a clean
# node only when needed. Captive portals: run `portal` (bin/).
alias vpn-on="vpn-pick"
alias vpn-off="tailscale set --exit-node="  # recovery: works offline, restores direct egress
alias vpn-where="curl -s https://am.i.mullvad.net/json | jq '{ip, country, city, mullvad_exit_ip, mullvad_exit_ip_hostname}'"

vpn-list() {  # all countries+cities; vpn-list <country> for that country's nodes
  if [[ -n "$1" ]]; then tailscale exit-node list --filter="$1"; return; fi
  tailscale exit-node list | awk '/mullvad\.ts\.net/ {
    sub(/^ *[0-9.]+ +[a-z0-9-]+\.mullvad\.ts\.net +/, ""); sub(/ +- *$/, "");
    if ($0 !~ / Any$/ && $0 != "") print
  }' | sort -u
}

vpn-to() {  # vpn-to Sweden | vpn-to 'New York' | vpn-to us-nyc-wg-301.mullvad.ts.net
  local node="$1"
  if [[ "$node" != *.mullvad.ts.net ]]; then
    node=$(tailscale exit-node list --filter="$1" | awk '/mullvad\.ts\.net/ {print $2; exit}')
    [[ -n "$node" ]] || { echo "no exit node matching '$1' (see: tailscale exit-node list)"; return 1; }
  fi
  tailscale set --exit-node="$node" --exit-node-allow-lan-access=true
  echo "exit node pinned: $node (auto-failover off — vpn-on to restore)"
}

