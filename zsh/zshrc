[[ -n "$ZPROF" ]] && zmodload zsh/zprof

source ~/.dotfiles/zsh/aliases
source ~/.dotfiles/zsh/exports
source ~/.dotfiles/zsh/functions
source ~/.dotfiles/zsh/plugins
source ~/.dotfiles/zsh/zsh_config
# A pane pc's tmux server restored at boot (tmux.nix) has nobody at it, and the keys
# arriving are the resume command resurrect types; secrets/zshrc prompts only when stdin is
# a terminal. Unset here, so the shells this one starts are not marked.
if [ -n "${TMUX_RESTORED_AT_BOOT-}" ]; then
  unset TMUX_RESTORED_AT_BOOT
  if [ -f ~/.dotfiles/secrets/zshrc ]; then source ~/.dotfiles/secrets/zshrc </dev/null; fi
elif [ -f ~/.dotfiles/secrets/zshrc ]; then source ~/.dotfiles/secrets/zshrc; fi
source ~/.dotfiles/zsh/plugin-files/mytheme.zsh-theme
source "$HOME/.dotfiles/zsh/plugin-files/zoxide-autocd.zsh"

# disable terminal flow control (can press ctrl+s without freezing it)
stty -ixon

# clipse tui clipboard manager
if command -v clipse &> /dev/null; then
  (clipse --listen &> /dev/null &)
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

[[ -n "$ZPROF" ]] && zprof

