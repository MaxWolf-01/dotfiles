# Delayed command execution using sleep
doin() {
    local time_spec="$1"
    shift
    local cmd="$*"
    
    if [[ -z "$cmd" ]]; then
        echo "Usage: doin <time> <command>"
        echo "Time examples: 10 (seconds), 5m (minutes), 2h (hours)"
        echo "Examples:"
        echo "  doin 5 echo 'Hello after 5 seconds'"
        echo "  doin 1h shutdown -h now"
        return 1
    fi
    
    echo "Scheduling: '$cmd' to run after $time_spec"
    (sleep "$time_spec" && eval "$cmd") &
    local pid=$!
    echo "Running in background (PID: $pid)"
    echo "Use 'kill $pid' to cancel"
}

loadenv() {
  set -a
  source "${1:-.env}"
  set +a
}

# Switch restic context so restic-snaps, restic-diff, etc. target the right repo.
# Usage: restic-ctx <name> [backend]   (backend defaults to rsyncnet)
#        restic-ctx                     (show current context)
restic-ctx() {
  local conf_dir="$HOME/.dotfiles/secrets/backup/restic"
  if [[ -z "${1:-}" ]]; then
    echo "Repository: ${RESTIC_REPOSITORY:-not set}"
    echo "Password:   ${RESTIC_PASSWORD_COMMAND:-not set}"
    echo ""
    echo "Available: $(ls "$conf_dir" | tr '\n' ' ')"
    return
  fi
  local name="$1"
  local backend="${2:-rsyncnet}"
  local conf="$conf_dir/$name/$backend.conf"
  [[ -f "$conf" ]] || { echo "Not found: $conf" >&2; return 1; }

  source "$conf"

  export RESTIC_REPOSITORY="$repo_path"
  export RESTIC_PASSWORD_COMMAND="$password_command"
  export RESTIC_CTX="$name-$backend"
  echo "→ $name/$backend ($repo_path)"
}

_restic-ctx() {
  local conf_dir="$HOME/.dotfiles/secrets/backup/restic"
  if (( CURRENT == 2 )); then
    _describe 'backup name' "($(ls "$conf_dir"))"
  elif (( CURRENT == 3 )); then
    local backends=("${(@f)$(ls "$conf_dir/$words[2]"/*.conf 2>/dev/null | xargs -I{} basename {} .conf)}")
    _describe 'backend' backends
  fi
}
compdef _restic-ctx restic-ctx

# Shutdown and wake after N hours (default 8) via RTC
sleepfor() {
    local hours=${1:-8}
    sudo rtcwake -m off -s $((hours * 3600))
}

discord() {
    /usr/bin/discord "$@" &
    disown
}
