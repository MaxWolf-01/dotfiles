#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Hold bin/prompt-waits' prompt table to the prompts it is for. Run it directly; no framework.

The table decides from a pane's foreground program and its last lines, the cursor's line last, whether the pane waits
on a prompt and of what kind. The prompt lines are the programs' own: the ones the ticket quotes, and the ones sudo,
sudo-rs, ssh, ssh-add, ykman, age-plugin-yubikey and bw print.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from check import bin_module, check, finish  # noqa: E402

pw = bin_module("prompt-waits")


def waits(program, *lines):
    prompt = pw.prompt_in(program, list(lines))
    return prompt and prompt.kind


# --- a prompter waiting on its prompt

for program, line, kind in [
    ("sudo", "[sudo] password for max: ", "password"),
    ("sudo", "[sudo: authenticate] Password: ", "password"),
    ("ssh", "max@pc's password: ", "password"),
    ("ssh", "Enter passphrase for key '/home/max/.ssh/id_ed25519': ", "passphrase"),
    ("ssh", "Enter PIN for ED25519-SK key /home/max/.ssh/id_ed25519_sk: ", "pin"),
    ("ssh-add", "Enter passphrase for /home/max/.ssh/id_ed25519: ", "passphrase"),
    ("ykman", "Enter PIN: ", "pin"),
    ("age-plugin-yubikey", "Enter PIN for YubiKey with serial 40771133 (default is 123456): ", "pin"),
    ("bw", "? Master password: [input is hidden] ", "password"),
    ("gpg", "│ Passphrase: ________________________________________ │", "passphrase"),
    ("pinentry-curses", "│ PIN: ________________________________________ │", "pin"),
]:
    check(f"{program} waits for a {kind} on «{line.strip()}»", kind, waits(program, "some output", line))

check("the prompt's own line is what the prompt holds, without its padding",
      "[sudo] password for max:", pw.prompt_in("sudo", ["$ sudo true", "[sudo] password for max: "]).line)

# A touch is asked for on a line of its own: the cursor sits below it on an empty line.
check("ykman waits for a touch asked for on the line above the cursor",
      "touch", waits("ykman", "Touch your YubiKey...", ""))
check("age-plugin-yubikey waits for a touch asked for on the line above the cursor",
      "touch", waits("age-plugin-yubikey", "Please touch the YubiKey", ""))
check("ssh waits for a touch on a security key",
      "touch", waits("ssh", "Confirm user presence for key ED25519-SK SHA256:abc", ""))

# --- what is not a waiting prompt

check("an answered password, the cursor below it on an empty line, no longer waits",
      None, waits("sudo", "[sudo] password for max: ", ""))
check("an answered password, the command's output below it, no longer waits",
      None, waits("sudo", "[sudo] password for max: ", "building the system configuration..."))
check("a prompt line in a program that is no prompter is not a prompt",
      None, waits("zsh", "$ echo 'Password: '", "Password: "))
check("a plain shell's read -s is out", None, waits("bash", "Password: "))
check("a prompter printing what is no prompt does not wait", None, waits("ssh", "Welcome to pc", "max@pc:~$ "))
check("a pane with no lines does not wait", None, waits("sudo"))

# --- which program a command line runs

for argv, name in [
    (["sudo", "nixos-rebuild", "switch"], "sudo"),
    (["/run/wrappers/bin/sudo", "-v"], "sudo"),
    (["/nix/store/abc-python3-3.12/bin/python3.12", "/nix/store/def-ykman/bin/.ykman-wrapped", "piv", "info"], "ykman"),
    (["node", "/nix/store/abc-bitwarden-cli/lib/bw.js", "unlock"], "bw"),
    (["bash", "/home/max/bin/nswitch"], "nswitch"),
    (["-zsh"], "zsh"),
    (["pinentry-curses", "--ttyname", "/dev/pts/3"], "pinentry-curses"),
]:
    check(f"«{' '.join(argv)}» runs as {name}", name, pw.program_name(argv))

check("pinentry* names every pinentry", True, pw.is_prompter("pinentry-tty"))

finish()
