#!/usr/bin/env bash
# Drive bin/overdue-check against fixtures and check what it reports. Run it
# directly; no framework.
#
# The cases here are the promises the watchdog makes: that a bound is the only
# thing standing between a dead unit and silence, that a unit judged by its run
# log is never quietly judged by systemd instead, that a host being off is not
# an alarm, and that a breach produces exactly one notification naming what
# broke.
#
# HOME is redirected at a scratch dir, which moves the run logs and empties the
# restic config glob, so the only repositories reached are the throwaway ones a
# case hands over by name. The systemd cases are the one thing not isolated:
# they read this machine's real journal, because a fake one would only prove the
# fake right.

set -uo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"

# Read from the script rather than repeated here: a test that carries its own
# copy of the id would keep passing against an id the script no longer uses.
unit_started=$(sed -n 's/^SYSTEMD_UNIT_STARTED=//p' "$bin_dir/overdue-check")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# Stubs stand in for the two things a check reaches outside this machine for.
# Alerts go through the real bin/alert-send, whose curl is stubbed to decode the
# subject and body of what would have been submitted, so a test can count and
# read them; ssh refuses to connect, the way a host that is off does.
mkdir -p "$work/stub"
cat >"$work/stub/curl" <<'STUB'
#!/usr/bin/env bash
msg="" prev=""
for a in "$@"; do
    [ "$prev" = "--upload-file" ] && msg="$a"
    prev="$a"
done
[ -n "$msg" ] && [ -f "$msg" ] || exit 0
sed -n 's/^Subject: =?UTF-8?B?\(.*\)?=$/\1/p' "$msg" | base64 -d >> "$ALERTS_SENT"
echo >> "$ALERTS_SENT"
awk '/^Content-Transfer-Encoding: base64$/{f=1;next} f&&/^$/{b=1;next} b&&/^--/{exit} b{print}' "$msg" \
    | base64 -d >> "$ALERTS_SENT"
echo "---" >> "$ALERTS_SENT"
STUB
cat >"$work/stub/ssh" <<'EOF'
#!/usr/bin/env bash
echo "ssh: connect to host: Connection timed out" >&2
exit 255
EOF
chmod +x "$work/stub/curl" "$work/stub/ssh"
export PATH="$work/stub:$PATH"
export ALERTS_SENT="$work/alerts.log"

export HOME="$work/home"
mkdir -p "$HOME/logs/runs" "$HOME/.local/secrets"
# The repo cases need a key file to exist at all; none of them needs sops, since
# their password command is a `cat`.
touch "$HOME/.local/secrets/age-key.txt"

# HOME is redirected, so alert-send's default config path lands on this
# throwaway channel rather than the real one.
mkdir -p "$HOME/.dotfiles/secrets/monitoring"
cat >"$HOME/.dotfiles/secrets/monitoring/alert.conf" <<'CONF'
smtp_url="smtp://localhost:587"
smtp_user="test@example.invalid"
password_command="echo test-token"
mail_from="test@example.invalid"
mail_to="test@example.invalid"
CONF

days_ago() { date -Iseconds -d "$1 days ago"; }

log_line() {  # unit outcome days_ago
    jq -c -n --arg ts "$(days_ago "$3")" --arg unit "$1" --arg outcome "$2" \
        '{ts: $ts, unit: $unit, outcome: $outcome, reason: null, stats: {}}' \
        >> "$HOME/logs/runs/$1.jsonl"
}

run() {  # config-body-on-stdin, args... -> stdout+stderr, sets $rc
    local config="$work/overdue.conf"
    cat > "$config"
    : > "$ALERTS_SENT"
    out=$("$bin_dir/overdue-check" --config "$config" "$@" 2>&1)
    rc=$?
}

# grep -c prints its 0 and then exits 1; the || keeps that from ending the run.
sent_count() { grep -c -- '^---$' "$ALERTS_SENT" 2>/dev/null || true; }

# The stub writes each alert as subject, body, then a --- line, so the subject of
# the first alert is the first line.
subject() { head -1 "$ALERTS_SENT"; }

this_host="$(uname -n)"

# --- a unit inside its bound is silent; outside it, it is named once

log_line fresh-unit ok 1
log_line stale-unit ok 9

run <<EOF
fresh-unit $this_host 3 run-log
EOF
check "a unit inside its bound exits 0" 0 "$rc"
check "...and sends nothing" 0 "$(sent_count)"

run <<EOF
stale-unit $this_host 3 run-log
EOF
check "a unit past its bound exits 1" 1 "$rc"
check "...sends exactly one notification" 1 "$(sent_count)"
check "...naming the unit and both ages" \
    "yes" \
    "$(grep -q 'stale-unit' "$ALERTS_SENT" && grep -q '9d since last success (limit 3d)' "$ALERTS_SENT" && echo yes || echo no)"
check "...and its own run log line says the alert was delivered" \
    "delivered" \
    "$(jq -r '.stats.alert' "$HOME/logs/runs/overdue-check.jsonl" | tail -1)"

# --- the subject is what a phone shows before anyone opens the mail
#
# It also has to change from run to run: Proton threads by subject and
# participants, so a constant one buries every alert in a single conversation.

log_line stale-two ok 9
log_line stale-three ok 9

run <<EOF
stale-unit $this_host 3 run-log
EOF
check "one breach names it in the subject" \
    "🕸️ 1 overdue: stale-unit ($this_host)" \
    "$(subject)"

run <<EOF
stale-unit $this_host 3 run-log
stale-two $this_host 3 run-log
stale-three $this_host 3 run-log
EOF
check "three breaches name the first and count the rest" \
    "🕸️ 3 overdue: stale-unit ($this_host) +2" \
    "$(subject)"

# --- a breach whose alert cannot be delivered is a failed run of the watchdog
#
# The channel going dark must not look like a quiet day: the fail line is what
# turns it into a red dashboard row, and the missing ok line is what makes the
# other host's copy of this check speak up.

cp "$HOME/.dotfiles/secrets/monitoring/alert.conf" "$work/alert.conf.good"
sed -i 's/^password_command=.*/password_command="false"/' \
    "$HOME/.dotfiles/secrets/monitoring/alert.conf"
run <<EOF
stale-unit $this_host 3 run-log
EOF
check "a breach with a dead channel still exits 1" 1 "$rc"
check "...but the watchdog's own run is recorded as fail" \
    "fail" \
    "$(jq -r '.outcome' "$HOME/logs/runs/overdue-check.jsonl" | tail -1)"
check "...naming the undelivered alert as the reason" \
    "found overdue units but the alert was not delivered" \
    "$(jq -r '.reason' "$HOME/logs/runs/overdue-check.jsonl" | tail -1)"
check "...with the mailer's exit in stats.alert" \
    "yes" \
    "$(jq -r '.stats.alert' "$HOME/logs/runs/overdue-check.jsonl" | tail -1 \
        | grep -q 'delivery failed' && echo yes || echo no)"
cp "$work/alert.conf.good" "$HOME/.dotfiles/secrets/monitoring/alert.conf"

# The acceptance case: tighten a bound to 0 and the unit must surface.
run <<EOF
fresh-unit $this_host 0 run-log
EOF
check "bound 0 makes a unit that ran yesterday overdue" 1 "$rc"
check "...in exactly one notification" 1 "$(sent_count)"

# --- --extra-days lifts every bound, which is how the second host stays quiet

run --extra-days 7 <<EOF
stale-unit $this_host 3 run-log
EOF
check "--extra-days lifts the bound past the breach" 0 "$rc"
check "...so the offset host stays silent" 0 "$(sent_count)"

# --- a unit that only ever fails has no last success

log_line failing-unit fail 5
log_line failing-unit fail 1

run <<EOF
failing-unit $this_host 30 run-log
EOF
check "a unit that only ever fails is overdue however loose the bound" 1 "$rc"
check "...reported as having no successful run" \
    "yes" \
    "$(grep -q 'no successful run on record' "$ALERTS_SENT" && echo yes || echo no)"

# --- deliberate skips are not successes

log_line skipping-unit ok 40
log_line skipping-unit skip 2
log_line skipping-unit skip 1

run <<EOF
skipping-unit $this_host 30 run-log
EOF
check "a skip streak does not refresh the clock" 1 "$rc"
check "...the age is measured from the last real success" \
    "yes" \
    "$(grep -q '40d since last success' "$ALERTS_SENT" && echo yes || echo no)"

# --- a unit nothing has ever heard of

run <<EOF
never-ran-unit $this_host 90 run-log
EOF
check "a unit with nothing on record is reported" 1 "$rc"
check "...rather than skipped" \
    "yes" \
    "$(grep -q 'never-ran-unit' "$ALERTS_SENT" && echo yes || echo no)"

# --- a unit judged by its run log is never judged by systemd instead
#
# systemd only knows the unit exited 0, and a run-logged job exits 0 when it
# deliberately did nothing — so silently reading the journal when the run log is
# missing would turn a broken recorder into a clean bill of health. This host's
# journal holds a real unit that succeeded minutes ago to prove the point on.

journal_unit=""
for candidate in github-mirror browsing-archive jarvis-sync dns-audit; do
    if [ -n "$(journalctl --user -u "$candidate.service" \
        "MESSAGE_ID=$unit_started" JOB_RESULT=done \
        -n 1 -o cat --no-pager 2>/dev/null)" ]; then
        journal_unit="$candidate"
        break
    fi
done

if [ -z "$journal_unit" ]; then
    echo "skip journald cases — no unit with a clean finish in this journal"
else
    run <<EOF
$journal_unit $this_host 30 systemd
EOF
    check "the systemd witness reads a real clean finish ($journal_unit)" 0 "$rc"

    run <<EOF
$journal_unit $this_host 30 run-log
EOF
    check "...and the same unit with no run log is overdue, not healthy" 1 "$rc"

    log_line "$journal_unit" skip 1
    run <<EOF
$journal_unit $this_host 30 run-log
EOF
    check "...still overdue when its only record is a fresh skip" 1 "$rc"
    rm -f "$HOME/logs/runs/$journal_unit.jsonl"
fi

# --- a host that is off is not an alarm

run <<EOF
some-unit a-host-that-is-off 1 run-log
EOF
check "an unreachable host exits 0" 0 "$rc"
check "...sends nothing" 0 "$(sent_count)"
check "...and says so on stdout" \
    "yes" \
    "$(grep -q 'a-host-that-is-off not reachable' <<<"$out" && echo yes || echo no)"

# --- a repository whose target is down is not an alarm while its backups are
#     fresh; a broken one is, and so is an outage that outlasts the bound
#
# An outage the backup already recorded as a skip must not come back as a
# notification the next morning. But a repository can only be dated from inside
# itself, so an unreachable one is judged by the run log of the host that backs
# it up — otherwise a provider that stays down looks exactly like health.
# A repository that answers and still cannot be read will not fix itself.

printf 'testpw\n' > "$work/pw"
mkdir -p "$work/repos"

repo_config() {  # name, repo path
    cat > "$work/repos/$1.conf" <<EOF
repo_path="$2"
password_command="cat $work/pw"
max_age_days="7"
EOF
}

unreachable_repo="sftp://max@127.0.0.1:2222//tmp/does-not-matter"

# No timer runs these throwaway configs, so the run log the check falls back to
# is this host's — the same read it would make on pc for a repo pc backs up.
log_line repos-away ok 1

repo_config away "$unreachable_repo"
run "$work/repos/away.conf" <<EOF
EOF
check "a repository whose target refuses the connection exits 0" 0 "$rc"
check "...sends nothing" 0 "$(sent_count)"
check "...and is listed as away on stdout" \
    "yes" \
    "$(grep -q 'repos-away: .*[Cc]onnection refused' <<<"$out" && echo yes || echo no)"
check "...with the age of the backup that keeps it quiet" \
    "yes" \
    "$(grep -q 'last backup 1d ago (limit 7d)' <<<"$out" && echo yes || echo no)"

log_line repos-stale ok 20
repo_config stale "$unreachable_repo"
run "$work/repos/stale.conf" <<EOF
EOF
check "an away streak past the repo's bound exits 1" 1 "$rc"
check "...sends exactly one notification" 1 "$(sent_count)"
check "...naming the unreachability as the reason" \
    "yes" \
    "$(grep -q 'repos-stale: target away' "$ALERTS_SENT" \
        && grep -qi 'connection refused' "$ALERTS_SENT" && echo yes || echo no)"
check "...and how long the backup has been missing" \
    "yes" \
    "$(grep -q 'no backup for 20d (limit 7d)' "$ALERTS_SENT" && echo yes || echo no)"

log_line repos-failing fail 1
repo_config failing "$unreachable_repo"
run "$work/repos/failing.conf" <<EOF
EOF
check "an away repository whose every run failed exits 1" 1 "$rc"
check "...saying nothing has succeeded, rather than waiting out the outage" \
    "yes" \
    "$(grep -q 'no successful backup on record' "$ALERTS_SENT" && echo yes || echo no)"

repo_config unlogged "$unreachable_repo"
run "$work/repos/unlogged.conf" <<EOF
EOF
check "an away repository nothing has ever logged exits 1" 1 "$rc"
check "...naming the missing log, which is a different fact from a failed backup" \
    "yes" \
    "$(grep -q 'keeps no run log for this backup' "$ALERTS_SENT" && echo yes || echo no)"

# A repo backed up by the other host: the run log that could date it is over
# there, and the stub ssh refuses, so nothing here can say how old it is. It also
# pins the lookup — judged against this host's logs it would read as a repo
# nothing has ever backed up, and alert. The conf is a copy of a real one, so the
# unit name comes from bin/restic-config-name rather than from splitting a name here.
away_conf=""
for conf in "$bin_dir/../secrets/backup/restic"/*/*.conf; do
    [ -f "$conf" ] || continue
    unit=$("$bin_dir/restic-config-name" "$conf")
    [ "$("$bin_dir/backup-hosts" | grep -c "^$unit	$this_host\$")" -eq 0 ] || continue
    away_conf="$conf"
    away_unit="$unit"
    break
done
if [ -z "$away_conf" ]; then
    echo "skip the both-away case — no restic repo is backed up from another host"
else
    away_dir="$work/$(basename "$(dirname "$away_conf")")"
    mkdir -p "$away_dir"
    cat > "$away_dir/$(basename "$away_conf")" <<EOF
repo_path="$unreachable_repo"
password_command="cat $work/pw"
max_age_days="7"
EOF
    run "$away_dir/$(basename "$away_conf")" <<EOF
EOF
    check "a repo away whose backup host is away too exits 0 ($away_unit)" 0 "$rc"
    check "...sends nothing, because nothing can date it either way" 0 "$(sent_count)"
    check "...and says both are away on stdout" \
        "yes" \
        "$(grep -q "$away_unit: .*is away too" <<<"$out" && echo yes || echo no)"
fi

mkdir -p "$work/not-a-repo"
repo_config broken "$work/not-a-repo"
run "$work/repos/broken.conf" <<EOF
EOF
check "a reachable repository that cannot be read exits 1" 1 "$rc"
check "...sends exactly one notification" 1 "$(sent_count)"
check "...naming it as unreadable" \
    "yes" \
    "$(grep -q 'repos-broken: no snapshots, or repo unreadable' "$ALERTS_SENT" && echo yes || echo no)"

# --- --dry-run is the same check with the notification withheld

runs_before=$(wc -l < "$HOME/logs/runs/overdue-check.jsonl")
run --dry-run <<EOF
stale-unit $this_host 3 run-log
EOF
check "--dry-run still reports a breach" 1 "$rc"
check "...sends nothing" 0 "$(sent_count)"
check "...prints what it would have sent" \
    "yes" \
    "$(grep -q 'stale-unit' <<<"$out" && grep -q 'dry-run: nothing sent' <<<"$out" && echo yes || echo no)"
check "...and leaves the watchdog's own run log alone" \
    "$runs_before" \
    "$(wc -l < "$HOME/logs/runs/overdue-check.jsonl")"

# --- a locked age key costs the repos, not the whole run
#
# pc keeps its key on tmpfs and decrypts it at the first interactive login, so
# every run between a reboot and that login lands here. Giving up would make a
# reboot silence the units too, and send nothing to say so.

log_line locked-key-unit ok 9
printf 'locked-key-unit %s 3 run-log\n' "$this_host" > "$work/locked.conf"
out=$(SOPS_AGE_KEY_FILE="$work/no-such-key" "$bin_dir/overdue-check" \
    --config "$work/locked.conf" "$work/some-repo.conf" 2>&1)
rc=$?
check "a missing age key does not abort the run" 1 "$rc"
check "...it is reported as something that could not be checked" \
    "yes" \
    "$(grep -q 'age key not available' <<<"$out" && echo yes || echo no)"
check "...and the units are still checked" \
    "yes" \
    "$(grep -q 'locked-key-unit' <<<"$out" && echo yes || echo no)"

# --- the check records its own run, so the other host can see it is alive

check "a completed check appends one ok line for itself" \
    "ok" \
    "$(jq -r '.outcome' "$HOME/logs/runs/overdue-check.jsonl" | tail -1)"
check "...carrying what it found" \
    "number number number number" \
    "$(jq -r '[.stats.overdue, .stats.unchecked, .stats.unreachable, .stats.ok | type] | join(" ")' \
        "$HOME/logs/runs/overdue-check.jsonl" | tail -1)"

# --- a unit on the last line is watched even with no newline after it
#
# Appending a line with something that leaves the file unterminated would
# otherwise drop that unit silently: no error, and nothing watching it.

printf 'stale-unit %s 3 run-log' "$this_host" > "$work/unterminated.conf"
: > "$ALERTS_SENT"
out=$("$bin_dir/overdue-check" --config "$work/unterminated.conf" 2>&1); rc=$?
check "a unit on an unterminated last line is still checked" 1 "$rc"
check "...and named in the notification" \
    "yes" \
    "$(grep -q 'stale-unit' "$ALERTS_SENT" && echo yes || echo no)"

# --- a config it cannot make sense of stops the check instead of guessing

reject() {
    local what="$1" body="$2" out rc
    out=$(printf '%s\n' "$body" > "$work/bad.conf"; \
        "$bin_dir/overdue-check" --config "$work/bad.conf" 2>&1); rc=$?
    if [ "$rc" -ne 2 ]; then
        echo "FAIL $what — exited $rc, should have refused with 2"
        failures=$((failures + 1))
    elif [ -z "$out" ]; then
        echo "FAIL $what — refused silently, should have said why"
        failures=$((failures + 1))
    else
        echo "ok   $what → rc=$rc, ${out%%$'\n'*}"
    fi
}

reject "a unit line missing its bound" "some-unit $this_host"
reject "a unit line missing its witness" "some-unit $this_host 7"
reject "a bound that is not a number" "some-unit $this_host soon run-log"
reject "a witness nothing can read" "some-unit $this_host 7 vibes"
reject "a unit name that would escape into a path or a command" \
    "../evil $this_host 7 run-log"
reject "an unknown setting" "colour: green"
reject "the retired ntfy_topic setting" "ntfy_topic: a-topic"

out=$("$bin_dir/overdue-check" --config "$work/does-not-exist.conf" 2>&1); rc=$?
check "a missing config refuses to run" 2 "$rc"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
    exit 0
fi
echo "$failures check(s) failed"
exit 1
