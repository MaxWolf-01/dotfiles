#!/usr/bin/env bash
# Drive bin/ssh-tint against a fake ssh, in a real pseudo-terminal (`script`),
# and read the escapes it writes. Run it directly; no framework.
#
# What matters: a known host gets its own tint and anything else the fallback;
# the reset returns to where the terminal was, which on a host reached over ssh
# is that host's tint; ssh's exit status survives the wrapper; and output that
# is not a terminal is never touched.

set -uo pipefail

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# `ssh -G` prints the resolved hostname the way the real one does; any other
# call is the session, which exits with FAKE_STATUS.
mkdir "$tmp/path"
cat > "$tmp/path/ssh" <<'EOF'
#!/usr/bin/env bash
if [ "$1" = -G ]; then echo "host $2"; echo "hostname ${FAKE_HOSTNAME:-$2}"; exit 0; fi
exit "${FAKE_STATUS:-0}"
EOF
chmod +x "$tmp/path/ssh"

printf '%s\n' "100.0.0.1 #111111" "100.0.0.2 #222222" "* #999999" > "$tmp/hosts"
export SSH_TINT_HOSTS="$tmp/hosts" PATH="$tmp/path:$PATH"
unset SSH_CONNECTION # set when the suite itself runs over ssh

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# Everything ssh-tint wrote to the terminal, escapes made readable: ESC as `^`,
# the string terminator ESC \ as `;`.
on_tty() { # <env assignments...> -- <ssh args...>
    local envs=()
    while [ "$1" != -- ]; do envs+=("$1"); shift; done; shift
    script -qec "env ${envs[*]} $bin/ssh-tint $*" /dev/null | tr -d '\r' | sed 's/\x1b\\/;/g; s/\x1b/^/g'
}

check "a known host is tinted, then reset" \
    "^]11;#111111;^]111;" "$(on_tty FAKE_HOSTNAME=100.0.0.1 -- pc)"

check "an unknown host gets the fallback" \
    "^]11;#999999;^]111;" "$(on_tty FAKE_HOSTNAME=203.0.113.9 -- somewhere)"

check "leaving a hop from a host reached over ssh restores that host's tint" \
    "^]11;#222222;^]11;#111111;" \
    "$(on_tty FAKE_HOSTNAME=100.0.0.2 "SSH_CONNECTION='10.0.0.5 5000 100.0.0.1 22'" -- jarvis)"

script -qec "env FAKE_HOSTNAME=100.0.0.1 FAKE_STATUS=7 $bin/ssh-tint pc" /dev/null > /dev/null
check "ssh's exit status comes through" 7 "$?"

check "output that is not a terminal is never tinted" \
    "" "$(FAKE_HOSTNAME=100.0.0.1 "$bin/ssh-tint" pc | sed 's/\x1b/^/g')"

rm "$tmp/hosts"
check "without a hosts file nothing is tinted" "" "$(on_tty FAKE_HOSTNAME=100.0.0.1 -- pc)"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
else
    echo "$failures check(s) failed"
fi
exit $((failures > 0))
