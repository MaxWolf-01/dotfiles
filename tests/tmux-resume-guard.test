#!/usr/bin/env bash
# tier: fast
# Check what bin/tmux-resume-guard lets a tmux restore resume, against a HOME in a scratch directory: the hosts that
# relay this one, what their hubs told it, the session copies, and stubs on PATH for `tailscale status` and `ssh -G`.
# Every case that would wait is given no time to (TMUX_RESUME_GUARD_WAIT=0); tests/tmux-save.test drives a wait
# through a real restore. Run it directly; no framework.

set -uo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
guard="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/tmux-resume-guard"
needs jq

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export HOME=$work/home USER=max XDG_CONFIG_HOME=$work/home/.config TMUX_RESUME_GUARD_WAIT=0
mkdir -p "$work/stubs" "$HOME/.claude/projects/-p" "$HOME/.config/container-hub"
told=$HOME/.local/state/container-hub/told-forks
copies=$HOME/.local/share/session-copies
boot=$(awk '$1 == "btime" { print $2 }' /proc/stat)

# The laptop is zephylux on the tailnet, which `ssh -G` resolves to the name `hostname` holds; `online` says whether
# tailscale shows it connected, and `listed` whether tailscale knows it at all.
online=true listed=true hostname=""
cat >"$work/stubs/ssh" <<STUB
#!/bin/sh
[ "\$1" = -G ] && echo "hostname \$(cat $work/hostname)"
STUB
cat >"$work/stubs/tailscale" <<STUB
#!/bin/sh
cat $work/status
STUB
chmod +x "$work/stubs/ssh" "$work/stubs/tailscale"
export PATH="$work/stubs:$PATH"
echo '{"host": "pc", "relayedBy": {"zephylux": "zephylux"}}' >"$HOME/.config/container-hub/relayed-by.json"

guard() {  # session -> "<exit code> <what it printed>"
    local said
    echo "${hostname:-zephylux}" >"$work/hostname"
    if [ "$listed" = true ]; then
        printf '{"Peer": {"k": {"HostName": "Zephylux", "DNSName": "zephylux.tail.ts.net.", "TailscaleIPs": ["100.1.1.1"], "Online": %s}}}' "$online"
    else
        echo '{"Peer": {}}'
    fi >"$work/status"
    said=$("$guard" "$HOME/.claude" "$1")
    echo "$? $said"
}
waits() { guard "$1" | grep -c 'did not say'; }  # session -> 1 where it waited for the laptop, here for no time
record() {  # host session on at fork
    printf '{"host": "%s", "session": "%s", "on": "%s", "at": %s, "pulled": %s, "point": 10, "fork": "%s"}' "$1" "$2" "$3" "$4" "$4" "$5"
}
tell() {  # host forks... : what that host's hub told this one, at `at` (now by default)
    local host=$1 IFS=,
    shift
    mkdir -p "$told"
    echo "{\"at\": ${at:-$EPOCHSECONDS}, \"forks\": [$*]}" >"$told/$host.json"
}

check "with the laptop off the tailnet and nothing heard of it, a session resumes at once: a host that cannot say is not waited for" \
    "0 " "$(online=false guard plain)"
check "...the laptop found by its tailnet address as well as by its name" "0 " "$(online=false hostname=100.1.1.1 guard plain)"
check "with the laptop on the tailnet and nothing heard of it since boot, the session waits, here for no time, and says so" \
    "0 tmux-resume-guard: zephylux did not say within 0 s whether it forked session plain while pc did not answer; resuming it" \
    "$(guard plain)"
check "...as it does where tailscale does not list the laptop" 1 "$(online=false listed=false waits plain)"
mkdir -p "$work/failing" "$work/garbled"
printf '#!/bin/sh\nexit 1\n' >"$work/failing/tailscale"
printf '#!/bin/sh\necho "not JSON"\n' >"$work/garbled/tailscale"
chmod +x "$work/failing/tailscale" "$work/garbled/tailscale"
check "...where tailscale answers what is not its status" 1 "$(online=false PATH="$work/garbled:$PATH" waits plain)"
check "...and where tailscale cannot say whether the laptop is on the tailnet" 1 "$(online=false PATH="$work/failing:$PATH" waits plain)"

tell zephylux "$(record pc forked zephylux 1700000000 aaaaaaaa-1111)" "$(record pc forked zephylux 1700000600 ffffffff-1111)" \
    "$(record pc other zephylux 1700000000 eeeeeeee)"
check "once the laptop's hub told this host it forked none of the session, the session resumes at once" "0 " "$(guard plain)"
check "...and one it forked is not resumed, saying where and as what it goes on, its latest fork where there are two" \
    "1 tmux-resume-guard: session forked was forked on zephylux at $(date -d @1700000600 '+%F %R') as ffffffff, while pc did not answer; it goes on there, and is not resumed here" \
    "$(guard forked)"
tell zephylux "$(record jarvis plain zephylux 1700000000 dddddddd)"
check "a fork of another host's session of the same id is none of this host's" "0 " "$(guard plain)"

at=$((boot - 60)) tell zephylux
check "a tell from before this host booted says nothing of a fork made while it was down" 1 "$(waits plain)"
mkdir -p "$copies/zephylux"
echo "{\"at\": $((boot - 1)), \"home\": \"/home/max\"}" >"$copies/zephylux/max.pulled.json"
check "...nor does a pull of the laptop from before" 1 "$(waits plain)"
mkdir -p "$copies/zephylux/max/.claude/session-pages/abcdef12-fork"
record pc pulled zephylux 1700000300 ignored | jq 'del(.fork)' >"$copies/zephylux/max/.claude/session-pages/abcdef12-fork/forked-from.json"
check "a fork record in the copy of the laptop counts, pulled before boot or not, named by its page directory" \
    "1 tmux-resume-guard: session pulled was forked on zephylux at $(date -d @1700000300 '+%F %R') as abcdef12, while pc did not answer; it goes on there, and is not resumed here" \
    "$(guard pulled)"
echo "{\"at\": $EPOCHSECONDS, \"home\": \"/home/max\"}" >"$copies/zephylux/max.pulled.json"
check "a pull of the laptop since boot says it as a tell does" "0 " "$(guard plain)"

echo '{"to": "zephylux"}' >"$HOME/.claude/projects/-p/pulled.release.json"
check "a session released to another host is not resumed, forked there or not" \
    "1 tmux-resume-guard: session pulled was released to zephylux; it resumes there, not here" "$(guard pulled)"

rm "$HOME/.config/container-hub/relayed-by.json"
check "on a host no other hub relays, nothing is waited for" "0 " "$(guard plain)"

finish
