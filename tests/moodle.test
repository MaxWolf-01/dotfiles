#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro", "requests", "beautifulsoup4", "lxml"]
# ///
"""Drive bin/moodle without Moodle. Run it directly; no framework.

The promises here: the tool never sends a request that could act on Moodle (a page outside
the ones it reads, a parameter that turns a view into an action, an AJAX function outside its
read-only list, a download that is not a Moodle file); text keeps every link's target beside
its text; a forum's discussions come with all their posts, read again only when a discussion
got a post; everything a snapshot could not read is listed in it as a gap with the reason, and
printed, and what it lacks by design (an activity Moodle withholds, a recording that only streams,
a page not opened) is listed apart from the gaps, so the gaps are its failed reads alone;
two equal snapshots diff to nothing and a changed due date, a new announcement or a removed
file each show as one change, named the way Moodle names them; a file already downloaded is
not fetched again, and a file of max's under the same name is never overwritten.

The HTML fixtures and the forum post are cut down from moodle.jku.at's pages and AJAX answers
as they were on 2026-10-04, keeping the markup the parser reads.
"""

import contextlib
import importlib.util
import io
import json
import sys
import tempfile
from datetime import datetime
from importlib.machinery import SourceFileLoader
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True  # importing bin/ must not leave a __pycache__ on $PATH
loader = SourceFileLoader("moodle", str(ROOT / "bin" / "moodle"))
spec = importlib.util.spec_from_loader(loader.name, loader)
assert spec
moodle = importlib.util.module_from_spec(spec)
sys.modules[loader.name] = moodle  # dataclasses resolve string annotations through it
loader.exec_module(moodle)

failures = 0


def check(what: str, expected, actual) -> None:
    global failures
    if expected == actual:
        print(f"ok   {what}")
    else:
        print(f"FAIL {what}\n       expected: {expected!r}\n       actual:   {actual!r}")
        failures += 1


class Wire:
    """Stands in for the network: records every request, answers from a table of path -> body."""

    def __init__(self, pages: dict[str, str] | None = None, ajax: dict[str, object] | None = None, broken: set[str] | None = None):
        self.sent: list[tuple[str, str]] = []
        self.pages = pages or {}
        self.ajax = ajax or {}
        self.broken = broken or set()  # paths and AJAX functions that answer with an error
        self.headers: dict = {}
        self.drops = 0  # how many of the next requests lose their connection

    def _answer(self, method: str, url: str, **kw):
        self.sent.append((method, url))
        if self.drops:
            self.drops -= 1
            raise moodle.requests.ConnectionError("Remote end closed connection without response")
        path = url.removeprefix(moodle.MOODLE).split("?")[0]
        body = self.pages.get(path, "")
        info = kw.get("params", {}).get("info")
        data = self.ajax.get(info, {})
        page_broken = any(path.startswith(b) for b in self.broken if b.startswith("/"))
        ajax_broken = info in self.broken

        class R:
            status_code, text, headers = (500 if page_broken else 200), body, {}

            def raise_for_status(self):
                if page_broken:
                    raise moodle.requests.HTTPError(f"500 Server Error for {path}")
            def json(self): return [{"error": True, "exception": {"message": "Fehler beim Lesen der Datenbank"}} if ajax_broken else {"error": False, "data": data}]
            def iter_content(self, n): yield b"pdf bytes"
            def __enter__(self): return self
            def __exit__(self, *a): ...
        return R()

    def get(self, url, **kw): return self._answer("GET", url, **kw)
    def post(self, url, **kw): return self._answer("POST", url, **kw)


def session(pages: dict[str, str] | None = None, ajax: dict[str, object] | None = None, broken: set[str] | None = None) -> tuple[object, Wire]:
    m = moodle.Moodle()
    m.s = Wire(pages, ajax, broken)
    m.sesskey = "k"
    moodle.PAUSE = 0
    return m, m.s


def refused(fn) -> bool:
    try:
        fn()
    except ValueError:
        return True
    return False


# --- nothing it sends can act on Moodle (ticket: "nothing the CLI does changes anything on Moodle")

m, wire = session()
check("a submission action on an assignment page is refused",
      True, refused(lambda: m.page("/mod/assign/view.php", id=1, action="savesubmission")))
check("a session key on a page is refused", True, refused(lambda: m.page("/mod/forum/view.php", id=1, sesskey="k")))
check("a page outside the ones it reads is refused", True, refused(lambda: m.page("/course/modedit.php", id=1)))
check("an activity type that may act on opening (an LTI launch) is refused", True, refused(lambda: m.page("/mod/lti/view.php", id=1)))
check("the logout page is refused", True, refused(lambda: m.page("/login/logout.php")))
check("a write AJAX function is refused", True, refused(lambda: m.ajax("mod_assign_submit_for_grading", assignmentid=1)))
check("posting to a forum is refused", True, refused(lambda: m.ajax("mod_forum_add_discussion_post", postid=1, subject="x", message="y")))
check("a download from outside pluginfile.php is refused", True,
      refused(lambda: m.download(f"{moodle.MOODLE}/mod/resource/view.php?id=1", Path(tempfile.mkdtemp()) / "x")))
check("no refused call reached the wire", [], wire.sent)
m.page("/mod/resource/view.php", follow=False, id=1, redirect=1)
m.ajax("core_courseformat_get_state", courseid=1)
m.ajax("mod_forum_get_discussion_posts", discussionid=1)
check("reads go out: a resource redirect, a read-only AJAX call, a forum's posts", ["GET", "POST", "POST"], [s[0] for s in wire.sent])

# --- the course page: summaries and labels keep their links and images; an unfinished view requirement does not keep a page closed

COURSE_PAGE = """
<ul>
<li class="section course-section main" data-for="section" data-id="1002002" data-number="2" data-sectionname="Forums">
 <div data-for="sectioninfo"><div class="summarytext"><p>Exercise sheets go <a href="https://moodle.jku.at/pluginfile.php/9/course/section/1002002/rules.pdf">here</a>.</p>
  <p>Live stream on <strong>Tuesday</strong> via <a href="https://jku.zoom.us/j/64011030340?pwd=V3wW">Zoom</a>, schedule in <a href="https:\\kusss.jku.at">KUSSS</a>.</p></div></div>
 <li class="activity label modtype_label" data-id="10" id="module-10">
  <div class="activity-altcontent"><div class="no-overflow"><p>Q&amp;A sessions: <a href="https://jku.zoom.us/j/98349106604">https://jku.zoom.us/j/98349106604</a></p>
   <p><img src="https://moodle.jku.at/pluginfile.php/9/mod_label/intro/schedule.png" alt="Schedule"><img src="https://moodle.jku.at/theme/image.php/boost/core/1/i/info"></p></div></div>
 </li>
 <li class="activity resource modtype_resource" data-id="11" id="module-11">
  <div data-region="completionrequirements"><button class="btn dropdown-toggle btn-subtle-secondary">Zu erledigen</button>
   <div class="completion-dialog"><div role="list">
    <div class="d-flex mt-2" role="listitem"><span class="visually-hidden">Zu erledigen:</span><span>Anzeigen</span></div>
   </div></div></div>
 </li>
 <li class="activity page modtype_page" data-id="14" id="module-14">
  <div class="activity-availability availabilityinfo isrestricted" data-region="availabilityinfo"><div class="showmore-container collapsed" data-region="showmore">
   <button class="showmore-button" type="button"><span class="collapsed-content">Mehr anzeigen</span><span class="expanded-content">Weniger anzeigen</span></button>
   <div class="collapsed-content text-truncate"><span class="availability-excerpt">Nicht verfügbar, außer: Sie sind in <strong>Kurs 365.215, UE Hands-on AI I, Mohammed Abbass / Rainer ...</strong> ...</span></div>
   <div class="expanded-content py-2">Nicht verfügbar, außer: Sie sind in <strong>Kurs 365.215, UE Hands-on AI I, Mohammed Abbass / Rainer Dangl, 2025W</strong></div>
  </div></div>
 </li>
 <li class="activity assign modtype_assign" data-id="13" id="module-13">
  <div data-region="activity-dates">Geöffnet: Dienstag, 3. März 2026, 18:00 Fällig: Donnerstag, 5. März 2026, 07:00</div>
 </li>
</li></ul>"""

m, wire = session({"/course/view.php": COURSE_PAGE})
sections, cards = moodle.course_page(m, 1)
check("a section summary keeps each link's target beside its text", "\n".join([
    "Exercise sheets go here <https://moodle.jku.at/pluginfile.php/9/course/section/1002002/rules.pdf>.",
    "Live stream on Tuesday via Zoom <https://jku.zoom.us/j/64011030340?pwd=V3wW>, schedule in KUSSS <https://kusss.jku.at>.",
]), sections["1002002"]["summary"])
check("a section's summary links its files", {"rules.pdf": "https://moodle.jku.at/pluginfile.php/9/course/section/1002002/rules.pdf"},
      sections["1002002"]["files"])
check("a label whose link text is its target says it once; an image it shows is named with its target, a theme icon is not",
      "Q&A sessions: <https://jku.zoom.us/j/98349106604>\nimage: Schedule <https://moodle.jku.at/pluginfile.php/9/mod_label/intro/schedule.png>", cards["10"]["text"])
check("and the image is one of its files", {"schedule.png": "https://moodle.jku.at/pluginfile.php/9/mod_label/intro/schedule.png"}, cards["10"]["files"])
check("an assignment card keeps Moodle's dates", "Geöffnet: Dienstag, 3. März 2026, 18:00 Fällig: Donnerstag, 5. März 2026, 07:00", cards["13"]["dates"])
check("a restriction reads once, in full", "Nicht verfügbar, außer: Sie sind in Kurs 365.215, UE Hands-on AI I, Mohammed Abbass / Rainer Dangl, 2025W",
      cards["14"]["restrictions"])
wire.sent.clear()
moodle.activity_detail(m, {"name": "Sheet", "module": "resource", **cards["11"]}, "11", None, set(), [], "Forums › Sheet")
check("an unfinished view requirement does not keep the page closed", 1, len(wire.sent))

# --- an activity's own page: its text with links, without the countdown that changes by the minute

ASSIGN_PAGE = """<div id="region-main"><div class="activity-header"><div id="intro"><p>Submit before Thursday 8:00.
 Template: <a href="https://moodle.jku.at/pluginfile.php/5/mod_assign/introattachment/0/template.tex">template.tex</a></p></div></div>
<div role="main"><table class="generaltable"><tr><th>Abgabestatus</th><td>Zur Bewertung abgegeben</td></tr>
<tr><th>Verbleibende Zeit</th><td>213 Tage 11 Stunden zu spät</td></tr>
<tr><th>Feedback als Kommentar</th><td>See <a href="view.php?id=13&amp;action=grading">the grading notes</a></td></tr></table>
<div class="comment-area"><span>___picture___ ___name___ - ___time___</span></div></div></div>"""
m, wire = session({"/mod/assign/view.php": ASSIGN_PAGE})
got = moodle.detail(m, "assign", "13")
check("an assignment's description, status and feedback, links kept, relative ones made absolute", "\n".join([
    "Submit before Thursday 8:00. Template: template.tex <https://moodle.jku.at/pluginfile.php/5/mod_assign/introattachment/0/template.tex>",
    "Abgabestatus Zur Bewertung abgegeben",
    "Feedback als Kommentar See the grading notes <https://moodle.jku.at/mod/assign/view.php?id=13&action=grading>",
]), got["content"])
check("and its files", {"template.tex": "https://moodle.jku.at/pluginfile.php/5/mod_assign/introattachment/0/template.tex"}, got["files"])
check("a parameter Moodle mints on every view is dropped", "https://moodle.jku.at/mod/assign/view.php?id=11905436&rownum=0&nonjscomment=1",
      moodle.absolute("https://moodle.jku.at/mod/assign/view.php?id=11905436&rownum=0&useridlistid=6ac29775ea483312580166&nonjscomment=1"))
check("a session key in a link is dropped, the rest kept", "https://moodle.jku.at/filter/opencast/ltilaunch.php?courseid=42975&episodeid=8b47",
      moodle.absolute("https://moodle.jku.at/filter/opencast/ltilaunch.php?courseid=42975&sesskey=1EwtB8zIjh&episodeid=8b47"))

# --- an activity page is opened again only when something says it changed

m, wire = session()
before = {"name": "Notes", "module": "resource", "files": {"a.pdf": "u"}}
check("an unchanged activity carries its files over", {"files": {"a.pdf": "u"}},
      moodle.activity_detail(m, {"name": "Notes", "module": "resource"}, "20", before, set(), [], ""))
check("without opening its page", [], wire.sent)
moodle.activity_detail(m, {"name": "Notes", "module": "resource"}, "20", before, {"20"}, [], "")
check("one Moodle reports changed is opened again", 1, len(wire.sent))
wire.sent.clear()
moodle.activity_detail(m, {"name": "Notes", "module": "resource"}, "20", before, None, [], "")
check("in a course whose update check fails, it is opened every run", 1, len(wire.sent))

# --- a forum: every discussion with all its posts

FORUM_PAGE = """<div id="region-main"><div role="main"><table>
<tr class="discussion" data-discussionid="173014"><th class="topic"><a href="https://moodle.jku.at/mod/forum/discuss.php?d=173014">Results of VL exam 03.07.2026</a></th>
 <td class="author"><div class="author-info"><div class="text-truncate">Luca Gerardo-Giorda</div><time data-timestamp="1784482375"></time></div></td>
 <td><time data-timestamp="1784482375"></time></td><td class="p-0 text-center"><span>1</span></td></tr>
</table></div></div>"""
POSTS = {"posts": [
    {"id": 340221, "subject": "Results of VL exam 03.07.2026 ", "author": {"fullname": "Luca Gerardo-Giorda"}, "parentid": None,
     "timecreated": 1784482375, "timemodified": 1784482375,
     "message": "<p>Dear all, </p>\r\n<p>The results are available on <a href=\"https://kusss.jku.at\">KUSSS</a>. </p>",
     "attachments": [{"filename": "grades.pdf", "url": "https://moodle.jku.at/webservice/pluginfile.php/13916849/mod_forum/attachment/340221/grades.pdf"}],
     "messageinlinefiles": []},
    {"id": 340300, "subject": "Re: Results", "author": {"fullname": "A Student"}, "parentid": 340221,
     "timecreated": 1784490000, "timemodified": 1784490000, "message": "<p>Thanks!</p>", "attachments": [], "messageinlinefiles": []}]}
m, wire = session({"/mod/forum/view.php": FORUM_PAGE}, {"mod_forum_get_discussion_posts": POSTS})
forum = moodle.activity_detail(m, {"name": "Announcements", "module": "forum", "topics": 1, "posts": 2}, "21", None, set(), [], "Forums › Announcements")
check("each discussion comes with every post, the message's links kept", {
    "340221": {"subject": "Results of VL exam 03.07.2026", "author": "Luca Gerardo-Giorda", "created": "2026-07-19T17:32+00:00",
               "modified": "2026-07-19T17:32+00:00", "message": "Dear all,\nThe results are available on KUSSS <https://kusss.jku.at>.",
               "files": {"grades.pdf": "https://moodle.jku.at/pluginfile.php/13916849/mod_forum/attachment/340221/grades.pdf"}},
    "340300": {"subject": "Re: Results", "author": "A Student", "created": "2026-07-19T19:40+00:00", "modified": "2026-07-19T19:40+00:00",
               "parent": "340221", "message": "Thanks!"},
}, forum["discussions"]["173014"]["posts"])
wire.sent.clear()
again = moodle.activity_detail(m, {"name": "Announcements", "module": "forum", "topics": 1, "posts": 3},
                               "21", {"name": "Announcements", "module": "forum", "topics": 1, "posts": 2, **forum}, set(), [], "")
check("a forum with a new reply is opened again, but a discussion whose last post is unchanged is not reread",
      (1, 0), (len([u for _, u in wire.sent if "view.php" in u]), len([u for _, u in wire.sent if "service.php" in u])))
check("and keeps its posts", forum["discussions"]["173014"]["posts"], again["discussions"]["173014"]["posts"])
m.s.broken = {"mod_forum_get_discussion_posts"}
newer = {"173014": forum["discussions"]["173014"] | {"modified": "2026-07-20T08:00+00:00", "replies": 2}}
gaps = []
kept = moodle.discussion_posts(m, {k: {kk: vv for kk, vv in v.items() if kk != "posts"} for k, v in newer.items()}, forum["discussions"], gaps, "Forums › Announcements")
check("posts that fail to load are a gap, and the discussion keeps what its old posts were read against",
      (1, "2026-07-19T17:32+00:00", 1), (len(gaps), kept["173014"]["modified"], kept["173014"]["replies"]))
m.s.broken = set()
wire.sent.clear()
moodle.discussion_posts(m, {k: {kk: vv for kk, vv in v.items() if kk != "posts"} for k, v in newer.items()}, kept, [], "")
check("so the next run reads them again", 1, len([u for _, u in wire.sent if "service.php" in u]))
check("two files under one name both stay", {"Loesung.pdf": "https://moodle.jku.at/pluginfile.php/1/a/Loesung.pdf", "Loesung (2).pdf": "https://moodle.jku.at/pluginfile.php/2/b/Loesung.pdf"},
      moodle.merge_files({"Loesung.pdf": "https://moodle.jku.at/pluginfile.php/1/a/Loesung.pdf"}, {"Loesung.pdf": "https://moodle.jku.at/pluginfile.php/2/b/Loesung.pdf"}))

# --- a dropped connection is tried again; one that keeps dropping is a gap, not a crash

moodle.RETRIES = (0, 0)
m, wire = session({"/mod/page/view.php": "<div id='region-main'><div role='main'><p>Exam on 3 July</p></div></div>"})
wire.drops = 2
check("a page whose connection dropped twice is read on the third try", "Exam on 3 July", moodle.detail(m, "page", "5")["content"])
wire.drops = 3
gaps = []
moodle.activity_detail(m, {"name": "Rules", "module": "page"}, "5", None, set(), gaps, "Info › Rules")
check("one that drops three times is a gap", ["Info › Rules"], [g["where"] for g in gaps])
wire.drops = 3
failed = moodle.activity_detail(m, {"name": "Rules", "module": "page"}, "5", None, set(), [], "Info › Rules")
check("the activity says its page could not be read", True, failed["unread"].startswith("its page could not be read"))
wire.drops, before_count = 0, len(wire.sent)
moodle.activity_detail(m, {"name": "Rules", "module": "page"}, "5", {"name": "Rules", "module": "page", **failed}, set(), [], "Info › Rules")
check("and is read again next run though Moodle reports no change", 1, len(wire.sent) - before_count)
check("names arrive unescaped", "Q&A Forum", moodle.name_of("Q&amp;A  Forum"))

# --- what a snapshot could not read, it lists as a gap with the reason; what it lacks by design, apart

STATE = json.dumps({"course": {"id": "7"}, "section": [{"id": "70", "title": "Material", "cmlist": ["71", "72", "73", "74"], "visible": True}],
                    "cm": [{"id": "71", "name": "Sheet 1", "module": "resource", "url": "https://moodle.jku.at/mod/resource/view.php?id=71", "visible": True, "uservisible": True},
                           {"id": "72", "name": "Exam registration", "module": "page", "url": "https://moodle.jku.at/mod/page/view.php?id=72", "visible": True, "uservisible": False},
                           {"id": "73", "name": "Tutor tool", "module": "lti", "url": "https://moodle.jku.at/mod/lti/view.php?id=73", "visible": True, "uservisible": True},
                           {"id": "74", "name": "Recordings", "module": "opencast", "url": "https://moodle.jku.at/mod/opencast/view.php?id=74", "visible": True, "uservisible": True}]})
course = {"id": 7, "name": "C", "folder": "c", "url": "u", "hidden": False}
m, wire = session({"/course/view.php": "<ul></ul>"}, {"core_courseformat_get_state": STATE}, broken={"/mod/resource/view.php", "core_course_get_updates_since"})
lacks = moodle.Lacks()
snap = moodle.scrape_course(m, course, {"sections": {}}, 1790000000, lacks)
gaps = lacks.gaps
check("the page that could not be read is the one gap, a failed read saying why",
      [("Material › Sheet 1", True, True)],
      [(g["where"], g["reason"].startswith("its page could not be read (500 Server Error"), g["failed"]) for g in gaps])
check("an activity Moodle shows max as unavailable is withheld, not a gap", ["Material › Exam registration"],
      [w["where"] for w in lacks.withheld])
notes = {n["where"]: n["note"] for n in lacks.notes}
check("an activity type that acts on opening is a note saying why it stays closed",
      "its page is not opened: opening launches an outside tool with max's identity, which may act in his name", notes["Material › Tutor tool"])
check("the failing update check and the streamed recordings are course-wide notes",
      [True, True], sorted(any(n["note"].startswith(p) for n in lacks.notes if n["where"] == "")
                           for p in ("Moodle's update check fails", "1 recording(s) not downloaded: Opencast only streams them")))
check("and no LTI page went out", [], [u for _, u in wire.sent if "/mod/lti/" in u])

RESTRICTED = json.dumps({"course": {"id": "7"}, "section": [{"id": "70", "title": "Übungen", "cmlist": ["81"], "visible": True}],
                         "cm": [{"id": "81", "name": "Group 3 slot", "module": "page", "url": "https://moodle.jku.at/mod/page/view.php?id=81",
                                 "visible": True, "uservisible": False}]})
GROUP_PAGE = ('<ul><li class="activity" data-id="81"><div data-region="availabilityinfo">Nicht verfügbar, es sei denn: '
              'Sie gehören zu <strong>Gruppe 3</strong></div></li></ul>')
m, wire = session({"/course/view.php": GROUP_PAGE}, {"core_courseformat_get_state": RESTRICTED, "core_course_get_updates_since": {"instances": []}})
lacks = moodle.Lacks()
moodle.scrape_course(m, course, {"sections": {}}, 1790000000, lacks)
check("an activity restricted to another group is withheld with Moodle's restriction, and no gap",
      ([{"where": "Übungen › Group 3 slot", "restrictions": "Nicht verfügbar, es sei denn: Sie gehören zu Gruppe 3"}], []),
      (lacks.withheld, lacks.gaps))

PREV = {"assignments": {"401": {"name": "Homework 1", "module": "assign", "due": "Donnerstag, 12. März, 08:00", "submission": "Keine Abgabe"}},
        "sections": {"70": {"name": "Material", "items": {}}}}
STATE2 = json.dumps({"course": {"id": "7"}, "section": [{"id": "70", "title": "Material", "cmlist": ["401"], "visible": True}],
                     "cm": [{"id": "401", "name": "Homework 1", "module": "assign", "url": "https://moodle.jku.at/mod/assign/view.php?id=401", "visible": True, "uservisible": True}]})
m, wire = session({"/course/view.php": "<ul></ul>"}, {"core_courseformat_get_state": STATE2, "core_course_get_updates_since": {"instances": []}},
                  broken={"/mod/assign/index.php"})
overview = moodle.Lacks()
snap = moodle.scrape_course(m, course, PREV, 1790000000, overview)
check("an overview page that fails keeps the last snapshot's due dates and statuses", PREV["assignments"], snap["assignments"])
check("and is a failed read", [("assign overview", True)], [(g["where"], g["failed"]) for g in overview.gaps])

out = io.StringIO()
named = {"course": 7, "name": "C", "folder": "c"}
with contextlib.redirect_stdout(out):
    moodle.show({"courses": {}}, {"courses": {}, "gaps": [named | g for g in gaps],
                                  "withheld": [named | {"where": "Übungen › Group 3 slot", "restrictions": "Sie gehören zu Gruppe 3"}],
                                  "notes": [named | {"where": "", "note": "1 recording(s) not downloaded"}]}, False)
check("snapshot and diff print the gaps, then the withheld activities and the notes, after the changes",
      "no changes\n\nmissing from the snapshot (1):\n  c › Material › Sheet 1: its page could not be read (500 Server Error for /mod/resource/view.php)\n"
      "\nwithheld from max (1):\n  c › Übungen › Group 3 slot: Sie gehören zu Gruppe 3\n"
      "\nnotes (1):\n  c: 1 recording(s) not downloaded\n", out.getvalue())

# --- a snapshot: past semesters' courses read less often, failed reads fail the run

ENROLLED = {"courses": [{"id": 1, "fullname": "344.001, UE Logic, A. Lecturer, 2025W"},
                        {"id": 2, "fullname": "357.260, VL / UE Mathematics for AI III, B. Lecturer, 2026W"}]}
EMPTY_STATE = json.dumps({"course": {}, "section": [], "cm": []})
LAST = {"taken": "2026-10-07T08:00:00+00:00", "scraped": {"1": "2026-10-07T08:00:00+00:00", "2": "2026-10-07T08:00:00+00:00"},
        "gaps": [{"course": 1, "name": "L", "folder": "2025W-ue-logic", "where": "x", "reason": "its page could not be read (500)", "failed": True}],
        "withheld": [{"course": 1, "name": "L", "folder": "2025W-ue-logic", "where": "Group 3 slot", "restrictions": "Gruppe 3"}],
        "notes": [{"course": 1, "name": "L", "folder": "2025W-ue-logic", "where": "", "note": "2 recording(s) not downloaded"}],
        "courses": {"1": {"name": "Logic", "folder": "2025W-ue-logic"}, "2": {"name": "Math III", "folder": "2026W-vl-ue-mathematics-for-ai-iii"}}}


def take(past_every: float, now: str, prev=LAST, broken=None):
    m, wire = session({"/course/view.php": "<ul></ul>"}, {"core_course_get_enrolled_courses_by_timeline_classification": ENROLLED,
                                                         "core_courseformat_get_state": EMPTY_STATE,
                                                         "core_course_get_updates_since": {"instances": []}}, broken)
    with contextlib.redirect_stderr(io.StringIO()):
        snap, failed = moodle.take(m, moodle.Snapshot(download=False, past_every=past_every), prev, datetime.fromisoformat(now))
    return snap, failed, sorted(c for c, t in snap["scraped"].items() if t != prev["scraped"].get(c))


snap, failed, read = take(24, "2026-10-07T20:00:00+00:00")
check("a past semester's course read 12 hours ago is carried over, the current one read", ["2"], read)
check("and keeps when it was read, and its gaps", ("2026-10-07T08:00:00+00:00", ["x"]),
      (snap["scraped"]["1"], [g["where"] for g in snap["gaps"] if g.get("course") == 1]))
check("a gap carried from an earlier run is no failed read of this one", (0, [None]),
      (failed, [g.get("failed") for g in snap["gaps"] if g.get("course") == 1]))
check("and it keeps its withheld activities and notes", (LAST["withheld"], LAST["notes"]),
      (snap["withheld"], [n for n in snap["notes"] if n.get("course") == 1]))
check("a snapshot taken without downloads says so in a note, not a gap", (["files not downloaded: run with --no-download"], []),
      ([n["note"] for n in snap["notes"] if n.get("course") is None], [g for g in snap["gaps"] if g.get("course") is None]))
snap, failed, read = take(24, "2026-10-08T09:00:00+00:00")
check("once its last read is a day old, it is read again", ["1", "2"], read)
check("without --past-every every course is read", ["1", "2"], take(0, "2026-10-07T09:00:00+00:00")[2])
first = {"taken": None, "scraped": {}, "gaps": [], "courses": {}}
check("a past semester's course no snapshot has yet is read", ["1", "2"], take(24, "2026-10-07T09:00:00+00:00", first)[2])
snap, failed, read = take(0, "2026-10-07T09:00:00+00:00", broken={"core_courseformat_get_state"})
check("a course Moodle refuses is a failed read, counted once per course", 2, failed)
check("and keeps the last snapshot's copy, marked failed", (LAST["courses"]["1"], [True]),
      (snap["courses"]["1"], [g.get("failed") for g in snap["gaps"] if g.get("course") == 1 and g["where"] == ""]))

check("a semester ends when the next begins: winter in March, summer in October",
      [False, True, False, True, True, False],
      [moodle.ended("2025W-x", moodle.date(2026, 2, 28)), moodle.ended("2025W-x", moodle.date(2026, 3, 1)),
       moodle.ended("2026S-x", moodle.date(2026, 9, 30)), moodle.ended("2026S-x", moodle.date(2026, 10, 1)),
       moodle.ended("2026S-x", moodle.date(2027, 1, 15)), moodle.ended("no-semester", moodle.date(2030, 1, 1))])

out = io.StringIO()
later = {"taken": "2026-10-07T20:00:00+00:00", "scraped": {"1": "2026-10-07T08:00:00+00:00"}, "gaps": [],
         "withheld": LAST["withheld"], "notes": [],
         "courses": {"1": {"name": "Logic", "folder": "2025W-ue-logic"}}}
with contextlib.redirect_stdout(out):
    moodle.show(LAST, later, True)
shown = json.loads(out.getvalue())
check("as JSON: when it was taken, since when, each course's last read, changes, gaps, withheld activities and notes",
      {"taken": "2026-10-07T20:00:00+00:00", "since": "2026-10-07T08:00:00+00:00",
       "courses": [{"course": 1, "name": "Logic", "folder": "2025W-ue-logic", "scraped": "2026-10-07T08:00:00+00:00"}], "gaps": [],
       "withheld": LAST["withheld"], "notes": []},
      {k: v for k, v in shown.items() if k != "changes"})
check("a course gone from the snapshot is a change", [("removed", "Math III")], [(c["change"], c["course"]) for c in shown["changes"]])
out = io.StringIO()
with contextlib.redirect_stdout(out):
    moodle.show(None, later, True)
check("a first snapshot has no earlier one and no changes", (None, []), (json.loads(out.getvalue())["since"], json.loads(out.getvalue())["changes"]))

# --- the forum overview gives topic and post counts, without the unread count Moodle appends

FORUM_INDEX = """
<table class="generaltable"><thead><tr><th>Name</th><th>Markieren?</th><th>Abonniert</th><th>Digest-Typ</th><th>Themen</th><th>Beiträge</th></tr></thead>
<tbody><tr><td><a href="https://moodle.jku.at/mod/forum/view.php?id=12843629">Questions about the Organization</a></td>
<td>Ungelesene Beiträge markieren: Verpflichtend</td><td><a href="#">Forum abonnieren</a></td><td>Standard</td><td>69</td><td>150 ( 1 )</td></tr></tbody></table>"""
m, wire = session({"/mod/forum/index.php": FORUM_INDEX})
check("topics and posts per forum", {"12843629": {"topics": 69, "posts": 150}}, moodle.index_rows(m, "forum", 1))

# --- the assignment overview reads as Moodle shows it

ASSIGN_INDEX = """
<table class="generaltable"><thead><tr><th>Name</th><th>Fälligkeitsdatum</th><th>Abgabestatus</th><th>Bewertung</th></tr></thead>
<tbody>
<tr><td><a href="https://moodle.jku.at/mod/assign/view.php?id=12819680">Submit homework assignment 1 (13 points)</a> Exercise</td>
    <td>Donnerstag, 12. März, 08:00</td><td>Zur Bewertung abgegeben</td><td>10,50</td></tr>
<tr><td><a href="https://moodle.jku.at/mod/assign/view.php?id=13002690">Submit homework assignment 9</a></td>
    <td>Donnerstag, 11. Juni, 08:00</td><td>Keine Abgabe</td><td>-</td></tr>
</tbody></table>"""
