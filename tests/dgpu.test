#!/usr/bin/env bash
# Drive bin/dgpu against a fake sysfs and /dev tree. Run it directly; no framework.
#
# The decisions under test: the dGPU is the display device that is not the
# boot VGA, and only its device files change; lock takes every bit, unlock
# gives back what udev sets; auto locks only on battery with none of the
# dGPU's outputs connected, found through its PCI device whatever the card
# numbers; install runs auto after a wake and on a monitor hotplug. That a
# failed open keeps a real dGPU in D3cold, and that the hook and the rule run
# before gnome-shell draws, show only on the hardware.

set -uo pipefail

script="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/dgpu"
root=$(mktemp -d)
trap 'rm -rf "$root"' EXIT

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

mode() { stat -L -c %a "$1"; }

# An iGPU at 00:02.0 that owns the console, an NVIDIA dGPU at 01:00.0 in
# D3cold, and the charger plugged in. The layout is a real sysfs's: each card
# sits under its PCI device with its outputs inside it, /sys/class/drm links to
# both, and the by-path links point at the /dev nodes the way udev lays them
# out. An output's device is its card, not a PCI device. The laptop panel is on
# the iGPU and connected; the dGPU's two ports are empty.
#
# fresh_tree <igpu card number> <dgpu card number>; the numbers change between
# boots, so the default is this boot's order and a case can swap it.
fresh_tree() {
    igpu_card=${1:-0} dgpu_card=${2:-1}
    rm -rf "${root:?}"/{sys,dev,ps}
    mkdir -p "$root/sys/drm" "$root/sys/drivers/i915" "$root/sys/drivers/nvidia" \
             "$root/dev/dri/by-path" "$root/ps/AC0" "$root/ps/BAT0"
    card 0000:00:02.0 "$igpu_card" i915 1 eDP-1 DP-1 DP-2
    card 0000:01:00.0 "$dgpu_card" nvidia 0 DP-3 HDMI-A-1
    echo D3cold > "$root/sys/pci/0000:01:00.0/power_state"
    output igpu eDP-1 connected
    local n
    for n in nvidia0 nvidiactl nvidia-modeset nvidia-uvm; do
        : > "$root/dev/$n"; chmod 0666 "$root/dev/$n"
    done
    echo Mains > "$root/ps/AC0/type"; echo 1 > "$root/ps/AC0/online"
    echo Battery > "$root/ps/BAT0/type"
}

card() { # addr number driver boot_vga output...
    local addr=$1 n=$2 driver=$3 boot_vga=$4 pci="$root/sys/pci/$1" o
    shift 4
    mkdir -p "$pci/drm/card$n"
    echo 0x030000 > "$pci/class"
    echo "$boot_vga" > "$pci/boot_vga"
    ln -s "../../drivers/$driver" "$pci/driver"
    ln -s ../.. "$pci/drm/card$n/device"
    ln -s "../pci/$addr/drm/card$n" "$root/sys/drm/card$n"
    for o in "$@"; do
        mkdir "$pci/drm/card$n/card$n-$o"
        ln -s .. "$pci/drm/card$n/card$n-$o/device"
        echo disconnected > "$pci/drm/card$n/card$n-$o/status"
        ln -s "../pci/$addr/drm/card$n/card$n-$o" "$root/sys/drm/card$n-$o"
    done
    : > "$root/dev/dri/card$n"; : > "$root/dev/dri/renderD$((128 + n))"
    chmod 0660 "$root/dev/dri/card$n" "$root/dev/dri/renderD$((128 + n))"
    ln -s "../card$n" "$root/dev/dri/by-path/pci-$addr-card"
    ln -s "../renderD$((128 + n))" "$root/dev/dri/by-path/pci-$addr-render"
}

output() { # igpu|dgpu connector status
    local n
    if [ "$1" = igpu ]; then n=$igpu_card; else n=$dgpu_card; fi
    echo "$3" > "$root/sys/drm/card$n-$2/status"
}

run() {
    DGPU_SYSFS_DRM="$root/sys/drm" DGPU_DEV="$root/dev" DGPU_POWER_SUPPLY="$root/ps" DGPU_NODE_WAIT=0 "$script" "$@"
}

on_battery() { echo 0 > "$root/ps/AC0/online"; }

modes() { # the dGPU's nodes, then the iGPU's
    local p="$root/dev/dri/by-path"
    echo "$(mode "$p/pci-0000:01:00.0-card") $(mode "$p/pci-0000:01:00.0-render") $(mode "$root/dev/nvidia0") $(mode "$root/dev/nvidiactl") $(mode "$root/dev/nvidia-modeset") $(mode "$root/dev/nvidia-uvm") / $(mode "$p/pci-0000:00:02.0-card") $(mode "$p/pci-0000:00:02.0-render")"
}

# --- lock and unlock

fresh_tree
run lock
check "lock succeeds" 0 $?
check "the dGPU's nodes lose every bit, the iGPU's keep theirs" \
    "0 0 0 0 0 0 / 660 660" "$(modes)"
check "status says so" "dgpu: 0000:01:00.0 driver nvidia, D3cold, locked" "$(run status | head -1)"

run unlock
check "unlock succeeds" 0 $?
check "and restores udev's modes" "660 660 666 666 666 666 / 660 660" "$(modes)"
check "status says so" "dgpu: 0000:01:00.0 driver nvidia, D3cold, unlocked" "$(run status | head -1)"

# --- auto follows the charger

fresh_tree
on_battery
run auto
check "on battery auto locks" "0 0 0 0 0 0 / 660 660" "$(modes)"
check "and status says battery" "power: battery" "$(run status | grep '^power:')"
echo 1 > "$root/ps/AC0/online"
run auto
check "on AC auto unlocks" "660 660 666 666 666 666 / 660 660" "$(modes)"

# --- a node that is not there is skipped, not an error

fresh_tree
rm "$root/dev/nvidia-uvm"
run lock
check "lock succeeds without the uvm node" 0 $?
check "and locks the rest" "0 0 0 0 0" \
    "$(mode "$root/dev/dri/card1") $(mode "$root/dev/dri/renderD129") $(mode "$root/dev/nvidia0") $(mode "$root/dev/nvidiactl") $(mode "$root/dev/nvidia-modeset")"

# --- the render node has not arrived yet: lock what is there, and say so

fresh_tree
rm "$root/dev/dri/by-path/pci-0000:01:00.0-render"
on_battery
err=$(run auto 2>&1 >/dev/null)
check "auto without the render node exits 0" 0 $?
check "locks the nodes that exist" "0 0 0 0 0" \
    "$(mode "$root/dev/dri/card1") $(mode "$root/dev/nvidia0") $(mode "$root/dev/nvidiactl") $(mode "$root/dev/nvidia-modeset") $(mode "$root/dev/nvidia-uvm")"
check "and names the gap" "dgpu: 0000:01:00.0 has no render node under $root/dev/dri/by-path yet, lock applied to the rest" "$err"

# --- an AMD dGPU has no /dev/nvidia* to touch

fresh_tree
rm "$root/sys/pci/0000:01:00.0/driver"
mkdir -p "$root/sys/drivers/amdgpu"
ln -s ../../drivers/amdgpu "$root/sys/pci/0000:01:00.0/driver"
run lock
check "an amdgpu dGPU locks its dri nodes only" "0 0 666 666 666 666 / 660 660" "$(modes)"

# --- no dGPU on the bus

fresh_tree
rm -r "$root/sys/drm/card1"
no_dgpu="no dGPU with a driver bound (is the card on the bus: lspci -d 10de:; is its driver loaded: lsmod)"
out=$(run lock 2>&1)
check "without a dGPU lock fails" 1 $?
check "and says what to check" "dgpu: $no_dgpu" "$out"
check "status says the same" "dgpu: $no_dgpu" "$(run status | head -1)"
run auto 2>/dev/null
check "auto, what the unit runs, exits 0 instead" 0 $?
check "and the iGPU is untouched" "660 660" "$(mode "$root/dev/dri/card0") $(mode "$root/dev/dri/renderD128")"

# --- a monitor on a dGPU port keeps it unlocked on battery

fresh_tree
on_battery
output dgpu DP-3 connected
err=$(run auto 2>&1 >/dev/null)
check "on battery with a monitor on the dGPU auto leaves it unlocked" \
    "660 660 666 666 666 666 / 660 660" "$(modes)"
check "and says why" "dgpu: on battery with a monitor on card1-DP-3, unlocked" "$err"
run lock
run auto 2>/dev/null
check "and unlocks a card locked by hand" "660 660 666 666 666 666 / 660 660" "$(modes)"
check "status names the dGPU's outputs and which is connected" \
    "outputs: card1-DP-3 connected, card1-HDMI-A-1 disconnected" "$(run status | grep '^outputs:')"
output dgpu DP-3 disconnected
run auto
check "the monitor unplugged, auto locks" "0 0 0 0 0 0 / 660 660" "$(modes)"

fresh_tree
on_battery
output dgpu DP-3 unknown
output igpu DP-1 connected
run auto
check "a monitor on the iGPU, or an output in an unknown state, does not stop the lock" \
    "0 0 0 0 0 0 / 660 660" "$(modes)"

# --- the outputs are the dGPU's whatever this boot numbered the cards

fresh_tree 1 0
on_battery
output dgpu HDMI-A-1 connected
run auto 2>/dev/null
check "the dGPU as card0: its monitor keeps it unlocked" "660 660 666 666 666 666 / 660 660" "$(modes)"
check "and status names card0's outputs" \
    "outputs: card0-DP-3 disconnected, card0-HDMI-A-1 connected" "$(run status | grep '^outputs:')"
output dgpu HDMI-A-1 disconnected
output igpu DP-1 connected
run auto
check "the dGPU as card0: a monitor on the iGPU's card1 does not stop the lock" \
    "0 0 0 0 0 0 / 660 660" "$(modes)"

# --- install and reset, into a fake root, with sudo, systemctl and udevadm stubbed

fresh_tree
on_battery
fs="$root/fs" stubs="$root/stubs" calls="$root/calls"
mkdir -p "$fs/usr/local/sbin" "$fs/etc/systemd/system" "$fs/etc/udev/rules.d" "$stubs"
printf '#!/bin/sh\nexec "$@"\n' > "$stubs/sudo"
printf '#!/bin/sh\necho "$(basename "$0") $*" >> "%s"\n' "$calls" > "$stubs/systemctl"
cp "$stubs/systemctl" "$stubs/udevadm"
chmod +x "$stubs"/*
installing() { PATH="$stubs:$PATH" DGPU_ROOT="$fs" run "$@"; }

installing install >/dev/null
check "install succeeds" 0 $?
hook="$fs/etc/systemd/system-sleep/dgpu"
unit="$fs/etc/systemd/system/dgpu-auto.service"
rule="$fs/etc/udev/rules.d/99-dgpu.rules"
check "install writes the copy, the unit, the sleep hook and the rule" "yes yes yes yes" \
    "$([ -x "$fs/usr/local/sbin/dgpu" ] && echo yes) $([ -f "$unit" ] && echo yes) $([ -x "$hook" ] && echo yes) $([ -f "$rule" ] && echo yes)"
check "and ran auto" "0 0 0 0 0 0 / 660 660" "$(modes)"
check "the unit starts at boot and on no wake target" \
    "WantedBy=multi-user.target" "$(grep -E '^WantedBy=|^After=|sleep|suspend|hibernate' "$unit")"
check "enabling the unit drops the links an older one left in the wake targets" \
    "systemctl reenable --quiet dgpu-auto.service" "$(grep -w reenable "$calls")"
check "a monitor plugged in or out runs auto from the rule, before udev passes the event on" \
    "ACTION==\"change\", SUBSYSTEM==\"drm\", ENV{DEVTYPE}==\"drm_minor\", KERNEL==\"card*\", RUN+=\"/usr/bin/env DGPU_NODE_WAIT=0 $fs/usr/local/sbin/dgpu auto\"" \
    "$(grep 'SUBSYSTEM=="drm"' "$rule" | grep change)"
run unlock
DGPU_SYSFS_DRM="$root/sys/drm" DGPU_DEV="$root/dev" DGPU_POWER_SUPPLY="$root/ps" DGPU_NODE_WAIT=0 sh "$hook" pre
check "the hook does nothing before the sleep" "660 660 666 666 666 666 / 660 660" "$(modes)"
DGPU_SYSFS_DRM="$root/sys/drm" DGPU_DEV="$root/dev" DGPU_POWER_SUPPLY="$root/ps" DGPU_NODE_WAIT=0 sh "$hook" post
check "and runs auto after the wake" "0 0 0 0 0 0 / 660 660" "$(modes)"
check "status sees the hook" "sleep hook: $hook installed" "$(installing status | grep '^sleep hook:')"

installing reset >/dev/null
check "reset succeeds" 0 $?
check "and removes the copy, the unit, the hook and the rule" "" \
    "$(find "$fs" -type f)"
check "and unlocks" "660 660 666 666 666 666 / 660 660" "$(modes)"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
else
    echo "$failures check(s) failed"
fi
exit $((failures > 0))
