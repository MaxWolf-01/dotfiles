#!/usr/bin/env bash
# tier: full-path (logind's inhibitors, systemd user units, tmux)
# Drive bin/nosleep against real inhibitors. Run it directly; no framework.
#
# What matters here is that every hold that can refuse a suspend is listed with
# a cancel command that actually works, whoever took it: `job`, a detached -b,
# or a bare foreground run. The identity is derived from the process, because a
# hold taken by hand carries no label and still has to be clearable.

set -uo pipefail

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
nosleep="$bin/nosleep"
job="$bin/job"
export JOB_STATE_DIR
JOB_STATE_DIR=$(mktemp -d)
# The detached hold gets a unit of its own: under nosleep's own name, it would
# replace a hold the user is running, and the cleanup would stop it.
export NOSLEEP_UNIT="nosleep-test-$$"
cleanup() {
    "$job" rm nst-hold >/dev/null 2>&1
    systemctl --user stop "$NOSLEEP_UNIT" >/dev/null 2>&1
    [ -n "${bare_pid:-}" ] && kill "$bare_pid" 2>/dev/null
    [ -n "${stand_in:-}" ] && [ "$(systemctl --user show -P InvocationID nosleep)" = "$stand_in" ] &&
        systemctl --user stop nosleep
    rm -rf "$JOB_STATE_DIR"
}
trap cleanup EXIT

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"

needs systemd-inhibit systemctl tmux
# logind refuses a block inhibitor to a session polkit does not count as
# active, and a headless host has no seat to make a session active.
if ! refusal=$(systemd-inhibit --what=sleep --mode=block --who=nosleep.test --why=probe true 2>&1); then
    skip "this user cannot hold sleep open here: $refusal"
fi

# The user's own detached hold, or a stand-in this suite takes under nosleep's
# own name when none is running: nothing the suite does to its holds touches it.
if ! systemctl --user is-active --quiet nosleep; then
    NOSLEEP_UNIT=nosleep "$nosleep" -b sleep 600 >/dev/null
    stand_in=$(systemctl --user show -P InvocationID nosleep)
fi
theirs=$(systemctl --user show -P InvocationID nosleep)

row() { "$nosleep" --list | awk -v w="$1" '$1 == w || $1" "$2 == w'; }

# Scoped to this suite's own holds throughout: the machine may legitimately be
# running a job of its own, and a test that demands an idle machine fails for
# the wrong reason. The delay-mode holds NetworkManager and GNOME always have
# never show up here at all, since they postpone a suspend and never refuse one.
mine() { "$nosleep" --list | grep -cE 'nst-hold|sleep 120' || true; }
check "this suite starts with no holds of its own" 0 "$(mine)"

# Orphaned at once: a hold with a job up its parent chain lists as the job's, and this suite may itself run in one.
bare_pid=$("$nosleep" sleep 120 >/dev/null 2>&1 & echo $!)
"$nosleep" -b sleep 120 >/dev/null 2>&1
"$job" run nst-hold --awake -- sleep 120 >/dev/null
sleep 2

check "all three holds are listed" 3 "$(mine)"

# A job's hold names the job, so the cancel command is one a reader can run
# without first working out which pane it came from.
check "a job's hold is cancelled through job" \
    "job stop nst-hold" "$(row 'job nst-hold' | grep -o 'job stop nst-hold')"
check "a detached hold is cancelled through systemctl" \
    "systemctl --user stop $NOSLEEP_UNIT" "$(row detached | grep -o "systemctl --user stop $NOSLEEP_UNIT")"
check "the one hold listed as detached is this suite's, not the user's" \
    "1 sleep 120" "$(row detached | wc -l) $(row detached | grep -o 'sleep 120')"
# A bare hold has no unit and no name: pid and tty are the whole of its
# identity, which is honest, because that is all a foreground hold is.
check "a bare hold is cancelled by pid" \
    "kill $bare_pid" "$(row "pid $bare_pid" | grep -o "kill $bare_pid")"

# --why replaces what the listing shows, for a wrapper whose argv says nothing.
check "job's hold shows the job, not the wrapper's command line" \
    "yes" "$(row 'job nst-hold' | grep -q 'JOB_LOG' && echo no || echo yes)"

"$job" stop nst-hold >/dev/null
sleep 1
check "stopping the job drops its hold" \
    "" "$(row 'job nst-hold')"

# The hold is opt-in, because it lasts as long as the command does: a server or
# a watcher never ends, and the laptop then stops suspending until someone
# works out why.
"$job" rm nst-hold >/dev/null
"$job" run nst-hold -- sleep 120 >/dev/null
sleep 2
check "a run without --awake takes no hold at all" "" "$(row 'job nst-hold')"

systemctl --user stop "$NOSLEEP_UNIT"
check "stopping this suite's detached hold leaves the user's running, the same one" "active $theirs" \
    "$(systemctl --user is-active nosleep) $(systemctl --user show -P InvocationID nosleep)"

finish
