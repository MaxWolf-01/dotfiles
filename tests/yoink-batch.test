#!/usr/bin/env -S uv run --script --quiet
"""Check that bin/yoink-batch saves every image of a book under a name starting with the book's.

Run it directly; no framework. yoink-batch runs as a subprocess with HOME in a
temporary directory and fake `yapit` and `sops` first on PATH, so nothing is
fetched and no real library or secret is touched. The fake yapit writes an
entry the way the real one does: `<entry>.md` and `TTS.md` embedding
`<entry>-<n>.<ext>` as `![alt](./<file>)`.
"""

import os
import subprocess
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]

FAKE_YAPIT = r"""#!/usr/bin/env bash
# yapit fetch <src> -o <dir> --name <slug> [--ai]
set -eu
while [ $# -gt 0 ]; do
  case "$1" in -o) out=$2; shift ;; --name) name=$2; shift ;; esac; shift
done
d="$out/$name"; mkdir -p "$d"
printf 'one' > "$d/$name-1.webp"
printf 'eleven' > "$d/$name-11.webp"
printf 'map' > "$d/$name-2.png"
body="![](./$name-1.webp)\n\n![A map.](./$name-2.png)\n\n![](./$name-11.webp)\n\nprose mentions $name-1.webp\n"
printf "# $name\n\n$body" > "$d/$name.md"
printf "$body" > "$d/TTS.md"
"""

failures = 0


def check(what: str, expected: object, actual: object) -> None:
    global failures
    if expected != actual:
        failures += 1
        print(f"FAIL {what}\n  expected: {expected!r}\n  actual:   {actual!r}")
    else:
        print(f"ok   {what}")


with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    fakes = root / "bin"
    fakes.mkdir()
    for name, script in {"yapit": FAKE_YAPIT, "sops": "#!/bin/sh\necho YAPIT_EMAIL=x\n"}.items():
        (fakes / name).write_text(script)
        (fakes / name).chmod(0o755)
    env = os.environ | {"HOME": str(root), "PATH": f"{fakes}:{os.environ['PATH']}"}
    r = subprocess.run(
        [REPO / "bin/yoink-batch", "my-book", "https://example.com/chapter-01",
         "intro=https://example.com/prologue"],
        env=env, capture_output=True, text=True,
    )
    check("yoink-batch exits 0", 0, r.returncode)
    if r.returncode:
        print(r.stdout[-2000:], r.stderr[-2000:])

    book = root / "Documents/library/my-book"
    check("the entries keep their directories and markdown names",
          ["chapter-01/TTS.md", "chapter-01/chapter-01.md", "intro/TTS.md", "intro/intro.md"],
          sorted(str(p.relative_to(book)) for p in book.rglob("*.md")))
    check("every image starts with the book's name",
          ["chapter-01/my-book-chapter-01-1.webp", "chapter-01/my-book-chapter-01-11.webp",
           "chapter-01/my-book-chapter-01-2.png",
           "intro/my-book-intro-1.webp", "intro/my-book-intro-11.webp", "intro/my-book-intro-2.png"],
          sorted(str(p.relative_to(book)) for p in book.rglob("*") if p.is_file() and p.suffix != ".md"))
    check("each embed points at the renamed image, and prose is left alone",
          "![](./my-book-chapter-01-1.webp)\n\n![A map.](./my-book-chapter-01-2.png)\n\n"
          "![](./my-book-chapter-01-11.webp)\n\nprose mentions chapter-01-1.webp\n",
          (book / "chapter-01/TTS.md").read_text())
    check("the entry's own note is rewritten too", True,
          "![A map.](./my-book-intro-2.png)" in (book / "intro/intro.md").read_text())

print(f"\n{'FAILED' if failures else 'passed'}: {failures} failure(s)")
raise SystemExit(1 if failures else 0)
