#!/usr/bin/env bash
# tier: fast
# Drive bin/host-slots against a slot directory in a scratch directory. Run it directly; no framework.
#
# What dispatch relies on: a machine never holds more slots than its count, however many spawns take one at once; a
# slot whose holder died, or whose pid now runs something else, is free; and a slot handed from a spawn to its runner
# stays held after the spawn exits, without a moment free in between.

set -uo pipefail

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
scratch=$(mktemp -d)
holders=()
trap 'kill "${holders[@]}" 2>/dev/null; rm -rf "$scratch"' EXIT

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"

needs flock

export HOST_SLOTS_DIR=$scratch/slots

# Starts a process whose command line carries "sleep 300", and sets $holder to its pid.
hold() { sleep 300 & holder=$!; holders+=("$holder"); }
slots() { HOST_SLOTS=$1 "$bin/host-slots" "${@:2}"; }

# --- many spawns at once

# Eight takes start together for three slots, five times over: a take that read the count before another wrote its
# slot would let a fourth through.
over=
for round in 1 2 3 4 5; do
    rm -rf "$HOST_SLOTS_DIR"
    takers=()
    for _ in 1 2 3 4 5 6 7 8; do
        hold
        ( slots 3 take "$holder" "sleep 300" 2>/dev/null; echo $? >"$scratch/took.$BASHPID" ) &
        takers+=($!)
    done
    wait "${takers[@]}"
    taken=$(cat "$scratch"/took.* | grep -cx 0)
    refused=$(cat "$scratch"/took.* | grep -cx 3)
    rm -f "$scratch"/took.*
    [ "$taken $refused" = "3 5" ] || over+="round $round: $taken taken, $refused refused; "
    kill "${holders[@]}" 2>/dev/null; holders=()
done
check "eight spawns racing for three slots take exactly three, and the rest are told every slot is held" "" "$over"

# --- holders that are gone

rm -rf "$HOST_SLOTS_DIR"
hold; dead=$holder
slots 1 take "$dead" "sleep 300" 2>/dev/null
kill "$dead"; wait "$dead" 2>/dev/null
hold
slots 1 take "$holder" "sleep 300" 2>/dev/null
check "a slot whose holder died is free" 0 "$?"

rm -rf "$HOST_SLOTS_DIR"
# This test's own pid stands for one the kernel gave to another process after the holder ended: the slot was taken
# under that pid by a run whose word this process's command line does not carry.
slots 1 take $$ "a-run-long-gone" 2>/dev/null
hold
slots 1 take "$holder" "sleep 300" 2>/dev/null
check "a slot whose pid now runs another command is free" 0 "$?"
check "that slot's file is gone" "" "$(ls "$HOST_SLOTS_DIR" | grep -F ".$$")"

# --- the hand-over

rm -rf "$HOST_SLOTS_DIR"
hold; spawn=$holder
slots 1 take "$spawn" "sleep 300" 2>/dev/null
hold; runner=$holder
slots 1 hand "$spawn" "$runner" "sleep 300"
check "a spawn hands its slot to its runner" 0 "$?"
check "a handed slot is held once, by the runner, while the spawn still lives" "1 1" "$(slots 1 count)"
kill "$spawn"; wait "$spawn" 2>/dev/null
check "the slot stays held once the spawn is gone" "1 1" "$(slots 1 count)"
hold
slots 1 take "$holder" "sleep 300" 2>/dev/null
check "and no other spawn takes it" 3 "$?"
slots 1 hand "$holder" "$runner" "sleep 300" 2>/dev/null
check "a process holding no slot hands none over" 1 "$?"

# --- the count

rm -rf "$HOST_SLOTS_DIR"
hold
slots 6 take "$holder" "sleep 300" 2>/dev/null
check "the count says the slots held and the machine's count" "1 6" "$(slots 6 count)"
HOST_SLOTS= "$bin/host-slots" count 2>/dev/null
check "with no count installed, nothing is counted or taken" 2 "$?"

finish
