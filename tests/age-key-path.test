#!/usr/bin/env bash
# tier: fast
# Check that only each host's Home Manager config says where the age key is. Run it directly; no framework.
#
# nix/home/hosts/<host>.nix sets SOPS_AGE_KEY_FILE, and common.nix hands it to every user unit and GNOME-started
# app. A script that falls back to a path of its own names a file another host lacks (pc keeps its key on tmpfs), and
# a unit that sets it hides a host config that forgot to. Both are read from the files this checkout tracks.

set -uo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 1

defaults='[$]\{SOPS_AGE_KEY_FILE:?[-=][^}]'
sets='(^|[^A-Za-z0-9_])SOPS_AGE_KEY_FILE='

# A pattern that matched nothing would pass on any tree, so each is first shown the shapes it must catch and the
# ones it must let through: an empty default only reads the variable, and another tool's key is not this one.
check "the default pattern catches a fallback path, in either form" \
    $'k="${SOPS_AGE_KEY_FILE:-$HOME/k}"\nexport SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:=/k}"' \
    "$(printf '%s\n' 'k="${SOPS_AGE_KEY_FILE:-$HOME/k}"' 'export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:=/k}"' \
        '[ -f "${SOPS_AGE_KEY_FILE:-}" ]' | grep -E "$defaults")"
check "the set pattern catches a unit line, an export and a quoted remote command" \
    $'"SOPS_AGE_KEY_FILE=/k"\nexport SOPS_AGE_KEY_FILE=/k\nssh pc \'SOPS_AGE_KEY_FILE=/k sops -d f\'\nEnvironment=SOPS_AGE_KEY_FILE=/k' \
    "$(printf '%s\n' '"SOPS_AGE_KEY_FILE=/k"' 'export SOPS_AGE_KEY_FILE=/k' "ssh pc 'SOPS_AGE_KEY_FILE=/k sops -d f'" \
        'Environment=SOPS_AGE_KEY_FILE=/k' 'export YAPIT_SOPS_AGE_KEY_FILE=/k' | grep -E "$sets")"

check "no script falls back to an age key path of its own" "" \
    "$(git grep -nE "$defaults" -- . ':!*.test')"

# Allowed: hardware-alerts.nix's system units, which no user session reaches, and `setup secrets`, which runs before
# the first Home Manager switch has set the variable.
check "no unit or script sets the age key's path, outside the host configs" "" \
    "$(git grep -nE "$sets" -- . ':!*.test' ':!tests/' ':!nix/nixos/pc/hardware-alerts.nix' ':!setup')"

finish
