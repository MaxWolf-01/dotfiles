#!/usr/bin/env bash
# Drive bin/gdr and bin/glog against a throwaway repo. Run it directly; no framework.
#
# The point of these cases is the numbering contract the two scripts share: a
# number names a position on HEAD's first-parent chain, 1 being HEAD, so what
# glog shows in its gutter is exactly what gdr's SPEC addresses.

set -uo pipefail

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
repo=$(mktemp -d)
trap 'rm -rf "$repo"' EXIT

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# History, newest first: 1 merge of side, 2 f2, 3 f3, 4 f4, 5 f5. The side branch's
# commit hangs off the merge and sits on no numbered position.
cd "$repo" || exit 1
git init -q -b main
git config user.email t@example.com
git config user.name t
for f in f5 f4 f3; do echo "$f" > "$f"; git add "$f"; git commit -qm "add $f"; done
git checkout -qb side
echo s > s1; git add s1; git commit -qm "side one"
git checkout -q main
echo f2 > f2; git add f2; git commit -qm "add f2"
git merge -q --no-ff side -m "merge side"

names() { "$bin/gdr" "$@" --name-only | grep -v '^#' | grep . | tr '\n' ' '; }
header() { "$bin/gdr" "$@" --name-only | grep '^#' | cut -d' ' -f2 | tr '\n' ' '; }

check "no spec: HEAD's own change" "s1 " "$(names)"
check "N: the newest N" "f2 f3 s1 " "$(names 3)"
check "A..B: inclusive, both ends" "f2 f3 f4 " "$(names 2..4)"
check "B..A: order does not matter" "f2 f3 f4 " "$(names 4..2)"
check "A..A: one commit" "f3 " "$(names 3..3)"
check "header numbers match the positions" "4 3 2 " "$(header 2..4)"
check "header: off-chain commit gets no number" "$(git rev-parse --short side) " "$(header side~1..side)"
check "git range passes through" "s1 " "$(names side~1..side)"

"$bin/gdr" 0..2 >/dev/null 2>&1
check "position 0 is rejected" 1 $?
"$bin/gdr" >/dev/null 2>&1 --help
check "--help exits 0" 0 $?

# glog: the gutter carries the same numbers, one per first-parent commit, blank
# on side-branch commits and on graph-only lines.
gutter=$("$bin/glog" | sed 's/^\(..\).*/\1/' | tr -d ' ' | tr '\n' ',')
check "gutter numbers the first-parent chain only" "1,,,2,,3,4,5," "$gutter"
check "gutter follows a path filter past the shown window" "3" \
    "$("$bin/glog" 1 -- f3 | cut -c1)"

[ "$failures" -eq 0 ] && echo "all ok" || { echo "$failures failing"; exit 1; }
