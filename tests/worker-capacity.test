#!/usr/bin/env bash
# tier: full-path (the systemd slices and host-slots of the worker host it runs on)
# Read a worker host's memory limits and slot tool back from the running machine, against what its NixOS config in
# this checkout declares. Run it directly, on pc or xmg19, as a worker user, once the config is switched to.
#
# What dispatch relies on: every user's sessions together stay under the machine's ceiling with no swap, max's
# sessions keep their reserve inside it, and the slot tool answers with the machine's count.

set -uo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"

needs systemctl nix numfmt
command -v host-slots >/dev/null ||
    skip "no host-slots on PATH: not a worker host, or its config is not switched to yet"

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
machine=$(uname -n)
# A value of the machine's NixOS config, as this checkout declares it.
declared() { nix eval --raw "$repo#nixosConfigurations.$machine.config.$1" 2>/dev/null; }
running() { systemctl show "$1" -p "$2" --value; }

check "user.slice's ceiling is the declared memoryMax" \
    "$(numfmt --from=iec "$(declared 'systemd.slices.user.sliceConfig.MemoryMax')")" "$(running user.slice MemoryMax)"
check "user.slice swaps nothing" 0 "$(running user.slice MemorySwapMax)"
check "max's slice is protected up to the declared sessionsReserve" \
    "$(numfmt --from=iec "$(declared "systemd.slices.\"user-$(id -u max)\".sliceConfig.MemoryLow")")" \
    "$(running "user-$(id -u max).slice" MemoryLow)"
# The counts dispatch-places-workers ruled (D1); `slots` is an argument of agent-user.nix, which no option exposes.
declare -A ruled=([pc]=6 [xmg19]=8)
check "host-slots counts against the machine's ruled count" "${ruled[$machine]:-none ruled}" \
    "$(host-slots count | cut -d' ' -f2)"

finish
