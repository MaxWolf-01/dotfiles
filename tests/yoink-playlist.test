#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro>=1.0.14"]
# ///
"""Check bin/yoink-playlist: which videos it hands to yoink-talk, and what a run records. Run it directly.

yt-dlp and yoink-talk are stubs first on PATH: the listing comes from a file, and yoink-talk logs each
video, and fails for those in $FAIL.
"""

import json
import os
import subprocess
import sys
import shutil
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from check import check, finish  # noqa: E402

BIN = Path(__file__).resolve().parents[1] / "bin" / "yoink-playlist"
A, B, C, D, E, F, G, H, I = (c * 11 for c in "abcdefghi")

YT_DLP = """#!/usr/bin/env bash
echo "$*" >> "$LISTED"
url="${@: -1}"
case "$url" in *refused*) exit 1 ;; esac
cat "$LISTINGS/${url##*list=}"
"""
SSH = """#!/usr/bin/env bash
echo "ssh $*" >> "$LISTED"
[ -n "$SSH_DOWN" ] && exit 255
cat "$LISTINGS/remote"
"""
YOINK_TALK = """#!/usr/bin/env bash
id="${1##*=}"
echo "$id $2 $3" >> "$CALLS"
case " $FAIL " in *" $id "*) echo "yoink-talk: it broke for a reason"  >&2; exit 1 ;; esac
mkdir -p "$3/$id" && printf -- '---\nurl: https://www.youtube.com/watch?v=%s\n---\n' "$id" > "$3/$id/$id.md"
"""

with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    (root / "stubs").mkdir()
    for name, text in (("yt-dlp", YT_DLP), ("ssh", SSH), ("yoink-talk", YOINK_TALK)):
        (root / "stubs" / name).write_text(text)
        (root / "stubs" / name).chmod(0o755)
    library = root / "library"
    for slug, line in (("old-talk", f"url: https://www.youtube.com/watch?v={A}"), ("short-link", f"source: https://youtu.be/{F}"),
                       ("live", f"url: https://www.youtube.com/live/{G}")):
        (library / slug).mkdir(parents=True)
        (library / slug / f"{slug}.md").write_text(f"---\ntitle: Old\n{line}\n---\n\nbody\n")
    (library / "other").mkdir()
    (library / "other" / "other.md").write_text(f"---\ntitle: Other\n---\n\nA note linking https://www.youtube.com/watch?v={B}\n")
    (library / "dangling").mkdir()
    (library / "dangling" / "gone.md").symlink_to(root / "nowhere")
    (root / "scribe" / "elsewhere").mkdir(parents=True)
    (root / "scribe" / "elsewhere" / "elsewhere.md").write_text(f"---\nurl: https://www.youtube.com/watch?v={H}\n---\n")
    playlists = root / "playlists.txt"
    playlists.write_text("# a comment\n\nhttps://youtube.com/playlist?list=X\nhttps://youtube.com/playlist?list=Y\n")
    calls, listed_log, listings = root / "calls", root / "listed", root / "listings"
    listings.mkdir()
    (listings / "X").write_text(json.dumps({"entries": [
        {"id": C, "title": "new, listed before B", "duration": 3600},
        {"id": A, "title": "in the library", "duration": 60},
        {"id": F, "title": "in the library by a short link", "duration": 60},
        {"id": G, "title": "in the library by a live link", "duration": 60},
        {"id": B, "title": "only linked from a note", "duration": None},
        {"id": H, "title": "only under $SCRIBE_DIR", "duration": 0},
        {"id": D, "title": "[Private video]", "duration": None},
        {"id": E, "title": "fails", "duration": 3600},
    ]}))
    (listings / "Y").write_text(json.dumps({"entries": [{"id": C, "title": "also on the second playlist", "duration": 3600}]}))

    def run(*args: str, fail: str = "", env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
        full = {**os.environ, "PATH": f"{root / 'stubs'}:{os.environ['PATH']}", "LISTED": str(listed_log), "LISTINGS": str(listings), "CALLS": str(calls), "FAIL": fail,
                "XDG_STATE_HOME": str(root / "state"), "SCRIBE_DIR": str(root / "scribe"), "RUN_LOG_DIR": str(root / "runs"), **(env or {})}
        calls.write_text("")
        listed_log.write_text("")
        return subprocess.run([str(BIN), str(playlists), "--library", str(library), *args], env=full, capture_output=True, text=True)

    def called() -> list[str]:
        return [line.split()[0] for line in calls.read_text().splitlines()]

    def lines() -> list[dict]:
        return [json.loads(line) for line in (root / "runs" / "yoink-playlist.jsonl").read_text().splitlines()]

    def outcomes() -> list[str]:
        return [line["outcome"] for line in lines()]

    r = run("--dry-run")
    check("a dry run yoinks nothing", [], called())
    check("a dry run lists what is new, in playlist order, each once, skipping the library's and the unavailable", [C, B, H, E], [line.split()[0] for line in r.stdout.splitlines()])
    check("and says their total length, a video of unknown length counting nothing", True, "2.0 h" in r.stderr)
    check("every playlist is asked for flat, comments are not", ["--flat-playlist -J --no-warnings https://youtube.com/playlist?list=X", "--flat-playlist -J --no-warnings https://youtube.com/playlist?list=Y"], listed_log.read_text().splitlines())

    r = run("--record", fail=E)
    check("new videos go to yoink-talk in playlist order, each once", [C, B, H, E], called())
    check("into the library", f"--output-dir {library}", calls.read_text().splitlines()[0].split(" ", 1)[1])
    check("a failed video fails the run", 1, r.returncode)
    check("and is written down as a failure", ["fail"], outcomes())
    check("with yoink-talk's own reason", True, "it broke for a reason" in lines()[-1]["reason"])
    check("what yoink-talk printed still reaches the journal", True, "it broke for a reason" in r.stderr)

    r = run("--record")
    check("the next run tries only what failed", [E], called())
    check("and succeeds", 0, r.returncode)
    check("and records it", ["fail", "ok"], outcomes())

    run("--record")
    check("a video yoinked earlier is not redone", [], called())

    shutil.rmtree(library / C)
    run("--record")
    check("a talk deleted from the library is yoinked again while the playlist lists it", [C], called())

    playlists.write_text("https://youtube.com/playlist?list=refused\n")
    (listings / "remote").write_text(json.dumps({"entries": [{"id": I, "title": "listed on pc", "duration": 60}]}))
    r = run("--record")
    check("a playlist refused here is listed on pc", [I], called())

    r = run("--record", env={"SSH_DOWN": "1"})
    check("a playlist listed nowhere fails the run", 1, r.returncode)
    check("and is recorded", "fail", outcomes()[-1])

    playlists.write_text("https://youtube.com/playlist?list=X\n")
    (listings / "X").write_text("not json")
    r = run("--record")
    check("a listing that makes no sense does not pass as an empty playlist", 1, r.returncode)
    check("and is recorded", "fail", outcomes()[-1])

    playlists.unlink()
    r = run("--record")
    check("a missing playlist file is recorded as a failure too", (1, "fail"), (r.returncode, outcomes()[-1]))

finish()
