#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro>=1.0.14"]
# ///
"""Check bin/yoink-playlist: which videos it hands to yoink-talk, and what a run records. Run it directly.

yt-dlp and yoink-talk are stubs first on PATH: the listing comes from a file, and yoink-talk logs each
video, and fails for those in $FAIL.
"""

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from check import check, finish  # noqa: E402

BIN = Path(__file__).resolve().parents[1] / "bin" / "yoink-playlist"
A, B, C, D, E = ("aaaaaaaaaaa", "bbbbbbbbbbb", "ccccccccccc", "ddddddddddd", "eeeeeeeeeee")

YT_DLP = """#!/usr/bin/env bash
cat "$LISTING"
"""
YOINK_TALK = """#!/usr/bin/env bash
id="${1##*=}"
echo "$id $2 $3" >> "$CALLS"
case " $FAIL " in *" $id "*) exit 1 ;; esac
"""

with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    (root / "stubs").mkdir()
    for name, text in (("yt-dlp", YT_DLP), ("yoink-talk", YOINK_TALK)):
        (root / "stubs" / name).write_text(text)
        (root / "stubs" / name).chmod(0o755)
    library = root / "library"
    (library / "old-talk").mkdir(parents=True)
    (library / "old-talk" / "old-talk.md").write_text(f"---\ntitle: Old\nurl: https://www.youtube.com/watch?v={A}\n---\n\nbody\n")
    (library / "other").mkdir()
    (library / "other" / "other.md").write_text(f"---\ntitle: Other\n---\n\nA note linking https://www.youtube.com/watch?v={B}\n")
    playlists = root / "playlists.txt"
    playlists.write_text("# a comment\n\nhttps://youtube.com/playlist?list=X\n")
    calls = root / "calls"
    listing = root / "listing.json"
    listing.write_text(json.dumps({"entries": [
        {"id": A, "title": "in the library", "duration": 60},
        {"id": B, "title": "only linked from a note", "duration": 60},
        {"id": C, "title": "new", "duration": 3600},
        {"id": D, "title": "[Private video]", "duration": None},
        {"id": E, "title": "fails", "duration": 60},
    ]}))

    def run(*args: str, fail: str = "") -> subprocess.CompletedProcess:
        env = {**os.environ, "PATH": f"{root / 'stubs'}:{os.environ['PATH']}", "LISTING": str(listing), "CALLS": str(calls), "FAIL": fail,
               "XDG_STATE_HOME": str(root / "state"), "SCRIBE_DIR": str(root / "scribe"), "RUN_LOG_DIR": str(root / "runs")}
        calls.write_text("")
        return subprocess.run([str(BIN), str(playlists), "--library", str(library), *args], env=env, capture_output=True, text=True)

    def called() -> list[str]:
        return [line.split()[0] for line in calls.read_text().splitlines()]

    def outcomes() -> list[str]:
        return [json.loads(line)["outcome"] for line in (root / "runs" / "yoink-playlist.jsonl").read_text().splitlines()]

    r = run("--dry-run")
    check("a dry run yoinks nothing", [], called())
    check("a dry run lists what is new, skipping the library's and the unavailable", [B, C, E], [line.split()[0] for line in r.stdout.splitlines()])

    r = run("--record", fail=E)
    check("new videos go to yoink-talk in playlist order; the library's and the unavailable do not", [B, C, E], called())
    check("into the library", f"--output-dir {library}", calls.read_text().splitlines()[0].split(" ", 1)[1])
    check("a failed video fails the run", 1, r.returncode)
    check("and is written down as a failure", ["fail"], outcomes())

    r = run("--record")
    check("the next run tries only what failed", [E], called())
    check("and succeeds", 0, r.returncode)
    check("and records it", ["fail", "ok"], outcomes())

    run("--record")
    check("a video finished earlier is not redone, though its talk left the library", [], called())

    listing.write_text("not json")
    check("a listing that makes no sense does not pass as an empty playlist", True, run("--record").returncode != 0)

finish()
