#!/usr/bin/env bash
# tier: full-path (a NixOS VM: a systemd user manager and Home Manager's unit switcher)
# A Home Manager switch neither starts a backup nor waits on one. For the
# laptop's and pc's Home Manager configuration in turn, this builds the
# catch-up target and the backups it lists, swaps each backup's commands for a
# sleep, and has sd-switch switch a VM's user manager onto them while one
# backup runs: the switch has to finish, leave the running backup alone and
# start no other. A catch-up before and after the switch has to run every
# backup, as a login's does.
#
# REV=<commit> builds that commit rather than the checkout.

set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$repo/tests/check.sh"

needs nix jq
[ -w /dev/kvm ] || skip "no /dev/kvm to run the VM on"

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

flake="$repo"
[ -z "${REV:-}" ] || flake="git+file://$repo?rev=$(git -C "$repo" rev-parse "$REV")"
nixpkgs=$(nix flake archive --json "$flake" | jq -r .inputs.nixpkgs.path)

declare -A generation=(
    [laptop]=homeConfigurations.zephyrus.activationPackage
    [pc]=nixosConfigurations.pc.config.home-manager.users.max.home.activationPackage
)

# The VM's user is max, as on both hosts, so %h is the stand-ins' home.
sleep_line="ExecStart=/run/current-system/sw/bin/sh -c 'echo %N >>%h/runs; exec /run/current-system/sw/bin/sleep \$\$(/run/current-system/sw/bin/cat %h/seconds/%N 2>/dev/null || echo 1)'"

for host in laptop pc; do
    if ! gen=$(nix build --no-link --print-out-paths "$flake#${generation[$host]}" 2>"$scratch/build.log"); then
        fail "$host: its Home Manager generation builds" "$(tail -20 "$scratch/build.log")"
        continue
    fi
    built="$gen/home-files/.config/systemd/user"
    new="$scratch/$host/new" old="$scratch/$host/old"
    mkdir -p "$new" "$old"
    cp "$built/backup-catchup.target" "$new/"
    for unit in $(sed -n 's/^Wants=//p' "$built/backup-catchup.target"); do
        awk -v line="$sleep_line" '/^Exec/ { next } { print } /^\[Service\]$/ { print line }' \
            "$built/$unit" >"$new/$unit"
    done
    # The generation before: the same units, each changed, as a switch that
    # touches every backup finds them.
    for file in "$new"/*; do
        { cat "$file"; echo "X-SwitchTest=old"; } >"$old/${file##*/}"
    done

    if nix build --no-link -L --impure --expr \
        "import $repo/tests/fixtures/hm-switch/vm.nix { nixpkgs = $nixpkgs; old = $old; new = $new; }" \
        >"$scratch/vm.log" 2>&1; then
        passed "$host: a switch while a backup runs finishes, starts no backup, and the catch-up still runs them all"
    else
        fail "$host: a switch while a backup runs finishes, starts no backup, and the catch-up still runs them all" \
            "$(grep -E 'subtest|Assertion|Error|sd-switch|Starting units|Stopping units|Keeping|timed out' "$scratch/vm.log" | tail -30)"
    fi
done

finish
