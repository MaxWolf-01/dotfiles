#!/usr/bin/env bash
# Drive bin/host-recorder-report against fixture recorder files and a stubbed
# journal, and check its answers. Run it directly; no framework.
#
# The CPU question's cases are the promises the report makes about lifetimes:
# a restart or a reboot splits a unit into lifetimes that each count only their
# CPU inside the window; a stop record closes a lifetime at its own total; a
# unit that lived between two hourly counters is counted from its stop record
# alone; a unit already running when the counters began is not charged for its
# past; one name under several managers is one unit per manager.
# The window question's cases: which holders and samples fall in the window,
# how a holder's memory is summed and followed across the rankings, and files
# of either header, across midnight.
# Every expected number below is worked out by hand from the fixture.

set -uo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/cpu" "$work/window"

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# --- the CPU question ---

# Each instant is computed once: the host recorder stamps a whole dump with one time,
# and the report recognises the first dump by that time being shared.
now=$(date +%s)
ago() { date -d "@$((now - $1 * 3600))" '+%F %T'; }  # counter timestamp
ago_us() { echo "$((now - $1 * 3600))000000"; }      # journal timestamp

# The reading user's manager, whose journal the stub below answers for, and another user's.
me=user@$(id -u)
other=user@$(($(id -u) + 1))

# Hourly counters: time, owning manager, unit, cumulative usage in usec (here
# whole seconds). The units that also have stop records are the reading user's.
counters() {  # manager hours_ago unit seconds...
    local manager=$1 h=$2 unit=$3 s
    for s in "${@:4}"; do echo "$(ago "$h"),$manager,$unit,${s}000000"; done
}
series() {  # manager unit "hours_ago seconds"...
    local manager=$1 unit=$2 row
    for row in "${@:3}"; do
        # shellcheck disable=SC2086
        set -- $row; counters "$manager" "$1" "$unit" "$2"
    done
}
{
    echo "time,manager,unit,usage_usec"
    series system "(root)" "12 10000" "11 10100" "9 10300" "5 10700" "1 11100"
    # steady: 100 s an hour, running before the counters began
    series "$me" steady.service "12 1000" "11 1100" "9 1300" "5 1700" "1 2100"
    # restarted: stopped at -6h (stop record: 900 s), a new lifetime from -5h
    series "$me" restarted.service "12 500" "9 800" "5 50" "1 250"
    # reboot: counter reset between -9h and -5h with no stop record
    series "$me" reboot.service "12 3000" "9 3300" "5 20" "1 120"
    # one name, three managers, their samples interleaved in every dump: the
    # system bus uses 100 s an hour, the reading user's session bus 1 s every
    # 2-4 hours, another user's 10 s an hour from a larger count, which a reader
    # joining on "user" alone would take for a restart at every dump
    series system dbus.service "12 50000" "11 50100" "9 50300" "5 50700" "1 51100"
    series "$me" dbus.service "12 9" "11 9" "9 10" "5 12" "1 15"
    series "$other" dbus.service "12 5000" "11 5010" "9 5030" "5 5070" "1 5110"
    # labelled "user" by a recorder from before the uid, then by uid: one lifetime
    series user relabelled.service "12 100" "11 200"
    series "$me" relabelled.service "9 400" "5 800" "1 1200"
    # two tmux panes born inside the window, one still open, one closed at -7h
    counters "$me" 5 tmux-spawn-11111111-1111-1111-1111-111111111111.scope 30
    counters "$me" 1 tmux-spawn-11111111-1111-1111-1111-111111111111.scope 90
    counters "$me" 9 tmux-spawn-22222222-2222-2222-2222-222222222222.scope 10
} >"$work/cpu/$(date +%F).counters.csv"

# The journal's stop records, as `journalctl -o json` prints them. The stub
# honours --since like the real one and answers only for --user.
{
    stop() { printf '{"MESSAGE":"%s: Consumed %s CPU time over %s wall clock time.","__REALTIME_TIMESTAMP":"%s"}\n' "$2" "$3" "${4:-1min}" "$(ago_us "$1")"; }
    stop 6 restarted.service "15min"
    stop 7 tmux-spawn-22222222-2222-2222-2222-222222222222.scope "1min"
    stop 11 short.service "1min 40s"
    stop 8 short.service "5.000s"
    stop 3 short.service "7000ms"
    # never scanned (no counters): 600 s of CPU over a 20 h life that ended at -2h
    stop 2 long.service "10min" "20h"
} >"$work/journal.jsonl"

mkdir -p "$work/stub"
cat >"$work/stub/journalctl" <<STUB
#!/usr/bin/env bash
case " \$* " in *" --system "*) exit 1 ;; esac
since=\$(printf '%s\n' "\$@" | sed -n 's/^@//p')
while IFS= read -r line; do
    ts=\$(sed -n 's/.*"__REALTIME_TIMESTAMP":"\([0-9]*\)".*/\1/p' <<<"\$line")
    [ "\$((ts / 1000000))" -ge "\$since" ] && echo "\$line"
done <"$work/journal.jsonl"
exit 0
STUB
# ssh, standing in: drops its options and the host, runs the command here, and
# says it was called.
cat >"$work/stub/ssh" <<STUB
#!/usr/bin/env bash
echo "\$*" >> "$work/ssh-calls"
while getopts o: _; do :; done
shift \$((OPTIND - 1))
shift
exec bash -c "\$*"
STUB
chmod +x "$work/stub/journalctl" "$work/stub/ssh"
export PATH="$work/stub:$PATH"
unset HOST_RECORDER_SSH

report() { "$bin_dir/host-recorder-report" --logdir "$work/cpu" --json "$@"; }
cpu() {  # json unit -> whole cpu seconds
    jq -r --arg u "$2" '(.units[] | select(.unit == $u) | .cpu_s | floor) // "absent"' <<<"$1"
}

# Window of 10 h: it starts between the -11h and -9h counters.
r=$(report --hours 10)
check "steady unit: from the last counter at or before the window start" 1000 "$(cpu "$r" steady.service)"
check "restart: stop total minus baseline, plus the new lifetime" 650 "$(cpu "$r" restarted.service)"
check "reboot: each side of the counter reset counts separately" 420 "$(cpu "$r" reboot.service)"
check "timer: stop records inside the window only" 12 "$(cpu "$r" short.service)"
check "tmux panes grouped into one line" 150 "$(cpu "$r" 'tmux-spawn-*.scope')"
check "system total from the root counter" 1000 "$(jq -r '.total_cpu_s | floor' <<<"$r")"
check "a name several managers use: the system unit on its own" 1000 "$(cpu "$r" 'dbus.service (system)')"
check "a name several managers use: the reading user's unit on its own" 6 "$(cpu "$r" "dbus.service ($me)")"
check "a name several managers use: another user's unit on its own" 100 "$(cpu "$r" "dbus.service ($other)")"
check "counters labelled user before the uid continue the reading user's" 1000 "$(cpu "$r" relabelled.service)"
check "unit known only from its stop: the window's share of its life, 8 of 20 h" 240 "$(cpu "$r" long.service)"

r=$(report --hours 10 --no-group)
check "ungrouped pane still open" 90 "$(cpu "$r" tmux-spawn-11111111-1111-1111-1111-111111111111.scope)"
check "ungrouped pane closed by its stop record" 60 "$(cpu "$r" tmux-spawn-22222222-2222-2222-2222-222222222222.scope)"

# Window of 20 h: it starts before the counters do.
r=$(report --hours 20)
check "unit running before the counters began: not charged for its past" 1100 "$(cpu "$r" steady.service)"
check "timer: every stop record inside the longer window" 112 "$(cpu "$r" short.service)"
check "unit known only from its stop: 18 of its 20 h inside" 540 "$(cpu "$r" long.service)"

# Through ssh: the same answer, the journal and the uid read on the other side.
local_units=$(report --hours 10 | jq -c .units)
remote_units=$(report --hours 10 --host elsewhere | jq -c .units)
check "the CPU question through ssh: the same units" "$local_units" "$remote_units"
check "the CPU question through ssh: files, uid and both journals read there" 4 \
    "$(grep -c '^-o BatchMode=yes elsewhere ' "$work/ssh-calls")"

# --- the window question ---

# Samples once a minute from 23:50 to 00:06 across midnight, rankings at the
# same minutes. The 27th is in thermal-log's columns, which carry no pressure;
# the 28th in the host recorder's, where pressure rises 0.5 a minute.
sample_old=time,pkg_c,cpu_c,board_c,cpu_rpm,gpu_rpm,mhz_max,load1,profile,spl_w,sppt_w,ac,bat_pct,bat_w,dgpu_disable,dgpu_port,dgpu_drv,mem_avail_mb,swap_used_mb
sample_new=time,mhz_max,load1,mem_avail_mb,swap_used_mb,mem_some_avg10,mem_full_avg10,cpu_c,ccd1_c,nvme_c,board_c,wmi1_c,wmi2_c,wmi3_c,wmi4_c,wmi5_c,wmi6_c
top_old=time,unit,cpu_pct,anon_mb,shmem_mb,swap_mb,procs,process,cwd
top_new=time,unit,cpu_pct,anon_mb,shmem_mb,swap_mb,procs,process,cwd,mem_some_avg60,mem_full_avg60
pane=tmux-spawn-04a022ba-0a66-4f6d-8220-46e4b6481a45.scope
echo "$sample_old" >"$work/window/2026-09-27.csv"
echo "$top_old" >"$work/window/2026-09-27.top.csv"
echo "$sample_new" >"$work/window/2026-09-28.csv"
echo "$top_new" >"$work/window/2026-09-28.top.csv"
# k counts minutes from 23:50. The pane grows 100 MB a minute of anonymous
# memory and holds 10 shared and 5 swapped; its largest process is bash until
# 00:03, claude after. The service holds 800 and drops out of the 00:00 ranking.
for k in $(seq 0 16); do
    if ((k < 10)); then day=2026-09-27 stamp="2026-09-27 23:5$k:00"; else
        day=2026-09-28 stamp=$(printf '2026-09-28 00:%02d:00' $((k - 10))); fi
    anon=$((1000 + 100 * k)) avail=$((30000 - 1000 * k))
    if ((k < 13)); then proc=bash cwd='~/repos/a'; else proc=claude cwd='~/repos/b'; fi
    if [ $day = 2026-09-27 ]; then
        echo "$stamp,,,,,,4000,1.5,,,,,,,,,,$avail,100" >>"$work/window/$day.csv"
        echo "$stamp,$pane,20,$anon,10,5,3,$proc,$cwd" >>"$work/window/$day.top.csv"
        echo "$stamp,postgresql.service,,800,0,0,9,postgres,/" >>"$work/window/$day.top.csv"
        echo "$stamp,(rest),5,4000,0,0,,," >>"$work/window/$day.top.csv"
    else
        some=$((k - 10)).$((k % 2 * 5)) full=0.$((k - 10))
        echo "$stamp,4000,1.5,$avail,100,$some,$full,,,,,,,,,," >>"$work/window/$day.csv"
        echo "$stamp,$pane,$((20 + k)),$anon,10,5,3,$proc,$cwd,$full,0.10" >>"$work/window/$day.top.csv"
        ((k == 10)) || echo "$stamp,postgresql.service,,800,0,0,9,postgres,/,," >>"$work/window/$day.top.csv"
        echo "$stamp,(rest),5,4000,0,0,,,,," >>"$work/window/$day.top.csv"
    fi
done

ask() { "$bin_dir/host-recorder-report" --logdir "$work/window" --at '2026-09-28 00:03:00' --json "$@"; }
holder() { jq -c --arg u "$2" '.holders[] | select(.unit == $u) | [.first_mb, .last_mb, .peak_mb, .peak_at, .ranked]' <<<"$1"; }

# Ten minutes before 00:03 and one after: 23:53 to 00:04, twelve minutes.
r=$(ask)
check "window: ten minutes before the moment and one after" '["2026-09-27 23:53:00","2026-09-28 00:04:00"]' \
    "$(jq -c '[.from, .to]' <<<"$r")"
check "window: every sample inside, none outside" "12 2026-09-27 23:53:00 2026-09-28 00:04:00" \
    "$(jq -r '[(.samples | length), .samples[0].time, .samples[-1].time] | join(" ")' <<<"$r")"
check "window: the rankings inside" 12 "$(jq .rankings <<<"$r")"
check "holder: anonymous + shared + swapped at first, last and peak, and when" \
    '[1315,2415,2415,"2026-09-28 00:04:00",12]' "$(holder "$r" "$pane")"
check "holder: the process and cwd of its peak" '["claude","~/repos/b"]' \
    "$(jq -c --arg u "$pane" '.holders[] | select(.unit == $u) | [.process, .cwd]' <<<"$r")"
check "holder missing from one ranking: ranked in the others" '[800,800,800,"2026-09-27 23:53:00",11]' \
    "$(holder "$r" postgresql.service)"
check "holders: the largest peak first" "(rest) $pane postgresql.service" \
    "$(jq -r '[.holders[].unit] | join(" ")' <<<"$r")"
check "holder: its peak CPU and pressure; null where its files have none" '[34,0.4,0.1,null,null]' \
    "$(jq -c --arg u "$pane" '(.holders[] | select(.unit == $u) | [.cpu_pct_peak, .mem_some_avg60_peak, .mem_full_avg60_peak]) +
        (.holders[] | select(.unit == "postgresql.service") | [.cpu_pct_peak, .mem_some_avg60_peak])' <<<"$r")"
check "pressure: null before the recorder recorded it, then as recorded" '[null,null,3.5,0.3,17000]' \
    "$(jq -c '(.samples[0] | [.mem_some_avg10, .mem_full_avg10]) +
        (.samples[] | select(.time == "2026-09-28 00:03:00") | [.mem_some_avg10, .mem_full_avg10, .mem_avail_mb])' <<<"$r")"

r=$(ask --minutes 2)
check "a narrower window: 00:01 to 00:04" "4 4" "$(jq -r '"\(.samples | length) \(.rankings)"' <<<"$r")"

r=$(ask --host elsewhere)
check "the window question through ssh: the same answer" "$(ask | jq -c 'del(.host)')" "$(jq -c 'del(.host)' <<<"$r")"

table=$("$bin_dir/host-recorder-report" --logdir "$work/window" --at '2026-09-28 00:03:00')
check "the table names the pane, its process and cwd" 1 \
    "$(grep -c '^ *2415 *1315 *2415 *12 *00:04:00 .*tmux-spawn-04a022ba…, claude, ~/repos/b$' <<<"$table")"
check "the table marks the moment's minute" 1 "$(grep -c '^ *00:03 .*<- --at$' <<<"$table")"

r=$("$bin_dir/host-recorder-report" --logdir "$work/window" --at '2026-09-20 12:00:00' --json)
check "a window nothing was recorded in: empty, not an error" "0 0 0" \
    "$(jq -r '"\(.samples | length) \(.holders | length) \(.rankings)"' <<<"$r")"

if "$bin_dir/host-recorder-report" --logdir "$work/nowhere" --at '2026-09-28 00:03:00' 2>"$work/err" >/dev/null; then
    check "a directory that is not there: an error" "exit 1" "exit 0"
else
    check "a directory that is not there: an error naming it" 1 "$(grep -c "no host recorder directory at $work/nowhere" "$work/err")"
fi

if [ "$failures" -gt 0 ]; then
    echo "$failures failed"
    exit 1
fi
echo "all passed"
