#!/usr/bin/env bash
# tier: full-path (the mx plugin each Claude Code profile has installed)
# Check that no command name is on a session's PATH twice: bin/, secrets/bin/ and the bin/ of the
# mx plugin each Claude Code profile under $HOME has installed. A second command of the same name
# is shadowed by whichever directory PATH lists first, so a skill that names one runs the other.
# Reads the plugin installs, writes nothing.

set -uo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
needs git jq

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)

# shared <dir>...: each command name more than one of the directories holds, one per line.
shared() {
    local dir
    for dir; do
        find -L "$dir" -mindepth 1 -maxdepth 1 -type f -executable -printf '%f\n'
    done | sort | uniq -d
}

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
mkdir "$scratch/a" "$scratch/b"
touch "$scratch/a/run-log" "$scratch/b/run-log" "$scratch/a/notes" "$scratch/b/notes" "$scratch/a/only-a"
chmod +x "$scratch/a/run-log" "$scratch/b/run-log" "$scratch/a/only-a"
check "a name two directories hold is found, and a file that is not executable is no command" \
    run-log "$(shared "$scratch/a" "$scratch/b")"

dirs=("$repo/bin")
if [ -d "$repo/secrets/bin" ]; then
    dirs+=("$repo/secrets/bin")
else
    skipped "secrets/bin" "this checkout has no secrets/ repo"
fi

installs=$(jq -r '.plugins | to_entries[] | select(.key | startswith("mx@")) | .value[].installPath' \
    "$HOME"/.claude*/plugins/installed_plugins.json 2>/dev/null)
[ -n "$installs" ] || skipped "the mx plugin's bin/" "no Claude Code profile under $HOME has it installed"

check "no name in ${dirs[*]#"$repo/"} twice" "" "$(shared "${dirs[@]}")"
while IFS= read -r install; do
    [ -n "$install" ] || continue
    [ -d "$install/bin" ] || { fail "$install/bin" "installed_plugins.json names it, but it does not exist"; continue; }
    check "no name in ${dirs[*]#"$repo/"} and $install/bin twice" "" "$(shared "${dirs[@]}" "$install/bin")"
done <<<"$installs"

finish
