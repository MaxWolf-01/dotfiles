#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro>=1.0.14", "numpy", "opencv-python-headless>=5", "pillow"]
# ///
# tier: full-path (ffmpeg, and the face model's download on a machine without it)
"""Check bin/yoink-talk's slide finder on a talk drawn here: which slides it keeps, and when they appeared.

Run it directly; no framework. The talk is drawn frame by frame with Pillow and encoded by
ffmpeg: slide A, a bullet added to it, slide B, a black screen, A again, with a patch of
noise in the bottom corner the whole time, as a speaker's inset moves.
"""

import subprocess
import sys
import tempfile
from pathlib import Path

import numpy as np
from PIL import Image, ImageDraw, ImageFont

sys.path.insert(0, str(Path(__file__).resolve().parent))
from check import check, finish, needs  # noqa: E402

needs("ffmpeg", "ffprobe")
yt = __import__("check").bin_module("yoink-talk")

W, H, FPS = 1280, 720, 10
FONT = ImageFont.load_default(size=40)
TITLE = ImageFont.load_default(size=64)


def slide(title: str, lines: list[str]) -> Image.Image:
    img = Image.new("L", (W, H), 245)
    d = ImageDraw.Draw(img)
    d.text((80, 60), title, fill=20, font=TITLE)
    for k, line in enumerate(lines):
        d.text((100, 200 + 70 * k), f"- {line}", fill=40, font=FONT)
    return img


A = ["Stillness marks a slide", "An inset keeps moving", "Builds are saved once"]
B = ["A camera shot is footage", "A portrait is a slide"]
TALK = [  # seconds, picture
    (6, slide("Alpha", A)),
    (6, slide("Alpha", [*A, "Finished at the last step"])),
    (6, slide("Beta", B)),
    (3, Image.new("L", (W, H), 0)),
    (6, slide("Alpha", [*A, "Finished at the last step"])),
]

with tempfile.TemporaryDirectory() as tmp:
    video = Path(tmp) / "talk.mp4"
    enc = subprocess.Popen(["ffmpeg", "-nostdin", "-v", "error", "-f", "rawvideo", "-pix_fmt", "gray", "-s", f"{W}x{H}",
                            "-r", str(FPS), "-i", "-", "-c:v", "libx264", "-pix_fmt", "yuv420p", str(video)], stdin=subprocess.PIPE)
    rng = np.random.default_rng(0)
    for seconds, picture in TALK:
        base = np.asarray(picture)
        for _ in range(seconds * FPS):
            frame = base.copy()
            frame[H - 120:H - 40, W - 120:W - 40] = rng.integers(0, 255, (80, 80), np.uint8)
            enc.stdin.write(frame.tobytes())
    enc.stdin.close()
    enc.wait()

    shown = yt.find_slides(video)
    check("slide A, its build kept as one, then B, then A again; the black screen gives none", 3, len(shown))
    check("each appeared when it was put up, the build at A's time",
          [0, 12, 21], [round(s["s"]) for s in shown])
    check("A shown again points at its first appearance", [None, None, 0], [s["again"] for s in shown])
    check("A is saved finished, from its last step", True, 6 <= shown[0]["frame_s"] < 12)


# what the run hands to scribe; every command is stubbed, and nothing downloads or pays
with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    meta = yt.pick_meta('{"id": "v", "title": "A talk", "channel": "Chan", "upload_date": "20260102", "duration": 60, "webpage_url": "u", "description": "' + "d" * (yt.DESCRIPTION_LONGEST + 50) + '"}')
    check("the description is part of a video's details", yt.DESCRIPTION_LONGEST + 50, len(meta["description"]))
    commands = []

    class Done:
        returncode = 0

    yt.video_meta = lambda url, via: (meta, "here")
    real_download = yt.download
    yt.download = lambda m, fmt, into, stem, where, via: (root / "audio.m4a")
    (root / "audio.m4a").touch()
    yt.subprocess.run = lambda cmd, **kw: commands.append(cmd) or Done()
    sys.argv = ["yoink-talk", "u", "--no-slides", "--output-dir", str(root / "lib")]
    yt.main()
    scribe = commands[-1]
    context = scribe[scribe.index("--context") + 1]
    check("scribe gets the title and channel", True, "A talk" in context and "Chan" in context)
    check("and the description, cut to its limit", yt.DESCRIPTION_LONGEST, context.split("Description:\n")[1].count("d"))

    # YouTube answered for the video's details here, then refused the download
    class Ran:
        def __init__(self, returncode: int = 0, stdout: str = "", stderr: str = ""):
            self.returncode, self.stdout, self.stderr = returncode, stdout, stderr

    def refusing(cmd, **kw):
        commands.append(cmd)
        if cmd[0] == "yt-dlp":
            return Ran(1, stderr="ERROR: Sign in to confirm you're not a bot")
        if cmd[0] == "scp":
            Path(cmd[-1]).touch()
        return Ran(stdout="/var/tmp/yoink-talk-v/audio.m4a\n")

    commands.clear()
    yt.subprocess.run = refusing
    got = real_download(meta, "ba", root / "cache", "audio", "here", "auto")
    check("a download refused here is tried on pc", ["yt-dlp", "ssh", "scp", "ssh"], [c[0] for c in commands])
    check("and copied into the folder", root / "cache" / "audio.m4a", got)

finish()
