#!/usr/bin/env bash
# Drive bin/restic-unreachable-reason and check which failures it calls a target
# being away. Run it directly; no framework.
#
# The cases that matter are the ones where restic's log names no cause: on a
# busy host restic can exit before it has passed ssh's words on, and the
# repository has to be asked again for them.

set -uo pipefail

tool="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/restic-unreachable-reason"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# Nothing listens on 2222 here, the same port the backup and watchdog tests use
# for a target that refuses.
refused="sftp://max@127.0.0.1:2222//tmp/does-not-matter"

# What restic 0.19.1 printed for that repository when it did pass ssh's line on,
# and what is left when it did not.
cat >"$work/with-cause.log" <<'LOG'
subprocess ssh: ssh: connect to host 127.0.0.1 port 2222: Connection refused
Fatal: unable to open repository at sftp://max@127.0.0.1:2222//tmp/does-not-matter: unable to start the sftp session, error: error receiving version packet from server: server unexpectedly closed connection: unexpected EOF
LOG
tail -1 "$work/with-cause.log" >"$work/no-cause.log"

# --- the log names the cause: it is the answer, prefix stripped

out=$("$tool" "$work/with-cause.log"); rc=$?
check "a log naming a refusal exits 0" 0 "$rc"
check "...and prints ssh's line" \
    "ssh: connect to host 127.0.0.1 port 2222: Connection refused" "$out"
check "stdin is read when no file is given" \
    "ssh: connect to host 127.0.0.1 port 2222: Connection refused" \
    "$("$tool" <"$work/with-cause.log")"

# --- the log lost the cause: the repository is asked

out=$("$tool" --repo "$refused" "$work/no-cause.log"); rc=$?
check "a refused sftp:// repository with no cause logged exits 0" 0 "$rc"
check "...and names the refusal" \
    "yes" "$(grep -qi 'connection refused' <<<"$out" && echo yes || echo "$out")"

out=$("$tool" --repo "sftp:max@nosuchhost.invalid:restic-test" "$work/no-cause.log"); rc=$?
check "an sftp:user@host:path repository that does not resolve exits 0" 0 "$rc"
check "...and names the resolution failure" \
    "yes" "$(grep -qiE 'resolve|not known' <<<"$out" && echo yes || echo "$out")"

# --- nothing to ask, or nothing unreachable: still a failure

"$tool" "$work/no-cause.log" >/dev/null; rc=$?
check "no cause and no repository exits 1" 1 "$rc"

"$tool" --repo "$work/local-repo" "$work/no-cause.log" >/dev/null; rc=$?
check "no cause and a local repository exits 1" 1 "$rc"

# A reachable sshd that turns the probe away, whether over the host key or the
# user, has answered: that is a person's problem, not an outage.
if ss -ltn 2>/dev/null | grep -q ':22 '; then
    "$tool" --repo "sftp://nosuchuser@127.0.0.1//tmp/does-not-matter" "$work/no-cause.log" >/dev/null; rc=$?
    check "an sshd that answers and refuses us exits 1" 1 "$rc"
else
    echo "skip the answering-sshd case: nothing is listening on port 22 here"
fi

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
else
    echo "$failures check(s) failed"
    exit 1
fi
