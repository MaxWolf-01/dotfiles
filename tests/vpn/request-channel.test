#!/usr/bin/env -S uv run --script --quiet
# tier: full-path (a unix socket, bin/vpn as a subprocess, real time)
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Drive bin/vpn's request channel for real: a unix socket, the watcher of a fake
World behind it on a thread, and bin/vpn as the command, each request a process
of its own. The World's time passes against the wall clock, so that a command
started or interrupted meanwhile finds a move under way. Run it directly; no
framework.
"""

import contextlib
import io
import json
import os
import queue
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
from dataclasses import replace
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
VPN = Path(__file__).resolve().parents[2] / "bin" / "vpn"

import fakes  # noqa: E402  (loads bin/vpn with its runtime files in a scratch directory)
from fakes import EVERYTHING, WORLDS, events, moved, world  # noqa: E402

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from check import check, finish  # noqa: E402

vpn = fakes.vpn


class Stopped(Exception):
    pass


class Paced:
    """bin/vpn's watcher (`run_watcher`) over a World, on a thread of its own, taking requests over a real unix
    socket in a scratch directory. The World's time passes at `scale` real seconds per second, so that a
    command started or interrupted meanwhile finds a move under way."""

    def __init__(self, wd, scale=0.05):
        self.wd, self.scale = wd, scale
        self.dir = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH))
        self.socket = self.dir / "vpn.sock"
        self.arrivals = queue.Queue()
        self.stopping = threading.Event()
        self.failed = None
        self.ports = replace(wd.ports, clock=vpn.Clock(now=wd.ports.clock.now, wait=self.wait))
        self.thread = threading.Thread(target=self.watch, daemon=True)
        self.thread.start()
        deadline = time.monotonic() + 10
        while not self.socket.exists() and time.monotonic() < deadline:
            time.sleep(0.01)

    def wait(self, secs):
        """The Clock port's wait: what the socket delivered, else the World's next arrival within `secs`."""
        end = self.wd.now + secs
        while not self.stopping.is_set():
            try:
                return self.arrivals.get_nowait()
            except queue.Empty:
                pass
            before = self.wd.now
            arrival = self.wd.wait(max(min(end - before, 0.5), 0.0))
            time.sleep((self.wd.now - before) * self.scale)
            if arrival is not None:
                return arrival
            if self.wd.now >= end:
                return None
        raise Stopped

    def watch(self):
        try:
            with fakes.driving(self.wd), contextlib.redirect_stdout(io.StringIO()):
                try:
                    vpn.run_watcher(self.ports, self.arrivals.put, self.socket)
                except Stopped:
                    pass
        except AssertionError as e:  # the watcher, or a command meanwhile, went around the ports
            self.failed = e

    def command(self, *args):
        """bin/vpn, run as a command whose runtime directory is this watcher's. It runs under this suite's own
        interpreter rather than through its `uv run` shebang, which is slower to start; the double Ctrl-C that
        `uv run` can deliver is checked in-process (`ask_pressing`)."""
        return subprocess.Popen([sys.executable, str(VPN), *args], env=os.environ | {"XDG_RUNTIME_DIR": str(self.dir)},
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

    def stop(self):
        """Stop the watcher. Raises what `fakes.driving` found gone around the ports meanwhile."""
        self.stopping.set()
        self.thread.join(30)
        if self.failed:
            raise self.failed


def read_until(proc, prefix):
    """The command's lines up to and including the first that starts with `prefix`, each with when it came."""
    began, got = time.monotonic(), []
    for text in proc.stdout:
        got.append((time.monotonic() - began, text.rstrip("\n")))
        if text.startswith(prefix):
            break
    return got


def ended(proc):
    """The command's exit status, the rest of what it printed, and what it printed to stderr."""
    out, err = proc.communicate(timeout=60)
    return proc.returncode, out.splitlines(), err.strip()


with contextlib.redirect_stdout(io.StringIO()):
    empty = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH))
    began = time.monotonic()
    proc = subprocess.run([sys.executable, str(VPN), "next"], env=os.environ | {"XDG_RUNTIME_DIR": str(empty)},
                          capture_output=True, text=True, timeout=60)
    took = time.monotonic() - began
    stale = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    stale.bind(str(empty / "vpn.sock"))
    stale.close()
    left_behind = subprocess.run([sys.executable, str(VPN), "off"], env=os.environ | {"XDG_RUNTIME_DIR": str(empty)},
                                 capture_output=True, text=True, timeout=60)
check("with no watcher, a command fails at once, saying vpn-watch is not running, how to start it, and that "
      "vpn-off still works", (1, "", f"vpn: {vpn.NOT_RUNNING}", True),
      (proc.returncode, proc.stdout, proc.stderr.strip(), took < 10))
check("and so it does with a socket a dead watcher left behind", (1, f"vpn: {vpn.NOT_RUNNING}"),
      (left_behind.returncode, left_behind.stderr.strip()))

wd = world(inert={"de-fra-wg-401"}, vesktop=False)
paced = Paced(wd, scale=0.2)
proc = paced.command("next")
got = read_until(proc, "pinned")
status, rest, err = ended(proc)
paced.stop()
check("vpn next prints each line the watcher streams, in order, and exits 0 on the pin",
      (0, ["probing the next 7 nodes …", "handshake: 7 of the next 7 nodes answer",
           "trying de-fra-wg-401 (Frankfurt, Germany) …",
           "trying de-fra-wg-001 (Frankfurt, Germany) …", "pinned: de-fra-wg-001 (Frankfurt, Germany)"], [], ""),
      (status, [text for _, text in got], rest, err))
check("each line as it comes, the one naming a node before the wait on it", True, got[3][0] - got[2][0] > 0.2)

wd = world(blocked=EVERYTHING, vesktop=False)
paced = Paced(wd)
status, out, err = ended(paced.command("to", "Berlin"))
paced.stop()
check("a request that fails exits 1, its final line on stderr",
      (1, "vpn: none of the 1 nodes tried passed (Cloudflare blocks 1); the exit node is back on de-fra-wg-202"),
      (status, err))

wd = world(inert={"de-fra-wg-401", "de-fra-wg-001"}, vesktop=False)
paced = Paced(wd, scale=0.2)
first = paced.command("next")
read_until(first, "trying de-fra-wg-401")
second = paced.command("to", "Vienna")
superseded, won = ended(first), ended(second)
paced.stop()
check("a newer command supersedes a running one: that exits 1 with the exit node put back, the newer one pins",
      ((1, "vpn: superseded by a newer request; the exit node is back on de-fra-wg-202"),
       (0, "pinned: at-vie-wg-001 (Vienna, Austria)"), ("pinned", "at-vie-wg-001")),
      ((superseded[0], superseded[2]), (won[0], won[1][-1]), wd.setting()))

wd = world(inert={"de-fra-wg-401", "de-fra-wg-001"}, vesktop=False)
paced = Paced(wd, scale=0.2)
proc = paced.command("next")
read_until(proc, "trying de-fra-wg-401")
proc.send_signal(signal.SIGINT)
status, out, err = ended(proc)
paced.stop()
check("Ctrl-C at a command cancels its request, and the command prints where the exit node went back to",
      (1, "vpn: cancelled; the exit node is back on de-fra-wg-202", ("pinned", "de-fra-wg-202"),
       [("stayed", "next", "de-fra-wg-202", "de-fra-wg-202")]), (status, err, wd.setting(), moved(wd)))


def ask_pressing(presses, answer_after=0.5):
    """`vpn.ask` in this process against a stand-in watcher that answers `answer_after` seconds after the command
    hung up, with Ctrl-C pressed at each of `presses` seconds. How it ended, and whether the watcher saw it hang
    up. The stand-in is what lets a case time its answer against the presses."""
    path = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH)) / "vpn.sock"
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    server.listen(1)
    hung_up = threading.Event()

    def watcher():
        conn, _ = server.accept()
        with conn:
            conn.makefile("rb").readline()
            while conn.recv(1024):
                pass
            hung_up.set()
            time.sleep(answer_after)
            with contextlib.suppress(OSError):
                conn.sendall(b'{"ok": false, "message": "cancelled; the exit node is back off"}\n')

    threading.Thread(target=watcher, daemon=True).start()
    timers = [threading.Timer(secs, os.kill, (os.getpid(), signal.SIGINT)) for secs in presses]
    for timer in timers:
        timer.start()
    try:
        vpn.ask("next", path=path)
        how = "ok"
    except vpn.VpnError as e:
        how = str(e)
    except SystemExit as e:
        how = f"exit {e.code}"
    finally:
        server.close()
    assert not any(timer.is_alive() for timer in timers), "a press came after the command ended"
    return how, hung_up.is_set()


held_before = signal.getsignal(signal.SIGINT)
# `uv run`, as bin/vpn's shebang runs it, can pass on a press the terminal also delivered.
check("Ctrl-C at a command hangs up and waits for the watcher's last line, and a press that arrives twice is one",
      ("cancelled; the exit node is back off", True), ask_pressing([0.1, 0.2]))
check("a second Ctrl-C leaves at once", ("exit 130", True),
      ask_pressing([0.1, 0.1 + 2 * vpn.CTRL_C_ECHO_SECS], answer_after=5))
check("and gives Ctrl-C back when it ends", held_before, signal.getsignal(signal.SIGINT))

mute_path = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH)) / "vpn.sock"
mute = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
mute.bind(str(mute_path))
mute.listen(1)


def hang_up():
    conn, _ = mute.accept()
    with conn:
        conn.makefile("rb").readline()


threading.Thread(target=hang_up, daemon=True).start()
try:
    vpn.ask("next", path=mute_path)
    how = "ok"
except vpn.VpnError as e:
    how = str(e)
mute.close()
check("a watcher that hangs up without a final line fails the command, saying where to look",
      "vpn-watch hung up without an answer; `journalctl --user -u vpn-watch` says why", how)

wd = world(inert={"de-fra-wg-401", "de-fra-wg-001"}, vesktop=False)
paced = Paced(wd, scale=0.2)
proc = paced.command("next")
read_until(proc, "trying de-fra-wg-401")
proc.kill()
proc.communicate(timeout=60)
deadline = time.monotonic() + 30
while time.monotonic() < deadline and not events(wd):
    time.sleep(0.1)
paced.stop()
check("a command that dies without a word cancels its request all the same",
      (("pinned", "de-fra-wg-202"), ["stayed"]), (wd.setting(), events(wd)))

wd = world(vesktop=False)
paced = Paced(wd)
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as raw:
    raw.connect(str(paced.dir / "vpn.sock"))
    raw.sendall(b'{"request": "sideways"}\n')
    answer = json.loads(raw.makefile("r").readline())
try:
    vpn.listen(paced.dir / "vpn.sock", lambda arrival: None)
    second_watcher = None
except vpn.VpnError as e:
    second_watcher = str(e)
paced.stop()
check("a request the watcher does not understand gets a final line saying so", (False, True),
      (answer["ok"], answer["message"].startswith("not a request vpn understands")))
check("and a second watcher refuses to take over a socket the first still answers on", True,
      (second_watcher or "").startswith("another vpn watch already takes requests"))
check("the watcher stopping takes its socket with it", False, paced.socket.exists())

left = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH)) / "vpn.sock"
stale = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
stale.bind(str(left))
stale.close()
server = vpn.listen(left, lambda arrival: None)
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
    reached = probe.connect_ex(str(left)) == 0
server.close()
check("a watcher starting where a dead one left its socket takes it over", True, reached)

check("no move and no look asks am.i.mullvad.net", 0, sum(w.egress_asks for w in WORLDS))

finish()
