#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["playwright"]
# ///
"""Drive a container's view (bin/container-hub.html) in headless Chromium and check what it promises: keys
that answer with the hub frozen, rulings from the tracker, links and keys inside a page. Run it directly; no
framework. Skips when no chromium is on PATH ($CHROMIUM overrides).

GNOME takes its own bindings before a browser sees them, so a key that clashes with one passes here and
fails on the desktop: this is no substitute for driving the view in Brave.
"""

import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path

from playwright.sync_api import sync_playwright

BIN = Path(__file__).resolve().parents[1] / "bin"
CHROMIUM = os.environ.get("CHROMIUM") or shutil.which("chromium")
SCRATCH = Path(tempfile.mkdtemp(prefix="container-hub-view-test."))
HOME = SCRATCH / "home"
ORCHESTRATOR = "aaaaaaaa-0000-4000-8000-000000000001"

failures = 0


def check(what: str, expected, actual) -> None:
    global failures
    if expected == actual:
        print(f"ok   {what}")
    else:
        failures += 1
        print(f"FAIL {what}\n       expected: {expected!r}\n       actual:   {actual!r}")


def settles(what: str, expected, read, within: float = 10) -> None:
    """check() on what read() returns once it equals expected, or at the deadline: the view moves the keyboard a
    frame after a key, renders the sheet after the layout, and the hub catches up after a thaw."""
    deadline = time.monotonic() + within
    while (actual := read()) != expected and time.monotonic() < deadline:
        time.sleep(0.05)
    check(what, expected, actual)


ENV = {k: v for k, v in os.environ.items() if not k.startswith(("CLAUDE", "MX_", "GIT_", "XDG_", "CONTAINER_HUB"))}
for k, args in (("UV_CACHE_DIR", ("cache", "dir")), ("UV_PYTHON_INSTALL_DIR", ("python", "dir"))):
    ENV[k] = subprocess.run(["uv", *args], capture_output=True, text=True, check=True).stdout.strip()
ENV.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1")
HUB_ENV = {**ENV, "HOME": str(HOME)}
TICKET = "---\nstatus: {status}\n{parent}priority: 2\nsize: S\n---\n\n# {slug}\n\n## Brief\n\n{slug}.\n\n## Acceptance criteria\n\n## Comments\n"


def git(cwd: Path, *args: str) -> None:
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *args], cwd=cwd, env=HUB_ENV,
                   check=True, capture_output=True)


def ticket(slug: str, status: str = "open", parent: str | None = None) -> None:
    (AGENT / "tickets" / f"{slug}.md").write_text(
        TICKET.format(status=status, parent=f"parent: {parent}\n" if parent else "", slug=slug))


def page(rel: str, body: str) -> Path:
    path = AGENT / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(f"<!doctype html><body style='height:400px'>{body}")
    return path


if not CHROMIUM:
    print("skip: no chromium on PATH")
    sys.exit(0)

CODE = HOME / "repos" / "alpha"
AGENT = CODE / "agent"
(AGENT / "tickets").mkdir(parents=True)
git(CODE, "init", "-q")
(CODE / ".git/info/exclude").write_text("agent/\n")
git(CODE, "commit", "-q", "--allow-empty", "-m", "init")
git(AGENT, "init", "-q")
ticket("map-columns")
ticket("csv-import", "claimed", "map-columns")
git(AGENT, "add", "tickets")
git(AGENT, "commit", "-q", "-m", "file the tree", "-m", f"Session: {ORCHESTRATOR}")
pages = [page(f"sessions/{ORCHESTRATOR}/index.html", "<h1>session</h1>"),
         page("show/csv-import/index.html", "<h1>csv import</h1>"),
         page("show/map-columns/index.html", "<h1>map columns</h1><a id=link href='other.html'>other</a>")]
page("show/map-columns/other.html", "<h1>other</h1>")
(HOME / ".cache/diffview").mkdir(parents=True)
(HOME / ".cache/diffview/highlight.min.js").write_text("")  # diffview would fetch it otherwise
(CODE / "notes.txt").write_text("one\n")
git(CODE, "add", "notes.txt")
git(CODE, "commit", "-q", "-m", "notes")
DIFF = AGENT / "diffviews" / "map-columns.html"  # opened by the maximize steps at the end, after those counting panels
DIFF.parent.mkdir()
subprocess.run([BIN / "diffview", f"{CODE}@HEAD~1..HEAD", "-o", str(DIFF), "--no-auto-summary"], env=HUB_ENV,
               check=True, capture_output=True)

with socket.socket() as s:
    s.bind(("127.0.0.1", 0))
    PORT = s.getsockname()[1]
ORIGIN = f"http://127.0.0.1:{PORT}"
hub = subprocess.Popen([BIN / "container-hub", "--port", str(PORT), "--state", str(SCRATCH / "state")], env=HUB_ENV,
                       stdout=subprocess.DEVNULL, stderr=(SCRATCH / "hub.log").open("w"), start_new_session=True)


def api(path: str, body: dict | None = None) -> dict:
    req = urllib.request.Request(ORIGIN + path, data=json.dumps(body).encode() if body else None,
                                 method="POST" if body else "GET")
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read())


try:
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        try:
            socket.create_connection(("127.0.0.1", PORT), timeout=1).close()
            break
        except OSError:
            time.sleep(0.1)
    opened = [api("/api/open", {"target": str(p), "session": ORCHESTRATOR}) for p in pages]
    key, view_path = opened[0]["container"], opened[0]["view"]
    ids = {p.parent.name: o["id"] for p, o in zip(pages, opened)}

    with sync_playwright() as pw:
        browser = pw.chromium.launch(executable_path=CHROMIUM)
        context = browser.new_context(viewport={"width": 1600, "height": 950})
        view = context.new_page()
        errors = []
        view.on("pageerror", lambda e: errors.append(str(e)))
        view.goto(ORIGIN + view_path)
        view.wait_for_function("window.wc && ws.views().length === 3", timeout=30000)
        docked = lambda: sorted(view.evaluate("ws.views().filter(v => v.placement === 'docked').map(v => v.id)"))
        focused = lambda: view.evaluate("ws.getSnapshot().focusedView")
        frame_of = lambda member: next(f for f in view.frames if f.url.endswith(f"/{member}/index.html"))

        view.keyboard.press("Control+Alt+1")
        settles("ctrl+alt+1 goes into the first orchestrator", ORCHESTRATOR, lambda: view.evaluate("wc.current"))

        # the keys answer with the hub frozen: it gets the change once it runs again
        hub_view = lambda: api("/api/c/" + urllib.parse.quote(key, safe=""))
        csv_import = lambda: next(m for m in hub_view()["members"] if m["id"] == ids["csv-import"])
        events, listening = [], threading.Event()  # what the hub broadcasts on the container

        def listen() -> None:
            with urllib.request.urlopen(ORIGIN + "/events/" + urllib.parse.quote(key, safe="")) as r:
                for line in r:
                    listening.set()
                    if line.startswith(b"data:"):
                        events.append(json.loads(line[5:]))

        threading.Thread(target=listen, daemon=True).start()
        listening.wait(30)
        os.killpg(hub.pid, signal.SIGSTOP)
        try:
            view.evaluate(f"ws.focus({json.dumps(ids['csv-import'])})")
            view.keyboard.press("Control+Alt+w")
            settles("ctrl+alt+w takes the page out of the layout with the hub frozen", False, lambda: ids["csv-import"] in docked())
            view.evaluate(f"ws.focus({json.dumps(ids['map-columns'])})")
            view.keyboard.press("Control+Alt+d")
            settles("ctrl+alt+d marks the page seen with the hub frozen", True,
                    lambda: view.evaluate("Object.keys(wc.state.seen).some(u => u.endsWith('/map-columns/index.html'))"))
            settles("...and moves on to the next unseen page", ids["csv-import"], focused)
        finally:
            os.killpg(hub.pid, signal.SIGCONT)
        # closed reads False before the close arrives too, so the read waits until the hub has applied both
        settles("the hub has the close and the reopen once it runs again", {"close", "reopened"},
                lambda: {e["type"] for e in events if e.get("id") == ids["csv-import"]})
        check("...in that order", False, csv_import()["closed"])
        settles("...and the seen mark", True, lambda: any(u.endswith("/map-columns/index.html") for u in hub_view()["seen"]))

        # a ruling in the tracker minimizes the ticket's pages, and the session page stays
        # A page opened after its ticket's ruling stays up. The kernel stamps the ticket file from a clock a few
        # milliseconds behind the hub's, so a ruling written right after the reopen can read as older than it; it is
        # written again until it reads as newer.
        reopened_at, deadline = csv_import()["at"], time.monotonic() + 10
        ticket("csv-import", "done", "map-columns")
        while (AGENT / "tickets/csv-import.md").stat().st_mtime <= reopened_at and time.monotonic() < deadline:
            time.sleep(0.01)
            ticket("csv-import", "done", "map-columns")
        view.wait_for_function(f"!ws.views().some(v => v.id === {json.dumps(ids['csv-import'])} && v.placement === 'docked')",
                               timeout=10000)
        check("ruling a ticket in the tracker takes its pages out of the layout", sorted([ids["map-columns"], ids[ORCHESTRATOR]]),
              sorted(x for x in docked()))
        settles("...and the sheet lists them as minimized", True, lambda: "ruled · minimized" in view.inner_text("#sheet"))

        # links and keys inside a page
        frame_of("map-columns").click("#link")
        view.wait_for_function("ws.views().some(v => v.params.url.endsWith('/other.html'))", timeout=10000)
        other = view.evaluate("ws.views().find(v => v.params.url.endsWith('/other.html')).params")
        check("a plain click on a link opens it as a panel in the page's group", (ORCHESTRATOR, "map-columns"),
              (other["group"], other["ticket"]))
        view.evaluate(f"ws.focus({json.dumps(ids['map-columns'])})")  # other.html took its panel's front tab
        with context.expect_page(timeout=5000) as tab:
            frame_of("map-columns").click("#link", modifiers=["Control"])
        check("a ctrl-click opens it as a browser tab", True, tab.value.url.endswith("/other.html"))
        frame_of("map-columns").press("#link", "Control+Alt+0")
        settles("ctrl+alt+0 from inside a page goes to the overview", None, lambda: view.evaluate("wc.current"))

        # maximize: ctrl+alt+z takes the focused panel to the whole workspace and back
        diff_id = api("/api/open", {"target": str(DIFF), "session": ORCHESTRATOR})["id"]
        view.wait_for_function(f"ws.views().some(v => v.id === {json.dumps(diff_id)} && v.placement === 'docked')", timeout=10000)
        diff_panel = view.evaluate(f"ws.view({json.dumps(diff_id)}).panelId")
        diff_frame = next(f for f in view.frames if f.url.endswith("/diffviews/map-columns.html"))
        box = lambda sel: view.evaluate(f"(r => [r.x, r.y, r.width, r.height].map(Math.round))(document.querySelector({json.dumps(sel)}).getBoundingClientRect())")
        settle = lambda: view.evaluate("new Promise(r => requestAnimationFrame(() => requestAnimationFrame(() => r())))")  # trellis places panels a frame later
        panel_box = lambda: settle() or box(f'[data-trellis-part="panel"][data-panel="{diff_panel}"]')
        fills = lambda b, a: abs(b[0] - a[0]) <= 8 and abs(b[1] - a[1]) <= 8 and abs(b[2] - a[2]) <= 8 and abs(b[3] - a[3]) <= 8
        view.keyboard.press("Control+Alt+1")
        before = panel_box()
        # into the diff, over to the session page and back by a click: trellis hears no focus move between two pages
        diff_frame.click("body", position={"x": 300, "y": 200})
        diff_frame.press("body", "Control+Alt+h")
        diff_frame.click("body", position={"x": 300, "y": 200})
        settles("a click into a page focuses its panel, before any key", diff_panel, lambda: view.evaluate("ws.getSnapshot().focusedPanel"))
        diff_frame.press("body", "Control+Alt+z")
        settles("ctrl+alt+z from inside a page maximizes that page's panel", True, lambda: fills(panel_box(), box("#app")))
        diff_frame.press("body", "Control+Alt+z")
        settles("...and again restores it", before, panel_box)
        check("...staying in the orchestrator", ORCHESTRATOR, view.evaluate("wc.current"))
        tab = view.locator(f'[data-trellis-part="panel"][data-panel="{diff_panel}"] [role="tab"]').first
        tab.click()
        view.keyboard.press("Control+Alt+z")
        settles("ctrl+alt+z in the workspace maximizes the focused panel", True, lambda: fills(panel_box(), box("#app")))
        view.keyboard.press("Control+Alt+z")
        settles("...and again restores it", before, panel_box)
        tab.click(button="right")
        check("the panel menu's Maximize names ctrl+alt+z", True,
              "Ctrl+Alt+Z" in view.locator('[role="menuitem"]', has_text="Maximize").first.inner_text())
        view.keyboard.press("Escape")

        # the rail's switches; a key from inside a page is pressed after a click into it, as a person would
        def in_diff(key: str) -> None:
            diff_frame.click("body", position={"x": 300, "y": 200})
            diff_frame.press("body", key)

        in_diff("Control+Alt+m")
        settles("ctrl+alt+m turns minimize ruled off, and the checkbox follows", (False, True),
                lambda: (view.is_checked("#hide-ruled"), ids["csv-import"] in docked()))
        in_diff("Control+Alt+k")
        settles("ctrl+alt+k still focuses the panel above, the ruled ticket's row on top again", "csv-import",
                lambda: view.evaluate("ws.getSnapshot().focusedPanel").split(":")[2])
        settles("...and the keyboard goes with it", True,
                lambda: view.evaluate("document.activeElement === ws.view(ws.getSnapshot().focusedView).element.querySelector('iframe')"))
        tab.click()
        view.keyboard.press("Control+Alt+m")
        settles("ctrl+alt+m in the workspace turns it back on", (True, False),
                lambda: (view.is_checked("#hide-ruled"), ids["csv-import"] in docked()))
        in_diff("Control+Alt+Shift+K")
        settles("ctrl+alt+shift+k from inside a page folds the keys list open", True, lambda: view.evaluate("document.getElementById('keys').open"))
        settle()  # a focus move would land a frame later
        check("...and moves no focus", diff_panel, view.evaluate("ws.getSnapshot().focusedPanel"))
        tab.click()
        view.keyboard.press("Control+Alt+Shift+K")
        settles("...and in the workspace shut", False, lambda: view.evaluate("document.getElementById('keys').open"))
        keys = view.text_content("#keys")
        check("the keys list names ctrl+alt+m and ctrl+alt+shift+k", True, "ctrl+alt+m" in keys and "ctrl+alt+shift+k" in keys)
        check("no script errors", [], errors)
        browser.close()
finally:
    os.killpg(hub.pid, signal.SIGKILL)  # `uv run` leads the group; the server is its child
    hub.wait()
    shutil.rmtree(SCRATCH, ignore_errors=True)

print()
print("FAILED" if failures else "all ok")
sys.exit(1 if failures else 0)
