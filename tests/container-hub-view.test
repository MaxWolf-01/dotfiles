#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["playwright"]
# ///
"""Drive the hub tab (bin/container-hub.html) in headless Chromium and check what it promises: keys that answer
with the hub frozen, rulings from the tracker, links and keys inside a page, the rail's numbers following the
sessions' turns while focus stays put, a unit's two panes and the user's arrangement of them, the session page in its
sidebar as the list of a unit's pages that brings a minimized one back, an account hidden by a click on its name, a
page on another origin framed or opened as a tab on a click, and a page that still loads with many units open. Run it
directly; no framework. Skips when no chromium is on PATH ($CHROMIUM overrides).

GNOME takes its own bindings before a browser sees them, so a key that clashes with one passes here and
fails on the desktop: this is no substitute for driving the view in Brave.
"""

import http.server
import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import urllib.request
from pathlib import Path

from playwright.sync_api import Error as PlaywrightError, TimeoutError as PlaywrightTimeout, sync_playwright

BIN = Path(__file__).resolve().parents[1] / "bin"
CHROMIUM = os.environ.get("CHROMIUM") or shutil.which("chromium")
SCRATCH = Path(tempfile.mkdtemp(prefix="container-hub-view-test."))
HOME = SCRATCH / "home"
ORCHESTRATOR = "aaaaaaaa-0000-4000-8000-000000000001"
SECOND = "bbbbbbbb-0000-4000-8000-000000000002"  # an orchestrator of another subtree of the same tree
SELF_STARTED = Path("/proc/self/stat").read_text().rsplit(")", 1)[1].split()[19]

failures = 0


def check(what: str, expected, actual) -> None:
    global failures
    if expected == actual:
        print(f"ok   {what}")
    else:
        failures += 1
        print(f"FAIL {what}\n       expected: {expected!r}\n       actual:   {actual!r}")


def settles(what: str, expected, read, within: float = 10) -> None:
    """check() on what read() returns once it equals expected, or at the deadline: the view moves the keyboard a
    frame after a key, marks the session page after the layout, and the hub catches up after a thaw."""
    deadline = time.monotonic() + within
    while (actual := read()) != expected and time.monotonic() < deadline:
        time.sleep(0.05)
    check(what, expected, actual)


ENV = {k: v for k, v in os.environ.items() if not k.startswith(("CLAUDE", "MX_", "GIT_", "XDG_", "CONTAINER_HUB", "TMUX"))}
# Every tmux call, the hub's and the test's, goes through a tmux that passes on only those naming the test's own
# server's socket, and records the rest: nothing here may reach a server the test did not start.
TMUX_SOCKET = SCRATCH / "tmux.sock"
TMUX_REFUSED = SCRATCH / "tmux-refused"
TMUX = SCRATCH / "shim" / "tmux"
TMUX.parent.mkdir()
TMUX.write_text(f"""#!/usr/bin/env bash
[ "$1" = -S ] && [ "$2" = {shlex.quote(str(TMUX_SOCKET))} ] && exec {shlex.quote(shutil.which("tmux"))} "$@"
printf '%s\\n' "$*" >> {shlex.quote(str(TMUX_REFUSED))}
exit 1
""")
TMUX.chmod(0o755)
ENV["PATH"] = f"{TMUX.parent}:{ENV['PATH']}"
for k, args in (("UV_CACHE_DIR", ("cache", "dir")), ("UV_PYTHON_INSTALL_DIR", ("python", "dir"))):
    ENV[k] = subprocess.run(["uv", *args], capture_output=True, text=True, check=True).stdout.strip()
ENV.update(GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1")
HUB_ENV = {**ENV, "HOME": str(HOME)}
TICKET = "---\nstatus: {status}\n{parent}priority: 2\nsize: S\n---\n\n# {slug}\n\n## Brief\n\n{slug}.\n\n## Acceptance criteria\n\n## Comments\n"


def git(cwd: Path, *args: str) -> None:
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *args], cwd=cwd, env=HUB_ENV,
                   check=True, capture_output=True)


def ticket(slug: str, status: str = "open", parent: str | None = None) -> None:
    (AGENT / "tickets" / f"{slug}.md").write_text(
        TICKET.format(status=status, parent=f"parent: {parent}\n" if parent else "", slug=slug))


def registered(session: str, at: float, status: str = "idle", pid: int | None = None, started: str = SELF_STARTED,
               account: str = ".claude", file: str | None = None, **extra) -> None:
    """The session's file in the registry of its account, as Claude Code writes it while the session's process runs:
    by default this test's own process, which runs for as long as the hub reads it. A second process of the session
    has a file of its own."""
    path = HOME / account / "sessions" / f"{file or session[:8]}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"pid": pid or os.getpid(), "procStart": started, "sessionId": session, "status": status,
                                "statusUpdatedAt": int(at * 1000), **extra}))


def page(rel: str, body: str) -> Path:
    path = AGENT / rel
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(f"<!doctype html><body style='height:400px'>{body}")
    return path


if not CHROMIUM:
    print("skip: no chromium on PATH")
    sys.exit(0)

CODE = HOME / "repos" / "alpha"
AGENT = CODE / "agent"
(AGENT / "tickets").mkdir(parents=True)
git(CODE, "init", "-q")
(CODE / ".git/info/exclude").write_text("agent/\n")
git(CODE, "commit", "-q", "--allow-empty", "-m", "init")
git(AGENT, "init", "-q")
ticket("map-columns")
ticket("csv-import", "claimed", "map-columns")
git(AGENT, "add", "tickets")
git(AGENT, "commit", "-q", "-m", "file the tree", "-m", f"Session: {ORCHESTRATOR}")
# The session page as the mx renderer writes it, cut to what the hub reads: the artefact column (#artefacts), each
# link to an artefact carrying the absolute path it opens (data-artefact), on a collapsed turn's chips too, and the
# page's keys 1 to 9, which click the focused turn's links in the column.
SESSION_PAGE = f"""<h1>session</h1>
<details class="turn" id="t01" data-block><summary>turn 1 <span class="chip"><a class="chip-link" href="../../show/csv-import/index.html"
  data-artefact="{AGENT}/show/csv-import/index.html" target="_blank">csv import</a></span></summary></details>
<aside class="column" id="artefacts"><section class="group" id="a01"><a class="turn-ref" href="#t01">01</a><ol>
  <li><kbd class="n">1</kbd><a class="artefact" href="../../show/csv-import/index.html" data-artefact="{AGENT}/show/csv-import/index.html" target="_blank">csv import</a></li>
  <li><kbd class="n">2</kbd><a class="artefact" href="../../show/map-columns/index.html" data-artefact="{AGENT}/show/map-columns/index.html" target="_blank">map columns</a></li>
  <li><kbd class="n">3</kbd><a class="artefact" href="../../show/map-columns/sketch.html" data-artefact="{AGENT}/show/map-columns/sketch.html" target="_blank">sketch</a></li>
</ol></section></aside>
<script>document.addEventListener("keydown", (e) => {{
  if (!e.ctrlKey && !e.altKey && /^[1-9]$/.test(e.key)) document.querySelectorAll("#a01 a[data-artefact]")[+e.key - 1]?.click()
}})</script>"""
pages = [page(f"sessions/{ORCHESTRATOR}/index.html", SESSION_PAGE),
         page("show/csv-import/index.html", "<h1>csv import</h1>"),
         page("show/map-columns/index.html", "<h1>map columns</h1><a id=link href='other.html'>other</a>")]
page("show/map-columns/other.html", "<h1>other</h1>")
# the session page's reader, which the hub loads from the newest mx plugin: the one this machine has
READER = max(Path.home().glob(".claude*/plugins/cache/*/mx/*/skills/session-page/session_page.py"),
             key=lambda p: tuple(int(x) if x.isdigit() else 0 for x in p.parents[2].name.split(".")), default=None)
if READER:
    (HOME / ".claude/plugins/cache/market/mx").mkdir(parents=True)
    (HOME / ".claude/plugins/cache/market/mx" / READER.parents[2].name).symlink_to(READER.parents[2])
page("show/map-columns/sketch.html", "<h1>sketch</h1>")  # the column links it, and nobody opens it until ctrl+alt+n
# The board as the tracker renders it, cut to what the hub reads: a row per ticket, carrying its slug
# (details.ticket[data-slug]), in groups the done of which is folded. The rows before ORCHESTRATOR's open ticket push
# it out of view; csv-import is done by the time the board opens. drop-zone is SECOND's.
row = lambda slug: f'<details class="ticket" id="t-{slug}" data-slug="{slug}"><summary style="height:60px">{slug}</summary></details>'
page("board.html", '<details class="grp" id="grp-frontier" open><summary>frontier</summary>'
     + "".join(row(f"filler-{n}") for n in range(30)) + row("map-columns") + row("drop-zone")
     + '</details><details class="grp" id="grp-done"><summary>done</summary>' + row("csv-import") + "</details>")
HLJS = HOME / ".cache/diffview" / ("hljs-" + re.search(r'HLJS_VERSION = "(.+)"', (BIN / "diffview").read_text())[1])
HLJS.mkdir(parents=True)
(HLJS / "highlight.min.js").write_text("")  # fails its pin, so diffview neither fetches nor highlights
(CODE / "notes.txt").write_text("one\n")
git(CODE, "add", "notes.txt")
git(CODE, "commit", "-q", "-m", "notes")
DIFF = AGENT / "diffviews" / "map-columns.html"  # opened by the maximize steps at the end, after those counting panels
DIFF.parent.mkdir()
subprocess.run([BIN / "diffview", f"{CODE}@HEAD~1..HEAD", "-o", str(DIFF), "--no-auto-summary"], env=HUB_ENV,
               check=True, capture_output=True)

with socket.socket() as s:
    s.bind(("127.0.0.1", 0))
    PORT = s.getsockname()[1]
ORIGIN = f"http://127.0.0.1:{PORT}"
HUB_ARGS = [str(BIN / "container-hub"), "--port", str(PORT), "--state", str(SCRATCH / "state"), "--tmux-socket", str(TMUX_SOCKET)]


def start_hub() -> subprocess.Popen:
    started = subprocess.Popen(HUB_ARGS, env=HUB_ENV, stdout=subprocess.DEVNULL, stderr=(SCRATCH / "hub.log").open("a"),
                               start_new_session=True)
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        try:
            socket.create_connection(("127.0.0.1", PORT), timeout=1).close()
            break
        except OSError:
            time.sleep(0.1)
    return started


def kill_hub() -> None:
    os.killpg(hub.pid, signal.SIGKILL)
    hub.wait()
    deadline = time.monotonic() + 10  # `uv run` leads the group and is reaped first; the server holds the port until it goes too
    while time.monotonic() < deadline:
        try:
            os.killpg(hub.pid, 0)
            time.sleep(0.05)
        except ProcessLookupError:
            break


hub = None


HELD = threading.Event()  # set, /slow answers


class Elsewhere(http.server.BaseHTTPRequestHandler):
    """A local server on another origin than the hub's: /deny and /self refuse framing, /slow answers only once HELD is
    set, so a page fetching it has not loaded until then, and any other path allows framing."""

    def do_GET(self):
        if self.path == "/slow":
            HELD.wait(60)
        self.send_response(200)
        if self.path == "/deny":
            self.send_header("X-Frame-Options", "DENY")
        if self.path == "/self":
            self.send_header("Content-Security-Policy", "frame-ancestors 'self'")
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        self.wfile.write(b"<!doctype html><h1>an app</h1>")

    def log_message(self, *_):
        pass


elsewhere = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Elsewhere)
threading.Thread(target=elsewhere.serve_forever, daemon=True).start()


def api(path: str, body: dict | None = None) -> dict:
    req = urllib.request.Request(ORIGIN + path, data=json.dumps(body).encode() if body else None,
                                 method="POST" if body else "GET")
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.loads(r.read())


try:
    hub = start_hub()
    t0 = time.time()
    os.utime(pages[0], (t0 - 100, t0 - 100))  # the session page's render: when ORCHESTRATOR last finished a turn
    registered(ORCHESTRATOR, t0 - 100)
    opened = [api("/api/open", {"target": str(p), "session": ORCHESTRATOR}) for p in pages]
    mids = {p.parent.name: o["id"] for p, o in zip(pages, opened)}
    ids = {k: f"{ORCHESTRATOR}~{v}" for k, v in mids.items()}  # a page's view in the hub tab is its unit's

    with sync_playwright() as pw:
        browser = pw.chromium.launch(executable_path=CHROMIUM)
        context = browser.new_context(viewport={"width": 1600, "height": 950})
        context.grant_permissions(["clipboard-read", "clipboard-write"], origin=ORIGIN)
        view = context.new_page()
        errors = []
        view.on("pageerror", lambda e: errors.append(str(e)))
        view.goto(ORIGIN + "/")
        view.wait_for_function("window.wc && ws.views().length === 2", timeout=30000)
        docked = lambda: sorted(view.evaluate("ws.views().filter(v => v.placement === 'docked').map(v => v.id)"))
        focused = lambda: view.evaluate("ws.getSnapshot().focusedView")

        def frame_at(suffix: str):
            """The frame showing the page, once loaded: a panel is in the layout before its iframe navigates."""
            view.wait_for_function(f"[...document.querySelectorAll('iframe')].some(f => f.contentDocument?.readyState === 'complete'"
                                   f" && f.contentWindow.location.pathname.endsWith({json.dumps(suffix)}))", timeout=30000)
            deadline = time.monotonic() + 10
            while not (f := next((f for f in view.frames if f.url.endswith(suffix)), None)):
                if time.monotonic() > deadline:
                    raise RuntimeError(f"no frame shows {suffix}")
                view.wait_for_timeout(50)  # playwright hears of the navigation after the page shows it
            return f

        frame_of = lambda member: frame_at(f"/{member}/index.html")
        def line(suffix: str):
            """How the session page's column marks the page whose path ends so: open, minimized, tab, or "" for not
            opened yet, with the glyph before its line. None while the page is reloading, or lists no such page."""
            try:
                return frame_of(ORCHESTRATOR).evaluate("""s => {
                    const a = [...document.querySelectorAll('#artefacts a[data-artefact]')].find(a => a.dataset.artefact.endsWith(s));
                    const mark = a?.previousElementSibling;
                    return a && mark?.classList.contains('hub-mark') ? [a.dataset.hub ?? "", mark.textContent] : null }""", suffix)
            except PlaywrightError:
                return None
        line_link = lambda suffix: f'#artefacts a[data-artefact$="{suffix}"]'
        def written() -> None:
            """Wait until the hub has answered every write the tab queued (wc.sending). A key shows its change in the
            tab and queues its write to the hub: settle on what the tab shows, then call this before reading the hub.
            A write the hub never got is queued again only once the hub is back, so a read of that settles instead."""
            view.evaluate("(async () => { for (let p; p !== wc.sending;) await (p = wc.sending); })()")

        holds_keyboard = "document.activeElement === ws.view(ws.getSnapshot().focusedView)?.element.querySelector('iframe')"
        # the session page of the unit you are in, in the sidebar right of the rail
        sidebar_page = "document.querySelector('#session-frames > .current iframe')"
        holds_session = f"document.activeElement === {sidebar_page}"
        sidebar_url = lambda page=view: page.evaluate(f"({sidebar_page})?.getAttribute('src') ?? null")

        def focus_session() -> None:
            """The keyboard into the session page, as a click into it would put it there."""
            view.evaluate(f"{sidebar_page}.focus()")
            view.wait_for_function(holds_session, timeout=10000)

        def focus(member: str) -> None:
            """Focus a page as a click would, and wait for trellis to move the keyboard into it a frame later."""
            view.evaluate(f"ws.focus({json.dumps(ids[member])})")
            view.wait_for_function(holds_keyboard, timeout=10000)

        for member in ("csv-import", "map-columns"):  # a key that trellis sends into a page still loading goes nowhere
            frame_of(member)
        check("the overview shows no session page", (None, True), (view.evaluate("wc.current"),
              view.evaluate("document.getElementById('session-side').getBoundingClientRect().width === 0")))
        view.keyboard.press("Control+Alt+1")
        settles("ctrl+alt+1 goes into the first orchestrator", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        frame_of(ORCHESTRATOR)
        # a unit's columns left to right, each the panels in it
        panes = lambda page=view: page.evaluate(f"""(() => {{
            const d = ws.getDocument(), panels = (n) => n.kind === "panel" ? [n] : n.children.flatMap(panels);
            const mine = (n) => d.views[panels(n)[0].views[0]]?.params.group === "{ORCHESTRATOR}";
            const top = d.root.id === "root" ? d.root.children.find(mine) : d.root;
            return (top.kind === "split" && top.axis === "x" ? top.children : [top]).map((c) => panels(c).map((p) => p.id).join("+"));
        }})()""")
        pane_id = lambda name: f"p:{ORCHESTRATOR}:{name}"
        # the panels the camera shows, left to right
        on_screen = lambda: view.evaluate("""(() => { const app = document.getElementById("app").getBoundingClientRect();
            return [...document.querySelectorAll('[data-trellis-part="panel"]')].map((e) => [e.dataset.panel, e.getBoundingClientRect()])
              .filter(([, r]) => r.width > 40 && r.left >= app.left - 4 && r.right <= app.right + 4).sort((a, b) => a[1].left - b[1].left).map(([id]) => id); })()""")
        # hub-layout-pass 1 and 2
        check("the session page is in the sidebar right of the rail, never a tab", (f"/f{urllib.parse.quote(str(pages[0]))}", False),
              (sidebar_url(), view.evaluate("ws.views().some(v => v.params.kind === 'session')")))
        check("...and the other pages of a unit open in a pane on the left: two tickets' show pages as its tabs",
              ([pane_id("left")], [pane_id("left")] * 2),
              (panes(), [view.evaluate(f"ws.view({json.dumps(ids[k])}).panelId") for k in ("csv-import", "map-columns")]))
        settles("...on screen", [pane_id("left")], on_screen)

        # the keys answer with the hub frozen: it gets the change once it runs again
        hub_view = lambda: api("/api/u/" + ORCHESTRATOR)
        csv_import = lambda: next(m for m in hub_view()["members"] if m["id"] == mids["csv-import"])
        events, listening = [], threading.Event()  # what the hub broadcasts

        def listen() -> None:
            with urllib.request.urlopen(ORIGIN + "/events") as r:
                for line in r:
                    listening.set()
                    if line.startswith(b"data:"):
                        events.append(json.loads(line[5:]))

        threading.Thread(target=listen, daemon=True).start()
        check("the test hears the hub's events", True, listening.wait(30))
        # the close is held back on its way, so a reopen sent without waiting on it would reach the hub first
        view.route("**/api/close", lambda r: (time.sleep(1), r.continue_()))
        os.killpg(hub.pid, signal.SIGSTOP)
        try:
            focus("csv-import")
            view.keyboard.press("Control+Alt+w")
            settles("ctrl+alt+w takes the page out of the layout with the hub frozen", False, lambda: ids["csv-import"] in docked())
            settles("...its line marked minimized in the session page's column", ["minimized", "–"], lambda: line("/csv-import/index.html"))
            view.keyboard.press("Control+Alt+Shift+W")
            settles("ctrl+alt+shift+w brings it back with the hub frozen", True, lambda: ids["csv-import"] in docked())
        finally:
            os.killpg(hub.pid, signal.SIGCONT)
            view.unroute("**/api/close")
        written()
        check("the page is open in the hub once it runs again", False, csv_import()["closed"])
        settles("...having had the close and then the reopen", {"close", "reopened"},
                lambda: {e["type"] for e in events if e.get("id") == mids["csv-import"]})

        # hub-layout-pass 4: a ruling in the tracker minimizes nothing
        ticket("csv-import", "done", "map-columns")
        view.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(ORCHESTRATOR)}).tickets"
                               ".find(t => t.slug === 'csv-import')?.status === 'done'", timeout=10000)
        view.wait_for_timeout(500)  # past whatever the tab does on the hub's news of the ruling
        check("ruling a ticket leaves its pages where they are", True, ids["csv-import"] in docked())
        check("...and the hub tab has no switch, and no mark, of anything seen", (None, False),
              (view.evaluate("document.getElementById('hide-ruled')"), frame_of(ORCHESTRATOR).evaluate(
                  "[...document.querySelectorAll('.hub-mark')].some(m => m.textContent === '✓' || m.hasAttribute('data-seen'))")))
        focus("csv-import")
        view.keyboard.press("Control+Alt+w")
        settles("a ruled ticket's page minimizes as any other does", (False, ["minimized", "–"]),
                lambda: (ids["csv-import"] in docked(), line("/csv-import/index.html")))

        # links and keys inside a page
        frame_of("map-columns").click("#link")
        view.wait_for_function("ws.views().some(v => v.params.url.endsWith('/other.html'))", timeout=10000)
        other = view.evaluate("ws.views().find(v => v.params.url.endsWith('/other.html')).params")
        check("a plain click on a link opens it as a panel in the page's unit", (ORCHESTRATOR, "map-columns"),
              (other["group"], other["ticket"]))
        focus("map-columns")  # other.html took its panel's front tab
        with context.expect_page(timeout=30000) as tab:
            frame_of("map-columns").click("#link", modifiers=["Control"])
        check("a ctrl-click opens it as a browser tab", True, tab.value.url.endswith("/other.html"))
        tab.value.close()

        def link(href: str) -> None:
            """A link in the map-columns page, clicked as a person would."""
            focus("map-columns")
            frame_of("map-columns").evaluate(
                "href => { const a = Object.assign(document.createElement('a'), { id: 'added', href, textContent: 'added' });"
                " document.getElementById('added')?.remove(); document.body.prepend(a); }", href)
            frame_of("map-columns").click("#added")

        third = page("show/map-columns/third.html", "<h1>third</h1>")
        link(f"http://localhost:{PORT}/f{urllib.parse.quote(str(third))}")
        settles("a link to the hub by its other name opens as a panel too", True,
                lambda: view.evaluate("ws.views().some(v => v.params.url.endsWith('/third.html'))"))
        clipboard = lambda: frame_of("map-columns").evaluate("navigator.clipboard.readText()")
        views_before = view.evaluate("ws.views().length")
        link(f"file://{urllib.parse.quote(str(third.parent))}")
        settles("a link to a directory copies its path", str(third.parent), clipboard)
        check("...and opens nothing", views_before, view.evaluate("ws.views().length"))
        frame_of("map-columns").evaluate("""() => { document.body.insertAdjacentHTML("afterbegin",
            '<p>at <code id="inline"> 2a3754f9 </code></p><pre><code id="block">make check</code></pre>'); }""")
        frame_of("map-columns").click("#inline")
        settles("a click on inline code copies its text", "2a3754f9", clipboard)
        frame_of("map-columns").click("#block")
        view.wait_for_timeout(300)
        check("...and one on a code block copies nothing", "2a3754f9", clipboard())
        shot = AGENT / "show/map-columns/shot.svg"
        shot.write_text('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200"><rect width="400" height="200"/></svg>')
        frame_of("map-columns").evaluate("""() => { document.body.insertAdjacentHTML("afterbegin",
            '<img id="shot" src="shot.svg" width="200"> <img id="icon" src="shot.svg" width="16">'
            + ' <a href="other.html"><img id="thumb" src="shot.svg" width="200"></a>'); }""")
        frame_of("map-columns").wait_for_function("document.getElementById('shot').complete")
        looked = lambda: view.evaluate("document.querySelector('#look img')?.src.split('/').pop() ?? null")
        looked_width = lambda: view.evaluate("parseFloat(document.querySelector('#look img')?.style.width)")
        views_before = view.evaluate("ws.views().length")
        frame_of("map-columns").click("#shot")
        settles("a click on an image in a page looks at it closer, over the tab", "shot.svg", looked)
        check("...and opens no page", views_before, view.evaluate("ws.views().length"))
        settles("...fitted to the tab", True, lambda: looked_width() > 400)
        fitted_width = looked_width()
        view.mouse.move(700, 400)
        view.mouse.wheel(0, -300)
        settles("...zoomed by the wheel", True, lambda: looked_width() > fitted_width)
        view.keyboard.press("Escape")
        settles("...and put away by esc", None, looked)
        frame_of("map-columns").click("#icon")
        view.wait_for_timeout(300)
        check("a click on an icon looks at nothing", None, looked())
        frame_of("map-columns").click("#thumb")
        view.wait_for_timeout(300)
        check("...nor one on an image in a link to another page", None, looked())
        focus("map-columns")
        frame_of("map-columns").click("#shot")
        view.mouse.click(5, 300)
        settles("a click beside an image looked at puts it away", None, looked)
        frame_of("map-columns").click("#shot")
        view.keyboard.press("p")
        settles("p keeps it as a page of the unit", True, lambda: view.evaluate("ws.views().some(v => v.params.url.endsWith('/shot.svg'))"))
        check("...and puts it away", None, looked())
        shot.unlink()  # out of the unit again, whose pages the checks below count
        links_page = page("show/map-columns/links.html", f'<a id="dir" href="file://{urllib.parse.quote(str(third.parent))}">dir</a>'
                                                         f' <a id="page" href="file://{urllib.parse.quote(str(third))}">third</a>')
        api("/api/open", {"target": str(links_page), "session": ORCHESTRATOR})
        frame_at("/links.html")
        colour = lambda sel: frame_at("/links.html").evaluate(f"getComputedStyle(document.querySelector('{sel}')).color")
        settles("a link that copies is drawn as the text around it, one that opens as a link",
                (True, False), lambda: (colour("#dir") == colour("body"), colour("#page") == colour("body")))
        links_page.unlink()  # out of the unit again, whose pages the checks below count
        focus("map-columns")
        frame_of("map-columns").press("#link", "Control+Alt+0")
        settles("ctrl+alt+0 from inside a page goes to the overview", None, lambda: view.evaluate("wc.current"))

        # one-hub-tab#P2: a page minimized is listed in its unit's session page, and one key or click brings it back
        view.keyboard.press("Control+Alt+1")
        settles("in the orchestrator again, its session page in the sidebar", f"/f{urllib.parse.quote(str(pages[0]))}", sidebar_url)
        check("the hub tab has no sheet of its own", None, view.evaluate("document.getElementById('sheet')"))
        check("the column marks each page open (●), minimized (–) or not opened yet (○)",
              (["open", "●"], ["minimized", "–"], ["", "○"]),
              (line("/map-columns/index.html"), line("/csv-import/index.html"), line("/sketch.html")))
        check("...and so does a collapsed turn's chip, csv import's", "minimized",
              frame_of(ORCHESTRATOR).evaluate("document.querySelector('.chip a[data-artefact]').dataset.hub"))
        unlinked = lambda: frame_of(ORCHESTRATOR).evaluate("[...document.querySelectorAll('#hub-unlinked a[data-artefact]')].map(a => a.dataset.artefact.split('/').pop())")
        settles("the pages no turn links are listed at the column's end, in the order they were opened", ["other.html", "third.html"], unlinked)
        check("...after every line the renderer wrote", True, frame_of(ORCHESTRATOR).evaluate(
            "document.querySelector('#artefacts').lastElementChild.id === 'hub-unlinked'"))
        focus("map-columns")
        view.keyboard.press("Control+Alt+w")
        settles("ctrl+alt+w minimizes the page: out of the layout, its line marked minimized", (False, ["minimized", "–"]),
                lambda: (ids["map-columns"] in docked(), line("/map-columns/index.html")))
        written()
        check("...still a member, minimized", True, next(m for m in hub_view()["members"] if m["id"] == mids["map-columns"])["closed"])
        frame_of(ORCHESTRATOR).click(line_link("/map-columns/index.html"))
        settles("a click on its line in the column brings it back to its pane, focused", (pane_id("left"), ids["map-columns"]),
                lambda: (view.evaluate(f"ws.view({json.dumps(ids['map-columns'])})?.panelId ?? null"), focused()))
        settles("...its line marked open again", ["open", "●"], lambda: line("/map-columns/index.html"))
        view.keyboard.press("Control+Alt+w")
        settles("minimized again", False, lambda: ids["map-columns"] in docked())
        view.wait_for_function(holds_keyboard, timeout=10000)  # the panel nearest it takes the keyboard a frame later
        frame_of(ORCHESTRATOR).press("#t01 > summary", "2")
        settles("the session page's key 2 brings back the focused turn's second page", (pane_id("left"), ids["map-columns"]),
                lambda: (view.evaluate(f"ws.view({json.dumps(ids['map-columns'])})?.panelId ?? null"), focused()))
        other_id = view.evaluate("ws.views().find(v => v.params.url.endsWith('/other.html')).id")
        view.evaluate(f"ws.focus({json.dumps(other_id)})")
        view.wait_for_function(holds_keyboard, timeout=10000)
        view.keyboard.press("Control+Alt+w")
        settles("a page no turn links, minimized, is marked so at the column's end", (False, ["minimized", "–"]),
                lambda: (other_id in docked(), line("/other.html")))
        frame_of(ORCHESTRATOR).click(line_link("/other.html"))
        settles("...and a click on its line there brings it back", True, lambda: other_id in docked())
        view.evaluate(f"ws.focus({json.dumps(other_id)})")
        view.wait_for_function(holds_keyboard, timeout=10000)
        view.keyboard.press("Control+Alt+w")
        settles("minimized again", False, lambda: other_id in docked())
        view.keyboard.press("Control+Alt+Shift+W")
        settles("ctrl+alt+shift+w brings back the page minimized last, not the one minimized before it", (True, False),
                lambda: (other_id in docked(), ids["csv-import"] in docked()))
        laid_out = docked()
        focus_session()
        view.keyboard.press("Control+Alt+w")
        view.wait_for_timeout(300)
        check("ctrl+alt+w with the keyboard in the session page minimizes nothing, the page being no tab",
              (laid_out, True, f"/f{urllib.parse.quote(str(pages[0]))}"), (docked(), view.evaluate(holds_session), sidebar_url()))
        keys = view.text_content("#keys")
        check("the keys list says how to bring a minimized page back", True,
              "minimize" in keys and "click its line" in keys and "ctrl+alt+shift+w" in keys)
        view.keyboard.press("Control+Alt+0")

        # maximize: ctrl+alt+z takes the focused panel, or the session page, over the whole window and back
        diff_id = f"{ORCHESTRATOR}~" + api("/api/open", {"target": str(DIFF), "session": ORCHESTRATOR})["id"]
        view.wait_for_function(f"ws.views().some(v => v.id === {json.dumps(diff_id)} && v.placement === 'docked')", timeout=10000)
        diff_panel = view.evaluate(f"ws.view({json.dumps(diff_id)}).panelId")
        diff_frame = frame_at("/diffviews/map-columns.html")
        box = lambda sel: view.evaluate(f"(r => [r.x, r.y, r.width, r.height].map(Math.round))(document.querySelector({json.dumps(sel)}).getBoundingClientRect())")
        settle = lambda: view.evaluate("new Promise(r => requestAnimationFrame(() => requestAnimationFrame(() => r())))")  # trellis places panels a frame later
        panel_box = lambda: settle() or box(f'[data-trellis-part="panel"][data-panel="{diff_panel}"]')
        fills = lambda b, a: abs(b[0] - a[0]) <= 8 and abs(b[1] - a[1]) <= 8 and abs(b[2] - a[2]) <= 8 and abs(b[3] - a[3]) <= 8
        window = lambda: view.evaluate("[0, 0, innerWidth, innerHeight]")
        sides = lambda: view.evaluate("['rail-side', 'session-side'].map((id) => document.getElementById(id).getBoundingClientRect().width > 0)")
        check("a diffview page goes to the pane on the right", [pane_id("left"), pane_id("right")], panes())
        view.keyboard.press("Control+Alt+1")
        settles("the camera frames the unit whole: both panes on screen", [pane_id("left"), pane_id("right")], on_screen)
        focus("map-columns")
        view.keyboard.press("Control+Alt+l")
        settles("ctrl+alt+l moves the keyboard to the pane on the right", (diff_panel, True),
                lambda: (view.evaluate("ws.getSnapshot().focusedPanel"), view.evaluate(holds_keyboard)))
        check("...the camera staying, both panes being in sight", [pane_id("left"), pane_id("right")], on_screen())
        view.keyboard.press("Control+Alt+l")
        settle()
        check("...and at the rightmost pane the keyboard stays", diff_panel, view.evaluate("ws.getSnapshot().focusedPanel"))
        before = panel_box()
        # into the diff, over to the left pane and back by a click: trellis hears no focus move between two pages
        diff_frame.click("body", position={"x": 300, "y": 200})
        view.mouse.click(*view.evaluate(f"(r => [r.x + r.width / 2, r.y + r.height / 2])(document.querySelector('[data-panel=\"{pane_id("left")}\"]').getBoundingClientRect())"))
        diff_frame.click("body", position={"x": 300, "y": 200})
        settles("a click into a page focuses its panel, before any key", diff_panel, lambda: view.evaluate("ws.getSnapshot().focusedPanel"))
        diff_frame.press("body", "Control+Alt+z")
        settles("ctrl+alt+z from inside a page puts that page's panel over the whole window", True, lambda: fills(panel_box(), window()))
        check("...both sidebars out of sight", [False, False], sides())
        diff_frame.press("body", "Control+Alt+z")
        settles("...and again restores it", before, panel_box)
        check("...staying in the orchestrator", ORCHESTRATOR, view.evaluate("wc.current"))
        tab = view.locator(f'[data-trellis-part="panel"][data-panel="{diff_panel}"] [role="tab"]').first
        tab.click()
        view.keyboard.press("Control+Alt+z")
        settles("ctrl+alt+z in the workspace puts the focused panel over the whole window", True, lambda: fills(panel_box(), window()))
        view.keyboard.press("Control+Alt+z")
        settles("...and again restores it", before, panel_box)
        check("...both sidebars back", [True, True], sides())
        view.keyboard.press("Control+Alt+z")
        settles("maximized again,", True, lambda: fills(panel_box(), window()))
        view.keyboard.press("Control+Alt+a")
        settles("...ctrl+alt+a brings everything back rather than folding the rail away unseen", (before, [True, True]), lambda: (panel_box(), sides()))
        view.keyboard.press("Control+Alt+z")
        settles("maximized again,", True, lambda: fills(panel_box(), window()))
        view.keyboard.press("Control+Alt+h")
        settles("...ctrl+alt+h brings everything back and the keyboard into the panel on the left", (before, [True, True], pane_id("left")),
                lambda: (panel_box(), sides(), view.evaluate("ws.getSnapshot().focusedPanel")))
        focus_session()
        view.keyboard.press("Control+Alt+z")
        settles("ctrl+alt+z with the keyboard in the session page puts it over the whole window", True, lambda: fills(box("#session-side"), window()))
        check("...the rail and the panes out of sight", [0, 0], [box("#rail-side")[2], box("#work")[2]])
        view.keyboard.press("Control+Alt+z")
        settles("...and again brings them back", (before, [True, True]), lambda: (panel_box(), sides()))
        check("...the keyboard still in the session page", True, view.evaluate(holds_session))
        tab.click()
        tab.click(button="right")
        check("the panel menu's Maximize names ctrl+alt+z", True,
              "Ctrl+Alt+Z" in view.locator('[role="menuitem"]', has_text="Maximize").first.inner_text())
        view.keyboard.press("Escape")
        tab.click()
        view.keyboard.press("F6")
        settle()
        check("F6 in the workspace moves no panel's focus: it is the browser's", diff_panel, view.evaluate("ws.getSnapshot().focusedPanel"))
        view.keyboard.press("Shift+F6")
        settle()
        check("...and neither does shift+F6", diff_panel, view.evaluate("ws.getSnapshot().focusedPanel"))

        # the rail's switches; a key from inside a page is pressed after a click into it, as a person would
        def in_diff(key: str) -> None:
            diff_frame.click("body", position={"x": 300, "y": 200})
            diff_frame.press("body", key)

        in_diff("Control+Alt+l")  # the rightmost pane already: the keyboard stays
        # trellis's drag gestures, every one held on a chord the hub's keys share, are off: no grab hand or crosshair, and
        # the page under the pointer takes a click
        gesture = lambda: view.evaluate(f"""(() => {{ const f = ws.view({json.dumps(diff_id)}).element.querySelector("iframe"), r = f.getBoundingClientRect();
            return [document.querySelector(".trellis").getAttribute("data-gesture-key"),
                    document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2) === f]; }})()""")
        tab.click()
        for chord in (["Control", "Alt"], ["Control", "Alt", "Shift"], ["Control", "Shift"], ["Control", "Alt", "v"]):
            for k in chord:
                view.keyboard.down(k)
            settle()
            check(f"{'+'.join(chord).lower()} held in the workspace takes no drag gesture, and a page still takes a click",
                  [None, True], gesture())
            for k in reversed(chord):
                view.keyboard.up(k)
        # a drag on the rail's grip makes every page deaf to the pointer while it lasts
        grip = view.locator("#rail-side .grip").bounding_box()
        view.evaluate("document.querySelector('#rail-side .grip').addEventListener('pointerdown', (e) => { window.gripPointer = e.pointerId; }, { once: true })")
        at = lambda dy: (grip["x"] + grip["width"] / 2, grip["y"] + grip["height"] / 2 + dy)  # straight down: the rail keeps its width
        view.mouse.move(*at(0))
        view.mouse.down()
        view.mouse.move(*at(1))  # a capture takes hold, and is let go, at the pointer's next event
        resizing = lambda: view.evaluate("document.body.classList.contains('resizing')")
        check("a drag on the rail's grip holds the pointer", True, resizing())
        view.evaluate("document.querySelector('#rail-side .grip').releasePointerCapture(gripPointer)")  # as a pointercancel would
        view.mouse.move(*at(2))
        settles("...and ends when the grip loses it, before any pointerup", False, resizing)
        view.mouse.up()
        in_diff("Control+Alt+h")
        settles("ctrl+alt+h from inside a page moves the keyboard to the pane on its left", (pane_id("left"), True),
                lambda: (view.evaluate("ws.getSnapshot().focusedPanel"), view.evaluate(holds_keyboard)))
        view.keyboard.press("Control+Alt+h")
        settles("...and from the leftmost pane into the session page in its sidebar", True, lambda: view.evaluate(holds_session))
        view.keyboard.press("Control+Alt+l")
        settles("...and ctrl+alt+l from there to the leftmost pane", (pane_id("left"), True),
                lambda: (view.evaluate("ws.getSnapshot().focusedPanel"), view.evaluate(holds_keyboard)))
        view.keyboard.press("Control+Alt+l")
        settles("...and on to the right", (diff_panel, True),
                lambda: (view.evaluate("ws.getSnapshot().focusedPanel"), view.evaluate(holds_keyboard)))
        check("...the camera never moving", [pane_id("left"), pane_id("right")], on_screen())
        keys_open = lambda: view.evaluate("document.getElementById('keys').open")
        in_diff("Control+Alt+?")
        settles("ctrl+alt+? from inside a page folds the keys list open", True, keys_open)
        settle()  # a focus move would land a frame later
        check("...and moves no focus", diff_panel, view.evaluate("ws.getSnapshot().focusedPanel"))
        tab.click()
        view.keyboard.press("Control+Alt+?")
        settles("...and in the workspace shut", False, keys_open)
        zoom = lambda: view.evaluate("Object.values(JSON.parse(localStorage.getItem('wc:zoom') ?? '{}'))")
        zoom_before = zoom()
        # on a German layout ? is shift+ß, the key US layouts have - on, and ctrl+alt acting as AltGr types \ there
        diff_frame.evaluate("""document.body.dispatchEvent(new KeyboardEvent("keydown",
            { key: "\\\\", code: "Minus", ctrlKey: true, altKey: true, shiftKey: true, bubbles: true, cancelable: true }))""")
        settles("ctrl+alt+? as a German layout types it folds the keys list open too", True, keys_open)
        check("...and zooms nothing out", zoom_before, zoom())
        diff_frame.evaluate("""document.body.dispatchEvent(new KeyboardEvent("keydown",
            { key: "\\\\", code: "Minus", ctrlKey: true, altKey: true, shiftKey: true, bubbles: true, cancelable: true }))""")
        settles("...and shut", False, keys_open)
        view.keyboard.press("Control+Alt+Shift+Minus")  # _ on a US layout
        settles("ctrl+alt+shift+- on a US layout still zooms out, and folds nothing open", (True, False),
                lambda: (zoom() != zoom_before, keys_open()))
        view.keyboard.press("Control+Alt+Equal")
        settles("...and ctrl+alt+= zooms it back in", zoom_before, zoom)

        # hub-sidebar-zoom: the rail and the session sidebar each zoom on their own, by the keys where the keyboard is
        # and by the − % + at their top, and keep it across a reload
        def zooms(page=view):
            """The rail's zoom, the session sidebar's, its session page's and box's as drawn, and every page's."""
            return page.evaluate(f"""[localStorage.getItem("wc:side:rail:zoom"), localStorage.getItem("wc:side:session:zoom"),
                getComputedStyle(document.querySelector("#rail > .usage")).zoom, {sidebar_page}.contentDocument.documentElement.style.zoom,
                getComputedStyle(document.getElementById("session-box")).zoom, localStorage.getItem("wc:zoom")]""")
        unzoomed = zooms()
        pages_zoom = unzoomed[5]
        check("both sidebars start at 100%", [None, None, "1", "", "1"], unzoomed[:5])
        view.focus("#search")
        view.keyboard.press("Control+Alt+Equal")
        settles("ctrl+alt++ with the keyboard in the rail's search box zooms the rail alone", ["1.1", None, "1.1", "", "1", pages_zoom], zooms)
        focus_session()
        view.keyboard.press("Control+Alt+Minus")
        view.keyboard.press("Control+Alt+Minus")
        settles("ctrl+alt+- twice in the session page zooms the session sidebar alone, its page and box both",
                ["1.1", "0.8", "1.1", "0.8", "0.8", pages_zoom], zooms)
        zoomer = lambda side, part: view.locator(f'.zoomer[data-side="{side}"] .{part}')
        zoomer("rail", "in").click()
        zoomer("session", "out").click()
        settles("the + at the rail's top and the − at the session sidebar's do the same",
                ["1.25", "0.7", "1.25", "0.7", "0.7", pages_zoom], zooms)
        check("...each showing its sidebar's percentage", ["125%", "70%"], [zoomer("rail", "pct").inner_text(), zoomer("session", "pct").inner_text()])
        if shot := os.environ.get("HUB_VIEW_SCREENSHOT"):
            view.screenshot(path=shot)
        kept = context.new_page()
        kept.goto(ORIGIN + "/")
        kept.wait_for_function(f"window.wc && {sidebar_page}?.contentDocument?.readyState === 'complete'", timeout=30000)
        settles("a reloaded hub tab keeps both", ["1.25", "0.7", "1.25", "0.7", "0.7", pages_zoom], lambda: zooms(kept))
        kept.close()
        focus_session()
        view.keyboard.press("Control+Alt+Shift+Digit3")  # # on a US layout
        zoomer("rail", "pct").click()
        settles("ctrl+alt+# in the session page, and a click on the rail's percentage, put them back at 100%", unzoomed, zooms)

        # hub-theme-switch: the switch at the rail's top pins the other scheme on the tab and every page in it, a reload
        # keeps it, and picked again it gives the tab back to the system's (day under playwright). Playwright's emulated
        # scheme pins every frame's prefers-color-scheme, so a framed page following the frame's color-scheme shows only
        # in a browser without it.
        def schemes(page=view):
            """The tab's pin, its ground as painted, and its session page's pin."""
            return page.evaluate(f"""[localStorage.getItem("hub:theme"), getComputedStyle(document.body).backgroundColor,
                {sidebar_page}.contentDocument.documentElement.dataset.theme]""")
        day, night = [None, "rgb(244, 228, 205)", "day"], ["night", "rgb(26, 23, 20)", "night"]
        check("the tab starts on the system's scheme", day, schemes())
        view.click("#scheme")
        settles("the switch pins night on the tab and its session page", night, schemes)
        kept = context.new_page()
        kept.goto(ORIGIN + "/")
        kept.wait_for_function(f"window.wc && {sidebar_page}?.contentDocument?.readyState === 'complete'", timeout=30000)
        settles("a reloaded hub tab keeps the pin", night, lambda: schemes(kept))
        kept.close()
        view.click("#scheme")
        settles("day, the system's scheme, is no pin", day, schemes)
        keys = view.text_content("#keys")
        check("the keys list names ctrl+alt+s, ctrl+alt+? and ctrl+alt+d, and nothing of seen or of ctrl+alt+shift+k", (True, False),
              ("ctrl+alt+s" in keys and "ctrl+alt+?" in keys and "ctrl+alt+d" in keys, "seen" in keys or "ctrl+alt+m" in keys or "shift+k" in keys))
        check("...the panes on ctrl+alt+h / l, the rail on ctrl+alt+j / k, and no ctrl+alt+[ or ]", (True, True, False),
              ("ctrl+alt+h / l" in keys and "pane" in keys, "ctrl+alt+j / k" in keys, "ctrl+alt+[" in keys or "ctrl+alt+]" in keys))

        # the user's arrangement holds: a pane resized and a page put beside another survive a reload of the hub tab,
        # and an agent opening another page
        divider = view.evaluate(f"""(() => {{ const app = document.getElementById("app").getBoundingClientRect();
            const d = [...document.querySelectorAll('[data-trellis-part="divider"][data-split="g:{ORCHESTRATOR}"]')]
              .map((e) => e.getBoundingClientRect()).find((r) => r.height > 100 && r.left > app.left + 50 && r.right < app.right - 50);
            return d && [d.left + d.width / 2, d.top + d.height / 2]; }})()""")
        weights = lambda page=view: page.evaluate(f"(function find(n) {{ return !n ? null : n.id === 'g:{ORCHESTRATOR}' ? n.weights.map((w) => Math.round(w * 1000)) : n.children?.map(find).find(Boolean) ?? null; }})(ws.getDocument().root)")
        dragged_from = weights()
        view.mouse.move(*divider)
        view.mouse.down()
        view.mouse.move(divider[0] - 60, divider[1], steps=8)
        view.mouse.move(divider[0] - 120, divider[1], steps=8)
        view.mouse.up()
        settles("dragging the divider between the two panes resizes them", True,
                lambda: weights()[0] < dragged_from[0] and weights()[1] > dragged_from[1])
        figure = page("show/map-columns/plot.svg", "")  # an image, written as one below
        figure.write_text('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 20"><rect width="40" height="20"/></svg>')
        figure_id = f"{ORCHESTRATOR}~" + api("/api/open", {"target": str(figure), "session": ORCHESTRATOR})["id"]
        settles("an agent's figure lands in the left pane", pane_id("left"),
                lambda: view.evaluate(f"ws.view({json.dumps(figure_id)})?.panelId ?? null"))
        view.evaluate(f"ws.dock({json.dumps(figure_id)}, {{ beside: {json.dumps(diff_panel)}, edge: 'right' }})")
        def beside_diff() -> bool:
            at, cols = view.evaluate(f"ws.view({json.dumps(figure_id)}).panelId"), panes()
            code = next(i for i, c in enumerate(cols) if pane_id("right") in c.split("+"))
            return at != pane_id("left") and at in "+".join(cols[code:code + 2]).split("+")
        settles("a page dragged beside the diff sits beside it", True, beside_diff)
        arranged = panes(), weights()
        written()
        reloaded = context.new_page()
        reloaded.goto(ORIGIN + "/")
        reloaded.wait_for_function(f"window.wc && ws.view({json.dumps(figure_id)})", timeout=30000)
        check("a reloaded hub tab keeps both", arranged, (panes(reloaded), weights(reloaded)))
        reloaded.close()
        late = api("/api/open", {"target": str(page("show/map-columns/late.html", "<h1>late</h1>")), "session": ORCHESTRATOR})
        late_id = f"{ORCHESTRATOR}~{late['id']}"
        settles("a page an agent opens later goes to its pane", pane_id("left"),
                lambda: view.evaluate(f"ws.view({json.dumps(late_id)})?.panelId ?? null"))
        check("...and the arrangement holds", arranged, (panes(), weights()))
        api("/api/open", {"target": str(AGENT / "show/map-columns/late.html"), "session": ORCHESTRATOR, "lane": "output"})
        view.wait_for_timeout(500)
        check("a page an agent puts in another lane of the same pane stays where it is", pane_id("left"),
              view.evaluate(f"ws.view({json.dumps(late_id)})?.panelId ?? null"))
        api("/api/open", {"target": str(AGENT / "show/map-columns/late.html"), "session": ORCHESTRATOR, "lane": "code"})
        settles("...and one an agent puts in the code lane moves to the right pane", pane_id("right"),
                lambda: view.evaluate(f"ws.view({json.dumps(late_id)})?.panelId ?? null"))
        check("...every pane of the unit on screen, the user's third included", sorted(sum((c.split("+") for c in panes()), [])),
              sorted(on_screen()))
        view.evaluate(f"ws.focus({json.dumps(late_id)})")
        view.wait_for_function(holds_keyboard, timeout=10000)
        view.keyboard.press("Control+Alt+w")
        settles("...and once a page goes, the unit is still framed whole", sorted(sum((c.split("+") for c in panes()), [])),
                lambda: sorted(on_screen()))

        # an agent opening a page again reloads it, though never over what the page says it would lose
        def reloaded() -> bool:
            try:
                return frame_of("map-columns").evaluate("window.__mark === undefined")
            except PlaywrightError:  # read mid-reload: the old page is gone and the new one not there yet
                return False
        frame_of("map-columns").evaluate("window.__mark = 1; window.reloadWouldLose = () => true")
        api("/api/open", {"target": str(pages[2]), "session": ORCHESTRATOR})
        view.wait_for_timeout(2500)
        check("a page that would lose what is typed in it is not reloaded under it", False, reloaded())
        frame_of("map-columns").evaluate("window.reloadWouldLose = () => false")
        settles("...and is reloaded once it would lose nothing", True, reloaded)
        api("/api/open", {"target": str(pages[2]), "session": ORCHESTRATOR})
        settles("a page that says nothing is reloaded at once", True, reloaded, within=5)
        frame_of("map-columns").evaluate("window.__mark = 1")
        api("/api/open", {"target": str(pages[2]), "session": ORCHESTRATOR})
        settles("...every time an agent opens it", True, reloaded, within=5)

        # a minimized page opened again by an agent needs the user again
        api("/api/open", {"target": str(pages[1]), "session": ORCHESTRATOR})
        settles("a minimized page an agent opens again comes back into the layout", True, lambda: ids["csv-import"] in docked())

        # hub-layout-pass 4: the next page not opened yet; the board
        focus_session()
        view.keyboard.press("Control+Alt+n")
        focused_path = lambda: view.evaluate("decodeURIComponent(ws.view(ws.getSnapshot().focusedView)?.params.url.replace(/^\\/f/, '') ?? '')")
        sketch = os.path.realpath(AGENT / "show/map-columns/sketch.html")
        settles("ctrl+alt+n goes from the session page to the first page its column lists that is not opened yet", sketch, focused_path)
        settles("...its line marked open", ["open", "●"], lambda: line("/sketch.html"))
        frame_at("/sketch.html")  # the keys go into the page ctrl+alt+n focused
        view.keyboard.press("Control+Alt+n")
        view.wait_for_timeout(300)
        check("...and with every page opened, ctrl+alt+n says so and opens nothing", (sketch, True),
              (focused_path(), "is opened" in view.inner_text("#log")))
        board_placement = lambda: view.evaluate("ws.views().find(v => v.params.kind === 'board')?.placement ?? null")
        view.keyboard.press("Control+Alt+b")
        settles("ctrl+alt+b shows the board, floating over the units", "floating", board_placement)
        board = frame_at("/board.html")  # a key pressed into a page still loading goes nowhere
        check("csv-import is done by now", "done", next(t["status"] for t in hub_view()["tickets"] if t["slug"] == "csv-import"))
        settles("...marking the tickets the unit's session claimed or committed on and not done, and no other", ["map-columns"],
                lambda: board.evaluate("[...document.querySelectorAll('[data-hub-unit]')].map(r => r.dataset.slug)"))
        check("...the first of them scrolled into view", True,
              board.evaluate("(r => r.top >= 0 && r.bottom <= innerHeight)(document.getElementById('t-map-columns').getBoundingClientRect())"))
        view.keyboard.press("Control+Alt+b")
        settles("...and hides it again", None, board_placement)
        api("/api/open", {"target": str(AGENT / "board.html"), "session": ORCHESTRATOR})
        settles("a board an agent hands the hub opens over the hub tab", "floating", board_placement)
        check("...as a page of no unit", False, any(m["kind"] == "board" for m in hub_view()["members"]))
        view.keyboard.press("Control+Alt+b")
        settles("...and ctrl+alt+b hides it", None, board_placement)

        # two orchestrators on one tree: the rail numbers them by when each last finished a turn
        ticket("drop-zone", "claimed", "map-columns")
        git(AGENT, "add", "tickets/drop-zone.md")
        git(AGENT, "commit", "-q", "-m", "claim drop-zone", "-m", f"Session: {SECOND}")
        view.keyboard.press("Control+Alt+0")
        settles("in the overview", None, lambda: view.evaluate("wc.current"))
        registered(SECOND, t0 - 50)
        second = api("/api/open", {"target": str(page("show/drop-zone/index.html", "<h1>drop zone</h1>")), "session": SECOND})
        second_id = f"{SECOND}~{second['id']}"
        check("a second orchestrator's page lands in its own unit", SECOND, second["unit"])
        view.wait_for_function(f"ws.views().some(v => v.id === {json.dumps(second_id)})", timeout=10000)
        api("/api/open", {"target": str(pages[2]), "session": ORCHESTRATOR})
        settles("the rail marks both orchestrators as having something new", 2,
                lambda: view.evaluate("document.querySelectorAll('#units .new').length"))
        # hub-rail-marks-sessions-needing-you#P1: an idle session's mark and status line, from its page's records
        if not READER:
            print("skip: no mx plugin here, whose session page reader the rail reads a page by")
        else:
            (AGENT / f"sessions/{ORCHESTRATOR}/turns").mkdir()
            (AGENT / f"sessions/{ORCHESTRATOR}/turns/01.md").write_text(
                "---\ndate: 2026-10-07\n---\n\n# Two ways to import\n\n## Questions\n\n"
                "- [Q1] **Which way?** A call only the user can make.\n  - (a) this way *my pick*\n  - (b) that way\n")
            rail_row = lambda U: f"[...document.querySelectorAll('#units .unit')].find(b => b.querySelector('button[title=\"session {U}\"]'))"
            marked_row = lambda U: view.evaluate(f"(r => [r.querySelector('.mark').hasAttribute('data-needs'), r.querySelector('.mark').title,"
                                                 f" r.querySelector('.said')?.textContent ?? null])({rail_row(U)})")
            settles("the rail fills the mark of an idle session with an open question, and shows its status line under its title",
                    [True, "needs you: 1 open question, a turn record you have not seen", "Two ways to import"], lambda: marked_row(ORCHESTRATOR))
            check("...and leaves hollow that of one with no records", [False, "idle, nothing on its page waits on you", None], marked_row(SECOND))
            check("...the one that needs you numbered 1, though the other finished a turn since", [ORCHESTRATOR, SECOND],
                  view.evaluate("wc.state.units.filter(u => u.number).map(u => u.unit)"))
            (AGENT / f"sessions/{ORCHESTRATOR}/turns/01.md").unlink()  # the checks below number them by their turns alone
            settles("...and hollow once its page holds nothing for you", False, lambda: marked_row(ORCHESTRATOR)[0])
        view.keyboard.press("Control+Alt+Enter")
        settles("ctrl+alt+enter goes to the orchestrator whose news is oldest", SECOND, lambda: view.evaluate("wc.current"))
        settles("...its stand-in for a session page in the sidebar, while it has rendered none", f"/pages/{SECOND}", sidebar_url)
        settles("...and the keyboard on its page", (second_id, True), lambda: (focused(), view.evaluate(holds_keyboard)))
        view.keyboard.press("Control+Alt+2")
        settles("ctrl+alt+2 goes to the orchestrator that finished a turn before the last", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        view.keyboard.press("Control+Alt+1")
        settles("ctrl+alt+1 to the one that finished a turn last", SECOND, lambda: view.evaluate("wc.current"))
        view.keyboard.press("Control+Alt+j")
        settles("ctrl+alt+j to the next down the rail", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        view.keyboard.press("Control+Alt+k")
        settles("ctrl+alt+k back up to the one before", SECOND, lambda: view.evaluate("wc.current"))

        # the board over one of two orchestrators on one tree marks that one's tickets
        marked = lambda: frame_at("/board.html").evaluate("[...document.querySelectorAll('[data-hub-unit]')].map(r => r.dataset.slug)")
        view.keyboard.press("Control+Alt+b")
        settles("the board over the second orchestrator marks its tickets, not the first's", ["drop-zone"], marked)
        view.keyboard.press("Control+Alt+j")
        settles("...and the marks follow you to the other orchestrator", ["map-columns"], marked)
        view.keyboard.press("Control+Alt+k")
        settles("...and back", ["drop-zone"], marked)
        view.keyboard.press("Control+Alt+b")
        settles("...the board hidden again", None, board_placement)

        # one-hub-tab#P6: a reorder of the rail never changes which session has the user's focus
        rail = lambda: view.evaluate("wc.state.units.filter(u => u.number).map(u => u.unit)")
        view.evaluate(f"ws.focus({json.dumps(second_id)})")
        view.wait_for_function(holds_keyboard, timeout=10000)
        registered(ORCHESTRATOR, time.time())  # the other orchestrator finishes a turn
        settles("an orchestrator finishing a turn becomes 1 on the rail", [ORCHESTRATOR, SECOND], rail)
        view.wait_for_timeout(2500)  # past the hub's next look at the disk, and whatever the tab does on its news
        check("...while the unit you are in stays the one you are in", SECOND, view.evaluate("wc.current"))
        check("...and the page you are on keeps the focus, and the keyboard", (second_id, True), (focused(), view.evaluate(holds_keyboard)))
        check("...the rail's keys naming the new order", ["ctrl+alt+1", "ctrl+alt+2"],
              view.evaluate("[...document.querySelectorAll('#units .cap')].map(e => e.title)"))

        # the ✕: out of the numbers until the session next finishes a turn
        view.locator("#units .unit", has=view.locator(f'button[title="session {SECOND}"]')).locator(".dismiss").click(force=True)
        settles("the ✕ takes an orchestrator out of the numbers", [ORCHESTRATOR], rail)
        check("...to the list of those set aside", True, f"session {SECOND[:8]}" in view.inner_text("#aside-units"))
        check("...and leaves you where you are", (SECOND, True), (view.evaluate("wc.current"), second_id in docked()))
        view.keyboard.press("Control+Alt+j")
        settles("ctrl+alt+j from outside the numbers goes to the first in them", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        settles("...the one set aside leaving the layout with you", False, lambda: second_id in docked())
        registered(SECOND, time.time() + 1)
        settles("its session finishing a turn brings it back, as 1", [SECOND, ORCHESTRATOR], rail)
        view.keyboard.press("Control+Alt+d")
        settles("ctrl+alt+d takes the orchestrator you are in out of the numbers, as its ✕ does", [SECOND], rail)
        check("...and leaves you in it", ORCHESTRATOR, view.evaluate("wc.current"))
        view.keyboard.press("Control+Alt+d")
        settles("...and again, already set aside, says so", True, lambda: "is set aside already" in view.inner_text("#log"))
        check("...changing nothing", [SECOND], rail())
        registered(ORCHESTRATOR, time.time() + 2)
        settles("its session finishing a turn brings it back, as 1", [ORCHESTRATOR, SECOND], rail)
        registered(SECOND, time.time() + 3)
        settles("...the order as it was again", [SECOND, ORCHESTRATOR], rail)

        # the session id on the rail: its first 8 characters, the whole id on hover, copied by a click
        row = lambda U: view.locator("#units .unit", has=view.locator(f'button[title="session {U}"]'))
        meta = lambda U: row(U).locator(".meta").evaluate("m => [m.querySelector('.sid').textContent, m.querySelector('.session').textContent, m.querySelector('.session').title]")
        settles("a rail entry shows its session id's first 8 characters once, the whole id on hover, where its short id is those 8",
                ["", SECOND[:8], SECOND], lambda: meta(SECOND))
        registered(SECOND, time.time() + 3, name="drop-zone-name")
        settles("...and beside a short id that is a name", ["drop-zone-name", SECOND[:8], SECOND], lambda: meta(SECOND))
        registered(SECOND, time.time() + 3)
        row(SECOND).locator(".session").click()
        settles("a click on it copies the whole id", SECOND, lambda: view.evaluate("navigator.clipboard.readText()"))
        check("...and enters no orchestrator", ORCHESTRATOR, view.evaluate("wc.current"))

        # one-hub-tab#P2 for the loose pages. No session page lists them, so a stand-in in the sidebar does.
        loose_note = HOME / "notes" / "loose.html"
        loose_note.parent.mkdir(parents=True, exist_ok=True)
        loose_note.write_text("<!doctype html><h1>a loose note</h1>")
        loose_id = f"loose~{api('/api/open', {'target': str(loose_note)})['id']}"
        view.locator("#aside-units button.nav[title='pages no session opened']").click()
        settles("the loose pages, entered, have a stand-in for a session page in the sidebar", ["loose", "/pages/loose"],
                lambda: [view.evaluate("wc.current"), sidebar_url()])
        stand_in = frame_at("/pages/loose")
        def stand_line():
            try:
                return stand_in.evaluate("""() => { const a = document.querySelector('#artefacts a[data-artefact$="/loose.html"]');
                    return a && a.previousElementSibling?.classList.contains('hub-mark') ? a.dataset.hub ?? "" : null }""")
            except PlaywrightError:
                return None
        settles("...listing the unit's page as the column does, marked open", "open", stand_line)
        view.evaluate(f"ws.focus({json.dumps(loose_id)})")
        view.wait_for_function(holds_keyboard, timeout=10000)
        view.keyboard.press("Control+Alt+w")
        settles("...marked minimized once you minimize it", (False, "minimized"), lambda: (loose_id in docked(), stand_line()))
        stand_in.click('#artefacts a[data-artefact$="/loose.html"]')
        settles("...and a click on its line brings it back", (True, "open"), lambda: (loose_id in docked(), stand_line()))
        loose_note.unlink()
        settles("the unit you are in going away, its one page deleted, puts you in the overview, with no session page",
                (None, True), lambda: (view.evaluate("wc.current"),
                                       view.evaluate("document.getElementById('session-side').getBoundingClientRect().width === 0")))

        # the address of the hub tab at a unit, which the Stop hook's line links
        written()
        api("/api/close", {"unit": ORCHESTRATOR, "id": mids[ORCHESTRATOR]})
        at_unit = context.new_page()
        at_unit.goto(f"{ORIGIN}/u/{ORCHESTRATOR}#{mids['csv-import']}")
        at_unit.wait_for_function("window.wc && ws.views().length > 0", timeout=30000)
        settles("the hub tab opened at a unit and a page is in that unit, on that page", [ORCHESTRATOR, ids["csv-import"]],
                lambda: at_unit.evaluate("[wc.current, ws.getSnapshot().focusedView]"))
        check("...its session page in the sidebar, the list of every other", f"/f{urllib.parse.quote(str(pages[0]))}", sidebar_url(at_unit))
        check("...its address back at the hub's root, so a reload stays where you are then", "/", at_unit.evaluate("location.pathname + location.hash"))
        at_unit.close()
        view.bring_to_front()  # back from the tab, as a person would be before the next key

        # the hub gone: the tab says so with the command that brings it back, and sends what changed meanwhile
        view.keyboard.press("Control+Alt+2")
        settles("in the first orchestrator again", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        focus("map-columns")
        kill_hub()
        settles("a hub tab cut off from the hub says so, with the command that restarts it", " ".join(["setsid", "-f", *HUB_ARGS]),
                lambda: view.evaluate("document.querySelector('#status code')?.textContent ?? null"))
        view.keyboard.press("Control+Alt+w")
        settles("a key still answers while the hub is down", False, lambda: ids["map-columns"] in docked())
        hub = start_hub()
        settles("the hub tab hears the hub is back", True, lambda: view.evaluate("document.getElementById('status').textContent === 'hub: connected'"), within=20)
        settles("...and the hub gets the close made while it was down", True,
                lambda: next(m for m in hub_view()["members"] if m["id"] == mids["map-columns"])["closed"])

        # one-hub-tab#P1: many orchestrators' pages open in one tab, and a page opened then still loads
        many = [f"{n:08x}-0000-4000-8000-{n:012x}" for n in range(0x10, 0x18)]
        for n, session in enumerate(many):
            registered(session, t0 - 300 - n)
            api("/api/open", {"target": str(page(f"show/unit-{n}/index.html", f"<h1>unit {n}</h1>")), "session": session})
        view.keyboard.press("Control+Alt+0")
        settles("ten orchestrators' pages are open in the one tab", 10, lambda: view.evaluate(
            "new Set(ws.views().filter(v => v.placement === 'docked').map(v => v.params.group)).size"), within=30)
        try:
            for n in range(len(many)):
                frame_at(f"/unit-{n}/index.html")
            view.wait_for_timeout(2000)  # whatever connections the tab holds open for its units, it holds by now
            api("/api/open", {"target": str(page("show/unit-0/late.html", "<h1 id=late>late</h1>")), "session": many[0]})
            late = frame_at("/unit-0/late.html").inner_text("#late")
        except (PlaywrightError, RuntimeError) as e:
            late = f"not loaded: {e}"[:200]
        check("...and a page opened then still loads", "late", late)
        check("...as does a read of the hub", True, view.evaluate(
            "Promise.race([fetch('/api/hub').then(r => r.ok), new Promise(r => setTimeout(() => r(false), 10000))])"))

        # a unit whose session page nobody opened: entering it opens that page, the list of its pages
        unopened = page(f"sessions/{many[1]}/index.html", "<h1>unit 1's session</h1>")
        os.utime(unopened, (t0 - 301, t0 - 301))  # its last turn, as registered, so the rail keeps its order
        view.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(many[1])})?.session_page?.url.startsWith('/f/')", timeout=10000)
        view.locator(f'#units button[title="session {many[1]}"]').click()
        settles("entering a unit whose session page nobody opened shows it in the sidebar", f"/f{urllib.parse.quote(str(unopened))}", sidebar_url)

        # the input box under a unit's session page, typing into the session's tmux pane. The session's program stands
        # in for Claude Code: it asks for bracketed paste, and records every byte typed into its pane.
        answering = many[1]
        received, recorder = SCRATCH / "received", SCRATCH / "recorder.py"
        recorder.write_text("import os, sys, tty\ntty.setraw(0)\nos.write(1, b'\\x1b[?2004h')\nout = open(sys.argv[1], 'ab', buffering=0)\n"
                            "while data := os.read(0, 4096):\n    out.write(data)\n")
        tmux = lambda *args: subprocess.run([TMUX, "-S", TMUX_SOCKET, *args], env=ENV, capture_output=True, text=True, check=True).stdout.strip()
        # no config: the user's own would load plugins whose tmux calls name no socket
        tmux("-f", "/dev/null", "new-session", "-d", "-s", "answering", "-x", "100", "-y", "20", f"exec {sys.executable} {recorder} {received}")
        try:
            pane, pane_pid = tmux("display-message", "-p", "-t", "answering:", "#{pane_id} #{pane_pid}").split()
            started = Path(f"/proc/{pane_pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
            in_pane = lambda status="idle", **extra: registered(answering, t0 - 301, status, pid=int(pane_pid), started=started, **extra)
            in_pane(tmux=f"answering:@0.{pane}")
            box = "document.querySelector('#session-box .reply')"
            box_says = lambda: view.evaluate(f"(b => b && [b.dataset.state, b.querySelector('.how').textContent])({box})")
            area_value = lambda: view.evaluate(f"{box}.querySelector('textarea').value")
            arrived = lambda: received.read_bytes() if received.exists() else b""

            def after_reload() -> str:
                """What the box holds in a hub tab opened afresh, as after a reload or a browser restart."""
                fresh = context.new_page()
                fresh.goto(ORIGIN + "/")
                fresh.wait_for_function(f"(() => {{ try {{ return !!{box}.querySelector('textarea'); }} catch {{ return false; }} }})()",
                                       timeout=30000)  # throws until the workspace and the session page are up
                text = fresh.evaluate(f"{box}.querySelector('textarea').value")
                fresh.close()
                return text
            settles("a unit whose session runs in a tmux pane has an input box under its session page, its session idle",
                    ["waiting", "idle · enter types into tmux session answering"], box_says)
            if READER:  # hub-rail-marks-sessions-needing-you D5: it waits on you only where it needs you
                asked = AGENT / f"sessions/{answering}/turns/01.md"
                asked.parent.mkdir()
                asked.write_text("---\ndate: 2026-10-07\n---\n\n# One call\n\n## Questions\n\n"
                                 "- [Q1] **Which way?** A call only the user can make.\n  - (a) this way *my pick*\n  - (b) that way\n")
                settles("...which says it waits on you while its page has an open question",
                        ["waiting", "waiting on you · enter types into tmux session answering"], box_says)
                asked.unlink()  # the rail's order, which a session needing you leads, stays what the checks below expect
                settles("...and idle again once it has none", ["waiting", "idle · enter types into tmux session answering"], box_says)
                number_of = lambda U: view.evaluate(f"wc.state.units.find(u => u.unit === {json.dumps(U)}).number")
                was = number_of(answering)
                asked.write_text("---\ndate: 2026-10-07\n---\n\n# A record, no question\n")
                view.wait_for_timeout(2500)  # past the hub's next look at the disk, and the visit the tab sends on it
                check("a turn record landing in the unit you are in keeps its number, it being seen as it lands",
                      (was, None), (number_of(answering), view.evaluate(f"wc.state.units.find(u => u.unit === {json.dumps(answering)}).needs_you")))
                asked.unlink()

            # hub-ui-nits 2: the statusline's numbers, from what the statusline keeps of each session's last render
            def statusline(session: str, config_dir: Path, **numbers) -> None:
                path = HOME / ".cache/claude-statusline" / f"{session}.json"
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(json.dumps({"session_id": session, "config_dir": str(config_dir), "written_at": time.time(),
                                            "model": {"display_name": "Opus"}, **numbers}))
            t = time.time()
            statusline(answering, HOME / ".claude", context_window={"used_percentage": 42.5, "total_input_tokens": 85000},
                       rate_limits={"five_hour": {"used_percentage": 31, "resets_at": t + 3700},
                                    "seven_day": {"used_percentage": 90, "resets_at": t + 6 * 86400 + 3700}})
            statusline("99999999-0000-4000-8000-00000000000f", HOME / ".claude-work",
                       rate_limits={"five_hour": {"used_percentage": 70, "resets_at": t - 60},
                                    "seven_day": {"used_percentage": 50, "resets_at": None}})
            usage_lines = lambda: view.evaluate("[...document.querySelectorAll('#usage > *')].map(e => [e.textContent, e.dataset.tone ?? ''])")
            settles("the rail's top shows each account's 5h and weekly usage, a bar coloured by pace, the time to its reset", [
                [".claude", ""], ["5h", ""], ["━━────", "ok"], ["31%", ""], ["↻1h", ""], ["week", ""], ["━━━━━╸", "over"], ["90%", ""], ["↻6d", ""],
                [".claude-work", ""], ["5h", ""], ["──────", "ok"], ["0%", ""], ["fresh", ""],
                ["week", ""], ["━━━───", "ok"], ["50%", ""], ["", ""]], usage_lines)  # no reset time: no pace to fall behind
            # hub-layout-pass 6: where each column's text starts (the label, the bar, the reset time) or ends (the
            # percentage, which lines up on its last digit), on every line of every account
            edges = lambda: view.evaluate("""(() => {
                const cells = [...document.querySelectorAll('#usage > :not(.account)')];
                const text = (e) => { const r = document.createRange(); r.selectNodeContents(e); return r.getBoundingClientRect(); };
                const lines = []; for (let i = 0; i < cells.length; i += 4) lines.push(cells.slice(i, i + 4));
                return [0, 1, 2, 3].map((c) => [...new Set(lines.filter((l) => l[c].textContent)
                  .map((l) => Math.round(c === 2 ? text(l[c]).right : text(l[c]).left)))].length); })()""")
            check("the usage block's label, bar, percentage and reset columns line up across every line of every account",
                  [1, 1, 1, 1], edges())

            # hub-layout-pass 5: an account hidden or shown by its name, kept per browser profile
            other_account = many[7]
            (HOME / ".claude/sessions" / f"{other_account[:8]}.json").unlink()
            registered(other_account, t0 - 307, account=".claude-work")
            rail_units = lambda page=view: page.evaluate("[...document.querySelectorAll('#units .nav, #aside-units .nav')].map(b => b.title.replace('session ', ''))")
            settles("an orchestrator under another account is on the rail", True, lambda: other_account in rail_units())
            ended_other = "f7f7f7f7-0000-4000-8000-0000000000f7"  # a session of that account that ended, by its transcript
            (HOME / ".claude-work/projects/-home-repos-alpha").mkdir(parents=True, exist_ok=True)
            (HOME / ".claude-work/projects/-home-repos-alpha" / f"{ended_other}.jsonl").write_text("")
            ended_page = page("notes/ended-other.html", "an ended session's page")
            api("/api/open", {"target": str(ended_page), "session": ended_other})
            settles("...and one of its that ended in the ended list", True,
                    lambda: ended_other in view.evaluate("[...document.querySelectorAll('#aside-units .nav')].map(b => b.title.replace('session ', ''))"))
            numbers_before = view.evaluate("wc.state.units.filter(u => u.number).length")
            work_name = lambda page=view: page.locator('#usage button.account:text-is(".claude-work")')
            check("an account's name is its toggle, and says it can be clicked: a pointer, an underline under it", ("pointer", "underline"),
                  (work_name().evaluate("e => getComputedStyle(e).cursor"),
                   (work_name().hover(), work_name().evaluate("e => getComputedStyle(e).textDecorationLine"))[1]))
            work_name().click()
            settles("a click on its name takes its orchestrators off the rail, the ended one off the ended list", (False, False),
                    lambda: (other_account in rail_units(), ended_other in rail_units()))
            view.mouse.move(800, 900)  # off the name, which underlines under the pointer
            name_looks = lambda page=view: work_name(page).evaluate(
                "e => [getComputedStyle(e).textDecorationLine, getComputedStyle(e).opacity < 1, e.getAttribute('aria-pressed')]")
            settles("...its name struck through and dimmed", ["line-through", True, "false"], name_looks)
            check("...as are both its usage lines, every cell after its name", [8, True], work_name().evaluate("""e => {
                const cells = []; for (let c = e.nextElementSibling; c && !c.classList.contains('account'); c = c.nextElementSibling) cells.push(c);
                return [cells.length, cells.every((c) => getComputedStyle(c).opacity < 1)]; }"""))
            check("...out of the numbers", (numbers_before - 1, False), (view.evaluate("wc.state.units.filter(u => u.number).length"),
                  view.evaluate(f"wc.state.units.some(u => u.unit === {json.dumps(other_account)})")))
            check("...and out of the layout, the overview's too", False, view.evaluate(
                f"ws.views().some(v => v.params.group === {json.dumps(other_account)})"))
            view.keyboard.press("Control+Alt+f")
            view.keyboard.type(other_account[:8])
            settles("...and out of the search", "no orchestrator matches",
                    lambda: view.evaluate("document.querySelector('#units .found-none')?.textContent ?? null"))
            view.keyboard.press("Escape")
            check("...the others staying", True, answering in rail_units())
            reopened = context.new_page()
            reopened.goto(ORIGIN + "/")
            reopened.wait_for_function("window.wc && document.querySelectorAll('#units .nav').length > 0", timeout=30000)
            check("the account stays hidden in the same browser profile", (False, ["line-through", True, "false"]),
                  (other_account in rail_units(reopened), name_looks(reopened)))
            reopened.close()
            view.bring_to_front()  # back from the other tab, whose frames the hub tab's waited on meanwhile
            elsewhere_profile = browser.new_context(viewport={"width": 1600, "height": 950})
            profile_tab = elsewhere_profile.new_page()
            profile_tab.goto(ORIGIN + "/")
            profile_tab.wait_for_function("window.wc && document.querySelectorAll('#units .nav').length > 0", timeout=30000)
            check("...and another profile keeps its own choice", True, other_account in rail_units(profile_tab))
            elsewhere_profile.close()
            view.bring_to_front()
            later = api("/api/open", {"target": str(page("show/unit-7/later.html", "<h1>later</h1>")), "session": other_account})
            view.wait_for_timeout(1000)
            check("a page an agent of a hidden account opens goes to its unit, nothing of it to this tab, and the hub, "
                  "heard by this tab, has claude-browser open no browser tab for it", (True, False, None),
                  (any(m["url"].endswith("/later.html") for m in api(f"/api/u/{other_account}")["members"]),
                   view.evaluate("ws.views().some(v => v.params.url.endsWith('/later.html'))"), later["open"]))
            board_before = view.evaluate("ws.views().some(v => v.params.kind === 'board')")
            api("/api/open", {"target": str(AGENT / "board.html"), "session": other_account})
            view.wait_for_timeout(1000)
            check("...nor does a board it hands the hub open over this tab", (False, False),
                  (board_before, view.evaluate("ws.views().some(v => v.params.kind === 'board')")))
            work_name().focus()
            view.keyboard.press("Enter")
            settles("Enter on its name, which has the keyboard, brings it back, the name no longer struck through", (True, "none"),
                    lambda: (other_account in rail_units(), work_name().evaluate("e => getComputedStyle(e).textDecorationLine")))
            view.keyboard.press("Space")
            settles("...Space hides it again", False, lambda: other_account in rail_units())
            view.keyboard.press("Space")  # shown again for what follows
            view.wait_for_function(f"wc.state.units.some(u => u.unit === {json.dumps(other_account)})", timeout=10000)
            ended_page.unlink()  # its unit goes with its one page, and the ended list is as the search below has it
            view.locator(f'#units button[title="session {answering}"]').click()
            settles("back in the unit that answers", answering, lambda: view.evaluate("wc.current"))
            context_line = lambda key: view.evaluate(
                f"(e => e && [e.textContent, e.querySelector('.bar').dataset.tone])(document.querySelector('#units button[title=\"session {key}\"] .ctx'))")
            check("a running session's rail entry shows its context use", ["ctx ━━╸─── 42% · 85k", "ok"], context_line(answering))
            check("...and one with no statusline file shows none", True, view.evaluate(
                f"(b => !!b && !b.querySelector('.ctx'))(document.querySelector('#units button[title=\"session {many[0]}\"]'))"))
            check("the token that lets the tab type is out of its document before any page is framed", None,
                  view.evaluate("document.querySelector('meta[name=\"hub-token\"]')"))
            view.keyboard.press("Control+Alt+s")
            settles("ctrl+alt+s folds the session page's sidebar away", [True, 0],
                    lambda: view.evaluate("(s => [s.classList.contains('folded'), s.getBoundingClientRect().width])(document.getElementById('session-side'))"))
            view.keyboard.press("Control+Alt+r")
            settles("ctrl+alt+r unfolds it, and puts the keyboard in the box", [False, True], lambda: view.evaluate(
                f"[document.getElementById('session-side').classList.contains('folded'), document.activeElement === {box}.querySelector('textarea')]"))
            box_zoom = lambda: view.evaluate("[localStorage.getItem('wc:side:session:zoom'), getComputedStyle(document.getElementById('session-box')).zoom]")
            view.keyboard.press("Control+Alt+Equal")
            settles("ctrl+alt++ in the box zooms the session sidebar", ["1.1", "1.1"], box_zoom)
            view.keyboard.press("Control+Alt+Shift+Digit3")  # # on a US layout
            settles("...and ctrl+alt+# puts it back", [None, "1"], box_zoom)
            view.keyboard.type("go on")
            view.keyboard.press("Shift+Enter")
            view.keyboard.type("but leave the tests")
            check("shift+enter is a new line in the box, sending nothing", ("go on\nbut leave the tests", b""), (area_value(), arrived()))
            check("the box's unsent text survives a reload", "go on\nbut leave the tests", after_reload())
            view.evaluate(f"{box}.querySelector('textarea').dispatchEvent(new KeyboardEvent('keydown', {{ key: 'Enter', bubbles: true, cancelable: true }}))")
            view.wait_for_timeout(500)
            check("an Enter a page made up sends nothing", ("go on\nbut leave the tests", b""), (area_value(), arrived()))
            view.keyboard.press("Enter")
            settles("enter types the box's text into the session's pane, a paste and then Enter",
                    b"\x1b[200~go on\rbut leave the tests\x1b[201~\r", arrived)
            settles("...and empties the box", "", area_value)
            check("...which a reload finds empty", "", after_reload())
            view.keyboard.press("Control+z")
            check("...which ctrl+z undoes, the browser's own editing having emptied it", "go on\nbut leave the tests", area_value())
            view.keyboard.press("Control+a")
            view.keyboard.type("then ")
            check("select-all selects the box's text", "then ", area_value())
            check("...and a reload finds what was typed last", "then ", after_reload())

            # a file pasted, and one dropped: each saved by the hub, its path typed where the cursor is
            view.evaluate(f"""(() => {{
                const area = {box}.querySelector('textarea'), dt = new DataTransfer();
                dt.items.add(new File([new Uint8Array([137, 80, 78, 71])], 'image.png', {{ type: 'image/png' }}));
                area.dispatchEvent(new ClipboardEvent('paste', {{ clipboardData: dt, bubbles: true, cancelable: true }}));
            }})()""")
            drops = HOME / ".cache/container-hub/drops" / answering
            pasted = lambda: re.fullmatch(rf"then ({re.escape(str(drops))}/\S+-image\.png)", area_value())
            settles("a pasted screenshot goes in as its path, at the cursor", True, lambda: bool(pasted()))
            check("...the file saved there with what was pasted", b"\x89PNG", Path(pasted()[1]).read_bytes() if pasted() else None)
            view.evaluate(f"""(() => {{
                const area = {box}.querySelector('textarea'), dt = new DataTransfer();
                area.setSelectionRange(5, 5);
                dt.items.add(new File(['notes'], 'my notes.txt', {{ type: 'text/plain' }}));
                area.dispatchEvent(new DragEvent('drop', {{ dataTransfer: dt, bubbles: true, cancelable: true }}));
            }})()""")
            settles("a dropped file goes in as its path at the cursor, set apart from the words around it", True,
                    lambda: bool(re.fullmatch(rf"then {re.escape(str(drops))}/\S+-my-notes\.txt {re.escape(str(drops))}/\S+-image\.png", area_value())))

            received.write_bytes(b"")
            in_pane("waiting", tmux=f"answering:@0.{pane}", waitingFor="permission prompt")
            settles("a session blocked in its terminal: the box says so, on what, and where to go", [
                "blocked", "blocked in its terminal (permission prompt). Answer it in tmux session answering; nothing is sent from here meanwhile."],
                box_says)
            view.evaluate(f"{box}.querySelector('textarea').focus()")
            view.keyboard.press("Enter")
            view.wait_for_timeout(500)
            check("...and sends it nothing, keeping the text", (b"", True), (arrived(), area_value().startswith("then ")))
            in_pane()
            settles("a session with no tmux pane in the registry: no box, and the unit says why",
                    ["none", "No input box. The session runs in no tmux pane, so the hub has nowhere to type; answer it in its terminal."],
                    box_says)
            check("...the box's text area hidden", False, view.evaluate(f"{box}.querySelector('textarea').checkVisibility()"))

            # hub-continues-a-session-from-its-handoff: the box offers to write, update or hand off from the session's handoff
            if READER:
                handoff = AGENT / "handoffs" / "2026-10-07-unit-1.md"
                handoff_url = "/f" + urllib.parse.quote(str(handoff.resolve()))
                offer = f"{box}.querySelector('.handoff')"
                offers = lambda: view.evaluate(f"(o => o.checkVisibility() ? [o.textContent, o.querySelector('a')?.getAttribute('href') ?? null] : null)({offer})")
                ready = lambda: view.evaluate(f"document.querySelector('#units button[title=\"session {answering}\"] .mark')?.hasAttribute('data-handoff') ?? null")
                seen = []  # every offer the box made, none of which may say "continue"

                def commit_handoff(at: int, text: str) -> None:
                    """The session writes its handoff and commits it at `at`, as the committer date has it."""
                    handoff.parent.mkdir(exist_ok=True)
                    handoff.write_text(f"---\nsession: {answering}\npurpose: continuation\n---\n\n{text}")
                    git(AGENT, "add", "handoffs")
                    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", "commit", "-q", "-m", "handoff"],
                                   cwd=AGENT, env={**HUB_ENV, "GIT_COMMITTER_DATE": f"@{at} +0000"}, check=True, capture_output=True)

                in_pane(tmux=f"answering:@0.{pane}", cwd=str(CODE))
                settles("hub-continues-a-session-from-its-handoff#P1: the box of a session idle in its pane, with no handoff, offers to write one",
                        ["no handoff yetwrite handoff", None], offers)
                seen.append(offers()[0])
                received.write_bytes(b"")
                view.locator("#session-box .reply .handoff button").click()
                settles("hub-continues-a-session-from-its-handoff#P7: a click types one request for the handoff skill into the pane, and says "
                        "to read what it writes", [True, True], lambda: [arrived().startswith(b"\x1b[200~/mx:handoff ") and arrived().count(b"\r") == 1,
                                                                         "read it before you hand off" in view.evaluate(f"{box}.querySelector('.how').textContent")])
                h0 = int(time.time())
                commit_handoff(h0, "# Unit 1, handed on\n")
                settles("hub-continues-a-session-from-its-handoff#P1: once the session committed it, the box offers to hand off from it, "
                        "with a link to it", [f"handoff {handoff.name}hand off", handoff_url], offers)
                seen.append(offers()[0])
                settles("hub-continues-a-session-from-its-handoff#P8: the rail marks the session ready to hand off", True, ready)
                # two rings, this session and the one that takes over: the mark, and a second ring of its size overlapping it on its
                # right, in its colour
                rings = lambda: view.evaluate(f"""(m => {{ const s = getComputedStyle(m), a = getComputedStyle(m, '::after');
                    return [s.width, s.borderTopWidth, s.borderTopColor, s.backgroundColor, a.width, a.top, a.left, a.borderTopWidth, a.borderTopColor,
                            a.borderTopColor === s.borderTopColor, m.title.endsWith('ready to hand off')]; }})
                    (document.querySelector('#units button[title="session {answering}"] .mark'))""")
                hollow = rings()
                px = lambda v: float(v.removesuffix("px"))
                check("...as two hollow rings, the second as large, overlapping the first on its right, no lower, in the idle mark's colour "
                      "and border, its tooltip saying so", [True] * 5,
                      [hollow[4] == hollow[0], 0 < px(hollow[1]) + px(hollow[6]) < px(hollow[0]), px(hollow[1]) + px(hollow[5]) <= 0,
                       hollow[9] and hollow[7] == hollow[1], hollow[10]])
                question = AGENT / f"sessions/{answering}/turns/02.md"
                question.parent.mkdir(parents=True, exist_ok=True)
                question.write_text("---\ndate: 2026-10-08\n---\n\n# One call\n\n## Questions\n\n"
                                    "- [Q1] **Which way?** A call only the user can make.\n  - (a) this way *my pick*\n  - (b) that way\n")
                settles("...and where it needs you, the filled dot with a ring of its colour overlapping it", [True, True, True],
                        lambda: (lambda r: [r[3] not in ("rgba(0, 0, 0, 0)", "transparent"), r[3] == r[2] == r[8], r[3] != hollow[2]])(rings()))
                question.unlink()
                transcript = HOME / ".claude/projects/-alpha" / f"{answering}.jsonl"
                transcript.parent.mkdir(parents=True, exist_ok=True)
                transcript.write_text(json.dumps({"type": "user", "message": {"role": "user", "content": "keep going"}, "origin": {"kind": "human"},
                                                  "promptSource": "typed", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(h0 + 5))},
                                                 separators=(",", ":")) + "\n")
                settles("hub-continues-a-session-from-its-handoff#P6: a prompt sent after it makes it stale: the box offers to update it",
                        [f"handoff written before your last message: {handoff.name}update handoff", handoff_url], offers)
                seen.append(offers()[0])
                settles("...and the rail no longer marks the session ready", False, ready)
                commit_handoff(h0 + 10, "# Unit 1, handed on, updated\n")
                settles("...until the session commits it again", f"handoff {handoff.name}hand off", lambda: (offers() or [None])[0])
                check("the box never says continue", [], [s for s in seen if "continu" in s.lower()])
                view.locator("#session-box .reply .handoff a").click()
                settles("...and its link opens the handoff in the unit, to be read before the click", True,
                        lambda: view.evaluate(f"ws.views().some(v => v.params.url === {json.dumps(handoff_url)} && v.params.group === {json.dumps(answering)})"))

                def cleared_into(session: str, status: str = "idle", **extra) -> None:
                    """Click the control, and once its /clear reaches the pane, do what Claude Code does: name the session
                    it started in the registry file of the same process."""
                    received.write_bytes(b"")
                    view.locator("#session-box .reply .handoff button").click()
                    deadline = time.monotonic() + 10
                    while b"/clear" not in arrived() and time.monotonic() < deadline:
                        time.sleep(0.05)
                    registered(session, t0 - 301, status, pid=int(pane_pid), started=started, tmux=f"answering:@0.{pane}", cwd=str(CODE), **extra)
                    (HOME / ".claude/sessions" / f"{answering[:8]}.json").unlink()

                stalled = f"{0x21:08x}-0000-4000-8000-{0x21:012x}"
                cleared_into(stalled, "waiting", waitingFor="permission prompt")
                settles("hub-continues-a-session-from-its-handoff#P3: a refusal after the /clear started a session takes the tab to that "
                        "session's unit, its box saying why", [stalled, True],
                        lambda: [view.evaluate("wc.current"), view.evaluate(f"{box}?.querySelector('.how').textContent ?? ''")
                                 .startswith("not handed off:") and "permission prompt" in view.evaluate(f"{box}.querySelector('.how').textContent")],
                        within=20)
                check("...having typed the /clear alone", b"\x1b[200~/clear\x1b[201~\r", arrived())
                (HOME / ".claude/sessions" / f"{stalled[:8]}.json").unlink()
                in_pane(tmux=f"answering:@0.{pane}", cwd=str(CODE))
                # the stalled session ended, its unit with it, and the one it came from runs again
                view.wait_for_function(f"!wc.state.units.some(u => u.unit === {json.dumps(stalled)}) && "
                                       f"wc.state.units.find(u => u.unit === {json.dumps(answering)})?.state === 'idle'", timeout=20000)
                view.locator(f'#units button[title="session {answering}"] .name').click()  # its middle may be the id, which copies
                settles("back in the session the refusal left", [answering, True],
                        lambda: [view.evaluate("wc.current"), view.evaluate(f"{offer}?.checkVisibility() ?? false")])
                handed_to = f"{0x20:08x}-0000-4000-8000-{0x20:012x}"
                cleared_into(handed_to)
                settles("hub-continues-a-session-from-its-handoff#P4: a click takes the tab to the new session's unit, its stand-in in the sidebar "
                        "and its input box live", [handed_to, f"/pages/{handed_to}", "waiting", True],
                        lambda: [view.evaluate("wc.current"), sidebar_url(), view.evaluate(f"{box}?.dataset.state"),
                                 view.evaluate(f"document.activeElement === {box}?.querySelector('textarea')")], within=20)
                check("...having typed /clear, then `continue`", b"\x1b[200~/clear\x1b[201~\r\x1b[200~continue\x1b[201~\r", arrived())
                (HOME / ".claude/sessions" / f"{handed_to[:8]}.json").unlink()  # the session ends, and its unit with it
                in_pane()

            view.locator(f'#units button[title="session {answering}"] .name').click()  # its middle may be the id, which copies
            settles("back in the unit whose session runs in no tmux pane", [answering, "none"], lambda: [view.evaluate("wc.current"), box_says()[0]])
            acts = lambda: view.evaluate(f"(a => a.checkVisibility() ? [...a.querySelectorAll('button')].map(b => b.textContent) : null)({box}.querySelector('.acts'))")
            check("...and no jump or close over it", None, acts())

            # jump and close over the box. The session runs in a second pane too, and a bystander session keeps the
            # tmux server up once both are closed.
            tmux("new-session", "-d", "-s", "bystander", "sleep 600")
            tmux("new-window", "-d", "-t", "answering:", "sleep 600")
            second, second_pid = tmux("display-message", "-p", "-t", "answering:1", "#{pane_id} #{pane_pid}").split()
            all_panes = lambda: sorted(tmux("list-panes", "-a", "-F", "#{pane_id}").split())
            before = all_panes()
            in_pane(tmux=f"answering:@0.{pane}")
            settles("a unit whose session runs in a tmux pane has jump and close over its box", ["jump to panectrl+alt+g", "close panectrl+alt+x"], acts)
            second_started = Path(f"/proc/{second_pid}/stat").read_text().rsplit(")", 1)[1].split()[19]

            def both(status: str = "idle") -> None:
                """The unit's state is read from either of its session's processes, so both change together."""
                in_pane(status, tmux=f"answering:@0.{pane}")
                registered(answering, t0 - 301, status, pid=int(second_pid), started=second_started, file="second", tmux=f"answering:@1.{second}")

            both()
            settles("...and says how many panes where it runs in more than one", ["jump to pane · 2 panesctrl+alt+g", "close 2 panesctrl+alt+x"], acts)
            act = lambda n: view.locator(f"#session-box .reply .acts button >> nth={n}").click()
            how = lambda: view.evaluate(f"{box}.querySelector('.how').textContent")

            act(0)
            settles("a jump with no tmux client attached goes nowhere, the unit saying why", "not gone to: no tmux client is attached to go to it in", how)
            both("busy")
            view.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(answering)}).state === 'busy'", timeout=10000)
            act(1)
            settles("a close of a session at work is refused at once, the unit saying why, nothing to confirm",
                    ["not closed: the session is at work; close it once it is idle", "close 2 panesctrl+alt+x"], lambda: [how(), acts()[1]])
            check("...and kills no pane", before, all_panes())
            both()
            view.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(answering)}).state === 'idle'", timeout=10000)
            act(1)
            check("a first click on close asks to be confirmed, in place", "close all 2 panes, shell and all? again to confirm", acts()[1].removesuffix("ctrl+alt+x"))
            view.wait_for_timeout(500)
            check("...and kills nothing", before, all_panes())
            settles("...until it lapses, a few seconds on", "close 2 panesctrl+alt+x", lambda: acts()[1], within=8)
            view.keyboard.press("Control+Alt+x")
            view.wait_for_timeout(500)
            check("ctrl+alt+x asks the same", (True, before), (acts()[1].startswith("close all 2 panes"), all_panes()))
            view.keyboard.press("Control+Alt+x")
            settles("...and confirmed by a second, every pane the session runs in is closed, and no other",
                    sorted(set(before) - {pane, second}), all_panes)
            settles("...after which its unit is an ended one, with nothing over its box", ("ended", None),
                    lambda: (view.evaluate(f"wc.state.units.find(u => u.unit === {json.dumps(answering)}).state"), acts()))
        finally:
            subprocess.run([TMUX, "-S", TMUX_SOCKET, "kill-server"], env=ENV, capture_output=True, check=False)
        check("no tmux call, the hub's or the test's, went to a server other than the test's own", "",
              TMUX_REFUSED.read_text() if TMUX_REFUSED.exists() else "")

        # pages on another origin: framed in the left pane where they allow it, listed and opened as a tab on a click
        # where they refuse
        app = f"http://127.0.0.1:{elsewhere.server_address[1]}"
        view.locator(f'#units button[title="session {ORCHESTRATOR}"]').click()
        settles("in the first orchestrator once more", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        framed_at = lambda url: view.evaluate(f"ws.views().find(v => v.params.url === {json.dumps(url)})?.panelId ?? null")
        api("/api/open", {"target": f"{app}/deny", "session": ORCHESTRATOR})
        settles("a page an agent opens that refuses framing is listed at the column's end, marked as one that opens as a tab",
                ["tab", "↗"], lambda: line(f"{app}/deny"))
        check("...and is in no panel", None, framed_at(f"{app}/deny"))
        with context.expect_page(timeout=30000) as tab:
            view.keyboard.press("Control+Alt+Shift+W")
        check("...until ctrl+alt+shift+w opens it as a browser tab, it being the page minimized last", f"{app}/deny", tab.value.url)
        tab.value.close()
        view.bring_to_front()  # back from the tab the key opened, as a person would be before the next key
        tabs = len(context.pages)
        view.keyboard.press("Control+Alt+Shift+W")
        settles("...and the key again brings back the page minimized before it, in its pane, and no second tab", (True, tabs),
                lambda: (ids["map-columns"] in docked(), len(context.pages)))
        with context.expect_page(timeout=30000) as tab:
            frame_of(ORCHESTRATOR).click(line_link("/deny"))
        check("...as does a click on its line", f"{app}/deny", tab.value.url)
        tab.value.close()
        view.bring_to_front()
        api("/api/open", {"target": f"{app}/app", "session": ORCHESTRATOR})
        settles("a local server that allows framing opens in the left pane of the opening session's unit", pane_id("left"),
                lambda: framed_at(f"{app}/app"))
        settles("...showing the page", True, lambda: any(f.url == f"{app}/app" for f in view.frames))

        def clicked(href: str) -> None:
            """A link in the session page, clicked as a person would."""
            focus_session()
            frame_of(ORCHESTRATOR).evaluate(
                "href => { const a = Object.assign(document.createElement('a'), { id: 'added', href, textContent: 'added' });"
                " document.getElementById('added')?.remove(); document.body.prepend(a); }", href)
            frame_of(ORCHESTRATOR).click("#added")

        with context.expect_page(timeout=30000) as tab:
            clicked(f"{app}/self")
        check("a plain click on a link to a page that refuses framing opens a browser tab", f"{app}/self", tab.value.url)
        tab.value.close()
        check("...and no panel", None, framed_at(f"{app}/self"))
        clicked(f"{app}/app2")
        settles("a plain click on a link to one that allows it opens it in the unit's left pane", pane_id("left"),
                lambda: framed_at(f"{app}/app2"))

        # a link clicked before its page has loaded, the page's image still on its way, and one in a page framed inside it
        page("show/map-columns/inner.html", f'<a id="nested" href="{app}/self">self</a>')
        early = page("show/map-columns/early.html", f'<a id="early" href="{app}/deny">deny</a>'
                     f'<iframe src="inner.html"></iframe><img src="{app}/slow">')
        view.evaluate(f"ws.focus({json.dumps(ORCHESTRATOR + '~' + api('/api/open', {'target': str(early), 'session': ORCHESTRATOR})['id'])})")
        deadline = time.monotonic() + 30
        while not (outer := next((f for f in view.frames if f.url.endswith("/early.html")), None)):
            if time.monotonic() > deadline:
                raise RuntimeError("no frame shows /early.html")
            view.wait_for_timeout(50)
        outer.wait_for_selector("#early")
        if not (inner := next((f for f in outer.child_frames if f.url.endswith("/inner.html")), None)):
            raise RuntimeError("no frame inside /early.html shows /inner.html")
        inner.wait_for_selector("#nested")

        def tab_on(frame, selector: str) -> str | None:
            """The address of the browser tab a click on the link opens, None for no tab."""
            try:
                with context.expect_page(timeout=10000) as tab:
                    frame.click(selector)
                url = tab.value.url
                tab.value.close()
                return url
            except PlaywrightTimeout:
                return None

        check("the page has not loaded", "interactive", outer.evaluate("document.readyState"))
        check("...and what the hub put in the page leaves it in standards mode", "CSS1Compat", outer.evaluate("document.compatMode"))
        check("a link in a page framed inside it, clicked, opens the page that refuses framing as a browser tab",
              f"{app}/self", tab_on(inner, "#nested"))
        check("a link clicked before its page has loaded opens a page that refuses framing as a browser tab", f"{app}/deny",
              tab_on(outer, "#early"))
        check("...and the pane still shows the page", True, outer.url.endswith("/early.html"))
        HELD.set()
        elsewhere.shutdown()
        focus_session()  # out of the page on another origin, which the hub tab's keys do not reach

        # --- hub-session-search: finding an orchestrator by its session id, its short id or its title, the ended ones
        # folded under "N more" included. Ended sessions, more than the ended list shows, each titled by the title
        # Claude Code keeps in its transcript, as 2.1.289 writes it; the last of them, which sorts last among the
        # ended, is folded. Two titles share hbrd for hub-layout-pass 7, the one fzf ranks first later on the rail.
        ended = [f"e{i}e{i}e{i}e{i}-0000-4000-8000-00000000001{i}" for i in range(7)]
        titles = [*(f"Chore number {i}" for i in range(4)), "Hash bread", "Hub redesign", "Instagram saves pass 1"]
        for i, (sid, title) in enumerate(zip(ended, titles)):
            transcript = HOME / ".claude" / "projects" / "-home-repos-alpha" / f"{sid}.jsonl"
            transcript.parent.mkdir(parents=True, exist_ok=True)
            transcript.write_text("".join(json.dumps({"type": "ai-title", "aiTitle": t, "sessionId": sid}, separators=(",", ":")) + "\n"
                                          for t in ("Chore", title)))
            api("/api/open", {"target": str(page(f"notes/ended-{i}.html", "an ended session's page")), "session": sid})
        registered(ORCHESTRATOR, time.time(), name="alpha-d2")
        rail_names = lambda: view.evaluate("[...document.querySelectorAll('#units .name, #aside-units .name')].map(e => e.textContent)")
        settles("an ended session with no session page is titled on the rail by Claude Code's own title for it",
                True, lambda: "Chore number 0" in rail_names())
        settles("...the orchestrator searched for below folded under the ended list's \"N more\"",
                (False, True), lambda: ("Instagram saves pass 1" in rail_names(),
                                        view.locator("#aside-units .more").text_content().endswith("more")))
        found = lambda: view.evaluate("[...document.querySelectorAll('#units .name')].map(e => e.textContent)")

        def search(query: str, expected: list[str], what: str, sort: bool = False) -> None:
            view.keyboard.press("Control+Alt+f")
            view.keyboard.type(query)
            settles(what, expected, lambda: sorted(found()) if sort else found())

        search(ended[6][:6], ["Instagram saves pass 1"], "ctrl+alt+f and a prefix of a session id finds that orchestrator alone, folded as it is")
        check("...from a search box ctrl+alt+f put the keyboard in", "search", view.evaluate("document.activeElement.id"))
        view.keyboard.press("Enter")
        settles("...and enter goes to it, as a click on the rail would", (ended[6], ""),
                lambda: (view.evaluate("wc.current"), view.evaluate("document.getElementById('search').value")))
        frame_at("/ended-6.html")  # its page, which has the keyboard once it loads
        view.wait_for_function(holds_keyboard, timeout=10000)
        search(ended[6], ["Instagram saves pass 1"], "a whole session id finds it too")
        view.keyboard.press("Escape")
        settles("...and escape clears the search, the rail back as it was", ("", True),
                lambda: (view.evaluate("document.getElementById('search').value"), "Chore number 0" in rail_names()))
        search("SAVES insta", ["Instagram saves pass 1"], "words of a title, in any order and either case, find its orchestrator")
        view.keyboard.press("Escape")
        # hub-layout-pass 7, the ranking as fzf 0.74.4 --filter hbrd ranks these units' lines (title, short id, session id)
        search("hbrd", ["Hub redesign", "Hash bread"], "a query's characters in order with gaps find a title, ranked as fzf ranks "
               "them: Hub redesign first, though longer and later on the rail")
        view.keyboard.press("Escape")
        search("HbRd", ["Hub redesign", "Hash bread"], "...whatever their case")
        view.keyboard.press("Escape")
        search("hub rd", ["Hub redesign"], "...and a space splits the query into terms that must all match")
        view.keyboard.press("Escape")
        search("chore number", [f"Chore number {i}" for i in range(4)], "...every orchestrator whose title holds them", sort=True)
        third = found()[2]
        view.keyboard.press("ArrowDown")
        view.keyboard.press("ArrowDown")
        view.keyboard.press("Enter")
        title_here = lambda: view.evaluate("wc.state.units.find(u => u.unit === wc.current)?.title")
        settles("...and the arrows pick the one enter goes to", third, title_here)
        view.wait_for_function(f"{holds_keyboard} && document.activeElement.contentDocument?.readyState === 'complete'", timeout=10000)
        orchestrator = view.evaluate(f"wc.state.units.find(u => u.unit === {json.dumps(ORCHESTRATOR)}).title")
        search("alpha-d2", [orchestrator], "a short id from the registry finds its orchestrator")
        view.keyboard.press("Enter")
        settles("...and enter goes to it", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        search("nothing-is-called-this", [], "a query nothing matches finds nothing")
        check("...and says so", "no orchestrator matches", view.locator("#units .found-none").text_content())
        view.keyboard.press("Escape")
        focus_session()
        view.keyboard.press("Control+Alt+f")
        view.keyboard.press("Escape")
        settles("escape gives the keyboard back to the page that had it before ctrl+alt+f", True,
                lambda: view.evaluate(holds_session))
        units = api("/api/hub")["units"]
        prefixed = [u["title"] for u in units if u["session"] and u["session"].startswith("0000001")]
        inside = [u["title"] for u in units if u["session"] and "0000001" in u["session"] and u["title"] not in prefixed]
        view.keyboard.press("Control+Alt+f")
        view.keyboard.type("0000001")
        settles("a session id the query starts is found before one it is only inside of", (sorted(prefixed), True),
                lambda: (sorted(found()[:len(prefixed)]), set(inside) <= set(found()[len(prefixed):])))
        view.keyboard.press("Escape")

        # hub-follows-links-between-session-pages: a handoff's links, as the mx renderer writes them at a session page's
        # top, to the session after it (one the hub has no unit of) and back to the one before it (one it has)
        handoff = lambda word, sid: f'<p class="v-meta handoffs" id="handoffs">{word} <a href="../{sid}/index.html">{sid[:8]}</a></p>'
        AFTER = "9a9a9a9a-0000-4000-8000-000000000099"
        page(f"sessions/{AFTER}/index.html", handoff("continues", ORCHESTRATOR) + "<h1>the session after</h1>")
        settles("(back in the orchestrator)", ORCHESTRATOR, lambda: view.evaluate("wc.current"))
        frame_of(ORCHESTRATOR).evaluate("html => document.body.insertAdjacentHTML('afterbegin', html)", handoff("continued in", AFTER))
        frame_of(ORCHESTRATOR).click("#handoffs a")
        settles("a click on a link to another session's page goes to that session's unit, made one though the hub had none",
                (AFTER, True), lambda: (view.evaluate("wc.current"), (sidebar_url() or "").endswith(f"/sessions/{AFTER}/index.html")))
        frame_of(AFTER).click("#handoffs a")
        settles("...and its link back goes back to the unit before it", ORCHESTRATOR, lambda: view.evaluate("wc.current"))

        check("no script errors", [], errors)
        check("closing or reloading the hub tab asks nothing", False,
              view.evaluate("(e => (dispatchEvent(e), e.defaultPrevented))(new Event('beforeunload', { cancelable: true }))"))
        browser.close()
finally:
    HELD.set()
    if hub:
        os.killpg(hub.pid, signal.SIGKILL)  # `uv run` leads the group; the server is its child
        hub.wait()
    shutil.rmtree(SCRATCH, ignore_errors=True)

print()
print("FAILED" if failures else "all ok")
sys.exit(1 if failures else 0)
