#!/usr/bin/env bash
# tier: fast
# Run the Makefile's `make test` over a scratch repo of stub test files and check what it makes of each: a pass, a
# skip, a skip of some cases, a failure, a full-path file it leaves alone, and a file that names no tier.

set -uo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
needs make git

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp "$(dirname "${BASH_SOURCE[0]}")/../Makefile" "$work/"
git -C "$work" init --quiet

stub() {  # name tier body
    printf '#!/usr/bin/env bash\n# tier: %s\n%s\n' "$2" "$3" >"$work/$1.test"
    chmod +x "$work/$1.test"
}
stub passes fast 'echo "skip one case: this host has none of it"'
stub skips fast 'echo "skip: nothing here to check"; exit 77'
stub fails fast 'exit 1'
stub drives full-path 'echo driven'

# This file may itself run under make, whose flags would reach the make below.
run() { env -u MAKEFLAGS -u MFLAGS -u MAKELEVEL make -C "$work" --no-print-directory test JOBS=1 2>&1; }

out=$(run); rc=$?
check "a failure fails the run" 2 "$rc"
check "the run ends naming each skip, each partial skip and each failure" \
    "skipped:
  skips.test: nothing here to check

skipped in part:
  passes.test: skip one case: this host has none of it

failed:
  fails.test" "$(sed -n '/^skipped:/,$p' <<<"$out" | grep -v '^make')"
check "a full-path file is not run" "" "$(grep 'drives' <<<"$out")"

printf '#!/usr/bin/env bash\nexit 0\n' >"$work/untiered.test"
chmod +x "$work/untiered.test"
out=$(run)
check "a file that names no tier stops the run, named" 1 "$(grep -c 'these files name no tier: untiered.test' <<<"$out")"
check "...before any file runs" "" "$(grep '^== ' <<<"$out")"

finish
