#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro", "wa-crypt-tools"]
# ///
"""Drive how bin/whatsapp-chat reads a decrypted WhatsApp database. Run it directly; no framework.

The promises here: a person is called by their address-book name whichever way the number
was saved, else by the name they set in WhatsApp, else by their full number, and never by
the masked number WhatsApp shows for strangers when the full one is known, and names.json, which
lifelog's view reads in place of this script, calls everyone that too; a chat is found
by id or by name, an exact name winning over a partial one, and a name matching several
chats exits 2; a chat prints oldest first, cut to the newest messages or to a start time,
without system notices, with replies and media named.

The database is a fixture built here with only the columns the script reads, in the
shape of a 2.26 backup. Copying from the phone and decrypting are not covered: the mirror's
checks stand a copy of the fixture in for what decrypting gives, and an answer for the phone.
"""

import io
import json
import os
import shutil
import sqlite3
import sys
import tempfile
from contextlib import redirect_stderr, redirect_stdout
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from check import bin_module, check, finish  # noqa: E402

wc = bin_module("whatsapp-chat")

SCHEMA = """
create table jid (_id integer primary key, user text, server text, raw_string text);
create table jid_map (lid_row_id integer primary key, jid_row_id integer);
create table lid_display_name (lid_row_id integer primary key, display_name text);
create table chat (_id integer primary key, jid_row_id integer, subject text);
create table message (_id integer primary key, chat_row_id integer, from_me integer, sender_jid_row_id integer,
                      timestamp integer, message_type integer, text_data text, sort_id integer);
create table message_media (message_row_id integer primary key, raw_transcription_text text);
create table message_quoted (message_row_id integer primary key, from_me integer, sender_jid_row_id integer,
                             message_type integer, text_data text);
"""


def ms(stamp: str) -> int:
    return int(datetime.fromisoformat(stamp).timestamp() * 1000)


def fixture() -> sqlite3.Connection:
    db = sqlite3.connect(":memory:")
    db.executescript(SCHEMA)
    db.executemany(
        "insert into jid values (?, ?, ?, ?)",
        [
            (1, "436601111111", "s.whatsapp.net", "436601111111@s.whatsapp.net"),  # Anna: in the address book
            (2, "436602222222", "s.whatsapp.net", "436602222222@s.whatsapp.net"),  # Ben: a WhatsApp name only, reached through his lid
            (3, "436603333333", "s.whatsapp.net", "436603333333@s.whatsapp.net"),  # Cleo: masked name, number known
            (11, "900000000000002", "lid", "900000000000002@lid"),
            (12, "900000000000003", "lid", "900000000000003@lid"),
            (13, "900000000000004", "lid", "900000000000004@lid"),  # Dan: lid only, masked name
            (20, "120363000000000001", "g.us", "120363000000000001@g.us"),
            (21, "120363000000000002", "g.us", "120363000000000002@g.us"),
        ],
    )
    db.executemany("insert into jid_map values (?, ?)", [(11, 2), (12, 3)])
    db.executemany(
        "insert into lid_display_name values (?, ?)",
        [(11, "Ben B"), (12, "+43∙∙∙∙∙∙∙∙33"), (13, "+49∙∙∙∙∙∙∙∙44")],
    )
    db.executemany(
        "insert into chat values (?, ?, ?)",
        [(100, 1, None), (101, 2, None), (102, 20, "Hikers"), (103, 21, "Hikers Vienna"), (104, 3, None)],
    )
    messages = [
        # Anna's DM
        (1, 100, 0, None, ms("2026-10-01T09:00"), 0, "first line\nsecond line", 1),
        (2, 100, 1, None, ms("2026-10-02T09:00"), 0, "hi back", 2),
        (3, 100, 0, None, ms("2026-10-03T09:00"), 1, "a caption", 3),
        (4, 100, 0, None, ms("2026-10-04T09:00"), 2, None, 4),
        (5, 100, 0, None, ms("2026-10-05T09:00"), 99, None, 5),
        # the group
        (10, 102, 0, None, ms("2026-10-01T10:00"), 7, None, 10),
        (11, 102, 0, 11, ms("2026-10-01T10:01"), 0, "from ben", 11),
        (12, 102, 0, 13, ms("2026-10-01T10:02"), 0, "from dan", 12),
        (13, 102, 1, None, ms("2026-10-01T10:03"), 0, "agreed", 13),
        (14, 103, 0, 12, ms("2026-09-01T10:00"), 0, "other group", 14),
        (15, 101, 0, None, ms("2026-08-01T10:00"), 0, "ben's dm", 15),
        (16, 104, 0, None, ms("2026-07-01T10:00"), 0, "cleo's dm", 16),
    ]
    db.executemany("insert into message values (?, ?, ?, ?, ?, ?, ?, ?)", messages)
    db.execute("insert into message_media values (4, 'what was said')")
    db.execute("insert into message_quoted values (13, 0, 11, 0, 'from ben, quoted')")
    return db


def run(fn, *args) -> tuple[str, str, int | None]:
    out, err = io.StringIO(), io.StringIO()
    code = None
    with redirect_stdout(out), redirect_stderr(err):
        try:
            fn(*args)
        except SystemExit as e:
            code = e.code if isinstance(e.code, int) else 1
    return out.getvalue(), err.getvalue(), code


db = fixture()
book = {wc.number(n): name for n, name in [("+43 660 1111111", "Anna")]}
names = wc.Names(db, book)

# --- names
check("an address-book number with a + reads as written", "436601111111", wc.number("+43 660 1111111"))
check("an address-book number with 00 drops it", "436601111111", wc.number("0043 660 1111111"))
check("an address-book number with a leading 0 gets the home country code", "436601111111", wc.number("0660/1111111"))
check("a person in the address book has that name", "Anna", names(1))
check("a person with only a WhatsApp name has it, reached through the lid map", "Ben B", names(2))
check("the same person addressed by lid has the same name", "Ben B", names(11))
check("a masked WhatsApp name loses to the full number", "+436603333333", names(12))
check("a lid with no number keeps its masked name", "+49∙∙∙∙∙∙∙∙44", names(13))
check("a group is its subject", "Hikers", names(20))

# --- names.json, the names lifelog reads
side = json.loads(wc.names_file(db, names))
check("names.json calls every jid what whatsapp-chat calls it",
      {"436601111111@s.whatsapp.net": "Anna", "436602222222@s.whatsapp.net": "Ben B",
       "436603333333@s.whatsapp.net": "+436603333333",
       "900000000000002@lid": "Ben B", "900000000000003@lid": "+436603333333", "900000000000004@lid": "+49∙∙∙∙∙∙∙∙44",
       "120363000000000001@g.us": "Hikers", "120363000000000002@g.us": "Hikers Vienna"},
      {n["jid"]: n["name"] for n in side["names"]})
check("and names the message types, the system notices' type and the kinds of chat",
      ("text", "image", "audio", 7, "group"),
      (*({k["type"]: k["kind"] for k in side["kinds"]}[t] for t in (0, 1, 2)), side["system"],
       {c["server"]: c["kind"] for c in side["chat_kinds"]}["g.us"]))
check("the same database and address book give the same names.json", wc.names_file(db, names), wc.names_file(db, names))

# --- the address book, as termux-contact-list answers
entries = [{"name": "Anna", "number": "+43 660 1111111"}]
check("a list of contacts is the address book", entries, wc.address_book(json.dumps(entries)))
refused = '{"error": "Please grant the following permission: android.permission.READ_CONTACTS"}'
answer = {}
_, err, _ = run(lambda: answer.setdefault("book", wc.address_book(refused)))
check("a refused permission is no address book", None, answer["book"])
check("and says why", True, "READ_CONTACTS" in err)
check("no Termux:API on the phone is no address book", None, wc.address_book("termux-contact-list: command not found"))

# --- picking a chat
every = wc.chats(db, names)
check("chats run most recent first, empty of system notices",
      [(100, 5), (102, 3), (103, 1), (101, 1), (104, 1)], [(c.id, c.messages) for c in every])
check("a chat is found by its id", 104, wc.pick_chat(db, names, "104").id)
check("an exact name wins over a partial match", 102, wc.pick_chat(db, names, "hikers").id)
check("part of a name finds the one chat holding it", 103, wc.pick_chat(db, names, "vienna").id)
_, err, code = run(wc.pick_chat, db, names, "e")
check("a name matching several chats exits 2", 2, code)
check("and lists them", True, "Hikers Vienna" in err and "Ben B" in err)
_, _, code = run(wc.pick_chat, db, names, "nobody")
check("a name matching nothing exits 1", 1, code)

# --- printing a chat
anna = wc.pick_chat(db, names, "anna")
out, _, _ = run(wc.print_chat, db, names, anna, 0, None)
check(
    "a chat prints oldest first, its media named, a voice note by what was said",
    [
        "[2026-10-01 09:00] Anna: first line",
        "    second line",
        "[2026-10-02 09:00] me: hi back",
        "[2026-10-03 09:00] Anna: [image] a caption",
        "[2026-10-04 09:00] Anna: [audio] what was said",
        "[2026-10-05 09:00] Anna: [type 99]",
    ],
    out.splitlines(),
)
out, _, _ = run(wc.print_chat, db, names, anna, 2, None)
check("--last keeps the newest messages", ["[2026-10-04 09:00]", "[2026-10-05 09:00]"], [line[:18] for line in out.splitlines()])
out, _, _ = run(wc.print_chat, db, names, anna, 0, datetime.fromisoformat("2026-10-03T09:00"))
check("--since keeps what was sent from then on", 3, len(out.splitlines()))
out, _, _ = run(wc.print_chat, db, names, wc.pick_chat(db, names, "102"), 0, None)
check(
    "a group names each sender and the one replied to, without system notices",
    [
        "[2026-10-01 10:01] Ben B: from ben",
        "[2026-10-01 10:02] +49∙∙∙∙∙∙∙∙44: from dan",
        '[2026-10-01 10:03] me (replying to Ben B: "from ben, quoted"): agreed',
    ],
    out.splitlines(),
)

# --- --since
check("an age counts back from now", True, abs((datetime.now() - wc.since("2h")).total_seconds() - 7200) < 5)
check("a date is its midnight", datetime(2026, 10, 1), wc.since("2026-10-01"))
_, err, code = run(wc.since, "yesterday")
check("anything else is refused", 1, code)

# --- the mirror
# A copy of the fixture stands in for a decrypted backup, and the phone's answer is set per run.
scratch = Path(tempfile.mkdtemp())
wc.CACHE, wc.MIRROR = scratch / "cache", scratch / "data/whatsapp"
wc.CACHE.mkdir()
(wc.CACHE / "contacts.json").write_text(json.dumps([{"name": "Anna", "number": "+43 660 1111111"}]))
calls = scratch / "run-log.calls"
wc.RUN_LOG = scratch / "run-log"
wc.RUN_LOG.write_text(f'#!/usr/bin/env bash\necho "$*" >> {calls}\n')
wc.RUN_LOG.chmod(0o755)
decrypted = []


def decrypt(backup: Path, plain: Path, stamp: int) -> None:
    decrypted.append(backup)
    db.commit()  # the backup API waits forever on the fixture's own open transaction
    out = sqlite3.connect(scratch / "plain.db")
    db.backup(out)
    out.close()
    wc.replace(plain, (scratch / "plain.db").read_bytes(), stamp)


def mirror_run(phone: str | None) -> tuple[str, int | None]:
    """One `mirror --record` run, the phone answering where phone is None, else away for that reason: what it logged."""
    wc.decrypt, wc.pull = decrypt, lambda: phone
    calls.unlink(missing_ok=True)
    _, _, code = run(wc.mirror, True)
    return calls.read_text().strip() if calls.exists() else "", code


logged, _ = mirror_run("ssh: connect to host phone port 8022: Connection timed out")
check("a phone that does not answer, with no backup cached, is a skip saying why, and mirrors nothing",
      ("whatsapp-mirror skip --reason phone not reached, no backup cached: ssh: connect to host phone port 8022: "
       "Connection timed out", False), (logged, wc.MIRROR.exists()))

backup = wc.CACHE / wc.BACKUP
backup.write_bytes(b"encrypted")
os.utime(backup, ns=(1_790_000_000_123_456_789,) * 2)
logged, _ = mirror_run(None)
stats = json.loads(logged.split("--stats ", 1)[1])
plain, named = wc.MIRROR / "msgstore.db", wc.MIRROR / "names.json"
check("a backup the mirror lacks is decrypted, and names.json written beside it: ok",
      ("whatsapp-mirror ok", True, True, 1), (logged.split(" --")[0], stats["decrypted"], stats["names_written"], len(decrypted)))
check("the mirror's database carries the backup's mtime, to the nanosecond", backup.stat().st_mtime_ns, plain.stat().st_mtime_ns)
check("names.json is what whatsapp-chat names the fixture by", wc.names_file(db, names), named.read_text())
before = [(f.stat().st_ino, f.stat().st_mtime_ns) for f in (plain, named)]
logged, _ = mirror_run(None)
stats = json.loads(logged.split("--stats ", 1)[1])
check("a run with no newer backup decrypts nothing and rewrites nothing",
      (False, False, 1, before), (stats["decrypted"], stats["names_written"], len(decrypted),
                                  [(f.stat().st_ino, f.stat().st_mtime_ns) for f in (plain, named)]))
logged, _ = mirror_run("ssh: connect to host phone port 8022: No route to host")
check("a phone that does not answer, with a backup cached, is a skip", "whatsapp-mirror skip --reason phone not reached: "
      "ssh: connect to host phone port 8022: No route to host", logged)
os.utime(backup, ns=(1_790_000_100_000_000_000,) * 2)
logged, _ = mirror_run(None)
check("a newer backup is decrypted again", (True, 2, 1_790_000_100_000_000_000),
      (json.loads(logged.split("--stats ", 1)[1])["decrypted"], len(decrypted), plain.stat().st_mtime_ns))
wc.decrypt = lambda *_: sys.exit("whatsapp-chat: could not decrypt the backup key: no identity matched")
os.utime(backup, ns=(1_790_000_200_000_000_000,) * 2)
calls.unlink(missing_ok=True)
wc.pull = lambda: None
_, _, code = run(wc.mirror, True)
check("a backup that cannot be decrypted is a fail saying why, and exits non-zero",
      ("whatsapp-mirror fail --reason whatsapp-chat: could not decrypt the backup key: no identity matched", 1),
      (calls.read_text().strip(), code))
shutil.rmtree(scratch)

finish()
