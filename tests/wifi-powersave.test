#!/usr/bin/env bash
# tier: fast
# Drive `bin/wifi-powersave` against a fake sysfs tree and a fake iw. Run it directly; no framework.
#
# The decisions under test: the power source picks the setting, only wireless
# interfaces get it, and of NetworkManager's events only an interface coming up
# sets it.
#
# No Wi-Fi chip, udev or NetworkManager is involved, so whether the rule fires
# on a real plug and whether the dispatcher runs the copy goes untested here;
# `wifi-powersave status` after pulling the plug on the laptop shows it.

set -uo pipefail

script="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/wifi-powersave"
root=$(mktemp -d)
trap 'rm -rf "$root"' EXIT

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"

# A laptop: a mains supply, a battery, a USB-C port that is no mains supply, one
# wireless interface and one wired.
fresh_tree() { # online
    rm -rf "${root:?}/power" "${root:?}/net" "${root:?}/calls"
    mkdir -p "$root/power/AC0" "$root/power/BAT0" "$root/power/ucsi-source-psy-USBC000:001" \
             "$root/net/wlan0/wireless" "$root/net/eth0"
    echo Mains > "$root/power/AC0/type"
    echo "$1" > "$root/power/AC0/online"
    echo Battery > "$root/power/BAT0/type"
    echo USB > "$root/power/ucsi-source-psy-USBC000:001/type"
    echo 1 > "$root/power/ucsi-source-psy-USBC000:001/online"
    : > "$root/calls"
}

cat > "$root/iw" <<EOF
#!/bin/sh
echo "\$*" >> "$root/calls"
EOF
chmod +x "$root/iw"

run() {
    WIFI_POWERSAVE_POWER="$root/power" WIFI_POWERSAVE_NET="$root/net" WIFI_POWERSAVE_IW="$root/iw" "$script" "$@"
}

fresh_tree 1
run apply
check "on AC, power saving goes off, on the wireless interface only" \
    "dev wlan0 set power_save off" "$(cat "$root/calls")"

fresh_tree 0
run apply
check "on battery, power saving goes on, whatever a USB-C port reports" \
    "dev wlan0 set power_save on" "$(cat "$root/calls")"

fresh_tree 1
NM_DISPATCHER_ACTION=up run wlan0 up
check "NetworkManager reporting an interface up sets it" \
    "dev wlan0 set power_save off" "$(cat "$root/calls")"

fresh_tree 1
NM_DISPATCHER_ACTION=down run wlan0 down
status=$?
check "any other NetworkManager event sets nothing and succeeds" "0:" "$status:$(cat "$root/calls")"

finish
