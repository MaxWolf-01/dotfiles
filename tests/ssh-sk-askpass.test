#!/usr/bin/env bash
# tier: fast
# Run nix/home/ssh-sk-askpass.sh the way ssh-agent does, against a stand-in for the YubiKey agent's socket and for
# the ssh client forwarding it, all in a scratch directory and on loopback. Run it directly; no framework.
#
# What max relies on: while a key waits for a touch there is a waiting prompt in prompt-waits/, of kind touch,
# naming the host whose session asked; and it goes as soon as the wait ends, whether ssh-agent ends it or dies.

set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$repo/tests/check.sh"
needs python3 jq ss
askpass="$repo/nix/home/ssh-sk-askpass.sh"
scratch=$(mktemp -d)
pids=()
trap 'kill "${pids[@]}" 2>/dev/null; rm -rf "$scratch"' EXIT

export XDG_RUNTIME_DIR="$scratch/run" SSH_SK_AGENT_SOCK="$scratch/agent" SSH_SK_HOSTS="$scratch/hosts"
mkdir -p "$XDG_RUNTIME_DIR"
message='Confirm user presence for key ED25519-SK SHA256:4bQbKz6dGq0dD3yS3lVq3m8L8b0YkqzWQe1h1fZr1nE'

# The agent's socket and the host's sshd, both listening, the sshd on an address of its own so that only the
# connection's far end names the host; and the ssh client, connected to both, as `ssh pc` is
# while it forwards the agent. Each prints a line once it is listening or connected.
python3 -c '
import os, socket, sys, time
agent = socket.socket(socket.AF_UNIX); agent.bind(sys.argv[1]); agent.listen()
sshd = socket.socket(); sshd.bind(("127.0.0.2", 0)); sshd.listen()
print(sshd.getsockname()[1], flush=True)
conns = [agent.accept(), sshd.accept()]
time.sleep(600)' "$SSH_SK_AGENT_SOCK" >"$scratch/port" &
pids+=($!)
timeout 5 bash -c "until [ -s '$scratch/port' ]; do sleep 0.05; done" || { fail "the stand-in agent listens"; finish; }
port=$(cat "$scratch/port")
printf '100.97.152.25 xmg19\n127.0.0.2 pc\n' >"$SSH_SK_HOSTS"
python3 -c '
import socket, sys, time
a = socket.socket(socket.AF_UNIX); a.connect(sys.argv[1])
t = socket.create_connection(("127.0.0.2", int(sys.argv[2])))
print("connected", flush=True)
time.sleep(600)' "$SSH_SK_AGENT_SOCK" "$port" >"$scratch/client" &
pids+=($!)
timeout 5 bash -c "until [ -s '$scratch/client' ]; do sleep 0.05; done" || { fail "the stand-in ssh client connects"; finish; }

waiting() {
    timeout 5 bash -c "until ls '$XDG_RUNTIME_DIR'/prompt-waits/*.json >/dev/null 2>&1; do sleep 0.05; done"
}
gone() {
    timeout 5 bash -c "while ls -A '$XDG_RUNTIME_DIR/prompt-waits' 2>/dev/null | grep -q .; do sleep 0.05; done"
}

SSH_ASKPASS_PROMPT=none bash "$askpass" "$message" &
asking=$!
pids+=($asking)
if waiting; then
    prompt=$(cat "$XDG_RUNTIME_DIR"/prompt-waits/*.json)
    check "the waiting prompt is a touch" touch "$(jq -r .kind <<<"$prompt")"
    check "it is named by its id" "$(jq -r .id <<<"$prompt").json" "$(basename "$XDG_RUNTIME_DIR"/prompt-waits/*.json)"
    check "it names the host whose session asked" "ssh pc" "$(jq -r .command <<<"$prompt")"
    check "it carries ssh-agent's message" yes \
        "$(jq -r .prompt <<<"$prompt" | grep -qF "$message" && echo yes)"
    check "it lies in no tmux pane" null "$(jq -c .pane <<<"$prompt")"
    check "its since is a UTC time" yes "$(jq -r .since <<<"$prompt" | grep -qxE '[0-9-]{10}T[0-9:]{8}Z' && echo yes)"
else
    fail "a waiting prompt appears while the key waits for a touch"
fi
kill -TERM "$asking"
gone && passed "ssh-agent's SIGTERM removes the waiting prompt" || fail "ssh-agent's SIGTERM removes the waiting prompt"
wait "$asking"
check "the askpass exits 0 on SIGTERM" 0 "$?"

# No ssh client on the socket: the host is not known, and the prompt still shows.
kill "${pids[1]}"
wait "${pids[1]}" 2>/dev/null
SSH_ASKPASS_PROMPT=none bash "$askpass" "$message" &
asking=$!
pids+=($asking)
if waiting; then
    check "with no ssh client connected the host is unknown" "ssh an unknown host" \
        "$(jq -r .command "$XDG_RUNTIME_DIR"/prompt-waits/*.json)"
else
    fail "a waiting prompt appears with no ssh client connected"
fi
kill -TERM "$asking"
gone || fail "the prompt with no ssh client goes on SIGTERM"

# ssh-agent going without a word (SIGKILL) ends the wait too.
bash -c 'SSH_ASKPASS_PROMPT=none bash "$1" "$2" & wait' _ "$askpass" "$message" &
agent=$!
pids+=($agent)
if waiting; then
    kill -KILL "$agent"
    wait "$agent" 2>/dev/null
    gone && passed "the prompt goes when ssh-agent dies" || fail "the prompt goes when ssh-agent dies"
else
    fail "a waiting prompt appears under a parent that dies"
fi

finish
