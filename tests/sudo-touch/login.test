#!/usr/bin/env bash
# tier: fast
# Drive the zsh login snippet pc and xmg19 run (nix/nixos/sudo-touch-login.zsh) against a scratch home with stand-in
# agent sockets. Run it directly; no framework.
#
# What max relies on: in a login from the laptop, git and ssh use the host's own agent, and sudo finds the forwarded
# YubiKey agent at ~/.ssh/sk-agent.sock, the latest login's; a login with no forwarded agent changes nothing.

set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
. "$repo/tests/check.sh"
needs zsh python3
snippet="$repo/nix/nixos/sudo-touch-login.zsh"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

home="$scratch/home"
run="$scratch/run"
mkdir -p "$home/.ssh/agent" "$run"
socket() { python3 -c 'import socket, sys; socket.socket(socket.AF_UNIX).bind(sys.argv[1])' "$1"; }
first="$home/.ssh/agent/s.AAAA.sshd.100.BBBB"
second="$home/.ssh/agent/s.CCCC.sshd.200.DDDD"
socket "$first"
socket "$second"
socket "$run/ssh-agent"

# A login: the snippet sourced as /etc/zshenv sources it, printing where SSH_AUTH_SOCK ends up.
login() { # <SSH_AUTH_SOCK>
    HOME="$home" XDG_RUNTIME_DIR="$run" SSH_AUTH_SOCK="$1" zsh -f -c '. "$1"; print -r -- "$SSH_AUTH_SOCK"' _ "$snippet"
}

check "a login from the laptop points SSH_AUTH_SOCK at the host's own agent" "$run/ssh-agent" "$(login "$first")"
check "and links the forwarded agent where sudo reads it" "$first" "$(readlink "$home/.ssh/sk-agent.sock")"

login "$second" >/dev/null
check "a later login repoints the link, so a tmux from an earlier one finds the live agent" "$second" \
    "$(readlink "$home/.ssh/sk-agent.sock")"

check "a login without a forwarded agent keeps its SSH_AUTH_SOCK" "$run/ssh-agent" "$(login "$run/ssh-agent")"
check "and leaves the link alone" "$second" "$(readlink "$home/.ssh/sk-agent.sock")"

check "a forwarded path whose socket is gone changes nothing" "$home/.ssh/agent/s.EEEE.sshd.300.FFFF" \
    "$(login "$home/.ssh/agent/s.EEEE.sshd.300.FFFF")"

rm "$run/ssh-agent"
check "with no own agent to go back to, SSH_AUTH_SOCK stays on the forwarded one" "$first" "$(login "$first")"

finish
