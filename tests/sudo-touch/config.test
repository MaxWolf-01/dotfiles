#!/usr/bin/env bash
# tier: full-path (nix)
# Evaluate the flake's real host configs and check what sudo by a YubiKey touch puts in them. Run it directly; no
# framework.
#
# What max relies on: on pc and xmg19 the touch comes before the password and never replaces it, and the keys it
# takes are only the YubiKeys' sk keys, in a file root owns; from the laptop, the YubiKey agent is forwarded to pc
# and xmg19 and no agent to anywhere else; and pc's and xmg19's own ssh config forwards nothing.

set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
. "$repo/tests/check.sh"
needs nix jq ssh
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

nix eval --json --impure --expr "
let
  f = builtins.getFlake \"git+file://$repo\";
  server = host: let c = f.nixosConfigurations.\${host}.config; in {
    sudo = c.security.pam.services.sudo.text;
    keys = c.environment.etc.\"ssh/sudo-touch/max\";
    sshConfig = c.home-manager.users.max.home.file.\".ssh/config\".source;
    blocks = builtins.attrNames c.home-manager.users.max.programs.ssh.settings;
  };
  laptop = f.homeConfigurations.zephyrus.config;
in {
  pc = server \"pc\";
  xmg19 = server \"xmg19\";
  laptop = {
    sshConfig = laptop.home.file.\".ssh/config\".source;
    blocks = builtins.attrNames laptop.programs.ssh.settings;
    unit = laptop.systemd.user.services.ssh-sk-agent.Service.ExecStart;
  };
}" >"$scratch/eval.json" 2>"$scratch/err" || { fail "the flake's host configs evaluate" "$(tail -20 "$scratch/err")"; finish; }

for host in pc xmg19; do
    sudo=$(jq -r ".$host.sudo" "$scratch/eval.json" | grep '^auth ')
    rssh=$(grep -n 'libpam_rssh\.so' <<<"$sudo" | cut -d: -f1)
    unix=$(grep -n 'pam_unix\.so' <<<"$sudo" | cut -d: -f1)
    check "$host: sudo asks for a touch once" 1 "$(wc -l <<<"$rssh")"
    check "$host: the touch is sufficient, so the password stays" sufficient "$(grep libpam_rssh <<<"$sudo" | cut -d' ' -f2)"
    check "$host: the touch comes before the password" yes "$([ "${rssh:-0}" -gt 0 ] && [ "$rssh" -lt "${unix:-0}" ] && echo yes)"
    keyfile=$(grep -o 'auth_key_file=[^ ]*' <<<"$sudo" | cut -d= -f2)
    check "$host: the keys are read from the file NixOS writes for the user who ran sudo" '/etc/ssh/sudo-touch/$ruser' "$keyfile"
    check "$host: that file is a link into the store, which root owns" symlink "$(jq -r ".$host.keys.mode" "$scratch/eval.json")"
    source=$(jq -r ".$host.keys.source" "$scratch/eval.json")
    check "$host: it holds the YubiKeys' sk keys and nothing else" "" \
        "$(grep -vE '^(#|$|sk-ssh-ed25519@openssh\.com )' "$source")"
done

# Every block name the config holds, each alias of a block on its own, and a host it does not know.
forwarding() {
    local config="$1" blocks="$2" name
    for name in $(jq -r '.[]' <<<"$blocks" | tr ' ' '\n' | grep -vx '\*') somewhere.example; do
        echo "$name $(ssh -G -F "$config" "$name" 2>/dev/null | awk '$1 == "forwardagent" { print $2 }')"
    done | LC_ALL=C sort
}

laptop=$(forwarding "$(jq -r .laptop.sshConfig "$scratch/eval.json")" "$(jq -c .laptop.blocks "$scratch/eval.json")")
agent="/run/user/$(id -u)/ssh-sk-agent"
check "from the laptop, only pc and xmg19 are forwarded an agent, and only the YubiKey agent" \
    "$(printf '%s\n' "pc $agent" "xmg $agent" "xmg19 $agent")" "$(grep -v ' no$' <<<"$laptop")"
check "the agent forwarded is the one the unit listens on" yes \
    "$(jq -r ".laptop.unit[]" "$scratch/eval.json" | grep -qE ' -a %t/ssh-sk-agent$' && echo yes)"
for host in pc xmg19; do
    check "$host's own ssh config forwards no agent" "" \
        "$(forwarding "$(jq -r ".$host.sshConfig" "$scratch/eval.json")" "$(jq -c ".$host.blocks" "$scratch/eval.json")" | grep -v ' no$')"
done

finish
