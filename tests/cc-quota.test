#!/usr/bin/env bash
# tier: fast
# Drive bin/cc-quota against a fake home and a fake usage endpoint, and check what it prints. Run it directly; no framework.
#
# The contract under test: every profile with a login gets its section, an expired token is named rather than sent,
# every bucket the reply fills in is listed whatever its name, and a reset time a fraction of a second before the
# minute reads as that minute, each row with a bar and how far off its reset is. Every with-secrets entry holding an
# organization key is a Console org, whose spend since the grant's day the cost report gives, never a balance it
# cannot read. --json is the same report as one line of JSON. A profile with no login, as on a setup-token, is read from
# the newest statusline reading of its config dir that carries rate_limits, and so is one whose login expired or was
# refused.

set -uo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
needs jq curl

cc_quota="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/cc-quota"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

login() { # login <dir> <expiresAt ms>
	mkdir -p "$work/home/$1"
	echo "{\"claudeAiOauth\":{\"accessToken\":\"t\",\"expiresAt\":$2,\"subscriptionType\":\"max\"}}" >"$work/home/$1/.credentials.json"
}
future=$((($(date +%s) + 3600) * 1000))
login .claude "$future"
login .claude-work "$future"
login .claude-old 1
mkdir -p "$work/home/.claude-nologin"
# curl reads a file:// URL, so every profile gets this one reply.
mkdir -p "$work/api/api/oauth"
cat >"$work/api/api/oauth/usage" <<'EOF'
{"five_hour":{"utilization":30.4,"resets_at":"2026-10-14T22:59:59.854121+00:00","remaining_dollars":null},
 "seven_day":{"utilization":99.0,"resets_at":"2026-10-16T05:00:00.237130+00:00","remaining_dollars":null},
 "seven_day_opus":null,
 "new_bucket":{"utilization":0.0,"resets_at":"2026-11-05T07:59:00+00:00","limit_dollars":250,"remaining_dollars":250.0},
 "extra_usage":{"is_enabled":false,"utilization":null}}
EOF

mkdir -p "$work/api/v1/organizations"
echo '{"id":"o","type":"organization","name":"X"}' >"$work/api/v1/organizations/me"
# 4000 cents over three days, two charges on the last.
cat >"$work/api/v1/organizations/cost_report" <<'EOF'
{"data":[{"starting_at":"2026-10-10T00:00:00Z","results":[{"currency":"USD","amount":"1234.5"}]},
 {"starting_at":"2026-10-11T00:00:00Z","results":[]},
 {"starting_at":"2026-10-12T00:00:00Z","results":[{"currency":"USD","amount":"765.5"},{"currency":"USD","amount":"2000"}]}],
 "has_more":false,"next_page":null}
EOF

# The clock stands at Wed 14 Oct 20:00 UTC, three hours before the 5-hour bucket resets.
now=$(date -d 2026-10-14T20:00:00Z +%s)
quota() { HOME=$work/home CC_QUOTA_API=file://$work/api CC_QUOTA_NOW=$now TZ=UTC "$cc_quota" "$@"; }

out=$(CC_QUOTA_ORG_KEY= quota)
check "one section per profile with a login, ~/.claude as default" \
	"default max|old token expired; open claude in this profile to renew it|work max" \
	"$(grep -v '^ ' <<<"$out" | sort | paste -sd'|')"
check "every filled bucket is a row with its bar, rounded to the minute, and how far off it is" \
	"  5-hour        ██████░░░░░░░░░░░░░░  30%  resets Wed 23:00, in 3h 0m
  week          ███████████████████░  99%  resets Fri 05:00, in 1d 9h
  new_bucket    ░░░░░░░░░░░░░░░░░░░░   0%  \$250.00 of \$250 left, expires Thu 05 Nov, in 21d 11h" \
	"$(sed -n '/^default/,/^[^ ]/{/^ /p}' <<<"$out")"
check "with the organization key set empty, no Console org is listed" "" "$(grep '^console' <<<"$out")"

check "a cycle that started earlier sums the cost report's cents since the grant's day" \
	"console X key
  API credits   \$40.00 spent since Sat 10 Oct, through yesterday" \
	"$(CC_QUOTA_ORG_KEY=k quota | sed -n '/^console/,$p')"
check "a cycle that starts today has no whole day to count yet" \
	"  API credits   \$0.00 spent since Wed 14 Oct, through yesterday" \
	"$(CC_QUOTA_ORG_KEY=k CC_QUOTA_GRANT_DAY=14 quota | sed -n '/API credits/p')"

# with-secrets as cc-quota meets it: one entry holding an organization key and its grant day, one that holds none.
mkdir -p "$work/bin"
cat >"$work/bin/with-secrets" <<'EOF'
#!/usr/bin/env bash
case $1 in
--list) printf '%-24s %s\n' org-a "ORGANIZATION_API_KEY CC_QUOTA_GRANT_DAY" org-b "SOME_OTHER_KEY ACME_DEV_ORGANIZATION__ANTHROPIC_API_KEY" other "SOME_OTHER_KEY" ;;
org-a) printf '%s\n' ORGANIZATION_API_KEY=k CC_QUOTA_GRANT_DAY=14 HOME=/elsewhere ;;
org-b) printf '%s\n' SOME_OTHER_KEY=x ACME_DEV_ORGANIZATION__ANTHROPIC_API_KEY=k ;;
*) exit 1 ;;
esac
EOF
chmod +x "$work/bin/with-secrets"
check "each with-secrets entry holding an organization key, under any name of that shape, is a Console org with its own grant day" \
	"console X org-a|  API credits   \$0.00 spent since Wed 14 Oct, through yesterday|console X org-b|  API credits   \$40.00 spent since Sat 10 Oct, through yesterday" \
	"$(PATH=$work/bin:$PATH quota | sed -n '/^console/,$p' | paste -sd'|')"

json=$(CC_QUOTA_ORG_KEY=k quota --json)
check "--json is the report on one line" "1" "$(wc -l <<<"$json")"
check "it holds each profile's buckets, or its error, as the text does" \
	"default:five_hour=30,seven_day=99,new_bucket=0|old:token expired; open claude in this profile to renew it|work:five_hour=30,seven_day=99,new_bucket=0" \
	"$(jq -r '.profiles | sort_by(.name)[] | "\(.name):\(.error // ([.buckets[] | "\(.name)=\(.used)"] | join(",")))"' <<<"$json" | paste -sd'|')"
check "and a reset rounded to the minute, in UTC" "2026-10-14T23:00:00Z" \
	"$(jq -r '.profiles[] | select(.name == "default") | .buckets[] | select(.name == "five_hour") | .resets_at' <<<"$json")"
check "and each Console org's spend in dollars, with no balance" '[{"entry":"key","org":"X","since":"2026-10-10","spent":40}]' \
	"$(jq -c '.consoles' <<<"$json")"
check "and without a key, no Console org" "[]" "$(CC_QUOTA_ORG_KEY= quota --json | jq -c .consoles)"

# No profile holds a login: each is read from what its statusline last saw.
statusline() { # statusline <session> <config dir> <minutes before now> [rate_limits]
	mkdir -p "$work/bare/.cache/claude-statusline"
	local f=$work/bare/.cache/claude-statusline/$1.json
	echo "{\"session_id\":\"$1\",\"config_dir\":\"$2\",\"written_at\":$((now - $3 * 60)).5${4:+,\"rate_limits\":$4}}" >"$f"
	touch -d "@$((now - $3 * 60))" "$f"
}
mkdir -p "$work/bare/.claude" "$work/bare/.claude-helferline" "$work/bare/.claude-unused"
ln -s "$work/bare/.claude-helferline" "$work/bare/hl-link"
login() { mkdir -p "$work/bare/$1"; echo "{\"claudeAiOauth\":{\"accessToken\":\"t\",\"expiresAt\":$2}}" >"$work/bare/$1/.credentials.json"; }
login .claude-lapsed 1
login .claude-refused "$future"
mkdir -p "$work/bare/.claude-fresh/projects"
# default: its newest reading carries no rate_limits yet (a session that has not had a reply), so the one before counts.
statusline s1 "$work/bare/.claude" 300 '{"five_hour":{"used_percentage":80,"resets_at":'$((now - 3600))'}}'
statusline s2 "$work/bare/.claude" 12 '{"five_hour":{"used_percentage":41.6,"resets_at":'$(date -d 2026-10-14T22:59:58Z +%s)'},"seven_day":{"used_percentage":7,"resets_at":'$(date -d 2026-10-20T08:00:00Z +%s)'}}'
statusline s3 "$work/bare/.claude" 1
# helferline: named through a link, its 5-hour window reset since the reading.
statusline s4 "$work/bare/hl-link/" 200 '{"five_hour":{"used_percentage":95,"resets_at":'$((now - 60))'},"seven_day":{"used_percentage":63.2,"resets_at":'$(date -d 2026-10-17T05:00:00Z +%s)'}}'
statusline s5 "$work/bare/.claude-lapsed" 30 '{"seven_day":{"used_percentage":20,"resets_at":'$(date -d 2026-10-17T05:00:00Z +%s)'}}'
# refused: its login is current, but the endpoint ($work/nowhere) answers nothing.
statusline s6 "$work/bare/.claude-refused" 2 '{"seven_day":{"used_percentage":5,"resets_at":'$(date -d 2026-10-17T05:00:00Z +%s)'}}'
# A reading that is not JSON, as a write caught halfway, is passed over.
printf '{"config_dir":' >"$work/bare/.cache/claude-statusline/broken.json"
bare() { HOME=$work/bare CC_QUOTA_API=file://$work/nowhere CC_QUOTA_NOW=$now CC_QUOTA_ORG_KEY= TZ=UTC "$cc_quota" "$@" 2>/dev/null; }

out=$(bare)
check "with no login, each profile with a statusline reading has its section, saying how old the reading is, and one with sessions but no reading is named" \
	"default as its statusline saw it 12m ago|fresh no login, and no statusline reading that carries rate_limits|helferline as its statusline saw it 3h 20m ago|lapsed as its statusline saw it 30m ago|refused as its statusline saw it 2m ago" \
	"$(grep -v '^ ' <<<"$out" | sort | paste -sd'|')"
check "its rows are the newest reading that carries rate_limits, resets rounded to the minute" \
	"  5-hour        ████████░░░░░░░░░░░░  42%  resets Wed 23:00, in 3h 0m
  week          █░░░░░░░░░░░░░░░░░░░   7%  resets Tue 08:00, in 5d 12h" \
	"$(sed -n '/^default/,/^[^ ]/{/^ /p}' <<<"$out")"
check "a bucket whose reset passed since the reading is a fresh window" \
	"  5-hour        ░░░░░░░░░░░░░░░░░░░░   0%  next reset unknown
  week          ████████████░░░░░░░░  63%  resets Sat 05:00, in 2d 9h" \
	"$(sed -n '/^helferline/,/^[^ ]/{/^ /p}' <<<"$out")"

json=$(bare --json)
check "--json holds each profile's buckets from its reading, and when it was seen" \
	"default@2026-10-14T19:48:00Z:five_hour=42/2026-10-14T23:00:00Z,seven_day=7/2026-10-20T08:00:00Z|helferline@2026-10-14T16:40:00Z:five_hour=0/null,seven_day=63/2026-10-17T05:00:00Z|lapsed@2026-10-14T19:30:00Z:seven_day=20/2026-10-17T05:00:00Z|refused@2026-10-14T19:58:00Z:seven_day=5/2026-10-17T05:00:00Z" \
	"$(jq -r '.profiles | sort_by(.name)[] | select(.seen_at) | "\(.name)@\(.seen_at):\([.buckets[] | "\(.name)=\(.used)/\(.resets_at)"] | join(","))"' <<<"$json" | paste -sd'|')"
rm "$work/bare/.cache/claude-statusline/s5.json"
check "a lapsed login with no reading is still named" "token expired; open claude in this profile to renew it" \
	"$(bare --json | jq -r '.profiles[] | select(.name == "lapsed") | .error')"

finish
