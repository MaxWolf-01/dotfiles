#!/usr/bin/env bash
# tier: fast
# Drive bin/host-unlock against a machines list of its own, with a stand-in ssh that logs what it was asked and
# what it was handed, and a stand-in sops that decrypts a secret to its own name. Run it directly; no framework.
#
# What max relies on: the machines with an unlock are the ones the list says have one, each reached at the ssh
# destination its entry names, and a machine with none is refused before anything is sent anywhere.

set -uo pipefail

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
needs jq

mkdir -p "$scratch/bin"
cat >"$scratch/bin/ssh" <<EOF
#!/usr/bin/env bash
echo "\$* < \$(cat)" >>"$scratch/ssh.log"
EOF
printf '#!/bin/sh\necho "secret:$(basename "$2")"\n' >"$scratch/bin/sops"
chmod +x "$scratch/bin/ssh" "$scratch/bin/sops"
export PATH="$scratch/bin:$PATH"
echo age-key >"$scratch/age-key.txt"
export SOPS_AGE_KEY_FILE="$scratch/age-key.txt"

# xmg19 reached at an alias of its own; a desk machine with nothing locked; a machine with an unlock that this
# script has no steps for.
export MACHINES_FILE="$scratch/machines.json"
cat >"$MACHINES_FILE" <<'JSON'
[
  {"name": "pc", "ssh": "pc-alias", "unlock": true},
  {"name": "zephylux", "ssh": "zephylux", "unlock": false},
  {"name": "xmg19", "ssh": "xmg-alias", "unlock": true},
  {"name": "vps", "ssh": "vps.example", "unlock": true}
]
JSON

unlock() { : >"$scratch/ssh.log"; out=$("$bin/host-unlock" "$1" 2>&1); status=$?; }

unlock xmg19
check "xmg19's home key goes to its entry's ssh destination, through sudo" \
    "0 xmg-alias sudo host-unlock-receive < secret:xmg19-home-luks" "$status $(cat "$scratch/ssh.log")"

unlock pc
check "pc gets its age key, ssh key and datasets, then finish, all at its entry's ssh destination" \
    "0 pc-alias host-unlock-receive age-key < age-key
pc-alias host-unlock-receive ssh-key < secret:ssh-passphrase-pc
pc-alias host-unlock-receive zfs phone < secret:zfs-phone-general
pc-alias host-unlock-receive zfs general < secret:zfs-phone-general
pc-alias host-unlock-receive zfs encrypted < secret:zfs-encrypted
pc-alias host-unlock-receive finish < " "$status $(cat "$scratch/ssh.log")"

unlock zephylux
check "a machine the list gives no unlock is refused, naming those it gives one, and nothing is sent" \
    "1 host-unlock: no unlock known for 'zephylux' (pc, xmg19, vps) ssh:0" "$status $out ssh:$(wc -l <"$scratch/ssh.log")"

unlock athena
check "...and so is a machine the list does not hold" 1 "$status"

unlock vps
[ "$status" -eq 1 ] && [[ $out == *"says vps has an unlock, but this script has no steps for it"* ]] &&
    [ ! -s "$scratch/ssh.log" ] &&
    passed "a machine the list gives an unlock the script has no steps for is refused, saying so" ||
    fail "a machine the list gives an unlock the script has no steps for is refused, saying so" "$status $out"

finish
