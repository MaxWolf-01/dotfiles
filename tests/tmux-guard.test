#!/usr/bin/env bash
# Drive nix/home/tmux-guard.sh against a stubbed tmux. Run it directly; no
# framework.
#
# The promises here: kill-server is refused in every spelling tmux accepts,
# target-less and -a forms of kill-session/kill-window are refused, a command
# on its own socket or carrying the bypass flag reaches the real tmux with the
# flag stripped, and everything else passes through untouched.

set -uo pipefail

guard="$(cd "$(dirname "${BASH_SOURCE[0]}")/../nix/home" && pwd)/tmux-guard.sh"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# The stub records the argv it received; a pass-through is proven by that file,
# a block by its absence.
cat >"$work/tmux" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$WORK/argv"
exit "${STUB_EXIT:-0}"
STUB
chmod +x "$work/tmux"

export WORK="$work" TMUX_TMPDIR="$work/run"
unset TMUX
default_socket="$work/run/tmux-$(id -u)/default"

# run <args...>: sets rc, err (stderr), and argv (what the stub saw, or "-").
run() {
    rm -f "$work/argv"
    err=$(bash "$guard" "$work/tmux" "$@" 2>&1 >/dev/null)
    rc=$?
    if [ -f "$work/argv" ]; then argv=$(paste -sd' ' "$work/argv"); else argv="-"; fi
}

blocked() {
    run "$@"
    check "blocked: $*" "1 - tmux guard: blocked" "$rc $argv ${err:0:19}"
}

passed() {
    run "$@"
    check "passed: $*" "0 $*" "$rc $argv"
}

blocked kill-server
blocked kill-ser
blocked new-session -d -s a \; kill-server
blocked -f /dev/null kill-server
blocked -2u kill-server
blocked -L default kill-server
blocked -S "$default_socket" kill-server
blocked kill-session
blocked kill-ses
blocked kill-window
blocked kill-w
blocked killw
blocked kill-session -a -t mine
blocked kill-session -t mine -a
blocked kill-window -at mine

passed kill-se
passed ls
passed kill-session -t mine
passed kill-window -tmine
passed kill-session -ta
passed send-keys -t x kill-server
passed capture-pane -p -S -50
passed -L scratch kill-server
passed -Lscratch kill-session
passed -S "$work/other" kill-server

run --dangerously-bypass-protection kill-server
check "bypass flag stripped before the real tmux (leading)" "0 kill-server" "$rc $argv"
run kill-session --dangerously-bypass-protection
check "bypass flag stripped before the real tmux (trailing)" "0 kill-session" "$rc $argv"

TMUX="$work/run/sock,1,0" run -S "$work/run/sock" kill-server
check "blocked: -S naming the socket \$TMUX points at" "1 -" "$rc $argv"

run kill-server
check "block message names the bypass flag" "yes" "$(case $err in *--dangerously-bypass-protection*) echo yes;; *) echo no;; esac)"
check "block message says to ask the user" "yes" "$(case $err in *"ask the user"*) echo yes;; *) echo no;; esac)"

STUB_EXIT=3 run ls
check "real tmux's exit code comes back on pass-through" "3" "$rc"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
else
    echo "$failures check(s) failed"
    exit 1
fi
