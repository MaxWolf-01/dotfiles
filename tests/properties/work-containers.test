#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["hypothesis", "tyro", "pyyaml", "markdown-it-py"]  # and the hub's own, whose module this loads
# ///
"""Check the properties of work containers (the dotfiles ticket work-containers), and that a hub unit's view is a
function of what is on disk and the time (hub-decisions-tested-at-the-module). Run it directly; no framework.

P1, P2, P6 and the view's property are checked against the container hub's module, loaded in this process with
HOME in a scratch directory, as tests/container-hub.test loads it; no example starts a hub. P3 is checked at
claude-browser's seam with no hub at all, and P4 at the address `diffview --open` prints and one hub behind it, on a
free port, never 8377. P5, links and keys inside a page, is reviewed in a browser; tests/container-hub-view.test
drives it in headless Chromium. Which container a page went to is read from the hub's answer: the key is the hub's
to choose. A container here is a unit of the hub: one orchestrator session's pages.

Hypothesis draws whole worlds: one or two repos, each with an agent repo of ticket trees, every ticket
committed by one of a few sessions (a `Session:` trailer), pages under the tickets' show, prototype and
diffview paths, and loose pages under no ticket. Then what the sessions do: open those pages, several times,
by different sessions and by different spellings of the same file, and close them.

Which container a page lands in is read off the tracker. The hub asks the mx plugin's `tracker data` for it, which
the worlds here have answered by a stand-in that reads their ticket files: the plugin's own takes a quarter of a second
a world, and tests/container-hub.test reads by it.

Examples:

    tests/properties/work-containers.test
    tests/properties/work-containers.test P1 P3
"""

import atexit
import contextlib
import io
import itertools
import json
import os
import random
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import traceback
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from pathlib import Path

from hypothesis import HealthCheck, Phase, example, given, settings
from hypothesis import strategies as st
from hypothesis.database import DirectoryBasedExampleDatabase

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
sys.dont_write_bytecode = True  # importing bin/ must not leave a __pycache__ on $PATH, nor tests/ one
import container_hub_fakes as fakes  # noqa: E402  (the hub's module in this process, and its clock)

BIN = Path(__file__).resolve().parents[2] / "bin"
SCRATCH = Path(tempfile.mkdtemp(prefix="work-containers-test."))
HOME = SCRATCH / "home"
"""The HOME of the hub's module in this process, which the worlds are placed in."""
LIVE_HUB_PORT = 8377
"""The port of the hub this machine runs, which no check may touch."""
PORT = 18377
"""The port the hub's module takes for its own in this process, so that one of its addresses names a page it serves.
Nothing listens on it."""

PROPERTIES = []


def prop(fn):
    PROPERTIES.append(fn)
    return fn


def checked(examples: int):
    """Hypothesis settings."""
    return settings(
        max_examples=examples,
        deadline=None,
        phases=[Phase.explicit, Phase.reuse, Phase.generate, Phase.target, Phase.shrink],
        report_multiple_bugs=False,
        database=DirectoryBasedExampleDatabase(Path(__file__).resolve().parent / ".hypothesis"),
        suppress_health_check=[HealthCheck.too_slow, HealthCheck.data_too_large],
    )


# --------------------------------------------------------------------------
# the world: repos, ticket trees, sessions and pages, on disk
# --------------------------------------------------------------------------

SLUGS = ["map-columns", "csv-import", "one-flow", "board-orients", "sync-state", "drop-zone"]
"""Few enough that two repos often hold the same slug."""

PAGE_KINDS = [
    "agent/show/{slug}/index.html",
    "agent/show/{slug}/figure.svg",
    "agent/prototypes/{slug}/index.html",
    "agent/diffviews/{slug}.html",
]

SPELLINGS = ["path", "file-url", "dotted", "symlink", "served"]
"""How an opener names a page: its path, a file:// URL, a path through `/./`, a path through a symlinked
directory, or the address the hub serves it at (a link followed inside a page)."""

WORLDS = itertools.count()


@dataclass(frozen=True)
class Ticket:
    repo: str
    slug: str
    parent: str | None
    session: int
    """Which of the world's sessions committed it."""


@dataclass(frozen=True)
class World:
    tickets: tuple[Ticket, ...]
    pages: tuple[str, ...]
    """Paths relative to the world's directory; loose pages sit outside every repo."""
    sessions: int


@st.composite
def worlds(draw) -> World:
    sessions = draw(st.integers(1, 3))
    tickets = []
    for repo in draw(st.lists(st.sampled_from(["alpha", "beta"]), min_size=1, max_size=2, unique=True)):
        slugs = draw(st.lists(st.sampled_from(SLUGS), min_size=1, max_size=4, unique=True))
        for i, slug in enumerate(slugs):
            parent = draw(st.sampled_from([None, *slugs[:i]])) if i else None
            tickets.append(Ticket(repo, slug, parent, draw(st.integers(0, sessions - 1))))
    pages = [f"repos/{t.repo}/" + kind.format(slug=t.slug)
             for t in tickets for kind in draw(st.lists(st.sampled_from(PAGE_KINDS), max_size=2, unique=True))]
    pages += [f"scratch/note-{i}.html" for i in range(draw(st.integers(0, 2)))]
    if not pages:
        pages.append(f"repos/{tickets[0].repo}/" + PAGE_KINDS[0].format(slug=tickets[0].slug))
    return World(tuple(tickets), tuple(pages), sessions)


@dataclass
class Placed:
    """A world written under a directory of its own, with session ids no other world uses."""

    world: World
    root: Path
    sessions: list[str]

    def page(self, i: int) -> Path:
        return self.root / self.world.pages[i]


def git(cwd: Path, *args: str, env: dict | None = None) -> None:
    subprocess.run(["git", "-c", "user.name=fixture", "-c", "user.email=fixture@example.com", *args],
                   cwd=cwd, env=env or base_env(SCRATCH), check=True, capture_output=True)


TICKET = """---
status: {status}
{parent}priority: 2
size: S
---

# {title}

## Brief

{brief}

## Acceptance criteria

## Comments
"""


def place(world: World, home: Path) -> Placed:
    n = next(WORLDS)
    root = home / f"world-{n}"
    sessions = [f"{n:08x}-0000-4000-8000-{s:012x}" for s in range(world.sessions)]
    for repo in sorted({t.repo for t in world.tickets}):
        code = root / "repos" / repo
        (code / "agent" / "tickets").mkdir(parents=True)
        git(code, "init", "-q")
        (code / ".git" / "info" / "exclude").write_text("agent/\n")
        (code / "README.md").write_text(f"{repo}\n")
        git(code, "add", "README.md")
        git(code, "commit", "-q", "-m", "init")
        agent = code / "agent"
        git(agent, "init", "-q")
        for i, t in enumerate(x for x in world.tickets if x.repo == repo):
            (agent / "tickets" / f"{t.slug}.md").write_text(TICKET.format(
                status="claimed" if t.parent else "open", parent=f"parent: {t.parent}\n" if t.parent else "",
                title=t.slug.replace("-", " ").capitalize(), brief=f"The {t.slug} ticket of {repo}."))
            stamp = f"2026-10-01T10:{i:02d}:00+00:00"
            env = {**base_env(SCRATCH), "GIT_AUTHOR_DATE": stamp, "GIT_COMMITTER_DATE": stamp}
            git(agent, "add", f"tickets/{t.slug}.md", env=env)
            git(agent, "commit", "-q", "-m", f"file {t.slug}\n\nSession: {sessions[t.session]}", env=env)
    for rel in world.pages:
        page = root / rel
        page.parent.mkdir(parents=True, exist_ok=True)
        page.write_text(f"<!doctype html><title>{rel}</title><p>{rel}</p>\n" if page.suffix == ".html"
                        else f'<svg xmlns="http://www.w3.org/2000/svg"><title>{rel}</title></svg>\n')
    (root / "link").symlink_to(root, target_is_directory=True)
    return Placed(world, root, sessions)


# --------------------------------------------------------------------------
# the hub: its module in this process, and the environment everything under test runs in
# --------------------------------------------------------------------------

UV_DIRS = {
    "UV_CACHE_DIR": subprocess.run(["uv", "cache", "dir"], capture_output=True, text=True, check=True).stdout.strip(),
    "UV_PYTHON_INSTALL_DIR": subprocess.run(["uv", "python", "dir"], capture_output=True, text=True, check=True).stdout.strip(),
}
"""uv's own directories, which would otherwise move into the scratch HOME and fetch everything again."""


TRACKER = f"""#!{sys.executable} -I
# `tracker data` as the hub reads it, for the worlds here: the tickets of the repo it runs in, by their frontmatter
import json, pathlib, sys
root = pathlib.Path.cwd() / "agent" / "tickets"
if sys.argv[1:] != ["data"] or not root.is_dir():
    sys.exit("tracker: refused: no tracker here")
tickets = []
for path in sorted(root.glob("*.md")):
    front, _, body = path.read_text().removeprefix("---\\n").partition("\\n---\\n")
    fields = dict(line.split(": ", 1) for line in front.splitlines())
    title = next(line[2:] for line in body.splitlines() if line.startswith("# "))
    tickets.append({{"slug": path.stem, "status": fields["status"], "parent": fields.get("parent"), "title": title, "diff": []}})
print(json.dumps({{"root": str(root.resolve()), "tickets": tickets}}))
"""


def base_env(home: Path, **extra: str) -> dict[str, str]:
    """This environment with HOME moved, no session of its own, and no git or XDG configuration of the
    user's: a global commit hook would stamp the fixture's commits with this run's session."""
    env = {k: v for k, v in os.environ.items()
           if not k.startswith(("CLAUDE", "GIT_", "XDG_CONFIG", "XDG_DATA", "XDG_STATE", "XDG_CACHE", "CONTAINER_HUB"))}
    env.update({k: v for k, v in UV_DIRS.items() if v}, HOME=str(home), PATH=f"{BIN}:{os.environ['PATH']}",
               GIT_CONFIG_GLOBAL=os.devnull, GIT_CONFIG_NOSYSTEM="1")
    env.update(extra)
    return env


class Hub:
    """The hub's module, loaded anew in this process on a state directory, at the time its clock reads: what the hub
    decides, with no server. What a restart keeps is what is on disk, so a hub loaded anew on the same state is
    the hub restarted."""

    def __init__(self, state: Path, clock: fakes.Clock):
        self.module, self.state, self.clock = fakes.load(clock, state), state, clock

    def restarted(self) -> "Hub":
        return Hub(self.state, self.clock)

    def open(self, target: str, session: str) -> tuple[str, str]:
        """The unit the page went to, and its member id there."""
        status, answer = self.module.open_page({"target": target, "session": session}, PORT, from_page=False)
        assert status == 200 and "unit" in answer, f"opening {target} as {session} answered {status}: {answer}"
        return answer["unit"], answer["id"]

    def close(self, key: str, member_id: str) -> None:
        status, answer = self.module.mark("close", {"unit": key, "id": member_id})
        assert status == 200, f"closing {member_id} in {key} answered {status}: {answer}"

    def unit(self, key: str) -> dict | None:
        """A unit as the hub tab reads it (/api/u/<key>)."""
        return next((u for u in self.view()["units"] if u["unit"] == key), None)

    def view(self) -> dict:
        return self.module.hub_view()

    def rail(self, sessions: list[str]) -> list[tuple]:
        """What the hub derives of these sessions' units from disk: each one's title, tree and repo, its session's
        state, and its number."""
        return sorted((u["unit"], u["title"], u["tree"], u["repo"], u["state"], u["number"])
                      for u in self.view()["units"] if u["unit"] in sessions)


def fresh_hub() -> Hub:
    """A hub on a state directory of its own, its clock at a fixed time: a read of every unit reads one world's."""
    return Hub(Path(tempfile.mkdtemp(prefix="state.", dir=SCRATCH)), fakes.Clock(1_790_000_000.0))


def spell(placed: Placed, i: int, how: str, member_url: str | None) -> str:
    page = placed.page(i)
    if how == "file-url":
        return "file://" + urllib.parse.quote(str(page))
    if how == "dotted":
        return f"{page.parent}/./{page.name}"
    if how == "symlink":
        return str(placed.root / "link" / page.relative_to(placed.root))
    if how == "served" and member_url:
        return urllib.parse.urljoin(f"http://127.0.0.1:{PORT}", member_url)
    return str(page)


def member(view: dict, member_id: str) -> dict | None:
    return next((m for m in view["members"] if m["id"] == member_id), None)


def listing(view: dict) -> str:
    return "\n".join(f"        {m['id']}  {m['url']}{'  (closed)' if m.get('closed') else ''}" for m in view["members"])


def running(placed: Placed, rng: random.Random) -> list[Path]:
    """The world's sessions run, in Claude Code's session registry. This process stands in for each, some at work and
    the others idle since a turn of their own, so the rail numbers them, and in an order the opens do not give. The
    files, which the caller deletes once the world is done with, so the next world's sessions are numbered among
    themselves."""
    registry = [HOME / ".claude" / "sessions" / f"{s}.json" for s in placed.sessions]
    registry[0].parent.mkdir(parents=True, exist_ok=True)
    started = Path("/proc/self/stat").read_text().rsplit(")", 1)[1].split()[19]
    for path, s, at in zip(registry, placed.sessions, rng.sample(range(10**6), len(placed.sessions))):
        path.write_text(json.dumps({"pid": os.getpid(), "procStart": started, "sessionId": s,
                                    "status": rng.choice(["idle", "busy"]), "statusUpdatedAt": (1_790_000_000 + at) * 1000}))
    return registry


# --------------------------------------------------------------------------
# P1: no second copy
# --------------------------------------------------------------------------

STEP = st.tuples(st.sampled_from(["open", "open", "open", "close"]), st.integers(0, 7),
                 st.sampled_from(SPELLINGS), st.integers(0, 2))


@prop
def p1():
    """P1 Opening a page never produces a second copy of a page the container already holds.

    Whatever spelling the opener uses and whichever session opens it, a container holds one member per page
    opened into it: the first open adds one, every later one leaves the count as it was. A closed page is
    still held, so opening it again adds nothing either."""

    @checked(25)
    @given(worlds(), st.lists(STEP, min_size=1, max_size=12))
    def holds(world, steps):
        hub = fresh_hub()
        placed = place(world, HOME)
        into: dict[str, set[int]] = {}
        last: dict[int, tuple[str, str]] = {}
        done = []
        for op, i, how, s in steps:
            i, session = i % len(world.pages), placed.sessions[s % world.sessions]
            if op == "close":
                if i not in last:
                    continue
                key, mid = last[i]
                hub.close(key, mid)
                done.append(f"close {world.pages[i]} in {key}")
            else:
                url = member(hub.unit(last[i][0]), last[i][1])["url"] if how == "served" and i in last else None
                target = spell(placed, i, how, url)
                key, mid = hub.open(target, session)
                last[i] = (key, mid)
                into.setdefault(key, set()).add(i)
                done.append(f"open {target} as session {s} -> {key} {mid}")
            view = hub.unit(key)
            assert len(view["members"]) == len(into[key]), (
                f"container {key} holds {len(view['members'])} members after these steps, but only "
                f"{len(into[key])} distinct pages were opened into it:\n      " + "\n      ".join(done)
                + f"\n      its members:\n{listing(view)}")

    holds()


# --------------------------------------------------------------------------
# P2: survives a restart
# --------------------------------------------------------------------------

@prop
def p2():
    """P2 A container's pages, and which of them are closed, survive a hub restart.

    The hub is loaded anew on its state once the container has answered with every page opened and closed: what a
    restart keeps is what the hub wrote before it answered. Loaded anew, each container answers the same members and
    the same closed members."""

    @checked(15)
    @given(worlds(), st.lists(st.integers(0, 2), min_size=1, max_size=8), st.lists(st.integers(0, 7), max_size=8))
    def survives(world, openers, closes):
        hub = fresh_hub()
        placed = place(world, HOME)
        ids: dict[int, tuple[str, str]] = {}
        for i in range(len(world.pages)):
            ids[i] = hub.open(spell(placed, i, "path", None), placed.sessions[openers[i % len(openers)] % world.sessions])
        closed = set()
        for i in closes:
            key, mid = ids[i % len(world.pages)]
            hub.close(key, mid)
            closed.add(mid)
        before = {key: snapshot(hub.unit(key)) for key, _ in ids.values()}
        for key, mid in ids.values():
            members = before[key]
            assert mid in {m[0] for m in members}, f"{mid} is not a member of {key} before the restart: {members}"
            shut = mid in {m[0] for m in members if m[2]}
            assert shut == (mid in closed), f"{mid} in {key} should{'' if mid in closed else ' not'} be closed before the restart"
        restarted = hub.restarted()
        for key, was in before.items():
            now = snapshot(restarted.unit(key))
            assert now == was, f"container {key} changed across the restart:\n      before {was}\n      after  {now}"

    survives()


def snapshot(view: dict) -> frozenset:
    """A container's members, as (id, url, closed)."""
    return frozenset((m["id"], m["url"], bool(m.get("closed"))) for m in view["members"])


# --------------------------------------------------------------------------
# P3: no hub, a plain tab
# --------------------------------------------------------------------------

BRAVE = """#!/bin/sh
printf '%s\\n' "$@" > "$RECORD.tmp" && mv "$RECORD.tmp" "$RECORD"
"""

SYSTEMD_RUN = """#!/bin/sh
# drop systemd-run's own options, run the command they wrap
while [ "${1#--}" != "$1" ]; do shift; done
exec "$@"
"""


@contextlib.contextmanager
def no_hub(how: str):
    """A port with no hub on it: nothing listening, a socket that never answers, or a server that is not one."""
    if how == "nothing":
        yield free_port()
        return
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    s.listen(8)
    stop = False
    if how == "foreign":
        def serve():
            while not stop:
                with contextlib.suppress(OSError):
                    conn, _ = s.accept()
                    with conn:
                        conn.recv(65536)
                        conn.sendall(b"HTTP/1.0 404 Not Found\r\nContent-Length: 0\r\n\r\n")

        threading.Thread(target=serve, daemon=True).start()
    try:
        yield s.getsockname()[1]
    finally:
        stop = True
        s.close()


def free_port() -> int:
    while True:
        with socket.socket() as s:
            s.bind(("127.0.0.1", 0))
            port = s.getsockname()[1]
        if port != LIVE_HUB_PORT:
            return port


@prop
def p3():
    """P3 With no hub answering, claude-browser hands the browser the plain URL or file, as today.

    Nothing on the hub's port, a socket that accepts and never answers, and a server that is not a hub: each
    time the browser gets the profile and the target it got before containers, the file as a file:// URL of
    its real path, a URL as it was given, and a blank tab for no target, within a few seconds."""
    home = Path(tempfile.mkdtemp(prefix="p3-home.", dir=SCRATCH))
    stubs = home / "stubs"
    stubs.mkdir()
    for name, body in (("brave", BRAVE), ("systemd-run", SYSTEMD_RUN)):
        (stubs / name).write_text(body)
        (stubs / name).chmod(0o755)
    state = home / ".config" / "BraveSoftware" / "Brave-Browser" / "Local State"
    state.parent.mkdir(parents=True)
    state.write_text(json.dumps({"profile": {"info_cache": {"Profile 3": {"name": "Personal"}}}}))
    pages = home / "repos" / "alpha" / "agent" / "show" / "map-columns"
    pages.mkdir(parents=True)
    (pages / "index.html").write_text("<!doctype html><p>map columns</p>\n")
    (pages / "a figure.svg").write_text('<svg xmlns="http://www.w3.org/2000/svg"/>\n')
    (home / "linked").symlink_to(pages)
    cases = [
        ([str(pages / "index.html")], f"file://{pages}/index.html"),
        (["agent/show/map-columns/a figure.svg"], f"file://{pages}/a figure.svg"),
        ([str(home / "linked" / "index.html")], f"file://{pages}/index.html"),
        (["https://example.com/a/b?c=d#e"], "https://example.com/a/b?c=d#e"),
        ([], "about:blank"),
    ]

    def hands(n: int, how: str, args: list[str], target: str) -> None:
        """One case, with a record of its own: the cases run at once, since a socket that never answers holds each
        for as long as claude-browser waits on it."""
        record = home / f"record-{n}"
        with no_hub(how) as port:
            env = base_env(home, CLAUDE_CONFIG_DIR=str(home / ".claude"), CONTAINER_HUB_PORT=str(port),
                           CLAUDE_CODE_SESSION_ID="00000000-0000-4000-8000-000000000003", RECORD=str(record),
                           PATH=f"{stubs}:{BIN}:{os.environ['PATH']}")
            started = time.monotonic()
            run = subprocess.run([BIN / "claude-browser", *args], env=env, cwd=home / "repos" / "alpha",
                                 capture_output=True, text=True, timeout=30, check=False)
            took = time.monotonic() - started
        at = f"claude-browser {' '.join(args)} with {how} on the hub's port"
        assert run.returncode == 0, f"{at} exited {run.returncode}: {run.stderr}"
        assert took < 10, f"{at} took {took:.1f} s"
        deadline = time.monotonic() + 10
        while not record.exists() and time.monotonic() < deadline:
            time.sleep(0.05)
        assert record.exists(), f"{at}: the browser was never started"
        handed = record.read_text().splitlines()
        assert len(handed) == 2 and handed[0] == "--profile-directory=Profile 3", f"{at}: the browser got {handed}"
        got = urllib.parse.unquote(handed[1]) if handed[1].startswith("file://") else handed[1]
        assert got == target, f"{at}: the browser got {handed[1]!r}, not {target!r}"

    every = [(how, args, target) for how in ("nothing", "silent", "foreign") for args, target in cases]
    with ThreadPoolExecutor(len(every)) as pool:
        for done in [pool.submit(hands, n, *case) for n, case in enumerate(every)]:
            done.result()


# --------------------------------------------------------------------------
# P4: a diffview page takes comments through the hub
# --------------------------------------------------------------------------


class HubError(Exception):
    pass


class NotThroughHub(Exception):
    """`diffview --open` printed an address on a server other than the hub."""


@contextlib.contextmanager
def hub_process():
    """bin/container-hub on a port of its own, its HOME and state in a scratch directory: (its HOME, its origin)."""
    home = Path(tempfile.mkdtemp(prefix="hub-home.", dir=SCRATCH))
    port = free_port()
    log = home / "hub.log"
    with log.open("a") as out:
        proc = subprocess.Popen(
            [BIN / "container-hub", "--port", str(port), "--state", str(home / ".local" / "state" / "container-hub")],
            env=base_env(home), cwd=home, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    try:
        deadline = time.monotonic() + 60
        while True:
            if proc.poll() is not None:
                raise HubError(f"the hub exited with {proc.returncode} on start:\n{log.read_text()}")
            with contextlib.suppress(OSError), socket.create_connection(("127.0.0.1", port), timeout=1):
                break
            if time.monotonic() > deadline:
                raise HubError(f"the hub did not answer on port {port} within 60 s:\n{log.read_text()}")
            time.sleep(0.1)
        yield home, port
    finally:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)  # `uv run` leads the group; the server is its child
        proc.wait()


def request(origin: str, method: str, url: str, body: bytes | None = None, headers: dict | None = None) -> tuple[int, bytes, str]:
    """Status, body and the URL answered at, after redirects."""
    req = urllib.request.Request(urllib.parse.urljoin(origin, url), data=body, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, r.read(), r.url
    except urllib.error.HTTPError as e:
        return e.code, e.read(), e.url


@prop
def p4():
    """P4 A diffview page that `diffview --open` opens is served by the hub, so it is never read-only.

    The address it prints is on the hub's origin and answers with the page; the hub answers /.health with
    `saves: true`; and a state-file write to the page's address plus `.state.json`, from the hub's own
    origin, lands in the file beside the page."""
    with hub_process() as (home, port):
        origin = f"http://127.0.0.1:{port}"
        repo = home / "repos" / "alpha"
        repo.mkdir(parents=True)
        (home / ".cache" / "diffview").mkdir(parents=True)
        (home / ".cache" / "diffview" / "highlight.min.js").write_text("")  # diffview would fetch it otherwise
        token = f"line-{os.getpid()}-only-in-this-diff"
        git(repo, "init", "-q")
        (repo / "notes.txt").write_text("one\n")
        git(repo, "add", "notes.txt")
        git(repo, "commit", "-q", "-m", "one")
        (repo / "notes.txt").write_text(f"one\n{token}\n")
        git(repo, "commit", "-q", "-am", "two")
        page = repo / "agent" / "diffviews" / "map-columns.html"
        record = home / "opened"
        browser = home / "browser"
        browser.write_text(f'#!/bin/sh\nprintf "%s\\n" "$1" > {record}\n')
        browser.chmod(0o755)
        env = base_env(home, CONTAINER_HUB_PORT=str(port), DIFFVIEW_BROWSER=str(browser))
        run = subprocess.run([BIN / "diffview", f"{repo}@HEAD~1..HEAD", "-o", str(page), "--open",
                              "--no-auto-summary"], cwd=repo, env=env, capture_output=True, text=True, timeout=120,
                             check=False)
        assert run.returncode == 0, f"diffview --open exited {run.returncode}: {run.stderr}"
        address = next((line for line in run.stdout.splitlines() if line.startswith(("http://", "https://"))), None)
        assert address, f"diffview --open printed no http address: {run.stdout!r}"
        where = urllib.parse.urlsplit(address)
        if where.scheme != "http" or where.netloc not in (f"127.0.0.1:{port}", f"localhost:{port}"):
            raise NotThroughHub(f"diffview --open printed {address}, not an address on the hub at port {port}")
        status, raw, _ = request(origin, "GET", "/.health")
        health = json.loads(raw) if status == 200 else None
        assert isinstance(health, dict) and health.get("saves") is True, f"/.health answered {status}: {raw[:200]!r}"
        status, raw, final = request(origin, "GET", address)
        assert status == 200 and token.encode() in raw, f"{address} answered {status}, without the page"
        state = {"writer": "p4", "savedAt": 1, "comments": [{"id": 1, "path": "notes.txt", "text": "why?"}]}
        target = urllib.parse.urlsplit(final)._replace(query="", fragment="").geturl() + ".state.json"
        status, raw, _ = request(origin, "POST", target, json.dumps(state).encode(),
                                 {"Origin": f"{where.scheme}://{where.netloc}", "Content-Type": "application/json"})
        assert 200 <= status < 300, f"the state write to {target} answered {status}: {raw[:200]!r}"
        beside = Path(f"{page}.state.json")
        assert beside.is_file() and json.loads(beside.read_text()) == state, (
            f"{beside} does not hold the state written: {beside.read_text() if beside.is_file() else 'missing'}")


# --------------------------------------------------------------------------
# P6: the container is derived from files on disk
# --------------------------------------------------------------------------


@prop
def p6():
    """P6 The container is derived from files on disk: the hub's own state can go.

    Each page is opened by one or two of the world's sessions. The hub's state directory is deleted, and the hub
    loaded anew; opening the same pages by the same sessions, in another order, answers the same unit for each, and
    the rail derives the same of each unit: its title, its tree and repo, its session's state and its number."""

    @checked(15)
    @given(worlds(), st.lists(st.integers(0, 2), min_size=1, max_size=8), st.randoms(use_true_random=False))
    # a session that committed on neither of two trees, opening a page of each: the tree beside its unit follows from
    # disk, not from which page it opened last
    @example(World((Ticket("alpha", "map-columns", None, 0), Ticket("alpha", "csv-import", None, 0)),
                   ("repos/alpha/agent/show/map-columns/index.html", "repos/alpha/agent/show/csv-import/index.html"), 2),
             [1], random.Random(1))
    def derived(world, openers, rng):
        hub = fresh_hub()
        placed = place(world, HOME)
        registry = running(placed, rng)
        try:
            opens = []
            for i in range(len(world.pages)):
                first = openers[i % len(openers)] % world.sessions
                opens.append((i, placed.sessions[first]))
                if (second := openers[(i + 1) % len(openers)] % world.sessions) != first:
                    opens.append((i, placed.sessions[second]))
            before = {(i, s): hub.open(str(placed.page(i)), s)[0] for i, s in opens}
            rail = hub.rail(placed.sessions)
            shutil.rmtree(hub.state)
            hub.state.mkdir()
            hub = hub.restarted()
            rng.shuffle(opens)
            for i, s in opens:
                now = hub.open(str(placed.page(i)), s)[0]
                assert now == before[(i, s)], (
                    f"{world.pages[i]} opened by {s} went to {before[(i, s)]}, and to {now} once the hub's state was gone")
            again = hub.rail(placed.sessions)
            assert again == rail, (f"the rail derived other units once the hub's state was gone and the pages were opened in another"
                                   f" order:\n      before {rail}\n      after  {again}")
        finally:
            for path in registry:
                path.unlink(missing_ok=True)

    derived()


# --------------------------------------------------------------------------
# hub-decisions-tested-at-the-module#P1: the view is a function of what is on disk and the time
# --------------------------------------------------------------------------


CHANGES = ["status", "retire", "turn", "heading", "title", "page", "statusline"]
"""What changes on disk under a running hub: a ticket's status, a ticket retired, a session finishing a turn or
starting one, its session page's heading, its title in its transcript, a page deleted, what its statusline keeps."""


def lived(placed: Placed, rng: random.Random) -> None:
    """What the world's sessions leave besides their commits: a session page with its heading in the first repo, a
    transcript with Claude Code's title for the session, and what the statusline keeps of its last render, each for
    some of them."""
    first = placed.root / "repos" / sorted({t.repo for t in placed.world.tickets})[0] / "agent"
    for s in placed.sessions:
        if rng.random() < 0.5:
            heading(first / "sessions" / s, rng)
        if rng.random() < 0.5:
            titled(s, rng)
        if rng.random() < 0.5:
            statusline(s, rng)


def heading(session_dir: Path, rng: random.Random) -> None:
    session_dir.mkdir(parents=True, exist_ok=True)
    (session_dir / "index.html").write_text("<!doctype html><p>a session page</p>\n")
    (session_dir / "session.md").write_text(f"---\nsession: x\n---\n\n# Session {rng.randrange(10**6)}\n")


def titled(session: str, rng: random.Random) -> None:
    path = HOME / ".claude" / "projects" / "-world" / f"{session}.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    kind = rng.choice(["ai", "custom"])
    with path.open("a") as f:
        f.write(json.dumps({"type": f"{kind}-title", f"{kind}Title": f"title {rng.randrange(10**6)}", "sessionId": session}) + "\n")


def statusline(session: str, rng: random.Random) -> None:
    path = HOME / ".cache" / "claude-statusline" / f"{session}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    used = rng.randrange(100)
    path.write_text(json.dumps({"session_id": session, "config_dir": str(HOME / ".claude"), "written_at": 1_790_000_000 + rng.randrange(10**6),
                                "context_window": {"used_percentage": used, "total_input_tokens": used * 2000},
                                "rate_limits": {"five_hour": {"used_percentage": used, "resets_at": 1_790_100_000}}}))


def change(placed: Placed, registry: list[Path], what: str, rng: random.Random) -> None:
    """One of CHANGES, to a ticket, session or page the world has."""
    tickets = sorted(placed.root.glob("repos/*/agent/tickets/*.md"))
    session = rng.choice(placed.sessions)
    if what == "status" and tickets:
        path = rng.choice(tickets)
        path.write_text(re.sub(r"^status: .*$", f"status: {rng.choice(['open', 'claimed', 'review', 'done'])}", path.read_text(),
                               count=1, flags=re.M))
    elif what == "retire" and tickets:
        rng.choice(tickets).unlink()
    elif what == "turn":
        path = rng.choice(registry)
        entry = json.loads(path.read_text())
        path.write_text(json.dumps({**entry, "status": rng.choice(["idle", "busy", "waiting"]),
                                    "statusUpdatedAt": entry["statusUpdatedAt"] + rng.randrange(1, 10**6)}))
    elif what == "heading":
        heading(placed.root / "repos" / sorted({t.repo for t in placed.world.tickets})[0] / "agent" / "sessions" / session, rng)
    elif what == "title":
        titled(session, rng)
    elif what == "page" and (pages := [p for p in map(placed.page, range(len(placed.world.pages))) if p.exists()]):
        rng.choice(pages).unlink()
    elif what == "statusline":
        statusline(session, rng)


@prop
def view_of_disk():
    """hub-decisions-tested-at-the-module#P1 A hub unit's view and the rail are a function of what is on disk and the time.

    The world's sessions run, and open and close its pages, at times a fixed clock gives, and leave session pages,
    transcripts and statusline files behind them. The hub reads its view; then the disk changes under it, and the
    clock moves on. Read again, by the hub that read the disk before and by a hub loaded anew on the same state at
    the same time, the view is the same: nothing the hub keeps in memory from an earlier read changes what it shows.
    No session here runs in a tmux pane, so the handoff a unit offers is not among what is compared."""

    @checked(25)
    @given(worlds(), st.lists(STEP, min_size=1, max_size=12), st.lists(st.sampled_from(CHANGES), min_size=1, max_size=3),
           st.randoms(use_true_random=False))
    def same(world, steps, changes, rng):
        hub = fresh_hub()  # whose view is this world's alone
        placed = place(world, HOME)
        registry = running(placed, rng)
        lived(placed, rng)
        try:
            last: dict[int, tuple[str, str]] = {}
            for op, i, how, s in steps:
                hub.clock.tick()
                i, session = i % len(world.pages), placed.sessions[s % world.sessions]
                if op == "close" and i in last:
                    hub.close(*last[i])
                elif op == "open":
                    last[i] = hub.open(spell(placed, i, how if how != "served" else "path", None), session)
            first = hub.view()
            assert hub.view() == first, "the hub's view changed between two reads of the same disk at the same time"
            for what in changes:
                change(placed, registry, what, rng)
            hub.clock.tick(rng.randrange(1, 10**5))
            warm, cold = hub.view(), hub.restarted().view()
            assert warm == cold, (f"after {', '.join(changes)}, the hub that read the disk before shows otherwise than a hub loaded "
                                  f"anew:\n      read before {json.dumps(warm, sort_keys=True)}\n      loaded anew {json.dumps(cold, sort_keys=True)}")
        finally:
            for path in registry:
                path.unlink(missing_ok=True)

    same()


# --------------------------------------------------------------------------


def main(only: list[str]) -> int:
    # the hub's module runs in this process, so what it runs (git, tracker, curl) gets the scratch HOME's environment
    HOME.mkdir()
    tracker = SCRATCH / "bin" / "tracker"
    tracker.parent.mkdir()
    tracker.write_text(TRACKER)
    tracker.chmod(0o755)
    moved = base_env(HOME)
    moved["PATH"] = f"{tracker.parent}:{moved['PATH']}"
    os.environ.clear()
    os.environ.update(moved)
    failures = 0
    for p in PROPERTIES:
        title = " ".join(p.__doc__.split("\n\n")[0].split())
        if only and title.split()[0] not in only:
            continue
        try:
            with contextlib.redirect_stderr(io.StringIO()):  # what the hub prints on the way, as its log would hold it
                p()
        except Exception as e:
            failures += 1
            print(f"FAIL  {title}")
            print("".join("      " + row for row in "".join(traceback.format_exception(e)).splitlines(True)))
            continue
        print(f"ok    {title}")
    print()
    print("FAILED" if failures else "all ok")
    return 1 if failures else 0


if __name__ == "__main__":
    atexit.register(shutil.rmtree, SCRATCH, ignore_errors=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    sys.exit(main(sys.argv[1:]))
