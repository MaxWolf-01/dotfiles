#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Drive bin/vpn's decisions. Run it directly; no framework.

The cases fix what the tool decides from what tailscaled, the internet and
Vesktop tell it: what a status reading names, where a move goes, what a Discord
answer means, what tailscaled's engine updates say about a node, what the
watcher does on each look, and which exit-node changes end up in the node log.

Everything bin/vpn does not own reaches it through its ports. The pure functions
are called directly; the watcher, the moves and the commands run in the fake
World of tests/vpn_fakes.py, over a handful of Mullvad peers in tailscaled's
shape. The node lock, the run log and the state file are the real ones, in the
fakes' scratch directory.
"""

import contextlib
import fcntl
import io
import json
import os
import sys
import tempfile
from dataclasses import replace
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import vpn_fakes as fakes  # noqa: E402  (loads bin/vpn with its runtime files in a scratch directory)

vpn = fakes.vpn
OUT = sys.stdout
"""Where the checks report; what bin/vpn prints while a case runs is swallowed."""

failures = 0


def check(what, expected, actual):
    global failures
    if expected == actual:
        print(f"ok   {what}", file=OUT)
    else:
        print(f"FAIL {what}", file=OUT)
        print(f"       expected: {expected}", file=OUT)
        print(f"       actual:   {actual}", file=OUT)
        failures += 1


def peer(name, country, city, online=True):
    return {
        "ID": f"id-{name}",
        "HostName": name,
        "DNSName": f"{name}.mullvad.ts.net.",
        "Online": online,
        "ExitNode": False,
        "ExitNodeOption": True,
        "Location": {"Country": country, "City": city},
    }


# Out of order on purpose, so the sorting is visible. Frankfurt has a node after
# the current one, an offline one between, and one before it to wrap around to.
PEERS = [
    peer("de-fra-wg-202", "Germany", "Frankfurt"),
    peer("se-sto-wg-001", "Sweden", "Stockholm"),
    peer("de-fra-wg-401", "Germany", "Frankfurt"),
    peer("nl-ams-wg-001", "Netherlands", "Amsterdam"),
    peer("de-fra-wg-001", "Germany", "Frankfurt"),
    peer("de-fra-wg-203", "Germany", "Frankfurt", online=False),
    peer("ch-zrh-wg-001", "Switzerland", "Zurich"),
    peer("de-dus-wg-101", "Germany", "Dusseldorf"),
    peer("us-ash-wg-001", "USA", "Ashburn, VA"),
    peer("at-vie-wg-001", "Austria", "Vienna"),
    peer("de-ber-wg-001", "Germany", "Berlin"),
    peer("se-got-wg-001", "Sweden", "Gothenburg"),
]
LAPTOP = {"ID": "id-laptop", "HostName": "laptop", "DNSName": "laptop.tail0000.ts.net.",
          "Online": True, "ExitNode": False, "ExitNodeOption": False}


def status(exit_name=None, online=True):
    """A full status reading with `exit_name` as the exit node, or none."""
    peers = {p["ID"]: dict(p) for p in PEERS + [LAPTOP]}
    if exit_name is None:
        return {"BackendState": "Running", "Peer": peers, "ExitNodeStatus": None}
    peers[f"id-{exit_name}"]["ExitNode"] = True
    return {"BackendState": "Running", "Peer": peers, "ExitNodeStatus": {"ID": f"id-{exit_name}", "Online": online}}


NODES = vpn.mullvad_nodes(status())
by_name = {n.name: n for n in NODES}


def names(nodes):
    return [n.name for n in nodes]


# --- what a status reading names

check("a live node keeps its id and reads online",
      vpn.ExitState(True, "nodeABC", True),
      vpn.exit_state({"ExitNodeStatus": {"ID": "nodeABC", "Online": True}}))
# The branch that matters: an offline node must read as False, not as unknown,
# or the watcher never moves off a dead node -- the failure it exists to catch.
check("a dead node reads offline, not unknown",
      False, vpn.exit_state({"ExitNodeStatus": {"ID": "nodeABC", "Online": False}}).online)
check("the VPN off leaves the id empty", vpn.ExitState(True, "", None),
      vpn.exit_state({"ExitNodeStatus": None}))
check("tailscaled not answering is not the VPN off", vpn.ExitState(False, "", None), vpn.exit_state(None))
# Shape captured from the live daemon: the watcher reads status without peers.
check("a peerless reading still carries both fields",
      vpn.ExitState(True, "nMQ9SbK6Q721CNTRL", True),
      vpn.exit_state({"BackendState": "Running", "Peer": None,
                      "ExitNodeStatus": {"ID": "nMQ9SbK6Q721CNTRL", "Online": True,
                                         "TailscaleIPs": ["100.83.36.108/32"]}}))
check("a peerless reading names no exit peer", None, vpn.exit_peer({"Peer": None}))

check("only Mullvad exit nodes, by country, city and name",
      ["at-vie-wg-001", "de-ber-wg-001", "de-dus-wg-101", "de-fra-wg-001", "de-fra-wg-202",
       "de-fra-wg-203", "de-fra-wg-401", "nl-ams-wg-001", "se-got-wg-001", "se-sto-wg-001",
       "ch-zrh-wg-001", "us-ash-wg-001"],
      names(NODES))
check("the exit node a full reading names", "de-fra-wg-202", vpn.current_node(status("de-fra-wg-202")).name)
check("no exit node names nothing", None, vpn.current_node(status()))

# AutoExitNode is omitempty in tailscale's prefs, so its absence is a pin.
check("a node without AutoExitNode is pinned", "pinned", vpn.mode({"ExitNodeID": "id-x"}))
check("AutoExitNode set is automatic, whatever node it chose",
      "automatic", vpn.mode({"ExitNodeID": "id-x", "AutoExitNode": "any"}))
check("neither is off", "off", vpn.mode({"ExitNodeID": ""}))
check("no prefs is unknown, not off", "unknown", vpn.mode(None))

# --- places

check("a city", ["de-ber-wg-001"], names(vpn.resolve("Berlin", NODES)))
check("a country, in any case",
      ["de-ber-wg-001", "de-dus-wg-101", "de-fra-wg-001", "de-fra-wg-202", "de-fra-wg-203", "de-fra-wg-401"],
      names(vpn.resolve("germany", NODES)))
check("a node by short name", ["de-fra-wg-202"], names(vpn.resolve("de-fra-wg-202", NODES)))
check("a node by full name, trailing dot and all", ["de-fra-wg-202"],
      names(vpn.resolve("de-fra-wg-202.mullvad.ts.net.", NODES)))
check("a US city without its state", ["us-ash-wg-001"], names(vpn.resolve("Ashburn", NODES)))
check("and with it", ["us-ash-wg-001"], names(vpn.resolve("Ashburn, VA", NODES)))
check("a place with no node", [], vpn.resolve("Atlantis", NODES))

frankfurt = vpn.resolve("Frankfurt", NODES)
check("vpn to a city skips the node in use and the offline one",
      ["de-fra-wg-001", "de-fra-wg-401"], names(vpn.destinations("Frankfurt", frankfurt, by_name["de-fra-wg-202"])))
check("vpn to a node by name keeps it, offline or not",
      ["de-fra-wg-203"], names(vpn.destinations("de-fra-wg-203", [by_name["de-fra-wg-203"]], None)))
check("and in use or not",
      ["de-fra-wg-202"], names(vpn.destinations("de-fra-wg-202", [by_name["de-fra-wg-202"]], by_name["de-fra-wg-202"])))

# --- where a move goes

check("from Frankfurt: the rest of the city after it, wrapping, then the country, then the fallbacks",
      ["de-fra-wg-401", "de-fra-wg-001", "de-ber-wg-001", "de-dus-wg-101",
       "at-vie-wg-001", "ch-zrh-wg-001", "nl-ams-wg-001"],
      names(vpn.candidates(by_name["de-fra-wg-202"], NODES)))
check("the last node of a city wraps to its first",
      ["de-fra-wg-001", "de-fra-wg-202"], names(vpn.candidates(by_name["de-fra-wg-401"], NODES))[:2])
check("its own country comes before the fallbacks, wherever it is",
      ["se-got-wg-001", "de-ber-wg-001"], names(vpn.candidates(by_name["se-sto-wg-001"], NODES))[:2])
check("with no exit node, the fallback countries in order",
      ["de-ber-wg-001", "de-dus-wg-101", "de-fra-wg-001", "de-fra-wg-202", "de-fra-wg-401",
       "at-vie-wg-001", "ch-zrh-wg-001", "nl-ams-wg-001"],
      names(vpn.candidates(None, NODES)))

# `vpn next`, again and again: every online node of the city before any repeats.
visited, here = [], by_name["de-fra-wg-001"]
for _ in range(3):
    here = vpn.candidates(here, NODES)[0]
    visited.append(here.name)
check("repeated moves walk the whole city, skipping the offline node",
      ["de-fra-wg-202", "de-fra-wg-401", "de-fra-wg-001"], visited)

# --- what a Discord answer means

check("403 is a block", "blocked", vpn.verdict(403))
check("no answer says nothing about the node", "unreachable", vpn.verdict(0))
check("nor does Discord failing, from its first 5xx", ("unreachable", "clean"), (vpn.verdict(500), vpn.verdict(499)))
check("200 is clean", "clean", vpn.verdict(200))
check("a rate limit is not a block", "clean", vpn.verdict(429))

# --- the Vesktop gate: a symlink Electron holds while an instance is up

with tempfile.TemporaryDirectory() as gate:
    lock = Path(gate) / "SingletonLock"
    check("no lock means no instance", False, vpn.vesktop_running(lock))
    os.symlink(f"{os.uname().nodename}-{os.getpid()}", lock)
    check("a lock naming a live pid means running", True, vpn.vesktop_running(lock))
    # An unclean exit leaves the symlink behind. pid_max itself is the one number
    # the allocator never hands out.
    lock.unlink()
    os.symlink(f"host-{Path('/proc/sys/kernel/pid_max').read_text().strip()}", lock)
    check("a lock naming a dead pid is stale, not running", False, vpn.vesktop_running(lock))
    lock.unlink()
    os.symlink("host-", lock)
    check("a lock naming no pid is not running", False, vpn.vesktop_running(lock))
    lock.unlink()
    lock.mkdir()
    check("a plain directory where the lock goes is not an instance", False, vpn.vesktop_running(lock))

# --- the heartbeat

guarding = status("de-fra-wg-202")
check("guarding a live node is ok and names it",
      ("ok", "", {"state": "guarding", "exit_node": "de-fra-wg-202", "vesktop": True, "bus": True}),
      vpn.heartbeat(guarding, "de-fra-wg-202", 2, True, True))
check("the VPN off is ok", "no-exit-node", vpn.heartbeat(status(), None, 2, False, True)[2]["state"])
check("and stays ok with no engine update for hours", "ok", vpn.heartbeat(status(), None, 7200, False, False)[0])
check("tailscaled down is ok", ("ok", "tailscale-down"),
      (lambda o, _, s: (o, s["state"]))(*vpn.heartbeat(None, None, 7200, False, False)))
# The failure only this line can show: an exit node set and no engine update,
# so the watcher sees none of its traffic and can call nothing silent.
check("an exit node set with no engine update for 60 s fails, as blind",
      ("ok", "fail"), (vpn.heartbeat(guarding, "de-fra-wg-202", 60, True, True)[0],
                       vpn.heartbeat(guarding, "de-fra-wg-202", 61, True, False)[0]))

# --- what the dot shows: what prefs ask for against what status delivers

ON = {"WantRunning": True, "ExitNodeID": "id-de-fra-wg-202"}
OFF = {"WantRunning": True, "ExitNodeID": ""}

check("no exit node asked for is off", ("off", ""), vpn.vpn_state(OFF, status(), False))
check("tailscale stopped is off, whatever node the prefs still name",
      ("off", "tailscale is stopped"), vpn.vpn_state(ON | {"WantRunning": False}, status(), False))
check("a node asked for and working is up", ("up", ""), vpn.vpn_state(ON, status("de-fra-wg-202"), False))
# 2026-08-16: Tailnet Lock dropped every peer, and the exit node with them,
# while the prefs still named it. That was an outage, not the VPN off.
check("a node asked for and missing from status is down, not off",
      ("down", "no exit node in the network map"), vpn.vpn_state(ON, status(), False))
check("a node reporting itself offline is down",
      ("down", "the node reports itself offline"), vpn.vpn_state(ON, status("de-fra-wg-202", online=False), False))
check("a silent node is down", ("down", "the node stopped answering"),
      vpn.vpn_state(ON, status("de-fra-wg-202"), True))
check("tailscale not running while a node is asked for is down", ("down", "tailscale is NeedsLogin"),
      vpn.vpn_state(ON, status("de-fra-wg-202") | {"BackendState": "NeedsLogin"}, False))
check("tailscaled not answering is unknown, not off",
      [("unknown", "tailscaled does not answer")] * 2, [vpn.vpn_state(None, None, False),
                                                        vpn.vpn_state(ON, None, False)])

# --- silence, on engine updates 2 s apart: a live WireGuard peer answers any
# data within 10 s, with an empty keepalive if it has nothing else to send, and
# nothing answers a keepalive

EXIT = {
    "Peer": {
        "id-a": {"ID": "id-a", "PublicKey": "nodekey:a", "HostName": "a", "ExitNode": True},
        "id-b": {"ID": "id-b", "PublicKey": "nodekey:b", "HostName": "b", "ExitNode": False},
    },
    "ExitNodeStatus": {"ID": "id-a", "Online": True},
}


def engine(peers):
    """An engine update with these (key, received, sent)."""
    return fakes.notify(Engine={"LivePeers": {k: {"NodeKey": k, "RxBytes": rx, "TxBytes": tx,
                                                  "LastHandshake": "2026-09-24T12:00:00+02:00"}
                                              for k, rx, tx in peers}})


def silent_after(readings, times=None):
    """Feed one engine update per reading, 2 s apart unless `times` says otherwise:
    (received, sent) from the exit node a, ("b", received, sent) with b as the
    exit node from then on, or None for an update the exit node is missing
    from. Whether the exit node counts as silent after each."""
    now = [1_000_000.0]
    live = vpn.Liveness(vpn.Clock(now=lambda: now[0], wait=lambda secs: None))
    live.learn(EXIT)
    seen = []
    for i, reading in enumerate(readings):
        now[0] = 1_000_000.0 + (times[i] if times else 2 * i)
        if reading and reading[0] == "b":
            b = json.loads(json.dumps(EXIT))
            b["Peer"]["id-a"]["ExitNode"], b["Peer"]["id-b"]["ExitNode"] = False, True
            b["ExitNodeStatus"]["ID"] = "id-b"
            live.learn(b)
            live.feed(engine([("nodekey:b", *reading[1:])]))
        else:
            live.feed(engine([("nodekey:a", *reading)] if reading else []))
        seen.append(live.silent())
    return seen


rising = [(100, 1000 + 100 * i) for i in range(12)]
check("traffic in with nothing back turns silent 20 s after the update that first saw it",
      [False] * 11 + [True], silent_after(rising))
check("anything coming back ends it", [False] * 11 + [True, False], silent_after(rising + [(132, 2300)]))
check("a reply within the 10 s WireGuard allows is never silence", [False] * 21,
      silent_after([(100 + 700 * (i // 5), 1000 + 100 * i) for i in range(21)]))
check("keepalives alone, one an update, are never silence", [False] * 16,
      silent_after([(100, 1000 + 32 * i) for i in range(16)]))
check("but three in one update is traffic", [False] * 11 + [True],
      silent_after([(100, 1000)] + [(100, 1096)] * 11))
check("an idle tunnel is not silent", [False] * 16, silent_after([(100, 1000)] * 16))
check("a new exit node starts over", [False] * 13,
      silent_after(rising[:10] + [("b", 0, 900), ("b", 0, 1000), ("b", 0, 1100)]))
# tailscaled drops a peer that went idle and adds it back with fresh counters.
check("counters starting again from zero, still with nothing back, keep the silence",
      [False] * 11 + [True], silent_after([(500, 5000), (500, 6000)] + [(0, 300 * i) for i in range(1, 11)]))
check("and with something back, end it", [False] * 12,
      silent_after([(500, 5000), (500, 6000)] + [(40, 300 * i) for i in range(1, 11)]))
check("an exit node missing from an update sent and received nothing, so the count goes on",
      [False] * 11 + [True], silent_after([(100, 1000), (100, 1500)] + [None] * 10))
check("one missing from the start is never silent", [False] * 12, silent_after([None] * 12))
HOURS_8 = 8 * 3600
check("a suspend is not time unanswered: the count starts over after it",
      [False] * 4 + [False] * 11 + [True],
      silent_after([(100, 1000 + 100 * i) for i in range(4)] + [(100, 2000 + 100 * i) for i in range(12)],
                   times=[0, 2, 4, 6] + [HOURS_8 + 2 * i for i in range(12)]))

now = [1_000_000.0]
live = vpn.Liveness(vpn.Clock(now=lambda: now[0], wait=lambda secs: None))
live.learn(EXIT)
verdicts = []
for i, t in enumerate([*range(0, 24, 2), 33, 34]):
    now[0] = 1_000_000.0 + t
    if t != 33:
        live.feed(engine([("nodekey:a", 100, 1000 + 100 * i)]))
    verdicts.append(live.silent())
check("with no engine update for 10 s there is no verdict, and the count goes on once they come back",
      [False] * 11 + [True, False, True], verdicts)

# --- which exit-node changes a vpn line accounts for

SINCE = datetime.fromisoformat("2026-09-14T12:00:00+02:00").timestamp()


def line(event, node=None, to=None, offset=10.0):
    return {"ts": datetime.fromtimestamp(SINCE + offset).astimezone().isoformat(),
            "stats": {"event": event, "node": node, "rotated_to": to}}


def accounts(record, node):
    return vpn.explains(record, node, SINCE)


check("a pin accounts for the node it pinned, not the one it left or another",
      (True, False, False), (accounts(line("pinned", "a", "b"), "b"),
                             accounts(line("pinned", "a", "b"), "a"), accounts(line("pinned", "a", "b"), "c")))
check("so does a rotation", (True, False), (accounts(line("rotated", "a", "b"), "b"), accounts(line("rotated", "a", "b"), "a")))
check("and a move off a dead node", (True, False), (accounts(line("offline", "a", "b"), "b"), accounts(line("offline", "a", "b"), "a")))
check("a clean check accounts for the node it checked, only",
      (True, False), (accounts(line("clean", "a"), "a"), accounts(line("clean", "a"), "b")))
check("automatic mode from a pin accounts for the node it picked, not the pin",
      (True, False), (accounts(line("clean", "a", "b"), "b"), accounts(line("clean", "a", "b"), "a")))
check("off accounts for no exit node, only", (True, False), (accounts(line("off", "a"), None), accounts(line("off", "a"), "a")))
check("a change to no exit node accounts for none", True, accounts(line("changed", "a", None), None))
check("giving up accounts for wherever automatic mode went", True, accounts(line("exhausted", "a"), "z"))
check("an event vpn does not write accounts for nothing", False, accounts(line("teleported", "a", "b"), "b"))
check("a line from before the last comparison accounts for nothing", False, accounts(line("pinned", "a", "b", -5), "b"))
check("one inside its timestamp's second still does", True, accounts(line("pinned", "a", "b", -0.5), "b"))
check("no line accounts for nothing", False, accounts(None, "b"))
check("nor does one with an unreadable time", False, accounts({"ts": "yesterday", "stats": {}}, "b"))




# --- the bus reader: it hands every message over, opens a closed stream again
# every 5 s, and closes one that carries no engine update for 10 s

E = fakes.notify(Engine={"LivePeers": {}})
P = fakes.notify(Prefs={"ExitNodeID": ""})


class Done(Exception):
    pass


def follow(streams):
    """follow_bus over one stream per opening, each (messages, end): the
    messages as (seconds after the one before, message), and how the stream
    ends, None for closing or an exception it raises. Returns the messages
    handed over, the sleeps, the openings closed again, and what it printed."""
    t = [0.0]
    handed, sleeps, closed = [], [], []

    def bus(mask):
        i = len(sleeps)
        if i >= len(streams):
            raise Done
        items, end = streams[i]
        try:
            for secs, message in items:
                t[0] += secs
                yield message
            if end is not None:
                raise end
        finally:
            closed.append(i)

    printed = io.StringIO()
    with contextlib.redirect_stdout(printed):
        try:
            vpn.follow_bus(bus, vpn.WATCH_MASK, handed.append, sleeps.append, lambda: t[0])
        except Done:
            pass
    return handed, sleeps, closed, printed.getvalue().splitlines()


handed, sleeps, closed, _ = follow([([(0, E), (2, P), (2, E)], None), ([(2, E)], None)])
check("the bus reader hands every message over, in order", [E, P, E, E], handed)
check("and opens a closed stream again 5 s later, every time", ([5, 5], [0, 1]), (sleeps, closed))
handed, sleeps, closed, _ = follow([([(0, E), (4, P), (4, P), (4, P), (4, E)], None)])
check("a stream that carries no engine update for 10 s is closed, and opened again 5 s later",
      ([E, P, P, P], [0], [5]), (handed, closed, sleeps))
handed, sleeps, closed, printed = follow([([(0, E)], TimeoutError("timed out")), ([], OSError("refused")),
                                          ([(0, E)], None)])
check("so is one that sends nothing for 10 s, which tailscaled's socket reports as a timeout", [5, 5, 5], sleeps)
check("losing the bus is printed once per outage, getting it back once",
      (2, 1), (sum("event bus lost" in line for line in printed), sum("connected again" in line for line in printed)))



# --- the watcher, the moves and the commands, in a fake World


HOSTS = [fakes.Host(p["HostName"], p["Location"]["Country"], p["Location"]["City"], online=p["Online"])
         for p in PEERS]
EVERYTHING = frozenset(h.name for h in HOSTS)
EGRESS_ASKED = [0]
"""How often anything but `vpn status` asked am.i.mullvad.net: never, since the traffic proof replaced it."""


def world(exit_name="de-fra-wg-202", *, automatic=False, blocked=(), dead=(), offline=(), mute=(),
          vesktop=True, auto_pick="de-fra-wg-001"):
    """The fake network of PEERS, the exit node pinned to `exit_name` (or on automatic mode, or off for
    None). `dead` nodes answer nothing, `mute` ones carry traffic but Discord does not answer through them."""
    hosts = [replace(h, blocked=h.name in blocked, answers=h.name not in dead, carries=h.name not in dead,
                     online=h.online and h.name not in offline, discord_silent=h.name in mute) for h in HOSTS]
    setting = ("off", None) if exit_name is None else ("automatic" if automatic else "pinned", exit_name)
    wd = fakes.World(hosts, setting, auto_pick=auto_pick, vesktop=vesktop)
    egress = wd.ports.network.egress

    def asked():
        EGRESS_ASKED[0] += 1
        return egress()

    wd.ports = replace(wd.ports, network=replace(wd.ports.network, egress=asked))
    return wd


def watcher(wd):
    return fakes.Watcher(wd)


def run(watching, secs):
    """Run the watcher to `secs` into its World: to the first moment it is idle at or after `secs`, which with
    engine updates every 2 s is `secs` itself when that is even."""
    with contextlib.redirect_stdout(io.StringIO()):
        watching.until(secs)
    return watching


def command(wd, fn, *args):
    """Run a command's body in the World; its error message, or None when it succeeded."""
    with contextlib.redirect_stdout(io.StringIO()), fakes.driving(wd):
        try:
            fn(*args, wd.ports)
        except vpn.VpnError as e:
            return str(e)
    return None


def at(wd, secs, happening):
    wd.when(fakes.At(secs), happening)


def records(wd):
    path = wd.runs / f"{vpn.NODE_UNIT}.jsonl"
    return [json.loads(text) for text in path.read_text().splitlines()] if path.exists() else []


def events(wd):
    return [r["stats"]["event"] for r in records(wd)]


def last(wd):
    return records(wd)[-1]["stats"]


def beats(wd):
    path = wd.runs / f"{vpn.WATCH_UNIT}.jsonl"
    return [json.loads(text) for text in path.read_text().splitlines()] if path.exists() else []


def sets(wd):
    return [e.what for e in wd.entries if e.kind == "set"]


def discords(wd):
    """The Discord checks run: (seconds in, the node they went through)."""
    return [(round(e.t - fakes.T0, 2), e.state[1]) for e in wd.entries if e.kind == "discord"]


def shown():
    """What the dot would show: the state file, or None where there is none."""
    return json.loads(vpn.STATE_FILE.read_text()) if vpn.STATE_FILE.exists() else None


def since(secs):
    return datetime.fromtimestamp(fakes.T0 + secs).astimezone().isoformat(timespec="seconds")


# --- the watcher's looks

wd = world(vesktop=False)
run(watcher(wd), 5)
check("Vesktop closed: a new node is not checked", [], discords(wd))

wd = world(vesktop=False)
watching = run(watcher(wd), 5)
wd.vesktop = True
run(watching, 20)
check("Vesktop opening on a node nobody checked checks it at the next look, 10 s at most",
      [(10.0, "de-fra-wg-202")], discords(wd))

wd = world()
watching = run(watcher(wd), 590)
early = len(discords(wd))
run(watching, 615)
check("a node that passed is not checked again within 600 s", 1, early)
check("and is after", 2, len(discords(wd)))

# Cloudflare can start blocking a node while Vesktop is closed, and Vesktop
# opening sends nothing on the bus.
wd = world()
watching = run(watcher(wd), 5)
wd.vesktop = False
run(watching, 15)
wd.vesktop = True
run(watching, 30)
check("Vesktop reopening checks the node again, even one that passed", 2, len(discords(wd)))

wd = world(blocked={"de-fra-wg-202"})
run(watcher(wd), 100)
check("a 403 is checked a second time, 45 s later, before anything moves",
      [(0.0, "de-fra-wg-202"), (45.2, "de-fra-wg-202")], [(round(t, 1), n) for t, n in discords(wd)[:2]])
check("a confirmed block turns on automatic mode", ("automatic", "de-fra-wg-001"), wd.setting())
check("and checks Tailscale's pick", "de-fra-wg-001", discords(wd)[-1][1])
check("and records the rotation", ("rotated", "de-fra-wg-202", "de-fra-wg-001"),
      (last(wd)["event"], last(wd)["node"], last(wd)["rotated_to"]))

wd = world(blocked={"de-fra-wg-202"}, auto_pick="de-fra-wg-202")
run(watcher(wd), 200)
check("when automatic mode picks the blocked node again, the clean node next to it is pinned",
      ("pinned", "de-fra-wg-401"), wd.setting())
check("and recorded as the rotation", ("rotated", "de-fra-wg-202", "de-fra-wg-401"),
      (last(wd)["event"], last(wd)["node"], last(wd)["rotated_to"]))

wd = world(mute={"de-fra-wg-202"})
run(watcher(wd), 30)
check("no Discord answer while the node carries traffic stays put", (("pinned", "de-fra-wg-202"), []),
      (wd.setting(), events(wd)))

wd = world(dead={"de-fra-wg-202"})
run(watcher(wd), 30)
check("no Discord answer and no traffic through the node turns on automatic mode",
      (("automatic", "de-fra-wg-001"), ["offline"]), (wd.setting(), events(wd)))

wd = world(offline={"de-fra-wg-202"}, vesktop=False)
run(watcher(wd), 30)
check("a node reporting itself offline turns on automatic mode, Vesktop closed or not",
      (("automatic", "de-fra-wg-001"), ["offline"]), (wd.setting(), events(wd)))
check("without the Discord check while Vesktop is closed", [], discords(wd))

wd = world(offline={"de-fra-wg-202"}, dead=EVERYTHING)
run(watcher(wd), 30)
check("with the network down, a recovery stops at automatic mode and tries no nodes", ["auto:any"], sets(wd))
check("and records the network as the problem", ["unreachable"], events(wd))

wd = world(blocked=EVERYTHING)
watching = run(watcher(wd), 5)
wd.vesktop = False
run(watching, 700)
check("when every node tried is blocked, automatic mode", "automatic", wd.mode)
check("recorded once, and not again as a change outside vpn after the back-off", ["exhausted"], events(wd))

wd = world(blocked={"de-fra-wg-202"})
at(wd, 10, fakes.Outside("de-fra-wg-401.mullvad.ts.net"))
run(watcher(wd), 60)
check("a 403 confirmed after the node changed moves nothing: the change is recorded as made outside",
      (("pinned", "de-fra-wg-401"), ["changed"]), (wd.setting(), events(wd)))
check("and the new node is checked a second later", ("de-fra-wg-401", True),
      (discords(wd)[2][1], discords(wd)[2][0] - discords(wd)[1][0] <= 1.5))

wd = world(None)
run(watcher(wd), 700)
check("no exit node set: nothing checked, nothing moved, even past a re-check", ([], [], []),
      (discords(wd), sets(wd), events(wd)))

wd = world()
wd.down = True
run(watcher(wd), 40)
check("tailscaled not answering: nothing is acted on", ([], []), (discords(wd), sets(wd)))
check("and it looks every 15 s", [0, 15, 30], wd.looked)

wd = world(vesktop=False)
at(wd, 5, fakes.Outside("de-fra-wg-401.mullvad.ts.net"))
watching = run(watcher(wd), 4)
first = events(wd)
run(watching, 20)
check("the first look records no change: there is no before", [], first)
check("a change something else made is recorded", [("changed", "de-fra-wg-202", "de-fra-wg-401")],
      [(r["stats"]["event"], r["stats"]["node"], r["stats"]["rotated_to"]) for r in records(wd)])

wd = world(vesktop=False)
watching = run(watcher(wd), 1)
command(wd, vpn.go_next)
run(watching, 30)
check("a move vpn made is recorded once, by vpn", ["pinned"], events(wd))

wd = world(vesktop=False)
at(wd, 5, fakes.Outside(""))
run(watcher(wd), 20)
check("the exit node turned off from outside is a change to none", [("changed", None)],
      [(r["stats"]["event"], r["stats"]["rotated_to"]) for r in records(wd)])

wd = world(vesktop=False)
at(wd, 5, fakes.Outside("de-fra-wg-401.mullvad.ts.net"))
watching = run(watcher(wd), 1)
with open(vpn.LOCKFILE, "a") as held:
    fcntl.flock(held, fcntl.LOCK_EX)
    looks_before = len(wd.looked)
    run(watching, 8)
    while_held = events(wd)
    looks_while = [t for t in wd.looked[looks_before:] if t > 5]
    fcntl.flock(held, fcntl.LOCK_UN)
run(watching, 20)
check("a change while a vpn command holds the lock is left to that command", [], while_held)
check("and looked at again a second later", True, len(looks_while) >= 2 and looks_while[1] - looks_while[0] <= 1.01)
check("once the lock is free and no vpn line accounts for it, it is recorded", ["changed"], events(wd))

wd = world(vesktop=False)
run(watcher(wd), 3605)
check("the heartbeat is written on the first look and then hourly", ["ok", "ok"], [b["outcome"] for b in beats(wd)])

wd = world(vesktop=False)
wd.when(fakes.At(3500), fakes.Quiet(200))
run(watcher(wd), 3605)
check("the heartbeat fails when an exit node is set and no engine update came for over 60 s",
      ["ok", "fail"], [b["outcome"] for b in beats(wd)])

# --- what the watcher reads

wd = world()
watching = run(watcher(wd), 700)
check("the watcher reads the full status once, at start, however long the exit node stays", 1, wd.status_reads)

wd = world()
at(wd, 100, fakes.Outside("de-fra-wg-401.mullvad.ts.net"))
run(watcher(wd), 700)
check("and again when the exit node changes", 2, wd.status_reads)

wd = world(vesktop=False)
watching = run(watcher(wd), 100)
newcomer = fakes.Host("de-fra-wg-999", "Germany", "Frankfurt")
wd.hosts[newcomer.name] = newcomer
wd.handshake[newcomer.name] = wd.now
run(watching, 200)
after_newcomer = wd.status_reads
wd.handshake["stranger"] = wd.now
run(watching, 400)
check("and when an engine update carries a peer it does not know", 2, after_newcomer)
check("once only, even for a peer no status reading lists", 3, wd.status_reads)

# --- what the watcher publishes for the dot

wd = world(vesktop=False)
run(watcher(wd), 12)
check("a working node is published up, with where it is and how it was chosen",
      {"state": "up", "reason": "", "mode": "pinned", "node": "de-fra-wg-202", "city": "Frankfurt",
       "country": "Germany", "since": since(0)}, shown())

wd = world(vesktop=False)
at(wd, 5, fakes.Outside("de-ber-wg-001.mullvad.ts.net"))
run(watcher(wd), 12)
check("a move from one working node to another keeps the time it has been up",
      ("de-ber-wg-001", "Berlin", since(0)), (shown()["node"], shown()["city"], shown()["since"]))

wd = world(None)
run(watcher(wd), 5)
check("no exit node is published off", ("off", None, "off"), (shown()["state"], shown()["node"], shown()["mode"]))

wd = world()
wd.down = True
run(watcher(wd), 5)
check("tailscaled not answering is published unknown", ("unknown", "tailscaled does not answer"),
      (shown()["state"], shown()["reason"]))


def silence_lines(wd):
    return [(r["outcome"], r["stats"]["event"], r["stats"]["node"], r["stats"]["secs"]) for r in records(wd)]


def dot():
    return shown()["state"], shown()["reason"], shown()["since"]


# 202 dies at 5 s. The update at 6 s is the first to see traffic go in with
# nothing back; 20 s later, at 26 s, the node is silent. It comes back at 51 s,
# and the update at 52 s carries its reply.
wd = world(vesktop=False)
at(wd, 5, fakes.Dies("de-fra-wg-202"))
at(wd, 51, fakes.Revives("de-fra-wg-202"))
watching = watcher(wd)
seen = [dot() for secs in (24, 28, 50, 54) if run(watching, secs)]
check("a node that stops answering goes down 20 s after the update that saw it, and back up once it answers",
      [("up", "", since(0)), ("down", "the node stopped answering", since(26)),
       ("down", "the node stopped answering", since(26)), ("up", "", since(52))], seen)
check("the silence is one node-log line, lasting from that update to the last that found it silent",
      [("ok", "silent", "de-fra-wg-202", 44)], silence_lines(wd))
check("and moves nothing", [], sets(wd))

# The same, with tailscaled pushing nothing from 31 s to 71 s, as across a
# suspend: the stream counts as closed from 40 s, and the first update after
# the gap, at 72 s, starts the count over.
wd = world(vesktop=False)
at(wd, 5, fakes.Dies("de-fra-wg-202"))
at(wd, 31, fakes.Quiet(40))
watching = watcher(wd)
seen = [dot()[0] for secs in (44, 74, 92, 96) if run(watching, secs)]
check("no silence verdict is published while the stream is closed", "up", seen[0])
check("a silence the stream went quiet in ends at the last update before the gap",
      [("ok", "silent", "de-fra-wg-202", 24)], silence_lines(wd)[:1])
check("and the count starts over after it", ["up", "up", "up", "down"], seen)

wd = world(vesktop=False)
watching = run(watcher(wd), 1)
command(wd, vpn.go_next)
with fakes.driving(wd):
    vpn.log_node("ok", "silent", "watch", "de-fra-wg-401", reason="de-fra-wg-401 answered nothing for at least 30 s", secs=30)
run(watching, 20)
check("a silent line written after a move does not hide the move from the watcher", ["pinned", "silent"], events(wd))

wd = world(vesktop=False, offline={"de-fra-wg-001"})
at(wd, 5, fakes.Outside("auto:any"))
watching = run(watcher(wd), 1)
with open(vpn.LOCKFILE, "a") as held:
    fcntl.flock(held, fcntl.LOCK_EX)
    run(watching, 8)
    while_held = shown()["state"]
    fcntl.flock(held, fcntl.LOCK_UN)
check("nothing is published while a vpn command is changing the exit node", "up", while_held)

# The recovery that fails, then looks during its back-off.
wd = world(offline=EVERYTHING, dead=EVERYTHING, vesktop=False)
watching = run(watcher(wd), 10)
after_first = sets(wd)
run(watching, 60)
during = (sets(wd), shown()["state"])
run(watching, 320)
check("after a failed recovery, no other starts for 5 minutes", (["auto:any"], ["auto:any"]), (after_first, during[0]))
check("while the dot keeps following", "down", during[1])
check("and one starts after", ["auto:any", "auto:any"], sets(wd))

wd = world(vesktop=False)
run(watcher(wd), 31)
check("an exit node set: the watcher looks every 10 s, and in between only takes in engine updates",
      [0, 10, 20, 30], wd.looked)
wd = world(None)
run(watcher(wd), 100)
check("no exit node and the engine updates coming: nothing is due before the hourly heartbeat", [0], wd.looked)
wd = world(None)
wd.quiet_until = fakes.T0 + 1000
run(watcher(wd), 50)
check("no engine update: it looks every 15 s", [0, 15, 30, 45], wd.looked[:4])
wd = world(None)
wd.when(fakes.At(21), fakes.Quiet(1000))
run(watcher(wd), 50)
check("and notices a stream going quiet within about 10 s of its last update", True,
      len(wd.looked) >= 3 and wd.looked[1] <= 20 + vpn.STALE_SECS + 0.5 and wd.looked[2] - wd.looked[1] == 15)

# --- the traffic proof and the handshake probe, as a move uses them


def proof(wd, name):
    """Set the exit node to `name` and run the traffic proof on it. Whether it passed, and how long it took."""
    by_name = fakes.nodes(wd)
    with fakes.driving(wd):
        live = vpn.Liveness(wd.ports.clock)
        vpn.tune_in(live, wd.status())
        wd.ports.tailscaled.set_exit_node(by_name[name].fqdn)
        began = wd.now
        passed = vpn.traffic_proof(by_name[name], live, wd.ports)
    return passed, round(wd.now - began, 2)


passed, secs = proof(world(None), "de-ber-wg-001")
check("the traffic proof confirms a node that carries traffic by the next engine update", (True, True),
      (passed, secs <= vpn.ENGINE_SECS + 0.2))
check("and fails one that does not in 5 s", (False, 5.0), proof(world(None, dead={"de-ber-wg-001"}), "de-ber-wg-001"))
leaky = world(None)
leaky.hosts["de-ber-wg-001"] = replace(leaky.hosts["de-ber-wg-001"], carries=False, leaks=True)
check("a connect that answered with no bytes back from the node is no proof", (False, 5.0), proof(leaky, "de-ber-wg-001"))

wd = world(vesktop=False, dead={"de-fra-wg-401"})
answered = fakes.probe(wd, ["de-fra-wg-001", "de-fra-wg-401", "de-ber-wg-001"])
check("the handshake probe names the nodes that answer, within the probe window, and moves nothing",
      (["de-fra-wg-001", "de-ber-wg-001"], ("pinned", "de-fra-wg-202"), True),
      (answered, wd.setting(), wd.now - fakes.T0 <= vpn.PROBE_SECS))

# --- the commands

wd = world(blocked={"de-fra-wg-401"})
command(wd, vpn.go_next)
check("vpn next skips a node Cloudflare blocks", "de-fra-wg-001", wd.exit)
check("and records where it went, from where, and how many it tried",
      {"event": "pinned", "command": "next", "node": "de-fra-wg-202", "rotated_to": "de-fra-wg-001", "tried": 2},
      last(wd))

wd = world(blocked=EVERYTHING)
error = command(wd, vpn.go_next)
check("vpn next finding nothing puts the pinned node back", ("pinned", "de-fra-wg-202"), wd.setting())
check("and fails, saying so", ("exhausted", True), (last(wd)["event"], error is not None))

wd = world(blocked=EVERYTHING, automatic=True)
command(wd, vpn.go_next)
check("from automatic mode, it goes back to automatic mode", ("automatic", "auto:any"), (wd.mode, sets(wd)[-1]))

wd = world(dead=EVERYTHING)
command(wd, vpn.go_next)
check("vpn next with the network down gives up after two silent nodes and puts the node back",
      (3, ("pinned", "de-fra-wg-202")), (len(sets(wd)), wd.setting()))
check("recording the network as the problem", "unreachable", last(wd)["event"])

wd = world()
command(wd, vpn.go_to, "Berlin")
check("vpn to a city pins its node", (("pinned", "de-ber-wg-001"), "to"), (wd.setting(), last(wd)["command"]))

wd = world()
error = command(wd, vpn.go_to, "Atlantis")
check("vpn to a place with no node fails without touching the exit node", (True, [], []),
      (error is not None, sets(wd), events(wd)))

wd = world()
command(wd, vpn.turn_on)
check("vpn on from a pin records both nodes",
      {"event": "clean", "command": "on", "node": "de-fra-wg-202", "rotated_to": "de-fra-wg-001", "tried": 0},
      last(wd))

wd = world(blocked={"de-fra-wg-001"})
command(wd, vpn.turn_on)
check("vpn on walks off automatic mode's blocked pick to the node next to it",
      ("pinned", "de-fra-wg-202"), wd.setting())
check("and records the rotation", ("rotated", "de-fra-wg-001", "de-fra-wg-202"),
      (last(wd)["event"], last(wd)["node"], last(wd)["rotated_to"]))

wd = world(dead={"de-fra-wg-001"})
error = command(wd, vpn.turn_on)
check("vpn on whose pick carries nothing fails, saying egress never reached Mullvad",
      (True, "unreachable"), (bool(error) and "never reached Mullvad" in error, last(wd)["event"]))

wd = world()
command(wd, vpn.turn_off)
check("vpn off drops the exit node and records the node it left",
      (None, "off", "de-fra-wg-202"), (wd.exit, last(wd)["event"], last(wd)["node"]))

wd = world(None)
command(wd, vpn.turn_on)
check("vpn on from off turns it on", ("automatic", "de-fra-wg-001"), wd.setting())

wd = world(None)
wd.running = False
error = command(wd, vpn.turn_on)
check("vpn on with tailscale stopped changes nothing and says why",
      ([], [], "tailscale is stopped: `tailscale up` first"), (sets(wd), events(wd), error))

# The dot's click turns the VPN off with a bare `tailscale set`, which does not
# wait for a vpn command's walk to finish.
wd = world(blocked={"de-fra-wg-401"})
wd.when(fakes.AfterStep(1, "discord"), fakes.Outside(""))
error = command(wd, vpn.go_next)
check("a walk that finds the VPN turned off under it leaves it off", (None, ["de-fra-wg-401.mullvad.ts.net"]),
      (wd.exit, sets(wd)))
check("and fails saying so", True, bool(error) and "turned off" in error)

check("no move and no look asked am.i.mullvad.net; the traffic proof stands in for it", 0, EGRESS_ASKED[0])

print(file=OUT)
print("FAILED" if failures else "all ok", file=OUT)
sys.exit(1 if failures else 0)
