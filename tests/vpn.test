      (1, "vpn: cancelled; the exit node is back on de-fra-wg-202", ("pinned", "de-fra-wg-202"),
       [("cancelled", "next", "de-fra-wg-202", None)]), (status, err, wd.setting(), moved(wd)))



def ask_pressing(presses, answer_after=0.5):
    """`vpn.ask` in this process against a watcher that answers `answer_after` seconds after the command hung
    up, with Ctrl-C pressed at each of `presses` seconds. How it ended, and whether the watcher saw it hang up."""
    path = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH)) / "vpn.sock"
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    server.listen(1)
    hung_up = threading.Event()

    def watcher():
        conn, _ = server.accept()
        with conn:
            conn.makefile("rb").readline()
            while conn.recv(1024):
                pass
            hung_up.set()
            time.sleep(answer_after)
            with contextlib.suppress(OSError):
                conn.sendall(b'{"ok": false, "message": "cancelled; the exit node is back off"}\n')

    threading.Thread(target=watcher, daemon=True).start()
    timers = [threading.Timer(secs, os.kill, (os.getpid(), signal.SIGINT)) for secs in presses]
    for timer in timers:
        timer.start()
    try:
        vpn.ask("next", path=path)
        how = "ok"
    except vpn.VpnError as e:
        how = str(e)
    except SystemExit as e:
        how = f"exit {e.code}"
    finally:
        server.close()
    assert not any(timer.is_alive() for timer in timers), "a press came after the command ended"
    return how, hung_up.is_set()


# `uv run`, as bin/vpn's shebang runs it, can pass on a press the terminal also delivered.
check("Ctrl-C at a command hangs up and waits for the watcher's last line, and a press that arrives twice is one",
      ("cancelled; the exit node is back off", True), ask_pressing([0.1, 0.2]))
check("a second Ctrl-C leaves at once", ("exit 130", True),
      ask_pressing([0.1, 0.1 + 2 * vpn.CTRL_C_ECHO_SECS], answer_after=5))
check("and ends the command's hold on Ctrl-C", signal.default_int_handler, signal.getsignal(signal.SIGINT))

wd = world(inert={"de-fra-wg-401", "de-fra-wg-001"}, vesktop=False)
paced = Paced(wd, scale=0.2)
proc = paced.command("next")
read_until(proc, "trying de-fra-wg-401")
proc.kill()
proc.communicate(timeout=60)
deadline = time.monotonic() + 30
while time.monotonic() < deadline and not events(wd):
    time.sleep(0.1)
paced.stop()
check("a command that dies without a word cancels its request all the same",
      (("pinned", "de-fra-wg-202"), ["cancelled"]), (wd.setting(), events(wd)))

wd = world(vesktop=False)
paced = Paced(wd)
with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as raw:
    raw.connect(str(paced.dir / "vpn.sock"))
    raw.sendall(b'{"request": "sideways"}\n')
    answer = json.loads(raw.makefile("r").readline())
try:
    vpn.listen(paced.dir / "vpn.sock", lambda arrival: None)
    second_watcher = None
except vpn.VpnError as e:
    second_watcher = str(e)
paced.stop()
check("a request the watcher does not understand gets a final line saying so", (False, True),
      (answer["ok"], answer["message"].startswith("not a request vpn understands")))
check("and a second watcher refuses to take over a socket the first still answers on", True,
      (second_watcher or "").startswith("another vpn watch already takes requests"))

check("no move and no look asks am.i.mullvad.net", 0, sum(w.egress_asks for w in WORLDS))

print(file=OUT)
print("FAILED" if failures else "all ok", file=OUT)
sys.exit(1 if failures else 0)
