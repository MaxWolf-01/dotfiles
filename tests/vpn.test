      (0, ["handshake: 7 of the next 7 nodes answer", "trying de-fra-wg-401 (Frankfurt, Germany) …",
           "trying de-fra-wg-001 (Frankfurt, Germany) …", "pinned: de-fra-wg-001 (Frankfurt, Germany)"], [], ""),
      (status, [text for _, text in got], rest, err))
check("each line as it comes, the one naming a node before the wait on it", True, got[2][0] - got[1][0] > 0.2)

