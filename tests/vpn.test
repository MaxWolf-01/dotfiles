# --- the request channel: a real unix socket, a World's watcher behind it, and
# bin/vpn as the command, each request a process of its own


class Stopped(Exception):
    pass


class Paced:
    """The watcher of a World on a thread of its own, taking requests over a real unix socket in a scratch
    directory. The World's time passes at `scale` real seconds per second, so that a command started or
    interrupted meanwhile finds a move under way."""

    def __init__(self, wd, scale=0.05):
        self.wd, self.scale = wd, scale
        self.dir = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH))
        self.arrivals = queue.Queue()
        self.server = vpn.listen(self.dir / "vpn.sock", self.arrivals.put)
        self.stopping = threading.Event()
        self.ports = replace(wd.ports, clock=vpn.Clock(now=wd.ports.clock.now, wait=self.wait))
        self.thread = threading.Thread(target=self.watch, daemon=True)
        self.thread.start()

    def wait(self, secs):
        """The Clock port's wait: what the socket delivered, else the World's next arrival within `secs`."""
        end = self.wd.now + secs
        while not self.stopping.is_set():
            try:
                return self.arrivals.get_nowait()
            except queue.Empty:
                pass
            before = self.wd.now
            arrival = self.wd.wait(max(min(end - before, 0.5), 0.0))
            time.sleep((self.wd.now - before) * self.scale)
            if arrival is not None:
                return arrival
            if self.wd.now >= end:
                return None
        raise Stopped

    def watch(self):
        w, due = vpn.Watch(live=vpn.Liveness(self.ports.clock)), 0.0
        try:
            with fakes.driving(self.wd), contextlib.redirect_stdout(io.StringIO()):
                while True:
                    due = vpn.handle(w, self.wait(due), self.ports)
        except Stopped:
            pass

    def command(self, *args):
        """bin/vpn, run as a command whose runtime directory is this watcher's."""
        return subprocess.Popen([sys.executable, str(VPN), *args], env=os.environ | {"XDG_RUNTIME_DIR": str(self.dir)},
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

    def stop(self):
        self.stopping.set()
        self.thread.join(30)
        self.server.close()


VPN = Path(__file__).resolve().parent.parent / "bin" / "vpn"


def read_until(proc, prefix):
    """The command's lines up to and including the first that starts with `prefix`, each with when it came."""
    began, got = time.monotonic(), []
    for text in proc.stdout:
        got.append((time.monotonic() - began, text.rstrip("\n")))
        if text.startswith(prefix):
            break
    return got


def ended(proc):
    """The command's exit status, the rest of what it printed, and what it printed to stderr."""
    out, err = proc.communicate(timeout=60)
    return proc.returncode, out.splitlines(), err.strip()


with contextlib.redirect_stdout(io.StringIO()):
    empty = Path(tempfile.mkdtemp(prefix="run-", dir=fakes.SCRATCH))
    began = time.monotonic()
    proc = subprocess.run([sys.executable, str(VPN), "next"], env=os.environ | {"XDG_RUNTIME_DIR": str(empty)},
                          capture_output=True, text=True, timeout=60)
    took = time.monotonic() - began
    stale = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    stale.bind(str(empty / "vpn.sock"))
    stale.close()
    left_behind = subprocess.run([sys.executable, str(VPN), "off"], env=os.environ | {"XDG_RUNTIME_DIR": str(empty)},
                                 capture_output=True, text=True, timeout=60)
check("with no watcher, a command fails at once, saying vpn-watch is not running, how to start it, and that "
      "vpn-off still works", (1, "", f"vpn: {vpn.NOT_RUNNING}", True), (proc.returncode, proc.stdout, proc.stderr.strip(), took < 10))
check("and so it does with a socket a dead watcher left behind", (1, f"vpn: {vpn.NOT_RUNNING}"),
      (left_behind.returncode, left_behind.stderr.strip()))

wd = world(inert={"de-fra-wg-401"}, vesktop=False)
paced = Paced(wd, scale=0.2)
proc = paced.command("next")
got = read_until(proc, "pinned")
status, rest, err = ended(proc)
paced.stop()
