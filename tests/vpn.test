      (("pinned", "de-fra-wg-401"), ["offline"]), (wd.setting(), events(wd)))
check("without the Discord check while Vesktop is closed", [], discords(wd))

# The dot's off click lands while the watcher's own move tries a node, and
# nothing is to be put back; 40 s later the node pinned by hand goes offline.
wd = world(offline={"de-fra-wg-202"}, vesktop=False)
wd.when(fakes.AfterStep(1, "connect"), fakes.Outside(""))
at(wd, 40, fakes.Outside("de-ber-wg-001.mullvad.ts.net"))
at(wd, 50, fakes.Online("de-ber-wg-001", False))
