def silence_lines(wd):
    return [(r["outcome"], r["stats"]["event"], r["stats"]["node"], r["stats"]["secs"]) for r in records(wd)]


def dot():
    return shown()["state"], shown()["reason"], shown()["since"]


# 202 dies at 5 s. The update at 6 s is the first to see traffic go in with
# nothing back; 20 s later, at 26 s, the node is silent. It comes back at 51 s,
# and the update at 52 s carries its reply.
wd = world(vesktop=False)
at(wd, 5, fakes.Dies("de-fra-wg-202"))
at(wd, 51, fakes.Revives("de-fra-wg-202"))
watching = fakes.Watcher(wd)
seen = [dot() for secs in (24, 28, 50, 54) if run_to(watching, secs)]
check("a node that stops answering goes down 20 s after the update that saw it, and back up once it answers",
      [("up", "", since(0)), ("down", "the node stopped answering", since(26)),
       ("down", "the node stopped answering", since(26)), ("up", "", since(52))], seen)
check("the silence is one node-log line, lasting from that update to the last that found it silent",
      [("ok", "silent", "de-fra-wg-202", 44)], silence_lines(wd))
check("and moves nothing", [], sets(wd))

# The same, with tailscaled pushing nothing from 31 s to 71 s, as across a
# suspend: the stream counts as closed from 40 s, and the first update after
# the gap, at 72 s, starts the count over.
wd = world(vesktop=False)
at(wd, 5, fakes.Dies("de-fra-wg-202"))
at(wd, 31, fakes.Quiet(40))
watching = fakes.Watcher(wd)
seen = [dot()[0] for secs in (44, 74, 92, 96) if run_to(watching, secs)]
check("no silence verdict is published while the stream is closed", "up", seen[0])
check("a silence the stream went quiet in ends at the last update before the gap",
      [("ok", "silent", "de-fra-wg-202", 24)], silence_lines(wd)[:1])
check("and the count starts over after it", ["up", "up", "up", "down"], seen)

wd = world(vesktop=False)
watching = run_to(fakes.Watcher(wd), 11)
said, set_exit_node = [], wd.ports.tailscaled.set_exit_node
wd.ports = replace(wd.ports, tailscaled=replace(wd.ports.tailscaled,
                                                set_exit_node=lambda t: said.append(shown()) or set_exit_node(t)))
output(wd, "to", "Berlin", watching=watching)
check("nothing is published while a request's move runs, and the node it pinned once it has finished",
      (["de-fra-wg-202"], "de-ber-wg-001"), ([s["node"] for s in said], shown()["node"]))

# The recovery that fails, then looks during its back-off.
wd = world(offline={"de-fra-wg-202"}, dead=EVERYTHING, vesktop=False)
watching = run_to(fakes.Watcher(wd), 10)
after_first = sets(wd)
run_to(watching, 60)
during = (sets(wd), shown()["state"])
run_to(watching, 320)
probes = [e.t - fakes.T0 for e in wd.entries if e.kind == "probe"]
check("after a failed recovery, no other starts for 5 minutes", ([], []), (after_first, during[0]))
check("while the dot keeps following", "down", during[1])
check("and one starts after", (2, True), (len({round(t) for t in probes}), 300 <= max(probes) - min(probes) < 320))

wd = world(vesktop=False)
run_to(fakes.Watcher(wd), 31)
check("an exit node set: the watcher looks every 10 s, and in between only takes in engine updates",
      [0, 10, 20, 30], wd.peerless_reads)
wd = world(None)
run_to(fakes.Watcher(wd), 100)
check("no exit node and the engine updates coming: nothing is due before the hourly heartbeat", [0], wd.peerless_reads)
wd = world(None, phase=1000)
run_to(fakes.Watcher(wd), 50)
check("no engine update: it looks every 15 s", [0, 15, 30, 45], wd.peerless_reads[:4])
wd = world(None)
at(wd, 21, fakes.Quiet(1000))
run_to(fakes.Watcher(wd), 50)
check("and notices a stream going quiet 10 s after its last update, at 20 s", [0, 30.1, 45.1], wd.peerless_reads[:3])
# With Vesktop open, the Discord check at the first look takes 0.2 s.
for vesktop, looks in ((False, [0, 10, 20, 30]), (True, [0, 10.2, 20.2, 30.2])):
    wd = world(vesktop=vesktop, phase=1000)
    run_to(fakes.Watcher(wd), 31)
    check(f"an exit node set and no engine update, with Vesktop {'open' if vesktop else 'closed'}, still looks every 10 s",
          looks, wd.peerless_reads[:4])

wd = world(vesktop=False)
for i in range(3):
    at(wd, 7 + 0.2 * i, fakes.Online("de-ber-wg-001", i % 2 == 0))
run_to(fakes.Watcher(wd), 12)
check("a burst of bus messages brings one look, a second after the first of them", [0, 8.0], wd.peerless_reads)

# --- the traffic proof and the handshake probe, as a move uses them


def proof(wd, name, connects=(), after=0.0):
    """Set the exit node to `name`, `after` seconds past an engine update, and run the traffic proof on it.
    `connects` stand in for the proof's first connects before the World's own take over: True for one that
    answered through the old route, False for one that failed. Whether the proof passed, and how long it took."""
    by_name = fakes.nodes(wd)
    queue, connect = list(connects), wd.ports.network.connect
    wd.ports = replace(wd.ports, network=replace(wd.ports.network,
                                                 connect=lambda timeout: queue.pop(0) if queue else connect(timeout)))
    with fakes.driving(wd):
        live = vpn.Liveness(wd.ports.clock)
        live.learn(wd.status())
        live.wait(vpn.ENGINE_SECS + 1, until=lambda: bool(live.samples))
        live.wait(after)
        wd.ports.tailscaled.set_exit_node(by_name[name].fqdn)
        began = wd.now
        passed = vpn.traffic_proof(by_name[name], live, wd.ports)
    return passed, round(wd.now - began, 2)


# A connect through the new node counts once an engine update shows bytes
# going to it, which is the first one after the switch. The connect under way
# when it arrives began before it, so the proof takes that and one more.
passed, secs = proof(world(None), "de-ber-wg-001")
check("the traffic proof confirms a node that carries traffic at the next engine update, two connects later",
      (True, True), (passed, secs <= vpn.ENGINE_SECS + 2 * fakes.CONNECT_SECS))
passed, secs = proof(world(None), "de-ber-wg-001", after=1.5)
check("and sooner when the switch comes just before an update", (True, True),
      (passed, secs <= 0.5 + 2 * fakes.CONNECT_SECS))
# A command starts at no particular phase of the updates, and waits for the
# first before its first switch, so the proof has an update to measure from.
passed, secs = proof(world(None, phase=1.5), "de-ber-wg-001")
check("a command whose first engine update comes 1.5 s in still has the proof end at the next one",
      (True, True), (passed, secs <= vpn.ENGINE_SECS + 2 * fakes.CONNECT_SECS))
check("it fails a node that answers nothing, in 5 s", (False, 5.0),
      proof(world(None, dead={"de-ber-wg-001"}), "de-ber-wg-001"))
# Right after a switch a connect can still leave through the old route, and
# with no application sending anything, nothing else reaches the new node.
switching = world(None)
switching.demand = 0
passed, secs = proof(switching, "de-ber-wg-001", [True])
check("a first connect that left through the old route does not fail a node that carries", (True, True),
      (passed, secs < vpn.PROOF_SECS))
check("nor pass one that answers handshakes and carries nothing, whose handshake bytes come back", (False, 5.0),
      proof(world(None, inert={"de-ber-wg-001"}), "de-ber-wg-001", [True]))
check("bytes back from a node with no connect through it are no proof", (False, 5.0),
      proof(world(None), "de-ber-wg-001", [False] * 50))
leaky = world(None)
leaky.hosts["de-ber-wg-001"] = replace(leaky.hosts["de-ber-wg-001"], carries=False, leaks=True)
check("nor is a connect that answers when the switch never took effect", (False, 5.0), proof(leaky, "de-ber-wg-001"))

wd = world(vesktop=False)
answered = fakes.probe(wd, ["de-fra-wg-001", "de-ber-wg-001"])
check("the handshake probe returns at the first engine update that carries every handshake",
      (["de-fra-wg-001", "de-ber-wg-001"], 2.0), (answered, wd.now - fakes.T0))
# The probe goes out 1 s before an engine update. A node whose first
# initiation is lost completes its handshake on WireGuard's retry, 5 s later,
# and the engine update at 7 s is the first to show it.
wd = world(vesktop=False, phase=1.0)
wd.hosts["de-fra-wg-001"] = replace(wd.hosts["de-fra-wg-001"], late=True)
check("a node that answers only WireGuard's handshake retry still answers the probe",
      (["de-fra-wg-001", "de-ber-wg-001"], 7.0), (fakes.probe(wd, ["de-fra-wg-001", "de-ber-wg-001"]), wd.now - fakes.T0))
wd = world(vesktop=False, dead={"de-fra-wg-401"})
fakes.probe(wd, ["de-fra-wg-001", "de-fra-wg-401"])
check("and waits out its window for a node that does not answer, 8 s", 8.0, wd.now - fakes.T0)
wd = world(vesktop=False, dead={"de-fra-wg-001", "de-fra-wg-401"})
wd.handshake.update({"de-fra-wg-001": fakes.T0 - 119, "de-fra-wg-401": fakes.T0 - 121})
check("a node whose last handshake is under 120 s old counts as answering, dead or not; an older one does not",
      ["de-fra-wg-001"], fakes.probe(wd, ["de-fra-wg-001", "de-fra-wg-401"]))

# --- the requests `vpn on`, `to`, `next` and `off` send, as the watcher serves them


def disconnect_after(wd, kind, n=1):
    """The command goes away, as on Ctrl-C, when the watcher's n-th step of `kind` returns."""
    wd.when(fakes.AfterStep(n, kind), fakes.Disconnect())


def steps_after_disconnect(wd):
    """The probes, connects and Discord checks between the command going away and its request's final line."""
    gone = next(i for i, e in enumerate(wd.entries) if e.kind == "disconnect")
    ended = next(i for i, e in enumerate(wd.entries) if e.kind == "finish")
    return [e.kind for e in wd.entries[gone + 1:ended] if e.kind in ("probe", "connect", "discord")]


wd = world(blocked={"de-fra-wg-401"}, vesktop=False)
command(wd, "next")
check("vpn next skips a node Cloudflare blocks", "de-fra-wg-001", wd.exit)
check("and records where it went, from where, and how many it tried",
      {"event": "pinned", "command": "next", "node": "de-fra-wg-202", "rotated_to": "de-fra-wg-001", "tried": 2},
      last(wd))

wd = world(inert={"de-fra-wg-401"}, vesktop=False)
command(wd, "next")
check("and a node that answers the handshake but carries nothing", ("pinned", "de-fra-wg-001"), wd.setting())

wd = world(blocked=EVERYTHING, vesktop=False)
error = command(wd, "next")
check("vpn next finding nothing puts the pinned node back", ("pinned", "de-fra-wg-202"), wd.setting())
check("and fails, saying so", ("exhausted", True), (last(wd)["event"], error is not None))

wd = world(blocked=EVERYTHING, automatic=True, vesktop=False)
command(wd, "next")
check("from automatic mode, it goes back to automatic mode", ("automatic", "auto:any"), (wd.mode, sets(wd)[-1]))

wd = world(None, blocked=EVERYTHING, vesktop=False)
command(wd, "next")
check("from off, it goes back to off", (("off", None), ""), (wd.setting(), sets(wd)[-1]))

wd = world(dead=EVERYTHING - {"de-fra-wg-202"}, vesktop=False)
error, printed = output(wd, "next")
check("vpn next whose candidates all fail the probe changes nothing", (("pinned", "de-fra-wg-202"), []),
      (wd.setting(), sets(wd)))
check("and says so within the probe window",
      (True, True, True), (printed[0].startswith("handshake: none of the next 7 nodes answers"),
                           "still on de-fra-wg-202" in (error or ""), finished(wd) <= vpn.PROBE_SECS))
check("recording the network as the problem", ("unreachable", 0), (last(wd)["event"], last(wd)["tried"]))

# Frankfurt as it was live on 2026-09-25: fifteen nodes in four provider series.
FRANKFURT = [fakes.Host(f"de-fra-wg-{n}", "Germany", "Frankfurt")
             for n in "001 002 003 004 005 101 102 103 104 201 202 203 404 405 406".split()]
check("from de-fra-wg-103, a move tries 203, 406, 004, 104, 005, 101, 001, 201",
      ["de-fra-wg-203", "de-fra-wg-406", "de-fra-wg-004", "de-fra-wg-104", "de-fra-wg-005", "de-fra-wg-101",
       "de-fra-wg-001", "de-fra-wg-201"], fakes.next_order(FRANKFURT, "de-fra-wg-103")[:8])
check("and vpn to Frankfurt, from the start of the cycle",
      ["de-fra-wg-001", "de-fra-wg-101", "de-fra-wg-201", "de-fra-wg-404", "de-fra-wg-002"],
      fakes.to_order(FRANKFURT, "Frankfurt", "de-fra-wg-103")[:5])
three_to_one = [fakes.Host(f"de-fra-wg-{n}", "Germany", "Frankfurt") for n in "001 002 003 004 101".split()]
check("a provider holding most of a city alternates while the city has another, then runs on",
      ["de-fra-wg-001", "de-fra-wg-101", "de-fra-wg-002", "de-fra-wg-003", "de-fra-wg-004"],
      fakes.to_order(three_to_one, "Frankfurt", None))

wd = fakes.World([replace(h, answers=h.name != "de-fra-wg-104", carries=h.name not in ("de-fra-wg-104", "de-fra-wg-203"))
                  for h in FRANKFURT], ("pinned", "de-fra-wg-103"))
WORLDS.append(wd)
error, printed = output(wd, "next")
check("vpn next in Frankfurt from 103 streams the probe summary, then each node before it tries it, then the pin",
      ["handshake: 7 of the next 8 nodes answer, de-fra-wg-104 does not",
       "trying de-fra-wg-203 (Frankfurt, Germany) …",
       "trying de-fra-wg-406 (Frankfurt, Germany) …",
       "pinned: de-fra-wg-406 (Frankfurt, Germany)"], printed)
check("and set the exit node to 203 first", ["de-fra-wg-203.mullvad.ts.net", "de-fra-wg-406.mullvad.ts.net"], sets(wd))

