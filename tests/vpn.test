      "outside vpn", [("cancelled", "watch", "de-fra-wg-202", "de-fra-wg-401"), ("changed", "watch", "de-fra-wg-401", None),
                      ("changed", "watch", None, "de-ber-wg-001")], moved(wd)[:3])
