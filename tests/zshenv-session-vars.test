#!/usr/bin/env bash
# tier: fast
# A zsh started under an environment from an older Home Manager generation (a
# GNOME login from before the last switch) gets the current session variables,
# while one started by a shell of the current generation keeps what that shell
# set by hand. Why: nix/home/common.nix, above the zshenv it writes.
# The laptop's .zshenv is read from the flake's evaluation alone, with its
# session-variables file swapped for a fixture: nothing is built.

set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$repo/tests/check.sh"

needs nix zsh

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

cfg="$repo#homeConfigurations.zephyrus.config"
if ! zshenv=$(nix eval --raw "$cfg.home.file" --apply 'f: f.".config/zsh/.zshenv".text' 2>"$scratch/err") ||
   ! pkg=$(nix eval --raw "$cfg.home.sessionVariablesPackage" 2>"$scratch/err"); then
    fail "the laptop's Home Manager configuration evaluates" "$(tail -20 "$scratch/err")"
    finish
fi

# Home Manager's own file opens with the guard these lines copy.
mkdir -p "$scratch/vars/etc/profile.d" "$scratch/zdotdir"
cat > "$scratch/vars/etc/profile.d/hm-session-vars.sh" <<'EOF'
if [ -n "${__HM_SESS_VARS_SOURCED-}" ]; then return; fi
export __HM_SESS_VARS_SOURCED=1
export SOPS_AGE_KEY_FILE=/from-home-manager
export PATH="/hm/bin${PATH:+:}$PATH"
EOF
# The fixture in place of the real file, and every zsh, children included, reading this .zshenv.
generation="$scratch/vars"
sed -e "s|$pkg|$generation|g" -e "s|^export ZDOTDIR=.*|export ZDOTDIR=$scratch/zdotdir|" \
    <<<"$zshenv" > "$scratch/zdotdir/.zshenv"

# The key path and how often /hm/bin is on PATH, as a zsh started with the given environment sees them.
start() {
    env -i HOME="$scratch" ZDOTDIR="$scratch/zdotdir" PATH=/usr/bin:/bin "$@" \
        "$(command -v zsh)" -c 'print -r -- "$SOPS_AGE_KEY_FILE $(print -l ${(s.:.)PATH} | grep -cx /hm/bin)"'
}

check "a fresh zsh loads the session variables once" \
    "/from-home-manager 1" "$(start)"
check "a zsh under a login older than the switch, guard set and variable missing, loads them" \
    "/from-home-manager 1" "$(start __HM_SESS_VARS_SOURCED=1)"
check "a zsh whose parent came from another generation loads this one's" \
    "/from-home-manager 1" "$(start __HM_SESS_VARS_SOURCED=1 __HM_SESS_VARS_FROM=/nix/store/old SOPS_AGE_KEY_FILE=/by-hand)"
check "a zsh whose parent is of this generation keeps what the parent set by hand" \
    "/by-hand 0" "$(start __HM_SESS_VARS_SOURCED=1 __HM_SESS_VARS_FROM="$generation" SOPS_AGE_KEY_FILE=/by-hand)"

finish
