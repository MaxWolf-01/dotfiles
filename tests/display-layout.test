#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro", "tomlkit"]
# ///
"""Drive bin/display-layout's commands over gdctl show fixtures. Run it directly; no framework.

The first part fixes the fallback's two judgements: what counts as the row
mutter falls back to, and where the panel goes underneath. The second runs
save, use, list and show against scratch layouts files, and checks the file
they write, the gdctl set arguments, and what they print. The last drives the
watcher over the same fixtures, files and recent record. Whether mutter accepts
an arrangement is mutter's to say, live, through gdctl set --verify.

The fixtures are gdctl show output, kept down to the lines the parser reads plus
the deeper ones it has to walk past. tests/properties/display-layout.test holds
the properties of matching, drawing and the watcher's choice.
"""

import contextlib
import importlib.util
import io
import json
import os
import re
import sys
import tempfile
import tomllib
from dataclasses import replace
from unittest import mock
from importlib.machinery import SourceFileLoader
from pathlib import Path


def load(name: str, path: Path):
    loader = SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    assert spec
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


dl = load("display_layout", Path(__file__).resolve().parent.parent / "bin" / "display-layout")

MONITORS = """\
Monitors:
├──Monitor eDP-1 (Built-in display)
│  ├──Vendor: AUO
│  ├──Product: 0xc199
│  ├──Serial: 0x00000000
│  ├──Current mode
│  │   └──2560x1600@165.040
│  └──Preferences
│      └──Backlight:
│          ├──active ⇒  True
│          └──max ⇒  19200
└──Monitor HDMI-1 (ASUSTek COMPUTER INC 28")
   ├──Vendor: AUS
   ├──Product: ASUS VP28U
   ├──Serial: 0x00039bf2
   ├──Current mode
   │   └──3840x2160@60.000
   └──Preferences
       └──Backlight: None
"""

ROW = MONITORS + """
Logical monitors:
├──Logical monitor #1
│  ├──Position: (0, 0)
│  ├──Scale: 1.3333333730697632
│  ├──Transform: normal
│  ├──Primary: yes
│  └──Monitors: (1)
│      └──eDP-1 (Built-in display)
└──Logical monitor #2
   ├──Position: (1920, 0)
   ├──Scale: 1.5
   ├──Transform: normal
   ├──Primary: no
   └──Monitors: (1)
       └──HDMI-1 (ASUSTek COMPUTER INC 28")
"""

STACKED = MONITORS + """
Logical monitors:
├──Logical monitor #1
│  ├──Position: (320, 1440)
│  ├──Scale: 1.3333333730697632
│  ├──Transform: normal
│  ├──Primary: yes
│  └──Monitors: (1)
│      └──eDP-1 (Built-in display)
└──Logical monitor #2
   ├──Position: (0, 0)
   ├──Scale: 1.5
   ├──Transform: normal
   ├──Primary: no
   └──Monitors: (1)
       └──HDMI-1 (ASUSTek COMPUTER INC 28")
"""

# Both monitors in one logical monitor: a mirror, and never mutter's fallback.
MIRRORED = MONITORS + """
Logical monitors:
└──Logical monitor #1
   ├──Position: (0, 0)
   ├──Scale: 1.0
   ├──Transform: normal
   ├──Primary: yes
   └──Monitors: (2)
       ├──eDP-1 (Built-in display)
       └──HDMI-1 (ASUSTek COMPUTER INC 28")
"""

PANEL_ONLY = """\
Monitors:
└──Monitor eDP-1 (Built-in display)
   ├──Vendor: AUO
   ├──Product: 0xc199
   ├──Serial: 0x00000000
   └──Current mode
       └──2560x1600@165.040

Logical monitors:
└──Logical monitor #1
   ├──Position: (0, 0)
   ├──Scale: 1.3333333730697632
   ├──Transform: normal
   ├──Primary: yes
   └──Monitors: (1)
       └──eDP-1 (Built-in display)
"""

failures = 0


def check(what, expected, actual):
    global failures
    if expected == actual:
        print(f"ok   {what}")
    else:
        print(f"FAIL {what}")
        print(f"       expected: {expected}")
        print(f"       actual:   {actual}")
        failures += 1


# --- the parser reads the tree, and walks past what sits below it

row = dl.parse_show(ROW)
check("monitors, in gdctl's order", ["eDP-1", "HDMI-1"], list(row.monitors))
check("current mode", "3840x2160@60.000", row.monitors["HDMI-1"].mode)
check("the panel is the built-in one", True, row.monitors["eDP-1"].is_builtin)
check("an external is not", False, row.monitors["HDMI-1"].is_builtin)
check("logical monitors", 2, len(row.logicals))
check("position", (1920, 0), (row.logicals[1].x, row.logicals[1].y))
check("scale", 1.5, row.logicals[1].scale)
check("primary", [True, False], [logical.primary for logical in row.logicals])
check("connectors, not the display names beside them", ["HDMI-1"], row.logicals[1].connectors)
# Backlight sits two levels under the monitor, where a mode name sits under
# "Current mode". Reading it as one would give an unparseable resolution.
check("Preferences are not mistaken for a mode", "2560x1600@165.040", row.monitors["eDP-1"].mode)
check(
    "vendor, product and serial, which name a monitor on any port",
    ("AUS", "ASUS VP28U", "0x00039bf2"),
    (row.monitors["HDMI-1"].vendor, row.monitors["HDMI-1"].product, row.monitors["HDMI-1"].serial),
)

check("logical size is the mode over the scale", (2560, 1440), row.size_of(row.logicals[1]))

# --- what counts as mutter's row

check("a row is recognised", True, dl.is_mutter_row(row))
check("an arrangement is not", False, dl.is_mutter_row(dl.parse_show(STACKED)))
check("one monitor is never worth rearranging", False, dl.is_mutter_row(dl.parse_show(PANEL_ONLY)))

# A gap between two monitors means someone placed them, so leave them placed.
gapped = dl.parse_show(ROW.replace("Position: (1920, 0)", "Position: (2000, 0)"))
check("a gap in the row is not the row", False, dl.is_mutter_row(gapped))
# mutter rounds logical sizes, so a pixel of drift is still the row.
drifted = dl.parse_show(ROW.replace("Position: (1920, 0)", "Position: (1921, 0)"))
check("a pixel of drift still is", True, dl.is_mutter_row(drifted))

# --- where the arrangement puts things

plan = dl.plan(row)
check("no --persistent, which would raise mutter's confirmation dialog", [], [a for a in plan if a in ("-P", "--persistent")])
check(
    "external on top, panel centred below it, panel primary",
    [
        "--logical-monitor", "--x", "0", "--y", "0", "--scale", "1.5",
        "--transform", "normal",
        "--monitor", "HDMI-1", "--mode", "3840x2160@60.000",
        "--logical-monitor", "--x", "320", "--y", "1440",
        "--scale", "1.3333333730697632", "--transform", "normal", "--primary",
        "--monitor", "eDP-1", "--mode", "2560x1600@165.040",
    ],
    plan,
)
# gdctl fills a missing --mode with the monitor's preferred mode, which would
# drop a variable-refresh mode: those are separate, non-preferred modes.
vrr_plan = dl.plan(dl.parse_show(ROW.replace("2560x1600@165.040", "2560x1600@165.040+vrr")))
check(
    "the current mode is named, variable-refresh variant included",
    ["3840x2160@60.000", "2560x1600@165.040+vrr"],
    [a for flag, a in zip(vrr_plan, vrr_plan[1:]) if flag == "--mode"],
)

# A turned monitor's mode height lies along the layout's x axis, so centring the
# panel under it has to measure the turned width.
turned = dl.parse_show(ROW.replace("   ├──Transform: normal\n   ├──Primary: no", "   ├──Transform: 90\n   ├──Primary: no"))
check("a turned external keeps its transform", "90", dl.plan(turned)[dl.plan(turned).index("--transform") + 1])
check(
    "a turned external is measured on its turned edge",
    (1440, 2560),
    turned.size_of(turned.logicals[1]),
)
check("nothing to arrange without an external", [], dl.plan(dl.parse_show(PANEL_ONLY)))
check("a mirror is left alone", [], dl.plan(dl.parse_show(MIRRORED)))

def positions(plan):
    """The plan's --x/--y per connector, read back the way gdctl reads it."""
    out, current = {}, {}
    for flag, value in zip(plan, plan[1:]):
        if flag in ("--x", "--y"):
            current[flag] = int(value)
        elif flag == "--monitor":
            out[value] = (current.get("--x"), current.get("--y"))
            current = {}
    return out


# A panel wider than the externals would centre at a negative x, which mutter
# rejects; the row moves right instead.
narrow = dl.parse_show(
    ROW.replace("3840x2160@60.000", "1280x1024@60.000").replace("Scale: 1.5", "Scale: 1.0")
)
check(
    "a panel wider than the row pushes the row right instead of going off-canvas",
    {"HDMI-1": (320, 0), "eDP-1": (0, 1024)},
    positions(dl.plan(narrow)),
)

# --- unreadable input is an error, not a silent misreading

try:
    dl.parse_show("Monitors:\n")
    check("empty output is refused", "ParseError", "no error")
except dl.ParseError:
    check("empty output is refused", "ParseError", "ParseError")

try:
    dl.parse_show(MONITORS.replace("│  │   └──2560x1600@165.040\n", "") + "\nLogical monitors:\n")
    check("a monitor without a mode is refused", "ParseError", "no error")
except dl.ParseError:
    check("a monitor without a mode is refused", "ParseError", "ParseError")

# --- named layouts: save, use, list and show
#
# Each command runs against gdctl show fixtures, with a layouts file and a
# recent record in a scratch directory. Only dl.run is replaced: it answers
# `gdctl show` from the fixtures, answers UPower's lid query, and records
# `gdctl set`. The monitors are the desk on zephylux (the ARZOPA turned to
# portrait on the left, the HP above the panel); the serials are made up.

LAPTOP = ("eDP-1", "Built-in display", "AUO", "0xc199", "0x00000000", "2560x1600@165.040")
HP = ("HDMI-1", 'HP Inc. 27"', "HPN", "HP M27fwa FHD", "HP0000001", "1920x1080@60.000")
ARZOPA = ("DP-1", 'GWD 16"', "GWD", "ARZOPA", "0x0000a001", "2560x1600@59.997")
ASUS = ("HDMI-1", 'ASUSTek COMPUTER INC 28"', "AUS", "ASUS VP28U", "0x00039bf2", "3840x2160@60.000")
FOUR_THIRDS = 1.3333333730697632


def on(port, monitor, serial=None):
    return (port, *monitor[1:4], serial or monitor[4], monitor[5])


def gdctl_show(monitors, logicals, off=()):
    """gdctl show output. A logical is (connectors, x, y, scale, transform, primary).

    A connector in `off` is listed with its preferred mode and has no logical
    monitor, the way gdctl shows a closed laptop panel.
    """
    lines = ["Monitors:"]
    for i, (connector, label, vendor, product, serial, mode) in enumerate(monitors):
        head, pad = ("└──", "   ") if i == len(monitors) - 1 else ("├──", "│  ")
        lines += [
            f"{head}Monitor {connector} ({label})",
            f"{pad}├──Vendor: {vendor}",
            f"{pad}├──Product: {product}",
            f"{pad}├──Serial: {serial}",
            f"{pad}├──{'Preferred' if connector in off else 'Current'} mode",
            f"{pad}│   └──{mode}",
            f"{pad}└──Preferences",
            f"{pad}    └──Backlight: None",
        ]
    lines += ["", "Logical monitors:"]
    for i, (connectors, x, y, scale, transform, primary) in enumerate(logicals):
        head, pad = ("└──", "   ") if i == len(logicals) - 1 else ("├──", "│  ")
        connectors = connectors.split("+")
        lines += [
            f"{head}Logical monitor #{i + 1}",
            f"{pad}├──Position: ({x}, {y})",
            f"{pad}├──Scale: {scale}",
            f"{pad}├──Transform: {transform}",
            f"{pad}├──Primary: {'yes' if primary else 'no'}",
            f"{pad}└──Monitors: ({len(connectors)})",
        ]
        lines += [f"{pad}    {'└' if j == len(connectors) - 1 else '├'}──{c} (label)" for j, c in enumerate(connectors)]
    return "\n".join(lines) + "\n"


def desk(arzopa_port="DP-1", arzopa=(0, 180, FOUR_THIRDS, "90"), hp=(1200, 0, 1.0, "normal"),
         laptop=(1200, 1080, FOUR_THIRDS, "normal"), primary="eDP-1", laptop_mode=LAPTOP[5]):
    """The desk as gdctl shows it, in gdctl's order, with any monitor's place, scale or turn changed."""
    return gdctl_show(
        [HP, LAPTOP[:5] + (laptop_mode,), on(arzopa_port, ARZOPA)],
        [(arzopa_port, *arzopa, primary == arzopa_port), ("HDMI-1", *hp, primary == "HDMI-1"),
         ("eDP-1", *laptop, primary == "eDP-1")],
    )


DESK = desk()
# The same monitors with the ARZOPA in the other USB-C port, mutter's row on screen.
DESK_DP2_ROW = gdctl_show(
    [HP, LAPTOP, on("DP-2", ARZOPA)],
    [("HDMI-1", 0, 0, 1.0, "normal", False), ("eDP-1", 1920, 0, FOUR_THIRDS, "normal", True),
     ("DP-2", 3840, 0, FOUR_THIRDS, "normal", False)],
)
# The lid closed at the desk: the panel is listed, off, and the HP is primary.
DOCKED = gdctl_show(
    [HP, LAPTOP, ARZOPA],
    [("DP-1", 0, 0, FOUR_THIRDS, "90", False), ("HDMI-1", 1200, 0, 1.0, "normal", True)],
    off=("eDP-1",),
)

ALIASES = """\
[aliases]
hp = { vendor = "HPN", product = "HP M27fwa FHD" }
laptop = { vendor = "AUO", product = "0xc199" }
arzopa = { vendor = "GWD", product = "ARZOPA" }
"""
DESK_TALL = """
[layouts.desk-tall]
arzopa = { x = 0, y = 180, mode = "2560x1600@59.997", scale = 1.3333333730697632, transform = "90" }
hp = { x = 1200, y = 0, mode = "1920x1080@60.000" }
laptop = { x = 1200, y = 1080, mode = "2560x1600@165.040", scale = 1.3333333730697632, primary = true }
"""
DESK_TOP = DESK_TALL.replace("desk-tall", "desk-top").replace("y = 180", "y = 0")
DOCKED_LAYOUT = """
[layouts.docked]
arzopa = { x = 0, y = 0, mode = "2560x1600@59.997", scale = 1.3333333730697632, transform = "90" }
hp = { x = 1200, y = 0, mode = "1920x1080@60.000", primary = true }
"""
DESK_FILE = ALIASES + DESK_TALL + DESK_TOP + DOCKED_LAYOUT


class Terminal(io.StringIO):
    def isatty(self):
        return True


class Session:
    """The display, the lid and the files a command sees, and what it did.

    `shows` are the gdctl show outputs the command reads in turn; the last one
    repeats. A show may be a function of the session, called when it is read,
    to change the files between two looks. `lid_closed` is one answer, or a
    list of them read in turn the same way. `layouts` and `recent` seed the
    files; None leaves none. mutter rejects the first `rejects` gdctl sets.
    """

    def __init__(self, *shows, lid_closed=False, layouts=None, recent=None, terminal=False, no_color=True, rejects=0):
        self.tmp = Path(tempfile.mkdtemp(prefix="display-layout-test."))
        self.shows, self.terminal, self.no_color, self.rejects = list(shows), terminal, no_color, rejects
        self.lids = list(lid_closed) if isinstance(lid_closed, list) else [lid_closed]
        self.applied, self.calls, self.logs = [], [], []
        if layouts is not None:
            self.path.write_text(layouts)
        if recent is not None:
            self.write_recent(recent)

    def write_recent(self, names):
        self.recent_path.parent.mkdir(parents=True, exist_ok=True)
        self.recent_path.write_text("".join(f"{n}\n" for n in names))

    path = property(lambda self: self.tmp / "layouts.toml")
    recent_path = property(lambda self: self.tmp / "state" / "display-layout" / "recent")
    file = property(lambda self: self.path.read_text() if self.path.exists() else "")
    recent = property(lambda self: self.recent_path.read_text().split() if self.recent_path.exists() else [])

    def run(self, argv):
        if argv[:2] == ["gdctl", "show"]:
            show = self.shows.pop(0) if len(self.shows) > 1 else self.shows[0]
            return show(self) if callable(show) else show
        if argv[:2] == ["gdctl", "set"]:
            self.applied.append(argv[2:])
            if len(self.applied) <= self.rejects:
                raise dl.CommandError("mutter rejected the configuration")
            return ""
        if argv[:2] == ["gdbus", "call"] and argv[-1] == "LidIsClosed":
            lid = self.lids.pop(0) if len(self.lids) > 1 else self.lids[0]
            return "(<true>,)\n" if lid else "(<false>,)\n"
        raise AssertionError(f"unexpected command {argv}")

    def recording(self, name, function):
        def recorded(*args, **kwargs):
            self.calls.append(name)
            return function(*args, **kwargs)
        return recorded

    def __call__(self, command, args):
        out = Terminal() if self.terminal else io.StringIO()
        env = {"DISPLAY_LAYOUTS": str(self.path), "XDG_STATE_HOME": str(self.tmp / "state"), "COLUMNS": "80"}
        with contextlib.ExitStack() as stack:
            stack.enter_context(mock.patch.dict(os.environ, env))
            if self.no_color:
                os.environ["NO_COLOR"] = "1"
            else:
                os.environ.pop("NO_COLOR", None)
            stack.enter_context(mock.patch.object(dl, "run", self.run))
            stack.enter_context(mock.patch.object(dl, "cells", self.recording("cells", dl.cells)))
            stack.enter_context(mock.patch.object(dl, "match", self.recording("match", dl.match)))
            stack.enter_context(mock.patch.object(dl, "decide", self.recording("decide", dl.decide)))
            stack.enter_context(mock.patch.object(dl, "log_run", lambda *line: self.logs.append(line)))
            stack.enter_context(contextlib.redirect_stdout(out))
            try:
                try:
                    command(args)
                except dl.REFUSALS as exc:
                    dl.fail(str(exc))
            except SystemExit as exc:
                return f"exit: {exc}"
            except Exception as exc:  # noqa: BLE001  reported as a failed check, so the checks after it still run
                return f"crash: {type(exc).__name__}: {exc}"
        return out.getvalue()


def groups(argv):
    """gdctl set arguments as {connector: (x, y, scale, transform, primary, mode)}."""
    out, group = {}, []
    for arg in argv + ["--logical-monitor"]:
        if arg == "--logical-monitor" and group:
            pairs = [a for a in group if a != "--primary"]
            flags = dict(zip(pairs[::2], pairs[1::2]))
            out[flags["--monitor"]] = (int(flags["--x"]), int(flags["--y"]), float(flags["--scale"]),
                                       flags["--transform"], "--primary" in group, flags["--mode"])
            group = []
        elif arg != "--logical-monitor":
            group.append(arg)
    return out


def drawing(arrangement):
    """How a command draws an arrangement at 80 columns without colour."""
    return dl.draw(arrangement, dl.fit_width(arrangement, 80), None)


TALL = (
    dl.Screen("arzopa", ARZOPA[5], 0, 180, FOUR_THIRDS, "90"),
    dl.Screen("hp", HP[5], 1200, 0),
    dl.Screen("laptop", LAPTOP[5], 1200, 1080, FOUR_THIRDS, primary=True),
)

# --- save

s = Session(DESK)
out = s(dl.save, dl.SaveArgs("desk-tall"))
check("save writes the arrangement on screen into the file, by alias, in the documented shape",
      tomllib.loads(ALIASES + DESK_TALL), tomllib.loads(s.file))
check("save names each new alias from its model, and says so",
      ["new alias hp: HPN HP M27fwa FHD", "new alias laptop: AUO 0xc199", "new alias arzopa: GWD ARZOPA",
       f"saved desk-tall in {s.path}", "", "desk-tall, as saved"],
      out.splitlines()[:6])
check("save draws what it saved through cells", (True, drawing(TALL)), ("cells" in s.calls, out.split("\n\n", 2)[-1].rstrip("\n")))
check("save puts the layout first in recent", ["desk-tall"], s.recent)

s = Session(DESK, layouts="# my desks\n" + ALIASES + DESK_TOP, recent=["desk-top"])
s(dl.save, dl.SaveArgs("desk-tall"))
check("saving into an existing file keeps its comments and layouts, and adds no alias twice",
      (True, tomllib.loads(ALIASES + DESK_TOP + DESK_TALL)), (s.file.startswith("# my desks\n"), tomllib.loads(s.file)))
check("and puts the saved layout first in recent", ["desk-tall", "desk-top"], s.recent)

# Lid closed, and the panel the only monitor: mutter keeps it in the set, so does a layout.
s = Session(PANEL_ONLY, lid_closed=True)
s(dl.save, dl.SaveArgs("solo"))
check("with the lid closed and only the panel, the panel is saved", ["laptop"],
      list(tomllib.loads(s.file).get("layouts", {}).get("solo", {})))

s = Session(DOCKED, lid_closed=True)
s(dl.save, dl.SaveArgs("docked"))
check("a layout saved with the lid closed leaves the panel out",
      tomllib.loads(ALIASES.replace('laptop = { vendor = "AUO", product = "0xc199" }\n', "") + DOCKED_LAYOUT),
      tomllib.loads(s.file))

FIVE = gdctl_show(
    [LAPTOP, HP, ("DP-3", "x", "GSM", "LG ULTRAWIDE", "1", "3440x1440@99.997"),
     ("DP-4", "x", "ABC", "0x1234", "2", "1920x1080@60.000"), ("DP-5", "x", "HPN", "HP E24 G5", "3", "1920x1080@60.000")],
    [("eDP-1", 0, 0, 1.0, "normal", True), ("HDMI-1", 2560, 0, 1.0, "normal", False),
     ("DP-3", 4480, 0, 1.0, "normal", False), ("DP-4", 7920, 0, 1.0, "normal", False),
     ("DP-5", 9840, 0, 1.0, "normal", False)],
)
s = Session(FIVE)
s(dl.save, dl.SaveArgs("wall"))
check("an alias is the product's first word, the vendor's when the product is a code, laptop for the panel",
      {"laptop": "0xc199", "hp": "HP M27fwa FHD", "lg": "LG ULTRAWIDE", "abc": "0x1234", "hp-2": "HP E24 G5"},
      {a: m["product"] for a, m in tomllib.loads(s.file).get("aliases", {}).items()})

TWINS = gdctl_show(
    [LAPTOP, ARZOPA, on("DP-2", ARZOPA, "0x0000a002")],
    [("eDP-1", 0, 0, 1.0, "normal", True), ("DP-1", 2560, 0, 1.0, "normal", False),
     ("DP-2", 5120, 0, 1.0, "normal", False)],
)
s = Session(TWINS, layouts='[aliases]\narzopa = { vendor = "GWD", product = "ARZOPA" }\n')
out = s(dl.save, dl.SaveArgs("twins"))
check("of two monitors of one model, the first takes the alias without a serial and gets its serial",
      sorted(["updated alias arzopa: GWD ARZOPA 0x0000a001", "new alias laptop: AUO 0xc199",
              "new alias arzopa-2: GWD ARZOPA 0x0000a002"]), sorted(out.splitlines()[:3]))

# Cheap portable monitors often report one serial for every unit.
same = TWINS.replace("0x0000a002", "0x0000a001")
s = Session(same)
first = s(dl.save, dl.SaveArgs("twins"))
again = s(dl.save, dl.SaveArgs("twins"))
check("twins with one serial get an alias each, and saving again reuses both",
      (["arzopa", "arzopa-2", "laptop"], "saved twins"),
      (sorted(tomllib.loads(s.file).get("layouts", {}).get("twins", {})), again.splitlines()[0].rsplit(" in ", 1)[0]))

for what, show, lid, message in (
    ("a name gdctl's users could not type", DESK, False, "'desk tall': a layout name is letters, digits, - and _"),
    ("a connected monitor that is off", DOCKED, False,
     "eDP-1 is connected but off, and a layout covers every connected monitor"),
    ("a mirror", gdctl_show([LAPTOP, HP], [("eDP-1+HDMI-1", 0, 0, 1.0, "normal", True)]), False,
     "eDP-1 and HDMI-1 mirror each other, and a layout cannot hold a mirror"),
    ("the panel on with the lid closed", DESK, True,
     "eDP-1 is on with the lid closed; open the lid, or turn the panel off"),
):
    s = Session(show, lid_closed=lid)
    check(f"save refuses {what}, and writes nothing",
          (f"exit: display-layout: {message}", False),
          (s(dl.save, dl.SaveArgs("desk tall" if "name" in what else "x")), s.path.exists()))

# --- use

s = Session(DESK_DP2_ROW, desk("DP-2"), layouts=DESK_FILE, recent=["desk-top", "desk-tall"])
out = s(dl.use, dl.UseArgs("desk-tall"))
check("use binds each alias to the port its monitor is on now, through match",
      ([{"DP-2": (0, 180, FOUR_THIRDS, "90", False, ARZOPA[5]), "HDMI-1": (1200, 0, 1.0, "normal", False, HP[5]),
         "eDP-1": (1200, 1080, FOUR_THIRDS, "normal", True, LAPTOP[5])}], True),
      ([groups(a) for a in s.applied], "match" in s.calls))
check("use never passes --persistent", [], [a for a in s.applied[0] if a in ("-P", "--persistent")])
check("use moves the layout to the front of recent", ["desk-tall", "desk-top"], s.recent)
check("use draws the result as it reads back from gdctl", "desk-tall, as saved\n\n" + drawing(TALL) + "\n", out)

s = Session(DOCKED.replace("DP-1", "DP-2"), lid_closed=True, layouts=DESK_FILE)
s(dl.use, dl.UseArgs("docked"))
check("a layout saved with the lid closed is applied, on other ports, with the panel left off",
      [{"DP-2": (0, 0, FOUR_THIRDS, "90", False, ARZOPA[5]), "HDMI-1": (1200, 0, 1.0, "normal", True, HP[5])}],
      [groups(a) for a in s.applied])

# A layout edited by hand need not start at (0, 0); mutter refuses one that does not.
s = Session(DESK, layouts=ALIASES + DESK_TALL.replace("x = 0, y = 180", "x = 100, y = 230")
            .replace("x = 1200, y = 0,", "x = 1300, y = 50,").replace("x = 1200, y = 1080", "x = 1300, y = 1130"))
s(dl.use, dl.UseArgs("desk-tall"))
check("use moves a layout to start at (0, 0)", {"DP-1": (0, 180), "HDMI-1": (1200, 0), "eDP-1": (1200, 1080)},
      {c: g[:2] for c, g in groups(s.applied[0]).items()})

for what, show, lid, name, message in (
    ("a layout for other monitors, naming those connected", PANEL_ONLY, False, "desk-tall",
     "desk-tall is for arzopa, hp, laptop; connected: laptop on eDP-1"),
    ("a monitor no alias stands for", ROW, False, "desk-tall",
     "desk-tall is for arzopa, hp, laptop; connected: laptop on eDP-1, HDMI-1 (AUS ASUS VP28U, no alias)"),
    ("the lid-closed layout with the lid open", DESK, False, "docked",
     "docked is for arzopa, hp; connected: hp on HDMI-1, laptop on eDP-1, arzopa on DP-1"),
    ("a name it does not know, listing those saved", DESK, False, "nope",
     "no layout named nope; saved: desk-tall, desk-top, docked"),
):
    s = Session(show, lid_closed=lid, layouts=DESK_FILE)
    check(f"use refuses {what}, and applies nothing",
          (f"exit: display-layout: {message}", []), (s(dl.use, dl.UseArgs(name)), s.applied))

check("a broken layouts file is named in the refusal", True,
      Session(DESK, layouts=DESK_FILE + "[layouts.docked]\n")(dl.use, dl.UseArgs("docked")).startswith("exit: display-layout: /"))

# --- list

s = Session(DESK_DP2_ROW, layouts=DESK_FILE)
check("list marks the layouts that fit, whatever the ports, through match",
      ("fits  desk-tall  arzopa, hp, laptop\nfits  desk-top   arzopa, hp, laptop\n      docked     arzopa, hp\n", True),
      (s(dl.list_, dl.ListArgs()), "match" in s.calls))
check("with the lid closed the panel is not part of the set",
      "      desk-tall  arzopa, hp, laptop\n      desk-top   arzopa, hp, laptop\nfits  docked     arzopa, hp\n",
      Session(DOCKED, lid_closed=True, layouts=DESK_FILE)(dl.list_, dl.ListArgs()))
check("list --json", [{"name": "desk-tall", "fits": False, "monitors": ["arzopa", "hp", "laptop"]},
                      {"name": "desk-top", "fits": False, "monitors": ["arzopa", "hp", "laptop"]},
                      {"name": "docked", "fits": True, "monitors": ["arzopa", "hp"]}],
      json.loads(Session(DOCKED, lid_closed=True, layouts=DESK_FILE)(dl.list_, dl.ListArgs(json=True))))
s = Session(DESK)
check("list with nothing saved says how to save", f"no layouts in {s.path}; display-layout save NAME saves the one on screen\n",
      s(dl.list_, dl.ListArgs()))

# --- show


def head(show, lid_closed=False, layouts=DESK_FILE, recent=()):
    return Session(show, lid_closed=lid_closed, layouts=layouts, recent=list(recent))(dl.show, dl.ShowArgs()).split("\n")[0]


check("show names the layout on screen, used or not", "desk-tall, as saved", head(DESK))
check("of two identical layouts, the one used last",
      "desk-copy, as saved", head(DESK, layouts=DESK_FILE + DESK_TALL.replace("desk-tall", "desk-copy"),
                                   recent=["desk-copy"]))
check("with the lid closed", "docked, as saved", head(DOCKED, lid_closed=True))
check("a screen no layout matches, with none used, is not a saved layout", "not a saved layout", head(ROW))
TOP = (0, 0, FOUR_THIRDS, "90")  # the ARZOPA in desk-top
for what, show, changed in (
    ("a monitor moved", desk(arzopa=(0, 100, FOUR_THIRDS, "90")), "arzopa moved"),
    ("a monitor turned", desk(arzopa=(0, 0, FOUR_THIRDS, "270")), "arzopa turned"),
    ("a monitor rescaled", desk(arzopa=TOP, hp=(1200, 0, 1.25, "normal"), laptop=(1200, 864, FOUR_THIRDS, "normal")),
     "hp rescaled, laptop moved"),
    ("another primary", desk(arzopa=TOP, primary="HDMI-1"), "hp made primary"),
    ("another mode", desk(arzopa=TOP, laptop_mode="2560x1600@60.000"), "laptop in another mode"),
):
    check(f"show names what changed since the layout last used: {what}",
          f"last used with these monitors: desk-top; since then {changed}", head(show, recent=["desk-top"]))

s = Session(DESK, layouts=DESK_FILE)
out = s(dl.show, dl.ShowArgs())
check("show draws through cells", (True, drawing(TALL)), ("cells" in s.calls, out.split("\n\n", 1)[1].rstrip("\n")))
check("show draws a mirror as one screen", "not a saved layout",
      head(gdctl_show([LAPTOP, HP], [("eDP-1+HDMI-1", 0, 0, 1.0, "normal", True)])))
report = json.loads(Session(desk(arzopa=(0, 100, FOUR_THIRDS, "90")), layouts=DESK_FILE, recent=["desk-top"])(
    dl.show, dl.ShowArgs(json=True)))
check("show --json names the layout and what changed", ("desk-top", ["arzopa moved"], False),
      (report["layout"], report["changed"], report["is_mutter_row"]))
check("colour in a terminal, outline with NO_COLOR or out of one", (True, False, False), tuple(
    "\x1b[" in Session(DESK, layouts=DESK_FILE, terminal=terminal, no_color=no_color)(dl.show, dl.ShowArgs())
    for terminal, no_color in ((True, False), (True, True), (False, False))
))

# --- the layouts file

commented = """\
# my desks
[aliases]
laptop = { vendor = "AUO", product = "0xc199" }  # the panel
hp = { vendor = "HPN", product = "HP M27fwa FHD" }

[layouts.solo]
laptop = { x = 1600, y = 180, mode = "2560x1600@165.040", primary = true }
hp = { x = 0, y = 0, mode = "1920x1080@60.000" }
"""
check("a monitor's entry reads with its defaults: scale 1, transform normal, not primary",
      (dl.Screen("laptop", LAPTOP[5], 1600, 180, primary=True), dl.Screen("hp", HP[5], 0, 0)),
      dl.parse_store(commented).layouts["solo"])
big = (dl.Screen("laptop", LAPTOP[5], 1600, 180, 2.0, "180", True),)
rewritten = dl.with_layout(commented, "solo-big", big, {})
check("writing a layout keeps the file's comments", (True, True), ("# my desks" in rewritten, "# the panel" in rewritten))
check("and reads back as written", big, dl.parse_store(rewritten).layouts["solo-big"])


def refusal(text):
    try:
        dl.parse_store(text)
        return "accepted"
    except dl.StoreError as exc:
        return str(exc)
    except Exception as exc:  # noqa: BLE001  reported as a failed check
        return f"crash: {type(exc).__name__}: {exc}"


for what, text, message in (
    ("an alias no [aliases] entry defines", commented.replace('hp = { vendor = "HPN", product = "HP M27fwa FHD" }\n', ""),
     "layout solo, hp: no such alias in [aliases]"),
    ("a layout without a primary", commented.replace(", primary = true", ""),
     "layout solo: exactly one monitor has primary = true"),
    ("a misspelt key", commented.replace("primary", "primay"),
     "layout solo, laptop: unknown key primay; keys are x, y, mode, scale, transform, primary"),
    ("a transform gdctl does not know", commented.replace("primary = true", 'primary = true, transform = "sideways"'),
     "layout solo, laptop: transform is one of normal, 90, 180, 270, flipped, flipped-90, flipped-180, flipped-270"),
    ("a mode that is not one", commented.replace("2560x1600@165.040", "2560x1600"),
     "layout solo, laptop: mode is WIDTHxHEIGHT@RATE as gdctl show prints it, not '2560x1600'"),
    ("a table it does not know", commented + "[monitors]\n", "unknown table monitors; there are [aliases] and [layouts.<name>]"),
    ("a position that is not a number", commented.replace("x = 0,", "x = true,"), "layout solo, hp: x = True is not int"),
    ("[aliases] that is not a table", 'aliases = "laptop"\n', "aliases is a table: [aliases]"),
):
    check(f"the file is refused for {what}", message, refusal(text))
check("a layout copied without renaming it is refused", True,
      refusal(commented + commented[commented.index("[layouts.solo]"):]) != "accepted")

# --- the drawing
#
# The laptop left of a turned ARZOPA, 40 columns across 1920 + 1200 logical px,
# so a cell is 78 px. The panel's columns are those whose centre lies left of
# 1920: 0 to 24. Its rows of cells run from 360 / 78 to 1560 / 78, cells 5 to 19,
# and a text row holds two cells, so its box takes the text rows whose top cell
# is its own: 3 to 9.

travel = (dl.Screen("laptop", LAPTOP[5], 0, 360, FOUR_THIRDS, primary=True),
          dl.Screen("arzopa", ARZOPA[5], 1920, 0, FOUR_THIRDS, "90"))
drawn = dl.draw(travel, 40, None).splitlines()
check("an outline to scale, heavy for the primary", (3, 9, 0, 24), (
    next((r for r, line in enumerate(drawn) if line.startswith("┏")), None),
    next((r for r, line in enumerate(drawn) if line.startswith("┗")), None),
    drawn[3].find("┏"), drawn[3].find("┓"),
))
check("the turned monitor spans the height, 15 columns", ("╭" + "─" * 13 + "╮", "╰" + "─" * 13 + "╯"),
      (drawn[0][25:], drawn[-1][25:]))
check("labels sit inside: alias, ★ on the primary, logical size, ↻ for turned right",
      ["┃       laptop ★        ┃│   arzopa    │", "┃       1920×1200       ┃│ 1200×1920 ↻ │"], drawn[5:7])
check("↺ for turned left", True,
      "1200×1920 ↺" in dl.draw((travel[0], replace(travel[1], transform="270")), 40, None))


def styled(line):
    """(foreground, background, character) for each character of a line of coloured drawing."""
    out, fg, bg = [], None, None
    for code, text in re.findall(r"\x1b\[([0-9;]*)m|(.)", line):
        if text:
            out.append((fg, bg, text))
            continue
        fields = [int(f) for f in code.split(";") if f] or [0]
        if fields == [0]:
            fg = bg = None
        for i, f in enumerate(fields):
            if f in (38, 48) and fields[i + 1] == 2:
                colour = "#" + "".join(f"{n:02x}" for n in fields[i + 2 : i + 5])
                fg, bg = (colour, bg) if f == 38 else (fg, colour)
    return out


# The same two, and a monitor with no colour of its own below the laptop.
three = travel + (dl.Screen("dell", HP[5], 0, 1560),)
colours = dl.palette(["laptop", "arzopa", "dell"])
lines = [styled(line) for line in dl.draw(three, 40, colours).splitlines()]
sage, slate, spare = dl.EARTH["laptop"], dl.EARTH["arzopa"], dl.MORE_EARTH[0]
check("each alias its own earth colour, the next spare for one the palette lacks",
      {"laptop": sage, "arzopa": slate, "dell": spare}, colours)
check("blocks fill each monitor in its colour", (sage, slate, spare),
      (lines[5][10][1], lines[8][30][1], lines[16][10][1]))
check("a blank column between neighbours", (" ", sage), (lines[5][24][2], lines[5][23][1]))
text = ["".join(c for _, _, c in line) for line in lines]
row = next((r for r, t in enumerate(text) if "laptop ★" in t), None)
check("labels in sand on their monitor's fill", (dl.SAND, sage),
      lines[row][text[row].index("laptop")][:2] if row is not None else None)

tall = (dl.Screen("arzopa", ARZOPA[5], 0, 0, 1.0, "90"), dl.Screen("laptop", LAPTOP[5], 0, 2560, 1.0, primary=True))
check("a tall arrangement stays within MAX_ROWS in a wide terminal", True,
      len(dl.draw(tall, dl.fit_width(tall, 200), None).splitlines()) <= dl.MAX_ROWS)
check("a wide one within MAX_COLUMNS", dl.MAX_COLUMNS, dl.fit_width((dl.Screen("hp", HP[5], 0, 0, primary=True),), 200))

# --- the watcher
#
# follow() runs over a startup look plus one MonitorsChanged per change, in a
# Session: the gdctl show fixtures, the lid, the layouts file and the recent
# record. Acting only on a change of the connected set is the guard that keeps
# it off a hand-made arrangement, and the one thing a forced layout on a live
# display cannot exercise: forcing a layout does not change the set.


def drive(startup, *changes, **session):
    """The Session the watcher ran in, over `startup` and then each of `changes`."""
    s = Session(startup, *changes, **session)
    crashed = s(lambda _: dl.follow(["MonitorsChanged\n"] * len(changes), 0), None)
    if crashed:
        check("the watcher ran without crashing", "", crashed)
    return s


# With no layouts file, only mutter's row is replaced.
check("a row the set did not change into is left alone", 0, len(drive(STACKED, ROW).applied))
check("a row a new monitor brought is arranged", 1, len(drive(PANEL_ONLY, ROW).applied))
s = drive(PANEL_ONLY, STACKED)
check("a new monitor already arranged is left alone, and the log says why",
      (0, ("skip", "no saved layout fits, and the layout is not mutter's row", {"monitors": ["HDMI-1", "eDP-1"]})),
      (len(s.applied), s.logs[-1]))
check("the same row twice is arranged once", 1, len(drive(PANEL_ONLY, ROW, ROW).applied))
# Docking before the session starts means no signal is coming; the startup look
# is the only chance to catch it.
check("a row already on screen at startup is arranged", 1, len(drive(ROW).applied))
# Giving up after one rejection would leave the row until the next plug.
check("a rejected apply is retried on the next signal", 2, len(drive(ROW, ROW, rejects=99).applied))

# The desk from the named-layouts part, desk-tall on screen, the ARZOPA on DP-1 at first.
HP_LAPTOP_ROW = gdctl_show([HP, LAPTOP], [("HDMI-1", 0, 0, 1.0, "normal", False),
                                          ("eDP-1", 1920, 0, FOUR_THIRDS, "normal", True)])
TALL_ON = lambda port: {port: (0, 180, FOUR_THIRDS, "90", False, ARZOPA[5]),  # noqa: E731
                        "HDMI-1": (1200, 0, 1.0, "normal", False, HP[5]),
                        "eDP-1": (1200, 1080, FOUR_THIRDS, "normal", True, LAPTOP[5])}
TOP_ON = lambda port: TALL_ON(port) | {port: (0, 0, FOUR_THIRDS, "90", False, ARZOPA[5])}  # noqa: E731

s = drive(DESK, HP_LAPTOP_ROW, DESK_DP2_ROW, layouts=DESK_FILE, recent=["desk-tall", "desk-top"])
check("the ARZOPA unplugged, then plugged into the other port, lands on its last-used layout",
      [TALL_ON("DP-1"), {"HDMI-1": (0, 0, 1.0, "normal", False, HP[5]),
                         "eDP-1": (0, 1080, FOUR_THIRDS, "normal", True, LAPTOP[5])}, TALL_ON("DP-2")],
      [groups(a) for a in s.applied])
check("every look goes through decide, and matches through match", (3, True),
      (s.calls.count("decide"), "match" in s.calls))
check("one run-log line per change of the set, naming the layout applied",
      [("ok", "applied desk-tall, last used with these monitors",
        {"monitors": ["DP-1", "HDMI-1", "eDP-1"], "layout": "desk-tall"}),
       ("ok", "no saved layout fits; replaced mutter's row", {"monitors": ["HDMI-1", "eDP-1"]}),
       ("ok", "applied desk-tall, last used with these monitors",
        {"monitors": ["DP-2", "HDMI-1", "eDP-1"], "layout": "desk-tall"})],
      s.logs)
check("the watcher never passes --persistent", [], [a for argv in s.applied for a in argv if a in ("-P", "--persistent")])

# The watcher carries out what decide returns, whatever that is.
canned = dl.Decision(frozenset({("DP-9", dl.Model("X", "Y"))}), dl.Recall("canned", ("--canned",)), "why not")
with mock.patch.object(dl, "decide", lambda *a, **k: canned):
    s = Session(DESK)
    s(lambda _: dl.follow([], 0), None)
check("the watcher applies what decide chose, and logs it",
      ([["--canned"]], [("ok", "applied canned, why not", {"monitors": ["DP-9"], "layout": "canned"})]),
      (s.applied, s.logs))

moved = desk(arzopa=(0, 100, FOUR_THIRDS, "90"))
s = drive(DESK, moved, desk(arzopa=(0, 40, FOUR_THIRDS, "90")), layouts=DESK_FILE, recent=["desk-tall"])
check("an arrangement made during the session is left alone while the set stays, and not logged",
      ([TALL_ON("DP-1")], 1), ([groups(a) for a in s.applied], len(s.logs)))
s = drive(DESK, moved, HP_LAPTOP_ROW, moved, layouts=DESK_FILE, recent=["desk-tall"])
check("and replaced once the set changes", TALL_ON("DP-1"), groups(s.applied[-1]))


def used(names, show):
    """A show read after `use` has put `names` in the recent record."""
    return lambda session: (session.write_recent(names), show)[1]


s = drive(DESK, HP_LAPTOP_ROW, used(["desk-top", "desk-tall"], DESK_DP2_ROW), layouts=DESK_FILE, recent=["desk-tall"])
check("the recent record is read at each change, so a layout used since is the one put back",
      TOP_ON("DP-2"), groups(s.applied[-1]))

s = drive(DESK_DP2_ROW, layouts=DESK_FILE, recent=["docked", "desk-top"])
check("docked before the session starts, the startup look applies the last-used layout",
      ([TOP_ON("DP-2")], ["applied desk-top, last used with these monitors"]),
      ([groups(a) for a in s.applied], [log[1] for log in s.logs]))

s = drive(DESK_DP2_ROW, layouts=DESK_FILE)
check("a set with saved layouts, none used yet, gets the first that fits, which is then the one last used",
      (["applied desk-tall, saved for these monitors, none used yet"], ["desk-tall"]),
      ([log[1] for log in s.logs], s.recent))
s.shows = [desk("DP-2", arzopa=(0, 100, FOUR_THIRDS, "90"))]
check("so show names it once a monitor is moved", "last used with these monitors: desk-tall; since then arzopa moved",
      s(dl.show, dl.ShowArgs()).split("\n")[0])

s = drive(DOCKED.replace("DP-1", "DP-2"), layouts=DESK_FILE, recent=["desk-tall", "docked"], lid_closed=True)
check("with the lid closed, the lid-closed layout", ["docked"], [log[2].get("layout") for log in s.logs])
s = drive(DESK, DOCKED, layouts=DESK_FILE, recent=["desk-tall", "docked"], lid_closed=[False, True])
check("closing the lid changes the connected set", ["desk-tall", "docked"], [log[2].get("layout") for log in s.logs])

# Twin ARZOPAs, told apart by serial, swap ports and nothing else changes.
TWIN_FILE = """
[aliases]
laptop = { vendor = "AUO", product = "0xc199" }
arzopa = { vendor = "GWD", product = "ARZOPA", serial = "0x0000a001" }
arzopa-2 = { vendor = "GWD", product = "ARZOPA", serial = "0x0000a002" }

[layouts.twins]
laptop = { x = 0, y = 0, mode = "2560x1600@165.040", primary = true }
arzopa = { x = 2560, y = 0, mode = "2560x1600@59.997" }
arzopa-2 = { x = 5120, y = 0, mode = "2560x1600@59.997" }
"""
swapped = TWINS.replace("0x0000a001", "SWAP").replace("0x0000a002", "0x0000a001").replace("SWAP", "0x0000a002")
s = drive(TWINS, swapped, layouts=TWIN_FILE, recent=["twins"])
check("twins swapping ports is a change of the set, and each goes back to its place",
      [{"DP-1": 2560, "DP-2": 5120}, {"DP-2": 2560, "DP-1": 5120}],
      [{c: g[0] for c, g in groups(a).items() if c != "eDP-1"} for a in s.applied])

s = drive(DESK_DP2_ROW, layouts=DESK_FILE, recent=["desk-tall"], rejects=1)
check("a layout mutter rejects is logged by name, and the next that fits is applied",
      (TOP_ON("DP-2"), [("fail", "desk-tall rejected: mutter rejected the configuration; "
                                 "applied desk-top, saved for these monitors, none used yet",
                         {"monitors": ["DP-2", "HDMI-1", "eDP-1"], "layout": "desk-top"})]),
      (groups(s.applied[-1]), s.logs))
s = drive(DESK_DP2_ROW, DESK_DP2_ROW, layouts=DESK_FILE, recent=["desk-tall"], rejects=99)
check("when every layout and the fallback are rejected, all are tried again on the next signal", 6, len(s.applied))

s = drive(PANEL_ONLY, ROW, ROW, layouts="[layouts.solo]\n")
check("a broken layouts file is logged once per change of the set, and the fallback still applies",
      (["fail", "fail"], 1), ([log[0] for log in s.logs], len(s.applied)))
check("in the same line as what the look did", True,
      s.logs[-1][1].endswith("layout solo lists no monitors; no saved layout fits; replaced mutter's row"))

print()
print("FAILED" if failures else "all ok")
sys.exit(1 if failures else 0)
