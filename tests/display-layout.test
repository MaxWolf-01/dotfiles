    ("a mirror", gdctl_show([LAPTOP, HP], [("eDP-1+HDMI-1", 0, 0, 1.0, "normal", True)]), False,
     "eDP-1 and HDMI-1 mirror each other, and a layout cannot hold a mirror"),
    ("the panel on with the lid closed", DESK, True,
