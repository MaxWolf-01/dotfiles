<form action="examinationreg.action" method="post"><input type="hidden" name="token" value="t"/>
<table><tr align="left"><th>Auswahl</th><th>Prüfung</th><th>Datum</th><th>Zeit/Ort</th><th>SKZ</th></tr>
 <tr class="darkcell"><td valign="top" rowspan="2"><input type="checkbox" name="examreg_action.273351"/></td>
  <td><strong>Machine Learning: Basic Techniques
     (365074,2026W)</strong></td><td>04.02.2027</td><td>15:30 - 17:00 Uhr/HS 1 </td>
  <td><select name="skz.273351"><option value="376" selected="selected">033 536</option></select></td></tr>
 <tr class="darkcell"><td colspan="4"><small>Maximale TeilnehmerInnenzahl: 200 &#8226; Bisherige Anmeldungen: 87
   &#8226; Abmeldeschluss: Mo. 01.02.2027 23:59 <br/> Anmeldezeitraum: 03.08.2026 00:00 - 01.02.2027 23:59</small></td></tr>
 <tr class="darkcell"><td colspan="5"></td></tr>
 <tr class="lightcell"><td valign="top" rowspan="2">--</td>
  <td><strong>Reinforcement Learning (344156,2026W)</strong></td><td>25.02.2027</td><td>13:45 - 15:15 Uhr/Linz/ Vienna/ Bregenz </td><td>--</td></tr>
 <tr class="lightcell"><td colspan="4"><small>Maximale TeilnehmerInnenzahl: 100 &#8226; Bisherige Anmeldungen: 0
   <span class="error_icon">&#8226; Abmeldeschluss: Do. 25.02.2027 13:45 <br/> Anmeldezeitraum: 04.02.2027 18:00 - 18.02.2027 13:45</span></small></td></tr>
 <tr class="lightcell"><td colspan="5"></td></tr>
 <tr class="darkcell"><td valign="top" rowspan="2">--</td>
  <td><strong>Statistics for AI (366590,2026S)</strong></td><td>30.10.2026</td><td>12:00 - 13:30 Uhr/Vienna </td><td>--</td></tr>
 <tr class="darkcell"><td colspan="4"><small><span class="error_icon">Maximale TeilnehmerInnenzahl: 65 &#8226; Bisherige Anmeldungen: 65</span>
   &#8226; Abmeldeschluss: So. 25.10.2026 23:59 <br/> Anmeldezeitraum: 27.07.2026 00:00 - 25.10.2026 23:59</small></td></tr>
 <tr class="darkcell"><td colspan="5">Gilt für [536]:<br/><span class="info_icon">Ein Hinweis zum Antritt.</span></td></tr>
 <tr><td colspan="5" align="right"><input type="submit" value="Zur ausgewählten Prüfung ANMELDEN"/></td></tr>
</table></form>
<h3>Aktuelle Prüfungsanmeldungen</h3>
<form action="examinationregunreg.action" method="post"><input type="hidden" name="token" value="t"/>
<table><tr><td colspan="5"><a href="ical-multi-form-sz.action"><img src="/common/kusss/pics/icon_ical.gif"/></a></td></tr>
 <tr align="left"><th>Prüfung</th><th>Datum</th><th>Zeit/Ort</th><th>SKZ</th><th>An-/Abmelden</th></tr>
 <tr class="darkcell"><td><strong>Statistics for AI  (366595,2026S)</strong></td><td><o>30.10.2026<o></td>
  <td><o>14:45 -
     16:15 Uhr/JKU HS1 <o></td><td><o>033 536 <a href="change-curr-of-student-examreg.action?examRegId=1569853"><img/></a><o></td>
  <td><input type="submit" name="signoff_registration_action.1569853" value="Abmelden"/></td></tr>
 <tr class="darkcell"><td colspan="5"><o>Maximale TeilnehmerInnenzahl: unbeschränkt &#8226; Bisherige Anmeldungen: 37
   &#8226; Abmeldeschluss: So. 25.10.2026 23:59 Anmeldezeitraum: Mo. 27.07.2026 00:00 - So. 25.10.2026 23:59</o></td></tr>
 <tr class="darkcell"><td colspan="5"></td></tr>
</table></form>"""

k, wire = session({("GET", ME + "szsearchexam.action"): (ME + "szsearchexam.action", page(EXAMS))})
got = kusss.read_mine(k, ("k", "pw"))["exams"]
check("an exam he can register for, with its window and deregistration deadline", {
    "course": "Machine Learning: Basic Techniques", "lva_nr": "365.074", "semester": "2026W", "date": "2027-02-04",
    "start": "2027-02-04T15:30", "end": "2027-02-04T17:00", "place": "HS 1", "capacity": 200, "registrations": 87,
    "registration_opens": "2026-08-03T00:00", "registration_closes": "2027-02-01T23:59", "deregistration_deadline": "2027-02-01T23:59",
    "status": "open", "notes": []}, got[0])
check("one whose window has not opened is outside-window", ("outside-window", "2027-02-04T18:00", "2027-02-18T13:45"),
      (got[1]["status"], got[1]["registration_opens"], got[1]["registration_closes"]))
check("a full one is full, and keeps KUSSS's note", ("full", 65, ["Gilt für [536]: Ein Hinweis zum Antritt."]),
      (got[2]["status"], got[2]["registrations"], got[2]["notes"]))
check("one he is registered for is registered, unlimited seats as null", {
    "course": "Statistics for AI", "lva_nr": "366.595", "semester": "2026S", "date": "2026-10-30", "start": "2026-10-30T14:45",
    "end": "2026-10-30T16:15", "place": "JKU HS1", "capacity": None, "registrations": 37, "registration_opens": "2026-07-27T00:00",
    "registration_closes": "2026-10-25T23:59", "deregistration_deadline": "2026-10-25T23:59", "status": "registered", "notes": []}, got[3])
check("the exam search goes out as a GET with exactly its two parameters",
      [{"search": "true", "searchType": "mylvas"}], [p for m, u, p in wire.sent if u == ME + "szsearchexam.action" and m == "GET"])

# --- grades and the fee

GRADES = """
<h3>Vorläufige Lehrveranstaltungsbeurteilungen</h3>
<table><tr><th><abbr>Datum</abbr></th><th><strong><abbr><strong>Titel</strong></abbr></strong></th><th><abbr>Note</abbr></th><th><abbr>Kurzbez.</abbr></th>
 <th><abbr>Typ</abbr></th><th><abbr>ECTS</abbr></th><th><abbr>SWSt</abbr></th><th><abbr>SKZ</abbr></th></tr>
 <tr class="darkcell"><td colspan="8">Keine Noten vorhanden</td></tr></table>
<h3>Lehrveranstaltungsbeurteilungen</h3>
<table><tr><th>Datum</th><th>Titel</th><th>Note</th><th>Kurzbez.</th><th>Typ</th><th>ECTS</th><th>SWSt</th><th>SKZ</th></tr>
 <tr><td>30.01.2026</td><td>Algorithmen und Datenstrukturen 2 (340328,2025W) Programmiersprache: Python</td><td>gut</td><td>INBIPUEALG2</td><td>UE</td><td>1,50</td><td>1,00</td><td>536</td></tr></table>
<h3>Anerkannte Beurteilungen</h3>
<table><tr><th>Datum</th><th>Titel</th><th>Note</th><th>Kurzbez.</th><th>Typ</th><th>ECTS</th><th>SWSt</th><th>SKZ</th></tr>
 <tr><td>24.11.2025</td><td>Technology and Society (anerkannt)</td><td>mit Erfolg teilgenommen</td><td>536AISOTASK19</td><td>KV</td><td>3,00</td><td>2,00</td><td>536</td></tr></table>"""
FEE = '{"state":"PAID","urlZulassung":"","termId":"2026W","obligationToPay":false,"totalFeeAmount":0.0,"paymentPeriodEnd":null}'
k, wire = session({
    ("GET", ME + "gradeinfo.action"): (ME + "gradeinfo.action", page(GRADES)),
    ("GET", ME + "outbound/myjku/fee"): (MYJKU + "/fee", "<html>myJKU</html>"),
    ("GET", MYJKU + "/api2/student/fee"): (MYJKU + "/api2/student/fee", FEE),
})
out = kusss.read_mine(k, ("k", "pw"))
check("each grade carries its list, its course number and semester, and what follows them", [
    {"kind": "Lehrveranstaltungsbeurteilungen", "date": "2026-01-30", "title": "Algorithmen und Datenstrukturen 2", "lva_nr": "340.328",
     "semester": "2025W", "info": "Programmiersprache: Python", "grade": "gut", "course_class": "INBIPUEALG2", "type": "UE", "ects": 1.5, "sws": 1.0, "skz": "536"},
    {"kind": "Anerkannte Beurteilungen", "date": "2025-11-24", "title": "Technology and Society (anerkannt)", "lva_nr": None, "semester": None,
     "info": None, "grade": "mit Erfolg teilgenommen", "course_class": "536AISOTASK19", "type": "KV", "ects": 3.0, "sws": 2.0, "skz": "536"},
], out["grades"])
check("the fee as myJKU reports it", {"semester": "2026W", "state": "PAID", "paid": True, "owed": False, "amount": 0.0, "payment_deadline": None}, out["fee"])
check("pages that are not what it reads are gaps, not empty lists passed off as none",
      ["courses", "exams"], [g["where"] for g in out["gaps"]])
k, wire = session({("GET", ME + "outbound/myjku/fee"): ("https://shibboleth.im.jku.at/idp/profile/SAML2/Redirect/SSO?execution=e2s1", page("Login to myJKU"))})
out = kusss.read_mine(k, ("k", "pw"))
check("a myJKU sign-in that does not reach myJKU is a gap", (None, True), (out["fee"], any(g["where"] == "fee" for g in out["gaps"])))

sys.exit(1 if failures else 0)
