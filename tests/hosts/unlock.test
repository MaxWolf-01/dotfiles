#!/usr/bin/env bash
# tier: fast
# Drive `hosts unlock` (bin/hosts) against a machines list of its own, with a stand-in ssh that logs what it was asked and
# what it was handed, and a stand-in sops that decrypts a secret to its own name. Run it directly; no framework.
#
# What max relies on: the machines with an unlock are the ones the list gives steps to, each step run in order at
# the ssh destination the machine's entry names and handed what the step says, an unlock stops at the step that
# fails, and a machine with none is refused before anything is sent anywhere.

set -uo pipefail

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../bin" && pwd)"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

. "$(dirname "${BASH_SOURCE[0]}")/../check.sh"
needs jq

mkdir -p "$scratch/bin"
# It fails the step named in $scratch/fail, after logging it.
cat >"$scratch/bin/ssh" <<EOF
#!/usr/bin/env bash
echo "\$* < \$(cat)" >>"$scratch/ssh.log"
[ "\$*" != "\$(cat "$scratch/fail" 2>/dev/null)" ]
EOF
printf '#!/bin/sh\necho "secret:$(basename "$2")"\n' >"$scratch/bin/sops"
chmod +x "$scratch/bin/ssh" "$scratch/bin/sops"
export PATH="$scratch/bin:$PATH"
echo age-key >"$scratch/age-key.txt"
export SOPS_AGE_KEY_FILE="$scratch/age-key.txt"

# Each machine reached at an alias of its own; pc's steps as pc's entry has them, a desk machine with nothing locked.
export MACHINES_FILE="$scratch/machines.json"
cat >"$MACHINES_FILE" <<'JSON'
[
  {"name": "pc", "ssh": "pc-alias", "unlock": [
    {"run": ["host-unlock-receive", "age-key"], "secret": null, "ageKey": true},
    {"run": ["host-unlock-receive", "ssh-key"], "secret": "ssh-passphrase-pc", "ageKey": false},
    {"run": ["host-unlock-receive", "zfs", "phone"], "secret": "zfs-phone-general", "ageKey": false},
    {"run": ["host-unlock-receive", "finish"], "secret": null, "ageKey": false}]},
  {"name": "zephylux", "ssh": "zephylux", "unlock": []},
  {"name": "xmg19", "ssh": "xmg-alias", "unlock": [
    {"run": ["sudo", "host-unlock-receive"], "secret": "xmg19-home-luks", "ageKey": false}]}
]
JSON

unlock() { : >"$scratch/ssh.log"; out=$("$bin/hosts" unlock "$1" 2>&1); status=$?; }

unlock xmg19
check "xmg19's home key goes to its entry's ssh destination, through sudo" \
    "0 xmg-alias sudo host-unlock-receive < secret:xmg19-home-luks" "$status $(cat "$scratch/ssh.log")"

unlock pc
check "pc's steps run in order at its entry's ssh destination, each handed the age key, its secret or nothing" \
    "0 pc-alias host-unlock-receive age-key < age-key
pc-alias host-unlock-receive ssh-key < secret:ssh-passphrase-pc
pc-alias host-unlock-receive zfs phone < secret:zfs-phone-general
pc-alias host-unlock-receive finish < " "$status $(cat "$scratch/ssh.log")"

echo "pc-alias host-unlock-receive ssh-key" >"$scratch/fail"
unlock pc
check "a step that fails stops the unlock there, names the step, and the steps after it are never sent" \
    "1 hosts unlock: 'host-unlock-receive ssh-key' on pc-alias failed; the steps after it were not run
pc-alias host-unlock-receive age-key < age-key
pc-alias host-unlock-receive ssh-key < secret:ssh-passphrase-pc" "$status $out
$(cat "$scratch/ssh.log")"
rm "$scratch/fail"

rm "$SOPS_AGE_KEY_FILE"
unlock pc
check "with no age key to hand over, pc is refused before anything is sent" \
    "2 hosts: no age key at $SOPS_AGE_KEY_FILE ssh:0" "$status $out ssh:$(wc -l <"$scratch/ssh.log")"

unlock zephylux
check "a machine the list gives no unlock is refused, naming those it gives one, and nothing is sent" \
    "2 hosts: no unlock known for 'zephylux' (pc, xmg19) ssh:0" "$status $out ssh:$(wc -l <"$scratch/ssh.log")"

unlock athena
check "...and so is a machine the list does not hold" \
    "2 hosts: no unlock known for 'athena' (pc, xmg19) ssh:0" "$status $out ssh:$(wc -l <"$scratch/ssh.log")"

finish
