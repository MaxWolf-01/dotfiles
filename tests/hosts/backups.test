#!/usr/bin/env bash
# tier: fast
# Run `hosts backups` (bin/hosts) in a scratch copy of the repo's layout, whose timer files and machines list are its
# own. Run it directly; no framework.
#
# What the watchdog and the backups dashboard rely on: each backup is named under the host whose timer file runs it,
# that file being the one the host's entry in the machines list names; a backup two hosts run is refused, since the
# watchdog could not tell whose run log to read; and a list that names none is refused rather than answered with
# nothing, which would read as "no host runs any backup".

set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

. "$repo/tests/check.sh"
needs jq

mkdir -p "$scratch/bin" "$scratch/nix/home"
cp "$repo/bin/hosts" "$repo/bin/restic-config-name" "$scratch/bin/"
cat >"$scratch/nix/home/desk-timers.nix" <<'EOF'
  ExecStart = "${dotfiles}/backup/restic_backup.sh ${secrets}/backup/restic/working/rsyncnet.conf";
  ExecStart = "${dotfiles}/backup/restic_backup.sh ${secrets}/backup/restic/working/box.conf";
EOF
cat >"$scratch/nix/home/box-timers.nix" <<'EOF'
  ExecStart = "${dotfiles}/backup/restic_backup.sh ${secrets}/backup/restic/phone/rsyncnet.conf";
EOF

hosts() { # <machines list as JSON>
    echo "$1" >"$scratch/machines.json"
    out=$(MACHINES_FILE="$scratch/machines.json" "$scratch/bin/hosts" backups 2>&1)
    status=$?
}

hosts '[{"name": "desk", "timers": "nix/home/desk-timers.nix"}, {"name": "box", "timers": "nix/home/box-timers.nix"},
        {"name": "vault", "timers": null}]'
check "each backup is named under the host whose entry names the timer file that runs it; a host with none runs none" \
    "0 phone-rsyncnet	box
working-box	desk
working-rsyncnet	desk" "$status $out"

echo '  ExecStart = "${dotfiles}/backup/restic_backup.sh ${secrets}/backup/restic/working/box.conf";' \
    >>"$scratch/nix/home/box-timers.nix"
hosts '[{"name": "desk", "timers": "nix/home/desk-timers.nix"}, {"name": "box", "timers": "nix/home/box-timers.nix"}]'
[ "$status" -eq 2 ] && [[ $out == *"more than one host: working-box"* ]] &&
    passed "a backup two hosts' timer files run is refused, naming it" ||
    fail "a backup two hosts' timer files run is refused, naming it" "$status $out"

hosts '[{"name": "vault", "timers": null}]'
[ "$status" -eq 2 ] && [[ $out == *"names a timer file"* ]] &&
    passed "a list in which no machine names a timer file is refused" ||
    fail "a list in which no machine names a timer file is refused" "$status $out"

rm "$scratch/machines.json"
out=$(MACHINES_FILE="$scratch/machines.json" "$scratch/bin/hosts" backups 2>&1)
status=$?
[ "$status" -eq 2 ] && [[ $out == *"no machines list at $scratch/machines.json"* ]] &&
    passed "no machines list is refused, naming where it was looked for" ||
    fail "no machines list is refused, naming where it was looked for" "$status $out"

finish
