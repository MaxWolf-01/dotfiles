#!/usr/bin/env bash
# Drive bin/diffview end to end and check the generated page. Run it directly; no framework.
#
# The contract under test: both source modes (git range, OLD=NEW paths) produce a
# self-contained page whose embedded data carries the right files, statuses and
# commits. What the page does with that data in a browser is tests/diffview-page.test's.

set -uo pipefail

# real shells pin the browser via this var; the --open checks stub xdg-open, so force that path
export DIFFVIEW_BROWSER=""

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
diffview="$bin/diffview"
work=$(mktemp -d)
free_port() { python3 -c "import socket;s=socket.socket();s.bind(('127.0.0.1',0));print(s.getsockname()[1])"; }

# a container hub of the test's own, never the one on 8377, with a home of its own outside $work
# so $work can be served whole; uv keeps its real directories, or the hub resolves its dependencies anew
hubhome=$(mktemp -d)
uvcache=$(uv cache dir)
uvpython=$(uv python dir)
export CONTAINER_HUB_PORT
CONTAINER_HUB_PORT=$(free_port)
hub="http://127.0.0.1:$CONTAINER_HUB_PORT"
HOME="$hubhome" UV_CACHE_DIR="$uvcache" UV_PYTHON_INSTALL_DIR="$uvpython" setsid "$bin/container-hub" --port "$CONTAINER_HUB_PORT" --state "$hubhome/state" \
    > "$hubhome/hub.log" 2>&1 &
hubpid=$!
downport=$(free_port)   # where a hub is down until a diffview brings one up
cleanup() {
    kill -- "-$hubpid" 2>/dev/null
    pkill -f "container-hub --port $downport" 2>/dev/null
    rm -rf "$work" "$hubhome"
}
trap cleanup EXIT
for _ in $(seq 300); do curl -sf -o /dev/null "$hub/.health" && break; sleep 0.2; done

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# a Python expression over a page's data: data is all of it, f the file at path (None for an empty path),
# baked(side) the sha256 of that image version as baked, "none" when the card has no such version,
# "unbaked SIZE" when it was left out
field() {
    python3 - "$@" <<'EOF'
import base64, hashlib, json, sys
page, path, expr = sys.argv[1:]
text = open(page).read()
data, _ = json.JSONDecoder().raw_decode(text, text.index("const DATA = ") + len("const DATA = "))
f = next((f for s in data["sources"] for f in s["files"] if f["path"] == path), None)
def baked(side):
    v = (f.get("image") or {}).get(side)
    return "none" if v is None else hashlib.sha256(base64.b64decode(v["src"].split(",", 1)[1])).hexdigest() if "src" in v else f"unbaked {v['size']}"
print(eval(expr))
EOF
}
datum() { field "$1" "" "$2"; }   # page, then an expression over its data alone
paths() { datum "$1" "' | '.join(f['path'] for s in data['sources'] for f in s['files'])"; }
added() { field "$1" "$2" "[ln[3] for h in f['hunks'] for ln in h['lines'] if ln[0] == 1]"; }   # page, path: its added lines

# --- OLD=NEW: two plain files, no git metadata

printf 'alpha\nbeta\ngamma\n' > "$work/old.txt"
printf 'alpha\nBETA\ngamma\ndelta\n' > "$work/new.txt"
out=$("$diffview" "$work/old.txt=$work/new.txt" -o "$work/files.html" --no-auto-summary)
check "file=file exits 0" 0 $?
check "file=file counts" "1 files, +2 -1" "$(grep -o '[0-9]* files, +[0-9]* -[0-9]*' <<<"$out")"
check "the changed lines are in the page, under the file's basename" "['BETA', 'delta']" "$(added "$work/files.html" new.txt)"

# --- the session the page was rendered for: the origin a separate process was handed wins over its own id

session() { datum "$work/session.html" "data['session']"; }
env -u MX_ORIGIN_SESSION -u CLAUDE_CODE_SESSION_ID "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "outside a session the page names none" '' "$(session)"
env -u MX_ORIGIN_SESSION CLAUDE_CODE_SESSION_ID=own "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "a session names itself" own "$(session)"
MX_ORIGIN_SESSION=origin CLAUDE_CODE_SESSION_ID=own "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "a separate process names the session it works for" origin "$(session)"
# the resume command enters the directory the session's transcript records, when it is still there
resume() { datum "$work/session.html" "data['resume']"; }
mkdir -p "$work/claude/projects/p"
env -u MX_ORIGIN_SESSION CLAUDE_CONFIG_DIR="$work/claude" CLAUDE_CODE_SESSION_ID=own "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "a session with no transcript here resumes from anywhere" 'claude --resume own' "$(resume)"
printf '{"type":"summary"}\n{"type":"user","cwd":"%s"}\n' "$work" > "$work/claude/projects/p/own.jsonl"
env -u MX_ORIGIN_SESSION CLAUDE_CONFIG_DIR="$work/claude" CLAUDE_CODE_SESSION_ID=own "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "a session resumes in the directory it ran in, under its account's config dir" \
    "cd $work && CLAUDE_CONFIG_DIR=$work/claude claude --resume own" "$(resume)"
printf '{"type":"user","cwd":"%s"}\n' "$work/gone" > "$work/claude/projects/p/own.jsonl"
env -u MX_ORIGIN_SESSION CLAUDE_CONFIG_DIR="$work/claude" CLAUDE_CODE_SESSION_ID=own "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "a session whose directory is gone resumes from anywhere" "CLAUDE_CONFIG_DIR=$work/claude claude --resume own" "$(resume)"
# run without a config dir, as the container hub's user service is, every account's transcripts are looked through
mkdir -p "$work/accounts/.claude-work/projects/p" "$work/accounts/.claude/projects/p"
printf '{"type":"user","cwd":"%s"}\n' "$work" > "$work/accounts/.claude-work/projects/p/own.jsonl"
env -u MX_ORIGIN_SESSION -u CLAUDE_CONFIG_DIR HOME="$work/accounts" UV_CACHE_DIR="$(uv cache dir)" UV_PYTHON_INSTALL_DIR="$(uv python dir)" \
    CLAUDE_CODE_SESSION_ID=own "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "a session of another account resumes under that account" \
    "cd $work && CLAUDE_CONFIG_DIR=$work/accounts/.claude-work claude --resume own" "$(resume)"
mv "$work/accounts/.claude-work/projects/p/own.jsonl" "$work/accounts/.claude/projects/p/own.jsonl"
env -u MX_ORIGIN_SESSION -u CLAUDE_CONFIG_DIR HOME="$work/accounts" UV_CACHE_DIR="$(uv cache dir)" UV_PYTHON_INSTALL_DIR="$(uv python dir)" \
    CLAUDE_CODE_SESSION_ID=own "$diffview" "$work/old.txt=$work/new.txt" -o "$work/session.html" --no-auto-summary >/dev/null
check "and one of ~/.claude names no config dir" "cd $work && claude --resume own" "$(resume)"

# --- highlight.js: every file is checked against its pin, cached or fetched

hl="$work/hljs"
version=$(grep -oP '^HLJS_VERSION = "\K[^"]+' "$diffview")
mkdir -p "$hl/.cache/diffview/hljs-$version" "$hl/.cache/diffview/hljs-0.0.1"
# offline: the proxy refuses, so a fetch fails rather than replacing what the cache holds
highlighted() {
    env HOME="$hl" UV_CACHE_DIR="$(uv cache dir)" UV_PYTHON_INSTALL_DIR="$(uv python dir)" https_proxy=http://127.0.0.1:9 \
        "$diffview" "$work/old.txt=$work/new.txt" -o "$work/hljs.html" --no-auto-summary 2>&1 >/dev/null
}
echo 'window.TAMPERED = 1' > "$hl/.cache/diffview/hljs-$version/highlight.min.js"
err=$(highlighted)
check "a cached highlight.js that differs from its pin is refused on stderr" yes \
    "$(grep -q "hljs-$version/highlight.min.js does not match its pinned sha256" <<<"$err" && echo yes)"
check "and the page renders without it" "0 new.txt" "$(grep -c TAMPERED "$work/hljs.html") $(paths "$work/hljs.html")"
rm "$hl/.cache/diffview/hljs-$version/highlight.min.js"
echo 'window.TAMPERED = 1' > "$hl/.cache/diffview/hljs-0.0.1/highlight.min.js"
echo 'window.TAMPERED = 1' > "$hl/.cache/diffview/highlight.min.js"   # where every version was cached before
err=$(highlighted)
check "a file cached for another version is not reused: the pinned one is fetched" "0 yes" \
    "$(grep -c TAMPERED "$work/hljs.html") $(grep -q "could not fetch .*cdn-release@$version/build/highlight.min.js" <<<"$err" && echo yes)"

# --- git range: a real repo with an edit, a rename, and two commits

repo="$work/repo"
git init -q "$repo"
printf 'untouched one\nuntouched two\n' > "$repo/c.txt"   # in every range's tree, in no range's diff
git -C "$repo" add c.txt
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m base
printf 'one\ntwo\n' > "$repo/a.txt"
git -C "$repo" add a.txt
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m "add a.txt"
git -C "$repo" mv a.txt b.txt
printf 'one\ntwo\nthree\n' > "$repo/b.txt"
git -C "$repo" add b.txt
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m "rename and extend"

out=$("$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --summary "test summary paragraph")
check "git range exits 0" 0 $?
check "both commits embedded, oldest first" "['add a.txt', 'rename and extend']" "$(datum "$work/range.html" "[c['subject'] for c in data['sources'][0]['commits']]")"
check "summary embedded" "test summary paragraph" "$(datum "$work/range.html" "data['summary']")"

"$diffview" "$repo@HEAD~1..HEAD" -o "$work/rename.html" --no-auto-summary >/dev/null
check "rename detected over the renaming range" "renamed a.txt" "$(field "$work/rename.html" b.txt "f['status'] + ' ' + f['oldPath']")"

# --- a path with a space in it: git tab-terminates the name in the diff header

spacerepo="$work/spacerepo"
git init -q "$spacerepo"
mkdir -p "$spacerepo/dir with space"
printf 'SELECT 1;\n' > "$spacerepo/dir with space/q.sql"
git -C "$spacerepo" add "dir with space/q.sql"
git -C "$spacerepo" -c user.name=t -c user.email=t@t commit -q -m base
printf 'SELECT 2;\n' > "$spacerepo/dir with space/q.sql"
git -C "$spacerepo" add "dir with space/q.sql"
git -C "$spacerepo" -c user.name=t -c user.email=t@t commit -q -m edit
"$diffview" "$spacerepo@HEAD~1..HEAD" -o "$work/space.html" --no-auto-summary >/dev/null
check "a path with a space does not keep the tab git ends it with" "dir with space/q.sql" "$(paths "$work/space.html")"
check "and with it the language it is highlighted in" sql "$(field "$work/space.html" "dir with space/q.sql" "f['lang']")"

# a note names the path git prints, so a path read wrong takes the note to a file of its own
cat > "$work/space-notes.json" <<'EOF'
{"notes": [{"id": 1, "path": "dir with space/q.sql", "text": "a note that has to find this file"}]}
EOF
"$diffview" "$spacerepo@HEAD~1..HEAD" -o "$work/space-note.html" --no-auto-summary --notes "$work/space-notes.json" >/dev/null
check "and a note naming it lands on the file, not beside it" "dir with space/q.sql" "$(paths "$work/space-note.html")"

# --- a binary file: it has no ---/+++ lines, so the `diff --git` header is the only place its path appears

binrepo="$work/binrepo"
git init -q "$binrepo"
mkdir -p "$binrepo/dir with space"   # which makes that header ambiguous
printf 'read me\n' > "$binrepo/readme.txt"
git -C "$binrepo" add readme.txt
git -C "$binrepo" -c user.name=t -c user.email=t@t commit -q -m base
printf '\x89PNG\r\n\x1a\n\x00\x01' > "$binrepo/dir with space/img.png"
git -C "$binrepo" add "dir with space/img.png"
git -C "$binrepo" -c user.name=t -c user.email=t@t commit -q -m "add the image"
printf '\x89PNG\r\n\x1a\n\x00\x02\x03' > "$binrepo/dir with space/img.png"
git -C "$binrepo" add "dir with space/img.png"
git -C "$binrepo" -c user.name=t -c user.email=t@t commit -q -m "change the image"

out=$("$diffview" "$binrepo@HEAD~1..HEAD" -o "$work/binary.html" --no-auto-summary)
check "a changed binary file reaches the page" "1 files, +0 -0" "$(grep -o '[0-9]* files, +[0-9]* -[0-9]*' <<<"$out")"
check "under the whole path, not a half of it" "dir with space/img.png" "$(paths "$work/binary.html")"
check "marked binary, so the page shows a card instead of hunks" True "$(field "$work/binary.html" "dir with space/img.png" "f['binary']")"

"$diffview" "$binrepo@HEAD~2..HEAD~1" -o "$work/binary-add.html" --no-auto-summary >/dev/null
check "an added binary file too" "added True" "$(field "$work/binary-add.html" "dir with space/img.png" "f['status'] + ' ' + str(f['binary'])")"

# a mode change has no ---/+++ lines and no hunks either, so there is no gap for a baked copy of the file to open
chmod +x "$binrepo/readme.txt"
git -C "$binrepo" add readme.txt
git -C "$binrepo" -c user.name=t -c user.email=t@t commit -q -m "make it executable"
"$diffview" "$binrepo@HEAD~1..HEAD" -o "$work/mode.html" --no-auto-summary >/dev/null
check "a mode-only change reaches the page" readme.txt "$(paths "$work/mode.html")"
check "carrying no copy of the file" None "$(field "$work/mode.html" readme.txt "f.get('content')")"

printf '\x89PNG\r\n\x1a\n\x00\x01' > "$work/before.png"
printf '\x89PNG\r\n\x1a\n\x00\x02\x03' > "$work/after.png"
"$diffview" "$work/before.png=$work/after.png" -o "$work/binary-files.html" --no-auto-summary >/dev/null
check "and a file=file compare of two binaries, under the new side's name" after.png "$(paths "$work/binary-files.html")"

# --- images: every version a card shows is baked into the page, byte for byte as the source holds it

baked() { field "$1" "$2" "baked('$3') + ' ' + baked('$4')"; }   # page, path, then the two sides to name
digest() { sha256sum "$1" | cut -d' ' -f1; }

# the expectations are digests of the bytes this test wrote, never of what git or diffview hands back
check "a file=file compare takes each version from its own file" "$(digest "$work/before.png") $(digest "$work/after.png")" "$(baked "$work/binary-files.html" after.png old new)"
check "a text file carries no image" False "$(field "$work/range.html" b.txt "'image' in f")"

imgrepo="$work/imgrepo"
commit() { git -C "$imgrepo" add -A; git -C "$imgrepo" -c user.name=t -c user.email=t@t commit -q -m "$1"; }
git init -q -b main "$imgrepo"
mkdir -p "$imgrepo/sub"
printf '\x89PNG\x00kept one' > "$imgrepo/kept.png"; kept1=$(digest "$imgrepo/kept.png")
printf '\x89PNG\x00gone' > "$imgrepo/gone.png"; gone=$(digest "$imgrepo/gone.png")
printf '\x89PNG\x00moving' > "$imgrepo/before.png"; moving=$(digest "$imgrepo/before.png")
printf '\x89PNG\x00still' > "$imgrepo/sub/still.png"; still=$(digest "$imgrepo/sub/still.png")
printf '<svg xmlns="http://www.w3.org/2000/svg"/>\n' > "$imgrepo/logo.svg"; svg1=$(digest "$imgrepo/logo.svg")
commit base
printf '\x89PNG\x00kept two' > "$imgrepo/kept.png"; kept2=$(digest "$imgrepo/kept.png")
rm "$imgrepo/gone.png"
git -C "$imgrepo" mv before.png after.png
printf '<svg xmlns="http://www.w3.org/2000/svg"><rect/></svg>\n' > "$imgrepo/logo.svg"; svg2=$(digest "$imgrepo/logo.svg")
head -c 5242880 /dev/zero > "$imgrepo/limit.png"; limit=$(digest "$imgrepo/limit.png")   # 5 MiB, the most a page bakes
head -c 5242881 /dev/zero > "$imgrepo/huge.png"                                           # one byte more
commit change

"$diffview" "$imgrepo@HEAD~1..HEAD" -o "$work/images.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 1, "path": "sub/still.png", "text": "left alone"}]}') >/dev/null
check "a modified image carries both versions as committed" "$kept1 $kept2" "$(baked "$work/images.html" kept.png old new)"
check "a deleted image its old version only" "$gone none" "$(baked "$work/images.html" gone.png old new)"
check "a renamed image finds its old version under the old name" "$moving $moving" "$(baked "$work/images.html" after.png old new)"
check "an SVG carries both versions" "$svg1 $svg2" "$(baked "$work/images.html" logo.svg old new)"
check "and keeps its text hunks" True "$(field "$work/images.html" logo.svg "bool(f['hunks'])")"
check "an image of exactly the limit is baked" "none $limit" "$(baked "$work/images.html" limit.png old new)"
check "one byte over it is left out, its size kept for the card to name" "none unbaked 5242881" "$(baked "$work/images.html" huge.png old new)"
check "a note on an image outside the diff brings it in whole, with no lines to open" "untouched [] none $still" \
    "$(field "$work/images.html" sub/still.png "f['status'] + ' ' + str(f['hunks']) + ' ' + baked('old') + ' ' + baked('new')")"

# A...B compares against where the branch forked: main moving on afterwards changes nothing on the page
git -C "$imgrepo" checkout -q -b feature
printf '\x89PNG\x00kept on the branch' > "$imgrepo/kept.png"; kept_branch=$(digest "$imgrepo/kept.png")
commit "branch edit"
git -C "$imgrepo" checkout -q main
printf '\x89PNG\x00kept on main later' > "$imgrepo/kept.png"; kept_main=$(digest "$imgrepo/kept.png")
commit "main moves on"
"$diffview" "$imgrepo@main...feature" -o "$work/images-fork.html" --no-auto-summary >/dev/null
check "A...B takes an image's old version from the fork point" "$kept2 $kept_branch" "$(baked "$work/images-fork.html" kept.png old new)"
"$diffview" "$imgrepo@main..feature" -o "$work/images-tips.html" --no-auto-summary >/dev/null
check "A..B from A itself" "$kept_main $kept_branch" "$(baked "$work/images-tips.html" kept.png old new)"

# a worktree compare reads the new version off the disk, from the repo's root whichever directory the spec names
printf '\x89PNG\x00kept on disk' > "$imgrepo/kept.png"; kept_disk=$(digest "$imgrepo/kept.png")
printf '\x89PNG\x00fresh' > "$imgrepo/fresh.png"; fresh=$(digest "$imgrepo/fresh.png")
ln -s nowhere.png "$imgrepo/broken.png"   # git lists a link to nothing, and there are no bytes behind it
"$diffview" "$imgrepo/sub@HEAD.." -o "$work/images-worktree.html" --no-auto-summary >/dev/null
check "a worktree compare takes the new version off the disk" "$kept_main $kept_disk" "$(baked "$work/images-worktree.html" kept.png old new)"
check "an untracked image too" "none $fresh" "$(baked "$work/images-worktree.html" fresh.png old new)"
check "an image with nothing to read keeps no size, for its card to say so" "none unbaked None" "$(baked "$work/images-worktree.html" broken.png old new)"
git -C "$imgrepo" checkout -q -- kept.png
rm "$imgrepo/fresh.png" "$imgrepo/broken.png"

git -C "$imgrepo" checkout -q feature
printf '\x89PNG\x00kept on the branch, uncommitted' > "$imgrepo/kept.png"; kept_wip=$(digest "$imgrepo/kept.png")
"$diffview" "$imgrepo@main..." -o "$work/images-branch.html" --no-auto-summary >/dev/null
check "A... takes the old version from the fork point and the new one off the disk" "$kept2 $kept_wip" "$(baked "$work/images-branch.html" kept.png old new)"
git -C "$imgrepo" checkout -q -- kept.png
git -C "$imgrepo" checkout -q main

mkdir -p "$work/imgs-old" "$work/imgs-new"
printf '\x89PNG\x00old' > "$work/imgs-old/pic.png"
printf '\x89PNG\x00new' > "$work/imgs-new/pic.png"
"$diffview" "$work/imgs-old=$work/imgs-new" -o "$work/images-dirs.html" --no-auto-summary >/dev/null
check "a directory compare takes each version from its own directory" "$(digest "$work/imgs-old/pic.png") $(digest "$work/imgs-new/pic.png")" \
    "$(baked "$work/images-dirs.html" pic.png old new)"

# a rev's version is what a checkout writes, through the repo's filters: Git LFS keeps only a pointer in the blob
smudgerepo="$work/smudgerepo"
git init -q "$smudgerepo"
git -C "$smudgerepo" config filter.upper.smudge 'tr a-z A-Z'
git -C "$smudgerepo" config filter.upper.clean cat
echo '*.png filter=upper' > "$smudgerepo/.gitattributes"
printf '\x89PNG\x00pointer one' > "$smudgerepo/pic.png"
git -C "$smudgerepo" add -A
git -C "$smudgerepo" -c user.name=t -c user.email=t@t commit -q -m one
printf '\x89PNG\x00pointer two' > "$smudgerepo/pic.png"
git -C "$smudgerepo" add -A
git -C "$smudgerepo" -c user.name=t -c user.email=t@t commit -q -m two
printf '\x89PNG\x00POINTER ONE' > "$work/smudged-one"
printf '\x89PNG\x00POINTER TWO' > "$work/smudged-two"
"$diffview" "$smudgerepo@HEAD~1..HEAD" -o "$work/images-smudged.html" --no-auto-summary >/dev/null
check "a rev's version comes through the smudge filter a checkout would run" "$(digest "$work/smudged-one") $(digest "$work/smudged-two")" \
    "$(baked "$work/images-smudged.html" pic.png old new)"

# --- a text file in another encoding: git prints the bytes as stored, and what is no UTF-8 shows as U+FFFD

latinrepo="$work/latinrepo"
git init -q "$latinrepo"
printf 'caf\xe9\n' > "$latinrepo/menu.txt"
git -C "$latinrepo" add menu.txt
git -C "$latinrepo" -c user.name=t -c user.email=t@t commit -q -m base
printf 'caf\xe9 cr\xe8me\n' > "$latinrepo/menu.txt"
git -C "$latinrepo" add menu.txt
git -C "$latinrepo" -c user.name=t -c user.email=t@t commit -q -m "$(printf 'cr\xe8me on the menu')"   # the commit list reads Latin-1 too
"$diffview" "$latinrepo@HEAD~1..HEAD" -o "$work/latin.html" --no-auto-summary >/dev/null 2>&1
check "a Latin-1 text file renders" 0 $?
check "its bytes that are no UTF-8 show as U+FFFD (here as ?)" 'caf? cr?me' \
    "$(field "$work/latin.html" menu.txt "[ln[3] for h in f['hunks'] for ln in h['lines'] if ln[0] == 1][0].replace(chr(0xfffd), '?')")"

# --- worktree range: trailing '..' includes uncommitted changes

printf 'four\n' >> "$repo/b.txt"
"$diffview" "$repo@HEAD.." -o "$work/worktree.html" --no-auto-summary >/dev/null
check "worktree range exits 0" 0 $?
check "uncommitted line is in the page" "['four']" "$(added "$work/worktree.html" b.txt)"
check "detail names the worktree" HEAD..worktree "$(datum "$work/worktree.html" "data['sources'][0]['detail']")"
git -C "$repo" checkout -q -- b.txt
"$diffview" "$repo@$(git -C "$repo" rev-parse HEAD~1)..$(git -C "$repo" rev-parse HEAD)" -o "$work/fullids.html" --no-auto-summary >/dev/null
check "full commit ids in a range show abbreviated" \
    "$(git -C "$repo" rev-parse --short HEAD~1)..$(git -C "$repo" rev-parse --short HEAD)" \
    "$(datum "$work/fullids.html" "data['sources'][0]['detail']")"
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/pinned.html" --no-auto-summary >/dev/null
check "the copyable spec pins a range's ends to commits" \
    "$repo@$(git -C "$repo" rev-parse --short HEAD~1)..$(git -C "$repo" rev-parse --short HEAD)" \
    "$(datum "$work/pinned.html" "data['sources'][0]['spec']")"
check "and a worktree range's base, leaving its right side open" \
    "$repo@$(git -C "$repo" rev-parse --short HEAD).." \
    "$(datum "$work/worktree.html" "data['sources'][0]['spec']")"
check "an OLD=NEW spec is both absolute paths" "$work/old.txt=$work/new.txt" \
    "$(datum "$work/files.html" "data['sources'][0]['spec']")"

# --- agent notes: inline annotations and agent-side resolutions from --notes

cat > "$work/notes.json" <<'EOF'
{"notes": [{"id": 1, "path": "b.txt", "line": "3", "text": "kept the old order on purpose"},
           {"id": 7, "path": "b.txt", "text": "this file carries the feature"}],
 "resolved": ["C2", 5]}
EOF
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/notes.html" --no-auto-summary --notes "$work/notes.json" >/dev/null
check "notes generation exits 0" 0 $?
check "notes embedded, a string line coerced to a number, gapped ids kept verbatim" \
    "[(1, 3, 'kept the old order on purpose'), (7, None, 'this file carries the feature')]" \
    "$(datum "$work/notes.html" "[(n['id'], n.get('line'), n['text']) for n in data['notes']]")"
check "agent resolutions normalise to numbers" "[2, 5]" "$(datum "$work/notes.html" "data['agentResolved']")"
echo 'not json' > "$work/bad.json"
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary --notes "$work/bad.json" >/dev/null 2>&1
check "malformed notes fail loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"path": "b.txt", "text": "no id"}]}') >/dev/null 2>&1
check "a note without an id fails loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 1, "path": "b.txt", "text": "a"}, {"id": 1, "path": "b.txt", "text": "b"}]}') >/dev/null 2>&1
check "duplicate note ids fail loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [], "resolved": ["nope"]}') >/dev/null 2>&1
check "a bad resolved id fails loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '[{"id": 1, "path": "b.txt", "text": "old bare-list schema"}]') >/dev/null 2>&1
check "the old bare-list schema fails loud" 1 $?
err=$("$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 1, "path": "nope.txt", "text": "hi"}]}') 2>&1 >/dev/null)
check "a note path in no source warns" yes "$(grep -q "path 'nope.txt' is in no source" <<<"$err" && echo yes)"
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/untouched.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 1, "path": "c.txt", "line": 2, "text": "outside the diff"}]}') >/dev/null
check "a note on a file outside the diff puts that file on the page" untouched "$(field "$work/untouched.html" c.txt "f['status']")"
check "the untouched file carries the noted line" True "$(field "$work/untouched.html" c.txt "any(ln[3] == 'untouched two' for h in f['hunks'] for ln in h['lines'])")"

# a note answering a comment needs no place of its own: the comment's file and lines fill in
cat > "$work/answer.html.state.json" <<'EOF'
{"savedAt": 1, "nextId": 2, "viewed": [], "verdict": [],
 "comments": [{"id": 1, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 3, "end": 3, "text": "why?", "excerpt": ["+ three"]}]}
EOF
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/answer.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 2, "re": "C1", "text": "because"}]}') >/dev/null
answer() { datum "$work/answer.html" "' '.join(str(data['notes'][0].get(k)) for k in $1)"; }
check "a note answering a comment inherits its file" "1 because b.txt" "$(answer "('re', 'text', 'path')")"
check "and its lines" "new 3 3" "$(answer "('side', 'line', 'end')")"
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 2, "re": "C9", "text": "answering nothing"}]}') >/dev/null 2>&1
check "a note answering a comment that is not on the page fails loud" 1 $?

# --- a note naming its source lands in that source's section, whichever other section shows its path

for twin in twin1 twin2; do
    git init -q "$work/$twin"
    printf 'title\n' > "$work/$twin/README.md"
    printf 'same everywhere\n' > "$work/$twin/same.txt"   # in both trees, in neither diff
    git -C "$work/$twin" add -A
    git -C "$work/$twin" -c user.name=t -c user.email=t@t commit -q -m base
    printf '%s title\n' "$twin" > "$work/$twin/README.md"
    git -C "$work/$twin" -c user.name=t -c user.email=t@t commit -q -am edit
done
cat > "$work/twin-notes.json" <<EOF
{"notes": [{"id": 1, "path": "README.md", "line": 1, "text": "about twin2's readme", "source": "$work/twin2"},
           {"id": 2, "path": "same.txt", "text": "read in twin2, left alone", "source": "$work/twin2/"},
           {"id": 3, "path": "README.md", "line": 1, "text": "no source named"}]}
EOF
"$diffview" "$work/twin1@HEAD~1..HEAD" "$work/twin2@HEAD~1..HEAD" -o "$work/twins.html" --no-auto-summary \
    --notes "$work/twin-notes.json" >/dev/null
check "a note's source is written as its section's root" "$(git -C "$work/twin2" rev-parse --show-toplevel)" \
    "$(field "$work/twins.html" README.md "next(n['source'] for n in data['notes'] if n['id'] == 1)")"
check "a note without a source has none written for it" None \
    "$(field "$work/twins.html" README.md "next(n.get('source') for n in data['notes'] if n['id'] == 3)")"
check "an untouched file a note names joins its source's section only" "[False, True]" \
    "$(field "$work/twins.html" README.md "[any(f['path'] == 'same.txt' for f in s['files']) for s in data['sources']]")"
"$diffview" "$work/twin1@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary --notes "$work/twin-notes.json" >/dev/null 2>&1
check "a note naming a source the page does not show fails loud" 1 $?
cat > "$work/twins-answer.html.state.json" <<'EOF'
{"savedAt": 1, "nextId": 2, "viewed": [], "verdict": [],
 "comments": [{"id": 1, "fileKey": "1:README.md", "hi": 0, "side": "new", "start": 1, "end": 1, "text": "why?", "excerpt": ["+ twin2 title"]}]}
EOF
"$diffview" "$work/twin1@HEAD~1..HEAD" "$work/twin2@HEAD~1..HEAD" -o "$work/twins-answer.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 2, "re": "C1", "text": "because"}]}') >/dev/null
check "a note answering a comment inherits its section too" "$(git -C "$work/twin2" rev-parse --show-toplevel)" \
    "$(field "$work/twins-answer.html" README.md "data['notes'][0]['source']")"
"$diffview" "$work/twin1@HEAD~1..HEAD" "$work/twin2@HEAD~1..HEAD" -o "$work/twins-answer.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 2, "re": "C1", "path": "same.txt", "text": "the answer is in the other file"}]}') >/dev/null
check "but not one placed on a file of its own" None \
    "$(field "$work/twins-answer.html" README.md "data['notes'][0].get('source')")"

# --- --sources-of: what a rendered page shows, as the page pins it

check "--sources-of prints each section's pinned spec" \
    "$(git -C "$work/twin1" rev-parse --show-toplevel)@$(git -C "$work/twin1" rev-parse --short HEAD~1)..$(git -C "$work/twin1" rev-parse --short HEAD)
$(git -C "$work/twin2" rev-parse --show-toplevel)@$(git -C "$work/twin2" rev-parse --short HEAD~1)..$(git -C "$work/twin2" rev-parse --short HEAD)" \
    "$("$diffview" --sources-of "$work/twins.html")"
echo '<html>not a page</html>' > "$work/not-a-page.html"
"$diffview" --sources-of "$work/not-a-page.html" >/dev/null 2>&1
check "--sources-of on a file that is no diffview page fails" 1 $?

# --- '@..' and '..' resolve to HEAD..worktree instead of crashing

printf 'five\n' >> "$repo/b.txt"
"$diffview" "$repo@.." -o "$work/atwt.html" --no-auto-summary >/dev/null
check "empty-base worktree range works" 0 $?
check "empty base means HEAD" HEAD..worktree "$(datum "$work/atwt.html" "data['sources'][0]['detail']")"
git -C "$repo" checkout -q -- b.txt

# --- saved review state beside the page is baked into rebuilds

cat > "$work/range.html.state.json" <<EOF
{"key": "diffview:repo@HEAD~2..HEAD", "savedAt": 1, "nextId": 2, "viewed": [],
 "comments": [{"id": 1, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 3, "end": 3,
               "text": "state survives a rebuild", "excerpt": ["+ three"]}]}
EOF
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null
saved() { datum "$1" "[c['text'] for c in data['saved']['comments']]"; }   # page: the texts of the comments baked into it
check "saved comments baked into the page" "['state survives a rebuild']" "$(saved "$work/range.html")"
echo '[]' > "$work/range.html.state.json"
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null 2>&1
check "non-object state file does not crash the build" 0 $?
cat > "$work/range.html.state.json" <<EOF
{"key": "diffview:repo@HEAD~2..HEAD", "savedAt": 2, "nextId": 2, "viewed": [],
 "comments": [{"id": 1, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 3, "end": 3,
               "text": "sneaky <!--<script> comment", "excerpt": ["+ three"]}]}
EOF
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null
check "comment openers cannot break the page script, and come back as typed" "0 ['sneaky <!--<script> comment']" \
    "$(grep -c '<!--<script' "$work/range.html") $(saved "$work/range.html")"
rm -f "$work/range.html.state.json"
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null

# --- the page's path is the review's identity

key1=$(datum "$work/range.html" "data['key']")
check "the page keys on its own path" "$work/range.html" "$key1"
"$diffview" "$repo@HEAD~2..HEAD" "$repo@HEAD~1..HEAD" -o "$work/range.html" --no-auto-summary --summary "s" >/dev/null
check "a later round adding a range keeps that identity" "$key1" "$(datum "$work/range.html" "data['key']")"

# --- derived output: one page per source list, so parallel renders never collide

d1=$(HOME="$work" "$diffview" "$repo@HEAD~2..HEAD" --no-auto-summary | head -1 | awk '{print $1}')
d2=$(HOME="$work" "$diffview" "$repo@HEAD~2..HEAD" --no-auto-summary | head -1 | awk '{print $1}')
d3=$(HOME="$work" "$diffview" "$repo@HEAD~1..HEAD" --no-auto-summary | head -1 | awk '{print $1}')
check "same specs derive the same page" "$d1" "$d2"
check "different specs derive different pages" yes "$([ "$d1" != "$d3" ] && echo yes)"
check "derived pages land under Downloads/diffview" yes "$(case "$d1" in "$work"/Downloads/diffview/*) echo yes;; esac)"
check "a derived name carries no range to mis-copy" yes "$(grep -qE '/repo-[0-9a-f]{8}\.html$' <<<"$d1" && echo yes)"
check "a derived page is served by the hub, so its url can take comments" yes "$(HOME="$work" "$diffview" "$repo@HEAD~2..HEAD" --no-auto-summary | tail -1 | grep -qE "^$hub/f$work/Downloads/diffview/repo-[0-9a-f]{8}\.html\$" && echo yes)"

# the displacing render is the moment comments are about to be stranded, so it says so
echo '{"savedAt":1,"comments":[{"id":1}],"viewed":[],"nextId":2,"verdict":[]}' > "$d1.state.json"
warned=$(HOME="$work" "$diffview" "$repo@HEAD~1..HEAD" --no-auto-summary 2>&1 >/dev/null)
check "a page displacing one that holds comments says so" yes "$(grep -q 'holds comments this one will not' <<<"$warned" && echo yes)"
rm -f "$d1.state.json"
check "and stays quiet when the earlier page holds none" "" "$(HOME="$work" "$diffview" "$repo@HEAD~1..HEAD" --no-auto-summary 2>&1 >/dev/null)"

d4=$(HOME="$work" "$diffview" "$repo@HEAD~2..HEAD" "$repo@HEAD~1..HEAD" --no-auto-summary | head -1 | awk '{print $1}')
check "a derived page is pinned to its specs, so a grown one differs" yes "$([ "$d1" != "$d4" ] && echo yes)"

mkdir -p "$repo/sub" && touch "$repo/sub/keep"
d5=$(HOME="$work" "$diffview" "$repo/sub@HEAD~2..HEAD" --no-auto-summary | head -1 | awk '{print $1}')
check "a spec written from a subdirectory names the repo's page" "$d1" "$d5"
rm -rf "$repo/sub"

repo2="$work/repo2"; mkdir -p "$repo2"; git -C "$repo2" init -q
for i in 1 2; do echo "line $i" >> "$repo2/a.txt"; git -C "$repo2" add a.txt; git -C "$repo2" commit -qm "c$i"; done
r1=$(HOME="$work" "$diffview" "$repo2@HEAD~1..HEAD" --no-auto-summary | head -1 | awk '{print $1}')
echo "line 3" >> "$repo2/a.txt"; git -C "$repo2" add a.txt; git -C "$repo2" commit -qm c3
r2=$(HOME="$work" "$diffview" "$repo2@HEAD~1..HEAD" --no-auto-summary | head -1 | awk '{print $1}')
check "a HEAD-relative range names a new page once a commit lands" yes "$([ "$r1" != "$r2" ] && echo yes)"

"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null

# --- --open lands on a page that can take comments, not a read-only file

mkdir -p "$work/stub" "$work/pages"
printf '#!/bin/sh\necho "$1" > "%s/opened"\n' "$work/stub" > "$work/stub/xdg-open"
chmod +x "$work/stub/xdg-open"
PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~1..HEAD" -o "$work/pages/o.html" --no-auto-summary --open >/dev/null 2>&1
opened=$(cat "$work/stub/opened")
check "--open opens the page on the container hub" "$hub/f$work/pages/o.html" "$opened"
curl -s -o "$work/served.html" "$opened"   # grep -q on a pipe would cut curl off, which pipefail counts as a failure
check "which serves the page there" "$work/pages/o.html" "$(datum "$work/served.html" "data['key']")"
check "and says the pages it serves can save" True "$(curl -s "$hub/.health" | python3 -c 'import json,sys;print(json.load(sys.stdin)["saves"])')"

PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~1..HEAD" -o "$hubhome/home.html" --no-auto-summary --open >/dev/null 2>&1
check "a page sitting in your home is served on its own" "$hub/f$hubhome/home.html" "$(cat "$work/stub/opened")"
check "and nothing else in your home with it" 403 "$(curl -s -o /dev/null -w '%{http_code}' "$hub/f$hubhome/hub.log")"
refused=$("$diffview" --serve "$hubhome" 2>&1)
check "your home is never served whole" "1 yes" "$? $(grep -q 'never serves whole' <<<"$refused" && echo yes)"
refused=$("$diffview" --serve "$work/nowhere" 2>&1)
check "a path that does not exist is refused before the hub is asked" "1 yes" "$? $(grep -q "^diffview: --serve $work/nowhere does not exist" <<<"$refused" && echo yes)"
# a symlinked home must not walk past that guard: resolve both sides or it does
ln -s "$hubhome" "$work/homelink"
refused=$("$diffview" --serve "$work/homelink" 2>&1)
check "nor through a symlink to it" "1 yes" "$? $(grep -q 'never serves whole' <<<"$refused" && echo yes)"

# a diffview with no hub beside it, and none answering, says so rather than failing
mkdir -p "$work/nohub"
cp "$diffview" "$work/nohub/diffview"
said=$(CONTAINER_HUB_PORT=$(free_port) "$work/nohub/diffview" --serve "$work/pages" 2>&1)
check "a diffview whose hub is gone says it cannot be started" "1 yes" "$? $(grep -q 'could not be started' <<<"$said" && echo yes)"

# something else on the hub's port that refuses the page, in words that are no JSON: the page opens as a file, and says why
refuserport=$(free_port)
mkdir -p "$work/refuser"
timeout 120 python3 -m http.server --bind 127.0.0.1 --directory "$work/refuser" "$refuserport" >/dev/null 2>&1 &
refuser=$!
for _ in $(seq 100); do curl -s -o /dev/null "http://127.0.0.1:$refuserport/" && break; sleep 0.1; done
said=$(CONTAINER_HUB_PORT=$refuserport PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~1..HEAD" -o "$work/pages/refused.html" --no-auto-summary --open 2>&1 >/dev/null)
kill "$refuser"
check "a page the hub's port refuses opens read-only, as its file" "file://$work/pages/refused.html" "$(cat "$work/stub/opened")"
check "...and says who refused it, and why" yes "$(tr '\n' ' ' <<<"$said" | grep -q "127.0.0.1:$refuserport refused it: .*501.*; read-only" && echo yes)"

# the page is opened as one url, not shadowed by a second one naming the read-only file
lines=$(PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~1..HEAD" -o "$work/pages/o.html" --no-auto-summary --open 2>/dev/null | grep -c '^file://')
check "no file:// url is printed alongside the served one" 0 "$lines"

served=$("$diffview" --serve "$work/pages")
check "--serve prints the directory's address on the hub" "diffview: serving $work/pages at $hub/f$work/pages/" "$served"

# --- with no hub answering, --serve brings one up; two at once, from a person and an agent say, leave one

mkdir -p "$work/beat" "$work/downhome"
starts=()
for n in 1 2; do
    HOME="$work/downhome" UV_CACHE_DIR="$uvcache" UV_PYTHON_INSTALL_DIR="$uvpython" CONTAINER_HUB_PORT=$downport \
        "$diffview" --serve "$work/beat" > "$work/beat/start$n" 2>&1 &
    starts+=($!)
done
wait "${starts[@]}"
check "--serve with the hub down starts one and prints the address on it" \
    "diffview: serving $work/beat at http://127.0.0.1:$downport/f$work/beat/ x2" "$(sort -u "$work/beat/start1" "$work/beat/start2") x$(cat "$work/beat/start1" "$work/beat/start2" | grep -c serving)"
for _ in $(seq 50); do [ "$(pgrep -fc "bin/python .*container-hub --port $downport")" -le 1 ] && break; sleep 0.2; done
check "and two at once leave one hub" 1 "$(pgrep -fc "bin/python .*container-hub --port $downport")"
pkill -f "container-hub --port $downport"

# --- the auto summary lands after the page, never before it

cat > "$work/stub/change-summary" <<'STUB'
#!/bin/sh
cat > /dev/null
sleep 1
echo "a stub summary paragraph"
STUB
chmod +x "$work/stub/change-summary"
PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~1..HEAD" -o "$work/async.html" >/dev/null
check "the page holds a slot for the summary" True "$(datum "$work/async.html" "data['summaryPending']")"
check "and is written before that summary exists" no "$([ -f "$work/async.html.summary.json" ] && echo yes || echo no)"
for _ in $(seq 40); do [ -f "$work/async.html.summary.json" ] && break; sleep 0.2; done
check "the summary lands in the sidecar a served page polls" yes "$(grep -q 'a stub summary paragraph' "$work/async.html.summary.json" && echo yes)"
check "and is baked into the page file too, which clears the slot" "a stub summary paragraph False" \
    "$(datum "$work/async.html" "data['summary'] + ' ' + str(data['summaryPending'])")"

# a failed model call belongs in the page, not in a terminal that has moved on
cat > "$work/stub/change-summary" <<'STUB'
#!/bin/sh
cat > /dev/null
echo "change-summary: claude exited 1: not logged in" >&2
exit 1
STUB
err=$(PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~2..HEAD" -o "$work/failed.html" 2>&1 >/dev/null)
for _ in $(seq 40); do [ -f "$work/failed.html.summary.json" ] && break; sleep 0.2; done
check "a failed summary says nothing on the command line" "" "$err"
check "and carries its reason in the sidecar instead" yes "$(grep -q 'not logged in' "$work/failed.html.summary.json" && echo yes)"
check "leaving the page as it was written" True "$(datum "$work/failed.html" "data['summaryPending']")"

# the page is open and commentable for the seconds the model runs, and the rewrite must keep what lands
cat > "$work/stub/change-summary" <<'STUB'
#!/bin/sh
cat > /dev/null
sleep 2
echo "a slow summary paragraph"
STUB
PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~1..HEAD" -o "$work/commented.html" >/dev/null
echo '{"savedAt":1,"comments":[{"id":1,"text":"written while the model ran"}],"viewed":[],"nextId":2,"verdict":[]}' > "$work/commented.html.state.json"
for _ in $(seq 60); do grep -q 'a slow summary paragraph' "$work/commented.html" && break; sleep 0.2; done
check "a comment made while the summary was written survives the rewrite" "a slow summary paragraph ['written while the model ran']" \
    "$(datum "$work/commented.html" "data['summary']") $(saved "$work/commented.html")"

# rendering to the same path again while the model runs makes the page somebody else's
cat > "$work/stub/change-summary" <<'STUB'
#!/bin/sh
cat > /dev/null
sleep 2
echo "a late summary paragraph"
STUB
PATH="$work/stub:$PATH" "$diffview" "$repo@HEAD~1..HEAD" -o "$work/raced.html" >/dev/null
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/raced.html" --no-auto-summary --summary "the newer render" >/dev/null
for _ in $(seq 40); do [ -f "$work/raced.html.summary.json" ] && break; sleep 0.2; done
sleep 0.5
check "a late summary does not clobber the render that replaced it" "the newer render" "$(datum "$work/raced.html" "data['summary']")"
check "though the sidecar still holds it for a page already open" yes "$(grep -q 'a late summary paragraph' "$work/raced.html.summary.json" && echo yes)"
rm -f "$work/stub/change-summary"

echo
if [ "$failures" -eq 0 ]; then echo "all checks passed"; else echo "$failures check(s) FAILED"; exit 1; fi
