#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro", "httpx", "websockets"]
# ///
"""Drive bin/discord-download's archive of server emoji and stickers. Run it directly; no framework.

The promises here: every emoji a run sees lands in all/<server>/ under its name,
nothing in the folder is ever deleted or overwritten, an emoji or server the run
no longer sees stays and shows up in gone/, the ones you uploaded show up in
mine/, and a failed download is tried again on the next run.

What Discord shows is handed in as the page would return it; the CDN is an
httpx MockTransport that answers with the emoji's id, or 404 for the ids in
`broken`.
"""

import json
import sys
import tempfile
from pathlib import Path

import httpx

sys.path.insert(0, str(Path(__file__).resolve().parent))
from check import bin_module, check, finish  # noqa: E402

dd = bin_module("discord-download")

ME = {"id": "1", "name": "max"}
requests: list[str] = []
urls: list[str] = []
broken: set[str] = set()


def cdn(request: httpx.Request) -> httpx.Response:
    urls.append(str(request.url))
    eid = request.url.path.rsplit("/", 1)[-1].split(".")[0]
    requests.append(eid)
    return httpx.Response(404) if eid in broken else httpx.Response(200, content=eid.encode())


def run(out: Path, servers: list[dict], today: str = "2026-10-17", kind=dd.EMOJIS) -> dict:
    requests.clear()
    with httpx.Client(transport=httpx.MockTransport(cdn)) as client:
        dd.archive(kind, {"me": ME["id"], "servers": servers}, out, client, today)
    return json.loads((out / f"{kind.key}.json").read_text())


def emoji(id: str, name: str, animated: bool = False, uploader: dict | None = None) -> dict:
    return {"id": id, "name": name, "animated": animated} | ({"uploader": uploader} if uploader else {})


def files(root: Path) -> list[str]:
    return sorted(str(p.relative_to(root)) for p in root.rglob("*") if p.is_file() or p.is_symlink())


out = Path(tempfile.mkdtemp())
eth = {"id": "10", "name": "ETH D-INFK", "items": [emoji("100", "blob"), emoji("101", "party", animated=True)]}
mine = {"id": "20", "name": "boxy", "items": [emoji("200", "wave", uploader=ME), emoji("201", "nod", uploader={"id": "9", "name": "x"})]}

manifest = run(out, [eth, mine])
check("every emoji lands under its server, a still one as png, an animated one as gif",
      ["all/ETH-D-INFK/blob.png", "all/ETH-D-INFK/party.gif", "all/boxy/nod.png", "all/boxy/wave.png", "mine/boxy/wave.png"],
      [f for f in files(out) if f != "emojis.json"])
check("a file holds what the CDN sent for its id", "101", (out / "all/ETH-D-INFK/party.gif").read_text())
check("mine/ links into all/", (out / "all/boxy/wave.png").resolve(), (out / "mine/boxy/wave.png").resolve())
check("the uploader is kept", "max", manifest["emojis"]["200"]["uploader"])

# A server's emoji removed, another server left, the first one renamed.
eth2 = {"id": "10", "name": "ETH Informatik", "items": [emoji("101", "party", animated=True), emoji("102", "new")]}
manifest = run(out, [eth2], today="2026-10-18")
check("only the new emoji is downloaded", ["102"], requests)
check("nothing is deleted", True, all((out / f).exists() for f in
      ["all/ETH-D-INFK/blob.png", "all/boxy/wave.png", "all/boxy/nod.png"]))
check("a renamed server keeps its folder", "all/ETH-D-INFK/new.png", manifest["emojis"]["102"]["file"])
check("gone/ holds the removed emoji and the left server's",
      ["gone/ETH-D-INFK/blob.png", "gone/boxy/nod.png", "gone/boxy/wave.png"],
      [f for f in files(out) if f.startswith("gone/")])
check("mine/ still holds what you uploaded on a server you left", ["mine/boxy/wave.png"],
      [f for f in files(out) if f.startswith("mine/")])
check("a gone emoji keeps the day it was last seen", ("2026-10-17", False),
      (manifest["emojis"]["100"]["last_seen"], manifest["emojis"]["100"]["accessible"]))
check("a left server reads as no longer a member", False, manifest["servers"]["20"]["member"])

# Back in the server: gone/ shrinks again, removing only symlinks.
(out / "gone/boxy/notes.txt").write_text("mine")
run(out, [eth2, mine], today="2026-10-19")
check("a server rejoined leaves gone/, a file of yours in it stays",
      ["gone/ETH-D-INFK/blob.png", "gone/boxy/notes.txt"], [f for f in files(out) if f.startswith("gone/")])

# Names already taken: by another emoji of the same server, or by a file that was there first.
(out / "all/boxy/hi.png").write_text("not discord's")
taken = {"id": "20", "name": "boxy", "items": [emoji("202", "hi"), emoji("203", "wave")]}
manifest = run(out, [taken])
check("a file already in the folder is not overwritten", "not discord's", (out / "all/boxy/hi.png").read_text())
check("the emoji gets its id appended instead", ("all/boxy/hi-202.png", "all/boxy/wave-203.png"),
      (manifest["emojis"]["202"]["file"], manifest["emojis"]["203"]["file"]))

same_slug = [{"id": "30", "name": "a/b", "items": [emoji("300", "x")]},
             {"id": "31", "name": "a b", "items": [emoji("310", "x")]}]
manifest = run(out, same_slug)
check("two servers whose names fold to one folder get two", ("a-b", "a-b-31"),
      (manifest["servers"]["30"]["folder"], manifest["servers"]["31"]["folder"]))

# A download that fails is tried again.
broken.add("400")
manifest = run(out, [{"id": "40", "name": "flaky", "items": [emoji("400", "late")]}])
check("a failed download leaves no file and no name", (False, None),
      ((out / "all/flaky").exists(), manifest["emojis"]["400"].get("file")))
broken.clear()
manifest = run(out, [{"id": "40", "name": "flaky", "items": [emoji("400", "late")]}])
check("the next run gets it", ("all/flaky/late.png", ["400"]), (manifest["emojis"]["400"]["file"], requests))

# Stickers: the same archive, their names free text, their format deciding file and URL.
out = Path(tempfile.mkdtemp())
stickers = {"id": "50", "name": "boxy", "items": [
    {"id": "500", "name": "aber sichi?", "format": 1}, {"id": "501", "name": "dance", "format": 3},
    {"id": "502", "name": "spin", "format": 4, "uploader": ME}, {"id": "503", "name": "///", "format": 2}]}
urls.clear()
manifest = run(out, [stickers], kind=dd.STICKERS)
check("a sticker's name becomes a safe file name, one with nothing safe in it its id",
      ["all/boxy/503.png", "all/boxy/aber-sichi.png", "all/boxy/dance.json", "all/boxy/spin.gif", "mine/boxy/spin.gif"],
      [f for f in files(out) if f != "stickers.json"])
check("a Lottie sticker comes from discord.com, the rest from media.discordapp.net",
      ["https://discord.com/stickers/501.json", "https://media.discordapp.net/stickers/500.png",
       "https://media.discordapp.net/stickers/502.gif", "https://media.discordapp.net/stickers/503.png"], sorted(urls))
check("the manifest keeps the name as Discord has it", "aber sichi?", manifest["stickers"]["500"]["name"])

finish()
