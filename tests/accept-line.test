#!/usr/bin/env bash
# tier: fast
# Check which lines zsh/plugin-files/accept-line.zsh turns into `o <file>` on Enter, by asking its
# _accept_line_file about lines naming files in a scratch directory.

set -uo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
needs zsh

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
mkdir "$scratch/dir"
touch "$scratch/pic.gif" "$scratch/with space.gif" "$scratch/ls"
printf '#!/bin/sh\n' >"$scratch/script" && chmod +x "$scratch/script"

# opens <line>: the file the line would open, or "-" for a line left as it is. Runs in $scratch.
opens() {
    (cd "$scratch" && HOME="$scratch" zsh -f -c '
        source "$1" 2>/dev/null
        _accept_line_file "$2" && print -r -- "$REPLY" || print -- -
    ' _ "$repo/zsh/plugin-files/accept-line.zsh" "$1")
}

check "absolute path" "$scratch/pic.gif" "$(opens "$scratch/pic.gif")"
check "relative path" "pic.gif" "$(opens "pic.gif")"
check "path under ~" "$scratch/pic.gif" "$(opens "~/pic.gif")"
check "quoted path with a space" "$scratch/with space.gif" "$(opens "'$scratch/with space.gif'")"
check "escaped path with a space" "$scratch/with space.gif" "$(opens "$scratch/with\\ space.gif")"
check "unquoted path with a space" "$scratch/with space.gif" "$(opens "$scratch/with space.gif")"
check "directory is left to autocd" "-" "$(opens "$scratch/dir")"
check "executable runs" "-" "$(opens "$scratch/script")"
check "command name beats a file of that name" "-" "$(opens "ls")"
check "command with a file argument runs" "-" "$(opens "cat pic.gif")"
check "missing file" "-" "$(opens "$scratch/nope.gif")"
check "empty line" "-" "$(opens "")"

finish
