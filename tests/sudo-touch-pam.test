#!/usr/bin/env bash
# tier: fast
# Run bin/sudo-touch-pam on copies of Debian's /etc/pam.d/sudo (the sudo package's, as Ubuntu ships it) in a scratch
# directory. Run it directly; no framework.
#
# What zephylux relies on: the touch comes before the password and never replaces it, so the line is `sufficient`,
# sits once above `@include common-auth`, and a second run changes nothing; and a file it cannot edit safely is
# left exactly as it was.

set -uo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
. "$repo/tests/check.sh"
pam="$repo/bin/sudo-touch-pam"
debian="$repo/tests/fixtures/sudo-touch-pam/debian-sudo"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
line='auth       sufficient pam_u2f.so cue'

cp "$debian" "$scratch/sudo"
chmod 640 "$scratch/sudo"
"$pam" "$scratch/sudo" >/dev/null 2>"$scratch/err" || fail "the script edits Debian's file" "$(cat "$scratch/err")"
check "the touch line is in the file once" 1 "$(grep -cxF "$line" "$scratch/sudo")"
check "it sits directly above @include common-auth" "@include common-auth" \
    "$(grep -A1 -xF "$line" "$scratch/sudo" | tail -1)"
check "nothing else in the file changed" "$(cat "$debian")" "$(grep -vxF "$line" "$scratch/sudo")"
check "the file keeps its mode" 640 "$(stat -c %a "$scratch/sudo")"

cp "$scratch/sudo" "$scratch/once"
"$pam" "$scratch/sudo" >/dev/null 2>&1 || fail "a second run succeeds"
check "a second run changes nothing" "" "$(cmp "$scratch/once" "$scratch/sudo" 2>&1)"
check "a run leaves no temporary file behind" "once sudo" "$(ls -A "$scratch" | grep -v err | tr '\n' ' ' | sed 's/ $//')"

# Each case: a name, then what to do to a fresh copy of Debian's file. The script has to fail and leave the copy as
# it was.
refuses() {
    local what="$1" edit="$2" before
    cp "$debian" "$scratch/case"
    eval "$edit"
    before=$(cat "$scratch/case")
    if "$pam" "$scratch/case" >/dev/null 2>&1; then
        fail "refuses $what"
    else
        check "refuses $what, leaving the file as it was" "$before" "$(cat "$scratch/case")"
    fi
}
refuses "a file with no @include common-auth" "sed -i '/@include common-auth/d' \"\$scratch/case\""
refuses "a file with two" "echo '@include common-auth' >>\"\$scratch/case\""
refuses "a file whose pam_u2f line requires the key" \
    "sed -i 's/^@include common-auth/auth required pam_u2f.so\n&/' \"\$scratch/case\""
refuses "a file where the touch line comes after the password" "echo '$line' >>\"\$scratch/case\""
refuses "a file a line of which PAM would not parse" "echo 'auth sufficent' >>\"\$scratch/case\""

cp "$debian" "$scratch/commented"
sed -i 's/^@include common-auth/#auth sufficient pam_u2f.so\n&/' "$scratch/commented"
"$pam" "$scratch/commented" >/dev/null 2>&1 || fail "a commented-out pam_u2f line is not counted as one"
check "a commented-out pam_u2f line is not counted as one" 1 "$(grep -cxF "$line" "$scratch/commented")"

finish
