#!/usr/bin/env -S uv run --script --quiet
"""Check that bin/vault-sync refuses to publish two media files under one name.

Run it directly; no framework. vault-sync runs as a subprocess against a
fixture vault with HOME in a temporary directory, and without R2 credentials.
The refusal has to come before the upload, so a run that reaches the upload
stops at the missing credentials instead, and says so. Where media lands when
it is published is tests/properties/vault-sync.test's business.
"""

import os
import subprocess
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
NO_CREDENTIALS = "R2 credentials missing"

failures = 0


def check(what: str, expected: object, actual: object) -> None:
    global failures
    if expected != actual:
        failures += 1
        print(f"FAIL {what}\n  expected: {expected!r}\n  actual:   {actual!r}")
    else:
        print(f"ok   {what}")


def run_sync(root: Path, vault: Path) -> subprocess.CompletedProcess:
    env = {
        "PATH": os.environ["PATH"],
        "HOME": str(root / "home"),
        "UV_CACHE_DIR": os.environ.get("UV_CACHE_DIR", str(Path.home() / ".cache/uv")),
        "VAULT_DIR": str(vault),
        "QUARTZ_DIR": str(root / "quartz"),
    }
    return subprocess.run([REPO / "bin/vault-sync"], env=env, capture_output=True, text=True)


def make_vault(root: Path, chapters: dict[str, str]) -> Path:
    """A vault whose library/ links to HOME's library, as the real one does.

    Each chapter of book `b` embeds its own `./fig-1.webp`, whose bytes are given.
    """
    library = root / "home/Documents/library"
    vault = root / "vault"
    vault.mkdir(parents=True)
    library.mkdir(parents=True)
    (vault / "library").symlink_to(library)
    notes = []
    for chapter, image_bytes in chapters.items():
        (library / chapter).mkdir(parents=True)
        (library / chapter / "note.md").write_text("![A figure.](./fig-1.webp)\n")
        (library / chapter / "fig-1.webp").write_text(image_bytes)
        notes.append(f'"library/{chapter}/note.md"')
    (vault / "whitelist.json").write_text(f'{{"files": [{", ".join(notes)}], "patterns": []}}')
    return vault


with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    vault = make_vault(root, {"book-a/chapter-01": "a", "book-b/chapter-01": "b"})
    r = run_sync(root, vault)
    check("two files with one name: the sync fails", True, r.returncode != 0)
    check("before it reaches the upload", False, NO_CREDENTIALS in r.stdout)
    check("naming both paths", [True, True],
          [f"library/{book}/chapter-01/fig-1.webp" in r.stdout for book in ("book-a", "book-b")])

with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    # one file, found once through the vault's library/ link and once in the library itself
    vault = make_vault(root, {"book-a/chapter-01": "a"})
    r = run_sync(root, vault)
    check("one file found under two paths is no collision: the sync reaches the upload",
          True, NO_CREDENTIALS in r.stdout)

print(f"\n{'FAILED' if failures else 'passed'}: {failures} failure(s)")
raise SystemExit(1 if failures else 0)
