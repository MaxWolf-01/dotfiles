#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.13"
# dependencies = ["boto3>=1.36", "moto[server]>=5"]
# ///
"""Check where bin/vault-sync puts a published note's media. Run it directly; no framework.

Media a published note references lands in the bucket under its file name,
none of it lands in the quartz content dir, and each object is byte-identical
to the vault's file. Two media files under one name are refused before the
upload.

vault-sync runs as the hook runs it, as a subprocess against a fixture vault,
with an in-process S3 server (moto) standing in for R2. HOME points at a
temporary directory, so no real vault, library or cache is read.

Example:

    tests/vault-sync.test
"""

import hashlib
import logging
import os
import random
import subprocess
import sys
import tempfile
from pathlib import Path

import boto3
from moto.server import ThreadedMotoServer

sys.path.insert(0, str(Path(__file__).resolve().parent))
from check import check, finish, free_port  # noqa: E402

REPO = Path(__file__).resolve().parents[1]
BUCKET = "mwolf-dev-media"
NO_CREDENTIALS = "R2 credentials missing"
MEDIA_SUFFIXES = {".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".mp4", ".webm", ".mov", ".mp3", ".pdf"}

def make_vault(root: Path) -> Path:
    vault = root / "vault"
    (vault / "notes").mkdir(parents=True)
    (vault / "Obsidian/attachments").mkdir(parents=True)
    (vault / "whitelist.json").write_text('{"files": ["notes/a.md"], "patterns": []}')
    (vault / "notes/a.md").write_text(
        "# A\n\n"
        "![[pic one.png|300]]\n\n"
        "See [[clip.mp4|the clip]].\n\n"
        "![[talk.mp3]]\n\n"
        # a markdown link's destination is percent-encoded, as Obsidian writes it
        "Read [the paper](../Obsidian/attachments/a%20paper.pdf) or [[notes.PDF|the notes]].\n\n"
        "```litegal\n![[strip “1”.webp]]\n```\n\n"
        "`![[in-code.png]]` is code, not an embed.\n\n"
        # one unpaired backtick, as a double-backtick span leaves to a
        # single-backtick reading, must not hide the embeds after it
        "Mask with ``x.tril()`` or pass `mask` instead.\n\n"
        "![[after-stray-backtick.png|600]]\n\n"
        "Masked values are `-inf`.\n\n"
        # a link before a media link on the same line is not part of its name
        "[[Spinoza]] called it [[god-or-nature.webp|God or Nature]].\n\n"
        "```python\nprint(`![[in-fence.png]]`)\n```\n\n"
        "![[after-fence.gif]]\n\n"
        # Quartz renders nothing inside a comment, so nothing there is published
        "%%\n![[in-obsidian-comment.webp]]\n%%\n\n"
        "Inline %%![[in-inline-comment.png]]%% and <!-- ![[in-html-comment.png]] -->"
        " but ![[after-comments.png]].\n\n"
        "<!--\n![alt](in-html-block.jpg)\n-->\n\n"
        # code goes before an HTML comment, but after an Obsidian one, as in Quartz
        "`<!--` is markup, ![[after-code-html-marker.png]] `-->`\n\n"
        "`%%` is markup, ![[in-code-opened-comment.png]] `%%`\n"
    )
    rng = random.Random(1)
    for rel in ["Obsidian/attachments/pic one.png", "notes/clip.mp4",
                "Obsidian/attachments/talk.mp3", "Obsidian/attachments/a paper.pdf",
                "notes/notes.PDF", "Obsidian/attachments/unreferenced.pdf",
                "Obsidian/attachments/strip “1”.webp", "Obsidian/attachments/in-code.png",
                "Obsidian/attachments/unreferenced.png", "Obsidian/attachments/after-stray-backtick.png",
                "Obsidian/attachments/god-or-nature.webp", "Obsidian/attachments/in-fence.png",
                "Obsidian/attachments/after-fence.gif", "Obsidian/attachments/in-obsidian-comment.webp",
                "Obsidian/attachments/in-inline-comment.png", "Obsidian/attachments/in-html-comment.png",
                "Obsidian/attachments/after-comments.png", "notes/in-html-block.jpg",
                "Obsidian/attachments/after-code-html-marker.png",
                "Obsidian/attachments/in-code-opened-comment.png"]:
        (vault / rel).write_bytes(rng.randbytes(rng.randrange(1000, 5000)))
    git = ["git", "-C", str(vault), "-c", "user.name=t", "-c", "user.email=t@t"]
    subprocess.run([*git, "init", "-q"], check=True)
    subprocess.run([*git, "add", "."], check=True)
    subprocess.run([*git, "commit", "-qm", "fixture"], check=True)
    return vault


def make_library_vault(root: Path, chapters: dict[str, str]) -> Path:
    """A vault whose library/ links to HOME's library, as the real one does.

    Each chapter of book `b` embeds its own `./fig-1.webp`, whose bytes are given.
    """
    library = root / "home/Documents/library"
    vault = root / "vault"
    vault.mkdir(parents=True)
    library.mkdir(parents=True)
    (vault / "library").symlink_to(library)
    notes = []
    for chapter, image_bytes in chapters.items():
        (library / chapter).mkdir(parents=True)
        (library / chapter / "note.md").write_text("![A figure.](./fig-1.webp)\n")
        (library / chapter / "fig-1.webp").write_text(image_bytes)
        notes.append(f'"library/{chapter}/note.md"')
    (vault / "whitelist.json").write_text(f'{{"files": [{", ".join(notes)}], "patterns": []}}')
    return vault


def run_sync(root: Path, vault: Path, endpoint: str | None) -> subprocess.CompletedProcess:
    env = {
        "PATH": os.environ["PATH"],
        "HOME": str(root / "home"),
        "UV_CACHE_DIR": os.environ.get("UV_CACHE_DIR", str(Path.home() / ".cache/uv")),
        "VAULT_DIR": str(vault),
        "QUARTZ_DIR": str(root / "quartz"),
    }
    if endpoint:
        env |= {
            "CLOUDFLARE_S3_API_ENDPOINT": endpoint,
            "CLOUDFLARE_ACCESS_KEY_ID": "test",
            "CLOUDFLARE_SECRET_ACCESS_KEY": "test",
        }
    return subprocess.run([REPO / "bin/vault-sync"], env=env, capture_output=True, text=True)


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def main() -> None:
    logging.getLogger("werkzeug").setLevel(logging.ERROR)  # moto's request log
    port = free_port()
    server = ThreadedMotoServer(ip_address="127.0.0.1", port=port, verbose=False)
    server.start()
    endpoint = f"http://127.0.0.1:{port}"
    s3 = boto3.client("s3", endpoint_url=endpoint, region_name="us-east-1",
                      aws_access_key_id="test", aws_secret_access_key="test")
    s3.create_bucket(Bucket=BUCKET)

    def objects() -> dict[str, bytes]:
        keys = [o["Key"] for o in s3.list_objects_v2(Bucket=BUCKET).get("Contents", [])]
        return {k: s3.get_object(Bucket=BUCKET, Key=k)["Body"].read() for k in keys}

    try:
        with tempfile.TemporaryDirectory() as tmp:
            root = Path(tmp)
            (root / "home").mkdir()
            vault = make_vault(root)

            r = run_sync(root, vault, endpoint)
            check("first sync exits 0", 0, r.returncode)
            if r.returncode:
                print(r.stdout[-2000:], r.stderr[-2000:])

            published = {"pic one.png": "Obsidian/attachments/pic one.png",
                         "clip.mp4": "notes/clip.mp4",
                         "talk.mp3": "Obsidian/attachments/talk.mp3",
                         "a paper.pdf": "Obsidian/attachments/a paper.pdf",
                         "notes.PDF": "notes/notes.PDF",
                         "strip “1”.webp": "Obsidian/attachments/strip “1”.webp",
                         "after-stray-backtick.png": "Obsidian/attachments/after-stray-backtick.png",
                         "god-or-nature.webp": "Obsidian/attachments/god-or-nature.webp",
                         "after-fence.gif": "Obsidian/attachments/after-fence.gif",
                         "after-comments.png": "Obsidian/attachments/after-comments.png",
                         "after-code-html-marker.png": "Obsidian/attachments/after-code-html-marker.png"}
            got = objects()
            check("the bucket holds exactly the referenced media, keyed by file name",
                  sorted(published), sorted(got))
            check("every object is byte-identical to the vault's file",
                  {k: sha256((vault / v).read_bytes()) for k, v in published.items()},
                  {k: sha256(v) for k, v in got.items()})
            check("an object carries its media type",
                  ["image/png", "audio/mpeg", "application/pdf"],
                  [s3.head_object(Bucket=BUCKET, Key=k)["ContentType"]
                   for k in ["pic one.png", "talk.mp3", "a paper.pdf"]])

            content = root / "quartz/content"
            check("the note is copied to content", True, (content / "notes/a.md").is_file())
            check("no media file is written under content", [],
                  [str(p) for p in content.rglob("*") if p.suffix.lower() in MEDIA_SUFFIXES])

            r = run_sync(root, vault, endpoint)
            check("a second sync with nothing changed uploads nothing",
                  True, "11 published, 0 uploaded" in r.stdout)

            # same size, different bytes: only a content comparison notices
            webp = vault / "Obsidian/attachments/strip “1”.webp"
            webp.write_bytes(bytes(b ^ 0xFF for b in webp.read_bytes()))
            r = run_sync(root, vault, endpoint)
            check("a changed file is uploaded again, and only it",
                  True, "11 published, 1 uploaded" in r.stdout)
            check("the re-uploaded object matches the changed file",
                  sha256(webp.read_bytes()), sha256(objects()["strip “1”.webp"]))

            r = run_sync(root, vault, None)
            check("a sync without R2 credentials fails", True, r.returncode != 0)
            check("and names what is missing", True, "CLOUDFLARE_S3_API_ENDPOINT" in r.stdout)
    finally:
        server.stop()

    # The refusal has to come before the upload, so these run without R2 credentials: a run that reaches the
    # upload stops at the missing credentials instead, and says so.
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        vault = make_library_vault(root, {"book-a/chapter-01": "a", "book-b/chapter-01": "b"})
        r = run_sync(root, vault, None)
        check("two files with one name: the sync fails", True, r.returncode != 0)
        check("before it reaches the upload", False, NO_CREDENTIALS in r.stdout)
        check("naming both paths", [True, True],
              [f"library/{book}/chapter-01/fig-1.webp" in r.stdout for book in ("book-a", "book-b")])

    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        # one file, found once through the vault's library/ link and once in the library itself
        vault = make_library_vault(root, {"book-a/chapter-01": "a"})
        r = run_sync(root, vault, None)
        check("one file found under two paths is no collision: the sync reaches the upload",
              True, NO_CREDENTIALS in r.stdout)

    finish()


if __name__ == "__main__":
    main()
