#!/usr/bin/env bash
# Drive bin/script-pins against a fake jsDelivr API and check what it lists. Run it directly; no framework.
#
# The contract under test: every pinned jsDelivr URL is found, whatever shape its package
# name takes or however its version is written, and stands beside the newest release
# jsDelivr names; a package jsDelivr cannot be asked about is shown, not dropped.

set -uo pipefail

script_pins="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/script-pins"
work=$(mktemp -d)
port=$(uv run --no-project python -c "import socket;s=socket.socket();s.bind(('127.0.0.1',0));print(s.getsockname()[1])")
api="$work/api/v1/packages"
mkdir -p "$api/npm/mermaid" "$api/npm/@scope/elk" "$api/gh/acme/cdn-release"
# http.server drops the query string, so each answer sits at .../resolved
echo '{"version": "12.1.0"}' > "$api/npm/mermaid/resolved"
echo '{"version": "0.2.2"}' > "$api/npm/@scope/elk/resolved"
echo '{"version": "11.12.0"}' > "$api/gh/acme/cdn-release/resolved"
timeout 120 uv run --no-project python -m http.server "$port" --bind 127.0.0.1 --directory "$work/api" >/dev/null 2>&1 &
server=$!
trap 'kill $server 2>/dev/null; rm -rf "$work"' EXIT
for _ in $(seq 100); do curl -sf -o /dev/null "http://127.0.0.1:$port/v1/packages/npm/mermaid/resolved" && break; sleep 0.1; done
export SCRIPT_PINS_API="http://127.0.0.1:$port/v1"

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

mkdir -p "$work/src"
cat > "$work/src/page.py" <<'EOF'
MERMAID = "https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.min.js"
ELK = "https://cdn.jsdelivr.net/npm/@scope/elk@0.2.2/dist/elk.mjs"
AGAIN = "https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/other.js"
EOF
cat > "$work/src/tool" <<'EOF'
HLJS_VERSION = "11.11.1"
HLJS_BASE = f"https://cdn.jsdelivr.net/gh/acme/cdn-release@{HLJS_VERSION}/build/"
LOOSE = "https://cdn.jsdelivr.net/npm/unpinned/dist/x.js"
EOF

out=$("$script_pins" "$work/src" "$work/nowhere" --json 2>"$work/err")
check "every package reached exits 0" 0 $?
check "each pin beside its newest release, a version read from its variable" \
    "gh/acme/cdn-release 11.11.1 11.12.0|npm/@scope/elk 0.2.2 0.2.2|npm/mermaid 11.17.2 12.1.0" \
    "$(jq -r 'map("\(.package) \(.pinned) \(.latest)") | join("|")' <<<"$out")"
check "a package pinned twice lists both lines" "$work/src/page.py:1 $work/src/page.py:3" \
    "$(jq -r '.[] | select(.package == "npm/mermaid") | .where | join(" ")' <<<"$out")"
check "a path that does not exist is named on stderr" yes "$(grep -q "$work/nowhere does not exist" "$work/err" && echo yes)"

rm "$api/npm/mermaid/resolved"
out=$("$script_pins" "$work/src" 2>"$work/err")
check "a package jsDelivr cannot answer for exits 1" 1 $?
check "and is shown with a question mark" "npm/mermaid  11.17.2  → ?  $work/src/page.py:1 $work/src/page.py:3" "$(grep mermaid <<<"$out")"
check "a current pin says so" "npm/@scope/elk  0.2.2  current  $work/src/page.py:2" "$(grep elk <<<"$out")"

echo
if [ "$failures" -eq 0 ]; then echo "all checks passed"; else echo "$failures check(s) FAILED"; exit 1; fi
