#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro"]
# ///
"""What a container hub with a tab listening costs a host: its CPU while nothing changes, and while sessions work,
hearing the disk's changes (events), reading it at every round of its watch (poll, the hub's --poll), and as a hub
from before the disk watch reads it (before, the script --before names), and the inotify watches it holds.

Each run starts a hub of its own on a scratch socket and state, with one listener on its event stream, waits for its
first reads to finish, then measures the CPU of its processes (the hub's and the commands it ran) over --seconds
while nothing writes, and again while --busy sessions write their transcripts and statusline files. The hub's tmux
server is the synthetic sessions' own, or with --real, one that is not there, so it types into none of the user's. A run whose tab was told nothing while sessions
worked measured a hub that heard nothing: it is marked invalid, and the tool exits 1.

The world it reads is a synthetic one (synthetic.py: --units units, --running of whose sessions run, each idle in a
pane of a tmux server of its own) under a scratch HOME, or with --real, this user's own HOME and a copy of the hub's state, the sessions' own
work being the load.

Examples:

    tests/container-hub/watch-load
    tests/container-hub/watch-load --units 300 --running 32 --busy 8 --seconds 60 --out result.json
    git show hub/cold-read:bin/container-hub > /tmp/before-hub && tests/container-hub/watch-load --before /tmp/before-hub --modes events before
    tests/container-hub/watch-load --real --seconds 120
"""

import json
import os
import random
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Literal

import tyro

HERE = Path(__file__).resolve().parent
sys.path[:0] = [str(HERE), str(HERE.parent)]
import fakes  # noqa: E402
import synthetic  # noqa: E402

BIN = HERE.parents[1] / "bin"
TICK = os.sysconf("SC_CLK_TCK")


@dataclass
class Args:
    units: int = 300
    """Units in the synthetic world."""
    running: int = 32
    """Of them, the ones whose sessions run."""
    busy: int = 8
    """Of those, the ones at work during the load: each appends a line to its transcript every --write seconds and
    rewrites its statusline file every second."""
    write: float = 0.5
    """Seconds between two lines a busy session writes to its transcript."""
    seconds: float = 60.0
    """Seconds each measurement lasts."""
    warmup: float = 30.0
    """Seconds a hub is given to make its first reads before it is measured."""
    modes: tuple[Literal["events", "poll", "before"], ...] = ("events", "poll")
    """The hubs measured, one after the other in each run."""
    before: Path | None = None
    """The hub script measured as `before`, run beside this checkout's diffview."""
    runs: int = 1
    """Times the modes are measured, in turn."""
    real: bool = False
    """Measure on this user's own HOME, and a copy of --state, with no synthetic load."""
    state: Path = Path("~/.local/state/container-hub")
    """With --real, the hub state copied for each hub measured."""
    out: Path | None = None
    """Where the results go as JSON, besides stdout."""


def main(args: Args) -> None:
    if "before" in args.modes and not args.before:
        sys.exit("watch-load: the `before` mode measures the hub --before names; give it one")
    scratch = Path(tempfile.mkdtemp(prefix="watch-load.", dir="/tmp"))  # a short path: a unix socket's is bounded
    tmux = scratch / "tmux.sock"
    try:
        home, state, sessions = Path.home(), None, []
        if not args.real:
            home, state = scratch / "home", scratch / "state"
            home.mkdir()
            fakes.with_reader(home)  # where the hub finds the mx plugin's session page reader and its tracker
            sessions = synthetic.build(home, state, args.units)
            synthetic.run(home, sessions[:args.running], tmux)
        hubs = {"events": BIN / "container-hub", "poll": BIN / "container-hub"}
        if args.before:
            (scratch / "before").mkdir()
            shutil.copy(args.before, hubs.setdefault("before", scratch / "before" / "container-hub"))
            hubs["before"].chmod(0o755)
            (scratch / "before" / "diffview").symlink_to(BIN / "diffview")
        results = {"host": socket.gethostname(), **({} if args.real else {"units": args.units, "running": args.running,
                   "busy": args.busy, "write": args.write}), "seconds": args.seconds, "runs": []}
        for run in range(args.runs):
            for mode in args.modes:
                mode_state = scratch / f"state-{mode}-{run}"
                shutil.copytree(state or args.state.expanduser(), mode_state, symlinks=True)
                measured = measure(args, hubs[mode], mode, f"{mode}-{run}", home, mode_state, scratch, sessions[:args.busy])
                results["runs"].append({"mode": mode, **measured})
                print(json.dumps(results["runs"][-1]), flush=True)
        if args.out:
            args.out.write_text(json.dumps(results, indent=1) + "\n")
        print(json.dumps(results, indent=1))
        if invalid := [r["mode"] for r in results["runs"] if not r["valid"]]:
            sys.exit(f"watch-load: {len(invalid)} runs measured a hub whose tab was told nothing while sessions worked: {invalid}")
    finally:
        synthetic.stop(tmux)
        shutil.rmtree(scratch, ignore_errors=True)


def measure(args: Args, hub_script: Path, mode: str, name: str, home: Path, state: Path, scratch: Path, busy: list[str]) -> dict:
    sock = scratch / f"{name}.sock"
    env = {k: v for k, v in fakes.scrubbed(home).items() if not k.startswith("DISPATCH_")}
    argv = [str(hub_script), "--socket", str(sock), "--state", str(state), "--host", "watch-load", "--url", "http://watch-load.invalid",
            "--tmux-socket", str(scratch / ("no-tmux.sock" if args.real else "tmux.sock")), *(["--poll"] if mode == "poll" else [])]
    log = scratch / f"{name}.log"
    hub = subprocess.Popen(argv, env=env, stdout=log.open("w"), stderr=subprocess.STDOUT, start_new_session=True)
    try:
        try:
            listener = Listener(sock)
        except OSError:
            sys.exit(f"the {mode} hub never listened on {sock}:\n" + log.read_text())
        time.sleep(args.warmup)
        heard = listener.heard
        idle = cpu_over(hub.pid, args.seconds)
        heard_idle, heard = listener.heard - heard, listener.heard
        stop = threading.Event()
        writer = threading.Thread(target=work, args=(home, busy, args.write, stop), daemon=True)
        if not args.real:
            writer.start()
        working = None if args.real else cpu_over(hub.pid, args.seconds)
        stop.set()
        told_busy = listener.heard - heard
        said = log.read_text().splitlines()
        return {"idle_cpu_percent": idle, "busy_cpu_percent": working, "watches": watches(hub.pid),
                "told_idle": heard_idle, "told_busy": told_busy, "valid": args.real or told_busy > 0,
                "errors": [line for line in said if line.startswith(("watching:", "listing ", "Traceback"))], "log": said[-8:]}
    finally:
        os.killpg(hub.pid, 9)
        hub.wait()


class Listener(threading.Thread):
    """A hub tab's event stream, read and counted."""

    def __init__(self, sock: Path):
        super().__init__(daemon=True)
        deadline = time.monotonic() + 120
        while True:
            try:
                self.s = socket.socket(socket.AF_UNIX)
                self.s.connect(str(sock))
                break
            except OSError:
                if time.monotonic() > deadline:
                    raise
                time.sleep(0.2)
        self.s.sendall(b"GET /events HTTP/1.1\r\nHost: hub\r\n\r\n")
        self.heard = 0
        self.start()

    def run(self) -> None:
        while chunk := self.s.recv(65536):
            self.heard += chunk.count(b"data: ")


def session_of(sid: int):
    """The /proc directory of each process of the session, with its stat's fields after the command's name."""
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            try:
                fields = (d / "stat").read_text().rsplit(")", 1)[1].split()
            except OSError:
                continue
            if int(fields[3]) == sid:  # the session id, the 6th field
                yield d, fields


def cpu_over(sid: int, seconds: float) -> float:
    """Percent of one core the hub's processes, with the children each has waited for, used over `seconds`."""
    ticks = lambda: sum(int(f[i]) for _, f in session_of(sid) for i in (11, 12, 13, 14))  # utime stime cutime cstime
    before, start = ticks(), time.monotonic()
    time.sleep(seconds)
    return round(100 * (ticks() - before) / TICK / (time.monotonic() - start), 3)


def watches(sid: int) -> int:
    """The inotify watches the hub's processes hold."""
    count = 0
    for d, _ in session_of(sid):
        try:
            for info in (d / "fdinfo").iterdir():
                count += sum(line.startswith("inotify wd:") for line in info.read_text().splitlines())
        except OSError:
            continue
    return count


def work(home: Path, busy: list[str], every: float, stop: threading.Event) -> None:
    """The busy sessions at work: a transcript line each every `every` seconds, a statusline file each every second."""
    line = json.dumps({"type": "assistant", "message": {"content": [{"type": "text", "text": "y" * 1800}]}}) + "\n"
    transcripts = [next((home / ".claude" / "projects").glob(f"*/{s}.jsonl")) for s in busy]
    n, last = 0, 0.0
    while not stop.is_set():
        for t in random.sample(transcripts, len(transcripts)):
            with t.open("a") as f:
                f.write(line)
        if time.monotonic() - last >= 1:
            last = time.monotonic()
            for s in busy:
                synthetic.statusline(home, s, n)
            n += 1
        stop.wait(every)


if __name__ == "__main__":
    main(tyro.cli(Args, description=__doc__))
