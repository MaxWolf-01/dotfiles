#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.12"
# dependencies = ["hypothesis", "tyro", "pyyaml", "markdown-it-py[linkify]"]  # and the hub's own, whose module this loads
# ///
"""Check the properties of work containers the hub's module decides, and that a hub unit's view is a function of what
is on disk and the time. Run it directly; no framework.

The properties are checked against the container hub's module, loaded in this process with HOME in a scratch
directory, as decisions.test loads it; no example starts a hub. What only claude-browser and diffview show, a plain
tab with no hub and a diffview page served by one, is work-containers-tools.test's. Links and keys inside a page are
reviewed in a browser; view.test drives them in headless Chromium. Which container a page went to is read from the
hub's answer: the key is the hub's to choose. A container here is a unit of the hub: one orchestrator session's pages.

Hypothesis draws whole worlds: one or two repos, each with an agent repo of ticket trees, every ticket
committed by one of a few sessions (a `Session:` trailer), pages under the tickets' show, prototype and
diffview paths, and loose pages under no ticket. Then what the sessions do: open those pages, several times,
by different sessions and by different spellings of the same file, and close them.

Which container a page lands in is read off the tracker. The hub asks the mx plugin's `tracker data` for it, which
the worlds here have answered by a stand-in that reads their ticket files: the plugin's own takes a quarter of a second
a world, and decisions.test reads by it.

Examples:

    tests/container-hub/work-containers.test
    tests/container-hub/work-containers.test restart    # only the properties whose statement holds one of these strings
"""

import atexit
import contextlib
import io
import itertools
import json
import os
import random
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import urllib.parse
from dataclasses import dataclass
from pathlib import Path

from hypothesis import example, given
from hypothesis import strategies as st

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import fakes  # noqa: E402  (the hub's module in this process, its clock, and the environment it runs in)
from check import checked, finish, prop, run_properties  # noqa: E402

SCRATCH = Path(tempfile.mkdtemp(prefix="work-containers-test."))
HOME = SCRATCH / "home"
"""The HOME of the hub's module in this process, which the worlds are placed in."""
PORT = 18377
"""The port the hub's module takes for its own in this process, so that one of its addresses names a page it serves.
Nothing listens on it."""
ORIGINS = (f"http://127.0.0.1:{PORT}", f"http://localhost:{PORT}")
"""The hub's own origins, as a request on that port knows them: the hub tab's first."""

# --------------------------------------------------------------------------
# the world: repos, ticket trees, sessions and pages, on disk
# --------------------------------------------------------------------------

SLUGS = ["map-columns", "csv-import", "one-flow", "board-orients", "sync-state", "drop-zone"]
"""Few enough that two repos often hold the same slug."""

PAGE_KINDS = [
    "agent/show/{slug}/index.html",
    "agent/show/{slug}/figure.svg",
    "agent/prototypes/{slug}/index.html",
    "agent/diffviews/{slug}.html",
]

SPELLINGS = ["path", "file-url", "dotted", "symlink", "served"]
"""How an opener names a page: its path, a file:// URL, a path through `/./`, a path through a symlinked
directory, or the address the hub serves it at (a link followed inside a page)."""

WORLDS = itertools.count()


@dataclass(frozen=True)
class Ticket:
    repo: str
    slug: str
    parent: str | None
    session: int
    """Which of the world's sessions committed it."""


@dataclass(frozen=True)
class World:
    tickets: tuple[Ticket, ...]
    pages: tuple[str, ...]
    """Paths relative to the world's directory; loose pages sit outside every repo."""
    sessions: int


@st.composite
def worlds(draw) -> World:
    sessions = draw(st.integers(1, 3))
    tickets = []
    for repo in draw(st.lists(st.sampled_from(["alpha", "beta"]), min_size=1, max_size=2, unique=True)):
        slugs = draw(st.lists(st.sampled_from(SLUGS), min_size=1, max_size=4, unique=True))
        for i, slug in enumerate(slugs):
            parent = draw(st.sampled_from([None, *slugs[:i]])) if i else None
            tickets.append(Ticket(repo, slug, parent, draw(st.integers(0, sessions - 1))))
    pages = [f"repos/{t.repo}/" + kind.format(slug=t.slug)
             for t in tickets for kind in draw(st.lists(st.sampled_from(PAGE_KINDS), max_size=2, unique=True))]
    pages += [f"scratch/note-{i}.html" for i in range(draw(st.integers(0, 2)))]
    if not pages:
        pages.append(f"repos/{tickets[0].repo}/" + PAGE_KINDS[0].format(slug=tickets[0].slug))
    return World(tuple(tickets), tuple(pages), sessions)


@dataclass
class Placed:
    """A world written under a directory of its own, with session ids no other world uses."""

    world: World
    root: Path
    sessions: list[str]
    linked: tuple[list[Path], str | None] = ([], None)
    """The pages, and the session whose page, the last session page rendered links."""

    def page(self, i: int) -> Path:
        return self.root / self.world.pages[i]


def git(cwd: Path, *args: str, env: dict | None = None) -> None:
    subprocess.run(["git", "-c", "user.name=fixture", "-c", "user.email=fixture@example.com", *args],
                   cwd=cwd, env=env or fakes.tools_env(SCRATCH), check=True, capture_output=True)


def place(world: World, home: Path) -> Placed:
    n = next(WORLDS)
    root = home / f"world-{n}"
    sessions = [f"{n:08x}-0000-4000-8000-{s:012x}" for s in range(world.sessions)]
    for repo in sorted({t.repo for t in world.tickets}):
        code = root / "repos" / repo
        (code / "agent" / "tickets").mkdir(parents=True)
        git(code, "init", "-q")
        (code / ".git" / "info" / "exclude").write_text("agent/\n")
        (code / "README.md").write_text(f"{repo}\n")
        git(code, "add", "README.md")
        git(code, "commit", "-q", "-m", "init")
        agent = code / "agent"
        git(agent, "init", "-q")
        for i, t in enumerate(x for x in world.tickets if x.repo == repo):
            (agent / "tickets" / f"{t.slug}.md").write_text(fakes.ticket_text(
                t.slug, "claimed" if t.parent else "open", t.parent, title=t.slug.replace("-", " ").capitalize(),
                brief=f"The {t.slug} ticket of {repo}."))
            stamp = f"2026-10-01T10:{i:02d}:00+00:00"
            env = {**fakes.tools_env(SCRATCH), "GIT_AUTHOR_DATE": stamp, "GIT_COMMITTER_DATE": stamp}
            git(agent, "add", f"tickets/{t.slug}.md", env=env)
            git(agent, "commit", "-q", "-m", f"file {t.slug}\n\nSession: {sessions[t.session]}", env=env)
    for rel in world.pages:
        page = root / rel
        page.parent.mkdir(parents=True, exist_ok=True)
        page.write_text(f"<!doctype html><title>{rel}</title><p>{rel}</p>\n" if page.suffix == ".html"
                        else f'<svg xmlns="http://www.w3.org/2000/svg"><title>{rel}</title></svg>\n')
    (root / "link").symlink_to(root, target_is_directory=True)
    return Placed(world, root, sessions)


# --------------------------------------------------------------------------
# the hub: its module in this process, and the environment everything under test runs in
# --------------------------------------------------------------------------


TRACKER = f"""#!{sys.executable} -I
# `tracker data` as the hub reads it, for the worlds here: the tickets of the repo it runs in, by their frontmatter
import json, pathlib, sys
root = pathlib.Path.cwd() / "agent" / "tickets"
if sys.argv[1:] != ["data"] or not root.is_dir():
    sys.exit("tracker: refused: no tracker here")
tickets = []
for path in sorted(root.glob("*.md")):
    front, _, body = path.read_text().removeprefix("---\\n").partition("\\n---\\n")
    fields = dict(line.split(": ", 1) for line in front.splitlines())
    title = next(line[2:] for line in body.splitlines() if line.startswith("# "))
    tickets.append({{"slug": path.stem, "status": fields["status"], "parent": fields.get("parent"), "title": title, "diff": []}})
print(json.dumps({{"root": str(root.resolve()), "tickets": tickets}}))
"""


class Hub:
    """The hub's module, loaded anew in this process on a state directory, at the time its clock reads: what the hub
    decides, with no server. What a restart keeps is what is on disk, so a hub loaded anew on the same state is
    the hub restarted."""

    def __init__(self, state: Path, clock: fakes.Clock):
        self.module, self.state, self.clock = fakes.load(clock, state), state, clock
        self.module.URL = ORIGINS[0]

    def restarted(self) -> "Hub":
        return Hub(self.state, self.clock)

    def open(self, target: str, session: str) -> tuple[str, str]:
        """The unit the page went to, and its member id there."""
        status, answer = self.module.open_page({"target": target, "session": session}, ORIGINS, from_page=False)
        assert status == 200 and "unit" in answer, f"opening {target} as {session} answered {status}: {answer}"
        return answer["unit"], answer["id"]

    def close(self, key: str, member_id: str) -> None:
        status, answer = self.module.mark("close", {"unit": key, "id": member_id})
        assert status == 200, f"closing {member_id} in {key} answered {status}: {answer}"

    def unit(self, key: str) -> dict | None:
        """A unit as the hub tab reads it (/api/u/<key>)."""
        return next((u for u in self.view()["units"] if u["unit"] == key), None)

    def view(self) -> dict:
        return self.module.hub_view()

    def rail(self, sessions: list[str]) -> list[tuple]:
        """What the hub derives of these sessions' units from disk: each one's title, tree and repo, its session's
        state, and its number."""
        return sorted((u["unit"], u["title"], u["tree"], u["repo"], u["state"], u["number"])
                      for u in self.view()["units"] if u["unit"] in sessions)


def fresh_hub() -> Hub:
    """A hub on a state directory of its own, its clock at a fixed time: a read of every unit reads one world's."""
    return Hub(Path(tempfile.mkdtemp(prefix="state.", dir=SCRATCH)), fakes.Clock(1_790_000_000.0))


def spell(placed: Placed, i: int, how: str, member_url: str | None) -> str:
    page = placed.page(i)
    if how == "file-url":
        return "file://" + urllib.parse.quote(str(page))
    if how == "dotted":
        return f"{page.parent}/./{page.name}"
    if how == "symlink":
        return str(placed.root / "link" / page.relative_to(placed.root))
    if how == "served" and member_url:
        return urllib.parse.urljoin(f"http://127.0.0.1:{PORT}", member_url)
    return str(page)


def member(view: dict, member_id: str) -> dict | None:
    return next((m for m in view["members"] if m["id"] == member_id), None)


def listing(view: dict) -> str:
    return "\n".join(f"        {m['id']}  {m['url']}{'  (closed)' if m.get('closed') else ''}" for m in view["members"])


def running(placed: Placed, rng: random.Random) -> list[Path]:
    """The world's sessions run, in Claude Code's session registry. This process stands in for each, some at work and
    the others idle since a turn of their own, so the rail numbers them, and in an order the opens do not give. The
    files, which the caller deletes once the world is done with, so the next world's sessions are numbered among
    themselves."""
    registry = [HOME / ".claude" / "sessions" / f"{s}.json" for s in placed.sessions]
    registry[0].parent.mkdir(parents=True, exist_ok=True)
    for path, s, at in zip(registry, placed.sessions, rng.sample(range(10**6), len(placed.sessions))):
        path.write_text(json.dumps({"pid": os.getpid(), "procStart": fakes.SELF_STARTED, "sessionId": s,
                                    "status": rng.choice(["idle", "busy"]), "statusUpdatedAt": (1_790_000_000 + at) * 1000}))
    return registry


# --------------------------------------------------------------------------
# P1: no second copy
# --------------------------------------------------------------------------

STEP = st.tuples(st.sampled_from(["open", "open", "open", "close"]), st.integers(0, 7),
                 st.sampled_from(SPELLINGS), st.integers(0, 2))


@prop("Opening a page never produces a second copy of a page the container already holds.")
def no_second_copy():
    """Whatever spelling the opener uses and whichever session opens it, a container holds one member per page
    opened into it: the first open adds one, every later one leaves the count as it was. A closed page is
    still held, so opening it again adds nothing either."""

    @checked(12)
    @given(worlds(), st.lists(STEP, min_size=1, max_size=12))
    def holds(world, steps):
        hub = fresh_hub()
        placed = place(world, HOME)
        into: dict[str, set[int]] = {}
        last: dict[int, tuple[str, str]] = {}
        done = []
        for op, i, how, s in steps:
            i, session = i % len(world.pages), placed.sessions[s % world.sessions]
            if op == "close":
                if i not in last:
                    continue
                key, mid = last[i]
                hub.close(key, mid)
                done.append(f"close {world.pages[i]} in {key}")
            else:
                url = member(hub.unit(last[i][0]), last[i][1])["url"] if how == "served" and i in last else None
                target = spell(placed, i, how, url)
                key, mid = hub.open(target, session)
                last[i] = (key, mid)
                into.setdefault(key, set()).add(i)
                done.append(f"open {target} as session {s} -> {key} {mid}")
            view = hub.unit(key)
            assert len(view["members"]) == len(into[key]), (
                f"container {key} holds {len(view['members'])} members after these steps, but only "
                f"{len(into[key])} distinct pages were opened into it:\n      " + "\n      ".join(done)
                + f"\n      its members:\n{listing(view)}")

    holds()


# --------------------------------------------------------------------------
# P2: survives a restart
# --------------------------------------------------------------------------

@prop("A container's pages, and which of them are closed, survive a hub restart.")
def survives_restart():
    """The hub is loaded anew on its state once the container has answered with every page opened and closed: what a
    restart keeps is what the hub wrote before it answered. Loaded anew, each container answers the same members and
    the same closed members."""

    @checked(8)
    @given(worlds(), st.lists(st.integers(0, 2), min_size=1, max_size=8), st.lists(st.integers(0, 7), max_size=8))
    def survives(world, openers, closes):
        hub = fresh_hub()
        placed = place(world, HOME)
        ids: dict[int, tuple[str, str]] = {}
        for i in range(len(world.pages)):
            ids[i] = hub.open(spell(placed, i, "path", None), placed.sessions[openers[i % len(openers)] % world.sessions])
        closed = set()
        for i in closes:
            key, mid = ids[i % len(world.pages)]
            hub.close(key, mid)
            closed.add(mid)
        before = {key: snapshot(hub.unit(key)) for key, _ in ids.values()}
        for key, mid in ids.values():
            members = before[key]
            assert mid in {m[0] for m in members}, f"{mid} is not a member of {key} before the restart: {members}"
            shut = mid in {m[0] for m in members if m[2]}
            assert shut == (mid in closed), f"{mid} in {key} should{'' if mid in closed else ' not'} be closed before the restart"
        restarted = hub.restarted()
        for key, was in before.items():
            now = snapshot(restarted.unit(key))
            assert now == was, f"container {key} changed across the restart:\n      before {was}\n      after  {now}"

    survives()


def snapshot(view: dict) -> frozenset:
    """A container's members, as (id, url, closed)."""
    return frozenset((m["id"], m["url"], bool(m.get("closed"))) for m in view["members"])


# --------------------------------------------------------------------------
# P6: the container is derived from files on disk
# --------------------------------------------------------------------------


@prop("The container is derived from files on disk: the hub's own state can go.")
def derived_from_disk():
    """Each page is opened by one or two of the world's sessions. The hub's state directory is deleted, and the hub
    loaded anew; opening the same pages by the same sessions, in another order, answers the same unit for each, and
    the rail derives the same of each unit: its title, its tree and repo, its session's state and its number."""

    @checked(8)
    @given(worlds(), st.lists(st.integers(0, 2), min_size=1, max_size=8), st.randoms(use_true_random=False))
    # a session that committed on neither of two trees, opening a page of each: the tree beside its unit follows from
    # disk, not from which page it opened last
    @example(World((Ticket("alpha", "map-columns", None, 0), Ticket("alpha", "csv-import", None, 0)),
                   ("repos/alpha/agent/show/map-columns/index.html", "repos/alpha/agent/show/csv-import/index.html"), 2),
             [1], random.Random(1))
    def derived(world, openers, rng):
        hub = fresh_hub()
        placed = place(world, HOME)
        registry = running(placed, rng)
        try:
            opens = []
            for i in range(len(world.pages)):
                first = openers[i % len(openers)] % world.sessions
                opens.append((i, placed.sessions[first]))
                if (second := openers[(i + 1) % len(openers)] % world.sessions) != first:
                    opens.append((i, placed.sessions[second]))
            before = {(i, s): hub.open(str(placed.page(i)), s)[0] for i, s in opens}
            rail = hub.rail(placed.sessions)
            shutil.rmtree(hub.state)
            hub.state.mkdir()
            hub = hub.restarted()
            rng.shuffle(opens)
            for i, s in opens:
                now = hub.open(str(placed.page(i)), s)[0]
                assert now == before[(i, s)], (
                    f"{world.pages[i]} opened by {s} went to {before[(i, s)]}, and to {now} once the hub's state was gone")
            again = hub.rail(placed.sessions)
            assert again == rail, (f"the rail derived other units once the hub's state was gone and the pages were opened in another"
                                   f" order:\n      before {rail}\n      after  {again}")
        finally:
            for path in registry:
                path.unlink(missing_ok=True)

    derived()


# --------------------------------------------------------------------------
# hub-decisions-tested-at-the-module#P1 and hub-rebuilds-only-what-changed#P1: the view is a function of what is on
# disk and the time, whatever the hub kept of an earlier read
# --------------------------------------------------------------------------


CHANGES = ["status", "retire", "commit", "board", "turn", "end", "heading", "render", "rendered", "record", "title",
           "launch", "cwd", "page", "diffview", "watch", "worktree", "statusline", "open", "close", "visit", "dismiss"]
"""What `change` does under a running hub, each touching one input of a unit's view (the hub's `unit_inputs`), so
that a change the hub misses shows."""


def lived(placed: Placed, rng: random.Random) -> None:
    """What the world's sessions leave besides their commits, each for some of them, and a worktree a watch record
    may name."""
    for s in placed.sessions:
        if rng.random() < 0.5:
            for d in session_dirs(placed, s):
                heading(d, rng)
                (d / "index.html").write_text("<!doctype html><p>a session page</p>\n")
            kept, first, *_ = session_dirs(placed, s)  # tied to the agent repo it commits into, as mx ties it
            (kept / "agent-repo").write_text(f"{first.parents[1]}\n")
        if rng.random() < 0.5:
            titled(s, rng)
        if rng.random() < 0.5:
            statusline(s, rng)
    (placed.root / "worktree").mkdir()


def session_dirs(placed: Placed, session: str) -> list[Path]:
    """A session's page directory under its account, where the mx plugin keeps it and the hub looks first, and in each
    of the world's repos, where an older mx kept it, all written alike: its unit's tracker is one of the repos."""
    return [HOME / ".claude" / "session-pages" / session,
            *(placed.root / "repos" / repo / "agent" / "sessions" / session for repo in sorted({t.repo for t in placed.world.tickets}))]


def heading(session_dir: Path, rng: random.Random) -> None:
    session_dir.mkdir(parents=True, exist_ok=True)
    (session_dir / "session.md").write_text(f"---\nsession: {session_dir.name}\nrepo: {session_dir.parents[2]}\n---\n\n"
                                           f"# Session {rng.randrange(10**6)}\n")


def transcribed(session: str, line: dict) -> None:
    path = HOME / ".claude" / "projects" / "-world" / f"{session}.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps({**line, "sessionId": session}) + "\n")


def titled(session: str, rng: random.Random) -> None:
    kind = rng.choice(["ai", "custom"])
    transcribed(session, {"type": f"{kind}-title", f"{kind}Title": f"title {rng.randrange(10**6)}"})


def statusline(session: str, rng: random.Random) -> None:
    path = HOME / ".cache" / "claude-statusline" / f"{session}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    used = rng.randrange(100)
    path.write_text(json.dumps({"session_id": session, "config_dir": str(HOME / ".claude"), "written_at": 1_790_000_000 + rng.randrange(10**6),
                                "context_window": {"used_percentage": used, "total_input_tokens": used * 2000},
                                "rate_limits": {"five_hour": {"used_percentage": used, "resets_at": 1_790_100_000}}}))


def change(hub: Hub, placed: Placed, registry: list[Path], what: str, rng: random.Random) -> None:
    """One of CHANGES. Some aim at what an earlier `render` linked, which only a link reads."""
    tickets = sorted(placed.root.glob("repos/*/agent/tickets/*.md"))
    agents = sorted(placed.root.glob("repos/*/agent"))
    session = rng.choice(placed.sessions)
    pages = [p for p in map(placed.page, range(len(placed.world.pages))) if p.exists()]
    html = [p for p in pages if p.suffix == ".html"]
    worktree = placed.root / "worktree"
    if what == "status" and tickets:
        path = rng.choice(tickets)
        path.write_text(re.sub(r"^status: .*$", f"status: {rng.choice(['open', 'claimed', 'review', 'done'])}", path.read_text(),
                               count=1, flags=re.M))
    elif what == "retire" and tickets:
        rng.choice(tickets).unlink()
    elif what == "commit" and tickets:
        path = rng.choice(tickets)
        agent, note = path.parents[1], f"show/{path.stem}/note-{rng.randrange(10**6)}.md"
        fakes.page(agent / note, "a note\n")
        git(agent, "add", note)
        git(agent, "commit", "-q", "-m", f"note on {path.stem}\n\nSession: {session}")
    elif what == "board":
        board = rng.choice(agents) / "board.html"
        if board.exists():
            board.unlink()
        else:
            fakes.page(board)
    elif what in ("turn", "end"):
        path = rng.choice(registry)
        if what == "end":
            path.unlink(missing_ok=True)
        else:
            entry = json.loads(path.read_text()) if path.exists() else {"pid": os.getpid(), "procStart": fakes.SELF_STARTED,
                                                                         "sessionId": path.stem, "statusUpdatedAt": 1_790_000_000_000}
            path.write_text(json.dumps({**entry, "status": rng.choice(["idle", "busy", "waiting", "shell"]),
                                        "statusUpdatedAt": entry["statusUpdatedAt"] + rng.randrange(1, 10**6)}))
    elif what == "heading":
        if placed.linked[1] and rng.random() < 0.5:
            session = placed.linked[1]
        for d in session_dirs(placed, session):
            heading(d, rng)
    elif what in ("render", "rendered"):
        units = [u["session"] for u in hub.view()["units"] if u["session"]]
        session = rng.choice(units) if units else session
        other = rng.choice([s for s in placed.sessions if s != session] or placed.sessions)
        linked = [*rng.sample(pages, min(len(pages), rng.randrange(1, 3))), *(d / "index.html" for d in session_dirs(placed, other))]
        if what == "render":
            placed.linked = linked, other
        for d in session_dirs(placed, session):
            page = d / "index.html"
            if what == "rendered" and page.exists():  # the same page, at the end of another turn
                os.utime(page, (hub.clock.now, hub.clock.now))
            elif what == "render":
                column = "".join(f'<a data-artefact="{p}">{p.name}</a>' for p in linked)
                fakes.page(page, f'<!doctype html><p>a session page</p><aside id="artefacts">{column}</aside>\n')
    elif what == "record":
        asked = "\n## Questions\n\n- [Q1] **Which way?** A call only the user can make.\n  - (a) this way *my pick*\n  - (b) that way\n"
        record = f"---\ndate: 2026-10-07\n---\n\n# Turn {rng.randrange(10**6)}\n{asked if rng.random() < 0.5 else ''}"
        for d in session_dirs(placed, session):
            fakes.page(d / "turns" / f"{rng.randrange(1, 4):02d}.md", record)
    elif what == "title":
        titled(session, rng)
    elif what == "launch":
        transcribed(session, {"type": "assistant", "timestamp": "2026-10-01T10:00:00Z", "message": {"content": [
            {"type": "tool_use", "id": f"toolu_{rng.randrange(10**6)}", "name": "Bash",
             "input": {"command": rng.choice(["make test", "diffview --watch"]), "description": "a run", "run_in_background": True}}]}})
    elif what == "cwd":
        transcribed(session, {"type": "user", "cwd": str(rng.choice([worktree, placed.root])), "message": {"content": "go on"}})
    elif what == "page" and pages:
        rng.choice(pages).unlink()
    elif what == "diffview" and html:
        aimed = [p for p in placed.linked[0] if p in html]
        rng.choice(aimed if aimed and rng.random() < 0.5 else html).write_text('<!doctype html><script>const DATA = {"sources": []};</script>\n')
    elif what == "watch" and html:
        Path(f"{rng.choice(html)}.watch.json").write_text(json.dumps({"watches": [str(worktree)]}))
    elif what == "worktree":
        if worktree.exists():
            worktree.rmdir()
        else:
            worktree.mkdir()
    elif what == "statusline":
        statusline(session, rng)
    elif what == "open" and pages:
        hub.open(str(rng.choice(pages)), session)
    elif what in ("close", "visit", "dismiss") and (units := hub.view()["units"]):
        unit = rng.choice(units)
        if what != "close":
            hub.module.mark(what, {"unit": unit["unit"]})
        elif unit["members"]:
            hub.close(unit["unit"], rng.choice(unit["members"])["id"])


@prop("A hub unit's view and the rail are a function of what is on disk and the time.")
def view_of_disk():
    """The world's sessions run, and open and close its pages, at times a fixed clock gives, and leave session pages,
    transcripts and statusline files behind them. Read again with nothing changed, the hub builds no unit again. Then
    every kind of change in CHANGES happens, one at a time in some order, and the clock moves on. After each, the hub
    that kept what it read before shows what a hub loaded anew on the same state shows, and a hub tab listening all
    along is told what it is due (event_due). That hub hears the disk (its WATCH on): once it has read the world, a
    read with nothing changed reads no unit, and each read after a change reads only the units the kernel's notices
    name, so a change whose files the watch does not listen to shows. No session here runs in a tmux pane, so no unit
    offers a handoff."""

    @checked(8)
    @given(worlds(), st.lists(STEP, min_size=1, max_size=12), st.permutations(list(CHANGES)), st.lists(st.sampled_from(list(CHANGES)), max_size=3),
           st.randoms(use_true_random=False))
    def same(world, steps, every, again, rng):
        hub = fresh_hub()  # whose view is this world's alone
        placed = place(world, HOME)
        registry = running(placed, rng)
        lived(placed, rng)
        try:
            last: dict[int, tuple[str, str]] = {}
            for op, i, how, s in steps:
                hub.clock.tick()
                i, session = i % len(world.pages), placed.sessions[s % world.sessions]
                if op == "close" and i in last:
                    hub.close(*last[i])
                elif op == "open":
                    last[i] = hub.open(spell(placed, i, how if how != "served" else "path", None), session)
            hub.view()  # which writes the units' trees into their state files, a change the next read reads
            first = hub.view()
            with Builds(hub) as built:
                assert hub.view() == first
                assert not built, built
                hub.module.KEPT.clear()
                hub.view()
                assert sorted(built) == sorted(u["unit"] for u in first["units"]), built
            assert hub.module.WATCH.start()
            for _ in range(3):  # the first reads it all, and every unit whose files were first watched then once more
                hub.view()
            with Reads(hub) as read:
                assert hub.view() == first
                assert not read, f"read {read} with nothing changed"
            done, heard, before = [], hub.module.view_digest(), first
            for what in [*every, *again]:
                change(hub, placed, registry, what, rng)
                done.append(what)
                hub.clock.tick(rng.randrange(1, 10**5))
                with Reads(hub) as read:
                    warm = hub.view()
                cold = hub.restarted().view()
                assert hub.module.WATCH.on and None not in read.heard, f"after {done}: read it all ({hub.module.WATCH.why})"
                assert warm == cold, f"after {done}\n      kept {json.dumps(warm, sort_keys=True)}\n      anew {json.dumps(cold, sort_keys=True)}"
                now = hub.module.view_digest()
                told, due = hub.module.disk_event(heard, now), event_due(hub, before, warm)
                assert told == due, f"after {done}: told {told}, due {due}"
                heard, before = now, warm
        finally:
            hub.module.WATCH.off("the world is done with")
            for path in registry:
                path.unlink(missing_ok=True)

    same()


def event_due(hub: Hub, before: dict, after: dict) -> dict | None:
    """What a hub tab that read `before` is told once the hub is `after`: the units whose details changed, where they
    or the rail's index did; numbers alone where only those did; else nothing."""
    detail = lambda view: {u["unit"]: [u[k] for k in ("members", "pages", "tickets", "session_page")] for u in view["units"]}
    a, b = detail(before), detail(after)
    changed = sorted(k for k in a.keys() | b.keys() if a.get(k) != b.get(k))
    index = lambda view: [{k: v for k, v in u.items() if k != "context"} for u in hub.module.rail_index(view)["units"]]
    numbers = lambda view: (view["usage"], [(u["unit"], u["context"]) for u in view["units"]])
    if changed or index(before) != index(after):
        return {"type": "disk", "units": changed}
    return {"type": "numbers"} if numbers(before) != numbers(after) else None


class Reads(list):
    """The keys of the units the hub reads while this is entered, and what the disk watch had heard (`heard`) at each
    read of the hub: None where it read every unit."""

    def __init__(self, hub: Hub):
        super().__init__()
        self.module, self.heard = hub.module, []

    def __enter__(self) -> "Reads":
        self.kept_view, self.read_changed = self.module.kept_view, self.module.read_changed
        self.module.kept_view = lambda key, *rest: (self.append(key), self.kept_view(key, *rest))[1]
        self.module.read_changed = lambda heard: (self.heard.append(heard), self.read_changed(heard))[1]
        return self

    def __exit__(self, *_) -> None:
        self.module.kept_view, self.module.read_changed = self.kept_view, self.read_changed


class Builds(list):
    """The keys of the units the hub builds while this is entered."""

    def __init__(self, hub: Hub):
        super().__init__()
        self.module = hub.module

    def __enter__(self) -> "Builds":
        self.unit_view = self.module.unit_view
        self.module.unit_view = lambda key, *rest: (self.append(key), self.unit_view(key, *rest))[1]
        return self

    def __exit__(self, *_) -> None:
        self.module.unit_view = self.unit_view


# --------------------------------------------------------------------------


def main(only: list[str]) -> None:
    # the hub's module runs in this process, so what it runs (git, tracker, curl) gets the scratch HOME's environment
    HOME.mkdir()
    tracker = SCRATCH / "bin" / "tracker"
    tracker.parent.mkdir()
    tracker.write_text(TRACKER)
    tracker.chmod(0o755)
    moved = fakes.tools_env(HOME)
    moved["PATH"] = f"{tracker.parent}:{moved['PATH']}"
    os.environ.clear()
    os.environ.update(moved)
    fakes.with_reader(HOME)  # without the reader, turn records change no view

    def run(check) -> None:
        with contextlib.redirect_stderr(io.StringIO()):  # what the hub prints on the way, as its log would hold it
            check()

    run_properties(run, only)
    finish()


if __name__ == "__main__":
    atexit.register(shutil.rmtree, SCRATCH, ignore_errors=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    main(sys.argv[1:])
