#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Drive one hub relaying another's, as pc's relays the laptop's: two live hubs, each on a scratch HOME of its own.

"laptop" runs one session, registered as this test's own process, and has a page and a directory of pages in its HOME;
it listens on its socket alone. "pc" listens on a port, as a browser reaches it, and relays laptop's at that socket,
as it reaches the ssh forward of it. Run it directly; no framework. What the hub tab makes of the relay is
view.test's.
"""

import http.client
import json
import os
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import fakes  # noqa: E402  (a HOME's environment, and what Claude Code leaves on disk)
from check import BIN, check, finish, free_port, settles  # noqa: E402

SESSION = "aaaaaaaa-0000-4000-8000-000000000001"
SCRATCH = Path(tempfile.mkdtemp(prefix="relay.", dir=fakes.RUN))
PORT = free_port()
ORIGIN = f"http://127.0.0.1:{PORT}"


class Hub:
    """A hub on a HOME of its own, started and stopped as a process."""

    def __init__(self, name: str, *flags: str):
        self.name, self.home = name, SCRATCH / name / "home"
        self.home.mkdir(parents=True)
        self.socket = SCRATCH / name / "hub.sock"
        self.argv = [str(BIN / "container-hub"), "--socket", str(self.socket), "--state", str(SCRATCH / name / "state"),
                     "--host", name, "--tmux-socket", str(SCRATCH / name / "no-tmux.sock"), *flags]
        self.env = fakes.scrubbed(self.home)
        self.proc = None

    def start(self) -> None:
        self.proc = subprocess.Popen(self.argv, env=self.env, stdout=subprocess.DEVNULL,
                                     stderr=(SCRATCH / f"{self.name}.log").open("a"), start_new_session=True)
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline and self.proc.poll() is None:
            try:
                with socket.socket(socket.AF_UNIX) as s:
                    s.connect(str(self.socket))
                return
            except OSError:
                time.sleep(0.1)
        raise RuntimeError(f"{self.name}'s hub did not listen:\n{(SCRATCH / f'{self.name}.log').read_text()}")

    def stop(self) -> None:
        os.killpg(self.proc.pid, signal.SIGKILL)  # `uv run` leads the group; the server is its child
        self.proc.wait()
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            try:
                os.killpg(self.proc.pid, 0)
                time.sleep(0.05)
            except ProcessLookupError:
                break


class Unix(http.client.HTTPConnection):
    def __init__(self, path: Path):
        super().__init__("hub", timeout=30)
        self.path_ = path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.connect(str(self.path_))


def request(method: str, path: str, body=None, headers: dict | None = None, to: Path | None = None):
    """(status, headers, body as JSON where it parses) of a request to pc's port, or to a hub's socket as a local tool."""
    conn = Unix(to) if to else http.client.HTTPConnection("127.0.0.1", PORT, timeout=30)
    data = body if isinstance(body, bytes) or body is None else json.dumps(body).encode()
    conn.request(method, path, body=data, headers={"Content-Type": "application/json", **(headers or {})})
    r = conn.getresponse()
    raw = r.read()
    conn.close()
    try:
        return r.status, r.headers, json.loads(raw)
    except ValueError:
        return r.status, r.headers, raw


def token() -> str:
    """pc's token, as its hub tab gets it at its load."""
    page = request("GET", "/")[2].decode()
    return page.split('name="hub-token" content="', 1)[1].split('"', 1)[0]


def events(path: str) -> list[dict]:
    """The events a stream on pc's port sends from now on, as they arrive."""
    heard = []

    def listen() -> None:
        try:
            conn = http.client.HTTPConnection("127.0.0.1", PORT, timeout=60)
            conn.request("GET", path)
            for line in conn.getresponse():
                if line.startswith(b"data:"):
                    heard.append(json.loads(line[5:]))
        except OSError:
            pass

    threading.Thread(target=listen, daemon=True).start()
    return heard


laptop = Hub("laptop", "--url", "http://laptop.invalid")
pc = Hub("pc", "--port", str(PORT), "--peer", f"laptop={laptop.socket}")
# The session's process: not this test's, which a worker may run, and a hub leaves a dispatched worker's session off its
# rail.
process = subprocess.Popen(["sleep", "600"], env={k: v for k, v in laptop.env.items() if k != "DISPATCH_WORKLOG"})
running = laptop.home / ".claude" / "sessions" / f"{process.pid}.json"
running.parent.mkdir(parents=True)
running.write_text(json.dumps({"pid": process.pid, "procStart": fakes.started(process.pid), "sessionId": SESSION, "status": "idle",
                               "statusUpdatedAt": int(time.time() * 1000), "cwd": str(laptop.home)}))
shown = fakes.page(laptop.home / "notes" / "laptop.html", "<!doctype html><p>written on the laptop</p>")
later = fakes.page(laptop.home / "notes" / "more" / "a.html")

try:
    laptop.start()
    pc.start()
    tab = token()

    # --- one address for both hosts' sessions

    own = request("GET", "/api/hub")[2]
    check("pc's index names its host and the hosts it relays, and holds none of the laptop's units",
          ("pc", ["laptop"], []), (own["host"], own["peers"], [u["unit"] for u in own["units"]]))
    status, _, index = request("GET", "/h/laptop/api/hub")
    check("the laptop's index answers under /h/laptop/, as the laptop's hub has it, its session a unit",
          (200, "laptop", [SESSION], "idle"), (status, index["host"], [u["unit"] for u in index["units"]], index["units"][0]["state"]))
    status, _, unit = request("GET", f"/h/laptop/api/u/{SESSION}")
    check("...and one of its units", (200, SESSION, False), (status, unit["session"], "unreachable" in unit))
    request("POST", "/api/open", {"target": str(shown), "session": SESSION}, to=laptop.socket)  # an agent there opens it
    status, _, body = request("GET", "/h/laptop" + fakes.served(shown))
    check("a page in the laptop's HOME is served under the same prefix", (200, True), (status, b"written on the laptop" in body))
    status, got, _ = request("GET", "/h/laptop" + fakes.served(shown.parent / "more"))
    check("a redirect the laptop answers stays under the prefix", (301, "/h/laptop" + fakes.served(shown.parent / "more") + "/"),
          (status, got["Location"]))
    status, got, _ = request("GET", f"/h/laptop/u/{SESSION}")
    check("the laptop's hub tab is pc's, at the laptop's unit", (302, f"/u/laptop/{SESSION}"), (status, got["Location"]))
    check("a host pc relays none of is not found", 404, request("GET", "/h/xmg19/api/hub")[0])

    # --- acting on the host the session runs on

    status, _, said = request("POST", "/h/laptop/api/dismiss", {"unit": SESSION})
    check("a mark goes to the laptop's hub, which keeps it", (200, True),
          (status, request("GET", f"/api/u/{SESSION}", to=laptop.socket)[2]["dismissed"]))
    check("...and pc's keeps no unit of the laptop's", [], [u["unit"] for u in request("GET", "/api/hub")[2]["units"]])
    status, _, said = request("POST", f"/h/laptop/api/drop?unit={SESSION}&name=shot.png", b"png bytes",
                              {"Content-Type": "application/octet-stream"})
    check("an action without pc's token is refused, and reaches no hub", (403, []),
          (status, list(laptop.home.glob(".cache/container-hub/drops/**/*.png"))))
    status, _, said = request("POST", f"/h/laptop/api/drop?unit={SESSION}&name=shot.png", b"png bytes",
                              {"Content-Type": "application/octet-stream", "X-Hub-Token": tab})
    check("with pc's token, the laptop's hub acts, with its own: the file is saved in the laptop's HOME",
          (200, True, b"png bytes"), (status, said["path"].startswith(str(laptop.home)), Path(said["path"]).read_bytes()))
    status, _, said = request("POST", "/h/laptop/api/type", {"unit": SESSION, "text": "hi"}, {"X-Hub-Token": tab})
    check("...and a refusal is the laptop's own to say", (409, "the session runs in no tmux pane"), (status, said.get("error")))
    status = request("POST", "/h/laptop/api/visit", {"unit": SESSION}, {"Origin": "https://elsewhere.example"})[0]
    check("a page on another site cannot write through the relay", 403, status)
    check("the laptop's token is pc's to ask, never a browser's", 403, request("GET", "/h/laptop/api/token")[0])
    check("pc's own token goes to no request on its port", 403, request("GET", "/api/token")[0])
    check("...nor to one `tailscale serve` forwards to its socket", 403,
          request("GET", "/api/token", headers={"X-Forwarded-Host": "pc.example:8377"}, to=pc.socket)[0])
    check("...but to a local tool on its socket, as the relay is to the laptop's", True,
          len(request("GET", "/api/token", to=pc.socket)[2]["token"]) >= 24)

    # --- the laptop's events, through the relay

    heard = events("/h/laptop/events")
    settles("the relayed stream opens with the relay's word that the laptop answers", [{"type": "reached"}], lambda: heard[:1])
    request("POST", "/api/open", {"target": str(later), "session": SESSION}, to=laptop.socket)
    settles("...then carries the laptop's own events", ["added"], lambda: [e["type"] for e in heard[1:]])
    request("GET", f"/h/laptop/api/u/{SESSION}")  # the hub tab reads the unit the event names

    # --- the laptop asleep

    laptop.stop()
    status, _, index = request("GET", "/h/laptop/api/hub")
    check("with the laptop down, its index is what it last answered, marked unreachable, its session not ended",
          (200, [SESSION], "idle", True), (status, [u["unit"] for u in index["units"]], index["units"][0]["state"],
                                          "laptop does not answer" in index["unreachable"]["why"]))
    status, _, unit = request("GET", f"/h/laptop/api/u/{SESSION}")
    check("...and so is its unit, with the page it opened last", (200, True, True),
          (status, bool(unit["unreachable"]), any(m["url"] == fakes.served(later) for m in unit["members"])))
    status, _, said = request("POST", "/h/laptop/api/type", {"unit": SESSION, "text": "hi"}, {"X-Hub-Token": tab})
    check("an action is refused, saying the laptop does not answer", (502, True), (status, said["error"].startswith("laptop does not answer")))
    check("a page is refused", 502, request("GET", "/h/laptop" + fakes.served(shown))[0])
    asleep = events("/h/laptop/events")
    settles("the stream says the laptop does not answer", ["unreachable"], lambda: [e["type"] for e in asleep[:1]])
    pc.stop()
    pc.start()
    check("pc restarted while the laptop sleeps still has what the laptop last answered", ([SESSION], True),
          ((index := request("GET", "/h/laptop/api/hub")[2]) and [u["unit"] for u in index["units"]], "unreachable" in index))
    laptop.start()
    check("the laptop back, its index is live again", (200, False), (lambda r: (r[0], "unreachable" in r[2]))(request("GET", "/h/laptop/api/hub")))
finally:
    process.kill()
    for hub in (pc, laptop):
        if hub.proc and hub.proc.poll() is None:
            hub.stop()

finish()
