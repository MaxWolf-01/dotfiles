#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Drive one hub relaying another's, as pc's relays the laptop's: two live hubs, each on a scratch HOME of its own.

"laptop" runs one session, registered as this test's own process, and has a page and a directory of pages in its HOME;
it listens on its socket alone. "pc" listens on a port, as a browser reaches it, and relays laptop's at that socket,
as it reaches the ssh forward of it. Run it directly; no framework. What the hub tab makes of the relay is
view.test's.
"""

import http.client
import http.server
import json
import socketserver
import sys
import tempfile
import threading
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import fakes  # noqa: E402  (a HOME's environment, and what Claude Code leaves on disk)
from check import check, finish, free_port, settles  # noqa: E402

SESSION = "aaaaaaaa-0000-4000-8000-000000000001"
SCRATCH = Path(tempfile.mkdtemp(prefix="relay.", dir=fakes.RUN))
PORT = free_port()
ORIGIN = f"http://127.0.0.1:{PORT}"


def request(method: str, path: str, body=None, headers: dict | None = None, to: Path | None = None):
    """A request to pc's port, or to a hub's socket as a local tool, as fakes.request answers it."""
    return fakes.request(to or PORT, method, path, body, headers, timeout=30)


def token() -> str:
    """pc's token, as its hub tab gets it at its load."""
    return fakes.token(PORT)


def events(path: str) -> list[dict]:
    """The events a stream on pc's port sends from now on, as they arrive."""
    heard = []

    def listen() -> None:
        try:
            conn = http.client.HTTPConnection("127.0.0.1", PORT, timeout=60)
            conn.request("GET", path)
            for line in conn.getresponse():
                if line.startswith(b"data:"):
                    heard.append(json.loads(line[5:]))
        except OSError:
            pass

    threading.Thread(target=listen, daemon=True).start()
    return heard


class Stub(http.server.BaseHTTPRequestHandler):
    """A peer that answers every request and records it: what pc's own guards let through to a peer."""
    reached: list[str] = []

    def answer(self):
        Stub.reached.append(f"{self.command} {self.path}")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(b'{"token": "stub-token-stub-token-stub-token"}')

    do_GET = do_POST = answer

    def log_message(self, *_):
        pass


class UnixHTTPServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True

    def get_request(self):  # BaseHTTPRequestHandler wants a client address it can index
        conn, _ = super().get_request()
        return conn, ("stub", 0)


SECOND = "bbbbbbbb-0000-4000-8000-000000000002"  # a session of the laptop's whose unit no tab reads
stub = UnixHTTPServer(str(SCRATCH / "stub.sock"), Stub)
threading.Thread(target=stub.serve_forever, daemon=True).start()
laptop = fakes.Hub(SCRATCH, "laptop", "--url", "http://laptop.invalid")
pc = fakes.Hub(SCRATCH, "pc", "--port", str(PORT), "--peer", f"laptop={laptop.socket}", f"stub={SCRATCH / 'stub.sock'}")
processes = [laptop.running(session) for session in (SESSION, SECOND)]
for entry in (laptop.home / ".claude/sessions").glob("*.json"):  # SECOND at work, so a state kept is told from one made up
    if (entry_said := json.loads(entry.read_text()))["sessionId"] == SECOND:
        entry.write_text(json.dumps({**entry_said, "status": "busy"}))
shown = fakes.page(laptop.home / "notes" / "laptop.html", "<!doctype html><p>written on the laptop</p>")
later = fakes.page(laptop.home / "notes" / "more" / "a.html")
kept_by_pc = SCRATCH / "pc" / "state" / "peers" / "laptop.json"

try:
    laptop.start()
    pc.start()
    tab = token()

    # --- one address for both hosts' sessions

    own = request("GET", "/api/hub")[2]
    check("pc's index names its host and the hosts it relays, and holds none of the laptop's units",
          ("pc", ["laptop", "stub"], []), (own["host"], own["peers"], [u["unit"] for u in own["units"]]))
    status, _, index = request("GET", "/h/laptop/api/hub")
    check("the laptop's index answers under /h/laptop/, as the laptop's hub has it, its sessions units",
          (200, "laptop", {SESSION: "idle", SECOND: "busy"}),
          (status, index["host"], {u["unit"]: u["state"] for u in index["units"]}))
    status, _, unit = request("GET", f"/h/laptop/api/u/{SESSION}")
    check("...and one of its units", (200, SESSION, False), (status, unit["session"], "unreachable" in unit))
    heard = events("/h/laptop/events")
    settles("the relayed event stream opens with the relay's word that the laptop answers", [{"type": "reached"}], lambda: heard[:1])
    request("POST", "/api/open", {"target": str(shown), "session": SESSION}, to=laptop.socket)  # an agent there
    settles("...while the stream carries the laptop's own events", ["added"], lambda: [e["type"] for e in heard[1:]])
    status, _, body = request("GET", "/h/laptop" + fakes.served(shown))
    check("a page in the laptop's HOME is served under the same prefix", (200, True), (status, b"written on the laptop" in body))
    status, got, _ = request("GET", "/h/laptop" + fakes.served(shown.parent / "more"))
    check("a redirect the laptop answers stays under the prefix", (301, "/h/laptop" + fakes.served(shown.parent / "more") + "/"),
          (status, got["Location"]))
    status, got, _ = request("GET", f"/h/laptop/u/{SESSION}")
    check("the laptop's hub tab is pc's, at the laptop's unit", (302, f"/u/laptop/{SESSION}"), (status, got["Location"]))
    check("a host pc relays none of is not found", 404, request("GET", "/h/xmg19/api/hub")[0])

    # --- acting on the host the session runs on

    status = request("POST", "/h/laptop/api/dismiss", {"unit": SESSION})[0]
    check("a mark goes to the laptop's hub, which keeps it", (200, True),
          (status, request("GET", f"/api/u/{SESSION}", to=laptop.socket)[2]["dismissed"]))
    status, _, said = request("POST", f"/h/laptop/api/drop?unit={SESSION}&name=shot.png", b"png bytes",
                              {"Content-Type": "application/octet-stream", "X-Hub-Token": tab})
    check("with pc's token, the laptop's hub acts, with its own: the file is saved in the laptop's HOME",
          (200, True, b"png bytes"), (status, said["path"].startswith(str(laptop.home)), Path(said["path"]).read_bytes()))
    status, _, said = request("POST", "/h/laptop/api/type", {"unit": SESSION, "text": "hi"}, {"X-Hub-Token": tab})
    check("...and a refusal is the laptop's own to say", (409, "the session runs in no tmux pane"), (status, said.get("error")))

    # --- pc's own guards, before anything reaches a peer

    refused = [request("POST", f"/h/stub/api/drop?unit={SESSION}&name=x", b"x", {"Content-Type": "application/octet-stream"})[0],
               request("POST", "/h/stub/api/visit", {"unit": SESSION}, {"Origin": "https://elsewhere.example"})[0],
               request("GET", "/h/stub/api/token")[0], request("POST", "/h/stub/api/serve", {"path": "/"})[0]]
    check("an action without pc's token, a write from another site, and the peer's token or sharing are refused by pc",
          ([403] * 4, []), (refused, Stub.reached))
    check("pc's own token goes to no request on its port", 403, request("GET", "/api/token")[0])
    check("...nor to one `tailscale serve` forwards to its socket", 403,
          request("GET", "/api/token", headers={"X-Forwarded-Host": "pc.example:8377"}, to=pc.socket)[0])
    check("...but to a local tool on its socket, as the relay is to the laptop's", True,
          len(request("GET", "/api/token", to=pc.socket)[2]["token"]) >= 24)

    # --- the laptop asleep

    request("POST", "/api/open", {"target": str(later), "session": SESSION}, to=laptop.socket)
    settles("the event of a page an agent opens on the laptop comes through", 2, lambda: sum(e["type"] == "added" for e in heard))
    request("GET", f"/h/laptop/api/u/{SESSION}")  # the hub tab reads the unit the event names, which pc keeps
    settles("pc keeps a unit no tab read, its details read by the relay itself", True,
            lambda: kept_by_pc.exists() and f"/api/u/{SECOND}" in json.loads(kept_by_pc.read_text()))
    laptop.stop()
    status, _, index = request("GET", "/h/laptop/api/hub")
    check("with the laptop down, its index is what it last answered, marked unreachable, its sessions not ended",
          (200, {SESSION: "idle", SECOND: "busy"}, True),
          (status, {u["unit"]: u["state"] for u in index["units"]},
           "laptop does not answer" in index["unreachable"]["why"]))
    status, _, unit = request("GET", f"/h/laptop/api/u/{SESSION}")
    check("...and so is its unit, with the page it opened last", (200, True, True),
          (status, bool(unit["unreachable"]), any(m["url"] == fakes.served(later) for m in unit["members"])))
    status, _, unit = request("GET", f"/h/laptop/api/u/{SECOND}")
    check("...and the unit no tab read", (200, SECOND, True), (status, unit.get("session"), bool(unit.get("unreachable"))))
    status, _, said = request("POST", "/h/laptop/api/type", {"unit": SESSION, "text": "hi"}, {"X-Hub-Token": tab})
    check("an action is refused, saying the laptop does not answer", (502, True), (status, said["error"].startswith("laptop does not answer")))
    check("a page fetched is refused", 502, request("GET", "/h/laptop" + fakes.served(shown))[0])
    status, got, page = request("GET", "/h/laptop" + fakes.served(shown), headers={"Sec-Fetch-Dest": "iframe"})
    check("...and a page loaded in a frame is a notice in its place: the laptop does not answer, and when pc last read it",
          (502, "text/html; charset=utf-8", True, True, False),
          (status, got["Content-Type"], '<meta name="hub-unreachable" content="laptop">' in page.decode(),
           "The hub last read laptop at <time data-at=" in page.decode(), b"written on the laptop" in page))
    asleep = events("/h/laptop/events")
    settles("the stream says the laptop does not answer", ["unreachable"], lambda: [e["type"] for e in asleep[:1]])
    pc.stop()
    pc.start()
    index = request("GET", "/h/laptop/api/hub")[2]
    check("pc restarted while the laptop sleeps still has what the laptop last answered", ([SESSION, SECOND], True),
          (sorted(u["unit"] for u in index["units"]), "unreachable" in index))
    (SCRATCH / "laptop" / "state" / "token").unlink()  # the laptop's hub makes a token anew
    laptop.start()
    check("the laptop back, its index is live again", (200, False), (lambda r: (r[0], "unreachable" in r[2]))(request("GET", "/h/laptop/api/hub")))
    status, _, said = request("POST", "/h/laptop/api/type", {"unit": SESSION, "text": "hi"}, {"X-Hub-Token": tab})
    check("...and an action reaches it with its new token", (409, "the session runs in no tmux pane"), (status, said.get("error")))
finally:
    for process in processes:
        process.kill()
    for hub in (pc, laptop):
        if hub.proc and hub.proc.poll() is None:
            hub.stop()
    stub.shutdown()

finish()
