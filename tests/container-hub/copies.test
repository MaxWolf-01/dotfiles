#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Drive a hub showing another host's sessions from its session copies while that host does not answer, and forking one,
as the laptop's shows pc's: two live hubs, each on a scratch HOME of its own.

"laptop" listens on a port, as a browser reaches it, and relays pc at pc's socket. Its --copies holds pc's sessions as
bin/session-copies pulls them, through an ssh stub that lands in pc's HOME: the copy of this user's home on pc, and
beside it what the pull recorded. pc runs first, so the relay has read it, then goes down. The fork is followed as far as the tmux window Claude Code would start
in, which neither hub has: the window itself is server.test's. Then pc answers again, with a copy of the laptop holding
the fork's record. Run it directly; no framework.
"""

import http.client
import json
import os
import pwd
import subprocess
import sys
import tempfile
import urllib.parse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import fakes  # noqa: E402  (a HOME's environment, and what Claude Code leaves on disk)
from check import check, finish, free_port  # noqa: E402

ENDED = "aaaaaaaa-0000-4000-8000-000000000001"  # ran on pc while the laptop read it, ended before the last pull
IDLE = "bbbbbbbb-0000-4000-8000-000000000002"  # idle at the last pull, which the laptop never read
WORKING = "cccccccc-0000-4000-8000-000000000003"  # at work at the last pull
WORKER = "dddddddd-0000-4000-8000-000000000004"  # nobody types into it (`claude -p`)
FORK = "eeeeeeee-0000-4000-8000-000000000005"  # a fork of WORKING made on the laptop earlier
BEHIND = "abababab-0000-4000-8000-000000000006"  # ended on a branch the laptop has, one commit behind what pc pushed
OWNED = "cdcdcdcd-0000-4000-8000-000000000007"  # ended, and in the laptop's own transcripts too
ASTRAY = "efefefef-0000-4000-8000-000000000008"  # ended in a checkout the laptop has, there on another branch
SCRATCH = Path(tempfile.mkdtemp(prefix="copies.", dir=fakes.RUN))
PORT = free_port()
USER = pwd.getpwuid(os.getuid()).pw_name
PC, PC_DEST = "tower", "tower-over-ssh"
"""pc's name in the hosts list, which is its hub's --peer name and its copy's, and the ssh destination its copies are
pulled from. Not "pc" itself: a pull leaves out a source on the host it runs on, and the host running this may be pc."""


def request(method: str, path: str, body=None, headers: dict | None = None):
    """(status, headers, body as JSON where it parses) of a request to the laptop's port."""
    conn = http.client.HTTPConnection("127.0.0.1", PORT, timeout=60)
    data = body if isinstance(body, bytes) or body is None else json.dumps(body).encode()
    conn.request(method, path, body=data, headers={"Content-Type": "application/json", **(headers or {})})
    r = conn.getresponse()
    raw = r.read()
    conn.close()
    try:
        return r.status, r.headers, json.loads(raw)
    except ValueError:
        return r.status, r.headers, raw


def token() -> str:
    page = request("GET", "/")[2].decode()
    return page.split('name="hub-token" content="', 1)[1].split('"', 1)[0]


def lines(session: str, cwd: Path, *more: dict, branch: str = "ticket/x") -> str:
    """A transcript as Claude Code writes one, in short: where it ran and on which branch, then `more`."""
    return "".join(json.dumps(line, separators=(",", ":")) + "\n" for line in (
        {"type": "user", "sessionId": session, "cwd": str(cwd), "gitBranch": branch, "entrypoint": "cli",
         "message": {"role": "user", "content": "go"}}, *more))


def turn_end(sidechain: bool = False) -> dict:
    return {"type": "system", "subtype": "turn_duration", "durationMs": 1000, "isSidechain": sidechain}


def git(cwd: Path, *args: str) -> str:
    return subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *args], cwd=cwd, env=laptop.env,
                          check=True, capture_output=True, text=True).stdout.strip()


laptop_copies, pc_copies = SCRATCH / "laptop-copies", SCRATCH / "pc-copies"
pc = fakes.Hub(SCRATCH, PC, "--url", f"http://{PC}.invalid", "--copies", str(pc_copies))
laptop = fakes.Hub(SCRATCH, "laptop", "--port", str(PORT), "--peer", f"{PC}={pc.socket}", "--copies", str(laptop_copies))

# a repo on the laptop whose origin has the branch pc's session was on, which the laptop never checked out
origin = SCRATCH / "origin.git"
repo = laptop.home / "repos" / "proj"
repo.mkdir(parents=True)
subprocess.run(["git", "init", "-q", "--bare", str(origin)], check=True, env=laptop.env)
git(repo, "init", "-q", "-b", "master")
(repo / "README.md").write_text("proj")
git(repo, "add", "README.md")
git(repo, "commit", "-q", "-m", "init")
git(repo, "remote", "add", "origin", str(origin))
git(repo, "push", "-q", "origin", "master")
git(repo, "checkout", "-q", "-b", "ticket/x")
(repo / "work.txt").write_text("pushed from pc")
git(repo, "add", "work.txt")
git(repo, "commit", "-q", "-m", "work on x")
git(repo, "push", "-q", "origin", "ticket/x")
pushed = git(repo, "rev-parse", "HEAD")
git(repo, "checkout", "-q", "master")
git(repo, "branch", "-q", "-D", "ticket/x")
git(repo, "update-ref", "-d", "refs/remotes/origin/ticket/x")  # fetched only by the fork
worktree = repo / ".worktrees" / "x"  # where pc's session ran: the same path on both hosts, as under /home/max
git(repo, "checkout", "-q", "-b", "ticket/y")  # a branch the laptop has, which pc took one commit further
git(repo, "push", "-q", "origin", "ticket/y")
git(repo, "checkout", "-q", "master")
other = SCRATCH / "pc-checkout"
subprocess.run(["git", "clone", "-q", "-b", "ticket/y", str(origin), str(other)], check=True, env=laptop.env)
(other / "y.txt").write_text("pushed from pc")
git(other, "add", "y.txt")
git(other, "commit", "-q", "-m", "work on y")
git(other, "push", "-q", "origin", "ticket/y")
pushed_y = git(other, "rev-parse", "HEAD")

# pc's sessions, in pc's HOME, and the laptop's copy of them as a pull under the hosts list's name for pc leaves it,
# pc reached at an ssh destination of another name. The pull keeps the registry entries of processes that run.
ended_said = lines(ENDED, worktree, {"type": "custom-title", "customTitle": "the ended one", "sessionId": ENDED}, turn_end())
fakes.page(pc.home / ".claude-helferline/projects/-p" / f"{ENDED}.jsonl", ended_said)  # under the second account
fakes.page(pc.home / ".claude-helferline/projects/-p" / ENDED / "subagents/a.jsonl", "{}\n")  # its agents' transcripts
fakes.page(pc.home / ".claude/projects/-p" / f"{BEHIND}.jsonl", lines(BEHIND, repo / ".worktrees" / "y", branch="ticket/y"))
fakes.page(pc.home / ".claude/projects/-p" / f"{OWNED}.jsonl", lines(OWNED, laptop.home))
fakes.page(pc.home / ".claude/projects/-p" / f"{ASTRAY}.jsonl", lines(ASTRAY, repo))
owned = fakes.page(laptop.home / ".claude/projects/-q" / f"{OWNED}.jsonl", lines(OWNED, laptop.home, turn_end()))
fakes.page(pc.home / ".claude/projects/-p" / f"{IDLE}.jsonl", lines(IDLE, laptop.home, {"type": "custom-title", "customTitle": "the idle one", "sessionId": IDLE}))
fakes.page(pc.home / ".claude/projects/-p" / f"{WORKING}.jsonl", lines(WORKING, laptop.home))
fakes.page(pc.home / ".claude/projects/-p" / f"{WORKER}.jsonl", lines(WORKER, laptop.home))
fakes.page(pc.home / ".claude/session-pages" / IDLE / "index.html", "<!doctype html><body><h1>the idle one</h1><p>its turns</p>")
fakes.page(pc.home / ".claude-helferline/session-pages" / ENDED / "index.html", "<!doctype html><body><h1>the ended one</h1>")
running = {session: pc.running(session) for session in (IDLE, WORKING, WORKER)}
for entry in (pc.home / ".claude/sessions").glob("*.json"):
    said = json.loads(entry.read_text())
    status, kind = {IDLE: ("idle", "interactive"), WORKING: ("busy", "interactive"), WORKER: ("idle", "sdk-cli")}[said["sessionId"]]
    entry.write_text(json.dumps({**said, "status": status, "kind": kind}))
stub = SCRATCH / "stub"
fakes.page(stub / "ssh", f"""#!/usr/bin/env bash
while [[ $1 == -* ]]; do shift; done
[ "$1" = {PC_DEST} ] || {{ echo "ssh: Could not resolve hostname $1" >&2; exit 255; }}
shift
cd {pc.home} && HOME={pc.home} USER={USER} exec sh -c "$*"
""").chmod(0o755)
pull = subprocess.run([str(fakes.BIN / "session-copies"), "--sources", f"{PC}={PC_DEST}", "--root", str(laptop_copies)],
                      env={**laptop.env, "PATH": f"{stub}:{laptop.env['PATH']}"}, capture_output=True, text=True, timeout=120)
for process in running.values():
    process.kill()
for entry in (pc.home / ".claude/sessions").glob("*.json"):  # pc's hub starts with none of them running
    entry.unlink()
copy = laptop_copies / PC / USER
PULLED = json.loads((laptop_copies / PC / f"{USER}.pulled.json").read_text())["at"] if pull.returncode == 0 else 0.0
# a fork of WORKING the laptop made earlier, and its page
fork_pages = laptop.home / ".claude/session-pages" / FORK
fakes.page(fork_pages / "forked-from.json", json.dumps({"host": PC, "session": WORKING, "point": len(lines(WORKING, laptop.home)),
                                                        "pulled": PULLED, "at": PULLED + 60, "on": "laptop",
                                                        "page": str(copy / ".claude/session-pages" / WORKING)}))
fakes.page(fork_pages / "index.html", "<!doctype html><body><h1>the fork</h1><p>its turns</p>")
(laptop.home / ".claude-helferline/projects").mkdir(parents=True)

processes = []
try:
    pc.start()
    laptop.start()
    processes.append(pc.running(ENDED))
    tab = token()
    check("the laptop's copy of pc is the one a pull from another ssh destination left under pc's name in the hosts list",
          (0, True, str(pc.home)), (pull.returncode, copy.is_dir(), json.loads(copy.with_name(f"{USER}.pulled.json").read_text())["home"]))
    status, _, index = request("GET", f"/h/{PC}/api/hub")
    check("while pc answers, the laptop reads its index through the relay", (200, [ENDED]), (status, [u["unit"] for u in index["units"]]))
    status, _, sessions = request("GET", f"/h/{PC}/api/sessions")
    check("...and what its search lists, from pc's own transcripts", (200, True, None),
          (status, {ENDED, IDLE, BEHIND} <= {s[0] for s in sessions["sessions"]}, sessions.get("unreachable")))
    status, _, unit = request("GET", f"/h/{PC}/api/u/{BEHIND}")
    check("...one of which no unit holds is shown, through the relay, as the unit pc's hub would make of it",
          (200, BEHIND, "ended", None), (status, unit.get("session"), unit.get("state"), unit.get("unreachable")))
    pc.stop()
    processes.pop().kill()

    # --- pc down: its sessions from the copy

    status, _, index = request("GET", f"/h/{PC}/api/hub")
    units = {u["unit"]: u for u in index["units"]}
    check("with pc down, its index lists the session the relay last read and each a person typed into at the last pull, "
          "each with how current its copy is: the time of the pull, and the session's state then",
          (200, True, {ENDED: {"state": "ended", "at": PULLED}, IDLE: {"state": "idle", "at": PULLED},
                       WORKING: {"state": "working", "at": PULLED}}),
          (status, bool(index.get("unreachable")), {k: u.get("copy") for k, u in units.items()}))
    check("...the session the relay never read titled as its transcript has it, and running as it was",
          ("the idle one", "idle", "busy"), (units.get(IDLE, {}).get("title"), units.get(IDLE, {}).get("state"),
                                             units.get(WORKING, {}).get("state")))
    status, _, sessions = request("GET", f"/h/{PC}/api/sessions")
    listed = {s[0]: (s[1], sessions["accounts"][s[2]]) for s in sessions.get("sessions", [])}
    check("with pc down, the search lists its sessions from the copy, each under its account as pc names it, with when "
          "the copy was pulled, one with no title untitled",
          (200, ("the ended one", f"{pc.home}/.claude-helferline"), ("", f"{pc.home}/.claude"), PULLED),
          (status, listed.get(ENDED), listed.get(BEHIND), (sessions.get("unreachable") or {}).get("at")))
    status, _, unit = request("GET", f"/h/{PC}/api/u/{BEHIND}")
    check("...and one no unit holds, which the relay never read, opens as its unit from the copy, ended", (200, BEHIND, "ended", True),
          (status, unit.get("session"), unit.get("state"), bool(unit.get("unreachable"))))
    status, _, unit = request("GET", f"/h/{PC}/api/u/{IDLE}")
    page_url = fakes.served(pc.home / ".claude/session-pages" / IDLE / "index.html")
    check("a unit the relay never read has its details from the copy: its session page where pc serves it",
          (200, page_url, {"state": "idle", "at": PULLED}), (status, unit.get("session_page", {}).get("url"), unit.get("copy")))
    status, got, page = request("GET", f"/h/{PC}" + page_url, headers={"Sec-Fetch-Dest": "iframe"})
    check("...and that page opens, from the copy, saying it is the copy and when it was pulled",
          (200, True, True), (status, b"its turns" in page, b"this is its copy, as this host last pulled it at <time" in page))
    sneaked = urllib.parse.quote(f"{pc.home}/.claude/session-pages/../projects/-p/{IDLE}.jsonl")
    check("...but nothing of the copy outside the session page directories", 502, request("GET", f"/h/{PC}/f{sneaked}")[0])

    # --- the fork, as far as the tmux window it would run in

    status, _, said = request("POST", "/api/fork", {"host": PC, "session": IDLE})
    check("a fork wants the hub tab's token", 403, status)
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": WORKING}, {"X-Hub-Token": tab})
    check("a fork of a session that was working at the last pull asks first, naming that pull", (409, {"state": "working", "at": PULLED}),
          (status, said.get("confirm")))
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": WORKING, "pulled": PULLED - 1}, {"X-Hub-Token": tab})
    check("...and asks again where the answer names another pull", (409, True), (status, "confirm" in said))
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": WORKING, "pulled": PULLED}, {"X-Hub-Token": tab})
    check("...and goes ahead once it names that pull, here as far as the tmux server this hub has none of", (409, True),
          (status, "no tmux server runs" in said.get("error", "")))
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": OWNED}, {"X-Hub-Token": tab})
    check("a session whose transcript the laptop's own transcripts hold is the laptop's to resume, and is not forked, its "
          "transcript left as it was", (409, True, lines(OWNED, laptop.home, turn_end())),
          (status, "this host's own transcripts hold the session" in said.get("error", ""), owned.read_text()))
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": ENDED}, {"X-Hub-Token": tab})
    check("a fork of an ended one goes ahead at once, here to the tmux server this hub has none of",
          (409, True), (status, "no tmux server runs" in said.get("error", "")))
    landed = laptop.home / ".claude-helferline/projects/-p"
    check("...its transcript copied into the laptop's own projects, under the account it ran under, its agents' with it",
          (ended_said, True), ((landed / f"{ENDED}.jsonl").read_text(), (landed / ENDED / "subagents/a.jsonl").is_file()))
    check("...the session's directory, which the laptop had not, made a worktree of the branch the session was on, as "
          "origin has it", ("ticket/x", pushed), (git(worktree, "branch", "--show-current"), git(worktree, "rev-parse", "HEAD")))
    check("...and no fork's page directory left of a fork that did not start", [FORK],
          [d.name for d in laptop.home.glob(".claude*/session-pages/*")])
    request("POST", "/api/fork", {"host": PC, "session": BEHIND}, {"X-Hub-Token": tab})
    check("a worktree of a branch the laptop has, behind what pc pushed, starts from what pc pushed", pushed_y,
          git(repo / ".worktrees" / "y", "rev-parse", "HEAD"))
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": ASTRAY}, {"X-Hub-Token": tab})
    check("a fork into a checkout the laptop has says it is on another branch than the session was, and leaves it there",
          (True, "master"), (f"{repo} is on master, where the session was last on ticket/x" in said.get("error", ""),
                             git(repo, "branch", "--show-current")))
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": ENDED}, {"X-Hub-Token": tab})
    check("a fork tried again takes the worktree there, and the transcript the first copied is no refusal", (409, True),
          (status, "no tmux server runs" in said.get("error", "")))
    status, _, said = request("POST", "/api/resume", {"unit": ENDED}, {"X-Hub-Token": tab})
    check("the laptop never resumes the session under its own id from the copy a fork started from", (409, True),
          (status, "only as the copy a fork of it started from" in said.get("error", "")))

    # --- the fork's page

    status, _, page = request("GET", fakes.served(fork_pages / "index.html"))
    copied_page = (copy / ".claude/session-pages" / WORKING / "index.html").as_uri()
    check("a fork's session page opens with a link to the copy of the page of the session it forks",
          (200, True), (status, page.find(f'href="{copied_page}"'.encode()) > page.find(b"</h1>") > 0))
    status, _, said = request("POST", "/api/open", {"target": copied_page, "unit": FORK, "by": "user"}, {"Origin": f"http://127.0.0.1:{PORT}"})
    check("...which the hub tab follows to that session's unit, on its host", (200, WORKING, PC), (status, said.get("unit"), said.get("host")))

    # --- pc answers again

    own = fakes.page(pc.home / ".claude-helferline/projects/-p" / f"{ENDED}.jsonl",
                     ended_said + lines(ENDED, worktree, turn_end(), turn_end(sidechain=True), turn_end()))
    after = len(own.read_bytes()) - len(ended_said)
    # pc's copy of the laptop, holding a fork of ENDED made there
    fakes.page(pc_copies / "laptop" / USER / ".claude/session-pages" / FORK.replace("e", "f") / "forked-from.json",
               json.dumps({"host": PC, "session": ENDED, "point": len(ended_said), "pulled": PULLED, "at": PULLED + 120,
                           "on": "laptop", "page": "/elsewhere"}))
    fakes.page(pc_copies / "laptop" / USER / ".claude/session-pages" / FORK.replace("e", "9") / "forked-from.json",  # an earlier fork
               json.dumps({"host": PC, "session": ENDED, "point": 1, "pulled": PULLED, "at": PULLED + 90, "on": "laptop", "page": "/elsewhere"}))
    fakes.page(pc_copies / "laptop" / f"{USER}.pulled.json", json.dumps({"at": PULLED + 200, "home": str(laptop.home)}))
    processes += [pc.running(ENDED), pc.running(WORKING)]
    pc.start()
    status, _, unit = request("GET", f"/h/{PC}/api/u/{ENDED}")
    check("once pc answers, its own hub shows the session forked on the laptop, from the fork record in its copy of the "
          "laptop, the latest fork where there are two, with what pc wrote after the point it started from, the turns of "
          "agents left out",
          (200, {"on": "laptop", "session": FORK.replace("e", "f"), "after": {"bytes": after, "turns": 2}}),
          (status, {k: (unit.get("forked") or {}).get(k) for k in ("on", "session", "after")}))
    refused = [request("POST", f"/h/{PC}/api/{route}", {"unit": ENDED, "text": "hi", "offer": "hand-off"}, {"X-Hub-Token": tab})
               for route in ("type", "hand-off", "resume")]
    check("...and pc's hub types nothing into it, nor hands it off or resumes it", [(409, True)] * 3,
          [(status, "forked on laptop" in said.get("error", "")) for status, _, said in refused])
    status, _, index = request("GET", f"/h/{PC}/api/hub")
    working = next((u for u in index["units"] if u["unit"] == WORKING), {})
    check("a session forked here that pc does not know of yet is marked so by the relay, from the laptop's own record",
          ("laptop", FORK, {"bytes": 0, "turns": 0}),
          ((working.get("forked") or {}).get("on"), (working.get("forked") or {}).get("session"), (working.get("forked") or {}).get("after")))
    refused = [request("POST", f"/h/{PC}/api/{route}", {"unit": WORKING, "text": "hi", "offer": "hand-off"}, {"X-Hub-Token": tab})
               for route in ("type", "hand-off", "resume")]
    check("...and the relay types nothing into it, nor hands it off or resumes it", [(409, True)] * 3,
          [(status, "forked here" in said.get("error", "")) for status, _, said in refused])
    status, _, said = request("POST", "/api/fork", {"host": PC, "session": IDLE}, {"X-Hub-Token": tab})
    check("a session of a host that answers is not forked: it is that host's to resume", (409, True),
          (status, f"{PC} answers" in said.get("error", "")))
finally:
    for process in processes:
        process.kill()
    for hub in (laptop, pc):
        if hub.proc and hub.proc.poll() is None:
            hub.stop()

finish()
