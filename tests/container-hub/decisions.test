#!/usr/bin/env -S uv run --script --quiet
# tier: fast
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro", "pyyaml", "markdown-it-py[linkify]"]  # the hub's own, whose module this loads
# ///
"""Check what the container hub decides: which unit a page lands in, its lane and title, a unit's pages, how the rail
numbers the units, what never opens, what leaves. Run it directly; no framework.

The hub's module is loaded in this process, as tests/vpn/examples.test checks bin/vpn, its functions called on
fixture files and its clock the test's. Each scenario builds a world of its own (fakes.World): a scratch HOME with a
repo or two, each holding an agent repo whose tickets were committed by sessions (a `Session:` trailer). Which
sessions run is what the HOME's session registry (`.claude/sessions/`) says; this process stands in for each. No
session here runs in a tmux pane: what the hub does in tmux, and what only its server does, is server.test's.
"""

import hashlib
import json
import re
import os
import shutil
import subprocess
import sys
import urllib.parse
from concurrent.futures import ThreadPoolExecutor
from datetime import UTC, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import fakes  # noqa: E402  (the hub's module in this process, its clock, and the world it reads)
from check import BIN, check, finish, skipped  # noqa: E402
from fakes import SELF_STARTED, page, served, ticket  # noqa: E402

ORCHESTRATOR = "aaaaaaaa-0000-4000-8000-000000000001"
WORKER = "bbbbbbbb-0000-4000-8000-000000000002"
STRANGER = "cccccccc-0000-4000-8000-000000000003"
SPIKER = "dddddddd-0000-4000-8000-000000000004"
NOVICE = "eeeeeeee-0000-4000-8000-000000000005"  # commits on nothing
RETIRER = "ffffffff-0000-4000-8000-000000000006"
ANSWERER = "abababab-0000-4000-8000-000000000007"  # drops a file into its box
LATECOMER = "cdcdcdcd-0000-4000-8000-000000000008"  # renders its session page late
ASKER = "efefefef-0000-4000-8000-000000000009"  # writes turn records with questions, and chat turns

TREE = [("map-columns", None, ORCHESTRATOR), ("csv-import", "map-columns", ORCHESTRATOR)]
"""alpha's tickets: csv-import under map-columns, both committed by the orchestrator."""

hub_said = (fakes.RUN / "module.log").open("w")
sys.stderr = hub_said  # what the hub prints on the way, as its log would hold it; check() prints to stdout
try:
    # --- where a page lands

    w = fakes.World()
    alpha, beta = w.repo("alpha", TREE), w.repo("beta", [("map-columns", None, STRANGER)])
    a = w.opened(page(alpha / "agent/show/csv-import/index.html"), WORKER)
    check("a page goes to the unit of the session that opened it, whatever ticket its path names", WORKER, a["unit"])
    check("...which has the tree of that ticket beside it, its repo, and no board while the repo has none", ("map-columns", "alpha", None),
          tuple(w.view(a["unit"])[k] for k in ("tree", "repo", "board")))
    b = w.opened(page(beta / "agent/show/map-columns/index.html"), WORKER)
    check("a session's pages in two repos are one unit", (WORKER, 2), (b["unit"], len(w.view(WORKER)["members"])))
    check("the first open of a page adds it", "added", a["action"])
    w.hub.mark("close", {"unit": a["unit"], "id": a["id"]})
    check("a closed page stays a member, closed", True, w.member_of(a)["closed"])
    again = w.opened(alpha / "agent/show/csv-import/index.html", WORKER)
    check("a second open of the same page brings the same member forward", ("reopened", a["id"]), (again["action"], again["id"]))
    check("...open again", False, w.member_of(a)["closed"])
    check("...and adds no second copy", 2, len(w.view(a["unit"])["members"]))
    by_stranger = w.opened(alpha / "agent/show/csv-import/index.html", STRANGER)
    check("the same page opened by another session is a member of that session's unit too", (STRANGER, a["id"], 2),
          (by_stranger["unit"], by_stranger["id"], len(w.view(WORKER)["members"])))
    check("a page named relative to the opener's directory lands as its absolute path does", a["id"],
          w.opened("agent/show/csv-import/index.html", WORKER, cwd=str(alpha)).get("id"))
    ticket_file = w.opened(alpha / "agent/tickets/csv-import.md", WORKER)
    check("a ticket file lands in the opener's unit, as a page of that ticket", (WORKER, "csv-import"),
          (ticket_file["unit"], w.member_of(ticket_file)["ticket"]))
    payload = w.opened(page(alpha / "agent/show/csv-import/broken.html", "<script>const DATA = {not json</script>"), WORKER)
    check("a page that looks like a diffview but carries no data opens like any other", WORKER, payload.get("unit"))
    check("a page that carries DATA naming sources without files opens like any other", WORKER,
          w.opened(page(alpha / "agent/show/csv-import/sourced.html", '<script>const DATA = {"sources": [{"kind": "git"}]}</script>'),
                   WORKER).get("unit"))
    check("so does a directory named like a page", WORKER,
          w.opened(page(alpha / "agent/show/csv-import/deck.html/index.html").parent, WORKER).get("unit"))

    # --- a page under no ticket, and what titles a unit

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    agent = alpha / "agent"
    note = page(w.home / "notes" / "scratch.html")
    by_trailer = w.opened(note, ORCHESTRATOR, cwd=str(alpha))
    check("a page under no ticket goes to its session's unit", ORCHESTRATOR, by_trailer["unit"])
    check("...as a page of the ticket the session committed on last", "csv-import", w.member_of(by_trailer)["ticket"])
    check("...whose tree is beside the unit's title", "map-columns", w.view(ORCHESTRATOR)["tree"])
    w.committed(agent, "drop-zone", ORCHESTRATOR)
    later = w.opened(page(w.home / "notes" / "later.html"), ORCHESTRATOR, cwd=str(alpha))
    check("a session that commits on another tree has that tree beside it, and its later pages that ticket",
          (ORCHESTRATOR, "drop-zone", "drop-zone"), (later["unit"], w.view(ORCHESTRATOR)["tree"], w.member_of(later)["ticket"]))
    novice = w.opened(note, NOVICE, cwd=str(alpha))
    check("a session with no commits, whose pages name no ticket, has a unit with no tree", (NOVICE, None),
          (novice["unit"], w.view(NOVICE)["tree"]))
    check("...titled by its session's id, cut short, with no session page and no registry entry, which is its short id too",
          (f"session {NOVICE[:8]}", NOVICE[:8]), tuple(w.view(NOVICE)[k] for k in ("title", "short")))
    w.registered(NOVICE, name="novice-name")
    check("...and by its name in the registry once there is one, as its short id is", ("novice-name", "novice-name"),
          tuple(w.view(NOVICE)[k] for k in ("title", "short")))
    # hub-session-search: a transcript's title lines as Claude Code 2.1.289 writes them
    transcript = w.home / ".claude" / "projects" / "-home-repos-alpha" / f"{NOVICE}.jsonl"
    title_line = lambda kind, text: json.dumps({"type": f"{kind}-title", f"{kind}Title": text, "sessionId": NOVICE},
                                               separators=(",", ":")) + "\n"
    page(transcript, title_line("ai", "Instagram saves") + '{"type":"user","message":{"content":"x"}}\n'
         + title_line("ai", "Instagram saves pass 1"))
    check("...and by Claude Code's own title for it, its last, over its name in the registry, which stays its short id",
          ("Instagram saves pass 1", "novice-name"), tuple(w.view(NOVICE)[k] for k in ("title", "short")))
    with transcript.open("a") as f:
        f.write(title_line("custom", "saves") + title_line("ai", "Instagram saves pass 2") + '{"type":"custom-title","custo')
    check("...the user's title from /rename over the AI's, whichever came last, and a line still being written not yet",
          "saves", w.view(NOVICE)["title"])
    with transcript.open("a") as f:
        f.write(title_line("custom", "saves again")[len('{"type":"custom-title","custo'):])
    check("...which counts once it is whole", "saves again", w.view(NOVICE)["title"])
    # hub-background-commands: a background command's launch and its end's notification, as Claude Code 2.1.296
    # writes them: the end as a prompt of its own, or queued into a turn under way
    compact = lambda entry: json.dumps(entry, separators=(",", ":")) + "\n"
    launch = lambda call, what, command, at: compact({"type": "assistant", "timestamp": at, "message": {"role": "assistant", "content": [
        {"type": "tool_use", "id": call, "name": "Bash",
         "input": {"command": command, "description": what, "run_in_background": True}}]}})
    notice = lambda call: f"<task-notification>\n<task-id>b1</task-id>\n<tool-use-id>{call}</tool-use-id>\n<status>completed</status>\n</task-notification>"
    with transcript.open("a") as f:  # launched out of the order they started in, as no transcript is, to sort
        f.write(launch("toolu_watch", "Render and watch the review page", "diffview a..b --watch --open", "2026-10-12T13:27:00.000Z")
                + launch("toolu_wait", "Wait for the Backend worker", "dispatch wait backend", "2026-10-12T13:25:00.000Z")
                + launch("toolu_suite", "Run the test suite", "make test", "2026-10-12T13:26:00.000Z")
                + launch("toolu_done", "Wait for the docs worker", "dispatch wait docs", "2026-10-12T13:28:00.000Z")
                + launch("toolu_gone", "Wait for a worker before a restart", "dispatch wait old", "2026-10-12T10:00:00.000Z"))
    check("a session the registry has idle runs nothing in the background, whatever its transcript started",
          [], w.view(NOVICE)["background"])
    started_at = int(datetime.fromisoformat("2026-10-12T12:00:00+00:00").timestamp() * 1000)
    w.registered(NOVICE, "shell", name="novice-name", started_at=started_at)
    check("one the registry says runs a shell runs each command its running process started in the background, oldest "
          "first, a command with --watch a watcher; one started before the process, by one that exited, does not",
          [("Wait for the Backend worker", False), ("Run the test suite", False), ("Render and watch the review page", True),
           ("Wait for the docs worker", False)], [(r["what"], r["watcher"]) for r in w.view(NOVICE)["background"]])
    with transcript.open("a") as f:  # each command's end, read after its launch was, as a turn writes them
        f.write(compact({"type": "user", "toolUseResult": {"stdout": notice("toolu_wait")},
                         "message": {"role": "user", "content": [{"type": "tool_result", "content": notice("toolu_wait")}]}})
                + compact({"type": "user", "origin": {"kind": "task-notification"}, "message": {"role": "user", "content": notice("toolu_done")}})
                + compact({"type": "attachment", "attachment": {"type": "queued_command", "prompt": notice("toolu_suite")}}))
    check("...until a notification names it, as a prompt of its own or queued into a turn, read after the launch; a "
          "command's output quoting a notification ends nothing",
          [("Wait for the Backend worker", "dispatch wait backend"), ("Render and watch the review page", "diffview a..b --watch --open")],
          [(r["what"], r["command"]) for r in w.view(NOVICE)["background"]])
    check("...and is idle, its launch's time kept", ("idle", datetime.fromisoformat("2026-10-12T13:25:00+00:00").timestamp()),
          (w.view(NOVICE)["state"], w.view(NOVICE)["background"][0]["at"]))
    w.registered(NOVICE, name="novice-name")
    kept = w.home / ".claude" / "session-pages" / ORCHESTRATOR  # where the mx plugin keeps a running session's page
    page(kept / "agent-repo", f"{alpha / 'agent'}\n")
    session_page = w.opened(page(kept / "index.html"), ORCHESTRATOR)
    check("a session page goes to its session's unit, under no ticket", (ORCHESTRATOR, None, "session"),
          (session_page["unit"], w.member_of(session_page)["ticket"], w.member_of(session_page)["kind"]))
    check("...and the unit to the tracker of the agent repo its directory names, with the tickets its session committed on",
          (str(alpha / "agent" / "tickets"), True),
          (w.member_of(session_page)["tracker"], {"map-columns", "csv-import"} <= {t["slug"] for t in w.view(ORCHESTRATOR)["tickets"]}))
    worker_page = w.opened(page(w.home / ".claude-other" / "session-pages" / WORKER / "index.html"))
    check("a session page lands in its own session's unit, whoever opens it, under any account", WORKER, worker_page["unit"])
    page(w.home / ".claude-other" / "session-pages" / WORKER / "session.md", "---\nsession: x\n---\n\n# Import the CSV files\n\n## Brief\n")
    w.registered(WORKER, name="worker-name")
    check("a unit is titled by its session page's heading, over its name in the registry", "Import the CSV files",
          w.view(WORKER)["title"])
    check("...and says how to resume that session", f"claude --resume {WORKER}", w.view(WORKER)["resume"])
    earlier = w.opened(page(alpha / f"agent/sessions/{STRANGER}/index.html"))
    page(alpha / f"agent/sessions/{STRANGER}/session.md", "---\nsession: x\n---\n\n# Map the columns\n")
    check("a session page an older mx wrote in the agent repo still heads its session's unit, and titles it",
          (STRANGER, "Map the columns"), (earlier["unit"], w.view(STRANGER)["title"]))
    moved = w.home / ".claude" / "session-pages" / STRANGER
    page(moved / "session.md", "---\nsession: x\n---\n\n# Map the columns, carried on\n")
    page(moved / "agent-repo", f"{alpha / 'agent'}\n")
    page(moved / "index.html")
    check("...until the session renders one under its account, which the unit reads over the agent repo's",
          ("Map the columns, carried on", served(moved / "index.html")),
          (w.view(STRANGER)["title"], w.view(STRANGER)["session_page"]["url"]))
    elsewhere = w.scratch / "accounts" / "linked"  # an account whose directory under HOME is a link to it
    (w.home / ".claude-linked").symlink_to(elsewhere, target_is_directory=True)
    page(elsewhere / "session-pages" / SPIKER / "index.html")
    page(elsewhere / "session-pages" / SPIKER / "agent-repo", f"{alpha / 'agent'}\n")
    record = page(elsewhere / "session-pages" / SPIKER / "session.md", "---\nsession: x\n---\n\n# Spike\n")
    check("/f/ serves what a session page under an account that is a link is rendered from, opened or not", True,
          w.hub.servable(record))
    opened_linked = w.opened(w.home / ".claude-linked" / "session-pages" / SPIKER / "index.html")
    check("...and the page heads its own session's unit, whoever opens it", (SPIKER, "session"),
          (opened_linked["unit"], w.member_of(opened_linked)["kind"]))

    # --- one-hub-tab#P2: a unit's session page lists every page of the unit, a minimized one included

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    shown_path = page(alpha / "agent/show/csv-import/index.html")
    w.opened(shown_path, STRANGER)
    # The session page's artefact column as the mx renderer writes it: each link carries the absolute path of the file
    # it opens, or the URL as written. A link elsewhere on the page (a turn's chip) repeats one of the column's.
    figure_path = page(alpha / "agent/show/csv-import/flow.svg", '<svg xmlns="http://www.w3.org/2000/svg"/>')
    page(alpha / f"agent/sessions/{STRANGER}/index.html", f"""<!doctype html><main>
      <details class="turn"><summary>turn 2 <span class="chip"><a href="#" data-artefact="{shown_path}">csv</a></span></summary></details>
      <aside class="column" id="artefacts"><section class="group" id="a02"><ol>
        <li><kbd class="n">1</kbd><a class="artefact" href="#" data-artefact="{figure_path}">flow</a></li>
        <li><kbd class="n">2</kbd><a class="artefact" href="#" data-artefact="{shown_path}">csv</a></li>
      </ol></section><section class="group" id="a01"><ol>
        <li><kbd class="n">1</kbd><a class="artefact" href="#" data-artefact="{figure_path}">flow again</a></li>
        <li><kbd class="n">2</kbd><a class="artefact" href="#" data-artefact="https://example.invalid/app?x=1&amp;y=2">app</a></li>
      </ol></section></aside></main>""")
    w.opened(alpha / f"agent/sessions/{STRANGER}/index.html", STRANGER)  # a member, which the list it is leaves off
    stray =w.opened(page(w.home / "notes" / "stray.html"), STRANGER)
    w.hub.mark("close", {"unit": STRANGER, "id": stray["id"]})
    w.clock.tick()
    aside = w.opened(page(w.home / "notes" / "aside.html"), STRANGER)  # opened after stray, though named before it
    listed = w.view(STRANGER)["pages"]
    check("a unit's pages are its session page's column links in its order, once each, then the pages no turn links, as opened",
          [(served(figure_path), True), (served(shown_path), True), ("https://example.invalid/app?x=1&y=2", True),
           (served(w.home / "notes" / "stray.html"), False), (served(w.home / "notes" / "aside.html"), False)],
          [(x["url"], x["linked"]) for x in listed])
    check("...each named as the column names it, a page no turn links by its path", [str(figure_path), str(shown_path),
          "https://example.invalid/app?x=1&y=2", str(w.home / "notes" / "stray.html"), str(w.home / "notes" / "aside.html")],
          [x["artefact"] for x in listed])
    check("...every member listed, the minimized one too, and the session page, the list itself, not on it", (True, False),
          ({m["url"] for m in w.view(STRANGER)["members"] if m["kind"] != "session"} <= {x["url"] for x in listed},
           any(x["kind"] == "session" for x in listed)))
    check("...the id of each the id it has as a member", [stray["id"], aside["id"]], [x["id"] for x in listed[-2:]])

    # --- the board: the rail's, opened over the hub tab, never a page of a unit

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    agent = alpha / "agent"
    shown_path = page(alpha / "agent/show/csv-import/index.html")
    w.opened(shown_path, WORKER)
    w.opened(shown_path, STRANGER)
    w.committed(agent, "drop-zone", ORCHESTRATOR)
    w.opened(page(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html"), ORCHESTRATOR)
    board = page(agent / "board.html", "<!doctype html><h1>board</h1>")
    board_url = served(board)
    before = {u["unit"]: [m["id"] for m in u["members"]] for u in w.rail()}
    handed = w.opened(board, ORCHESTRATOR)
    check("a board handed to the hub opens over the hub tab, joining no unit", (board_url, None, before),
          (handed.get("board"), handed.get("unit"), {u["unit"]: [m["id"] for m in u["members"]] for u in w.rail()}))
    check("...as does a link to one clicked in a page of the hub tab", (board_url, None),
          (lambda r: (r.get("board"), r.get("unit")))(w.clicked(board_url, STRANGER)))
    page(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html", f"""<!doctype html><aside class="column" id="artefacts"><ol>
      <li><a class="artefact" href="#" data-artefact="{board}">board</a></li>
      <li><a class="artefact" href="#" data-artefact="{shown_path}">csv</a></li></ol></aside>""")
    check("...and a session page's column linking it lists it as none of the unit's pages", [served(shown_path)],
          [p["url"] for p in w.view(ORCHESTRATOR)["pages"] if p["linked"]])
    check("a unit's board is its tree's, marking the tickets its session claimed or committed on",
          (board_url, {"map-columns", "csv-import", "drop-zone"}),
          (w.view(ORCHESTRATOR)["board"], set(w.view(ORCHESTRATOR)["worked_on"])))
    ticket(agent, "drop-zone", "done")
    check("...but none that is done, which is worked on no more", {"map-columns", "csv-import"}, set(w.view(ORCHESTRATOR)["worked_on"]))
    ticket(agent, "drop-zone")
    check("...and none of a session that committed on none there, whatever tickets its pages name", (board_url, []),
          (w.view(WORKER)["board"], w.view(WORKER)["worked_on"]))

    # --- what never opens, and a page's lane, from what it is

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    agent = alpha / "agent"
    w.committed(agent, "drop-zone", ORCHESTRATOR)
    a = w.opened(page(alpha / "agent/show/csv-import/index.html"), WORKER)
    note = page(w.home / "notes" / "scratch.html")
    by_trailer = w.opened(note, ORCHESTRATOR, cwd=str(alpha))
    session_page = w.opened(page(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html"), ORCHESTRATOR)
    payload = w.opened(page(alpha / "agent/show/csv-import/broken.html", "<script>const DATA = {not json</script>"), WORKER)
    report = page(alpha / "agent/show/drop-zone/report.md", "## Comments\n")
    page(alpha / "agent/show/drop-zone/notes.md", "# notes\n")
    page(alpha / "agent/show/drop-zone/figures/plot.svg", '<svg xmlns="http://www.w3.org/2000/svg"/>')
    skipped_open = w.opened(report, WORKER)
    check("a worker's report never opens", (True, None), ("skipped" in skipped_open, skipped_open["open"]))
    check("...and the line the hub has its caller print says why", True, "not opened" in skipped_open["say"] and "report" in skipped_open["say"])
    w.git(agent, "commit", "-q", "--allow-empty", "-m", "base")
    ticket(agent, "csv-import", "review", "map-columns")
    w.git(agent, "commit", "-q", "-am", "csv-import in review", "-m", f"Session: {ORCHESTRATOR}")
    tracker_diff = agent / "diffviews" / "tracker.html"
    tracker_diff.parent.mkdir(parents=True, exist_ok=True)
    ticket(agent, "csv-import", "claimed", "map-columns")
    page(agent / "show/csv-import/plan.md", "# plan\n")
    w.git(agent, "add", "tickets/csv-import.md", "show/csv-import/plan.md")
    w.git(agent, "commit", "-q", "-m", "csv-import back, with a plan")
    mixed_diff = agent / "diffviews" / "mixed.html"
    (alpha / "notes.txt").write_text("one\n")
    w.git(alpha, "add", "notes.txt")
    w.git(alpha, "commit", "-q", "-m", "notes")
    code_diff = agent / "diffviews" / "csv-import.html"
    renders = [[f"{agent}@HEAD~2..HEAD~1", tracker_diff], [f"{agent}@HEAD~1..HEAD", mixed_diff], [f"{alpha}@HEAD~1..HEAD", code_diff]]
    with ThreadPoolExecutor() as pool:  # diffview, as the agents run it
        list(pool.map(lambda r: subprocess.run([BIN / "diffview", r[0], "-o", str(r[1]), "--no-auto-summary"], env=w.env,
                                               check=True, capture_output=True), renders))
    check("a diffview of tracker files never opens", True, "skipped" in w.opened(tracker_diff, ORCHESTRATOR))
    check("a report beside a prototype is no worker's report, and opens", True,
          "unit" in w.opened(page(alpha / "agent/prototypes/csv-import/report.md", "# what the prototype showed\n"), WORKER))
    check("a diffview of a ticket and a show file opens", ORCHESTRATOR, w.opened(mixed_diff, ORCHESTRATOR).get("unit"))
    code_opened = w.opened(code_diff, ORCHESTRATOR)
    check("a diffview of code opens", ORCHESTRATOR, code_opened.get("unit"))

    lane_of = lambda path: w.member_of(w.opened(path, ORCHESTRATOR))["lane"]
    check("a session page goes to the session lane, a diffview page to code", ("session", "code"),
          (w.member_of(session_page)["lane"], w.member_of(code_opened)["lane"]))
    check("an image goes to concept, as does any other page of a show directory", ("concept", "concept", "concept"),
          (lane_of(alpha / "agent/show/drop-zone/figures/plot.svg"), lane_of(alpha / "agent/show/drop-zone/notes.md"), w.member_of(a)["lane"]))
    check("a page in no show directory goes to output, a prototype's too", ("output", "output"),
          (w.member_of(by_trailer)["lane"],
           w.member_of(w.opened(page(agent / "prototypes/csv-import/index.html"), ORCHESTRATOR))["lane"]))
    elsewhere_diff = w.opened(shutil.copy(code_diff, w.home / "notes" / "review.html"), ORCHESTRATOR)
    check("a diffview page goes to code wherever it was written", "code", w.member_of(elsewhere_diff)["lane"])
    check("...though a page that only looks like one does not", "concept", w.member_of(payload)["lane"])
    check("an image outside any show directory goes to concept", "concept",
          w.member_of(w.opened(page(w.home / "notes" / "sketch.png", "png"), ORCHESTRATOR))["lane"])
    overridden = w.opened(note, ORCHESTRATOR, lane="concept")
    check("an agent's lane overrides the one a page's kind gives it", "concept", w.member_of(overridden)["lane"])
    check("...and the line the caller prints names it", True, overridden["say"].endswith(", lane concept"))
    w.opened(note, ORCHESTRATOR)
    check("...and holds when the page is opened again without one", "concept", w.member_of(overridden)["lane"])
    check("...the unit's pages listing it in that lane", "concept",
          next(x["lane"] for x in w.view(ORCHESTRATOR)["pages"] if x["id"] == overridden["id"]))
    w.opened(note, ORCHESTRATOR, lane="output")
    check("...until an agent names another", "output", w.member_of(overridden)["lane"])
    check("a lane there is none of is refused, naming the lanes", (400, True),
          (lambda r: (r[0], "session, concept, output, code" in r[1].get("error", "")))(
              w.hub.open_page({"target": str(note), "session": ORCHESTRATOR, "lane": "diff"}, w.origins, from_page=False)))

    # --- a unit's tree, and a member as it was opened

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    agent = alpha / "agent"
    note = page(w.home / "notes" / "scratch.html")
    by_trailer = w.opened(note, ORCHESTRATOR, cwd=str(alpha))
    check("a unit's tree is the tree of the ticket its session committed on last", "map-columns", w.view(ORCHESTRATOR)["tree"])
    scratch_member = w.member_of(by_trailer)
    check("a member no turn links is in its unit's pages as it was opened", [{
        "url": scratch_member["url"], "id": scratch_member["id"], "artefact": str(note.resolve()), "linked": False, "ticket": "csv-import",
        "kind": "page", "title": "scratch.html", "lane": "output"}], [x for x in w.view(ORCHESTRATOR)["pages"] if x["id"] == by_trailer["id"]])
    ticket(agent, "spike", "open", "map-columns")
    spike = w.opened(page(agent / "show/spike/index.html"), SPIKER)
    (agent / "tickets/spike.md").unlink()
    spiker = w.view(spike["unit"])
    check("a unit whose ticket left the tracker before it was ever read has no tree, is never visited, the ticket marked gone",
          (None, 0, [{"slug": "spike", "status": "gone", "title": "spike", "diff": []}]),
          (spiker.get("tree"), spiker.get("visited"), spiker.get("tickets")))

    # --- the tracker drives the hub tab

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    agent = alpha / "agent"
    w.opened(page(w.home / "notes" / "scratch.html"), ORCHESTRATOR, cwd=str(alpha))
    ticket(agent, "csv-import", "done", "map-columns")
    status = lambda: next(t["status"] for t in w.view(ORCHESTRATOR)["tickets"] if t["slug"] == "csv-import")
    check("a ticket's status in the tracker is the hub tab's", "done", status())
    page(agent / "show/csv-import/plan.md", "# plan\n")
    w.git(agent, "add", "show/csv-import/plan.md")
    w.git(agent, "commit", "-q", "-m", "a plan")
    (alpha / "notes.txt").write_text("one\n")
    w.git(alpha, "add", "notes.txt")
    w.git(alpha, "commit", "-q", "-m", "notes")
    last_two = lambda repo: subprocess.run(["git", "log", "--reverse", "--format=%h", "-2"], cwd=repo, capture_output=True,
                                           text=True, check=True).stdout.split()
    commits = last_two(alpha)  # the code repo's last commit adds notes.txt
    agent_range = "..".join(last_two(agent))  # the agent repo's last commit adds show/csv-import/plan.md
    recorded_diff = lambda slug, *ranges: page(agent / f"tickets/{slug}.md", fakes.ticket_text(slug).replace(
        "size: S\n", "size: S\ndiff:\n" + "".join(f"  - {r}\n" for r in ranges)))
    recorded_diff("map-columns", f"code@{commits[0]}..{commits[1]}", f"agent@{agent_range}")
    # what the hub cached before it left agent ranges out: one page of both ranges, keyed by both
    old_specs = f"{alpha}@{commits[0]}..{commits[1]} {agent}@{agent_range}"
    page(w.hub.STATE / "diffs" / f"map-columns-{hashlib.sha1(old_specs.encode()).hexdigest()[:8]}.html", "stale render")
    tickets_root = (agent / "tickets").resolve()
    recorded = {"url": "/diff?" + urllib.parse.urlencode({"tracker": str(tickets_root), "ticket": "map-columns"}),
                "title": f"diff · code@{commits[0]}..{commits[1]}"}
    render, status_code, _ = w.hub.render_diff(tickets_root, "map-columns")
    rendered = render.read_bytes() if render else b""
    check("a ticket's recorded code range renders when opened", (200, True), (status_code, b"notes.txt" in rendered))
    check("...without its agent range, and never from a render cached with it", (False, False),
          (b"plan.md" in rendered, b"stale render" in rendered))
    from_view = w.clicked(recorded["url"], ORCHESTRATOR, title=recorded["title"])
    check("a recorded range clicked in the hub tab becomes a member of its unit, of its ticket", (ORCHESTRATOR, "diff", "map-columns"),
          (from_view["unit"], w.member_of(from_view)["kind"], w.member_of(from_view)["ticket"]))
    check("...under the title the hub tab gave it, opened by the user", (recorded["title"], "user"),
          (w.member_of(from_view)["title"], w.member_of(from_view)["by"]))
    ticket(agent, "drop-zone")
    check("a ticket with no range recorded has no diff to render", 404, w.hub.render_diff(tickets_root, "drop-zone")[1])
    recorded_diff("drop-zone", f"agent@{agent_range}")
    check("a ticket recording only agent ranges has no diff to render", 404, w.hub.render_diff(tickets_root, "drop-zone")[1])
    recorded_diff("map-columns", f"code@{commits[0]}..0123abc", f"agent@{agent_range}")
    _, status_code, said = w.hub.render_diff(tickets_root, "map-columns")
    check("a recorded range diffview cannot render answers why, not that none is recorded", (502, True),
          (status_code, "0123abc" in said))

    # --- the rail: the units whose sessions run, numbered by when each last finished a turn

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    for session in (ORCHESTRATOR, WORKER, SPIKER, STRANGER, NOVICE):
        w.opened(page(w.home / "notes" / f"{session[:8]}.html"), session)
    t0 = w.clock.tick(100)
    for session, at in ((ORCHESTRATOR, t0 - 100), (WORKER, t0 - 10)):
        w.opened(session_page := page(alpha / f"agent/sessions/{session}/index.html"), session)
        os.utime(session_page, (at, at))
    w.registered(ORCHESTRATOR, "idle", t0 - 50)
    w.registered(WORKER, "busy", t0 - 5)
    w.registered(SPIKER, "idle", t0 - 200)
    ours = lambda: [(u["unit"], u["number"] is not None) for u in w.rail() if u["unit"] in (ORCHESTRATOR, WORKER, SPIKER)]
    check("the rail numbers the idle sessions by their last turn's end, the latest first, and the busy after them",
          [(ORCHESTRATOR, True), (SPIKER, True), (WORKER, True)], ours())
    check("...a turn's end read off the session page's render where the registry has none", t0 - 10, w.view(WORKER)["last"])
    w.registered(SPIKER, "shell", t0 - 1)
    check("a session whose turn ended with a shell left running in the background is numbered with the idle, by that turn's end",
          [(SPIKER, True), (ORCHESTRATOR, True), (WORKER, True)], ours())
    check("...and is idle, waiting on that run as on a worker", ("idle", t0 - 1), (w.view(SPIKER)["state"], w.view(SPIKER)["last"]))
    # a turn's model calls and its end, as Claude Code 2.1.302 writes them; it keeps the registry `busy` while an
    # agent the session started in the background runs, its turn over or not
    line = lambda entry: json.dumps(entry, separators=(",", ":")) + "\n"
    iso = lambda at: datetime.fromtimestamp(at, UTC).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
    called = lambda at: line({"type": "api-request", "sessionId": WORKER, "id": "r", "timestamp": iso(at), "querySource": "repl_main_thread"})
    turn_end = lambda at: line({"parentUuid": "p", "isSidechain": False, "type": "system", "subtype": "turn_duration",
                                       "durationMs": 1000, "timestamp": iso(at)})
    launched = line({"type": "user", "timestamp": iso(t0 - 8), "toolUseResult": {"isAsync": True, "status": "async_launched",
                                                                               "agentId": "a1", "description": "Build the landing show"},
                     "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_agent", "content": "launched"}]}})
    resumed = lambda at: line({"type": "user", "timestamp": iso(at), "toolUseResult": {"success": True, "resumedAgentId": "a1"},
                               "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": "toolu_send", "content": "resuming"}]}})
    agent_done = line({"type": "user", "timestamp": iso(t0 - 1), "origin": {"kind": "task-notification"}, "message": {"role": "user", "content":
                       "<task-notification>\n<task-id>a1</task-id>\n<tool-use-id>toolu_agent</tool-use-id>\n<status>completed</status>\n</task-notification>"}})
    worker_transcript = page(w.home / ".claude" / "projects" / "-home-repos-alpha" / f"{WORKER}.jsonl",
                             line({"type": "user", "timestamp": iso(t0 - 9), "message": {"role": "user", "content": "go"}}) + called(t0 - 9)
                             + launched + called(t0 - 8))
    check("a busy session whose transcript shows a turn under way is busy, the agent that turn started in the background shown",
          ("busy", t0 - 10, ["Build the landing show"]),
          (w.view(WORKER)["state"], w.view(WORKER)["last"], [r["what"] for r in w.view(WORKER)["background"]]))
    with worker_transcript.open("a") as f:
        f.write(line({"type": "user", "toolUseResult": {"stdout": turn_end(t0 - 4)},
                      "message": {"role": "user", "content": [{"type": "tool_result", "content": turn_end(t0 - 4)}]}}) + called(t0 - 4))
    check("...a command's output quoting a turn's end ending nothing", "busy", w.view(WORKER)["state"])
    with worker_transcript.open("a") as f:
        f.write(turn_end(t0 - 3))
    check("one whose turn ended, an agent it started still running in the background, is idle, by that turn's end",
          ("idle", t0 - 3), (w.view(WORKER)["state"], w.view(WORKER)["last"]))
    check("...numbered with the idle", [(SPIKER, True), (WORKER, True), (ORCHESTRATOR, True)], ours())
    check("...waiting on the agent as on a run", [("Build the landing show", "agent", t0 - 8, False)],
          [(r["what"], r["command"], r["at"], r["watcher"]) for r in w.view(WORKER)["background"]])
    with worker_transcript.open("a") as f:
        f.write(line({"type": "user", "timestamp": iso(t0 - 2), "message": {"role": "user", "content": "<command-name>/reload-plugins</command-name>"}})
                + line({"type": "system", "subtype": "local_command", "timestamp": iso(t0 - 2), "content": "<local-command-stdout>Reloaded</local-command-stdout>"}))
    check("...and stays idle through a local command, which calls no model", "idle", w.view(WORKER)["state"])
    with worker_transcript.open("a") as f:
        f.write(agent_done + called(t0 - 1))
    check("...until its next turn calls the model, the agent's end notified", ("busy", []), (w.view(WORKER)["state"], w.view(WORKER)["background"]))
    with worker_transcript.open("a") as f:
        f.write(resumed(t0) + turn_end(t0))
    check("an agent resumed by a message runs in the background again, under the description it was launched with",
          ("idle", [("Build the landing show", t0)]), (w.view(WORKER)["state"], [(r["what"], r["at"]) for r in w.view(WORKER)["background"]]))
    w.hub.transcripts_read.clear()  # the hub restarted: what it read and built goes, and the transcript is read whole
    w.hub.KEPT.clear()
    check("...read the same from the whole transcript at once, its earlier end before the resume", [("Build the landing show", t0)],
          [(r["what"], r["at"]) for r in w.view(WORKER)["background"]])
    with worker_transcript.open("a") as f:
        f.write(agent_done.replace(iso(t0 - 1), iso(t0)) + called(t0))
    check("...until notified again", ("busy", []), (w.view(WORKER)["state"], w.view(WORKER)["background"]))
    w.registered(SPIKER, "waiting", t0 - 1000, waiting_for="permission prompt")
    check("a session blocked in its terminal is numbered first, however long ago its turn ended",
          [(SPIKER, True), (ORCHESTRATOR, True), (WORKER, True)], ours())
    w.registered(SPIKER, "idle", t0 - 200)
    w.registered(WORKER, "idle", t0)
    check("a session that finishes a turn is the first of them", [(WORKER, True), (ORCHESTRATOR, True), (SPIKER, True)], ours())
    check("...and 1 on the rail", 1, w.number(WORKER))
    check("a session no running process registers is ended: no number, after every numbered unit", ("ended", None, True),
          (lambda us: (next(u["state"] for u in us if u["unit"] == STRANGER), next(u["number"] for u in us if u["unit"] == STRANGER),
                       all(u["number"] for u in us[:[x["unit"] for x in us].index(STRANGER)])))(w.rail()))
    w.ended(STRANGER)
    w.registered(NOVICE, started=str(int(SELF_STARTED) + 1))
    check("...as is one whose registry file names a process that has exited, or a pid another process has taken since",
          ("ended", "ended"), (w.view(STRANGER)["state"], w.view(NOVICE)["state"]))
    w.registered(STRANGER, "idle", t0 + 1)
    check("a session resumed gets a number again", (True, "idle"), (w.number(STRANGER) is not None, w.view(STRANGER)["state"]))
    w.clock.tick()
    check("the ✕ takes a unit out of the numbers", (200, None, True),
          (w.hub.mark("dismiss", {"unit": ORCHESTRATOR})[0], w.number(ORCHESTRATOR), w.view(ORCHESTRATOR)["dismissed"]))
    check("...listed after the numbered ones", True,
          (lambda us: all(u["number"] for u in us[:[x["unit"] for x in us].index(ORCHESTRATOR)]))(w.rail()))
    w.opened(page(w.home / "notes" / "while-dismissed.html"), ORCHESTRATOR)
    check("...while an agent opening a page there does not bring it back", None, w.number(ORCHESTRATOR))
    w.registered(ORCHESTRATOR, "idle", w.clock.tick())
    check("...and its session finishing a turn does, as 1", (1, False), (w.number(ORCHESTRATOR), w.view(ORCHESTRATOR)["dismissed"]))
    check("a dismissal is refused for a unit that does not exist", 404, w.hub.mark("dismiss", {"unit": "no-such-unit"})[0])

    # --- hub-ui-nits 2: the statusline's numbers, from what the statusline keeps of each session's last render

    w = fakes.World()
    for session in (ORCHESTRATOR, WORKER, SPIKER, STRANGER, NOVICE):
        w.opened(page(w.home / "notes" / f"{session[:8]}.html"), session)
    t0 = w.clock.now
    for session in (ORCHESTRATOR, WORKER, SPIKER):
        w.registered(session, "idle", t0 - 100)
    check("a session with no statusline file shows no context use, nor any usage", (None, []),
          (w.view(WORKER)["context"], w.hub.hub_view()["usage"]))
    work = w.home / ".claude-work"
    w.statusline(WORKER, t0 - 30, context=(42.5, 85000), five_hour=(30, t0 + 3600), seven_day=(12, t0 + 3 * 86400))
    w.statusline(ORCHESTRATOR, t0 - 10, context=(81, 162000), five_hour=(35, t0 + 3500), seven_day=(13, t0 + 3 * 86400))
    w.statusline(SPIKER, t0 - 20, f"{work}/", context=(5, 9000), five_hour=(70, t0 - 60), seven_day=(40, t0 + 86400))
    w.statusline(NOVICE, t0, context=(90, 180000), five_hour=(99, t0 + 60), seven_day=(99, t0 + 60))
    w.statusline(STRANGER, t0 - 5, w.home / ".claude-pro", context=(20, 40000))
    w.statusline(SPIKER[:-1] + "9", t0 - 40, work, five_hour=(1, t0 + 60))  # the same account, spelled without the slash
    check("a running session shows its context use, as its statusline last had it",
          ({"used_percentage": 42.5, "total_input_tokens": 85000}, {"used_percentage": 81, "total_input_tokens": 162000}),
          (w.view(WORKER)["context"], w.view(ORCHESTRATOR)["context"]))
    check("...an ended one none", None, w.view(NOVICE)["context"])
    check("the 5h and weekly usage, one entry per account, each from its newest statusline file, an ended session's too", [
        {"account": str(w.home / ".claude"), "at": t0, "five_hour": {"used_percentage": 99, "resets_at": t0 + 60},
         "seven_day": {"used_percentage": 99, "resets_at": t0 + 60}},
        {"account": str(w.home / ".claude-pro"), "at": t0 - 5, "five_hour": None, "seven_day": None},
        {"account": str(work), "at": t0 - 20, "five_hour": {"used_percentage": 70, "resets_at": t0 - 60},
         "seven_day": {"used_percentage": 40, "resets_at": t0 + 86400}}], w.hub.hub_view()["usage"])

    # --- hub-layout-pass 5: a unit's account, the config dir its session runs under, which the rail ticks on and off

    w = fakes.World()
    for session in (WORKER, NOVICE):
        w.opened(page(w.home / "notes" / f"{session[:8]}.html"), session)
    w.registered(WORKER)
    work = w.home / ".claude-work"
    novice_transcript = page(w.home / ".claude" / "projects" / "-home-repos-alpha" / f"{NOVICE}.jsonl", "")
    page(w.home / ".claude-pro" / "projects" / "-home-repos-beta" / f"{WORKER}.jsonl", "")
    check("an ended session's account is the one its transcript is under, a running session's the one its registry "
          "file is under, whatever transcript it has", (str(w.home / ".claude"), str(w.home / ".claude")),
          (w.view(NOVICE)["account"], w.view(WORKER)["account"]))
    (work / "projects" / "-home-repos-alpha").mkdir(parents=True)
    novice_transcript.rename(work / "projects" / "-home-repos-alpha" / novice_transcript.name)
    check("...a transcript moved to another account moving it there, as the rail has it", (str(work), str(work)),
          (w.view(NOVICE)["account"], next(u["account"] for u in w.rail() if u["unit"] == NOVICE)))
    (work / "projects" / "-home-repos-alpha" / novice_transcript.name).unlink()
    check("...and one with no transcript left has none", None, w.view(NOVICE)["account"])

    # --- a file pasted or dropped into a unit's box

    w = fakes.World()
    w.opened(page(w.home / "notes" / "answering.html"), ANSWERER)
    screenshot = b"\x89PNG\r\n\x1a\n not really a png"
    status_code, answer = w.hub.drop(ANSWERER, "Screenshot from today.png", screenshot)
    saved = Path(answer.get("path", "/nonexistent"))
    check("a file pasted or dropped into the box is saved where the session can read it, under its own name, typed bare",
          (200, w.home / ".cache/container-hub/drops" / ANSWERER, True, screenshot),
          (status_code, saved.parent, saved.name.endswith("-Screenshot-from-today.png"), saved.read_bytes() if saved.is_file() else None))
    check("...a second of the same name kept beside it", True, w.hub.drop(ANSWERER, "Screenshot from today.png", screenshot)[1].get("path") != str(saved))
    check("...nor for a unit there is none of, whatever its name", (404, 404, False), (
        w.hub.drop("no-such-unit", "x.png", b"x")[0], w.hub.drop("..", "x.png", b"x")[0], any((w.home / ".cache/container-hub").glob("*x.png"))))

    # --- hub-reloads-mx: which sessions the hub types /reload-plugins into, and when an input box is empty

    w = fakes.World()
    plugins = w.home / ".claude" / "plugins"
    installed = lambda version: page(plugins / "installed_plugins.json", json.dumps(
        {"version": 2, "plugins": {"mx@MaxWolf-01": [{"scope": "user", "version": version}]}}))
    loaded = lambda session, version: page(plugins / "data" / "mx-MaxWolf-01" / "sessions" / session, version + "\n")
    due = lambda session: w.hub.reload_due(session, w.hub.registry()[session])
    # the session's process is a child without DISPATCH_WORKLOG: run inside a dispatched worker, this test's own
    # process carries it, and the hub would take the session for a worker
    interactive = subprocess.Popen(["sleep", "60"], env={k: v for k, v in os.environ.items() if k != "DISPATCH_WORKLOG"})
    registered = lambda *args, **kwargs: w.registered(ORCHESTRATOR, *args, pid=interactive.pid,
                                                      started=fakes.started(interactive.pid), **kwargs)
    registered()
    check("a session is due no reload where the account has no mx installed", None, due(ORCHESTRATOR))
    installed("1.0.55")
    check("...one that recorded no version is due the installed one", "1.0.55", due(ORCHESTRATOR))
    loaded(ORCHESTRATOR, "1.0.54")
    check("...as is one that recorded an older one", "1.0.55", due(ORCHESTRATOR))
    installed("1.0.100")
    check("...versions compared as numbers, not as text", "1.0.100", due(ORCHESTRATOR))
    installed("1.0.55")
    loaded(ORCHESTRATOR, "1.0.55")
    check("...and not one that runs it", None, due(ORCHESTRATOR))
    loaded(ORCHESTRATOR, "1.0.54")
    w.hub.RELOADED[ORCHESTRATOR] = "1.0.55"
    check("...nor one the hub already typed the reload into for that version", None, due(ORCHESTRATOR))
    installed("1.0.56")
    check("...until a newer one is installed", "1.0.56", due(ORCHESTRATOR))
    for status in ("busy", "waiting"):
        registered(status)
        check(f"a session {status} is due no reload", None, due(ORCHESTRATOR))
    registered("shell")
    check("...one idle with a background shell is", "1.0.56", due(ORCHESTRATOR))
    registered(kind="sdk-cli")
    check("...one that is no interactive session is not", None, due(ORCHESTRATOR))
    interactive.kill()
    interactive.wait()
    worker = subprocess.Popen(["sleep", "60"], env={**os.environ, "DISPATCH_WORKLOG": "/w/log"})
    try:
        w.registered(WORKER, pid=worker.pid, started=fakes.started(worker.pid))
        check("a dispatched worker is due none, staying on the mx its run started with", None, due(WORKER))
    finally:
        worker.kill()
        worker.wait()
    rule = "─" * 40
    footer = "  b8a010af │ max in scratch with Opus 5.5 (high)\n  ⏵⏵ auto mode on (shift+tab to cycle)\n"
    box = lambda *lines: f"❯ /reload-plugins\n  ⎿  Reloaded: 2 plugins\n\n{rule}\n" + "\n".join(lines) + f"\n{rule}\n{footer}"
    check("an input box holding nothing is empty, as Claude Code 2.1.296 draws it, whatever was typed above it",
          True, w.hub.prompt_empty(box("❯ ")))
    check("...and one holding a draft, a draft of two lines, or no box at all, as a dialog draws, is not",
          [False, False, False], [w.hub.prompt_empty(box("❯ what about")), w.hub.prompt_empty(box("❯ one", "  two")),
                                  w.hub.prompt_empty(" Is this a project you trust?\n\n ❯ No, exit\n   Yes, I trust this folder\n")])
    check("...nor a bare ❯ outside the box's two rules, as a list or a box scrolled away leaves one", False,
          w.hub.prompt_empty(f"{rule}\nsome output\n❯\nmore output\n{rule}\n"))

    # --- links clicked in the hub tab: a path to copy, rather than a page, where /f/ would not serve it

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    a = w.opened(page(alpha / "agent/show/csv-import/index.html"), WORKER)
    note = page(w.home / "notes" / "scratch.html")
    w.opened(note, ORCHESTRATOR, cwd=str(alpha))
    secret = page(w.home / ".ssh" / "id_ed25519", "not a page")
    check("a page in the hub tab opening a file no agent opened, outside every agent directory, gets its path to copy",
          str(secret), w.clicked(secret, a["unit"]).get("copy"))
    check("...and one opening a directory", str(note.parent), w.clicked(note.parent, a["unit"]).get("copy"))
    check("the hub tab hears which links a click copies: a directory and an unserved file, not a page it serves",
          (200, {"copies": [f"file://{note.parent}", str(secret)]}),
          w.hub.copying({"targets": [f"file://{note.parent}", str(secret), w.member_of(a)["url"], str(w.home / "gone")]}, w.origins))

    # --- whether a page on another origin lets the hub tab frame it, read off its frame-ancestors: the tab on the
    # tailnet, as tailscale serve puts it, is an https origin on a port of its own. CSP's own rules, read loosely where
    # an http source would count for an https tab once upgraded.

    tab = "https://pc.example.ts.net:8377"
    framing = {"*": True, "https:": True, "http:": True, "'self'": False, tab: True, "http://pc.example.ts.net:8377": True,
               "pc.example.ts.net:8377": True, "https://pc.example.ts.net:*": True, "https://pc.example.ts.net": False,
               "https://zephyrus.example.ts.net:8377": False, "http://127.0.0.1:8377": False}
    check("a frame-ancestors source admits the hub tab on the tailnet where CSP says it would, a source with no port "
          "naming 443", framing, {source: w.hub.admits_hub(source, tab) for source in framing})
    check("...and an https source never admits the tab on the loopback port", (False, False, True),
          (w.hub.admits_hub("https:", "http://127.0.0.1:8377"), w.hub.admits_hub("https://127.0.0.1:8377", "http://127.0.0.1:8377"),
           w.hub.admits_hub("127.0.0.1:8377", "http://127.0.0.1:8377")))

    # --- what leaves

    w = fakes.World()
    alpha, beta = w.repo("alpha", TREE), w.repo("beta", [("map-columns", None, STRANGER)])
    # WORKER's unit sits in alpha's tree, whose page of it changed last
    w.opened(page(beta / "agent/show/map-columns/index.html"), WORKER)
    os.utime(page(alpha / "agent/show/csv-import/index.html"), (w.clock.now, w.clock.now))
    w.opened(alpha / "agent/show/csv-import/index.html", WORKER)
    w.opened(page(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html"), ORCHESTRATOR)
    gone = page(alpha / "agent/prototypes/csv-import/index.html")
    gone_id = w.opened(gone, ORCHESTRATOR)["id"]
    gone.unlink()
    check("a member whose file is deleted leaves its unit", False, any(m["id"] == gone_id for m in w.view(ORCHESTRATOR)["members"]))
    retiring = w.opened(page(beta / "agent/show/map-columns/retiring.html"), RETIRER)
    check("a unit's tree, once read", "map-columns", w.view(retiring["unit"])["tree"])
    (beta / "agent/tickets/map-columns.md").unlink()
    check("...and retired, takes the unit with it, its pages still there", (None, True),
          (w.view(RETIRER), (beta / "agent/show/map-columns/retiring.html").exists()))
    check("...off the rail", False, any(u["unit"] == RETIRER for u in w.rail()))
    check("...while a unit of another tree holding a page of that tree stays", True, w.view(WORKER) is not None)
    # hub-follows-links-between-session-pages: a handoff's link to another session's page, clicked in the hub tab
    follow = lambda path: w.clicked(served(path.resolve()), WORKER)
    followed = follow(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html")
    check("a click on another session's session page goes to that session's unit, not the one clicked in", (ORCHESTRATOR, False),
          (followed.get("unit"), any(m["id"] == followed.get("id") for m in w.view(WORKER)["members"])))
    revived = follow(page(beta / f"agent/sessions/{RETIRER}/index.html"))
    check("...and makes a unit again of a session whose unit went with its tree", (RETIRER, True, revived.get("id")),
          (revived.get("unit"), w.view(RETIRER) is not None, (w.view(RETIRER) or {}).get("session_page", {}).get("id")))
    lone_session, solo_session, whole_session = (f"{n}0000000-0000-4000-8000-00000000000{n}" for n in (7, 8, 9))
    delta = w.repo("delta", [("lone", None, lone_session)])
    epsilon = w.repo("epsilon", [("solo", None, solo_session)])
    d = w.opened(page(delta / "agent/show/lone/index.html"), lone_session)
    e = w.opened(page(epsilon / "agent/show/solo/index.html"), solo_session)
    zeta = w.repo("zeta", [("whole", None, whole_session)])
    z = w.opened(page(zeta / "agent/show/whole/index.html"), whole_session)
    (zeta / "agent/tickets/half-written.md").write_text("no frontmatter yet\n")  # `tracker data` refuses the whole tracker
    check("a unit whose tracker refuses its tickets for now is still there", [z["id"]],
          [m["id"] for m in (w.view(z["unit"]) or {}).get("members", [])])
    shutil.rmtree(delta / "agent" / "tickets")
    shutil.rmtree(epsilon)
    check("a unit whose tracker is gone is gone, its pages still there or not", (None, None), (w.view(d["unit"]), w.view(e["unit"])))
    check("...and left the rail", False, any(u["unit"] in (d["unit"], e["unit"]) for u in w.rail()))
    passing = "12345678-0000-4000-8000-00000000000a"
    fleeting_note = w.opened(page(w.home / "notes" / "fleeting.html"), passing)
    (w.home / "notes" / "fleeting.html").unlink()
    check("a unit with no tree goes once every page of it is deleted", (passing, None), (fleeting_note["unit"], w.view(passing)))

    # --- the loose pages, and a stand-in for a session page

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    loose = w.opened(page(w.home / "notes" / "unclaimed.html"))
    check("a page no session opened lands with the loose pages", "loose", loose["unit"])
    check("...a unit of that name, with no session to resume, no number on the rail and no account", ("loose pages", "", None, None, None),
          (lambda u: (u["title"], u["resume"], u["state"], w.number("loose"), u["account"]))(w.view("loose")))
    eta = w.repo("eta", [("lonely", None, STRANGER)])
    w.opened(page(eta / "agent/show/lonely/index.html"))
    w.view("loose")
    (eta / "agent/tickets/lonely.md").unlink()
    check("...which a tree retired does not take, the loose pages of no tree still in it", True,
          loose["id"] in [m["id"] for m in (w.view("loose") or {}).get("members", [])])
    # one-hub-tab#P2 where no session page lists a unit's pages, a stand-in in the session lane does, until one exists
    check("the loose pages have a stand-in for a session page, with the column the hub tab fills", ("/pages/loose", True),
          (w.view("loose")["session_page"]["url"], 'id="artefacts"' in w.hub.stand_in_page(w.view("loose")).decode()))
    late = w.opened(page(alpha / "agent/show/csv-import/late.html"), LATECOMER)
    stand_in = w.view(LATECOMER)["session_page"]
    check("so has a session's unit before its session page is rendered", f"/pages/{LATECOMER}", stand_in["url"])
    w.clicked(stand_in["url"], LATECOMER)
    check("...which, opened from the hub tab, heads the unit as its session page, and lists the unit's pages but itself",
          ([("session", "session")], [late["id"]]),
          (lambda u: ([(m["kind"], m["lane"]) for m in u["members"] if m["url"] == stand_in["url"]], [p["id"] for p in u["pages"]]))(w.view(LATECOMER)))
    real = page(alpha / f"agent/sessions/{LATECOMER}/index.html")
    real_url = served(real.resolve())
    check("...and goes once the session page exists, which takes its place in the unit", (real_url, [real_url]),
          (lambda u: (u["session_page"]["url"], [m["url"] for m in u["members"] if m["kind"] == "session"]))(w.view(LATECOMER)))

    # --- hub-starts-and-resumes-sessions: every session running on the host is a unit from its start

    w = fakes.World()
    alpha = w.repo("alpha", TREE)
    # each session's process a child of this test's: run inside a dispatched worker, this test's own process carries
    # DISPATCH_WORKLOG, and the hub would take every session it registers for a worker
    person = {k: v for k, v in os.environ.items() if k != "DISPATCH_WORKLOG"}
    runs = {s: subprocess.Popen(["sleep", "60"], env={**person, **extra}) for s, extra in
            ((ORCHESTRATOR, {}), (NOVICE, {}), (WORKER, {"DISPATCH_WORKLOG": "/w/log"}), (SPIKER, {}))}
    try:
        in_process = lambda session, **kw: w.registered(session, pid=runs[session].pid, started=fakes.started(runs[session].pid), **kw)
        in_process(ORCHESTRATOR, cwd=alpha / "agent" / "show", kind="interactive")
        in_process(NOVICE, cwd=w.home)
        in_process(WORKER, cwd=alpha)
        in_process(SPIKER, cwd=alpha, kind="sdk-py")
        terminal = w.view(ORCHESTRATOR)
        check("a session started in a terminal, which has opened no page, is a unit at once, numbered on the rail, its "
              "session page a stand-in, under the tree of the repo it works in",
              (True, f"/pages/{ORCHESTRATOR}", "map-columns", "idle"),
              (terminal is not None and terminal["number"] is not None, (terminal or {}).get("session_page", {}).get("url"),
               (terminal or {}).get("tree"), (terminal or {}).get("state")))
        check("...as is one working in no repo with an agent repo, under no tree", (True, None),
              (w.view(NOVICE) is not None, (w.view(NOVICE) or {}).get("tree")))
        check("a dispatched worker's session is no unit, nor is one nobody types into", (None, None), (w.view(WORKER), w.view(SPIKER)))
        kept = w.home / ".claude" / "session-pages" / NOVICE
        page(kept / "index.html")
        check("...and its session page takes the stand-in's place once rendered", served((kept / "index.html").resolve()),
              w.view(NOVICE)["session_page"]["url"])
        for session in (ORCHESTRATOR, NOVICE):
            runs[session].kill()
            runs[session].wait()
        check("once its session ends, a unit that opened no page goes, and one whose session page was rendered is among "
              "the ended", (None, "ended"), (w.view(ORCHESTRATOR), (w.view(NOVICE) or {}).get("state")))
    finally:
        for run in runs.values():
            run.kill()
            run.wait()

    # --- hub-starts-and-resumes-sessions D4: what a resume restores of how a session last ran, as its transcript has it

    said = w.home / "ran-with.jsonl"
    line = lambda **fields: json.dumps(fields) + "\n"
    said.write_text(
        line(type="user", permissionMode="acceptEdits", message={"role": "user", "content": "go"})
        + line(type="assistant", effort="medium", message={"model": "claude-sonnet-5-5"})
        + line(type="user", permissionMode="plan", message={"role": "user", "content": "/model opus, and plan it"})
        + line(type="assistant", effort="max", message={"model": "claude-opus-5-5"})
        + line(type="assistant", isSidechain=True, effort="low", message={"model": "claude-haiku-5-5"})  # a subagent's
        + line(type="user", isSidechain=True, permissionMode="bypassPermissions", message={"content": "a subagent's prompt"})
        + line(type="assistant", message={"model": "<synthetic>"}))  # Claude Code's own stand-in reply
    check("a resume restores the model and effort of the main thread's last real reply, and the permission mode of the "
          "user's last prompt", {"model": "claude-opus-5-5", "effort": "max", "mode": "plan"}, w.hub.ran_with(said))
    said.write_text(said.read_text() + line(type="api-request", params={"model": "claude-opus-5-5", "betas": ["claude-code-20250219", "context-1m-2025-08-07"]})
                    + line(type="assistant", effort="max", message={"model": "claude-opus-5-5"}))
    check("...a model whose last request asked for the 1M context window by its beta with Claude Code's [1m]",
          "claude-opus-5-5[1m]", w.hub.ran_with(said).get("model"))
    said.write_text(line(type="user", permissionMode="default", cwd=str(w.home)) + line(type="assistant", message={"model": "<synthetic>"}))
    check("...and none it records nowhere, or as nothing Claude Code takes as a flag", {}, w.hub.ran_with(said))

    # --- hub-rail-marks-sessions-needing-you: what an idle session's page says it needs

    if not fakes.READER:
        skipped("what an idle session's page says it needs", "no mx plugin here, whose session page reader the rail reads a page by")
    else:
        w = fakes.World()
        alpha = w.repo("alpha", TREE)
        for session in (ORCHESTRATOR, WORKER, STRANGER):
            w.opened(page(w.home / "notes" / f"{session[:8]}.html"), session)
        w.registered(WORKER, "idle", w.clock.now - 500)
        w.clock.tick(100)
        asking = w.home / ".claude" / "session-pages" / ASKER  # outside the checkout, where the mx plugin keeps it
        page(asking / "agent-repo", f"{alpha / 'agent'}\n")
        w.turn_record(asking, 1, "Two ways to import, Q1 picks", ("Q1",), at=w.clock.now - 100)
        w.opened(page(asking / "index.html"), ASKER)
        w.registered(ASKER, "idle")
        w.hub.mark("visit", {"unit": ASKER})
        asker = lambda: (lambda u: (u["state"], u["needs_you"], u["status_line"]))(w.view(ASKER))
        check("an idle session whose page has an open question, every record seen, needs you for the question",
              ("idle", {"questions": 1, "unseen": False}, "Two ways to import, Q1 picks"), asker())
        w.registered(ASKER, "busy")
        check("a busy session shows busy, whatever its page holds", ("busy", None), asker()[:2])
        w.registered(ASKER, "waiting", waiting_for="permission prompt")
        check("...and a blocked one blocked", ("waiting", None), asker()[:2])
        w.registered(ASKER, "idle")
        w.turn_record(asking, 2, "Imported the CSV files as `Q1 (a)` has it", answered={"Q1": "a"}, at=w.clock.tick())
        check("a turn record written since the last visit marks it, the question it answered not",
              ("idle", {"questions": 0, "unseen": True}, "Imported the CSV files as Q1 (a) has it"), asker())
        w.clock.tick()
        w.hub.mark("visit", {"unit": ASKER})
        check("...and once visited, nothing open, it does not need you", None, asker()[1])
        long_ago = w.clock.now - 1000  # its last turn's end, older than any other running session's
        os.utime(asking / "index.html", (long_ago, long_ago))
        w.registered(ASKER, "idle", long_ago)
        w.registered(ORCHESTRATOR, "idle", w.clock.now)
        numbered_units = lambda: [u["unit"] for u in w.rail() if u["number"]]
        unneeded = numbered_units()
        check("...numbered by its last turn's end, after the idle sessions that finished one since", True,
              unneeded.index(ASKER) > 0)
        w.chat_turn(asking, "```text\nimport running\n```\n\n## **Waiting** on [the worker](agent/show/x/report.md)\n\nI report once it lands.", w.clock.tick())
        check("a chat turn after it marks nothing, and is the status line, its first line of prose without its markup",
              (None, "Waiting on the worker"), asker()[1:])
        w.turn_record(asking, 3, "Two more calls", ("Q2", "Q3"), at=w.clock.tick())
        w.turn_record(asking, 4, "Q2 settled, Q3 stands", answered={"Q2": "b"}, at=w.clock.tick())
        w.clock.tick()
        w.hub.mark("visit", {"unit": ASKER})
        check("a question asked in an earlier record stays open beside one answered, whichever turn asked it",
              ({"questions": 1, "unseen": False}, "Q2 settled, Q3 stands"), asker()[1:])
        check("a session that needs you is 1 on the rail, however long ago its turn ended, and the rest keep their order",
              [ASKER, *(u for u in unneeded if u != ASKER)], numbered_units())
        other = STRANGER  # a unit no registry entry kept in the numbers until now
        w.registered(other, "waiting", long_ago - 100, waiting_for="permission prompt")
        others = [u for u in unneeded if u not in (ASKER, other)]
        check("a session blocked in its terminal comes before one that needs you, "
              "however long ago its turn ended", [other, ASKER, *others], numbered_units())
        w.registered(other, "busy", w.clock.tick())
        check("...and a busy one after every idle one, however recently its turn ended",
              [ASKER, *others, other], numbered_units())
        (asking / "turns/05.md").write_text("no frontmatter\n")
        check("a record the reader refuses leaves the unit there, needing nothing and saying nothing", (True, None, ""),
              (lambda u: (u is not None, u["needs_you"], u["status_line"]))(w.view(ASKER)))

    # --- what type /f/ serves a file as

    served_as = lambda name, body=b"a = 1\n": w.hub.content_type(Path(name), body)  # noqa: E731
    check("text a browser would download is served as plain text, for the pane to show it",
          ["text/plain; charset=utf-8"] * 5, [served_as(n) for n in ("periods.toml", "a.yaml", "flake.nix", "run.sh", "notes.md")])
    rendered = w.hub.markdown_page(Path("notes.md"), (
        b"---\nstatus: open\n---\n\n# The *plan*\n\n| a | b |\n| - | - |\n| 1 | 2 |\n\n"
        b"[up](../other.md) [home](~/x.md) [abs](/tmp/y.md) <script>alert(1)</script>\n")).decode()
    check("a markdown file is served rendered, titled by its first heading, its tables too", (True, True, True),
          ("<title>The *plan*</title>" in rendered, "<em>plan</em></h1>" in rendered, "<td>1</td>" in rendered))
    check("...its frontmatter shown as the YAML it is", True, '<pre class="front">status: open</pre>' in rendered)
    check("...a relative link left to resolve beside it, a link to an absolute or ~ path made a file:// URL",
          (True, True, True), tuple(f'href="{t}"' in rendered for t in ("../other.md", f"{Path.home().as_uri()}/x.md", "file:///tmp/y.md")))
    shown = rendered.split('<main class="prose">')[1].split("</main>")[0]
    check("...and raw HTML in it shown as text", (False, True), ("<script>alert" in shown, "&lt;script&gt;" in shown))
    source = (b"# Notes\n\nA __BODY__ marker, `<!--<script>` and `</script>` quoted.\n")
    page_data = re.search(r'<script type="application/json" id="source">(.*?)</script>', w.hub.markdown_page(Path("n.md"), source).decode(), re.S)
    check("...and it carries the file as written, for its copy button, whatever the file quotes", source.decode(), json.loads(page_data[1]))
    check("...titled by its name where it has no heading", True, "<title>bare.md</title>" in w.hub.markdown_page(Path("bare.md"), b"text").decode())
    check("...and a type a browser shows keeps its own", ["text/html", "application/json", "image/png", "application/pdf"],
          [served_as(n) for n in ("index.html", "data.json", "fig.png", "paper.pdf")])
    check("a binary file is never served as text", ("application/octet-stream", "application/zip"),
          (served_as("blob", b"\xff\xfe\x00"), served_as("out.zip", b"PK\x03\x04\xff")))

    # --- hub-finds-every-session: what the search lists of a host, read from its transcripts as Claude Code writes them

    w = fakes.World()
    alpha = w.repo("alpha", [])
    found_ids = {name: f"{n:08x}-0000-4000-8000-0000000000{n:02x}" for n, name in enumerate(
        ["renamed", "worker", "released", "paged", "committed", "helferline", "fork source", "growing"], 0x51)}
    said_line = lambda **line: json.dumps(line, separators=(",", ":")) + "\n"
    first_line = lambda session, cwd, entry="cli": said_line(type="user", sessionId=session, cwd=str(cwd), entrypoint=entry,
                                                             message={"content": "go"})
    ai, custom = (lambda session, text: said_line(type="ai-title", aiTitle=text, sessionId=session),
                  lambda session, text: said_line(type="custom-title", customTitle=text, sessionId=session))
    projects = w.home / ".claude/projects/-home-repos-alpha"
    written = {}
    for name, session in found_ids.items():
        account = w.home / (".claude-helferline" if name == "helferline" else ".claude")
        written[name] = page(account / "projects/-home-repos-alpha" / f"{session}.jsonl",
                             first_line(session, alpha, "sdk-cli" if name == "worker" else "cli") + ai(session, f"the {name} one")
                             + (custom(session, "renamed by the user") + ai(session, "the AI's later title") if name == "renamed" else ""))
    page(projects / f"{found_ids['released']}.release.json", json.dumps({"to": "elsewhere", "at": 1, "from": "here"}))
    page(w.home / ".claude/session-pages" / found_ids["paged"] / "session.md", "---\ndate: 2026-10-23\n---\n\n# Its session page's heading\n")
    page(w.home / ".claude/session-pages" / found_ids["paged"] / "index.html", "<!doctype html><h1>Its session page's heading</h1>")
    page(alpha / "agent/sessions" / found_ids["committed"] / "session.md", "# Committed into the agent repo\n")
    page(w.hub.STATE / "fork-sources.json", json.dumps({found_ids["fork source"]: "pc"}))
    w.hub.SEARCH_READ = 0
    index = w.hub.own_sessions()
    check("a read of the session index that runs out of time lists what it read, here nothing, and how many it did not",
          ([], 6), (index["sessions"], index["unread"]))
    w.hub.SEARCH_READ = 2.0
    index = w.hub.own_sessions()
    listed = {s[0]: (s[1], index["accounts"][s[2]]) for s in index["sessions"]}
    claude, helferline = str((w.home / ".claude").resolve()), str((w.home / ".claude-helferline").resolve())
    check("the search lists every session a person started on the host, of every account, each titled as its unit would "
          "be: its session page's heading, under its account or in the agent repo of the directory it ran in, else the "
          "user's /rename over Claude Code's own title; a dispatched worker's left out, a session released to another "
          "host, and the copy a fork started from",
          {found_ids["renamed"]: ("renamed by the user", claude), found_ids["paged"]: ("Its session page's heading", claude),
           found_ids["committed"]: ("Committed into the agent repo", claude),
           found_ids["helferline"]: ("the helferline one", helferline), found_ids["growing"]: ("the growing one", claude)},
          listed)
    check("...nothing left to read", 0, index["unread"])
    with written["growing"].open("a") as f:
        f.write(custom(found_ids["growing"], "grown since") + '{"type":"custom-title","custo')
    w.hub.SEARCH_READ = 0
    restarted = fakes.load(w.clock, w.hub.STATE)
    restarted.SEARCH_READ = 0
    index = restarted.own_sessions()
    check("a hub started anew lists from what it kept of the index, reading only what was written since", 
          (5, 1, "the growing one"), (len(index["sessions"]), index["unread"],
                                      next(s[1] for s in index["sessions"] if s[0] == found_ids["growing"])))
    restarted.SEARCH_READ = 2.0
    check("...a title from a /rename added since, a line still being written not yet", "grown since",
          next(s[1] for s in restarted.own_sessions()["sessions"] if s[0] == found_ids["growing"]))
    with written["growing"].open("a") as f:
        f.write(custom(found_ids["growing"], "grown again")[len('{"type":"custom-title","custo'):])
    check("...which counts once it is whole", "grown again",
          next(s[1] for s in restarted.own_sessions()["sessions"] if s[0] == found_ids["growing"]))
    w.hub.SEARCH_READ = 2.0
    before = w.hub.own_sessions()
    page(projects / f"{'9' * 8}-0000-4000-8000-000000000099.jsonl", first_line(f"{'9' * 8}-0000-4000-8000-000000000099", alpha))
    with w.hub.index_lock:  # another read under way, as two tabs, or a tab and a peer's relay, ask at once
        check("a read of the index that comes while another runs gets the last listing at once, rather than wait",
              before, w.hub.own_sessions())
    check("...and the next read lists what was written since", len(before["sessions"]) + 1, len(w.hub.own_sessions()["sessions"]))
    kept = json.loads(w.hub.index_file().read_text())
    w.hub.index_file().write_text(json.dumps({**kept, "version": 0, "transcripts": {k: v[:3] for k, v in kept["transcripts"].items()}}))
    older = fakes.load(w.clock, w.hub.STATE)
    older.SEARCH_READ = 0
    check("an index kept in another shape is read again from scratch: every transcript but the released one and the "
          "fork's source, the worker's included", 7, older.own_sessions()["unread"])
    view = w.hub.unit_read(found_ids["renamed"])
    check("a session the search lists that has no unit is shown as the unit it would be: ended, its stand-in for a "
          "session page, its resume command",
          ("ended", "renamed by the user", f"/pages/{found_ids['renamed']}", True),
          (view["state"], view["title"], view["session_page"]["url"], found_ids["renamed"] in view["resume"]))
    check("...one with a session page, that page", served((w.home / ".claude/session-pages" / found_ids["paged"] / "index.html").resolve()),
          w.hub.unit_read(found_ids["paged"])["session_page"]["url"])
    check("...and its stand-in names it", True, b"renamed by the user" in w.hub.stand_in_page(view))
    check("...kept nowhere: the rail stays as it was", ([], []),
          ([u["unit"] for u in w.rail()], sorted(p.name for p in (w.hub.STATE / "units").glob("*.json"))))
    check("...and a dispatched worker's session, a released one and a fork's source have none",
          [None, None, None], [w.hub.unit_read(found_ids[n]) for n in ("worker", "released", "fork source")])
    w.clicked(w.home / ".claude/session-pages" / found_ids["paged"] / "index.html", found_ids["paged"])
    check("a page opened in it makes it a unit", [found_ids["paged"]], [u["unit"] for u in w.rail()])

    # --- hub-restarts-on-new-code: a disk watch that keeps failing says so once, and once that it recovered

    w = fakes.World()
    digest = w.hub.view_digest
    w.hub.listeners.append(w.hub.queue.Queue())  # a round reads only while a tab listens

    def failing(why: str):
        def view_digest():
            raise OSError(why)
        return view_digest

    said, sys.stderr = sys.stderr, (log := fakes.RUN / "watch.log").open("w")
    try:
        state = frozenset()
        moved, went = failing("a ticket moved"), failing("a page went")
        for read in (moved, moved, went, moved, went, digest, digest):
            w.hub.view_digest = read
            state = w.hub.watch_round(state)
    finally:
        sys.stderr.close()
        sys.stderr = said
    check("a failing watch round prints its error once per distinct error, and once more when rounds succeed again",
          ["watching: OSError: a ticket moved", "watching: OSError: a page went", "watching again"], log.read_text().splitlines())

    check("no world's hub or test called tmux", "", "".join(w.refused() for w in fakes.WORLDS))
finally:
    sys.stderr = sys.__stderr__
    hub_said.close()

finish()
