#!/usr/bin/env -S uv run --script --quiet
# tier: full-path (Chromium, tmux, a live hub)
# /// script
# requires-python = ">=3.12"
# dependencies = ["playwright", "tyro>=1.0.14"]
# ///
"""Drive the hub tab (bin/container-hub.html) in headless Chromium and check what it promises, one scenario at a time.

Each scenario starts from a world of its own: a hub on a scratch HOME holding one tree, whose orchestrator has its
session page and two tickets' show pages open, and a hub tab on it in a browser profile of its own. So any scenario
runs alone, and in any order. Skips with no Chromium (check.chromium says which it finds). What the hub decides (the
rail's numbers, a unit's state, its usage) is checked at its module, in decisions.test; this file checks
what the tab does with it.

GNOME takes its own bindings before a browser sees them, so a key that clashes with one passes here and fails on the
desktop: this is no substitute for driving the view in Brave.

Examples:

    tests/container-hub/view.test
    tests/container-hub/view.test maximize theme-switch
    tests/container-hub/view.test --shuffle 7
"""

import http.server
import json
import os
import pwd
import random
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import traceback
import urllib.parse
import urllib.request
from contextlib import contextmanager
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Literal

import tyro
from playwright.sync_api import Error as PlaywrightError, TimeoutError as PlaywrightTimeout, sync_playwright

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
import fakes  # noqa: E402  (the fixtures a hub's world is written with)
from check import BIN, Skip, check, chromium, fail, finish, free_port, needs, settles, skip, skipped  # noqa: E402
from fakes import READER, SELF_STARTED, started  # noqa: E402

ORCHESTRATOR = "aaaaaaaa-0000-4000-8000-000000000001"
SECOND = "bbbbbbbb-0000-4000-8000-000000000002"  # an orchestrator of another subtree of the same tree
LEFT, RIGHT = f"p:{ORCHESTRATOR}:left", f"p:{ORCHESTRATOR}:right"  # the panes of ORCHESTRATOR's unit


def session_id(n: int) -> str:
    return f"{n:08x}-0000-4000-8000-{n:012x}"


ANSWERING = session_id(0x11)  # a session in a tmux pane, which the input box types into
VIEWPORT = {"width": 1600, "height": 950}

def until(read, what: str, within: float = 30):
    """What read() returns once it is truthy; a scenario that never gets there stops, saying what it waited for."""
    deadline = time.monotonic() + within
    while not (got := read()):
        if time.monotonic() > deadline:
            raise RuntimeError(f"gave up waiting for {what}")
        time.sleep(0.05)
    return got


QUESTION = ("---\ndate: 2026-10-07\n---\n\n# {title}\n\n## Questions\n\n"
            "- [Q1] **Which way?** A call only the user can make.\n  - (a) this way *my pick*\n  - (b) that way\n")
TRELLIS_VERSION = re.search(r'TRELLIS_VERSION = "(.+)"', (BIN / "container-hub").read_text())[1]
HLJS_VERSION = re.search(r'HLJS_VERSION = "(.+)"', (BIN / "diffview").read_text())[1]
# A page that records each POST it makes to the hub, so a check that the tab sent nothing reads what it sent.
RECORD_POSTS = """if (window === top) { const f = window.fetch; window.posts = [];
  window.fetch = (url, o) => { if (o?.method === "POST") posts.push(new URL(url, location.href).pathname); return f(url, o); }; }"""


class Elsewhere(http.server.BaseHTTPRequestHandler):
    """A local server on another origin than the hub's: /deny and /self refuse framing, /slow answers only once the
    server's `held` is set, so a page fetching it has not loaded until then, and any other path allows framing."""

    def do_GET(self):
        if self.path == "/slow":
            self.server.held.wait(60)
        self.send_response(200)
        if self.path == "/deny":
            self.send_header("X-Frame-Options", "DENY")
        if self.path == "/self":
            self.send_header("Content-Security-Policy", "frame-ancestors 'self'")
        self.send_header("Content-Type", "text/html")
        self.end_headers()
        self.wfile.write(b"<!doctype html><h1>an app</h1>")

    def log_message(self, *_):
        pass


@contextmanager
def elsewhere():
    """The origin of an Elsewhere server, and the event that lets its /slow answer."""
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Elsewhere)
    server.held = threading.Event()
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        yield f"http://127.0.0.1:{server.server_address[1]}", server.held
    finally:
        server.held.set()
        server.shutdown()
        server.server_close()


class World:
    """One scenario's hub and hub tab. The hub runs on a scratch HOME holding one tree, repos/alpha and its agent repo:
    tickets map-columns (open) and csv-import (claimed under it, on ORCHESTRATOR's commit), ORCHESTRATOR's session page
    and both tickets' show pages, open in ORCHESTRATOR's unit. The tab opens in the overview, every page loaded."""

    def __init__(self, browser, run: Path, name: str):
        self.hub = self.context = self.tmux_socket = None
        self.news = 0  # the pages hears() has opened
        self.errors = []
        try:
            self.build(browser, run, name)
        except BaseException:
            self.close()
            raise

    def build(self, browser, run: Path, name: str) -> None:
        # A scenario named twice runs twice. The name is cut short because tmux's socket and the hub's live in here, and
        # a unix socket's path fits in 108 bytes, under a TMPDIR as long as the devShell's too.
        self.scratch = Path(tempfile.mkdtemp(dir=run, prefix=f"{name[:24]}."))
        self.home = self.scratch / "home"
        self.code = self.home / "repos" / "alpha"
        self.agent = self.code / "agent"
        self.t0 = time.time()
        # Every tmux call, the hub's and the test's, goes through a tmux that passes on only those naming the world's
        # own server's socket, and records the rest: nothing here may reach a server the test did not start.
        self.tmux_socket = self.scratch / "tmux.sock"
        self.tmux_refused = self.scratch / "tmux-refused"
        self.tmux_shim = self.scratch / "shim" / "tmux"
        self.tmux_shim.parent.mkdir()
        self.tmux_shim.write_text(f"""#!/usr/bin/env bash
[ "$1" = -S ] && [ "$2" = {shlex.quote(str(self.tmux_socket))} ] && exec {shlex.quote(shutil.which("tmux"))} "$@"
printf '%s\\n' "$*" >> {shlex.quote(str(self.tmux_refused))}
exit 1
""")
        self.tmux_shim.chmod(0o755)
        self.env = fakes.scrubbed(self.home)
        self.env["PATH"] = f"{self.tmux_shim.parent}:{self.env['PATH']}"
        (self.home / ".cache/container-hub").mkdir(parents=True)
        (self.home / ".cache/container-hub" / f"trellis-{TRELLIS_VERSION}").symlink_to(run / "trellis")
        fakes.with_reader(self.home)

        (self.agent / "tickets").mkdir(parents=True)
        self.git(self.code, "init", "-q")
        (self.code / ".git/info/exclude").write_text("agent/\n")
        self.git(self.code, "commit", "-q", "--allow-empty", "-m", "init")
        self.git(self.agent, "init", "-q")
        self.ticket("map-columns")
        self.ticket("csv-import", "claimed", "map-columns")
        self.git(self.agent, "add", "tickets")
        self.git(self.agent, "commit", "-q", "-m", "file the tree", "-m", f"Session: {ORCHESTRATOR}")
        # The session page as the mx renderer writes it, cut to what the hub reads: the artefact column (#artefacts),
        # each link to an artefact carrying the absolute path it opens (data-artefact), on a collapsed turn's chips
        # too, and the page's keys 1 to 9, which click the focused turn's links in the column.
        show = self.agent / "show"
        self.pages = [self.page(f"sessions/{ORCHESTRATOR}/index.html", f"""<h1>session</h1>
<details class="turn" id="t01" data-block><summary>turn 1 <span class="chip"><a class="chip-link" href="../../show/csv-import/index.html"
  data-artefact="{show}/csv-import/index.html" target="_blank">csv import</a></span></summary></details>
<aside class="column" id="artefacts"><section class="group" id="a01"><a class="turn-ref" href="#t01">01</a><ol>
  <li><kbd class="n">1</kbd><a class="artefact" href="../../show/csv-import/index.html" data-artefact="{show}/csv-import/index.html" target="_blank">csv import</a></li>
  <li><kbd class="n">2</kbd><a class="artefact" href="../../show/map-columns/index.html" data-artefact="{show}/map-columns/index.html" target="_blank">map columns</a></li>
  <li><kbd class="n">3</kbd><a class="artefact" href="../../show/map-columns/sketch.html" data-artefact="{show}/map-columns/sketch.html" target="_blank">sketch</a></li>
</ol></section></aside>
<script>document.addEventListener("keydown", (e) => {{
  if (!e.ctrlKey && !e.altKey && /^[1-9]$/.test(e.key)) document.querySelectorAll("#a01 a[data-artefact]")[+e.key - 1]?.click()
}})</script>"""),
                      self.page("show/csv-import/index.html", "<h1>csv import</h1>"),
                      self.page("show/map-columns/index.html", "<h1>map columns</h1><a id=link href='other.html'>other</a>")]
        self.page("show/map-columns/other.html", "<h1>other</h1>")
        self.page("show/map-columns/sketch.html", "<h1>sketch</h1>")  # the column links it, and nobody opens it
        # The board as the tracker renders it, cut to what the hub reads: a row per ticket, carrying its slug
        # (details.ticket[data-slug]), in groups the done of which is folded. The rows before ORCHESTRATOR's open
        # ticket push it out of view. drop-zone is SECOND's.
        row = lambda slug: f'<details class="ticket" id="t-{slug}" data-slug="{slug}"><summary style="height:60px">{slug}</summary></details>'
        self.page("board.html", '<details class="grp" id="grp-frontier" open><summary>frontier</summary>'
                  + "".join(row(f"filler-{n}") for n in range(30)) + row("map-columns") + row("drop-zone")
                  + '</details><details class="grp" id="grp-done"><summary>done</summary>' + row("csv-import") + "</details>")

        self.port = free_port()
        self.origin = f"http://127.0.0.1:{self.port}"
        self.hub_args = [str(BIN / "container-hub"), "--socket", str(self.scratch / "hub.sock"), "--port", str(self.port),
                         "--state", str(self.scratch / "state"),
                         "--tmux-socket", str(self.tmux_socket)]
        self.start_hub()
        os.utime(self.pages[0], (self.t0 - 100, self.t0 - 100))  # the session page's render: ORCHESTRATOR's last turn
        self.registered(ORCHESTRATOR, self.t0 - 100)
        opened = [self.api("/api/open", {"target": str(p), "session": ORCHESTRATOR}) for p in self.pages]
        self.mids = {p.parent.name: o["id"] for p, o in zip(self.pages, opened)}
        self.ids = {k: f"{ORCHESTRATOR}~{v}" for k, v in self.mids.items()}  # a page's view in the hub tab is its unit's

        self.context = browser.new_context(viewport=VIEWPORT)
        self.context.grant_permissions(["clipboard-read", "clipboard-write"], origin=self.origin)
        self.context.add_init_script(RECORD_POSTS)
        self.view = self.context.new_page()
        self.view.on("pageerror", lambda e: self.errors.append(str(e)))
        self.view.goto(self.origin + "/")
        self.view.evaluate("navigator.clipboard.writeText('')")  # the browser's, which every world's profile shares
        self.view.wait_for_function("window.wc && ws.views().length === 2", timeout=30000)
        for member in ("csv-import", "map-columns"):  # a key that trellis sends into a page still loading goes nowhere
            self.frame_of(member)

    # ---- the world on disk, and the hub

    def git(self, cwd: Path, *args: str, at: int | None = None) -> None:
        """git in the world, committing at `at` where it is given, as the committer date has it."""
        env = {**self.env, "GIT_COMMITTER_DATE": f"@{at} +0000"} if at else self.env
        subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *args], cwd=cwd, env=env,
                       check=True, capture_output=True)

    def ticket(self, slug: str, status: str = "open", parent: str | None = None) -> None:
        fakes.ticket(self.agent, slug, status, parent)

    def registered(self, session: str, at: float, status: str = "idle", pid: int | None = None, started: str = SELF_STARTED,
                   account: str = ".claude", file: str | None = None, **extra) -> None:
        """The session's file in the registry of its account, as Claude Code writes it while the session's process
        runs: by default this test's own process, which runs for as long as the hub reads it. A second process of the
        session has a file of its own."""
        path = self.home / account / "sessions" / f"{file or session[:8]}.json"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps({"pid": pid or os.getpid(), "procStart": started, "sessionId": session, "status": status,
                                    "statusUpdatedAt": int(at * 1000), **extra}))

    def statusline(self, session: str, config_dir: Path, **numbers) -> None:
        """What the statusline keeps of the session's last render."""
        path = self.home / ".cache/claude-statusline" / f"{session}.json"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps({"session_id": session, "config_dir": str(config_dir), "written_at": time.time(),
                                    "model": {"display_name": "Opus"}, **numbers}))

    def page(self, rel: str, body: str) -> Path:
        path = self.agent / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(f"<!doctype html><body style='height:400px'>{body}")
        return path

    def api(self, path: str, body: dict | None = None) -> dict:
        req = urllib.request.Request(self.origin + path, data=json.dumps(body).encode() if body else None,
                                     method="POST" if body else "GET")
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())

    def opened(self, target, session: str = ORCHESTRATOR, **extra) -> str:
        """The page an agent of the session opens, by its view's id in the hub tab."""
        answer = self.api("/api/open", {"target": str(target), "session": session, **extra})
        return f"{answer['unit']}~{answer['id']}"

    def listen(self) -> list[dict]:
        """What the hub tells its listeners from now on, as it tells them, the way a hub tab hears it."""
        events, listening = [], threading.Event()

        def stream() -> None:
            try:
                with urllib.request.urlopen(self.origin + "/events") as r:
                    for line in r:
                        listening.set()
                        if line.startswith(b"data:"):
                            events.append(json.loads(line[5:]))
            except OSError:
                pass  # the world's hub, gone at its end

        threading.Thread(target=stream, daemon=True).start()
        until(lambda: listening.wait(1), "the hub's events")
        return events

    def hub_view(self, unit: str = ORCHESTRATOR) -> dict:
        return self.api("/api/u/" + unit)

    def member(self, mid: str, unit: str = ORCHESTRATOR) -> dict:
        return next(m for m in self.hub_view(unit)["members"] if m["id"] == mid)

    def start_hub(self) -> None:
        self.hub = subprocess.Popen(self.hub_args, env=self.env, stdout=subprocess.DEVNULL,
                                    stderr=(self.scratch / "hub.log").open("a"), start_new_session=True)

        def listening() -> bool:
            try:
                socket.create_connection(("127.0.0.1", self.port), timeout=1).close()
                return True
            except OSError:
                return False
        until(listening, f"the hub to listen on its port (its log: {self.scratch / 'hub.log'})", within=60)

    def kill_hub(self) -> None:
        os.killpg(self.hub.pid, signal.SIGKILL)  # `uv run` leads the group; the server is its child
        self.hub.wait()
        deadline = time.monotonic() + 10  # `uv run` is reaped first; the server holds the port until it goes too
        while time.monotonic() < deadline:
            try:
                os.killpg(self.hub.pid, 0)
                time.sleep(0.05)
            except ProcessLookupError:
                break

    def tmux(self, *args: str) -> str:
        return subprocess.run([self.tmux_shim, "-S", self.tmux_socket, *args], env=self.env, capture_output=True,
                              text=True, check=True).stdout.strip()

    def close(self) -> None:
        """Everything the world started stops, whichever step of it fails."""
        try:
            if self.context:
                check("no script errors", [], self.errors)
                self.context.close()
        finally:
            try:
                if self.hub:
                    self.kill_hub()
            finally:
                if self.tmux_socket:
                    subprocess.run([self.tmux_shim, "-S", self.tmux_socket, "kill-server"], env=self.env, capture_output=True, check=False)
                    check("no tmux call, the hub's or the test's, went to a server other than the world's own", "",
                          self.tmux_refused.read_text() if self.tmux_refused.exists() else "")

    # ---- what the tab shows

    def current(self, page=None):
        return (page or self.view).evaluate("wc.current")

    def docked(self) -> list[str]:
        return sorted(self.view.evaluate("ws.views().filter(v => v.placement === 'docked').map(v => v.id)"))

    def focused(self, page=None):
        return (page or self.view).evaluate("ws.getSnapshot().focusedView")

    def focused_panel(self):
        return self.view.evaluate("ws.getSnapshot().focusedPanel")

    def panel_of(self, view_id: str):
        return self.view.evaluate(f"ws.view({json.dumps(view_id)})?.panelId ?? null")

    def frame_at(self, suffix: str, page=None):
        """The frame showing the page, once loaded: a panel is in the layout before its iframe navigates."""
        page = page or self.view
        page.wait_for_function(f"[...document.querySelectorAll('iframe')].some(f => f.contentDocument?.readyState === 'complete'"
                               f" && f.contentWindow.location.pathname.endsWith({json.dumps(suffix)}))", timeout=30000)
        # playwright hears of the navigation after the page shows it
        return until(lambda: next((f for f in page.frames if f.url.endswith(suffix)), None) or page.evaluate("false"),
                     f"a frame showing {suffix}", within=10)

    def frame_of(self, member: str):
        return self.frame_at(f"/{member}/index.html")

    def line(self, suffix: str):
        """How the session page's column marks the page whose path ends so: open, minimized, tab, or "" for not opened
        yet, with the glyph before its line. None while the page is reloading, or lists no such page."""
        try:
            return self.frame_of(ORCHESTRATOR).evaluate("""s => {
                const a = [...document.querySelectorAll('#artefacts a[data-artefact]')].find(a => a.dataset.artefact.endsWith(s));
                const mark = a?.previousElementSibling;
                return a && mark?.classList.contains('hub-mark') ? [a.dataset.hub ?? "", mark.textContent] : null }""", suffix)
        except PlaywrightError:
            return None

    @staticmethod
    def line_link(suffix: str) -> str:
        return f'#artefacts a[data-artefact$="{suffix}"]'

    def holds_keyboard(self) -> bool:
        return self.view.evaluate(HOLDS_KEYBOARD)

    def holds_session(self) -> bool:
        return self.view.evaluate(HOLDS_SESSION)

    def sidebar_url(self, page=None):
        return (page or self.view).evaluate(f"({SIDEBAR_PAGE})?.getAttribute('src') ?? null")

    def session_url(self, path: Path) -> str:
        return f"/f{urllib.parse.quote(str(path))}"

    def shown(self, side: str, page=None) -> bool:
        """Whether the sidebar (rail-side or session-side) is in sight: shown, and not folded to no width."""
        return (page or self.view).evaluate(f"(s => s.checkVisibility() && s.getBoundingClientRect().width > 0)(document.getElementById('{side}'))")

    def panes(self, page=None) -> list[str]:
        """ORCHESTRATOR's unit's columns left to right, each the panels in it."""
        return (page or self.view).evaluate(f"""(() => {{
            const d = ws.getDocument(), panels = (n) => n.kind === "panel" ? [n] : n.children.flatMap(panels);
            const mine = (n) => d.views[panels(n)[0].views[0]]?.params.group === "{ORCHESTRATOR}";
            const top = d.root.id === "root" ? d.root.children.find(mine) : d.root;
            return (top.kind === "split" && top.axis === "x" ? top.children : [top]).map((c) => panels(c).map((p) => p.id).join("+"));
        }})()""")

    def on_screen(self) -> list[str]:
        """The panels the camera shows, left to right."""
        return self.view.evaluate("""(() => { const app = document.getElementById("app").getBoundingClientRect();
            return [...document.querySelectorAll('[data-trellis-part="panel"]')].map((e) => [e.dataset.panel, e.getBoundingClientRect()])
              .filter(([, r]) => r.width > 40 && r.left >= app.left - 4 && r.right <= app.right + 4).sort((a, b) => a[1].left - b[1].left).map(([id]) => id); })()""")

    def tab_of(self, view_id: str):
        """The view's tab, in its panel's tab bar."""
        tab = self.view.evaluate(f"document.querySelector('[role=tabpanel][data-view=\"{view_id}\"]').getAttribute('aria-labelledby')")
        return self.view.locator(f'[id="{tab}"]')

    def keys_open(self) -> bool:
        return self.view.evaluate("document.getElementById('keys').open")

    def log(self) -> str:
        return self.view.inner_text("#log")

    def posted(self, what: str) -> int:
        """How many times this tab has POSTed to /api/<what>."""
        return self.view.evaluate(f"posts.filter((p) => p === {json.dumps('/api/' + what)}).length")

    # ---- what a person does in it, and what a scenario waits on

    def settle(self) -> None:
        """Two frames on: trellis places panels, and moves the keyboard, a frame after it is asked to."""
        self.view.evaluate("new Promise(r => requestAnimationFrame(() => requestAnimationFrame(() => r())))")

    def written(self) -> None:
        """Wait until the hub has answered every write the tab queued (wc.sending). A key shows its change in the
        tab and queues its write to the hub: settle on what the tab shows, then call this before reading the hub."""
        self.view.evaluate("(async () => { for (let p; p !== wc.sending;) await (p = wc.sending); })()")

    def fence(self) -> None:
        """Press ctrl+alt+? where the keyboard is, and wait for the keys list to fold over. Keys are handled in the
        order they are pressed, so every key pressed before it has been handled by then: what a check that a key
        did nothing waits on."""
        was = self.keys_open()
        self.view.keyboard.press("Control+Alt+?")
        until(lambda: self.keys_open() != was, "the keys list to fold over")
        self.settle()

    def hears(self, cause):
        """Do cause(), which has the hub tell this tab something, and return what it returns once the tab has done
        whatever the news makes it do. An agent of ORCHESTRATOR then opens a page: the tab reads the hub whole on each
        piece of news and draws what it read, so once that page is in the layout, a read holding the cause's news has
        been drawn."""
        result = cause()
        self.news += 1
        after = self.opened(self.page(f"show/map-columns/news-{self.news}.html", "<h1>news</h1>"))
        self.view.wait_for_function(f"!!ws.view({json.dumps(after)})", timeout=10000)
        self.settle()
        return result

    def enter(self) -> None:
        """Into ORCHESTRATOR's unit by its key, its session page loaded in the sidebar."""
        self.view.keyboard.press("Control+Alt+1")
        until(lambda: self.current() == ORCHESTRATOR, "ORCHESTRATOR's unit")
        self.frame_of(ORCHESTRATOR)

    def focus(self, member: str) -> None:
        """Focus a page as a click would, and wait for trellis to move the keyboard into it a frame later."""
        self.focus_view(self.ids[member])

    def focus_view(self, view_id: str) -> None:
        self.view.evaluate(f"ws.focus({json.dumps(view_id)})")
        self.view.wait_for_function(HOLDS_KEYBOARD, timeout=10000)

    def click_into(self, frame) -> None:
        """Click into the page, and wait for trellis to hand its panel the keyboard a frame later: a key pressed
        sooner would be undone by the handover."""
        frame.click("body", position={"x": 300, "y": 200})
        self.view.wait_for_function(HOLDS_KEYBOARD, timeout=10000)
        self.settle()

    def focus_session(self) -> None:
        """The keyboard into the session page, as a click into it would put it there."""
        self.view.evaluate(f"{SIDEBAR_PAGE}.focus()")
        self.view.wait_for_function(HOLDS_SESSION, timeout=10000)

    def minimize(self, view_id: str) -> None:
        """Minimize the page by its key, and wait for the hub to have it: the hub orders what was minimized last by
        when it heard."""
        self.focus_view(view_id)
        self.view.keyboard.press("Control+Alt+w")
        until(lambda: view_id not in self.docked(), f"{view_id} minimized")
        self.written()

    def rule(self, slug: str, status: str) -> None:
        """The tracker rules the ticket, and the tab has heard."""
        self.ticket(slug, status, "map-columns" if slug != "map-columns" else None)
        self.view.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(ORCHESTRATOR)}).tickets"
                                    f".find(t => t.slug === {json.dumps(slug)})?.status === {json.dumps(status)}", timeout=10000)
        self.settle()

    def fresh_tab(self, ready: str = "window.wc && ws.views().length > 0", context=None):
        """Another hub tab on the hub, in this browser profile unless another is given, as after a reload or a browser
        restart: once ready holds in it."""
        page = (context or self.context).new_page()
        page.goto(self.origin + "/")
        page.wait_for_function(ready, timeout=30000)
        return page

    def open_diff(self) -> tuple[str, str]:
        """A diffview page of the tree's last commit opened in ORCHESTRATOR's unit, by its view's id and its panel."""
        hljs = self.home / ".cache/diffview" / f"hljs-{HLJS_VERSION}"
        hljs.mkdir(parents=True)
        (hljs / "highlight.min.js").write_text("")  # fails its pin, so diffview neither fetches nor highlights
        (self.code / "notes.txt").write_text("one\n")
        self.git(self.code, "add", "notes.txt")
        self.git(self.code, "commit", "-q", "-m", "notes")
        diff = self.agent / "diffviews" / "map-columns.html"
        diff.parent.mkdir()
        subprocess.run([BIN / "diffview", f"{self.code}@HEAD~1..HEAD", "-o", str(diff), "--no-auto-summary"], env=self.env,
                       check=True, capture_output=True)
        diff_id = self.opened(diff)
        self.view.wait_for_function(f"ws.views().some(v => v.id === {json.dumps(diff_id)} && v.placement === 'docked')", timeout=10000)
        self.frame_at("/diffviews/map-columns.html")
        return diff_id, self.panel_of(diff_id)

    def second(self) -> str:
        """SECOND, an orchestrator on drop-zone in the same tree, which finished a turn after ORCHESTRATOR, its page
        open in its unit: by that page's view's id."""
        self.ticket("drop-zone", "claimed", "map-columns")
        self.git(self.agent, "add", "tickets/drop-zone.md")
        self.git(self.agent, "commit", "-q", "-m", "claim drop-zone", "-m", f"Session: {SECOND}")
        self.registered(SECOND, self.t0 - 50)
        second_id = self.opened(self.page("show/drop-zone/index.html", "<h1>drop zone</h1>"), SECOND)
        self.view.wait_for_function(f"ws.views().some(v => v.id === {json.dumps(second_id)})", timeout=10000)
        return second_id

    def board_marks(self) -> list[str]:
        """The tickets the board marks as the unit's."""
        return self.frame_at("/board.html").evaluate("[...document.querySelectorAll('[data-hub-unit]')].map(r => r.dataset.slug)")

    def rail(self) -> list[str]:
        """The numbered units, in their order on the rail."""
        return self.view.evaluate("wc.state.units.filter(u => u.number).map(u => u.unit)")

    def rail_units(self, page=None) -> list[str]:
        """Every unit the rail lists, numbered or not."""
        return (page or self.view).evaluate("[...document.querySelectorAll('#units .nav, #aside-units .nav')].map(b => b.title.replace('session ', ''))")

    def pane(self) -> "Pane":
        return Pane(self)


HOLDS_KEYBOARD = "document.activeElement === ws.view(ws.getSnapshot().focusedView)?.element.querySelector('iframe')"
# the session page of the unit you are in, in the sidebar right of the rail
SIDEBAR_PAGE = "document.querySelector('#session-frames > .current iframe')"
HOLDS_SESSION = f"document.activeElement === {SIDEBAR_PAGE}"
BOX = "document.querySelector('#session-box .reply')"


class Pane:
    """ANSWERING, a session in a tmux pane of the world's own server, the tab in its unit with the keyboard in its
    input box. The session's program stands in for Claude Code: it asks for bracketed paste, and records every byte
    typed into its pane. ANSWERING's session page lists its one page."""

    def __init__(self, w: World):
        self.w = w
        self.received, recorder = w.scratch / "received", w.scratch / "recorder.py"
        recorder.write_text("import os, sys, tty\ntty.setraw(0)\nos.write(1, b'\\x1b[?2004h')\nout = open(sys.argv[1], 'ab', buffering=0)\n"
                            "while data := os.read(0, 4096):\n    out.write(data)\n")
        # no config: the user's own would load plugins whose tmux calls name no socket
        w.tmux("-f", "/dev/null", "new-session", "-d", "-s", "answering", "-x", "100", "-y", "20",
               f"exec {sys.executable} {recorder} {self.received}")
        self.id, pid = w.tmux("display-message", "-p", "-t", "answering:", "#{pane_id} #{pane_pid}").split()
        self.pid = int(pid)
        self.started = started(pid)
        self.target = f"answering:@0.{self.id}"
        self.in_pane()
        self.session_page = w.page(f"sessions/{ANSWERING}/index.html", "<h1>answering's session</h1>")
        os.utime(self.session_page, (w.t0 - 301, w.t0 - 301))
        w.opened(w.page("show/unit-1/index.html", "<h1>unit 1</h1>"), ANSWERING)
        w.opened(self.session_page, ANSWERING)
        w.view.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(ANSWERING)})?.session_page?.url.startsWith('/f/')", timeout=10000)
        self.enter()
        until(lambda: self.says() == ["waiting", "idle"], "the box, idle")

    def enter(self) -> None:
        self.w.view.locator(f'#units button[title="session {ANSWERING}"] .name').click()  # its middle may be the id, which copies
        until(lambda: self.w.current() == ANSWERING, "ANSWERING's unit")
        self.w.frame_at(f"/{ANSWERING}/index.html")

    def in_pane(self, status: str = "idle", **extra) -> None:
        """The session's registry file, naming its pane."""
        self.w.registered(ANSWERING, self.w.t0 - 301, status, pid=self.pid, started=self.started, tmux=self.target, **extra)

    def in_no_pane(self) -> None:
        self.w.registered(ANSWERING, self.w.t0 - 301, pid=self.pid, started=self.started)

    def says(self):
        return self.w.view.evaluate(f"(b => b && [b.dataset.state, b.querySelector('.how').textContent])({BOX})")

    def how(self) -> str:
        return self.w.view.evaluate(f"{BOX}.querySelector('.how').textContent")

    def text(self) -> str:
        return self.w.view.evaluate(f"{BOX}.querySelector('textarea').value")

    def focus(self) -> None:
        self.w.view.evaluate(f"{BOX}.querySelector('textarea').focus()")

    def arrived(self) -> bytes:
        return self.received.read_bytes() if self.received.exists() else b""

    def after_reload(self) -> str:
        """What the box holds in a hub tab opened afresh."""
        fresh = self.w.fresh_tab(f"(() => {{ try {{ return !!{BOX}.querySelector('textarea'); }} catch {{ return false; }} }})()")
        text = fresh.evaluate(f"{BOX}.querySelector('textarea').value")  # the try: it throws until the session page is up
        fresh.close()
        return text

    def rendered(self, heading: str, *shown: str, ended: str = "") -> None:
        """The session page rendered again, showing these messages of the user's, and opened again, as the Stop hook does;
        with a turn that ended at `ended` (an ISO time) where one is given."""
        turn = f"<details class='turn' data-block data-at='{ended}'><summary>a turn</summary></details>" if ended else ""
        self.w.page(f"sessions/{ANSWERING}/index.html", f"<h1>{heading}</h1><section class='turns'>{turn}" + "".join(
            f"<details class='said you'><summary>you</summary><div class='said-text'><div class='msg'><p>{m}</p></div></div></details>"
            for m in shown) + "</section>")
        self.w.opened(self.session_page, ANSWERING)


SCENARIOS = {}


def scenario(fn):
    SCENARIOS[fn.__name__.replace("_", "-")] = fn
    return fn


# ---- a unit, its pages and the keys inside them

@scenario
def entering_a_unit(w: World) -> None:
    check("the overview shows no session page", (None, False), (w.current(), w.shown("session-side")))
    w.view.keyboard.press("Control+Alt+1")
    settles("ctrl+alt+1 goes into the first orchestrator", ORCHESTRATOR, w.current)
    w.frame_of(ORCHESTRATOR)
    check("the session page is in the sidebar right of the rail, never a tab", (w.session_url(w.pages[0]), False),
          (w.sidebar_url(), w.view.evaluate("ws.views().some(v => v.params.kind === 'session')")))
    check("...and the other pages of a unit open in a pane on the left: two tickets' show pages as its tabs",
          ([LEFT], [LEFT] * 2), (w.panes(), [w.panel_of(w.ids[k]) for k in ("csv-import", "map-columns")]))
    settles("...on screen", [LEFT], w.on_screen)
    check("closing or reloading the hub tab asks nothing", False,
          w.view.evaluate("(e => (dispatchEvent(e), e.defaultPrevented))(new Event('beforeunload', { cancelable: true }))"))


@scenario
def keys_with_the_hub_frozen(w: World) -> None:
    """The keys answer with the hub frozen: it gets the change once it runs again."""
    w.enter()
    events = w.listen()
    # The close is held back on its way until the hub runs again, so a reopen the tab sent without waiting on it
    # would reach the hub first.
    held = []
    w.view.route("**/api/close", lambda route: held.append(route))
    os.killpg(w.hub.pid, signal.SIGSTOP)
    try:
        w.focus("csv-import")
        w.view.keyboard.press("Control+Alt+w")
        settles("ctrl+alt+w takes the page out of the layout with the hub frozen", False, lambda: w.ids["csv-import"] in w.docked())
        settles("...its line marked minimized in the session page's column", ["minimized", "–"], lambda: w.line("/csv-import/index.html"))
        w.view.keyboard.press("Control+Alt+Shift+W")
        settles("ctrl+alt+shift+w brings it back with the hub frozen", True, lambda: w.ids["csv-import"] in w.docked())
        until(lambda: w.view.evaluate("true") and held, "the close on its way")
    finally:
        os.killpg(w.hub.pid, signal.SIGCONT)
        for route in held:
            route.continue_()
        w.view.unroute("**/api/close")
    w.written()
    check("the page is open in the hub once it runs again", False, w.member(w.mids["csv-import"])["closed"])
    settles("...having had the close and then the reopen", {"close", "reopened"},
            lambda: {e["type"] for e in events if e.get("id") == w.mids["csv-import"]})


@scenario
def a_ruling_minimizes_nothing(w: World) -> None:
    """hub-layout-pass 4: a ruling in the tracker minimizes nothing."""
    w.enter()
    w.rule("csv-import", "done")
    check("ruling a ticket leaves its pages where they are", True, w.ids["csv-import"] in w.docked())


@scenario
def links_in_a_page(w: World) -> None:
    v = w.view
    w.enter()
    w.focus("map-columns")  # its panel's front tab, which a click reaches
    w.frame_of("map-columns").click("#link")
    v.wait_for_function("ws.views().some(v => v.params.url.endsWith('/other.html'))", timeout=10000)
    other = v.evaluate("ws.views().find(v => v.params.url.endsWith('/other.html')).params")
    check("a plain click on a link opens it as a panel in the page's unit", (ORCHESTRATOR, "map-columns"),
          (other["group"], other["ticket"]))
    w.focus("map-columns")  # other.html took its panel's front tab
    with w.context.expect_page(timeout=30000) as tab:
        w.frame_of("map-columns").click("#link", modifiers=["Control"])
    check("a ctrl-click opens it as a browser tab", True, tab.value.url.endswith("/other.html"))
    tab.value.close()

    def link(href: str) -> None:
        """A link in the map-columns page, clicked as a person would."""
        w.focus("map-columns")
        w.frame_of("map-columns").evaluate(
            "href => { const a = Object.assign(document.createElement('a'), { id: 'added', href, textContent: 'added' });"
            " document.getElementById('added')?.remove(); document.body.prepend(a); }", href)
        w.frame_of("map-columns").click("#added")

    third = w.page("show/map-columns/third.html", "<h1>third</h1>")
    link(f"http://localhost:{w.port}/f{urllib.parse.quote(str(third))}")
    settles("a link to the hub by its other name opens as a panel too", True,
            lambda: v.evaluate("ws.views().some(v => v.params.url.endsWith('/third.html'))"))
    clipboard = lambda: w.frame_of("map-columns").evaluate("navigator.clipboard.readText()")
    views_before = v.evaluate("ws.views().length")
    link(f"file://{urllib.parse.quote(str(third.parent))}")
    settles("a link to a directory copies its path", str(third.parent), clipboard)
    check("...and opens nothing", views_before, v.evaluate("ws.views().length"))
    w.frame_of("map-columns").evaluate("""() => { document.body.insertAdjacentHTML("afterbegin",
        '<p>at <code id="inline"> 2a3754f9 </code></p><pre><code id="block">make check</code></pre><p><code id="after">after</code></p>'); }""")
    w.frame_of("map-columns").click("#inline")
    settles("a click on inline code copies its text", "2a3754f9", clipboard)
    w.frame_of("map-columns").click("#block")
    w.frame_of("map-columns").click("#after")  # copied after whatever the click on the block copied
    until(lambda: clipboard() == "after", "the copy after the code block's")
    check("...and one on a code block copies nothing", False, "copied make check" in w.log())
    w.frame_of("map-columns").press("#link", "Control+Alt+0")
    settles("ctrl+alt+0 from inside a page goes to the overview", None, w.current)


@scenario
def an_image_looked_at(w: World) -> None:
    v = w.view
    w.enter()
    w.focus("map-columns")  # its panel's front tab, which a click reaches
    shot = w.agent / "show/map-columns/shot.svg"
    shot.write_text('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200"><rect width="400" height="200"/></svg>')
    frame = w.frame_of("map-columns")
    frame.evaluate("""() => { document.body.insertAdjacentHTML("afterbegin",
        '<img id="shot" src="shot.svg" width="200"> <img id="icon" src="shot.svg" width="16">'
        + ' <a href="other.html"><img id="thumb" src="shot.svg" width="200"></a>'); }""")
    frame.wait_for_function("document.getElementById('shot').complete")
    looked = lambda: v.evaluate("document.querySelector('#look img')?.src.split('/').pop() ?? null")
    looked_width = lambda: v.evaluate("parseFloat(document.querySelector('#look img')?.style.width)")
    fitted = lambda: v.evaluate("""(() => { const img = document.querySelector('#look img'), box = img?.parentElement;
        return !!img && (Math.abs(parseFloat(img.style.width) - box.clientWidth) < 1 || Math.abs(parseFloat(img.style.height) - box.clientHeight) < 1); })()""")
    views_before = v.evaluate("ws.views().length")
    frame.click("#shot")
    settles("a click on an image in a page looks at it closer, over the tab", "shot.svg", looked)
    check("...and opens no page", views_before, v.evaluate("ws.views().length"))
    settles("...fitted to the tab: as wide as the look, or as high", True, fitted)
    fitted_width = looked_width()
    v.mouse.move(700, 400)
    v.mouse.wheel(0, -300)
    settles("...zoomed by the wheel", True, lambda: looked_width() > fitted_width)
    v.keyboard.press("Escape")
    settles("...and put away by esc", None, looked)
    # The tab decides in the click's own handler whether to look at an image, so by the time the click returns,
    # an image it looks at is over the tab.
    frame.click("#icon")
    check("a click on an icon looks at nothing", None, looked())
    frame.click("#thumb")
    check("...nor one on an image in a link to another page", None, looked())
    settles("...which follows its link instead, to a panel of the page it links", True,
            lambda: v.evaluate("ws.view(ws.getSnapshot().focusedView)?.params.url.endsWith('/other.html') ?? false"))
    w.focus("map-columns")
    frame.click("#shot")
    v.mouse.click(5, 300)
    settles("a click beside an image looked at puts it away", None, looked)
    frame.click("#shot")
    v.keyboard.press("p")
    settles("p keeps it as a page of the unit", True, lambda: v.evaluate("ws.views().some(v => v.params.url.endsWith('/shot.svg'))"))
    check("...and puts it away", None, looked())


@scenario
def minimized_pages_listed(w: World) -> None:
    """one-hub-tab#P2: a page minimized is listed in its unit's session page, and one key or click brings it back."""
    v = w.view
    other_id = w.opened(w.agent / "show/map-columns/other.html")
    third_id = w.opened(w.page("show/map-columns/third.html", "<h1>third</h1>"))
    # each takes its panel's front tab as the tab hears of it, which a focus made sooner would lose
    w.view.wait_for_function(f"[{json.dumps(other_id)}, {json.dumps(third_id)}].every((id) => ws.view(id))", timeout=10000)
    w.enter()
    w.minimize(w.ids["csv-import"])
    check("the column marks each page open (●), minimized (–) or not opened yet (○)",
          (["open", "●"], ["minimized", "–"], ["", "○"]),
          (w.line("/map-columns/index.html"), w.line("/csv-import/index.html"), w.line("/sketch.html")))
    check("...and so does a collapsed turn's chip, csv import's", "minimized",
          w.frame_of(ORCHESTRATOR).evaluate("document.querySelector('.chip a[data-artefact]').dataset.hub"))
    unlinked = lambda: w.frame_of(ORCHESTRATOR).evaluate("[...document.querySelectorAll('#hub-unlinked a[data-artefact]')].map(a => a.dataset.artefact.split('/').pop())")
    settles("the pages no turn links are listed at the column's end, in the order they were opened", ["other.html", "third.html"], unlinked)
    check("...after every line the renderer wrote", True, w.frame_of(ORCHESTRATOR).evaluate(
        "document.querySelector('#artefacts').lastElementChild.id === 'hub-unlinked'"))
    w.focus("map-columns")
    v.keyboard.press("Control+Alt+w")
    settles("ctrl+alt+w minimizes the page: out of the layout, its line marked minimized", (False, ["minimized", "–"]),
            lambda: (w.ids["map-columns"] in w.docked(), w.line("/map-columns/index.html")))
    w.written()
    check("...still a member, minimized", True, w.member(w.mids["map-columns"])["closed"])
    w.frame_of(ORCHESTRATOR).click(w.line_link("/map-columns/index.html"))
    settles("a click on its line in the column brings it back to its pane, focused", (LEFT, w.ids["map-columns"]),
            lambda: (w.panel_of(w.ids["map-columns"]), w.focused()))
    settles("...its line marked open again", ["open", "●"], lambda: w.line("/map-columns/index.html"))
    v.keyboard.press("Control+Alt+w")
    settles("minimized again", False, lambda: w.ids["map-columns"] in w.docked())
    v.wait_for_function(HOLDS_KEYBOARD, timeout=10000)  # the panel nearest it takes the keyboard a frame later
    w.frame_of(ORCHESTRATOR).press("#t01 > summary", "2")
    settles("the session page's key 2 brings back the focused turn's second page", (LEFT, w.ids["map-columns"]),
            lambda: (w.panel_of(w.ids["map-columns"]), w.focused()))
    w.focus_view(other_id)
    v.keyboard.press("Control+Alt+w")
    settles("a page no turn links, minimized, is marked so at the column's end", (False, ["minimized", "–"]),
            lambda: (other_id in w.docked(), w.line("/other.html")))
    w.frame_of(ORCHESTRATOR).click(w.line_link("/other.html"))
    settles("...and a click on its line there brings it back", True, lambda: other_id in w.docked())
    w.focus_view(other_id)
    v.keyboard.press("Control+Alt+w")
    settles("minimized again", False, lambda: other_id in w.docked())
    v.keyboard.press("Control+Alt+Shift+W")
    settles("ctrl+alt+shift+w brings back the page minimized last, not the one minimized before it", (True, False),
            lambda: (other_id in w.docked(), w.ids["csv-import"] in w.docked()))
    laid_out = w.docked()
    w.focus_session()
    v.keyboard.press("Control+Alt+w")
    w.fence()
    check("ctrl+alt+w with the keyboard in the session page minimizes nothing, the page being no tab",
          (laid_out, True, w.session_url(w.pages[0])), (w.docked(), w.holds_session(), w.sidebar_url()))


@scenario
def keyboard_between_panes(w: World) -> None:
    v = w.view
    w.enter()
    diff_id, diff_panel = w.open_diff()
    diff_frame = w.frame_at("/diffviews/map-columns.html")
    check("a diffview page goes to the pane on the right", [LEFT, RIGHT], w.panes())
    v.keyboard.press("Control+Alt+0")
    until(lambda: w.current() is None, "the overview")
    v.keyboard.press("Control+Alt+1")
    settles("the camera frames the unit whole: both panes on screen", [LEFT, RIGHT], w.on_screen)
    w.focus("map-columns")
    v.keyboard.press("Control+Alt+l")
    settles("ctrl+alt+l moves the keyboard to the pane on the right", (diff_panel, True), lambda: (w.focused_panel(), w.holds_keyboard()))
    check("...the camera staying, both panes being in sight", [LEFT, RIGHT], w.on_screen())
    v.keyboard.press("Control+Alt+l")
    w.fence()
    check("...and at the rightmost pane the keyboard stays", diff_panel, w.focused_panel())
    # into the diff, over to the left pane and back by a click: trellis hears no focus move between two pages
    diff_frame.click("body", position={"x": 300, "y": 200})
    v.mouse.click(*v.evaluate(f"(r => [r.x + r.width / 2, r.y + r.height / 2])(document.querySelector('[data-panel=\"{LEFT}\"]').getBoundingClientRect())"))
    w.click_into(diff_frame)
    check("a click into a page focuses its panel, before any key", diff_panel, w.focused_panel())
    diff_frame.press("body", "Control+Alt+h")
    settles("ctrl+alt+h from inside a page moves the keyboard to the pane on its left", (LEFT, True),
            lambda: (w.focused_panel(), w.holds_keyboard()))
    v.keyboard.press("Control+Alt+h")
    settles("...and from the leftmost pane into the session page in its sidebar", True, w.holds_session)
    v.keyboard.press("Control+Alt+l")
    settles("...and ctrl+alt+l from there to the leftmost pane", (LEFT, True), lambda: (w.focused_panel(), w.holds_keyboard()))
    v.keyboard.press("Control+Alt+l")
    settles("...and on to the right", (diff_panel, True), lambda: (w.focused_panel(), w.holds_keyboard()))
    check("...the camera never moving", [LEFT, RIGHT], w.on_screen())
    w.tab_of(diff_id).click()
    v.keyboard.press("F6")
    w.fence()
    check("F6 in the workspace moves no panel's focus: it is the browser's", diff_panel, w.focused_panel())
    v.keyboard.press("Shift+F6")
    w.fence()
    check("...and neither does shift+F6", diff_panel, w.focused_panel())


@scenario
def the_workspace_takes_no_drag_gestures(w: World) -> None:
    v = w.view
    w.enter()
    # trellis's drag gestures, every one held on a chord the hub's keys share, are off: no grab hand or crosshair, and
    # the page under the pointer takes a click
    gesture = lambda: v.evaluate(f"""(() => {{ const f = ws.view({json.dumps(w.ids["map-columns"])}).element.querySelector("iframe"), r = f.getBoundingClientRect();
        return [document.querySelector(".trellis").getAttribute("data-gesture-key"),
                document.elementFromPoint(r.x + r.width / 2, r.y + r.height / 2) === f]; }})()""")
    w.focus("map-columns")
    w.tab_of(w.ids["map-columns"]).click()
    for chord in (["Control", "Alt"], ["Control", "Alt", "Shift"], ["Control", "Shift"], ["Control", "Alt", "v"]):
        for k in chord:
            v.keyboard.down(k)
        w.settle()
        check(f"{'+'.join(chord).lower()} held in the workspace takes no drag gesture, and a page still takes a click",
              [None, True], gesture())
        for k in reversed(chord):
            v.keyboard.up(k)
    # a drag on the rail's grip makes every page deaf to the pointer while it lasts
    grip = v.locator("#rail-side .grip").bounding_box()
    v.evaluate("document.querySelector('#rail-side .grip').addEventListener('pointerdown', (e) => { window.gripPointer = e.pointerId; }, { once: true })")
    at = lambda dy: (grip["x"] + grip["width"] / 2, grip["y"] + grip["height"] / 2 + dy)  # straight down: the rail keeps its width
    v.mouse.move(*at(0))
    v.mouse.down()
    v.mouse.move(*at(1))  # a capture takes hold, and is let go, at the pointer's next event
    resizing = lambda: v.evaluate("document.body.classList.contains('resizing')")
    check("a drag on the rail's grip holds the pointer", True, resizing())
    v.evaluate("document.querySelector('#rail-side .grip').releasePointerCapture(gripPointer)")  # as a pointercancel would
    v.mouse.move(*at(2))
    settles("...and ends when the grip loses it, before any pointerup", False, resizing)
    v.mouse.up()


@scenario
def maximize(w: World) -> None:
    """ctrl+alt+z takes the focused panel, or the session page, over the whole window and back."""
    v = w.view
    w.enter()
    diff_id, diff_panel = w.open_diff()
    diff_frame = w.frame_at("/diffviews/map-columns.html")
    # over the whole window: the one panel on screen, both sidebars out of sight
    sight = lambda: (w.on_screen(), w.shown("rail-side"), w.shown("session-side"))
    whole, maximized = ([LEFT, RIGHT], True, True), ([diff_panel], False, False)
    settles("both panes in sight, and both sidebars", whole, sight)
    w.click_into(diff_frame)
    diff_frame.press("body", "Control+Alt+z")
    settles("ctrl+alt+z from inside a page puts that page's panel over the whole window, both sidebars out of sight", maximized, sight)
    diff_frame.press("body", "Control+Alt+z")
    settles("...and again restores it", whole, sight)
    check("...staying in the orchestrator", ORCHESTRATOR, w.current())
    tab = w.tab_of(diff_id)
    tab.click()
    v.keyboard.press("Control+Alt+z")
    settles("ctrl+alt+z in the workspace puts the focused panel over the whole window", maximized, sight)
    v.keyboard.press("Control+Alt+z")
    settles("...and again restores it, both sidebars back", whole, sight)
    v.keyboard.press("Control+Alt+z")
    settles("maximized again,", maximized, sight)
    v.keyboard.press("Control+Alt+a")
    settles("...ctrl+alt+a brings everything back rather than folding the rail away unseen", whole, sight)
    v.keyboard.press("Control+Alt+z")
    settles("maximized again,", maximized, sight)
    v.keyboard.press("Control+Alt+h")
    settles("...ctrl+alt+h brings everything back and the keyboard into the panel on the left", (whole, LEFT),
            lambda: (sight(), w.focused_panel()))
    w.focus_session()
    v.keyboard.press("Control+Alt+z")
    settles("ctrl+alt+z with the keyboard in the session page puts it over the whole window, the rail and the panes out of sight",
            (True, False, False), lambda: (w.shown("session-side"), w.shown("rail-side"), v.evaluate("document.getElementById('work').checkVisibility()")))
    v.keyboard.press("Control+Alt+z")
    settles("...and again brings them back", whole, sight)
    check("...the keyboard still in the session page", True, w.holds_session())
    tab.click()
    tab.click(button="right")
    check("the panel menu's Maximize names ctrl+alt+z", True,
          "Ctrl+Alt+Z" in v.locator('[role="menuitem"]', has_text="Maximize").first.inner_text())
    v.keyboard.press("Escape")


@scenario
def the_keys_list_and_a_pages_zoom(w: World) -> None:
    v = w.view
    w.enter()
    w.focus("map-columns")
    frame = w.frame_of("map-columns")
    frame.click("body", position={"x": 300, "y": 200})
    frame.press("body", "Control+Alt+?")
    settles("ctrl+alt+? from inside a page opens the keys over the tab", True, w.keys_open)
    w.settle()  # a focus move would land a frame later
    check("...and moves no focus", (w.ids["map-columns"], True), (w.focused(), w.holds_keyboard()))
    v.locator("#keys").click(position={"x": 4, "y": 4})
    settles("...and a click beside them shuts them", False, w.keys_open)
    w.tab_of(w.ids["map-columns"]).click()
    v.keyboard.press("Control+Alt+?")
    settles("...as ctrl+alt+? in the workspace opens", True, w.keys_open)
    v.keyboard.press("Control+Alt+?")
    settles("...and shuts them", False, w.keys_open)
    zoom = lambda: v.evaluate("Object.values(JSON.parse(localStorage.getItem('wc:zoom') ?? '{}'))")
    zoom_before = zoom()
    # on a German layout ? is shift+ß, the key US layouts have - on, and ctrl+alt acting as AltGr types \ there
    german = """document.body.dispatchEvent(new KeyboardEvent("keydown",
        { key: "\\\\", code: "Minus", ctrlKey: true, altKey: true, shiftKey: true, bubbles: true, cancelable: true }))"""
    frame.evaluate(german)
    settles("ctrl+alt+? as a German layout types it folds the keys list open too", True, w.keys_open)
    check("...and zooms nothing out", zoom_before, zoom())
    frame.evaluate(german)
    settles("...and shut", False, w.keys_open)
    v.keyboard.press("Control+Alt+Shift+Minus")  # _ on a US layout
    settles("ctrl+alt+shift+- on a US layout still zooms out, and folds nothing open", (True, False),
            lambda: (zoom() != zoom_before, w.keys_open()))
    v.keyboard.press("Control+Alt+Equal")
    settles("...and ctrl+alt+= zooms it back in", zoom_before, zoom)


@scenario
def sidebar_zoom(w: World) -> None:
    """hub-sidebar-zoom: the rail and the session sidebar each zoom on their own, by the keys where the keyboard is
    and by the − % + at their top, and keep it across a reload."""
    v = w.view
    w.enter()

    def zooms(page=v):
        """The rail's zoom, the session sidebar's, its session page's and box's as drawn, and every page's."""
        return page.evaluate(f"""[localStorage.getItem("wc:side:rail:zoom"), localStorage.getItem("wc:side:session:zoom"),
            getComputedStyle(document.querySelector("#rail > .usage")).zoom, {SIDEBAR_PAGE}.contentDocument.documentElement.style.zoom,
            getComputedStyle(document.getElementById("session-box")).zoom, localStorage.getItem("wc:zoom")]""")
    unzoomed = zooms()
    pages_zoom = unzoomed[5]
    check("both sidebars start at 100%", [None, None, "1", "", "1"], unzoomed[:5])
    v.focus("#search")
    v.keyboard.press("Control+Alt+Equal")
    settles("ctrl+alt++ with the keyboard in the rail's search box zooms the rail alone", ["1.1", None, "1.1", "", "1", pages_zoom], zooms)
    w.focus_session()
    v.keyboard.press("Control+Alt+Minus")
    v.keyboard.press("Control+Alt+Minus")
    settles("ctrl+alt+- twice in the session page zooms the session sidebar alone, its page and box both",
            ["1.1", "0.8", "1.1", "0.8", "0.8", pages_zoom], zooms)
    zoomer = lambda side, part: v.locator(f'.zoomer[data-side="{side}"] .{part}')
    zoomer("rail", "in").click()
    zoomer("session", "out").click()
    settles("the + at the rail's top and the − at the session sidebar's do the same",
            ["1.25", "0.7", "1.25", "0.7", "0.7", pages_zoom], zooms)
    check("...each showing its sidebar's percentage", ["125%", "70%"], [zoomer("rail", "pct").inner_text(), zoomer("session", "pct").inner_text()])
    if shot := os.environ.get("HUB_VIEW_SCREENSHOT"):
        v.screenshot(path=shot)
    kept = w.fresh_tab(f"window.wc && {SIDEBAR_PAGE}?.contentDocument?.readyState === 'complete'")
    settles("a reloaded hub tab keeps both", ["1.25", "0.7", "1.25", "0.7", "0.7", pages_zoom], lambda: zooms(kept))
    kept.close()
    w.focus_session()
    v.keyboard.press("Control+Alt+Shift+Digit3")  # # on a US layout
    zoomer("rail", "pct").click()
    settles("ctrl+alt+# in the session page, and a click on the rail's percentage, put them back at 100%", unzoomed, zooms)


@scenario
def theme_switch(w: World) -> None:
    """hub-theme-switch: the switch at the rail's top pins the other scheme on the tab and every page in it, a reload
    keeps it, and picked again it gives the tab back to the system's (day under playwright). Playwright's emulated
    scheme pins every frame's prefers-color-scheme, so a framed page following the frame's color-scheme shows only in
    a browser without it."""
    w.enter()
    schemes = lambda page=w.view: page.evaluate(  # the tab's pin, and its session page's
        f"[localStorage.getItem('hub:theme'), {SIDEBAR_PAGE}.contentDocument.documentElement.dataset.theme]")
    check("the tab starts on the system's scheme", [None, "day"], schemes())
    w.view.click("#scheme")
    settles("the switch pins night on the tab and its session page", ["night", "night"], schemes)
    kept = w.fresh_tab(f"window.wc && {SIDEBAR_PAGE}?.contentDocument?.readyState === 'complete'")
    settles("a reloaded hub tab keeps the pin", ["night", "night"], lambda: schemes(kept))
    kept.close()
    w.view.click("#scheme")
    settles("day, the system's scheme, is no pin", [None, "day"], schemes)


@scenario
def the_users_arrangement(w: World) -> None:
    """A pane resized and a page put beside another survive a reload of the hub tab, and an agent opening another page."""
    v = w.view
    w.enter()
    diff_id, diff_panel = w.open_diff()
    divider = v.evaluate(f"""(() => {{ const app = document.getElementById("app").getBoundingClientRect();
        const d = [...document.querySelectorAll('[data-trellis-part="divider"][data-split="g:{ORCHESTRATOR}"]')]
          .map((e) => e.getBoundingClientRect()).find((r) => r.height > 100 && r.left > app.left + 50 && r.right < app.right - 50);
        return d && [d.left + d.width / 2, d.top + d.height / 2]; }})()""")
    weights = lambda page=v: page.evaluate(f"(function find(n) {{ return !n ? null : n.id === 'g:{ORCHESTRATOR}' ? n.weights.map((w) => Math.round(w * 1000)) : n.children?.map(find).find(Boolean) ?? null; }})(ws.getDocument().root)")
    dragged_from = weights()
    v.mouse.move(*divider)
    v.mouse.down()
    v.mouse.move(divider[0] - 60, divider[1], steps=8)
    v.mouse.move(divider[0] - 120, divider[1], steps=8)
    v.mouse.up()
    settles("dragging the divider between the two panes resizes them", True,
            lambda: weights()[0] < dragged_from[0] and weights()[1] > dragged_from[1])
    figure = w.agent / "show/map-columns/plot.svg"
    figure.write_text('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 20"><rect width="40" height="20"/></svg>')
    figure_id = w.opened(figure)
    settles("an agent's figure lands in the left pane", LEFT, lambda: w.panel_of(figure_id))
    v.evaluate(f"ws.dock({json.dumps(figure_id)}, {{ beside: {json.dumps(diff_panel)}, edge: 'right' }})")

    def beside_diff() -> bool:
        at, cols = w.panel_of(figure_id), w.panes()
        code = next(i for i, c in enumerate(cols) if RIGHT in c.split("+"))
        return at != LEFT and at in "+".join(cols[code:code + 2]).split("+")
    settles("a page dragged beside the diff sits beside it", True, beside_diff)
    arranged = w.panes(), weights()
    w.written()
    reloaded = w.fresh_tab(f"window.wc && ws.view({json.dumps(figure_id)})")
    check("a reloaded hub tab keeps both", arranged, (w.panes(reloaded), weights(reloaded)))
    reloaded.close()
    late = w.page("show/map-columns/late.html", "<h1>late</h1>")
    late_id = w.opened(late)
    settles("a page an agent opens later goes to its pane", LEFT, lambda: w.panel_of(late_id))
    check("...and the arrangement holds", arranged, (w.panes(), weights()))
    w.hears(lambda: w.opened(late, lane="output"))
    check("a page an agent puts in another lane of the same pane stays where it is", LEFT, w.panel_of(late_id))
    w.opened(late, lane="code")
    settles("...and one an agent puts in the code lane moves to the right pane", RIGHT, lambda: w.panel_of(late_id))
    every_pane = lambda: sorted(sum((c.split("+") for c in w.panes()), []))
    check("...every pane of the unit on screen, the user's third included", every_pane(), sorted(w.on_screen()))
    w.focus_view(late_id)
    v.keyboard.press("Control+Alt+w")
    settles("...and once a page goes, the unit is still framed whole", every_pane(), lambda: sorted(w.on_screen()))


@scenario
def an_agent_opening_a_page_again(w: World) -> None:
    """An agent opening a page again reloads it, though never over what the page says it would lose."""
    w.enter()

    def reloaded() -> bool:
        try:
            return w.frame_of("map-columns").evaluate("window.__mark === undefined")
        except PlaywrightError:  # read mid-reload: the old page is gone and the new one not there yet
            return False
    asked = lambda: w.frame_of("map-columns").evaluate("window.asked")
    w.frame_of("map-columns").evaluate("window.__mark = 1; window.asked = 0; window.reloadWouldLose = () => (asked++, true)")
    w.opened(w.pages[2])
    until(lambda: asked() >= 2, "the tab to ask the page twice whether a reload would lose anything")
    check("a page that would lose what is typed in it is not reloaded under it", False, reloaded())
    w.frame_of("map-columns").evaluate("window.reloadWouldLose = () => false")
    settles("...and is reloaded once it would lose nothing", True, reloaded)
    w.frame_of("map-columns").evaluate("window.__mark = 1")
    w.opened(w.pages[2])
    settles("a page that says nothing is reloaded at once", True, reloaded, within=5)
    w.frame_of("map-columns").evaluate("window.__mark = 1")
    w.opened(w.pages[2])
    settles("...every time an agent opens it", True, reloaded, within=5)
    # a minimized page opened again by an agent needs the user again
    w.minimize(w.ids["csv-import"])
    w.opened(w.pages[1])
    settles("a minimized page an agent opens again comes back into the layout", True, lambda: w.ids["csv-import"] in w.docked())


@scenario
def the_board(w: World) -> None:
    """hub-layout-pass 4: the board."""
    v = w.view
    w.enter()
    w.rule("csv-import", "done")
    board_placement = lambda: v.evaluate("ws.views().find(v => v.params.kind === 'board')?.placement ?? null")
    v.keyboard.press("Control+Alt+b")
    settles("ctrl+alt+b shows the board, floating over the units", "floating", board_placement)
    board = w.frame_at("/board.html")  # a key pressed into a page still loading goes nowhere
    settles("...marking the tickets the unit's session claimed or committed on and not done, and no other", ["map-columns"],
            w.board_marks)
    check("...the first of them scrolled into view", True,
          board.evaluate("(r => r.top >= 0 && r.bottom <= innerHeight)(document.getElementById('t-map-columns').getBoundingClientRect())"))
    v.keyboard.press("Control+Alt+b")
    settles("...and hides it again", None, board_placement)
    box = lambda css: v.evaluate(f"(r => [r.left, r.top, r.width, r.height].map(Math.round))(document.querySelector('{css}').getBoundingClientRect())")
    board_box = lambda: box('[data-trellis-part="panel"][data-panel="board-panel"]')
    v.keyboard.press("Control+Alt+b")
    settles("ctrl+alt+b opens the board over the whole workspace", box("#app"), board_box)
    x, y, width, _ = board_box()
    v.mouse.move(x + width / 2, y + 12)  # its tab bar, right of the tab
    v.mouse.down()
    v.mouse.move(x + width / 2 + 200, y + 250, steps=12)
    v.mouse.up()
    settles("...a drag moves it", True, lambda: board_box() != box("#app"))
    v.keyboard.press("Control+Alt+b")
    settles("...and once closed", None, board_placement)
    v.keyboard.press("Control+Alt+b")
    settles("...it opens over the whole workspace again", box("#app"), board_box)
    w.frame_at("/board.html")
    v.keyboard.press("Control+Alt+b")
    settles("...and hides", None, board_placement)
    w.api("/api/open", {"target": str(w.agent / "board.html"), "session": ORCHESTRATOR})
    settles("a board an agent hands the hub opens over the hub tab", "floating", board_placement)
    check("...as a page of no unit", False, any(m["kind"] == "board" for m in w.hub_view()["members"]))
    v.keyboard.press("Control+Alt+b")
    settles("...and ctrl+alt+b hides it", None, board_placement)


# ---- the rail

@scenario
def two_orchestrators_on_one_tree(w: World) -> None:
    """The rail's keys walk the order the hub numbers its units in; the board marks the tickets of the unit you are in."""
    v = w.view
    w.rule("csv-import", "done")  # as the board has it
    w.enter()  # seen: its news is what comes after
    v.keyboard.press("Control+Alt+0")
    until(lambda: w.current() is None, "the overview")
    w.written()  # the hub dates a visit by when it hears of it, and the news below must come after
    second_id = w.second()
    check("a second orchestrator's page lands in its own unit", SECOND, second_id.split("~")[0])
    w.opened(w.pages[2])
    settles("the rail marks both orchestrators as having something new", 2,
            lambda: v.evaluate("document.querySelectorAll('#units .new').length"))
    # hub-rail-marks-sessions-needing-you#P1: an idle session's mark and status line, from its page's records
    if not READER:
        skipped("an idle session's mark and status line", "no mx plugin here, whose session page reader the rail reads a page by")
    else:
        record = w.agent / f"sessions/{ORCHESTRATOR}/turns/01.md"
        record.parent.mkdir()
        record.write_text(QUESTION.format(title="Two ways to import"))
        rail_row = lambda U: f"[...document.querySelectorAll('#units .unit')].find(b => b.querySelector('button[title=\"session {U}\"]'))"
        marked_row = lambda U: v.evaluate(f"(r => [r.querySelector('.mark').hasAttribute('data-needs'), r.querySelector('.mark').title,"
                                          f" r.querySelector('.said')?.textContent ?? null])({rail_row(U)})")
        settles("the rail fills the mark of an idle session with an open question, and shows its status line under its title",
                [True, "needs you: 1 open question, a turn record you have not seen", "Two ways to import"], lambda: marked_row(ORCHESTRATOR))
        check("...and leaves hollow that of one with no records", [False, "idle, nothing on its page waits on you", None], marked_row(SECOND))
        record.unlink()  # the keys below walk the units in the order of their turns alone
        settles("...and hollow once its page holds nothing for you", False, lambda: marked_row(ORCHESTRATOR)[0])
    v.keyboard.press("Control+Alt+Enter")
    settles("ctrl+alt+enter goes to the orchestrator whose news is oldest", SECOND, w.current)
    settles("...its stand-in for a session page in the sidebar, while it has rendered none", f"/pages/{SECOND}", w.sidebar_url)
    settles("...and the keyboard on its page", (second_id, True), lambda: (w.focused(), w.holds_keyboard()))
    v.keyboard.press("Control+Alt+2")
    settles("ctrl+alt+2 goes to the orchestrator that finished a turn before the last", ORCHESTRATOR, w.current)
    v.keyboard.press("Control+Alt+1")
    settles("ctrl+alt+1 to the one that finished a turn last", SECOND, w.current)
    v.keyboard.press("Control+Alt+j")
    settles("ctrl+alt+j to the next down the rail", ORCHESTRATOR, w.current)
    v.keyboard.press("Control+Alt+k")
    settles("ctrl+alt+k back up to the one before", SECOND, w.current)
    # the board over one of two orchestrators on one tree marks that one's tickets
    v.keyboard.press("Control+Alt+b")
    settles("the board over the second orchestrator marks its tickets, not the first's", ["drop-zone"], w.board_marks)
    v.keyboard.press("Control+Alt+j")
    settles("...and the marks follow you to the other orchestrator", ["map-columns"], w.board_marks)
    v.keyboard.press("Control+Alt+k")
    settles("...and back", ["drop-zone"], w.board_marks)


@scenario
def a_reorder_keeps_focus(w: World) -> None:
    """one-hub-tab#P6: a reorder of the rail never changes which session has the user's focus."""
    v = w.view
    second_id = w.second()
    v.keyboard.press("Control+Alt+1")
    until(lambda: w.current() == SECOND, "SECOND's unit, 1 on the rail")
    w.focus_view(second_id)
    w.registered(ORCHESTRATOR, time.time())  # the other orchestrator finishes a turn
    until(lambda: w.rail() == [ORCHESTRATOR, SECOND], "the rail reordered, the other orchestrator 1")
    w.settle()  # the tab redraws in the same task it takes the new numbers in; trellis moves a frame later
    check("...while the unit you are in stays the one you are in", SECOND, w.current())
    check("...and the page you are on keeps the focus, and the keyboard", (second_id, True), (w.focused(), w.holds_keyboard()))
    check("...the rail's keys naming the new order", ["ctrl+alt+1", "ctrl+alt+2"],
          v.evaluate("[...document.querySelectorAll('#units .cap')].map(e => e.title)"))


@scenario
def set_aside(w: World) -> None:
    """ctrl+alt+d takes the unit you are in out of the numbers, leaving you where you are."""
    v = w.view
    second_id = w.second()
    v.keyboard.press("Control+Alt+1")
    until(lambda: w.current() == SECOND, "SECOND's unit, 1 on the rail")
    w.focus_view(second_id)
    # the tab hears a key in a page once its load has hooked the page, theming it in the same step
    v.wait_for_function(f"!!ws.view({json.dumps(second_id)}).element.querySelector('iframe').contentDocument?.documentElement?.dataset.theme",
                        timeout=10000)
    v.keyboard.press("Control+Alt+d")
    settles("ctrl+alt+d takes the orchestrator you are in out of the numbers", [ORCHESTRATOR], w.rail)
    check("...to the list of those set aside", True, f"session {SECOND[:8]}" in v.inner_text("#aside-units"))
    check("...and leaves you where you are", (SECOND, True), (w.current(), second_id in w.docked()))
    v.keyboard.press("Control+Alt+j")
    settles("ctrl+alt+j from outside the numbers goes to the first in them", ORCHESTRATOR, w.current)
    settles("...the one set aside leaving the layout with you", False, lambda: second_id in w.docked())
    v.keyboard.press("Control+Alt+d")
    settles("...and again in the next", [], w.rail)
    check("...and leaves you in it", ORCHESTRATOR, w.current())
    v.keyboard.press("Control+Alt+d")
    settles("...and again, already set aside, says so", True, lambda: "is set aside already" in w.log())
    check("...changing nothing", [], w.rail())


@scenario
def the_session_id_on_the_rail(w: World) -> None:
    """Its first 8 characters, the whole id on hover, copied by a click, as the short id beside it is; "copied" rises
    over what the click copied."""
    v = w.view
    row = v.locator("#units .unit", has=v.locator(f'button[title="session {ORCHESTRATOR}"]'))
    meta = lambda: row.locator(".meta").evaluate("m => [m.querySelector('.sid').textContent, m.querySelector('.session').textContent, m.querySelector('.session').title]")
    settles("a rail entry shows its session id's first 8 characters once, the whole id on hover, where its short id is those 8",
            ["", ORCHESTRATOR[:8], ORCHESTRATOR], meta)
    w.registered(ORCHESTRATOR, w.t0 - 100, name="map-columns-name")
    settles("...and beside a short id that is a name", ["map-columns-name", ORCHESTRATOR[:8], ORCHESTRATOR], meta)
    clipboard = lambda: v.evaluate("navigator.clipboard.readText()")
    row.locator(".session").click()
    settles("a click on it copies the whole id", ORCHESTRATOR, clipboard)
    settles("...says so over it", "copied", lambda: v.evaluate("document.querySelector('.hub-copied-tip')?.textContent ?? null"))
    check("...and enters no orchestrator", None, w.current())
    row.locator(".sid").click()
    settles("a click on the short id copies it", "map-columns-name", clipboard)
    check("...and enters no orchestrator either", None, w.current())


@scenario
def loose_pages(w: World) -> None:
    """one-hub-tab#P2 for the loose pages. No session page lists them, so a stand-in in the sidebar does."""
    v = w.view
    # The hub tells a tab of a change on disk by comparing the disk with what it read at its last look, so a page opened
    # and deleted between two looks goes unnoticed: the deletion below waits for the look after the opening.
    events = w.listen()
    loose_note = w.home / "notes" / "loose.html"
    loose_note.parent.mkdir(parents=True, exist_ok=True)
    loose_note.write_text("<!doctype html><h1>a loose note</h1>")
    loose_id = f"loose~{w.api('/api/open', {'target': str(loose_note)})['id']}"
    heard = len(events)
    v.locator("#aside-units button.nav[title='pages no session opened']").click()
    settles("the loose pages, entered, have a stand-in for a session page in the sidebar", ["loose", "/pages/loose"],
            lambda: [w.current(), w.sidebar_url()])
    stand_in = w.frame_at("/pages/loose")

    def stand_line():
        try:
            return stand_in.evaluate("""() => { const a = document.querySelector('#artefacts a[data-artefact$="/loose.html"]');
                return a && a.previousElementSibling?.classList.contains('hub-mark') ? a.dataset.hub ?? "" : null }""")
        except PlaywrightError:
            return None
    settles("...listing the unit's page as the column does, marked open", "open", stand_line)
    w.focus_view(loose_id)
    v.keyboard.press("Control+Alt+w")
    settles("...marked minimized once you minimize it", (False, "minimized"), lambda: (loose_id in w.docked(), stand_line()))
    stand_in.click('#artefacts a[data-artefact$="/loose.html"]')
    settles("...and a click on its line brings it back", (True, "open"), lambda: (loose_id in w.docked(), stand_line()))
    until(lambda: any(e["type"] == "disk" for e in events[heard:]), "the hub's look at the disk after the loose page opened")
    loose_note.unlink()
    settles("the unit you are in going away, its one page deleted, puts you in the overview, with no session page",
            (None, False), lambda: (w.current(), w.shown("session-side")))


@scenario
def the_address_of_a_unit(w: World) -> None:
    """The address of the hub tab at a unit, which the Stop hook's line links."""
    w.api("/api/close", {"unit": ORCHESTRATOR, "id": w.mids[ORCHESTRATOR]})
    at_unit = w.context.new_page()
    at_unit.goto(f"{w.origin}/u/{ORCHESTRATOR}#{w.mids['csv-import']}")
    at_unit.wait_for_function("window.wc && ws.views().length > 0", timeout=30000)
    settles("the hub tab opened at a unit and a page is in that unit, on that page", [ORCHESTRATOR, w.ids["csv-import"]],
            lambda: [w.current(at_unit), w.focused(at_unit)])
    check("...its session page in the sidebar, the list of every other", w.session_url(w.pages[0]), w.sidebar_url(at_unit))
    check("...its address back at the hub's root, so a reload stays where you are then", "/", at_unit.evaluate("location.pathname + location.hash"))
    at_unit.close()


@scenario
def the_hub_gone(w: World) -> None:
    """The tab says so with the command that brings it back, and sends what changed meanwhile."""
    v = w.view
    w.enter()
    w.focus("map-columns")
    w.kill_hub()
    settles("a hub tab cut off from the hub says so, with the command that restarts it", " ".join(["setsid", "-f", *w.hub_args]),
            lambda: v.evaluate("document.querySelector('#status code')?.textContent ?? null"))
    v.keyboard.press("Control+Alt+w")
    settles("a key still answers while the hub is down", False, lambda: w.ids["map-columns"] in w.docked())
    w.start_hub()
    settles("the hub tab hears the hub is back", True, lambda: v.evaluate("document.getElementById('status').textContent === 'hub: connected'"), within=20)
    settles("...and the hub gets the close made while it was down", True, lambda: w.member(w.mids["map-columns"])["closed"])


@scenario
def many_units(w: World) -> None:
    """one-hub-tab#P1: many orchestrators' pages open in one tab, and a page opened then still loads."""
    v = w.view
    many = [session_id(n) for n in range(0x10, 0x19)]
    for n, session in enumerate(many):
        w.registered(session, w.t0 - 300 - n)
        w.opened(w.page(f"show/unit-{n}/index.html", f"<h1>unit {n}</h1>"), session)
    settles("ten orchestrators' pages are open in the one tab", 10, lambda: v.evaluate(
        "new Set(ws.views().filter(v => v.placement === 'docked').map(v => v.params.group)).size"), within=30)
    try:
        # whatever connection a page holds open, it opens as it loads
        for n in range(len(many)):
            w.frame_at(f"/unit-{n}/index.html")
        w.opened(w.page("show/unit-0/late.html", "<h1 id=late>late</h1>"), many[0])
        late = w.frame_at("/unit-0/late.html").inner_text("#late")
    except (PlaywrightError, RuntimeError) as e:
        late = f"not loaded: {e}"[:200]
    check("...and a page opened then still loads", "late", late)
    check("...as does a read of the hub", True, v.evaluate(
        "Promise.race([fetch('/api/hub').then(r => r.ok), new Promise(r => setTimeout(() => r(false), 10000))])"))


@scenario
def a_session_page_nobody_opened(w: World) -> None:
    """Entering a unit whose session page nobody opened opens that page, the list of its pages."""
    unit = session_id(0x10)
    w.registered(unit, w.t0 - 300)
    w.opened(w.page("show/unit-0/index.html", "<h1>unit 0</h1>"), unit)
    unopened = w.page(f"sessions/{unit}/index.html", "<h1>unit 0's session</h1>")
    os.utime(unopened, (w.t0 - 300, w.t0 - 300))  # its last turn, as registered
    w.view.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(unit)})?.session_page?.url.startsWith('/f/')", timeout=10000)
    w.view.locator(f'#units button[title="session {unit}"]').click()
    settles("entering a unit whose session page nobody opened shows it in the sidebar", w.session_url(unopened), w.sidebar_url)


# ---- the input box under a unit's session page, which types into the session's tmux pane

@scenario
def the_input_box_says_what_the_session_does(w: World) -> None:
    p = w.pane()
    check("a unit whose session runs in a tmux pane has an input box under its session page, its session idle",
          ["waiting", "idle"], p.says())
    check("...its tooltip naming the tmux session enter types into", "enter types into tmux session answering",
          w.view.evaluate(f"{BOX}.querySelector('.how').title"))
    if READER:  # hub-rail-marks-sessions-needing-you D5: it waits on you only where it needs you
        asked = w.agent / f"sessions/{ANSWERING}/turns/01.md"
        asked.parent.mkdir()
        asked.write_text(QUESTION.format(title="One call"))
        settles("...which says it waits on you while its page has an open question",
                ["waiting", "waiting on you"], p.says)
        asked.unlink()
        settles("...and idle again once it has none", ["waiting", "idle"], p.says)
        number_of = lambda: w.view.evaluate(f"(u => [u.number, u.needs_you])(wc.state.units.find(u => u.unit === {json.dumps(ANSWERING)}))")
        was = number_of()[0]
        with w.view.expect_request(lambda r: r.url.endswith("/api/visit"), timeout=30000):
            asked.write_text("---\ndate: 2026-10-07\n---\n\n# A record, no question\n")
        w.written()
        settles("a turn record landing in the unit you are in keeps its number, it being seen as it lands", [was, None], number_of)
        asked.unlink()
    p.in_pane("waiting", waitingFor="permission prompt")
    settles("a session blocked in its terminal: the box says so, on what, and where to go", [
        "blocked", "blocked in its terminal (permission prompt). Answer it in tmux session answering; nothing is sent from here meanwhile."],
        p.says)
    p.focus()
    w.view.keyboard.type("then ")
    w.view.keyboard.press("Enter")  # the box decides in the key's own handler whether to send
    check("...and sends it nothing, keeping the text", (0, b"", "then "), (w.posted("type"), p.arrived(), p.text()))
    p.in_no_pane()
    settles("a session with no tmux pane in the registry: no box, and the unit says why",
            ["none", "No input box. The session runs in no tmux pane, so the hub has nowhere to type; answer it in its terminal."],
            p.says)
    check("...the box's text area hidden", False, w.view.evaluate(f"{BOX}.querySelector('textarea').checkVisibility()"))


@scenario
def typing_into_the_pane(w: World) -> None:
    v = w.view
    p = w.pane()
    p.focus()
    v.keyboard.type("go on")
    v.keyboard.press("Shift+Enter")
    v.keyboard.type("but leave the tests")
    check("shift+enter is a new line in the box, sending nothing", ("go on\nbut leave the tests", 0), (p.text(), w.posted("type")))
    check("the box's unsent text survives a reload", "go on\nbut leave the tests", p.after_reload())
    v.evaluate(f"{BOX}.querySelector('textarea').dispatchEvent(new KeyboardEvent('keydown', {{ key: 'Enter', bubbles: true, cancelable: true }}))")
    # dispatchEvent returns once the box's handler has run, and a send starts in it
    check("an Enter a page made up sends nothing", ("go on\nbut leave the tests", 0), (p.text(), w.posted("type")))
    # what the box sent, shown on the session page until a render of the page shows it
    sidebar_doc = f"{SIDEBAR_PAGE}?.contentDocument"
    pending = lambda page=v: page.evaluate(f"""(d => d && [d.querySelector('h1')?.textContent,
        d.querySelector('#hub-sent .state')?.textContent ?? null, [...d.querySelectorAll('#hub-sent .msg')].map(m => m.innerHTML)])({sidebar_doc})""")
    pending_key = lambda: v.evaluate(f"localStorage.getItem({json.dumps('hub:sent:' + ANSWERING)})")
    older = "go on<br>but leave the tests"  # the words about to be sent, as the page shows them
    p.rendered("render 1", older)
    settles("a render of the session page shows in its sidebar", ["render 1", None, []], pending)
    p.focus()
    v.keyboard.press("Enter")
    settles("enter types the box's text into the session's pane, a paste and then Enter",
            b"\x1b[200~go on\rbut leave the tests\x1b[201~\r", p.arrived)
    settles("...and empties the box", "", p.text)
    sent_row = ["<p>go on<br>but leave the tests</p>"]
    settles("...and shows what it sent at the top of the session page's turns, open, its line breaks kept, the session idle",
            ["render 1", "not taken up yet", sent_row], pending)
    p.in_pane("busy")
    settles("...saying the session works on it once it does", ["render 1", "working on it", sent_row], pending)
    p.rendered("render 2", older)
    settles("...where a render showing only an older message of the same words keeps it", ["render 2", "working on it", sent_row], pending)
    fresh = w.fresh_tab(f"(() => {{ try {{ return !!{sidebar_doc}.getElementById('hub-sent'); }} catch {{ return false; }} }})()")
    check("...as does a hub tab opened afresh", ["render 2", "working on it", sent_row], pending(fresh))
    fresh.close()
    p.rendered("render 3", older, older)
    settles("...and drops it once a render of the page shows it", (["render 3", None, []], None), lambda: (pending(), pending_key()))
    p.in_pane()
    check("...which a reload finds empty", "", p.after_reload())
    p.focus()
    v.keyboard.press("Control+z")
    check("...which ctrl+z undoes, the browser's own editing having emptied it", "go on\nbut leave the tests", p.text())
    v.keyboard.press("Control+a")
    v.keyboard.type("then ")
    check("select-all selects the box's text", "then ", p.text())
    check("...and a reload finds what was typed last", "then ", p.after_reload())


@scenario
def a_sent_message_the_page_shows_otherwise(w: World) -> None:
    """What the box sent leaves the top of the session page once the page shows it as Claude Code kept it, a dropped
    file's path as the image it attached, or once the page shows a turn that ended after it was sent."""
    p = w.pane()
    drop = w.home / ".cache/container-hub/drops" / ANSWERING / "20261014-171130-image.png"
    sent = lambda text, at: w.view.evaluate(
        f"localStorage.setItem({json.dumps('hub:sent:' + ANSWERING)}, JSON.stringify([{{ text: {json.dumps(text)}, at: {at}, seen: 0 }}]))")
    held = lambda: w.frame_at(f"/{ANSWERING}/index.html").evaluate("!!document.getElementById('hub-sent')")
    sent(f"{drop}\n\nis this a bug", 1)
    p.rendered("render 1")
    settles("a message sent with a dropped file's path shows at the top of the page", True, held)
    p.rendered("render 2", "<span>[Image #1]</span><br><br>is this a bug")
    settles("...and leaves once the page shows it with the image in the path's place", False, held)
    at = int(time.time() * 1000)
    sent("fix it", at)
    p.rendered("render 3", ended=datetime.fromtimestamp(at / 1000 - 60).astimezone().isoformat())
    settles("a message sent after the page's newest turn ended shows at the top of the page", True, held)
    p.rendered("render 4", ended=datetime.fromtimestamp(at / 1000 + 60).astimezone().isoformat())
    settles("...and leaves once the page shows a turn that ended after it was sent, whatever it shows of its words", False, held)


@scenario
def the_session_pages_bar_holds_its_tools(w: World) -> None:
    """The session sidebar's zoom and the session's context use sit in its session page's bar, at their size whatever
    the zoom, and the row over the sidebar goes."""
    p = w.pane()
    w.statusline(ANSWERING, w.home / ".claude", context_window={"used_percentage": 42.5, "total_input_tokens": 85000})
    w.page(f"sessions/{ANSWERING}/index.html",
           "<header class='bar'><span class='where'>alpha</span></header><h1>with a bar</h1><section class='turns'></section>")
    w.opened(p.session_page, ANSWERING)
    frame = lambda: w.frame_at(f"/{ANSWERING}/index.html")
    tools = lambda: frame().evaluate("""(t => t && [t.querySelector('.ctx').textContent, t.querySelector('.zoom .pct').textContent,
        t.style.zoom])(document.querySelector('.bar > .where + #hub-tools'))""")
    settles("the session page's bar holds the session's context use and the sidebar's zoom", ["ctx42%", "100%", "1"], tools)
    check("...and the row over the sidebar goes", False, w.view.evaluate("document.querySelector('#session > .head').checkVisibility()"))
    frame().click("#hub-tools .zoom .in")
    settles("+ in the bar zooms the session sidebar, the tools staying their size", ("1.1", ["ctx42%", "110%", "0.909091"]),
            lambda: (w.view.evaluate("localStorage.getItem('wc:side:session:zoom')"), tools()))


@scenario
def files_into_the_box(w: World) -> None:
    """A file pasted, and one dropped: each saved by the hub, its path typed where the cursor is."""
    p = w.pane()
    p.focus()
    w.view.keyboard.type("then ")
    w.view.evaluate(f"""(() => {{
        const area = {BOX}.querySelector('textarea'), dt = new DataTransfer();
        dt.items.add(new File([new Uint8Array([137, 80, 78, 71])], 'image.png', {{ type: 'image/png' }}));
        area.dispatchEvent(new ClipboardEvent('paste', {{ clipboardData: dt, bubbles: true, cancelable: true }}));
    }})()""")
    drops = w.home / ".cache/container-hub/drops" / ANSWERING
    pasted = lambda: re.fullmatch(rf"then ({re.escape(str(drops))}/\S+-image\.png)", p.text())
    settles("a pasted screenshot goes in as its path, at the cursor", True, lambda: bool(pasted()))
    check("...the file saved there with what was pasted", b"\x89PNG", Path(pasted()[1]).read_bytes() if pasted() else None)
    w.view.evaluate(f"""(() => {{
        const area = {BOX}.querySelector('textarea'), dt = new DataTransfer();
        area.setSelectionRange(5, 5);
        dt.items.add(new File(['notes'], 'my notes.txt', {{ type: 'text/plain' }}));
        area.dispatchEvent(new DragEvent('drop', {{ dataTransfer: dt, bubbles: true, cancelable: true }}));
    }})()""")
    settles("a dropped file goes in as its path at the cursor, set apart from the words around it", True,
            lambda: bool(re.fullmatch(rf"then {re.escape(str(drops))}/\S+-my-notes\.txt {re.escape(str(drops))}/\S+-image\.png", p.text())))
    picked = w.scratch / "from the phone.jpg"
    picked.write_bytes(b"\xff\xd8\xff")
    w.view.evaluate(f"(a => a.setSelectionRange(a.value.length, a.value.length))({BOX}.querySelector('textarea'))")
    with w.view.expect_file_chooser() as chooser:
        w.view.evaluate(f"{BOX}.querySelector('.acts .attach').click()")
    chooser.value.set_files(picked)
    settles("a file picked with \"attach file\", as a phone attaches one, goes in as its path too", True,
            lambda: bool(re.search(rf"\.png {re.escape(str(drops))}/\S+-from-the-phone\.jpg$", p.text())))


@scenario
def a_long_message_sent(w: World) -> None:
    p = w.pane()
    long = "\n\n".join(f"paragraph {i} of a long message" for i in range(30))
    w.view.evaluate(f"localStorage.setItem({json.dumps('hub:sent:' + ANSWERING)}, JSON.stringify([{{ text: {json.dumps(long)}, at: 1, seen: 0 }}]))")
    p.rendered("render 4")
    folded = lambda: w.frame_at(f"/{ANSWERING}/index.html").evaluate(
        "[document.querySelector('#hub-sent .said-text')?.classList.contains('clamped'), document.querySelector('#hub-sent .more')?.textContent]")
    settles("a long message sent is shown folded to its first lines, with what unfolds it", [True, "show all · 180 words"], folded)
    w.frame_at(f"/{ANSWERING}/index.html").click("#hub-sent .more")
    check("...which a click unfolds", [False, "show less"], folded())


@scenario
def the_box_folded_and_zoomed(w: World) -> None:
    v = w.view
    w.pane()
    check("the token that lets the tab type is out of its document before any page is framed", None,
          v.evaluate("document.querySelector('meta[name=\"hub-token\"]')"))
    v.keyboard.press("Control+Alt+s")
    settles("ctrl+alt+s folds the session page's sidebar away", False, lambda: w.shown("session-side"))
    v.keyboard.press("Control+Alt+r")
    settles("ctrl+alt+r unfolds it, and puts the keyboard in the box", [True, True], lambda: [
        w.shown("session-side"), v.evaluate(f"document.activeElement === {BOX}.querySelector('textarea')")])
    box_zoom = lambda: v.evaluate("[localStorage.getItem('wc:side:session:zoom'), getComputedStyle(document.getElementById('session-box')).zoom]")
    v.keyboard.press("Control+Alt+Equal")
    settles("ctrl+alt++ in the box zooms the session sidebar", ["1.1", "1.1"], box_zoom)
    v.keyboard.press("Control+Alt+Shift+Digit3")  # # on a US layout
    settles("...and ctrl+alt+# puts it back", [None, "1"], box_zoom)


@scenario
def the_questions_folded_from_the_box(w: World) -> None:
    """ctrl+alt+q folds and shows the session page's questions by the page's own fold button, the keyboard staying in
    the box."""
    p = w.pane()
    # the band and button the session page renders, folding as page.js folds them
    w.page(f"sessions/{ANSWERING}/index.html", "<section id='open-questions'><button id='fold-band'"
           " onclick=\"document.getElementById('open-questions').classList.toggle('collapsed')\">fold</button></section>")
    w.opened(p.session_page, ANSWERING)
    folded = lambda: w.frame_at(f"/{ANSWERING}/index.html").evaluate(
        "document.getElementById('open-questions')?.classList.contains('collapsed') ?? null")
    settles("the session page shows its questions", False, folded)
    p.focus()
    in_box = lambda: w.view.evaluate(f"document.activeElement === {BOX}.querySelector('textarea')")
    w.view.keyboard.press("Control+Alt+q")
    settles("ctrl+alt+q in the box folds the session page's questions", True, folded)
    check("...the keyboard staying in the box", True, in_box())
    w.view.keyboard.press("Control+Alt+q")
    settles("...and again shows them", False, folded)
    w.view.keyboard.press("Control+Alt+q")
    w.view.keyboard.press("Control+Alt+s")
    settles("with the questions folded and the sidebar folded away", [True, False], lambda: [folded(), w.shown("session-side")])
    w.view.keyboard.press("Control+Alt+q")
    settles("...ctrl+alt+q brings the sidebar back with the questions shown", [False, True], lambda: [folded(), w.shown("session-side")])


@scenario
def the_newest_turn_from_the_box(w: World) -> None:
    """ctrl+alt+n goes to the session page's newest turn by the page's own control, the keyboard staying in the box;
    from inside the session page, the keyboard goes to the turn, as the page's own n takes it."""
    p = w.pane()
    # the control the session page renders, focusing the newest turn as page.js does
    w.page(f"sessions/{ANSWERING}/index.html", "<button data-newest onclick=\"window.went = (window.went ?? 0) + 1;"
           " document.querySelector('#t02 summary').focus()\">newest</button><details id='t02'><summary>02</summary></details>")
    w.opened(p.session_page, ANSWERING)
    page = lambda: w.frame_at(f"/{ANSWERING}/index.html")
    went = lambda: page().evaluate("window.went ?? 0")
    in_box = lambda: w.view.evaluate(f"document.activeElement === {BOX}.querySelector('textarea')")
    settles("the session page shows its newest control", True, lambda: page().evaluate("!!document.querySelector('[data-newest]')"))
    p.focus()
    w.view.keyboard.press("Control+Alt+n")
    settles("ctrl+alt+n in the box goes to the session page's newest turn", 1, went)
    check("...the keyboard staying in the box", True, in_box())
    w.view.keyboard.press("Control+Alt+s")
    settles("with the sidebar folded away", False, lambda: w.shown("session-side"))
    w.view.keyboard.press("Control+Alt+n")
    settles("...ctrl+alt+n brings it back at the newest turn", [2, True], lambda: [went(), w.shown("session-side")])
    w.focus_session()
    w.view.keyboard.press("Control+Alt+n")
    settles("from inside the session page, the keyboard goes to the turn", [3, "02"],
            lambda: [went(), page().evaluate("document.activeElement.textContent")])


@scenario
def the_box_resized(w: World) -> None:
    v = w.view
    w.pane()
    height = lambda: v.evaluate(f"{BOX}.querySelector('textarea').getBoundingClientRect().height")
    near = lambda want: lambda: abs(height() - want) <= 1

    def drag(dy: float) -> None:
        grip = v.locator("#box-grip").bounding_box()
        x, y = grip["x"] + grip["width"] / 2, grip["y"] + grip["height"] / 2
        v.mouse.move(x, y)
        v.mouse.down()
        v.mouse.move(x, y + dy, steps=5)
        v.mouse.up()

    natural = height()
    drag(-100)
    settles("a drag up on the box's top edge makes it taller by as much", True, near(natural + 100))
    fresh = w.fresh_tab(f"(() => {{ try {{ return !!{BOX}.querySelector('textarea'); }} catch {{ return false; }} }})()")
    check("...and a tab opened afresh has it as tall", True,
          abs(fresh.evaluate(f"{BOX}.querySelector('textarea').getBoundingClientRect().height") - natural - 100) <= 1)
    fresh.close()
    drag(60)
    settles("a drag down makes it shorter", True, near(natural + 40))
    v.locator("#box-grip").dblclick()
    settles("a double-click on the edge fits it to its text again", [True, None],
            lambda: [near(natural)(), v.evaluate("localStorage.getItem('wc:box:height')")])
    v.evaluate(f"{BOX}.querySelector('textarea').focus()")
    v.keyboard.press("Control+Alt+Equal")
    v.keyboard.press("Control+Alt+Equal")
    settles("the session sidebar zoomed to 125%", "1.25", lambda: v.evaluate("localStorage.getItem('wc:side:session:zoom')"))
    zoomed = height()
    drag(-100)
    settles("...a drag takes the box as far as the pointer went", True, near(zoomed + 100))

@scenario
def jump_and_close_panes(w: World) -> None:
    """Jump and close over the box. The session runs in a second pane too, and a bystander session keeps the tmux
    server up once both are closed."""
    v = w.view
    p = w.pane()
    acts = lambda: v.evaluate(f"(a => a.checkVisibility() ? [...a.querySelectorAll('button:not(.attach)')].map(b => b.textContent) : null)({BOX}.querySelector('.acts'))")
    p.in_no_pane()
    settles("a unit whose session runs in no tmux pane has no jump or close over its box", ("none", None), lambda: (p.says()[0], acts()))
    w.tmux("new-session", "-d", "-s", "bystander", "sleep 600")
    w.tmux("new-window", "-d", "-t", "answering:", "sleep 600")
    second, second_pid = w.tmux("display-message", "-p", "-t", "answering:1", "#{pane_id} #{pane_pid}").split()
    all_panes = lambda: sorted(w.tmux("list-panes", "-a", "-F", "#{pane_id}").split())
    before = all_panes()
    p.in_pane()
    settles("a unit whose session runs in a tmux pane has jump and close over its box", ["jump to panectrl+alt+g", "close panectrl+alt+x"], acts)
    second_started = started(second_pid)

    def both(status: str = "idle") -> None:
        """The unit's state is read from either of its session's processes, so both change together."""
        p.in_pane(status)
        w.registered(ANSWERING, w.t0 - 301, status, pid=int(second_pid), started=second_started, file="second", tmux=f"answering:@1.{second}")

    both()
    settles("...and says how many panes where it runs in more than one", ["jump to pane · 2 panesctrl+alt+g", "close 2 panesctrl+alt+x"], acts)
    act = lambda n: v.locator(f"#session-box .reply .acts button:not(.attach) >> nth={n}").click()
    act(0)
    settles("a jump with no tmux client attached goes nowhere, the unit saying why", "not gone to: no tmux client is attached to go to it in", p.how)
    both("busy")
    v.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(ANSWERING)}).state === 'busy'", timeout=10000)
    act(1)
    settles("a close of a session at work is refused at once, the unit saying why, nothing to confirm",
            ["not closed: the session is at work; close it once it is idle", "close 2 panesctrl+alt+x"], lambda: [p.how(), acts()[1]])
    check("...and kills no pane", before, all_panes())
    both()
    v.wait_for_function(f"wc.state.units.find(u => u.unit === {json.dumps(ANSWERING)}).state === 'idle'", timeout=10000)
    act(1)
    check("a first click on close asks to be confirmed, in place", "close all 2 panes, shell and all? again to confirm", acts()[1].removesuffix("ctrl+alt+x"))
    check("...and kills nothing, asking the hub nothing", (0, before), (w.posted("close-panes"), all_panes()))
    settles("...until it lapses, a few seconds on", "close 2 panesctrl+alt+x", lambda: acts()[1], within=8)
    v.locator(f'#units button[title="session {ORCHESTRATOR}"]').click()
    until(lambda: w.current() == ORCHESTRATOR, "the orchestrator's unit")
    row = v.locator(".unit", has=v.locator(f'button[title="session {ANSWERING}"]'))
    row.hover()  # the ✕ shows under the pointer
    row.locator(".close").click()
    settles("the ✕ on its row on the rail goes into its unit, and asks the same", (ANSWERING, True),
            lambda: (w.current(), (acts() or ["", ""])[1].startswith("close all 2 panes")))
    check("...asking the hub nothing", (0, before), (w.posted("close-panes"), all_panes()))
    settles("...until it lapses too", "close 2 panesctrl+alt+x", lambda: acts()[1], within=8)
    v.keyboard.press("Control+Alt+x")
    settles("ctrl+alt+x asks the same", True, lambda: acts()[1].startswith("close all 2 panes"))
    check("...asking the hub nothing", (0, before), (w.posted("close-panes"), all_panes()))
    v.keyboard.press("Control+Alt+x")
    settles("...and confirmed by a second, every pane the session runs in is closed, and no other",
            sorted(set(before) - {p.id, second}), all_panes)
    settles("...after which its unit is an ended one, with nothing over its box", ("ended", None),
            lambda: (v.evaluate(f"wc.state.units.find(u => u.unit === {json.dumps(ANSWERING)}).state"), acts()))


@scenario
def usage_and_context(w: World) -> None:
    """hub-ui-nits 2: the statusline's numbers, from what the statusline keeps of each session's last render."""
    v = w.view
    t = time.time()
    w.statusline(ORCHESTRATOR, w.home / ".claude", context_window={"used_percentage": 42.5, "total_input_tokens": 85000},
                 rate_limits={"five_hour": {"used_percentage": 31, "resets_at": t + 3700},
                              "seven_day": {"used_percentage": 90, "resets_at": t + 6 * 86400 + 3700}})
    w.statusline("99999999-0000-4000-8000-00000000000f", w.home / ".claude-work",
                 rate_limits={"five_hour": {"used_percentage": 70, "resets_at": t - 60},
                              "seven_day": {"used_percentage": 50, "resets_at": None}})
    w.second()  # running, with no statusline file
    usage_lines = lambda: v.evaluate("""[...document.querySelectorAll('#usage > *')].map(e => [e.textContent, e.dataset.tone ?? '',
        e.querySelector('.fill')?.style.width ?? '', e.querySelector('.tick')?.style.left.split('.')[0] ?? ''])""")
    settles("the rail's top shows each account's 5h and weekly usage, under the windows' names: a meter in the tone of its "
            "pace, a tick at the share of the window gone, the time to its reset", [
        ["", "", "", ""], ["5h", "", "", ""], ["week", "", "", ""],
        ["claude", "", "", ""], ["31%1h", "ok", "31%", "79"], ["90%6d", "over", "90%", "13"],
        ["work", "", "", ""], ["0%fresh", "ok", "0%", ""], ["50%", "ok", "50%", ""]], usage_lines)  # no reset time: no pace to fall behind
    context_line = lambda key: v.evaluate(
        f"(e => e && [e.textContent, e.dataset.tone, e.title])(document.querySelector('#units button[title=\"session {key}\"] .ctx'))")
    settles("a running session's rail entry shows its context use", ["42%", "ok", "context 42% used, 85k tokens"], lambda: context_line(ORCHESTRATOR))
    check("...and one with no statusline file shows none", True, v.evaluate(
        f"(b => !!b && !b.querySelector('.ctx'))(document.querySelector('#units button[title=\"session {SECOND}\"]'))"))


@scenario
def an_account_hidden(w: World) -> None:
    """hub-layout-pass 5: an account hidden or shown by its name, kept per browser profile."""
    v = w.view
    work = "77777777-0000-4000-8000-000000000077"  # an orchestrator under another account
    w.registered(work, w.t0 - 307, account=".claude-work")
    w.opened(w.page("show/unit-7/index.html", "<h1>unit 7</h1>"), work)
    w.statusline(work, w.home / ".claude-work", rate_limits={"five_hour": {"used_percentage": 10, "resets_at": time.time() + 3700}})
    settles("an orchestrator under another account is on the rail", True, lambda: work in w.rail_units())
    ended_other = "f7f7f7f7-0000-4000-8000-0000000000f7"  # a session of that account that ended, by its transcript
    (w.home / ".claude-work/projects/-home-repos-alpha").mkdir(parents=True, exist_ok=True)
    (w.home / ".claude-work/projects/-home-repos-alpha" / f"{ended_other}.jsonl").write_text("")
    w.opened(w.page("notes/ended-other.html", "an ended session's page"), ended_other)
    settles("...and one of its that ended in the ended list", True,
            lambda: ended_other in v.evaluate("[...document.querySelectorAll('#aside-units .nav')].map(b => b.title.replace('session ', ''))"))
    numbers_before = v.evaluate("wc.state.units.filter(u => u.number).length")
    work_name = lambda page=v: page.locator('#usage button.account:text-is("work")')
    shown = lambda page=v: work_name(page).get_attribute("aria-pressed")
    check("an account's name is a toggle, pressed while its orchestrators are shown", "true", shown())
    work_name().click()
    settles("a click on its name takes its orchestrators off the rail, the ended one off the ended list", (False, False),
            lambda: (work in w.rail_units(), ended_other in w.rail_units()))
    check("...its name no longer pressed", "false", shown())
    check("...out of the numbers", (numbers_before - 1, False), (v.evaluate("wc.state.units.filter(u => u.number).length"),
          v.evaluate(f"wc.state.units.some(u => u.unit === {json.dumps(work)})")))
    check("...and out of the layout, the overview's too", False, v.evaluate(f"ws.views().some(v => v.params.group === {json.dumps(work)})"))
    v.keyboard.press("Control+Alt+f")
    v.keyboard.type(work[:8])
    settles("...and out of the search", "no session matches",
            lambda: v.evaluate("document.querySelector('#units .found-none')?.textContent ?? null"))
    v.keyboard.press("Escape")
    check("...the others staying", True, ORCHESTRATOR in w.rail_units())
    rail_up = "window.wc && document.querySelectorAll('#units .nav').length > 0"
    reopened = w.fresh_tab(rail_up)
    check("the account stays hidden in the same browser profile", (False, "false"), (work in w.rail_units(reopened), shown(reopened)))
    reopened.close()
    other_profile = w.context.browser.new_context(viewport=VIEWPORT)
    check("...and another profile keeps its own choice", True, work in w.rail_units(w.fresh_tab(rail_up, other_profile)))
    other_profile.close()
    later = w.hears(lambda: w.api("/api/open", {"target": str(w.page("show/unit-7/later.html", "<h1>later</h1>")), "session": work}))
    check("a page an agent of a hidden account opens goes to its unit, nothing of it to this tab, and the hub, "
          "heard by this tab, has claude-browser open no browser tab for it", (True, False, None),
          (any(m["url"].endswith("/later.html") for m in w.hub_view(work)["members"]),
           v.evaluate("ws.views().some(v => v.params.url.endsWith('/later.html'))"), later["open"]))
    w.hears(lambda: w.api("/api/open", {"target": str(w.agent / "board.html"), "session": work}))
    check("...nor does a board it hands the hub open over this tab", False, v.evaluate("ws.views().some(v => v.params.kind === 'board')"))
    work_name().focus()
    v.keyboard.press("Enter")
    settles("Enter on its name, which has the keyboard, brings it back, the name pressed again", (True, "true"),
            lambda: (work in w.rail_units(), shown()))
    v.keyboard.press("Space")
    settles("...Space hides it again", False, lambda: work in w.rail_units())


@scenario
def continuing_from_a_handoff(w: World) -> None:
    """hub-continues-a-session-from-its-handoff: the box offers to write, update or hand off from the session's handoff."""
    if not READER:
        skipped("continuing from a handoff", "no mx plugin here, whose session page reader the hub reads a handoff's session by")
        return
    v = w.view
    p = w.pane()
    handoff = w.agent / "handoffs" / "2026-10-07-unit-1.md"
    handoff_url = "/f" + urllib.parse.quote(str(handoff.resolve()))
    offer = f"{BOX}.querySelector('.handoff')"
    offers = lambda: v.evaluate(f"(o => o.checkVisibility() ? [o.textContent, o.querySelector('a')?.getAttribute('href') ?? null] : null)({offer})")
    mark = lambda: v.evaluate(f"""(m => m && [m.hasAttribute('data-handoff'), m.hasAttribute('data-needs'), m.title.endsWith('ready to hand off')])
        (document.querySelector('#units button[title="session {ANSWERING}"] .mark'))""")

    def commit_handoff(at: int, text: str) -> None:
        """The session writes its handoff and commits it at `at`."""
        handoff.parent.mkdir(exist_ok=True)
        handoff.write_text(f"---\nsession: {ANSWERING}\npurpose: continuation\n---\n\n{text}")
        w.git(w.agent, "add", "handoffs")
        w.git(w.agent, "commit", "-q", "-m", "handoff", at=at)

    p.in_pane(cwd=str(w.code))
    settles("the box of a session idle in its pane, with no handoff, offers to write one",
            ["no handoff yetwrite handoff", None], offers)
    p.received.write_bytes(b"")
    v.locator("#session-box .reply .handoff button").click()
    settles("a click types one request for the handoff skill into the pane, and says "
            "to read what it writes", [True, True], lambda: [p.arrived().startswith(b"\x1b[200~/mx:handoff ") and p.arrived().count(b"\r") == 1,
                                                             "read it before you hand off" in p.how()])
    h0 = int(time.time())
    commit_handoff(h0, "# Unit 1, handed on\n")
    settles("once the session committed it, the box offers to hand off from it, "
            "with a link to it", [f"handoff {handoff.name}hand off", handoff_url], offers)
    settles("the rail marks the session ready to hand off, its tooltip saying so",
            [True, False, True], mark)
    question = w.agent / f"sessions/{ANSWERING}/turns/02.md"
    question.parent.mkdir(parents=True, exist_ok=True)
    question.write_text(QUESTION.format(title="One call"))
    settles("...and where it needs you too, marks both", [True, True, True], mark)
    question.unlink()
    transcript = w.home / ".claude/projects/-alpha" / f"{ANSWERING}.jsonl"
    transcript.parent.mkdir(parents=True, exist_ok=True)
    transcript.write_text(json.dumps({"type": "user", "message": {"role": "user", "content": "keep going"}, "origin": {"kind": "human"},
                                      "promptSource": "typed", "timestamp": time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(h0 + 5))},
                                     separators=(",", ":")) + "\n")
    settles("a prompt sent after it puts it behind: the box still offers to hand off from it, and to update it",
            [f"handoff {handoff.name}, written before your last messagehand offupdate handoff", handoff_url], offers)
    settles("...and the rail no longer marks the session ready", False, lambda: mark()[0])
    p.received.write_bytes(b"")
    v.locator("#session-box .reply .handoff button.behind").click()
    settles("...a click on hand off asks to be confirmed, typing nothing", ["hand off anyway? again to confirm", b""],
            lambda: [v.locator("#session-box .reply .handoff button.behind").text_content(), p.arrived()])
    commit_handoff(h0 + 10, "# Unit 1, handed on, updated\n")
    settles("...until the session commits it again", f"handoff {handoff.name}hand off", lambda: (offers() or [None])[0])
    v.locator("#session-box .reply .handoff a").click()
    settles("...and its link opens the handoff in the unit, to be read before the click", True,
            lambda: v.evaluate(f"ws.views().some(v => v.params.url === {json.dumps(handoff_url)} && v.params.group === {json.dumps(ANSWERING)})"))

    def cleared_into(session: str, status: str = "idle", **extra) -> None:
        """Click the control, and once its /clear reaches the pane, do what Claude Code does: name the session it
        started in the registry file of the same process."""
        p.received.write_bytes(b"")
        v.locator("#session-box .reply .handoff button").click()
        until(lambda: b"/clear" in p.arrived(), "the /clear in the pane", within=10)
        w.registered(session, w.t0 - 301, status, pid=p.pid, started=p.started, tmux=p.target, cwd=str(w.code), **extra)
        (w.home / ".claude/sessions" / f"{ANSWERING[:8]}.json").unlink()

    stalled = session_id(0x21)
    cleared_into(stalled, "waiting", waitingFor="permission prompt")
    settles("a refusal after the /clear started a session takes the tab to that "
            "session's unit, its box saying why", [stalled, True],
            lambda: [w.current(), (lambda how: how.startswith("not handed off:") and "permission prompt" in how)(
                v.evaluate(f"{BOX}?.querySelector('.how').textContent ?? ''"))], within=20)
    check("...having typed the /clear alone", b"\x1b[200~/clear\x1b[201~\r", p.arrived())
    (w.home / ".claude/sessions" / f"{stalled[:8]}.json").unlink()
    p.in_pane(cwd=str(w.code))
    # the stalled session ended, its unit with it, and the one it came from runs again
    v.wait_for_function(f"!wc.state.units.some(u => u.unit === {json.dumps(stalled)}) && "
                        f"wc.state.units.find(u => u.unit === {json.dumps(ANSWERING)})?.state === 'idle'", timeout=20000)
    v.locator(f'#units button[title="session {ANSWERING}"] .name').click()  # its middle may be the id, which copies
    settles("back in the session the refusal left", [ANSWERING, True],
            lambda: [w.current(), v.evaluate(f"{offer}?.checkVisibility() ?? false")])
    handed_to = session_id(0x20)
    cleared_into(handed_to)
    settles("a click takes the tab to the new session's unit, its stand-in in the sidebar "
            "and its input box live", [handed_to, f"/pages/{handed_to}", "waiting", True],
            lambda: [w.current(), w.sidebar_url(), v.evaluate(f"{BOX}?.dataset.state"),
                     v.evaluate(f"document.activeElement === {BOX}?.querySelector('textarea')")], within=20)
    check("...having typed /clear, then the line that picks up the handoff by its path", True,
          p.arrived().startswith(b"\x1b[200~/clear\x1b[201~\r\x1b[200~Continue from " + str(handoff.resolve()).encode() + b": "))


# ---- pages on another origin, and links

@scenario
def pages_on_another_origin(w: World) -> None:
    """Framed in the left pane where they allow it, listed and opened as a tab on a click where they refuse."""
    v = w.view
    w.enter()
    w.minimize(w.ids["map-columns"])
    framed_at = lambda url: v.evaluate(f"ws.views().find(v => v.params.url === {json.dumps(url)})?.panelId ?? null")
    with elsewhere() as (app, _):
        w.opened(f"{app}/deny")
        settles("a page an agent opens that refuses framing is listed at the column's end, marked as one that opens as a tab",
                ["tab", "↗"], lambda: w.line(f"{app}/deny"))
        check("...and is in no panel", None, framed_at(f"{app}/deny"))
        with w.context.expect_page(timeout=30000) as tab:
            v.keyboard.press("Control+Alt+Shift+W")
        check("...until ctrl+alt+shift+w opens it as a browser tab, it being the page minimized last", f"{app}/deny", tab.value.url)
        tab.value.close()
        v.bring_to_front()  # back from the tab the key opened, as a person would be before the next key
        tabs = len(w.context.pages)
        v.keyboard.press("Control+Alt+Shift+W")
        settles("...and the key again brings back the page minimized before it, in its pane, and no second tab", (True, tabs),
                lambda: (w.ids["map-columns"] in w.docked(), len(w.context.pages)))
        with w.context.expect_page(timeout=30000) as tab:
            w.frame_of(ORCHESTRATOR).click(w.line_link("/deny"))
        check("...as does a click on its line", f"{app}/deny", tab.value.url)
        tab.value.close()
        v.bring_to_front()
        w.opened(f"{app}/app")
        settles("a local server that allows framing opens in the left pane of the opening session's unit", LEFT, lambda: framed_at(f"{app}/app"))
        settles("...showing the page", True, lambda: any(f.url == f"{app}/app" for f in v.frames))

        def clicked(href: str) -> None:
            """A link in the session page, clicked as a person would."""
            w.focus_session()
            w.frame_of(ORCHESTRATOR).evaluate(
                "href => { const a = Object.assign(document.createElement('a'), { id: 'added', href, textContent: 'added' });"
                " document.getElementById('added')?.remove(); document.body.prepend(a); }", href)
            w.frame_of(ORCHESTRATOR).click("#added")

        with w.context.expect_page(timeout=30000) as tab:
            clicked(f"{app}/self")
        check("a plain click on a link to a page that refuses framing opens a browser tab", f"{app}/self", tab.value.url)
        tab.value.close()
        check("...and no panel", None, framed_at(f"{app}/self"))
        clicked(f"{app}/app2")
        settles("a plain click on a link to one that allows it opens it in the unit's left pane", LEFT, lambda: framed_at(f"{app}/app2"))


@scenario
def links_before_a_page_loads(w: World) -> None:
    """A link clicked before its page has loaded, the page's image still on its way, and one in a page framed inside it."""
    v = w.view
    w.enter()
    with elsewhere() as (app, held):
        w.page("show/map-columns/inner.html", f'<a id="nested" href="{app}/self">self</a>')
        early = w.page("show/map-columns/early.html", f'<a id="early" href="{app}/deny">deny</a>'
                       f'<iframe src="inner.html"></iframe><img src="{app}/slow">')
        w.focus_view(w.opened(early))
        outer = until(lambda: next((f for f in v.frames if f.url.endswith("/early.html")), None) or v.evaluate("false"),
                      "a frame showing /early.html")
        outer.wait_for_selector("#early")
        inner = until(lambda: next((f for f in outer.child_frames if f.url.endswith("/inner.html")), None) or v.evaluate("false"),
                      "a frame inside /early.html showing /inner.html")
        inner.wait_for_selector("#nested")

        def tab_on(frame, selector: str) -> str | None:
            """The address of the browser tab a click on the link opens, None for no tab."""
            try:
                with w.context.expect_page(timeout=10000) as tab:
                    frame.click(selector)
                url = tab.value.url
                tab.value.close()
                return url
            except PlaywrightTimeout:
                return None

        check("the page has not loaded", "interactive", outer.evaluate("document.readyState"))
        check("...and what the hub put in the page leaves it in standards mode", "CSS1Compat", outer.evaluate("document.compatMode"))
        check("a link in a page framed inside it, clicked, opens the page that refuses framing as a browser tab",
              f"{app}/self", tab_on(inner, "#nested"))
        check("a link clicked before its page has loaded opens a page that refuses framing as a browser tab", f"{app}/deny",
              tab_on(outer, "#early"))
        check("...and the pane still shows the page", True, outer.url.endswith("/early.html"))
        held.set()


@scenario
def links_between_session_pages(w: World) -> None:
    """hub-follows-links-between-session-pages: a handoff's links, as the mx renderer writes them at a session page's
    top, to the session after it (one the hub has no unit of) and back to the one before it (one it has)."""
    handoff = lambda word, sid: f'<p class="v-meta handoffs" id="handoffs">{word} <a href="../{sid}/index.html">{sid[:8]}</a></p>'
    after = "9a9a9a9a-0000-4000-8000-000000000099"
    w.page(f"sessions/{after}/index.html", handoff("continues", ORCHESTRATOR) + "<h1>the session after</h1>")
    w.enter()
    w.frame_of(ORCHESTRATOR).evaluate("html => document.body.insertAdjacentHTML('afterbegin', html)", handoff("continued in", after))
    w.frame_of(ORCHESTRATOR).click("#handoffs a")
    settles("a click on a link to another session's page goes to that session's unit, made one though the hub had none",
            (after, True), lambda: (w.current(), (w.sidebar_url() or "").endswith(f"/sessions/{after}/index.html")))
    w.frame_of(after).click("#handoffs a")
    settles("...and its link back goes back to the unit before it", ORCHESTRATOR, w.current)


@scenario
def start_and_resume(w: World) -> None:
    """hub-starts-and-resumes-sessions: the form that starts a session, and the resume on an ended session's row and in its
    box, each saying in place what the hub answered. The hub's answers are made up here: what it does in tmux is
    server.test's."""
    v = w.view
    ended = session_id(0x12)
    w.opened(w.page("show/old/index.html", "<h1>old</h1>"), ended)  # a unit whose session runs nowhere
    transcript = w.home / ".claude" / "projects" / "-alpha" / f"{ended}.jsonl"
    transcript.parent.mkdir(parents=True)
    transcript.write_text(json.dumps({"type": "user", "cwd": str(w.code), "entrypoint": "cli", "sessionId": ended}) + "\n")
    (w.scratch / "state" / "last-start.json").write_text(json.dumps({"account": str((w.home / ".claude").resolve()), "model": "sonnet",
                                                                      "effort": "low", "mode": ""}))
    sent, answers = [], []

    def answering(route) -> None:
        sent.append((route.request.url.rsplit("/", 1)[-1], route.request.post_data_json))
        code, body = answers.pop(0)
        route.fulfill(status=code, content_type="application/json", body=json.dumps(body))
    v.route("**/api/resume", answering)
    v.route("**/api/start", lambda route: answering(route) if route.request.method == "POST" else route.continue_())

    row = v.locator(".unit", has=v.locator(f'button[title="session {ended}"]'))
    until(lambda: row.locator(".resume").count(), "the ended session's row")
    answers.append((409, {"error": "the session still runs (in hub:@0.%3); a second process of it would write its transcript twice"}))
    row.locator(".resume").click()
    settles("a resume on an ended session's row goes into its unit, and a resume the hub refuses is said in its box",
            (ended, "not resumed: the session still runs (in hub:@0.%3); a second process of it would write its transcript twice"),
            lambda: (w.current(), v.evaluate(f"{BOX}.querySelector('.how').textContent")))
    check("...having asked the hub to resume that session", [("resume", {"unit": ended})], sent)
    answers.append((200, {"unit": ended, "view": f"/u/{ended}", "pane": "%3", "restored": {"model": "claude-opus-5-5", "effort": "high"},
                          "defaulted": ["mode"]}))
    settles("its box offers the resume too, once the refusal has been read", True,
            lambda: v.evaluate(f"!!{BOX}.querySelector('.how .resume-now')"), within=10)
    v.locator(f"#session-box .reply .how .resume-now").click()
    settles("...whose resume the hub carries out is said there too, with what it restored and what it left to Claude Code",
            "resumed in tmux pane %3 on claude-opus-5-5, at high effort; its permission mode recorded nowhere in its transcript, "
            "so Claude Code's default",
            lambda: v.evaluate(f"{BOX}.querySelector('.how').textContent"))

    v.keyboard.press("Control+Alt+c")
    field = lambda name: v.evaluate(f"(f => f.elements['{name}']?.value)(document.querySelector('#starter form'))")
    settles("ctrl+alt+c opens the form that starts a session, each choice but the project and the prompt as the last start "
            "on this host picked it, the projects its transcripts ran in offered",
            (True, str(w.code), str((w.home / ".claude").resolve()), "sonnet", "low", "", [str(w.code)]),
            lambda: (v.evaluate("document.getElementById('starter').open"), field("project"), field("account"), field("model"), field("effort"), field("mode"),
                     PROJECTS(v)))
    v.locator("#start-prompt").fill("map the columns")
    answers.append((409, {"error": "no tmux server runs; start one (tms), so that its saved sessions come back first"}))
    v.locator("#start-prompt").press("Control+Enter")
    settles("a start the hub refuses is said in the form, which stays open",
            (True, "not started: no tmux server runs; start one (tms), so that its saved sessions come back first"),
            lambda: (v.evaluate("document.getElementById('starter').open"), v.evaluate("document.querySelector('#starter .say').textContent")))
    check("...having sent what the form holds", ("start", {"project": str(w.code), "account": str((w.home / ".claude").resolve()),
                                                         "model": "sonnet", "effort": "low", "mode": "", "prompt": "map the columns"}), sent[-1])
    answers.append((200, {"unit": ORCHESTRATOR, "view": f"/u/{ORCHESTRATOR}", "pane": "%4"}))
    v.locator("#start-project").press("Enter")
    settles("a start the hub carries out closes the form and goes to the new session's unit", (False, ORCHESTRATOR),
            lambda: (v.evaluate("document.getElementById('starter').open"), w.current()))

    account = v.evaluate(f"wc.state.units.find((u) => u.unit === '{ORCHESTRATOR}').account")
    v.evaluate(f"localStorage.setItem('hub:accounts:hidden', JSON.stringify([{json.dumps(account)}]))")
    v.reload()
    until(lambda: v.evaluate(f"window.wc?.state && !wc.state.units.some((u) => u.unit === '{ORCHESTRATOR}')"), "the account hidden")
    v.keyboard.press("Control+Alt+c")
    until(lambda: PROJECTS(v), "the form's projects")
    answers.append((200, {"unit": ORCHESTRATOR, "view": f"/u/{ORCHESTRATOR}", "pane": "%5"}))
    v.locator("#start-project").press("Enter")
    settles("a session started under an account hidden from the rail shows that account again, and goes to the session",
            (ORCHESTRATOR, "[]"), lambda: (w.current(), v.evaluate("localStorage.getItem('hub:accounts:hidden')")))


PROJECTS = lambda tab: tab.evaluate("[...document.querySelectorAll('#start-projects li .path')].map(p => p.title)")
FORM_PICKS = """(f => [f.elements.project.value, ...['account', 'model', 'effort', 'mode'].map(n => f.elements[n]?.value),
    document.activeElement.closest('#starter .field')?.id || document.activeElement.id])(document.querySelector('#starter form'))"""


@scenario
def starting_from_the_keyboard(w: World) -> None:
    """hub-start-form-ergonomics: the + on the rail's head opens the form; its projects are the latest first, found as
    fzf finds, and every other choice is a row of segments; the keyboard walks it and enter starts. Ten projects, each
    the cwd of a transcript a minute older than the one before; alpha holds an agent repo."""
    v = w.view
    names = ["dotfiles", "alpha", "jarvis", "lifelog", "yapit", "obsidian/knowledge-base", "scratch/plot-sweep", "work/helferline",
             "repos-old/dot-files-2019", "notes"]
    dirs = [w.code if n == "alpha" else w.home / "repos" / n for n in names]
    for i, d in enumerate(dirs):
        d.mkdir(parents=True, exist_ok=True)
        transcript = w.home / ".claude" / "projects" / f"-p{i}" / f"{session_id(0x40 + i)}.jsonl"
        transcript.parent.mkdir(parents=True, exist_ok=True)
        transcript.write_text(json.dumps({"type": "user", "cwd": str(d), "entrypoint": "cli", "sessionId": session_id(0x40 + i)}) + "\n")
        os.utime(transcript, (w.t0 - 60 * i, w.t0 - 60 * i))
    (w.scratch / "state" / "last-start.json").write_text(json.dumps({"account": str((w.home / ".claude").resolve()), "model": "opus",
                                                                      "effort": "high", "mode": "auto"}))
    sent = []

    def answering(route) -> None:
        sent.append(route.request.post_data_json)
        route.fulfill(status=409, content_type="application/json", body=json.dumps({"error": "no tmux server runs"}))
    v.route("**/api/start", lambda route: answering(route) if route.request.method == "POST" else route.continue_())
    shots = os.environ.get("HUB_START_FORM_SCREENSHOTS")

    v.locator("#start-button").click()
    settles("the + on the rail's head opens the form, its projects the latest first, an agent repo's checkout named so",
            (True, [str(d) for d in dirs], "agent repo"),
            lambda: (v.evaluate("document.getElementById('starter').open"), PROJECTS(v),
                     v.evaluate("document.querySelector('#start-projects li:nth-child(2) .v-meta')?.textContent")))
    check("every choice but the project and the first prompt is a row of segments, each in sight, the last start's picked",
          {"host": 1, "account": ["claude"],
           "model": ["default", "fable", "opus", "sonnet", "haiku", ""], "effort": ["default", "low", "medium", "high", "xhigh", "max"],
           "mode": ["default", "manual", "acceptEdits", "auto", "plan", "dontAsk", "bypassPermissions"],
           "picked": ["claude", "opus", "high", "auto"]},
          v.evaluate("""(() => { const rows = Object.fromEntries([...document.querySelectorAll('#starter .seg')].map(r =>
              [r.dataset.name, [...r.querySelectorAll('label')].map(l => l.querySelector('span')?.textContent ?? '')]));
              rows.host = rows.host.length; // this host alone: the world has no peer
              rows.picked = [...document.querySelectorAll('#starter .seg:not(#start-host) label:has(:checked) span')].map(s => s.textContent);
              return rows; })()"""))
    if shots:
        v.screenshot(path=f"{shots}/desk.png")
        v.evaluate("document.documentElement.dataset.theme = 'night'")
        v.wait_for_timeout(400)  # the colours' transitions
        v.screenshot(path=f"{shots}/desk-night.png")
        v.evaluate("delete document.documentElement.dataset.theme")

    v.keyboard.type("~/rep/dot-f")
    check("a path typed to find a project picks the project it finds, the path as typed offered after it",
          ([str(dirs[8]), "~/rep/dot-f"], str(dirs[8])), (PROJECTS(v), v.evaluate(FORM_PICKS)[0]))
    v.keyboard.press("ControlOrMeta+a")
    v.keyboard.type("/srv/new-project")
    check("...and one that finds none is picked as typed", (["/srv/new-project"], "/srv/new-project"), (PROJECTS(v), v.evaluate(FORM_PICKS)[0]))
    v.keyboard.press("ControlOrMeta+a")
    v.keyboard.type("~/repos")
    settles("...and one that is a directory on the host goes ahead of the projects it also finds, typed whole as it is",
            ("~/repos", "~/repos", True), lambda: (PROJECTS(v)[0], v.evaluate(FORM_PICKS)[0], len(PROJECTS(v)) > 1))
    v.keyboard.press("ControlOrMeta+a")
    v.keyboard.type("dtfl")
    check("typing finds projects as fzf does, its letters in order and apart, ranked as fzf 0.74 ranks them, under ~",
          ([str(dirs[8]), str(dirs[0])], ["~/repos/repos-old/dot-files-2019", "~/repos/dotfiles"]),
          (PROJECTS(v), v.evaluate("[...document.querySelectorAll('#start-projects li .path')].map(p => p.textContent)")))
    v.keyboard.press("Control+j")
    check("ctrl+j picks the next one found", str(dirs[0]), v.evaluate(FORM_PICKS)[0])
    v.keyboard.press("ArrowDown")
    v.keyboard.press("ArrowDown")
    v.keyboard.press("ArrowRight")
    v.keyboard.press("l")
    check("↓ ↓ walks to the model, whose pick → and l move along its row",
          [str(dirs[0]), str((w.home / ".claude").resolve()), "haiku", "high", "auto", "start-model"], v.evaluate(FORM_PICKS))
    v.keyboard.press("l")
    v.keyboard.type("opus[1m]")
    v.keyboard.press("j")
    check("past the last model, a name typed in, where j is a letter of it", "opus[1m]j", v.evaluate(FORM_PICKS)[2])
    v.keyboard.press("Backspace")
    v.keyboard.press("ArrowDown")
    v.keyboard.press("h")
    v.keyboard.press("h")
    v.keyboard.press("j")
    v.keyboard.press("ArrowLeft")
    v.keyboard.press("k")
    v.keyboard.press("k")
    v.keyboard.press("ArrowUp")
    v.keyboard.press("k")
    v.keyboard.press("ArrowUp")
    check("j and k walk between the rows, h and ← along them; ↑ walks out of the typed model's name, and from the project to the host",
          [str(dirs[0]), str((w.home / ".claude").resolve()), "opus[1m]", "low", "acceptEdits", "start-host"], v.evaluate(FORM_PICKS))
    v.keyboard.press("Enter")
    settles("enter starts, with what the form holds", [{"project": str(dirs[0]), "account": str((w.home / ".claude").resolve()),
                                                       "model": "opus[1m]", "effort": "low", "mode": "acceptEdits", "prompt": ""}], lambda: sent)
    check("the start button wears the accent, as the primary action does", True,
          v.evaluate("""(() => { const probe = document.createElement('i'); probe.style.color = 'var(--accent)'; document.body.append(probe);
              const accent = getComputedStyle(probe).color; probe.remove();
              return getComputedStyle(document.querySelector('#starter [type=submit]')).backgroundColor === accent; })()"""))
    v.keyboard.press("Control+Alt+c")
    settles("ctrl+alt+c still folds it away", False, lambda: v.evaluate("document.getElementById('starter').open"))

    ph = phone_tab(w)
    ph.locator("#start-button").click()
    settles("on a phone, the + opens it too, and it fits the screen's width", (True, True),
            lambda: (ph.evaluate("document.getElementById('starter').open"),
                     ph.evaluate("(c => c.scrollWidth <= c.clientWidth && c.getBoundingClientRect().right <= innerWidth)(document.querySelector('#starter .card'))")))
    until(lambda: len(PROJECTS(ph)) > 1, "the projects on the phone")
    check("...each project's last name in sight, however long the path before it", True,
          ph.evaluate("""[...document.querySelectorAll('#start-projects li')].every((li) =>
              li.querySelector('.name').getBoundingClientRect().right <= li.getBoundingClientRect().right)"""))
    want = PROJECTS(ph)[1]
    ph.locator("#start-projects li").nth(1).tap()
    check("a project tapped is taken: picked, its path in the field, the list folded away and the keyboard with it",
          (want, True, False, False),
          (ph.evaluate(FORM_PICKS)[0],
           ph.evaluate("document.getElementById('start-project').value === document.querySelector('#start-projects li.picked .path').textContent"),
           ph.locator("#start-projects").is_visible(), ph.evaluate("document.activeElement.id === 'start-project'")))
    ph.locator("#start-project").tap()
    check("...and a tap on the field brings the list back", True, ph.locator("#start-projects").is_visible())
    if shots:
        ph.keyboard.press("Escape")  # the phone's own keyboard is up over a field in use; the shot shows the form whole
        ph.locator("#start-button").click()
        ph.evaluate("document.activeElement.blur()")
        ph.screenshot(path=f"{shots}/phone.png")
    ph.context.close()


@scenario
def finding_an_orchestrator(w: World) -> None:
    """hub-session-search: finding an orchestrator by its session id, its short id or its title, the ended ones folded
    under "N more" included. Ended sessions, more than the ended list shows, each titled by the title Claude Code keeps
    in its transcript, as 2.1.289 writes it; the last of them, which sorts last among the ended, is folded. Two titles
    share hbrd for hub-layout-pass 7, the one fzf ranks first later on the rail."""
    v = w.view
    ended = [f"e{i}e{i}e{i}e{i}-0000-4000-8000-00000000001{i}" for i in range(7)]
    titles = [*(f"Chore number {i}" for i in range(4)), "Hash bread", "Hub redesign", "Instagram saves pass 1"]
    for i, (sid, title) in enumerate(zip(ended, titles)):
        transcript = w.home / ".claude" / "projects" / "-home-repos-alpha" / f"{sid}.jsonl"
        transcript.parent.mkdir(parents=True, exist_ok=True)
        transcript.write_text("".join(json.dumps({"type": "ai-title", "aiTitle": t, "sessionId": sid}, separators=(",", ":")) + "\n"
                                      for t in ("Chore", title)))
        w.opened(w.page(f"notes/ended-{i}.html", "an ended session's page"), sid)
    for n in (0x10, 0x11):  # running sessions whose ids start with what the ended ones' only hold inside
        session = session_id(n)
        w.registered(session, w.t0 - 300 - n)
        w.opened(w.page(f"show/unit-{n}/index.html", f"<h1>unit {n}</h1>"), session)
    w.registered(ORCHESTRATOR, time.time(), name="alpha-d2")
    rail_names = lambda: v.evaluate("[...document.querySelectorAll('#units .name, #aside-units .name')].map(e => e.textContent)")
    settles("an ended session with no session page is titled on the rail by Claude Code's own title for it",
            True, lambda: "Chore number 0" in rail_names())
    settles("...the orchestrator searched for below folded under the ended list's \"N more\"",
            (False, True), lambda: ("Instagram saves pass 1" in rail_names(),
                                    v.locator("#aside-units .more").text_content().endswith("more")))
    found = lambda: v.evaluate("[...document.querySelectorAll('#units .name')].map(e => e.textContent)")

    def search(query: str, expected: list[str], what: str, sort: bool = False) -> None:
        v.keyboard.press("Control+Alt+f")
        v.keyboard.type(query)
        settles(what, expected, lambda: sorted(found()) if sort else found())

    search(ended[6][:6], ["Instagram saves pass 1"], "ctrl+alt+f and a prefix of a session id finds that orchestrator alone, folded as it is")
    check("...from a search box ctrl+alt+f put the keyboard in", "search", v.evaluate("document.activeElement.id"))
    v.keyboard.press("Enter")
    settles("...and enter goes to it, as a click on the rail would", (ended[6], ""),
            lambda: (w.current(), v.evaluate("document.getElementById('search').value")))
    w.frame_at("/ended-6.html")  # its page, which has the keyboard once it loads
    v.wait_for_function(HOLDS_KEYBOARD, timeout=10000)
    search(ended[6], ["Instagram saves pass 1"], "a whole session id finds it too")
    v.keyboard.press("Escape")
    settles("...and escape clears the search, the rail back as it was", ("", True),
            lambda: (v.evaluate("document.getElementById('search').value"), "Chore number 0" in rail_names()))
    search("SAVES insta", ["Instagram saves pass 1"], "words of a title, in any order and either case, find its orchestrator")
    v.keyboard.press("Escape")
    # hub-layout-pass 7, the ranking as fzf 0.74.4 --filter hbrd ranks these units' lines (title, short id, session id)
    search("hbrd", ["Hub redesign", "Hash bread"], "a query's characters in order with gaps find a title, ranked as fzf ranks "
           "them: Hub redesign first, though longer and later on the rail")
    v.keyboard.press("Escape")
    search("HbRd", ["Hub redesign", "Hash bread"], "...whatever their case")
    v.keyboard.press("Escape")
    search("hub rd", ["Hub redesign"], "...and a space splits the query into terms that must all match")
    v.keyboard.press("Escape")
    search("chore number", [f"Chore number {i}" for i in range(4)], "...every orchestrator whose title holds them", sort=True)
    third = found()[2]
    v.keyboard.press("ArrowDown")
    v.keyboard.press("ArrowDown")
    v.keyboard.press("Enter")
    title_here = lambda: v.evaluate("wc.state.units.find(u => u.unit === wc.current)?.title")
    settles("...and the arrows pick the one enter goes to", third, title_here)
    v.wait_for_function(f"{HOLDS_KEYBOARD} && document.activeElement.contentDocument?.readyState === 'complete'", timeout=10000)
    orchestrator = v.evaluate(f"wc.state.units.find(u => u.unit === {json.dumps(ORCHESTRATOR)}).title")
    search("alpha-d2", [orchestrator], "a short id from the registry finds its orchestrator")
    v.keyboard.press("Enter")
    settles("...and enter goes to it", ORCHESTRATOR, w.current)
    search("nothing-is-called-this", [], "a query nothing matches finds nothing")
    check("...and says so", "no session matches", v.locator("#units .found-none").text_content())
    v.keyboard.press("Escape")
    w.frame_of(ORCHESTRATOR)
    w.focus_session()
    v.keyboard.press("Control+Alt+f")
    v.keyboard.press("Escape")
    settles("escape gives the keyboard back to the page that had it before ctrl+alt+f", True, w.holds_session)
    units = w.api("/api/hub")["units"]
    prefixed = [u["title"] for u in units if u["session"] and u["session"].startswith("0000001")]
    inside = [u["title"] for u in units if u["session"] and "0000001" in u["session"] and u["title"] not in prefixed]
    v.keyboard.press("Control+Alt+f")
    v.keyboard.type("0000001")
    settles("a session id the query starts is found before one it is only inside of", (sorted(prefixed), True),
            lambda: (sorted(found()[:len(prefixed)]), set(inside) <= set(found()[len(prefixed):])))
    v.keyboard.press("Escape")



@scenario
def finding_a_session_no_unit_holds(w: World) -> None:
    """hub-finds-every-session: an ended session that never opened a page, so no unit on the rail, found by the search
    from the host's index of its transcripts and gone to as its unit, which resumes from there."""
    v = w.view
    quiet = session_id(0x31)
    fakes.page(w.home / ".claude/projects/-alpha" / f"{quiet}.jsonl", "".join(json.dumps(line, separators=(",", ":")) + "\n" for line in (
        {"type": "user", "sessionId": quiet, "cwd": str(w.code), "entrypoint": "cli", "message": {"content": "go"}},
        {"type": "ai-title", "aiTitle": "Quiet refactor of the parser", "sessionId": quiet})))
    rail_names = lambda: v.evaluate("[...document.querySelectorAll('#units .name, #aside-units .name')].map(e => e.textContent)")
    until(rail_names, "the rail")
    check("an ended session that never opened a page is not on the rail", False, "Quiet refactor of the parser" in rail_names())
    v.keyboard.press("Control+Alt+f")
    v.keyboard.type("quiet parser")
    settles("ctrl+alt+f finds it all the same, by its title", ["Quiet refactor of the parser"],
            lambda: v.evaluate("[...document.querySelectorAll('#units .name')].map(e => e.textContent)"))
    v.keyboard.press("Enter")
    stand_in = lambda: v.evaluate("document.querySelector('#session-frames > .current iframe')?.contentDocument?.body?.textContent ?? ''")
    settles("...and enter goes to it as its unit: its session page the hub's stand-in, the session listed among the ended",
            (quiet, True, True), lambda: (w.current(), "This session has rendered no session page yet" in stand_in(),
                                          "Quiet refactor of the parser" in rail_names()))
    sent = []

    def answering(route) -> None:
        sent.append(route.request.post_data_json)
        route.fulfill(status=200, content_type="application/json",
                      body=json.dumps({"unit": quiet, "view": f"/u/{quiet}", "pane": "%5", "restored": {}, "defaulted": []}))
    v.route("**/api/resume", answering)
    settles("its box offers to resume it", True, lambda: v.evaluate(f"!!{BOX}?.querySelector('.how .resume-now')"))
    v.locator("#session-box .reply .how .resume-now").click()
    settles("...which asks this host's hub to resume that session", [{"unit": quiet}], lambda: sent)
    v.locator(f'button[title="session {ORCHESTRATOR}"]').click()
    settles("once you leave it, the rail is as it was", (ORCHESTRATOR, False),
            lambda: (w.current(), "Quiet refactor of the parser" in rail_names()))


# ---- at phone width

PHONE = {"width": 393, "height": 852}
# what is in sight at phone width: the screen, and whether a page is over it
SCREEN = "[document.body.dataset.screen, document.body.classList.contains('paging')]"
# the widest of the hub tab and the frames in sight, against the screen's width: equal where nothing scrolls sideways
WIDEST = """[Math.max(...[document, ...[...document.querySelectorAll('#session-frames > .current iframe, #page iframe')]
  .map((f) => f.contentDocument ?? f)].map((d) => d.documentElement?.scrollWidth ?? 0)), innerWidth]"""
PAGED = "document.querySelector('#page iframe')?.getAttribute('src') ?? null"
POSTED = "(what) => posts.filter((p) => p === '/api/' + what).length"
# the desk's frames, which a phone never shows: how many there are, and how many of them load
DESK_FRAMES = """(f => [f.length, f.filter((i) => i.hasAttribute('src')).length])(
  [...document.querySelectorAll('iframe')].filter((i) => !i.closest('#page, #session-frames')))"""


def phone_tab(w: World):
    """A hub tab on a phone: a profile of its own, at a phone's size, touch for a pointer."""
    context = w.context.browser.new_context(viewport=PHONE, is_mobile=True, has_touch=True)
    context.add_init_script(RECORD_POSTS)
    page = w.fresh_tab("window.wc && document.body.dataset.screen", context=context)
    page.on("pageerror", lambda e: w.errors.append(str(e)))
    return page


@scenario
def on_the_phone(w: World) -> None:
    """hub-phone-layout: on a phone, max goes from the rail to a session, reads its page, answers in its box and opens
    one of its pages, without zooming or scrolling sideways, and the phone's back gesture steps back the way he came."""
    p = w.pane()
    ph = phone_tab(w)
    try:
        check("a phone opens the hub at the rail, the bar at the bottom under it", (["rail", False], True),
              (ph.evaluate(SCREEN), ph.locator("#tabs").is_visible()))
        check("...the rail alone in sight", (True, False), (w.shown("rail-side", ph), w.shown("session-side", ph)))
        check("...and none of the desk's frames loads, out of sight, slowing the phone's every tap", 0,
              until(lambda: (n := ph.evaluate(DESK_FRAMES))[0] and n, "the desk's frames")[1])
        ph.locator(f'#units button[title="session {ANSWERING}"] .name').tap()
        w.frame_at(f"/{ANSWERING}/index.html", ph)
        settles("a tap on a session's row goes to its session page, with its box", (["session", False], ANSWERING, True, False),
                lambda: (ph.evaluate(SCREEN), w.current(ph), w.shown("session-side", ph), w.shown("rail-side", ph)))
        check("...the bar naming the session", "session 00000011", ph.locator('#tabs [data-screen="session"] .label').text_content())
        settles("...nothing wider than the screen", [PHONE["width"]] * 2, lambda: ph.evaluate(WIDEST))
        box = ph.locator("#session-box textarea")
        box.tap()
        box.press_sequentially("yes")
        box.press("Enter")
        box.press_sequentially("the second way")
        check("enter in the box makes a new line, as a phone's keyboard does, and sends nothing", ("yes\nthe second way", b"", 0),
              (box.input_value(), p.arrived(), ph.evaluate(POSTED, "type")))
        check("...the bar out of the way while the box has the keyboard", False, ph.locator("#tabs").is_visible())
        ph.locator("#session-box .send").tap()
        settles("its send button types it into the session's pane", b"\x1b[200~yes\rthe second way\x1b[201~\r", p.arrived)
        settles("...and empties the box, the keyboard leaving it", ("", True), lambda: (box.input_value(), ph.locator("#tabs").is_visible()))
        check("jump, which moves a terminal at the desk, is not under a phone's box; close is",
              (False, True), (ph.locator("#session-box .jump").is_visible(), ph.locator("#session-box .acts button:not(.jump, .attach)").is_visible()))

        ph.locator('#tabs [data-screen="pages"]').tap()
        settles("the pages tab lists the unit's pages", (["pages", False], ["index.html"]),
                lambda: (ph.evaluate(SCREEN), [b.text_content() for b in ph.locator("#pages li b").all()]))
        ph.locator("#pages li button").first.tap()
        w.frame_at("/unit-1/index.html", ph)
        settles("a tap on one opens it over everything, the bar too", (["pages", True], False),
                lambda: (ph.evaluate(SCREEN), ph.locator("#tabs").is_visible()))
        settles("...nothing wider than the screen", [PHONE["width"]] * 2, lambda: ph.evaluate(WIDEST))
        check("...and asks the hub nothing, so the desk shows the unit as it did", 0, ph.evaluate(POSTED, "open"))
        ph.reload()
        ph.wait_for_function("window.wc && document.body.dataset.screen", timeout=30000)
        settles("a reload stays where the phone was, the page over its pages", (["pages", True], "/unit-1/index.html"),
                lambda: (ph.evaluate(SCREEN), (ph.evaluate(PAGED) or "")[-len("/unit-1/index.html"):]))
        fresh = w.fresh_tab("window.wc && document.body.dataset.screen", context=ph.context)
        check("...while a hub tab opened afresh starts at the rail, whatever session it was in last", ["rail", False], fresh.evaluate(SCREEN))
        fresh.close()
        for back, where in (("the page", ["pages", False]), ("the pages", ["session", False]), ("the session page", ["rail", False])):
            ph.go_back()
            settles(f"the back gesture leaves {back}", where, lambda: ph.evaluate(SCREEN))
    finally:
        ph.context.close()


@scenario
def links_on_the_phone(w: World) -> None:
    """hub-phone-layout: on a phone, a line of the session page opens its page over the screens, ‹ › step through
    the unit's pages there, and a link inside a page opens where it goes in its place. phone-links-leave-the-desk-alone:
    a link to a page the unit does not list yet joins the unit's pages, and the desk's layout and focus stay as they were."""
    desk = (w.docked(), w.focused())
    ph = phone_tab(w)
    try:
        ph.locator('#tabs [data-screen="session"]').tap()
        session = w.frame_at(f"/{ORCHESTRATOR}/index.html", ph)
        settles("the session tab, with no session gone to yet, is the rail's first", (["session", False], ORCHESTRATOR),
                lambda: (ph.evaluate(SCREEN), w.current(ph)))
        session.locator(w.line_link("map-columns/sketch.html")).tap()
        settles("a line of its session page opens the page over everything, even one nobody opened, asking the hub nothing",
                (True, "/sketch.html", 0), lambda: (ph.evaluate(SCREEN)[1], (ph.evaluate(PAGED) or "")[-12:], ph.evaluate(POSTED, "open")))
        check("...headed by what its line says of it, and where it is among the unit's pages", ("sketch", "3/3"),
              (ph.locator("#page .title b").text_content(), ph.locator("#page .at").text_content()))
        ph.locator("#page .next").tap()
        settles("› steps on to the unit's next page, round to its first", "/csv-import/index.html",
                lambda: (ph.evaluate(PAGED) or "")[-len("/csv-import/index.html"):])
        ph.locator("#page .next").tap()
        settles("› again, its next", "/map-columns/index.html", lambda: (ph.evaluate(PAGED) or "")[-len("/map-columns/index.html"):])
        ph.frame_locator("#page iframe").locator("#link").tap()
        settles("a link inside it opens where it goes, in its place", "/map-columns/other.html",
                lambda: (ph.evaluate(PAGED) or "")[-len("/map-columns/other.html"):])
        settles("...the desk's tab hears of it, and lists it minimized", [True],
                lambda: w.view.evaluate("wc.state.members.filter((m) => m.url.endsWith('/other.html')).map((m) => m.closed)"))
        check("...its layout and focus as they were before the phone came", desk, (w.docked(), w.focused()))
        w.view.keyboard.press("Control+Alt+1")
        settles("...and once the desk is in the unit", ORCHESTRATOR, w.current)
        w.view.keyboard.press("Control+Alt+Shift+W")
        settles("...where ctrl+alt+shift+w brings back the page the phone looked at", True,
                lambda: w.view.evaluate("ws.views().some((v) => v.params.url.endsWith('/other.html'))"))
        ph.go_back()
        settles("...and back goes back to the page it was clicked in", "/map-columns/index.html",
                lambda: (ph.evaluate(PAGED) or "")[-len("/map-columns/index.html"):])
        ph.locator("#page .shut").tap()
        settles("✕ closes the page, back to the session page", ["session", False], lambda: ph.evaluate(SCREEN))
        ph.locator('#tabs [data-screen="pages"]').tap()
        settles("the pages tab lists the page the link went to", True,
                lambda: any(b.text_content().endswith("other.html") for b in ph.locator("#pages li b").all()))
    finally:
        ph.context.close()


@scenario
def a_window_made_narrow(w: World) -> None:
    """hub-phone-layout: the desk's layout is a matter of width alone. A window made narrow takes the phone's, and
    made wide again it gets back the desk's, in the unit it was in."""
    w.enter()
    w.view.set_viewport_size(PHONE)
    settles("narrow, the tab shows the session page of the unit it was in, alone", (["session", False], True, False),
            lambda: (w.view.evaluate(SCREEN), w.shown("session-side"), w.shown("rail-side")))
    w.view.set_viewport_size(VIEWPORT)
    settles("wide again, the desk's: the rail, the session page and the unit's panes", (False, True, True, [LEFT]),
            lambda: (w.view.evaluate("document.body.classList.contains('phone')"), w.shown("rail-side"), w.shown("session-side"), w.on_screen()))
    ph = phone_tab(w)
    until(lambda: ph.evaluate(DESK_FRAMES)[0], "the desk's frames")
    ph.set_viewport_size(VIEWPORT)
    settles("a tab opened on a phone and made wide loads the desk's frames it held back", True,
            lambda: (lambda n: n[0] == n[1])(ph.evaluate(DESK_FRAMES)))
    ph.context.close()


# ---- another host's sessions, through the hub that relays its hub

PEER = session_id(0x21)  # a session on the laptop, in a tmux pane


@scenario
def a_peers_sessions(w: World) -> None:
    """hub-relays-peer-backends: the world's hub is pc's, relaying a laptop's hub on a HOME of its own. The laptop's
    session runs in a pane of the world's tmux server, which the laptop's hub types into."""
    home = w.scratch / "lap"
    (home / ".claude/sessions").mkdir(parents=True)
    (home / ".claude/projects").mkdir()  # an account the form offers
    env = {**w.env, "HOME": str(home)}
    lap = [str(BIN / "container-hub"), "--socket", str(w.scratch / "lap.sock"), "--url", "http://laptop.invalid",
           "--state", str(w.scratch / "lap-state"), "--host", "laptop", "--tmux-socket", str(w.tmux_socket)]

    def start_laptop() -> subprocess.Popen:
        hub = subprocess.Popen(lap, env=env, stdout=subprocess.DEVNULL, stderr=(w.scratch / "lap.log").open("a"), start_new_session=True)
        until(lambda: (w.scratch / "lap.sock").exists() or hub.poll() is not None, "the laptop's hub to listen")
        return hub

    def stop(hub: subprocess.Popen) -> None:
        os.killpg(hub.pid, signal.SIGKILL)
        hub.wait()

    received, recorder = w.scratch / "lap-received", w.scratch / "recorder.py"
    recorder.write_text("import os, sys, tty\ntty.setraw(0)\nos.write(1, b'\\x1b[?2004h')\nout = open(sys.argv[1], 'ab', buffering=0)\n"
                        "while data := os.read(0, 4096):\n    out.write(data)\n")
    w.tmux("-f", "/dev/null", "new-session", "-d", "-s", "lap", "-x", "100", "-y", "20", f"exec {sys.executable} {recorder} {received}")
    pane, pid = w.tmux("display-message", "-p", "-t", "lap:", "#{pane_id} #{pane_pid}").split()
    (home / ".claude/sessions" / f"{pid}.json").write_text(json.dumps({
        "pid": int(pid), "procStart": started(pid), "sessionId": PEER, "status": "idle", "statusUpdatedAt": int(w.t0 * 1000) - 50_000,
        "tmux": f"lap:@1.{pane}"}))
    laptop = start_laptop()
    try:
        shown = home / "notes" / "laptop.html"
        shown.parent.mkdir()
        shown.write_text("<!doctype html><h1>written on the laptop</h1>")
        figure = home / "notes" / "figure.svg"
        figure.write_text('<svg xmlns="http://www.w3.org/2000/svg" width="40" height="20"><rect width="40" height="20"/></svg>')
        # the page in the right pane, a frame there, beside the figure in the left, an image there
        for opened in ({"target": str(shown), "lane": "code"}, {"target": str(figure)}):
            subprocess.run(["curl", "-sf", "--unix-socket", str(w.scratch / "lap.sock"), "-H", "Content-Type: application/json", "-d",
                            json.dumps({**opened, "session": PEER}), "http://hub/api/open"], check=True, capture_output=True)
        w.kill_hub()
        w.hub_args += ["--host", "pc", "--peer", f"laptop={w.scratch / 'lap.sock'}"]
        w.start_hub()
        w.view.reload()
        key = f"laptop/{PEER}"
        w.view.wait_for_function(f"window.wc && wc.state.units.some(u => u.unit === {json.dumps(key)})", timeout=30000)
        hosts = lambda: w.view.evaluate("[...document.querySelectorAll('#units .nav')].map(b => [b.title.replace('session ', ''), b.querySelector('.host')?.textContent])")
        settles("one rail holds both hosts' sessions, each row naming its host", sorted([[ORCHESTRATOR, "pc"], [PEER, "laptop"]]),
                lambda: sorted(hosts()))
        w.view.locator(f'#units button[title="session {PEER}"] .name').click()
        until(lambda: w.current() == key, "the laptop's unit")
        check("its session page is the laptop's hub's, through the relay", f"/h/laptop/pages/{PEER}",
              urllib.parse.urlsplit(until(w.sidebar_url, "the session sidebar")).path)
        w.frame_at("/laptop.html")  # its page, in its pane
        box = lambda: w.view.evaluate(f"(b => b && [b.dataset.state, b.querySelector('.how').textContent])({BOX})")
        settles("the box types into the laptop's pane, and offers to move its session here", [["waiting", "idle"], "move to pc"],
                lambda: [box(), w.view.evaluate(f"{BOX}.querySelector('.acts .moves').textContent")])
        w.view.evaluate(f"{BOX}.querySelector('textarea').focus()")
        w.view.keyboard.type("from pc")
        w.view.keyboard.press("Enter")
        settles("...and what it sends, the laptop's hub types there", b"\x1b[200~from pc\x1b[201~\r",
                lambda: received.read_bytes() if received.exists() else b"")

        stop(laptop)
        aside = lambda: w.view.evaluate("[...document.querySelectorAll('#aside-units > *')].map(e => e.tagName === 'H2' ? e.textContent.replace(/; as read at .*/, '') : e.querySelector('.nav').title.replace('session ', ''))")
        settles("with the laptop down, its session shows under the laptop, as last read, and not among the ended",
                ["laptop does not answer", PEER], aside, within=20)
        check("...its mark the state it was last read in, faded", ["idle", True],
              w.view.evaluate(f"(m => [m.dataset.state, 'unreachable' in m.dataset])(document.querySelector('#aside-units button[title=\"session {PEER}\"] .mark'))"))
        settles("...and its box sends nothing, saying why", "none", lambda: (box() or [None])[0])
        settles("...in so many words", True, lambda: box()[1].startswith("laptop does not answer; as read at "))
        check("...and offers none of what it refuses: no jump, no close, no handoff", [False, False],
              w.view.evaluate(f"(b => [b.querySelector('.acts').checkVisibility(), b.querySelector('.offer')?.checkVisibility() ?? false])({BOX})"))
        # A tab opened while the laptop is down: each page of its unit is a notice in the hub's style, in place of the page.
        notices = lambda page: page.evaluate("""[...document.querySelectorAll('#session-frames > .current iframe, #work iframe')]
          .filter(f => f.getAttribute('src').startsWith('/h/laptop/') && !f.closest('.figure')).map(f => {
            const d = f.contentDocument, own = d?.querySelector('meta[name="hub-unreachable"]');
            return [f.getAttribute('src').split('/').pop(), own ? d.querySelector('h1').textContent : null];
          }).concat([...document.querySelectorAll('#work .figure')].filter(b => b.querySelector('img').getAttribute('src').startsWith('/h/laptop/'))
            .map(b => ['figure.svg', b.querySelector('.unreachable')?.contentDocument?.querySelector('h1')?.textContent ?? null])).sort()""")
        figures = lambda page: page.evaluate("document.querySelectorAll('#work .figure img').length")
        desk = w.fresh_tab()
        down = sorted([[PEER, "laptop does not answer"], ["laptop.html", "laptop does not answer"], ["figure.svg", "laptop does not answer"]])
        settles("a tab opened with the laptop down shows a notice in place of the session page, a page and a figure", down,
                lambda: notices(desk), within=20)
        check("...the figure an image of the tab's, the notice in its place", 1, figures(desk))
        check("...saying when the hub last read the laptop", True, desk.evaluate(
            "/The hub last read laptop at \\d\\d:\\d\\d\\b/.test(document.querySelector('#session-frames > .current iframe').contentDocument.body.textContent)"))
        phone = w.fresh_tab()
        phone.set_viewport_size(PHONE)
        notice_fits = lambda: phone.evaluate("""(f => { const d = f?.contentDocument; return !!d?.querySelector('meta[name="hub-unreachable"]')
            && d.documentElement.scrollWidth <= d.documentElement.clientWidth && f.checkVisibility(); })(document.querySelector('#session-frames > .current iframe'))""")
        settles("...and at phone width, the notice fitting the screen", True, notice_fits, within=20)
        check("...under a box with no send button", False, phone.evaluate(f"{BOX}.querySelector('.send').checkVisibility()"))
        phone.close()
        w.view.locator("#start").click()
        starts_on = lambda: w.view.evaluate("[...document.querySelectorAll('#start-host input')].map(o => o.value)")
        settles("...and the form that starts a session offers this host alone", ["pc"], starts_on)
        w.view.keyboard.press("Escape")
        laptop = start_laptop()
        settles("the laptop back, its session is numbered on the rail again", True,
                lambda: w.view.evaluate(f"!!wc.state.units.find(u => u.unit === {json.dumps(key)})?.number"), within=20)
        settles("...and the tab opened while it was down shows its pages in place of the notices",
                sorted([[PEER, None], ["laptop.html", None], ["figure.svg", None]]), lambda: notices(desk), within=20)
        desk.close()
        w.view.locator("#start").click()
        settles("...and the form names the host a session starts on: either", ["pc", "laptop"], starts_on)
        w.view.locator("#start-host label", has_text="laptop").click()
        settles("...offering, for the laptop, what the laptop's hub offers", True,
                lambda: w.view.evaluate(f"[...document.querySelectorAll('#start-account input')].some(o => o.value.startsWith({json.dumps(str(home))}))"))
        # A directory only the laptop has, and a model no hub takes: pc's hub would refuse the directory, the laptop's
        # refuses the model, before it starts anything.
        w.view.fill("#start-project", str(shown.parent))
        w.view.fill("#start-model .other [type=text]", "no model!")
        w.view.locator("#starter button[type=submit]").click()
        settles("...and starts it there: the laptop's hub is the one that answers", "not started: 'no model!' is no model name",
                lambda: w.view.evaluate("document.querySelector('#starter .say').textContent"))
        w.view.keyboard.press("Escape")
        on_laptop = lambda: json.loads(subprocess.run(["curl", "-sf", "--unix-socket", str(w.scratch / "lap.sock"), f"http://hub/api/u/{PEER}"],
                                                      check=True, capture_output=True).stdout)
        w.view.keyboard.press("Control+Alt+d")
        settles("ctrl+alt+d sets the laptop's session aside on the laptop's hub", True, lambda: on_laptop()["dismissed"])
        w.view.keyboard.press("Control+Alt+x")
        w.view.keyboard.press("Control+Alt+x")
        settles("ctrl+alt+x twice closes the laptop's session's pane, through the laptop's hub", False,
                lambda: pane in subprocess.run([w.tmux_shim, "-S", w.tmux_socket, "list-panes", "-a", "-F", "#{pane_id}"],
                                               env=w.env, capture_output=True, text=True).stdout.split())  # its server goes with its last pane
    finally:
        stop(laptop)


COPIED = session_id(0x22)  # a session on the laptop, idle at the last pull of it, the laptop down since
GONE = session_id(0x25)  # a session on the laptop, ended before the last pull, and no unit


@scenario
def a_down_hosts_copies(w: World) -> None:
    """hub-shows-copies-and-forks: the world's hub is pc's, relaying a laptop that never answers, whose sessions pc
    pulled: one of them idle at the last pull, with its session page."""
    copy, laptop_home = w.scratch / "copies" / "laptop" / pwd.getpwuid(os.getuid()).pw_name, "/home/someone"
    fakes.page(copy / ".claude/projects/-p" / f"{COPIED}.jsonl", json.dumps(
        {"type": "user", "sessionId": COPIED, "cwd": str(w.home), "message": {"content": "go"}}) + "\n")
    fakes.page(copy / ".claude/session-pages" / COPIED / "index.html", "<!doctype html><body><h1>on the laptop</h1><p>its turns</p>")
    fakes.page(copy / ".claude/sessions/100.json", json.dumps({"pid": 100, "sessionId": COPIED, "status": "idle"}))
    fakes.page(copy / ".claude/projects/-p" / f"{GONE}.jsonl", "".join(json.dumps(line, separators=(",", ":")) + "\n" for line in (
        {"type": "user", "sessionId": GONE, "cwd": str(w.home), "entrypoint": "cli", "message": {"content": "go"}},
        {"type": "ai-title", "aiTitle": "Long gone on the laptop", "sessionId": GONE})))
    # today, as a time of yesterday's says its date: ten minutes ago, or midnight where that was yesterday
    pulled = max(w.t0 - 600, datetime.fromtimestamp(w.t0).replace(hour=0, minute=0, second=0, microsecond=0).timestamp())
    fakes.page(copy.with_name(copy.name + ".pulled.json"), json.dumps({"at": pulled, "home": laptop_home}))
    w.kill_hub()
    w.hub_args += ["--host", "pc", "--peer", f"laptop={w.scratch / 'no-laptop.sock'}", "--copies", str(w.scratch / "copies")]
    w.start_hub()
    w.view.reload()
    key = f"laptop/{COPIED}"
    w.view.wait_for_function(f"window.wc && wc.state.units.some(u => u.unit === {json.dumps(key)})", timeout=30000)
    at = datetime.fromtimestamp(pulled).strftime("%H:%M")  # as the tab says a time, in the browser's zone, which is this host's
    row = f'#aside-units button[title="session {COPIED}"]'
    check("the laptop down, its session idle at the last pull is listed under it, with when its copy was pulled and the "
          "session's state then", ["laptop does not answer", f"copy · idle {at}"],
          [w.view.evaluate(f"document.querySelector('{row}').closest('.unit').previousElementSibling.textContent.replace(/; as read at .*/, '')"),
           w.view.evaluate(f"document.querySelector('{row} .copy').textContent")])
    w.view.locator(f"{row} .name").click()
    until(lambda: w.current() == key, "the laptop's unit")
    page = lambda: w.view.evaluate("document.querySelector('#session-frames > .current iframe')?.contentDocument?.body?.textContent ?? ''")
    settles("its session page opens, from the copy, saying so", (True, True),
            lambda: ("its turns" in page(), "this is its copy, as this host last pulled it at" in page()))
    how = lambda: w.view.evaluate(f"{BOX}?.querySelector('.how')?.textContent ?? ''")  # none while the tab loads
    settles("its box sends nothing, says how current the copy is, and offers to fork it here", True,
            lambda: f"Its copy was pulled at {at}, when its turn had ended with nothing left running" in how() and how().endswith("fork onto pc"))
    w.view.evaluate(f"{BOX}.querySelector('.how .resume-now').click()")
    settles("a fork of an idle session asks first, naming the pull", True,
            lambda: f"so it may be behind: pulled at {at}. Fork from it all the same?" in how() and how().endswith("fork anyway"))
    w.view.evaluate(f"{BOX}.querySelector('.how .resume-now').click()")
    settles("...and once asked again, pc's hub forks it, here to say it has no tmux server to start it in", True,
            lambda: how().startswith("not forked: no tmux server runs"))
    fakes.page(w.home / ".claude/session-pages" / session_id(0x23) / "forked-from.json", json.dumps(
        {"host": "laptop", "session": COPIED, "point": 0, "pulled": pulled, "at": pulled + 60, "on": "pc", "page": str(copy)}))
    w.view.reload()  # as the tab reads every host again once it has forked
    settles("a session forked here shows so, on its row and in its box, which offers to fork it no more", (True, True, False),
            lambda: (w.view.evaluate(f"document.querySelector('{row} .forked')?.textContent === 'forked on pc'"),
                     how().startswith(f"forked on pc at {datetime.fromtimestamp(pulled + 60).strftime('%H:%M')} as {session_id(0x23)[:8]}"),
                     w.view.evaluate(f"!!document.querySelector('{row}')?.closest('.unit').querySelector('.resume')")), within=30)
    w.view.keyboard.press("Control+Alt+f")
    w.view.keyboard.type("long gone")
    settles("the search finds a session of the laptop's the rail does not list, ended before the last pull, from the copy",
            ["Long gone on the laptop"], lambda: w.view.evaluate("[...document.querySelectorAll('#units .name')].map(e => e.textContent)"))
    w.view.keyboard.press("Enter")
    settles("...and goes to it as its unit, whose box offers to fork it here", (f"laptop/{GONE}", True),
            lambda: (w.current(), how().endswith("fork onto pc")))


MOVING = session_id(0x24)  # a session on the laptop, ended there, which the tab moves to pc


@scenario
def a_session_moved(w: World) -> None:
    """sessions-move-by-release: the world's hub is pc's, relaying a laptop whose ended session the tab moves to pc. pc
    pulls the laptop's copy through an ssh stub that lands in the laptop's HOME."""
    home, user = w.scratch / "lap", pwd.getpwuid(os.getuid()).pw_name
    fakes.page(home / ".claude/projects/-p" / f"{MOVING}.jsonl", json.dumps(
        {"type": "user", "sessionId": MOVING, "cwd": str(w.home), "message": {"content": "go"}}) + "\n")
    page = fakes.page(home / ".claude/session-pages" / MOVING / "index.html", "<!doctype html><body><h1>moving</h1><p>its turns</p>")
    env = {**w.env, "HOME": str(home)}
    laptop = subprocess.Popen([str(BIN / "container-hub"), "--socket", str(w.scratch / "lap.sock"), "--url", "http://laptop.invalid",
                               "--state", str(w.scratch / "lap-state"), "--host", "laptop", "--tmux-socket", str(w.tmux_socket)],
                              env=env, stdout=subprocess.DEVNULL, stderr=(w.scratch / "lap.log").open("a"), start_new_session=True)
    try:
        until(lambda: (w.scratch / "lap.sock").exists() or laptop.poll() is not None, "the laptop's hub to listen")
        subprocess.run(["curl", "-sf", "--unix-socket", str(w.scratch / "lap.sock"), "-H", "Content-Type: application/json", "-d",
                        json.dumps({"target": str(page), "session": MOVING}), "http://hub/api/open"], check=True, capture_output=True)
        stub = w.scratch / "stub"
        fakes.page(stub / "ssh", f"""#!/usr/bin/env bash
while [[ $1 == -* ]]; do shift; done
shift
cd {home} && HOME={home} USER={user} exec sh -c "$*"
""").chmod(0o755)
        copies = w.scratch / "copies"
        w.kill_hub()
        w.env["PATH"] = f"{stub}:{w.env['PATH']}"
        w.hub_args += ["--host", "pc", "--peer", f"laptop={w.scratch / 'lap.sock'}", "--copies", str(copies),
                       "--pull", f"{BIN / 'session-copies'} --sources laptop=lap-over-ssh --root {copies}"]
        w.start_hub()
        w.view.reload()
        key = f"laptop/{MOVING}"
        w.view.wait_for_function(f"window.wc && wc.state.units.some(u => u.unit === {json.dumps(key)})", timeout=30000)
        check("the rail offers to move every idle or ended session of each host to the other",
              ["move laptop's idle and ended sessions to pc", "move pc's idle and ended sessions to laptop"],
              w.view.evaluate("[...document.querySelectorAll('#host-moves .move-host')].map(b => b.textContent)"))
        row = f'#aside-units button[title="session {MOVING}"]'
        w.view.locator(f"{row} .name").click()
        until(lambda: w.current() == key, "the laptop's unit")
        how = lambda: w.view.evaluate(f"{BOX}?.querySelector('.how')?.textContent ?? ''")
        move = f"{BOX}.querySelector('.acts .moves button')"
        moves = lambda: w.view.evaluate(f"(a => a?.checkVisibility() ? a.querySelector('.moves').textContent : null)({BOX}?.querySelector('.acts'))")
        settles("the box of an ended session of the laptop's offers to resume it, and to move it to pc", [True, "move to pc"],
                lambda: [how().endswith("resume"), moves()])
        w.view.evaluate(f"{move}.click()")
        settles("...a click asks to be confirmed", "move to pc? again to confirm", moves)
        w.view.evaluate(f"{move}.click()")
        until(lambda: w.current() == MOVING, "pc's unit of the moved session", within=120)
        check("...and once confirmed, the laptop releases it and pc takes it over: the tab goes to pc's unit of it, under "
              "the same id, its session page pc's own copy of the laptop's",
              f"/f{w.home}/.claude/session-pages/{MOVING}/index.html", urllib.parse.unquote(urllib.parse.urlsplit(until(w.sidebar_url, "the session sidebar")).path))
        settles("...which pc offers to resume", [True, "move to laptop"], lambda: [how().endswith("resume"), moves()])
        settles("the laptop's row of it says it was released to pc", True,
                lambda: w.view.evaluate(f"[...document.querySelectorAll('{row} .released')].some(e => e.textContent === 'released to pc')"))
    finally:
        os.killpg(laptop.pid, signal.SIGKILL)
        laptop.wait()


# ---- running them

def run(browser, scratch: Path, name: str) -> None:
    print(f"\n== {name}")
    w = None
    try:
        w = World(browser, scratch, name)
        SCENARIOS[name](w)
    except Exception:
        fail(f"{name} stopped:", traceback.format_exc())
    finally:
        if w:
            try:
                w.close()
            except Exception:
                fail(f"{name}'s world did not close:", traceback.format_exc().splitlines()[-1])


@dataclass
class Args:
    scenarios: tyro.conf.Positional[tuple[Literal[tuple(SCENARIOS)], ...]] = ()
    """The scenarios to run, by name; every one when none is named."""
    shuffle: int = 0
    """Run them in an order shuffled with this seed; 0 keeps the file's order."""


def main(args: Args) -> None:
    needs("tmux")
    names = list(args.scenarios or SCENARIOS)
    if args.shuffle:
        random.Random(args.shuffle).shuffle(names)
    scratch = Path(tempfile.mkdtemp(prefix="container-hub-view-test."))  # every world's, and what they share
    # trellis, which a hub fetches on first use into its HOME's cache: fetched once, by the first world's hub
    (scratch / "trellis").mkdir()
    try:
        with sync_playwright() as pw:
            try:
                browser = chromium(pw)
            except Skip as e:
                skip(str(e))
            try:
                for name in names:
                    run(browser, scratch, name)
            finally:
                browser.close()
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    finish()


if __name__ == "__main__":
    for stop in (signal.SIGTERM, signal.SIGHUP):  # so a stopped run still kills its hubs and tmux servers
        signal.signal(stop, lambda n, _: sys.exit(128 + n))
    main(tyro.cli(Args, description=__doc__))
