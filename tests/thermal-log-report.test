#!/usr/bin/env bash
# Drive bin/thermal-log-report against fixture counters and a stubbed journal,
# and check the CPU time it gives each unit. Run it directly; no framework.
#
# The cases are the promises the report makes about lifetimes: a restart or a
# reboot splits a unit into lifetimes that each count only their CPU inside
# the window; a stop record closes a lifetime at its own total; a unit that
# lived between two hourly counters is counted from its stop record alone; a
# unit already running when the counters began is not charged for its past.
# Every expected number below is worked out by hand from the fixture.

set -uo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# Each instant is computed once: thermal-log stamps a whole dump with one time,
# and the report recognises the first dump by that time being shared.
now=$(date +%s)
ago() { date -d "@$((now - $1 * 3600))" '+%F %T'; }  # counter timestamp
ago_us() { echo "$((now - $1 * 3600))000000"; }      # journal timestamp

# Hourly counters: time, owning manager, unit, cumulative usage in usec (here
# whole seconds). The stubbed journal below answers for the user manager, so the
# units that also have stop records are user units.
counters() {  # manager hours_ago unit seconds...
    local manager=$1 h=$2 unit=$3 s
    for s in "${@:4}"; do echo "$(ago "$h"),$manager,$unit,${s}000000"; done
}
series() {  # manager unit "hours_ago seconds"...
    local manager=$1 unit=$2 row
    for row in "${@:3}"; do
        # shellcheck disable=SC2086
        set -- $row; counters "$manager" "$1" "$unit" "$2"
    done
}
{
    echo "time,manager,unit,usage_usec"
    series system "(root)" "12 10000" "11 10100" "9 10300" "5 10700" "1 11100"
    # steady: 100 s an hour, running before the counters began
    series user steady.service "12 1000" "11 1100" "9 1300" "5 1700" "1 2100"
    # restarted: stopped at -6h (stop record: 900 s), a new lifetime from -5h
    series user restarted.service "12 500" "9 800" "5 50" "1 250"
    # reboot: counter reset between -9h and -5h with no stop record
    series user reboot.service "12 3000" "9 3300" "5 20" "1 120"
    # one name, two managers, their samples interleaved in every dump: the system
    # bus uses 100 s an hour, the session bus 1 s every 2-4 hours
    series system dbus.service "12 50000" "11 50100" "9 50300" "5 50700" "1 51100"
    series user dbus.service "12 9" "11 9" "9 10" "5 12" "1 15"
    # two tmux panes born inside the window, one still open, one closed at -7h
    counters user 5 tmux-spawn-11111111-1111-1111-1111-111111111111.scope 30
    counters user 1 tmux-spawn-11111111-1111-1111-1111-111111111111.scope 90
    counters user 9 tmux-spawn-22222222-2222-2222-2222-222222222222.scope 10
} >"$work/$(date +%F).counters.csv"

# The journal's stop records, as `journalctl -o json` prints them. The stub
# honours --since like the real one and answers only for --user.
{
    stop() { printf '{"MESSAGE":"%s: Consumed %s CPU time over %s wall clock time.","__REALTIME_TIMESTAMP":"%s"}\n' "$2" "$3" "${4:-1min}" "$(ago_us "$1")"; }
    stop 6 restarted.service "15min"
    stop 7 tmux-spawn-22222222-2222-2222-2222-222222222222.scope "1min"
    stop 11 short.service "1min 40s"
    stop 8 short.service "5.000s"
    stop 3 short.service "7000ms"
    # never scanned (no counters): 600 s of CPU over a 20 h life that ended at -2h
    stop 2 long.service "10min" "20h"
} >"$work/journal.jsonl"

mkdir -p "$work/stub"
cat >"$work/stub/journalctl" <<STUB
#!/usr/bin/env bash
case " \$* " in *" --system "*) exit 1 ;; esac
since=\$(printf '%s\n' "\$@" | sed -n 's/^@//p')
while IFS= read -r line; do
    ts=\$(sed -n 's/.*"__REALTIME_TIMESTAMP":"\([0-9]*\)".*/\1/p' <<<"\$line")
    [ "\$((ts / 1000000))" -ge "\$since" ] && echo "\$line"
done <"$work/journal.jsonl"
exit 0
STUB
chmod +x "$work/stub/journalctl"
export PATH="$work/stub:$PATH"

report() { "$bin_dir/thermal-log-report" --logdir "$work" --json "$@"; }
cpu() {  # json unit -> whole cpu seconds
    jq -r --arg u "$2" '(.units[] | select(.unit == $u) | .cpu_s | floor) // "absent"' <<<"$1"
}

# Window of 10 h: it starts between the -11h and -9h counters.
r=$(report --hours 10)
check "steady unit: from the last counter at or before the window start" 1000 "$(cpu "$r" steady.service)"
check "restart: stop total minus baseline, plus the new lifetime" 650 "$(cpu "$r" restarted.service)"
check "reboot: each side of the counter reset counts separately" 420 "$(cpu "$r" reboot.service)"
check "timer: stop records inside the window only" 12 "$(cpu "$r" short.service)"
check "tmux panes grouped into one line" 150 "$(cpu "$r" 'tmux-spawn-*.scope')"
check "system total from the root counter" 1000 "$(jq -r '.total_cpu_s | floor' <<<"$r")"
check "a name both managers use: the system unit on its own" 1000 "$(cpu "$r" 'dbus.service (system)')"
check "a name both managers use: the user unit on its own" 6 "$(cpu "$r" 'dbus.service (user)')"
check "unit known only from its stop: the window's share of its life, 8 of 20 h" 240 "$(cpu "$r" long.service)"

r=$(report --hours 10 --no-group)
check "ungrouped pane still open" 90 "$(cpu "$r" tmux-spawn-11111111-1111-1111-1111-111111111111.scope)"
check "ungrouped pane closed by its stop record" 60 "$(cpu "$r" tmux-spawn-22222222-2222-2222-2222-222222222222.scope)"

# Window of 20 h: it starts before the counters do.
r=$(report --hours 20)
check "unit running before the counters began: not charged for its past" 1100 "$(cpu "$r" steady.service)"
check "timer: every stop record inside the longer window" 112 "$(cpu "$r" short.service)"
check "unit known only from its stop: 18 of its 20 h inside" 540 "$(cpu "$r" long.service)"

if [ "$failures" -gt 0 ]; then
    echo "$failures failed"
    exit 1
fi
echo "all passed"
