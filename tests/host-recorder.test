#!/usr/bin/env bash
# Drive bin/host-recorder at a fixture root under strace and check that its
# sampling loop starts no process (host-recorder#P1), and that its hourly
# counters name the manager each unit runs under. Run it directly; no
# framework.
#
# Starting up may fork (mkdir, the pruning find, the idle pipe); the loop may
# not. The loop begins where the recorder first opens a CSV, so every process
# the trace shows starting after that line is a fork the header's cost
# argument says is not there. The run lasts three rankings, which is where the
# heavier reads are (every cgroup, a pane's largest process and its cwd).

set -uo pipefail

recorder="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/host-recorder"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
root=$work/root

# Resolved before the timed run, so fetching it does not eat the recorder's time.
strace=$(command -v strace || echo "$(nix build --no-link --print-out-paths nixpkgs#strace)/bin/strace")

put() {  # put <path under root> <content>
    mkdir -p "$(dirname "$root/$1")"
    printf '%s\n' "$2" > "$root/$1"
}

pane=sys/fs/cgroup/user.slice/user-1001.slice/user@1001.service/tmux-spawn-04a022ba-0a66-4f6d-8220-46e4b6481a45.scope
put proc/loadavg "1.37 1.12 0.98 3/1204 482211"
put proc/meminfo "$(printf 'MemTotal: 65536000 kB\nMemAvailable: 20971520 kB\nSwapTotal: 0 kB\nSwapFree: 0 kB')"
put proc/pressure/memory "$(printf 'some avg10=1.52 avg60=0.83 avg300=0.21 total=4817352\nfull avg10=0.94 avg60=0.51 avg300=0.12 total=2941185')"
put sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq 3400000
# Both sensor sets' devices, so whichever host the run is reads them all.
put sys/class/thermal/thermal_zone0/type x86_pkg_temp
put sys/class/thermal/thermal_zone0/temp 67000
put sys/class/thermal/thermal_zone1/type acpitz
put sys/class/thermal/thermal_zone1/temp 16800
put sys/class/hwmon/hwmon0/name asus
put sys/class/hwmon/hwmon0/fan1_input 3100
put sys/class/hwmon/hwmon1/name k10temp
put sys/class/hwmon/hwmon1/temp1_input 54875
put sys/class/hwmon/hwmon2/name nvme
put sys/class/hwmon/hwmon2/temp1_input 38850
put sys/class/hwmon/hwmon3/name gigabyte_wmi
put sys/class/hwmon/hwmon3/temp1_input 36000
put sys/class/power_supply/AC0/type Mains
put sys/class/power_supply/AC0/online 1
put sys/fs/cgroup/memory.stat "$(printf 'anon %d\nshmem 0' $((1200 << 20)))"
put sys/fs/cgroup/cpu.stat "usage_usec 5000000"
put "$pane/memory.current" $((900 << 20))
put "$pane/memory.swap.current" 0
put "$pane/memory.stat" "$(printf 'anon %d\nshmem 0' $((900 << 20)))"
put "$pane/memory.pressure" "$(printf 'some avg10=0.00 avg60=0.12 avg300=0.40 total=81234\nfull avg10=0.00 avg60=0.05 avg300=0.20 total=41234')"
put "$pane/cpu.stat" "usage_usec 4000000"
put "$pane/cgroup.procs" 1300
put proc/1300/statm "460800 230400 57600 100 0 230400 0"
put proc/1300/comm claude
mkdir -p "$root/home/agent/repos/project"
ln -s "$root/home/agent/repos/project" "$root/proc/1300/cwd"
# A laptop's app under another user's manager and a system service, for the
# hourly counters' manager column.
app=sys/fs/cgroup/user.slice/user-1000.slice/user@1000.service/app.slice/app-firefox-1234.scope
put "$app/memory.current" $((100 << 20))
put "$app/cpu.stat" "usage_usec 7000000"
put sys/fs/cgroup/system.slice/sshd.service/memory.current $((10 << 20))
put sys/fs/cgroup/system.slice/sshd.service/cpu.stat "usage_usec 300000"

failures=0
for host in zephylux pc; do
    put proc/sys/kernel/hostname "$host"
    rm -rf "$work/state"
    HOST_RECORDER_ROOT=$root HOME=$root/home/agent XDG_STATE_HOME=$work/state \
        timeout -s INT 5 "$strace" -f -qq -o "$work/trace" \
        -e trace=clone,clone3,fork,vfork,execve,execveat,openat -e signal=none \
        "$recorder" 0.05 > /dev/null 2> "$work/stderr"

    rankings=$(grep -c '^[^,]*,(rest),' "$work"/state/host-recorder/*.top.csv 2>/dev/null)
    if [ "${rankings:-0}" -lt 3 ]; then
        echo "FAIL on $host the recorder wrote ${rankings:-0} rankings in 5 s, fewer than the 3 this check needs"
        sed 's/^/       /' "$work/stderr" | tail -20
        failures=1
        continue
    fi
    started=$(awk '/openat\(.*\.csv"/ { loop = 1 } loop && /(clone|clone3|fork|vfork|execve|execveat)\(/' "$work/trace")
    if [ -n "$started" ]; then
        echo "FAIL on $host the sampling loop started a process:"
        sed 's/^/       /' <<<"$started" | head -20
        failures=1
    else
        echo "ok   on $host the sampling loop starts no process, over $rankings rankings"
    fi

    # Each counter names its unit's manager by uid, so the same unit under two
    # users' managers is two units to the reader, not one that restarts.
    managers=$(cut -d, -f2,3 "$work"/state/host-recorder/*.counters.csv | LC_ALL=C sort -u | paste -sd' ')
    expected="manager,unit system,(root) system,sshd.service user@1000,app-firefox-1234.scope user@1001,${pane##*/}"
    if [ "$managers" = "$expected" ]; then
        echo "ok   on $host the hourly counters name each unit's manager"
    else
        echo "FAIL on $host the hourly counters' managers"
        echo "       expected: $expected"
        echo "       actual:   $managers"
        failures=1
    fi
done

exit $failures
