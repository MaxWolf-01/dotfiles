#!/usr/bin/env bash
# tier: fast
# Drive tests/check.sh and tests/check.py through small test files of their own, and check the exit code each
# hands the runner: 0 when every check passed, 1 when one failed, 77 with its reason when the file skipped.
#
# Every test file's verdict passes through these helpers, so this file reaches its own without them: a broken
# finish would otherwise pass it too.

set -uo pipefail

tests="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
wrong=0

# <what> <expected exit and output> <file body> [interpreter]: runs the body as a test file, and compares
# "<exit code>: <its last line>" with what is expected.
ends() {
    local what="$1" expected="$2" body="$3" run="${4:-bash}" out code actual
    printf '%s\n' "$body" > "$work/case"
    out=$(cd "$work" && $run case 2>&1); code=$?
    actual="$code: $(tail -1 <<<"$out")"
    if [ "$actual" = "$expected" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        wrong=1
    fi
}

sh=". '$tests/check.sh'"
ends "bash: every check passing exits 0" "0: all checks passed" "$sh
check one 1 1
finish"
ends "bash: one check failing exits 1" "1: 1 check(s) failed" "$sh
check one 1 1
check two 1 2
finish"
ends "bash: a skip exits 77 after its reason" "77: skip: no reason to run" "$sh
skip no reason to run
finish"
ends "bash: a tool missing from PATH skips, naming it" "77: skip: no-such-tool-here is not on PATH" "$sh
needs bash no-such-tool-here
finish"

python="uv run --no-project --quiet python"
py="import sys; sys.path.insert(0, '$tests'); from check import *"
ends "python: every check passing exits 0" "0: all checks passed" "$py
check('one', 1, 1)
reads = iter([1, 1])
settles('two, on the third read', 2, lambda: next(reads, 2))
finish()" "$python"
ends "python: one check failing exits 1" "1: 1 check(s) failed" "$py
check('one', 1, 1)
settles('two', 2, lambda: 3, within=0.1)
finish()" "$python"
ends "python: a skip exits 77 after its reason" "77: skip: no-such-tool-here is not on PATH" "$py
needs('no-such-tool-here')
finish()" "$python"
ends "python: a property that does not hold, or raises, fails; one that skips does not" "1: 2 check(s) failed" "$py
@prop('holds')
def a(): pass
@prop('does not hold')
def b(): expect(False, 'it does not')
@prop('raises')
def c(): raise RuntimeError('broken')
@prop('cannot be checked here')
def d(): raise Skip('no way to check it')
run_properties()
finish()" "$python"
ends "python: only the properties whose statement holds a word given run" "0: all checks passed" "$py
@prop('the one asked for')
def a(): pass
@prop('another')
def b(): expect(False, 'it does not')
run_properties(only=['asked'])
finish()" "$python"

echo
[ "$wrong" -eq 0 ] && echo "all checks passed" || echo "the helpers hand the runner a wrong verdict"
exit "$wrong"
