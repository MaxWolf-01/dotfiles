#!/usr/bin/env bash
# Drive bin/run-log and check what it writes. Run it directly; no framework.
#
# The point of these cases is the contract the run log's readers depend on: an
# envelope with fixed keys and honest types, and a call it cannot make sense of
# leaving the log untouched rather than putting a half-record in front of them.

set -uo pipefail

run_log="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/run-log"
export RUN_LOG_DIR
RUN_LOG_DIR=$(mktemp -d)
trap 'rm -rf "$RUN_LOG_DIR"' EXIT

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# --- accepted calls land one well-formed line each

"$run_log" working-rsyncnet ok --stats '{"snapshot_id":"0a1b2c3d","data_added":4096}'
check "ok run exits 0" 0 $?
line=$(cat "$RUN_LOG_DIR/working-rsyncnet.jsonl")
check "envelope keys" \
    "outcome reason stats ts unit" \
    "$(jq -r 'keys | join(" ")' <<<"$line")"
check "outcome" ok "$(jq -r .outcome <<<"$line")"
check "no reason on a green run" null "$(jq -r '.reason // "null"' <<<"$line")"
check "unit" working-rsyncnet "$(jq -r .unit <<<"$line")"
# The reason snapshot ids are passed through --stats rather than inferred from a
# key=value string: all-digit ids exist, and turning one into a number loses it.
check "stats keep the caller's types" \
    "string number" \
    "$(jq -r '[.stats.snapshot_id, .stats.data_added | type] | join(" ")' <<<"$line")"
check "timestamp is offset-aware ISO 8601" \
    "yes" \
    "$(jq -r 'if .ts | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}[+-][0-9:]{5}$") then "yes" else .ts end' <<<"$line")"

"$run_log" phone-sync skip --reason "phone is not reachable"
check "skip with a reason exits 0" 0 $?
check "skip reason survives" \
    "skip phone is not reachable" \
    "$(jq -r '"\(.outcome) \(.reason)"' "$RUN_LOG_DIR/phone-sync.jsonl")"

"$run_log" youtube-download fail --reason 'quotes " and
newlines' --stats '{"playlists_failed":["Music"]}'
check "fail with an awkward reason exits 0" 0 $?
check "the awkward reason round-trips" \
    'quotes " and
newlines' \
    "$(jq -r .reason "$RUN_LOG_DIR/youtube-download.jsonl")"

"$run_log" phone-sync ok --stats '{"files_synced":3}'
check "a second run appends" 2 "$(wc -l < "$RUN_LOG_DIR/phone-sync.jsonl")"
check "every line is valid JSON" \
    "yes" \
    "$(cat "$RUN_LOG_DIR"/*.jsonl | jq -c . >/dev/null 2>&1 && echo yes || echo no)"

# --- rejected calls write nothing at all

before=$(cat "$RUN_LOG_DIR"/*.jsonl | wc -l)

reject() {
    local what="$1"; shift
    local out rc
    out=$("$run_log" "$@" 2>&1); rc=$?
    if [ "$rc" -eq 0 ]; then
        echo "FAIL $what — exited 0, should have refused"
        failures=$((failures + 1))
    elif [ -z "$out" ]; then
        echo "FAIL $what — refused silently, should have said why"
        failures=$((failures + 1))
    else
        echo "ok   $what → rc=$rc, ${out%%$'\n'*}"
    fi
}

reject "no arguments"
reject "only a unit" some-unit
reject "unknown outcome" some-unit green
reject "unit name escaping the log dir" ../../evil ok
reject "unit name with a slash" logs/evil ok
reject "skip without a reason" some-unit skip
reject "fail without a reason" some-unit fail
reject "stats that are an array" some-unit ok --stats '[1,2]'
reject "stats that are not JSON" some-unit ok --stats 'nope'
reject "stats that are a bare number" some-unit ok --stats '42'
reject "unknown option" some-unit ok --wat
reject "--reason with no value" some-unit skip --reason
reject "--stats with no value" some-unit ok --stats

check "rejected calls wrote nothing" "$before" "$(cat "$RUN_LOG_DIR"/*.jsonl | wc -l)"
check "no file was created for a rejected unit" \
    "" \
    "$(find "$RUN_LOG_DIR" -name '*some-unit*' -o -name '*evil*')"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
    exit 0
fi
echo "$failures check(s) failed"
exit 1
