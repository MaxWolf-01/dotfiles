#!/usr/bin/env bash
# tier: fast
# Check that every executable git tracks in bin/ handles -h and --help, by reading its
# source. Nothing is run. A script passes when it imports tyro or builds an argparse
# parser, both of which answer --help themselves, or when it names -h and --help in a
# branch of its own. Where that branch sits is not checked: one placed after the script
# has already acted passes here, and a review has to catch it.

set -uo pipefail

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"

repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
handles_help='^(import tyro|from tyro)|argparse\.ArgumentParser|-h\|--help|"-h".*"--help"'
# Wrappers that pass every argument on to a script that answers --help itself.
wrappers=(ccx)

while IFS= read -r -d '' path; do
    [[ -x $repo/$path ]] || continue
    [[ " ${wrappers[*]} " == *" ${path#bin/} "* ]] && continue
    grep -qE "$handles_help" "$repo/$path" && handles=yes || handles=no
    check "$path handles -h and --help" yes "$handles"
done < <(git -C "$repo" ls-files -z bin)

finish
