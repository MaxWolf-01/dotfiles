#!/usr/bin/env bash
# Drive bin/hibernate against stubbed holds. Run it directly; no framework.
#
# The decisions under test: a hold refuses the hibernate and says whose it is
# and how to clear it, rather than passing systemd's anonymous failure through;
# -f overrides that and says what it stomped before the machine stops
# executing. The kernel check above both is not stubbed, so this only runs
# meaningfully when the running kernel matches /boot/vmlinuz -- which it must,
# or hibernate is refusing for that reason and every case below is moot.

set -uo pipefail

hibernate="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/hibernate"
stub=$(mktemp -d)
trap 'rm -rf "$stub"' EXIT
export PATH="$stub:$PATH"

# The stubs stand in for what hibernate asks the system: what is holding sleep
# open, and then the hibernate itself. For `in`, also the lid hold it takes and
# the wait, which returns at once and can make a hold appear.
cat > "$stub/systemctl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" > "$STUB_DIR/systemctl.args"
EOF
cat > "$stub/nosleep" <<'EOF'
#!/usr/bin/env bash
if [ "$1" = --list ]; then cat "$STUB_DIR/holds"; exit; fi
printf '%s\n' "$*" > "$STUB_DIR/nosleep.args"
shift 2
"$@"
EOF
cat > "$stub/systemd-inhibit" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" > "$STUB_DIR/inhibit.args"
while [[ $1 == --* ]]; do shift; done
"$@"
EOF
cat > "$stub/sleep" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" > "$STUB_DIR/sleep.args"
if [ -f "$STUB_DIR/appears" ]; then cp "$STUB_DIR/appears" "$STUB_DIR/holds"; fi
EOF
chmod +x "$stub/systemctl" "$stub/nosleep" "$stub/systemd-inhibit" "$stub/sleep"
export STUB_DIR=$stub

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

if [ "$(uname -r)" != "$(basename "$(readlink -f /boot/vmlinuz)" | sed 's/^vmlinuz-//')" ]; then
    echo "SKIP a kernel upgrade is pending, so hibernate refuses before reaching any case here"
    exit 0
fi

held='job diffview-job  diffview --watch  pts/51  2h13m  job stop diffview-job'

# --- nothing holding sleep: the ordinary path, unchanged

echo "nothing is holding sleep open" > "$stub/holds"
rm -f "$stub/systemctl.args"
"$hibernate" >/dev/null 2>&1
check "a clear machine hibernates" 0 $?
check "and without -i, so a later hold still gets its say" \
    "hibernate" "$(cat "$stub/systemctl.args")"

# --- a hold: refuse, and hand over the answer rather than systemd's silence

printf '%s\n' "$held" > "$stub/holds"
rm -f "$stub/systemctl.args"
out=$("$hibernate" 2>&1)
check "a hold refuses the hibernate" 1 $?
check "and nothing was asked of systemd" "no args" "$(cat "$stub/systemctl.args" 2>/dev/null || echo 'no args')"
check "the refusal names the holder" "yes" "$(grep -q 'job diffview-job' <<<"$out" && echo yes || echo no)"
check "and the command that clears it" "yes" "$(grep -q 'job stop diffview-job' <<<"$out" && echo yes || echo no)"
check "and the way out" "yes" "$(grep -q 'hibernate -f' <<<"$out" && echo yes || echo no)"

# --- -f: go anyway, having said what dies

rm -f "$stub/systemctl.args"
out=$("$hibernate" -f 2>&1)
check "-f hibernates through a hold" 0 $?
check "with -i, which is what ignores the hold" \
    "hibernate -i" "$(cat "$stub/systemctl.args")"
# Printed before the machine stops executing, so waking to a dead build comes
# with its reason attached.
check "-f says what it stomped" "yes" "$(grep -q 'job diffview-job' <<<"$out" && echo yes || echo no)"

echo "nothing is holding sleep open" > "$stub/holds"
out=$("$hibernate" -f 2>&1)
check "-f on a clear machine says nothing about overriding" \
    "" "$(grep -o 'overriding' <<<"$out")"

# --- in: wait under a lid hold and a sleep hold, hibernate under the lid alone

reset() { rm -f "$stub"/*.args "$stub/appears"; }

echo "nothing is holding sleep open" > "$stub/holds"
reset
"$hibernate" in 2m >/dev/null 2>&1
check "in on a clear machine hibernates" 0 $?
check "after waiting the span under a sleep hold" \
    "--why hibernate in 2m sleep 120" "$(cat "$stub/nosleep.args")"
# The lid is the point: closed during the wait, it must not suspend the laptop
# the moment the wait's hold goes. Lid only, or it would refuse the hibernate.
check "and the whole of it under a lid-only hold" yes \
    "$(grep -q -- '--what=handle-lid-switch ' "$stub/inhibit.args" && echo yes || echo no)"
# Overriding a hold asks for a password, and the lid is closed.
check "without -i" "hibernate" "$(cat "$stub/systemctl.args")"

reset
"$hibernate" in soon >/dev/null 2>&1
check "a span that is not one is refused" 1 $?
check "before any hold is taken" "no args" "$(cat "$stub/inhibit.args" 2>/dev/null || echo 'no args')"

reset
"$hibernate" -f in 2m >/dev/null 2>&1
check "-f with in is refused" 1 $?
check "before any hold is taken" "no args" "$(cat "$stub/inhibit.args" 2>/dev/null || echo 'no args')"

# Refused up front, while someone is at the keyboard to act on it.
printf '%s\n' "$held" > "$stub/holds"
reset
out=$("$hibernate" in 2m 2>&1)
check "in refuses a hold that is already there" 1 $?
check "without starting the wait" "no args" "$(cat "$stub/inhibit.args" 2>/dev/null || echo 'no args')"
check "and names it" yes "$(grep -q 'job stop diffview-job' <<<"$out" && echo yes || echo no)"

echo "nothing is holding sleep open" > "$stub/holds"
reset
printf '%s\n' "$held" > "$stub/appears"
"$hibernate" in 2m >/dev/null 2>&1
check "a hold taken during the wait refuses the hibernate" 1 $?
check "and nothing was asked of systemd" "no args" "$(cat "$stub/systemctl.args" 2>/dev/null || echo 'no args')"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
else
    echo "$failures check(s) failed"
fi
exit $((failures > 0))
