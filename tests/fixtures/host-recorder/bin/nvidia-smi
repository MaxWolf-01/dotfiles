#!/bin/sh
# Stands in for nvidia-smi under a fixture root: answers with what
# $HOST_RECORDER_ROOT/nvidia-smi holds, and fails as on a host without the
# driver when that file is not there. Builtins only, so a trace of the recorder
# shows one process per query. When the file says `hang`, it never answers, as
# under a wedged driver, and leaves its pid in nvidia-smi.hung for the test to
# kill.
[ -r "$HOST_RECORDER_ROOT/nvidia-smi" ] || exit 9
while IFS= read -r line; do
    if [ "$line" = hang ]; then
        echo $$ >> "$HOST_RECORDER_ROOT/nvidia-smi.hung"
        exec sleep 600
    fi
    printf '%s\n' "$line"
done < "$HOST_RECORDER_ROOT/nvidia-smi"
