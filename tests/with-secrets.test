#!/usr/bin/env bash
# Drive bin/with-secrets against dummy credentials and check what reaches the command.
# Run it directly; no framework.
#
# The cases here are the promises the wrapper makes: that the named files' variables
# reach the command and nothing else does, that an argument arrives byte for byte
# however many names wrap it, that an unknown name stops before running anything, and
# that no secret is ever visible in a process's arguments.
#
# HOME is redirected at a scratch directory holding a throwaway age key and dummy
# credential files, so the wrapper resolves its real path under a fake home and the
# path logic is tested rather than mocked.

set -uo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

env_dir="$work/home/.dotfiles/secrets/creds/env"
mkdir -p "$env_dir"
age-keygen -o "$work/key.txt" 2>/dev/null
recipient=$(grep 'public key' "$work/key.txt" | sed 's/.*: //')

# COLLIDE is defined by two files on purpose: the wrapper documents that a later
# name wins, and nothing else in the suite would catch that promise breaking.
write_creds() {
    local name="$1"; shift
    printf '%s\n' "$@" > "$env_dir/$name.env"
    sops encrypt --in-place --age "$recipient" "$env_dir/$name.env"
}
write_creds alpha 'ALPHA_TOKEN=aaa' 'COLLIDE=from-alpha'
write_creds beta 'BETA_TOKEN=bbb'
write_creds gamma 'GAMMA_TOKEN=ccc' 'COLLIDE=from-gamma'

export HOME="$work/home"
export SOPS_AGE_KEY_FILE="$work/key.txt"
run() { "$bin_dir/with-secrets" "$@"; }

check "one name sets its variable" \
    "aaa" "$(run alpha sh -c 'printf %s "$ALPHA_TOKEN"')"

check "three names set all three" \
    "aaa bbb ccc" "$(run alpha,beta,gamma sh -c 'printf "%s %s %s" "$ALPHA_TOKEN" "$BETA_TOKEN" "$GAMMA_TOKEN"')"

check "a later name wins a collision" \
    "from-gamma" "$(run alpha,gamma sh -c 'printf %s "$COLLIDE"')"

check "a name not asked for is absent" \
    "" "$(run alpha sh -c 'printf %s "${BETA_TOKEN-}"')"

# Every awkward shape in one argument list: a space, both quote characters, and two
# things an intermediate `sh -c` would expand if the quoting were wrong.
expected=$'[a b]\n[q"z]\n[it\'s]\n[$HOME]\n[$(date)]'
check "arguments survive one name" \
    "$expected" "$(run alpha printf '[%s]\n' 'a b' 'q"z' "it's" '$HOME' '$(date)')"
check "arguments survive three names" \
    "$expected" "$(run alpha,beta,gamma printf '[%s]\n' 'a b' 'q"z' "it's" '$HOME' '$(date)')"

# The wrapper exists partly to keep secrets out of argv, where any process on the
# machine can read them for as long as the command runs.
cmdline=$(run alpha,beta sh -c 'tr "\0" " " < /proc/self/cmdline')
case "$cmdline" in
    *aaa*|*bbb*) check "no secret reaches the command line" "absent" "present: $cmdline" ;;
    *)           check "no secret reaches the command line" "absent" "absent" ;;
esac

out=$(run nosuchname true 2>&1); rc=$?
check "an unknown name exits 1" 1 "$rc"
case "$out" in
    *"$env_dir/nosuchname.env"*) check "an unknown name names the path it looked for" "yes" "yes" ;;
    *)                           check "an unknown name names the path it looked for" "yes" "no: $out" ;;
esac

marker="$work/should-not-exist"
run nosuchname touch "$marker" >/dev/null 2>&1
check "an unknown name runs no command" "absent" "$([ -e "$marker" ] && echo present || echo absent)"

run alpha >/dev/null 2>&1; rc=$?
check "a name with no command exits 2" 2 "$rc"

run >/dev/null 2>&1; rc=$?
check "no arguments exits 2" 2 "$rc"

run --help >/dev/null 2>&1; rc=$?
check "--help exits 0" 0 "$rc"

# --list is the read path the whole layout exists for: an agent asking what is
# available must not need the key, so it runs here with no key configured at all.
listing=$(env -u SOPS_AGE_KEY_FILE "$bin_dir/with-secrets" --list 2>&1)
check "--list works without the age key" \
    "alpha ALPHA_TOKEN COLLIDE" "$(echo "$listing" | awk '$1=="alpha"' | tr -s ' ')"
case "$listing" in
    *aaa*|*bbb*|*ccc*) check "--list prints no values" "yes" "no" ;;
    *)                 check "--list prints no values" "yes" "yes" ;;
esac

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
    exit 0
fi
echo "$failures check(s) failed"
exit 1
