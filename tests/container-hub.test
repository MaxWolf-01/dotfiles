#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Drive bin/container-hub and bin/claude-browser over HTTP and check the ticket pages-open-into-containers
promises beyond the work-containers properties: where a page lands, what never opens, what leaves.
Run it directly; no framework.

One hub on a free port, never 8377, with HOME and its state in a scratch directory. Two repos, alpha and
beta, each with an agent repo whose tickets were committed by sessions (a `Session:` trailer).
"""

import json
import os
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

BIN = Path(__file__).resolve().parents[1] / "bin"
SCRATCH = Path(tempfile.mkdtemp(prefix="container-hub-test."))
HOME = SCRATCH / "home"
ORCHESTRATOR = "aaaaaaaa-0000-4000-8000-000000000001"
WORKER = "bbbbbbbb-0000-4000-8000-000000000002"
STRANGER = "cccccccc-0000-4000-8000-000000000003"

failures = 0


def check(what: str, expected, actual) -> None:
    global failures
    if expected == actual:
        print(f"ok   {what}")
    else:
        failures += 1
        print(f"FAIL {what}\n       expected: {expected!r}\n       actual:   {actual!r}")


def env(**extra: str) -> dict:
    keep = {k: v for k, v in os.environ.items()
            if not k.startswith(("CLAUDE", "MX_", "GIT_", "XDG_", "CONTAINER_HUB"))}
    for k in ("UV_CACHE_DIR", "UV_PYTHON_INSTALL_DIR"):  # uv's own, which would otherwise move into HOME
        keep[k] = subprocess.run(["uv", *(("cache", "dir") if k == "UV_CACHE_DIR" else ("python", "dir"))],
                                 capture_output=True, text=True, check=True).stdout.strip()
    return {**keep, "HOME": str(HOME), "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1", **extra}


ENV = env()


def git(cwd: Path, *args: str) -> None:
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *args], cwd=cwd, env=ENV,
                   check=True, capture_output=True)


TICKET = "---\nstatus: {status}\n{parent}priority: 2\nsize: S\n---\n\n# {slug}\n\n## Brief\n\n{slug}.\n\n## Acceptance criteria\n\n## Comments\n"


def ticket(agent: Path, slug: str, status: str = "open", parent: str | None = None) -> None:
    (agent / "tickets" / f"{slug}.md").write_text(
        TICKET.format(status=status, parent=f"parent: {parent}\n" if parent else "", slug=slug))


def repo(name: str, tickets: list[tuple[str, str | None, str]]) -> Path:
    """A code repo holding an agent repo; each ticket (slug, parent, session) committed by its session."""
    code = HOME / "repos" / name
    agent = code / "agent"
    (agent / "tickets").mkdir(parents=True)
    git(code, "init", "-q")
    (code / ".git" / "info" / "exclude").write_text("agent/\n")
    (code / "README.md").write_text(name)
    git(code, "add", "README.md")
    git(code, "commit", "-q", "-m", "init")
    git(agent, "init", "-q")
    for slug, parent, session in tickets:
        ticket(agent, slug, "claimed" if parent else "open", parent)
        git(agent, "add", f"tickets/{slug}.md")
        git(agent, "commit", "-q", "-m", f"file {slug}", "-m", f"Session: {session}")
    return code


def page(path: Path, body: str = "<!doctype html><p>a page</p>") -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body)
    return path


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


PORT = free_port()
ORIGIN = f"http://127.0.0.1:{PORT}"


def request(method: str, path: str, body: dict | None = None, headers: dict | None = None) -> tuple[int, dict | bytes]:
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(ORIGIN + path, data=data, method=method,
                                 headers={"Content-Type": "application/json", **(headers or {})})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            status, raw = r.status, r.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, raw


def open_page(target, session: str | None = None, **extra) -> dict:
    return request("POST", "/api/open", {"target": str(target), **({"session": session} if session else {}), **extra})[1]


def view(key: str) -> tuple[int, dict]:
    return request("GET", "/api/c/" + urllib.parse.quote(key, safe=""))


# --------------------------------------------------------------------------

HOME.mkdir()
(HOME / ".cache/diffview").mkdir(parents=True)
(HOME / ".cache/diffview/highlight.min.js").write_text("")  # diffview would fetch it otherwise
alpha = repo("alpha", [("map-columns", None, ORCHESTRATOR), ("csv-import", "map-columns", ORCHESTRATOR)])
beta = repo("beta", [("map-columns", None, STRANGER)])
gamma = repo("gamma", [("one-flow", None, WORKER)])  # opened only through claude-browser
hub = subprocess.Popen([BIN / "container-hub", "--port", str(PORT), "--state", str(SCRATCH / "state")],
                       env=ENV, stdout=subprocess.DEVNULL, stderr=(SCRATCH / "hub.log").open("w"), start_new_session=True)
try:
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        try:
            socket.create_connection(("127.0.0.1", PORT), timeout=1).close()
            break
        except OSError:
            time.sleep(0.1)

    # --- where a page lands

    a = open_page(page(alpha / "agent/show/csv-import/index.html"), WORKER)
    b = open_page(page(beta / "agent/show/map-columns/index.html"), WORKER)
    check("a child ticket's page lands in its tree's container", "map-columns", a["container"].split("@")[0])
    check("two repos whose trees share a slug get two containers", True, a["container"] != b["container"])
    check("the first open of a page adds it", "added", a["action"])
    again = open_page(alpha / "agent/show/csv-import/index.html", STRANGER)
    check("a second open of the same page brings the same member forward", ("reopened", a["id"]), (again["action"], again["id"]))
    check("...and adds no second copy", 1, len(view(a["container"])[1]["members"]))

    note = page(HOME / "notes" / "scratch.html")
    by_trailer = open_page(note, ORCHESTRATOR, cwd=str(alpha))
    check("a page under no ticket goes to the tree its session last committed on", a["container"], by_trailer["container"])
    check("...in that session's group", ORCHESTRATOR, next(m for m in view(a["container"])[1]["members"] if m["id"] == by_trailer["id"])["group"])
    check("a session with no commits keeps its pages in its own container", f"session-{STRANGER}",
          open_page(note, STRANGER, cwd=str(alpha))["container"])
    check("--container overrides the derivation", "elsewhere", open_page(note, ORCHESTRATOR, container="elsewhere")["container"])
    member_of = lambda opened: next(m for m in view(opened["container"])[1]["members"] if m["id"] == opened["id"])
    session_page = open_page(page(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html"), ORCHESTRATOR)
    check("a session page goes to its session's group, under no ticket", (ORCHESTRATOR, None),
          (member_of(session_page)["group"], member_of(session_page)["ticket"]))
    linked = open_page(page(alpha / "agent/show/map-columns/index.html"), container=a["container"], group=WORKER, by="user")
    check("a link opened from the view keeps its page's ticket", "map-columns", member_of(linked)["ticket"])

    groups = view(a["container"])[1]["groups"]
    mine = next(g for g in groups if g["id"] == ORCHESTRATOR)
    check("a group is named after the top of the tickets its session committed on", "map-columns", mine["name"])
    check("a worker report is not one of the group's artefacts", False,
          any(x["url"].endswith("report.md") for g in groups for x in g["artefacts"]))

    # --- what never opens (story 7)

    report = page(alpha / "agent/show/csv-import/report.md", "## Comments\n")
    check("a worker's report never opens", True, "skipped" in open_page(report, WORKER))
    agent = alpha / "agent"
    git(agent, "commit", "-q", "--allow-empty", "-m", "base")
    ticket(agent, "csv-import", "review", "map-columns")
    git(agent, "commit", "-q", "-am", "csv-import in review", "-m", f"Session: {ORCHESTRATOR}")
    tracker_diff = agent / "diffviews" / "tracker.html"
    tracker_diff.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run([BIN / "diffview", f"{agent}@HEAD~1..HEAD", "-o", str(tracker_diff), "--no-auto-summary"],
                   env=ENV, check=True, capture_output=True)
    check("a diffview of tracker files never opens", True, "skipped" in open_page(tracker_diff, ORCHESTRATOR))
    (alpha / "notes.txt").write_text("one\n")
    git(alpha, "add", "notes.txt")
    git(alpha, "commit", "-q", "-m", "notes")
    code_diff = agent / "diffviews" / "csv-import.html"
    subprocess.run([BIN / "diffview", f"{alpha}@HEAD~1..HEAD", "-o", str(code_diff), "--no-auto-summary"],
                   env=ENV, check=True, capture_output=True)
    check("a diffview of code opens", a["container"], open_page(code_diff, ORCHESTRATOR).get("container"))

    # --- the tracker drives the view

    ticket(agent, "csv-import", "done", "map-columns")
    status = lambda: next(t["status"] for g in view(a["container"])[1]["groups"] for t in g["tickets"] if t["slug"] == "csv-import")
    check("a ticket's status in the tracker is the view's", "done", status())

    # --- serving

    status_code, health = request("GET", "/.health")
    check("/.health says diffview pages can save", {"saves": True}, health)
    served = next(m["url"] for m in view(a["container"])[1]["members"] if m["id"] == a["id"])
    check("a member is served on the hub's origin", 200, request("GET", served)[0])
    check("a request for another Host is refused", 403, request("GET", served, headers={"Host": "attacker.example:80"})[0])
    diff_url = next(m["url"] for m in view(a["container"])[1]["members"] if m["url"].endswith("csv-import.html"))
    state = {"writer": "t", "savedAt": 1, "comments": []}
    check("a diffview page saves its comments through the hub", 204,
          request("POST", diff_url + ".state.json", state, {"Origin": ORIGIN})[0])
    check("...beside the page", state, json.loads(Path(f"{code_diff}.state.json").read_text()))
    check("a state write from another origin is refused", 403,
          request("POST", diff_url + ".state.json", state, {"Origin": "http://attacker.example"})[0])

    # --- what leaves (story 14)

    gone = page(alpha / "agent/prototypes/csv-import/index.html")
    gone_id = open_page(gone, ORCHESTRATOR)["id"]
    gone.unlink()
    check("a member whose file is deleted leaves its container", False,
          any(m["id"] == gone_id for m in view(a["container"])[1]["members"]))
    index = request("GET", "/")[1].decode()
    check("the index lists every container", True, all(urllib.parse.quote(k, safe="@.-_") in index
                                                       for k in (a["container"], b["container"], f"session-{STRANGER}")))
    check("...the one opened into last first", True, index.index("elsewhere") < index.index(urllib.parse.quote(b["container"], safe="@.-_")))
    (beta / "agent/tickets/map-columns.md").unlink()
    check("a container whose tree left the tracker is gone", 404, view(b["container"])[0])
    check("...and left the index", False, urllib.parse.quote(b["container"], safe="@.-_") in request("GET", "/")[1].decode())

    # --- claude-browser with a hub

    stubs = SCRATCH / "stubs"
    stubs.mkdir()
    record = SCRATCH / "browser"
    (stubs / "brave").write_text(f'#!/bin/sh\nprintf "%s\\n" "$@" > {record}\n')
    (stubs / "systemd-run").write_text('#!/bin/sh\nwhile [ "${1#--}" != "$1" ]; do shift; done\nexec "$@"\n')
    for s in stubs.iterdir():
        s.chmod(0o755)
    local_state = HOME / ".config/BraveSoftware/Brave-Browser/Local State"
    local_state.parent.mkdir(parents=True)
    local_state.write_text(json.dumps({"profile": {"info_cache": {"Default": {"name": "Personal"}}}}))

    def browse(*args: str, session: str = WORKER, cwd: Path = gamma) -> list[str]:
        record.unlink(missing_ok=True)
        subprocess.run([BIN / "claude-browser", *args], cwd=cwd, check=True, capture_output=True, timeout=30,
                       env={**ENV, "CONTAINER_HUB_PORT": str(PORT), "CLAUDE_CODE_SESSION_ID": session,
                            "PATH": f"{stubs}:{BIN}:{ENV['PATH']}"})
        deadline = time.monotonic() + 5
        while not record.exists() and time.monotonic() < deadline:
            time.sleep(0.05)
        return record.read_text().splitlines() if record.exists() else []

    fresh = page(gamma / "agent/show/one-flow/figure.svg", '<svg xmlns="http://www.w3.org/2000/svg"/>')
    opened = browse("agent/show/one-flow/figure.svg")
    key = urllib.parse.quote(open_page(fresh, WORKER)["container"], safe="@.-_")
    check("with no view showing, claude-browser opens the container's view at the page", True,
          len(opened) == 2 and opened[1].startswith(f"{ORIGIN}/c/{key}#m"))
    check("...and the page is a member", True, any(m["path"] == str(fresh) for m in view(urllib.parse.unquote(key))[1]["members"]))
    events = urllib.request.urlopen(f"{ORIGIN}/events/{key}", timeout=10)
    events.readline()
    check("with a view showing, claude-browser starts no browser", [], browse(str(fresh)))
    events.close()
    check("a worker's report starts no browser either", [], browse(str(report)))
finally:
    os.killpg(hub.pid, signal.SIGKILL)  # `uv run` leads the group; the server is its child
    hub.wait()
    subprocess.run(["rm", "-rf", str(SCRATCH)], check=False)

print()
print("FAILED" if failures else "all ok")
sys.exit(1 if failures else 0)
