#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# ///
"""Drive bin/container-hub and bin/claude-browser over HTTP and check what the hub promises beyond the
work-containers properties: which unit a page lands in, how the rail numbers the units, what never opens, what
leaves. Run it directly; no framework.

One hub on a free port, never 8377, with HOME and its state in a scratch directory. Two repos, alpha and
beta, each with an agent repo whose tickets were committed by sessions (a `Session:` trailer). Which sessions
run is what the scratch HOME's session registry (`.claude/sessions/`) says.
"""

import contextlib
import fcntl
import hashlib
import http.client
import http.server
import json
import os
import re
import shlex
import shutil
import signal
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

BIN = Path(__file__).resolve().parents[1] / "bin"
SCRATCH = Path(tempfile.mkdtemp(prefix="container-hub-test."))
HOME = SCRATCH / "home"
TEMP = SCRATCH / "tmp"  # the temp dir of everything the test runs, beside HOME and not around it, so each guard is checked on its own
ORCHESTRATOR = "aaaaaaaa-0000-4000-8000-000000000001"
WORKER = "bbbbbbbb-0000-4000-8000-000000000002"
STRANGER = "cccccccc-0000-4000-8000-000000000003"
SPIKER = "dddddddd-0000-4000-8000-000000000004"
NOVICE = "eeeeeeee-0000-4000-8000-000000000005"  # commits on nothing
RETIRER = "ffffffff-0000-4000-8000-000000000006"
ANSWERER = "abababab-0000-4000-8000-000000000007"  # runs in a tmux pane
LATECOMER = "cdcdcdcd-0000-4000-8000-000000000008"  # renders its session page late
ASKER = "efefefef-0000-4000-8000-000000000009"  # writes turn records with questions, and chat turns

failures = 0


def check(what: str, expected, actual) -> None:
    global failures
    if expected == actual:
        print(f"ok   {what}")
    else:
        failures += 1
        print(f"FAIL {what}\n       expected: {expected!r}\n       actual:   {actual!r}")


def env(**extra: str) -> dict:
    keep = {k: v for k, v in os.environ.items()
            if not k.startswith(("CLAUDE", "MX_", "GIT_", "XDG_", "CONTAINER_HUB", "TMUX"))}
    for k in ("UV_CACHE_DIR", "UV_PYTHON_INSTALL_DIR"):  # uv's own, which would otherwise move into HOME
        keep[k] = subprocess.run(["uv", *(("cache", "dir") if k == "UV_CACHE_DIR" else ("python", "dir"))],
                                 capture_output=True, text=True, check=True).stdout.strip()
    return {**keep, "HOME": str(HOME), "GIT_CONFIG_GLOBAL": os.devnull, "GIT_CONFIG_NOSYSTEM": "1", **extra}


# Every tmux call, the hub's and the test's, goes through a tmux that passes on only those naming the test's own
# server's socket, and records the rest: nothing here may reach a server the test did not start.
TMUX_SOCKET = SCRATCH / "tmux.sock"
TMUX_REFUSED = SCRATCH / "tmux-refused"
TMUX = SCRATCH / "shim" / "tmux"
TMUX.parent.mkdir()
TMUX.write_text(f"""#!/usr/bin/env bash
[ "$1" = -S ] && [ "$2" = {shlex.quote(str(TMUX_SOCKET))} ] && exec {shlex.quote(shutil.which("tmux"))} "$@"
printf '%s\\n' "$*" >> {shlex.quote(str(TMUX_REFUSED))}
exit 1
""")
TMUX.chmod(0o755)
ENV = env(TMPDIR=str(TEMP))
ENV["PATH"] = f"{TMUX.parent}:{ENV['PATH']}"
HUB_FLAGS = ["--tmux-socket", str(TMUX_SOCKET)]


def git(cwd: Path, *args: str) -> None:
    subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *args], cwd=cwd, env=ENV,
                   check=True, capture_output=True)


TICKET = "---\nstatus: {status}\n{parent}priority: 2\nsize: S\n---\n\n# {slug}\n\n## Brief\n\n{slug}.\n\n## Acceptance criteria\n\n## Comments\n"


def ticket(agent: Path, slug: str, status: str = "open", parent: str | None = None) -> None:
    (agent / "tickets" / f"{slug}.md").write_text(
        TICKET.format(status=status, parent=f"parent: {parent}\n" if parent else "", slug=slug))


def repo(name: str, tickets: list[tuple[str, str | None, str]]) -> Path:
    """A code repo holding an agent repo; each ticket (slug, parent, session) committed by its session."""
    code = HOME / "repos" / name
    agent = code / "agent"
    (agent / "tickets").mkdir(parents=True)
    git(code, "init", "-q")
    (code / ".git" / "info" / "exclude").write_text("agent/\n")
    (code / "README.md").write_text(name)
    git(code, "add", "README.md")
    git(code, "commit", "-q", "-m", "init")
    git(agent, "init", "-q")
    for slug, parent, session in tickets:
        ticket(agent, slug, "claimed" if parent else "open", parent)
        git(agent, "add", f"tickets/{slug}.md")
        git(agent, "commit", "-q", "-m", f"file {slug}", "-m", f"Session: {session}")
    return code


def page(path: Path, body: str = "<!doctype html><p>a page</p>") -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body)
    return path


SELF_STARTED = Path("/proc/self/stat").read_text().rsplit(")", 1)[1].split()[19]


def registered(session: str, status: str = "idle", at: float | None = None, pid: int | None = None,
               started: str | None = SELF_STARTED, name: str | None = None, tmux: str | None = None,
               waiting_for: str | None = None) -> None:
    """The session's file in the registry, as Claude Code writes it while the session's process runs: by default
    this test's own process, which runs for as long as the hub reads it."""
    entry = {"pid": pid or os.getpid(), "sessionId": session, "status": status,
             "statusUpdatedAt": int((at or time.time()) * 1000), **({"procStart": started} if started else {}),
             **({"name": name} if name else {}), **({"tmux": tmux} if tmux else {}),
             **({"waitingFor": waiting_for} if waiting_for else {})}
    path = HOME / ".claude" / "sessions" / f"{session[:8]}.json"  # named by the pid there; any name reads alike
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(entry))


def statusline(session: str, at: float, config_dir: Path | str = HOME / ".claude", context: tuple | None = None,
               five_hour: tuple | None = None, seven_day: tuple | None = None) -> None:
    """What the statusline keeps of a render: Claude Code's statusline input as received, with the account it ran
    under and when it ran added. A window is (used percentage, resets at); a pro account's input carries none."""
    data = {"session_id": session, "model": {"id": "claude-opus-5-5", "display_name": "Opus"},
            "workspace": {"current_dir": str(HOME)}, "config_dir": str(config_dir), "written_at": at,
            **({"context_window": {"used_percentage": context[0], "total_input_tokens": context[1],
                                   "context_window_size": 200000}} if context else {}),
            "rate_limits": {name: {"used_percentage": w[0], "resets_at": w[1]}
                            for name, w in (("five_hour", five_hour), ("seven_day", seven_day)) if w}}
    path = HOME / ".cache/claude-statusline" / f"{session}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data))


def turn_record(session_dir: Path, number: int, headline: str, questions: tuple[str, ...] = (), at: float | None = None,
                **front: dict[str, str]) -> None:
    """A turn record in the shape the mx plugin's RULES.md gives it, written at `at`: its frontmatter's `answered`
    and `superseded` each a mapping of question tags."""
    path = session_dir / "turns" / f"{number:02d}.md"
    path.parent.mkdir(parents=True, exist_ok=True)
    tables = "".join(f"{name}:\n" + "".join(f"  {tag}: {value}\n" for tag, value in table.items()) for name, table in front.items())
    asked = "\n## Questions\n\n" + "".join(f"- [{q}] **Which way, {q}?** A call only the user can make.\n  - (a) this way *my pick*\n  - (b) that way\n"
                                                for q in questions) if questions else ""
    path.write_text(f"---\ndate: 2026-10-07\n{tables}---\n\n# {headline}\n{asked}")
    if at:
        os.utime(path, (at, at))


def chat_turn(session_dir: Path, reply: str, at: float) -> None:
    """A chat turn, as the Stop hook records one at `at`."""
    when = time.gmtime(at)
    path = session_dir / "turns" / time.strftime("chat-%Y%m%dT%H%M%SZ.md", when)
    path.write_text(f"---\ndate: 2026-10-07\nchat: {time.strftime('%Y-%m-%dT%H:%M:%S+00:00', when)}\n---\n\n{reply}\n")


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


PORT = free_port()
ORIGIN = f"http://127.0.0.1:{PORT}"
TEMP_PAGE = TEMP / f"container-hub-test-{PORT}.html"  # directly in the temp dir


def request(method: str, path: str, body: dict | None = None, headers: dict | None = None,
            origin: str = ORIGIN, data: bytes | None = None) -> tuple[int, dict | bytes]:
    data = data if body is None else json.dumps(body).encode()
    req = urllib.request.Request(origin + path, data=data, method=method,
                                 headers={"Content-Type": "application/json", **(headers or {})})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            status, raw = r.status, r.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    try:
        return status, json.loads(raw)
    except ValueError:
        return status, raw


def open_page(target, session: str | None = None, **extra) -> dict:
    return request("POST", "/api/open", {"target": str(target), **({"session": session} if session else {}), **extra})[1]


def view(key: str) -> tuple[int, dict]:
    return request("GET", "/api/u/" + urllib.parse.quote(key, safe=""))


def rail() -> list[dict]:
    return request("GET", "/api/hub")[1]["units"]


def listening_ports(root: int) -> list[int]:
    """The TCP ports a process and every process under it listen on, read from /proc."""
    children: dict[int, list[int]] = {}
    for stat in Path("/proc").glob("[0-9]*/stat"):
        try:
            pid, rest = stat.read_text().split(" ", 1)
        except OSError:
            continue
        children.setdefault(int(rest.rsplit(")", 1)[1].split()[1]), []).append(int(pid))
    tree, todo = set(), [root]
    while todo:
        tree.add(pid := todo.pop())
        todo += children.get(pid, [])
    sockets = set()
    for pid in tree:
        for fd in Path(f"/proc/{pid}/fd").glob("*"):
            with contextlib.suppress(OSError):
                if (link := os.readlink(fd)).startswith("socket:["):
                    sockets.add(link[len("socket:["):-1])
    return [int(f[1].rsplit(":", 1)[1], 16) for table in ("/proc/net/tcp", "/proc/net/tcp6")
            for f in (line.split() for line in Path(table).read_text().splitlines()[1:]) if f[3] == "0A" and f[9] in sockets]


def tab_came_and_went() -> None:
    """A hub tab that opens and closes again, as the one claude-browser last opened would: the next open with none
    listening opens one at once, however recently the last did."""
    tab = urllib.request.urlopen(f"{ORIGIN}/events", timeout=10)
    tab.readline()
    tab.close()
    time.sleep(2)  # the hub looks for a closed tab once a second


# --------------------------------------------------------------------------

HOME.mkdir()
TEMP.mkdir()
HLJS = HOME / ".cache/diffview" / ("hljs-" + re.search(r'HLJS_VERSION = "(.+)"', (BIN / "diffview").read_text())[1])
HLJS.mkdir(parents=True)
(HLJS / "highlight.min.js").write_text("")  # fails its pin, so diffview neither fetches nor highlights
alpha = repo("alpha", [("map-columns", None, ORCHESTRATOR), ("csv-import", "map-columns", ORCHESTRATOR)])
beta = repo("beta", [("map-columns", None, STRANGER)])
gamma = repo("gamma", [("one-flow", None, WORKER)])  # opened only through claude-browser
agent = alpha / "agent"
# the session page's reader, which the hub loads from the newest mx plugin: the one this machine has
READER = max(Path.home().glob(".claude*/plugins/cache/*/mx/*/skills/session-page/session_page.py"),
             key=lambda p: tuple(int(x) if x.isdigit() else 0 for x in p.parents[2].name.split(".")), default=None)
if READER:
    (HOME / ".claude/plugins/cache/market/mx").mkdir(parents=True)
    (HOME / ".claude/plugins/cache/market/mx" / READER.parents[2].name).symlink_to(READER.parents[2])
hub = subprocess.Popen([BIN / "container-hub", "--port", str(PORT), "--state", str(SCRATCH / "state"), *HUB_FLAGS],
                       env=ENV, stdout=subprocess.DEVNULL, stderr=(SCRATCH / "hub.log").open("w"), start_new_session=True)
try:
    deadline = time.monotonic() + 60
    while time.monotonic() < deadline:
        try:
            socket.create_connection(("127.0.0.1", PORT), timeout=1).close()
            break
        except OSError:
            time.sleep(0.1)
    member_of = lambda opened: next(m for m in view(opened["unit"])[1]["members"] if m["id"] == opened["id"])

    # --- where a page lands

    a = open_page(page(alpha / "agent/show/csv-import/index.html"), WORKER)
    check("a page goes to the unit of the session that opened it, whatever ticket its path names", WORKER, a["unit"])
    check("...which has the tree of that ticket beside it, its repo, and no board while the repo has none", ("map-columns", "alpha", None),
          tuple(view(a["unit"])[1][k] for k in ("tree", "repo", "board")))
    b = open_page(page(beta / "agent/show/map-columns/index.html"), WORKER)
    check("a session's pages in two repos are one unit", (WORKER, 2), (b["unit"], len(view(WORKER)[1]["members"])))
    check("the first open of a page adds it", "added", a["action"])
    request("POST", "/api/close", {"unit": a["unit"], "id": a["id"]})
    check("a closed page stays a member, closed", True, member_of(a)["closed"])
    check("closing in a unit that does not exist, or a page it does not hold, is not found", (404, 404),
          (request("POST", "/api/close", {"unit": "no-such-unit", "id": a["id"]})[0],
           request("POST", "/api/close", {"unit": a["unit"], "id": "m0000000000"})[0]))
    # hub-layout-pass 4
    check("the hub keeps no seen marks: no route takes one, and neither the rail nor a unit carries any", (404, False, False),
          (request("POST", "/api/seen", {"url": member_of(a)["url"], "seen": True})[0], "seen" in request("GET", "/api/hub")[1],
           "seen" in view(a["unit"])[1]))
    events = urllib.request.urlopen(f"{ORIGIN}/events", timeout=10)
    events.readline()
    again = open_page(alpha / "agent/show/csv-import/index.html", WORKER)
    check("a second open of the same page brings the same member forward", ("reopened", a["id"]), (again["action"], again["id"]))
    check("...open again", False, member_of(a)["closed"])
    check("...and adds no second copy", 2, len(view(a["unit"])[1]["members"]))
    while not (line := events.readline().decode()).startswith("data:"):
        pass
    check("...and tells a listening hub tab to reload it, in its unit", ("reopened", WORKER, a["id"]),
          tuple(json.loads(line[5:])[k] for k in ("type", "unit", "id")))
    events.close()
    quiet = http.client.HTTPConnection("127.0.0.1", PORT, timeout=3)
    quiet.request("GET", "/events")
    stream, heard = quiet.getresponse(), []
    with contextlib.suppress(TimeoutError, OSError):
        while line := stream.readline().decode():
            heard += [line] if line.startswith("data:") else []
    stream.close()  # the socket stays open while the response holds it, and a tab listening would launch none
    quiet.close()
    check("a hub tab that starts listening hears nothing while nothing changes", [], heard)
    by_stranger = open_page(alpha / "agent/show/csv-import/index.html", STRANGER)
    check("the same page opened by another session is a member of that session's unit too", (STRANGER, a["id"], 2),
          (by_stranger["unit"], by_stranger["id"], len(view(WORKER)[1]["members"])))

    note = page(HOME / "notes" / "scratch.html")
    by_trailer = open_page(note, ORCHESTRATOR, cwd=str(alpha))
    check("a page under no ticket goes to its session's unit", ORCHESTRATOR, by_trailer["unit"])
    check("...as a page of the ticket the session committed on last", "csv-import", member_of(by_trailer)["ticket"])
    check("...whose tree is beside the unit's title", "map-columns", view(ORCHESTRATOR)[1]["tree"])
    ticket(agent, "drop-zone")
    git(agent, "add", "tickets/drop-zone.md")
    git(agent, "commit", "-q", "-m", "file drop-zone", "-m", f"Session: {ORCHESTRATOR}")
    later = open_page(page(HOME / "notes" / "later.html"), ORCHESTRATOR, cwd=str(alpha))
    check("a session that commits on another tree has that tree beside it, and its later pages that ticket",
          (ORCHESTRATOR, "drop-zone", "drop-zone"), (later["unit"], view(ORCHESTRATOR)[1]["tree"], member_of(later)["ticket"]))
    novice = open_page(note, NOVICE, cwd=str(alpha))
    check("a session with no commits, whose pages name no ticket, has a unit with no tree", (NOVICE, None),
          (novice["unit"], view(NOVICE)[1]["tree"]))
    check("...titled by its session's id, cut short, with no session page and no registry entry, which is its short id too",
          (f"session {NOVICE[:8]}", NOVICE[:8]), tuple(view(NOVICE)[1][k] for k in ("title", "short")))
    registered(NOVICE, name="novice-name")
    check("...and by its name in the registry once there is one, as its short id is", ("novice-name", "novice-name"),
          tuple(view(NOVICE)[1][k] for k in ("title", "short")))
    # --- hub-session-search: a transcript's title lines as Claude Code 2.1.289 writes them
    transcript = HOME / ".claude" / "projects" / "-home-repos-alpha" / f"{NOVICE}.jsonl"
    transcript.parent.mkdir(parents=True)
    title_line = lambda kind, text: json.dumps({"type": f"{kind}-title", f"{kind}Title": text, "sessionId": NOVICE},
                                          separators=(",", ":")) + "\n"
    transcript.write_text(title_line("ai", "Instagram saves") + '{"type":"user","message":{"content":"x"}}\n'
                          + title_line("ai", "Instagram saves pass 1"))
    check("...and by Claude Code's own title for it, its last, over its name in the registry, which stays its short id",
          ("Instagram saves pass 1", "novice-name"), tuple(view(NOVICE)[1][k] for k in ("title", "short")))
    with transcript.open("a") as f:
        f.write(title_line("custom", "saves") + title_line("ai", "Instagram saves pass 2") + '{"type":"custom-title","custo')
    check("...the user's title from /rename over the AI's, whichever came last, and a line still being written not yet",
          "saves", view(NOVICE)[1]["title"])
    with transcript.open("a") as f:
        f.write(title_line("custom", "saves again")[len('{"type":"custom-title","custo'):])
    check("...which counts once it is whole", "saves again", view(NOVICE)[1]["title"])
    ticket_file = open_page(agent / "tickets/csv-import.md", WORKER)
    check("a ticket file lands in the opener's unit, as a page of that ticket", (WORKER, "csv-import"),
          (ticket_file["unit"], member_of(ticket_file)["ticket"]))
    payload = open_page(page(alpha / "agent/show/csv-import/broken.html", "<script>const DATA = {not json</script>"), WORKER)
    check("a page that looks like a diffview but carries no data opens like any other", WORKER, payload.get("unit"))
    session_page = open_page(page(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html"), ORCHESTRATOR)
    check("a session page goes to its session's unit, under no ticket", (ORCHESTRATOR, None),
          (session_page["unit"], member_of(session_page)["ticket"]))
    worker_page = open_page(page(alpha / f"agent/sessions/{WORKER}/index.html"))
    check("a session page lands in its own session's unit, whoever opens it", WORKER, worker_page["unit"])
    page(alpha / f"agent/sessions/{WORKER}/session.md", "---\nsession: x\n---\n\n# Import the CSV files\n\n## Brief\n")
    registered(WORKER, name="worker-name")
    check("a unit is titled by its session page's heading, over its name in the registry", "Import the CSV files",
          view(WORKER)[1]["title"])
    check("...and says how to resume that session", f"claude --resume {WORKER}", view(WORKER)[1]["resume"])

    # --- one-hub-tab#P2: a unit's session page lists every page of the unit, a minimized one included
    # The session page's artefact column as the mx renderer writes it: each link carries the absolute path of the file
    # it opens, or the URL as written. A link elsewhere on the page (a turn's chip) repeats one of the column's.
    figure_path = page(alpha / "agent/show/csv-import/flow.svg", '<svg xmlns="http://www.w3.org/2000/svg"/>')
    shown_path = alpha / "agent/show/csv-import/index.html"
    page(alpha / f"agent/sessions/{STRANGER}/index.html", f"""<!doctype html><main>
      <details class="turn"><summary>turn 2 <span class="chip"><a href="#" data-artefact="{shown_path}">csv</a></span></summary></details>
      <aside class="column" id="artefacts"><section class="group" id="a02"><ol>
        <li><kbd class="n">1</kbd><a class="artefact" href="#" data-artefact="{figure_path}">flow</a></li>
        <li><kbd class="n">2</kbd><a class="artefact" href="#" data-artefact="{shown_path}">csv</a></li>
      </ol></section><section class="group" id="a01"><ol>
        <li><kbd class="n">1</kbd><a class="artefact" href="#" data-artefact="{figure_path}">flow again</a></li>
        <li><kbd class="n">2</kbd><a class="artefact" href="#" data-artefact="https://example.invalid/app?x=1&amp;y=2">app</a></li>
      </ol></section></aside></main>""")
    stray = open_page(page(HOME / "notes" / "stray.html"), STRANGER)
    request("POST", "/api/close", {"unit": STRANGER, "id": stray["id"]})
    served = lambda path: "/f" + urllib.parse.quote(str(path))
    listed = view(STRANGER)[1]["pages"]
    check("a unit's pages are its session page's column links in its order, once each, then the pages no turn links",
          [(served(figure_path), True), (served(shown_path), True), ("https://example.invalid/app?x=1&y=2", True),
           (served(HOME / "notes" / "stray.html"), False)],
          [(x["url"], x["linked"]) for x in listed])
    check("...each named as the column names it, a page no turn links by its path", [str(figure_path), str(shown_path),
          "https://example.invalid/app?x=1&y=2", str(HOME / "notes" / "stray.html")], [x["artefact"] for x in listed])
    check("...every member listed, the minimized one too, and the session page, the list itself, not on it", (True, False),
          ({m["url"] for m in view(STRANGER)[1]["members"]} <= {x["url"] for x in listed},
           any(x["kind"] == "session" for x in listed)))
    check("...the id of each the id it has as a member", stray["id"], listed[-1]["id"])
    check("a page named relative to the opener's directory lands as its absolute path does", a["id"],
          open_page("agent/show/csv-import/index.html", WORKER, cwd=str(alpha)).get("id"))
    check("a page that carries DATA naming sources without files opens like any other", WORKER,
          open_page(page(alpha / "agent/show/csv-import/sourced.html", '<script>const DATA = {"sources": [{"kind": "git"}]}</script>'),
                    WORKER).get("unit"))
    check("so does a directory named like a page", WORKER,
          open_page(page(alpha / "agent/show/csv-import/deck.html/index.html").parent, WORKER).get("unit"))

    # --- the board: the rail's, opened over the hub tab, never a page of a unit
    board = page(agent / "board.html", "<!doctype html><h1>board</h1>")
    board_url = served(board)
    before = {u["unit"]: [m["id"] for m in u["members"]] for u in rail()}
    handed = open_page(board, ORCHESTRATOR)
    check("a board handed to the hub opens over the hub tab, joining no unit", (board_url, None, before),
          (handed.get("board"), handed.get("unit"), {u["unit"]: [m["id"] for m in u["members"]] for u in rail()}))
    check("...as does a link to one clicked in a page of the hub tab", (board_url, None),
          (lambda r: (r.get("board"), r.get("unit")))(request("POST", "/api/open", {"unit": STRANGER, "target": board_url, "by": "user"},
                                                              {"Origin": ORIGIN})[1]))
    page(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html", f"""<!doctype html><aside class="column" id="artefacts"><ol>
      <li><a class="artefact" href="#" data-artefact="{board}">board</a></li>
      <li><a class="artefact" href="#" data-artefact="{shown_path}">csv</a></li></ol></aside>""")
    check("...and a session page's column linking it lists it as none of the unit's pages", [served(shown_path)],
          [p["url"] for p in view(ORCHESTRATOR)[1]["pages"] if p["linked"]])
    check("a unit's board is its tree's, marking the tickets its session claimed or committed on",
          (board_url, {"map-columns", "csv-import", "drop-zone"}),
          (view(ORCHESTRATOR)[1]["board"], set(view(ORCHESTRATOR)[1]["worked_on"])))
    ticket(agent, "drop-zone", "done")
    check("...but none that is done, which is worked on no more", {"map-columns", "csv-import"}, set(view(ORCHESTRATOR)[1]["worked_on"]))
    ticket(agent, "drop-zone")
    check("...and none of a session that committed on none there, whatever tickets its pages name", (board_url, []),
          (view(WORKER)[1]["board"], view(WORKER)[1]["worked_on"]))

    # --- what never opens

    report = page(alpha / "agent/show/drop-zone/report.md", "## Comments\n")
    page(alpha / "agent/show/drop-zone/notes.md", "# notes\n")
    page(alpha / "agent/show/drop-zone/figures/plot.svg", '<svg xmlns="http://www.w3.org/2000/svg"/>')
    page(alpha / "agent/show/drop-zone/out/raw.html")
    skipped = open_page(report, WORKER)
    check("a worker's report never opens", (True, None), ("skipped" in skipped, skipped["open"]))
    check("...and the line the hub has its caller print says why", True, "not opened" in skipped["say"] and "report" in skipped["say"])
    git(agent, "commit", "-q", "--allow-empty", "-m", "base")
    ticket(agent, "csv-import", "review", "map-columns")
    git(agent, "commit", "-q", "-am", "csv-import in review", "-m", f"Session: {ORCHESTRATOR}")
    tracker_diff = agent / "diffviews" / "tracker.html"
    tracker_diff.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run([BIN / "diffview", f"{agent}@HEAD~1..HEAD", "-o", str(tracker_diff), "--no-auto-summary"],
                   env=ENV, check=True, capture_output=True)
    check("a diffview of tracker files never opens", True, "skipped" in open_page(tracker_diff, ORCHESTRATOR))
    check("...though its source kept as text does, being no diffview", True,
          "unit" in open_page(shutil.copy(tracker_diff, tracker_diff.with_suffix(".txt")), ORCHESTRATOR))
    check("a report beside a prototype is no worker's report, and opens", True,
          "unit" in open_page(page(alpha / "agent/prototypes/csv-import/report.md", "# what the prototype showed\n"), WORKER))
    ticket(agent, "csv-import", "claimed", "map-columns")
    page(agent / "show/csv-import/plan.md", "# plan\n")
    git(agent, "add", "tickets/csv-import.md", "show/csv-import/plan.md")
    git(agent, "commit", "-q", "-m", "csv-import back, with a plan")
    mixed_diff = agent / "diffviews" / "mixed.html"
    subprocess.run([BIN / "diffview", f"{agent}@HEAD~1..HEAD", "-o", str(mixed_diff), "--no-auto-summary"],
                   env=ENV, check=True, capture_output=True)
    check("a diffview of a ticket and a show file opens", ORCHESTRATOR, open_page(mixed_diff, ORCHESTRATOR).get("unit"))
    (alpha / "notes.txt").write_text("one\n")
    git(alpha, "add", "notes.txt")
    git(alpha, "commit", "-q", "-m", "notes")
    code_diff = agent / "diffviews" / "csv-import.html"
    subprocess.run([BIN / "diffview", f"{alpha}@HEAD~1..HEAD", "-o", str(code_diff), "--no-auto-summary"],
                   env=ENV, check=True, capture_output=True)
    code_opened = open_page(code_diff, ORCHESTRATOR)
    check("a diffview of code opens", ORCHESTRATOR, code_opened.get("unit"))

    # --- a page's lane, from what it is

    lane_of = lambda path: member_of(open_page(path, ORCHESTRATOR))["lane"]
    check("a session page goes to the session lane, a diffview page to code", ("session", "code"),
          (member_of(session_page)["lane"], member_of(code_opened)["lane"]))
    check("an image goes to concept, as does any other page of a show directory", ("concept", "concept", "concept"),
          (lane_of(alpha / "agent/show/drop-zone/figures/plot.svg"), lane_of(alpha / "agent/show/drop-zone/notes.md"), member_of(a)["lane"]))
    check("a page in no show directory goes to output, a prototype's too", ("output", "output"),
          (member_of(by_trailer)["lane"],
           member_of(open_page(page(agent / "prototypes/csv-import/index.html"), ORCHESTRATOR))["lane"]))
    elsewhere = open_page(shutil.copy(code_diff, HOME / "notes" / "review.html"), ORCHESTRATOR)
    check("a diffview page goes to code wherever it was written", "code", member_of(elsewhere)["lane"])
    check("...though a page that only looks like one does not", "concept", member_of(payload)["lane"])
    check("an image outside any show directory goes to concept", "concept",
          member_of(open_page(page(HOME / "notes" / "sketch.png", "png"), ORCHESTRATOR))["lane"])
    overridden = open_page(note, ORCHESTRATOR, lane="concept")
    check("an agent's lane overrides the one a page's kind gives it", "concept", member_of(overridden)["lane"])
    check("...and the line the caller prints names it", True, ", lane concept;" in overridden["say"])
    open_page(note, ORCHESTRATOR)
    check("...and holds when the page is opened again without one", "concept", member_of(overridden)["lane"])
    check("...the unit's pages listing it in that lane", "concept",
          next(x["lane"] for x in view(ORCHESTRATOR)[1]["pages"] if x["id"] == overridden["id"]))
    open_page(note, ORCHESTRATOR, lane="output")
    check("...until an agent names another", "output", member_of(overridden)["lane"])
    check("a lane there is none of is refused, naming the lanes", (400, True),
          (lambda r: (r[0], "session, concept, output, code" in r[1].get("error", "")))(
              request("POST", "/api/open", {"target": str(note), "session": ORCHESTRATOR, "lane": "diff"})))

    check("a unit's tree is the tree of the ticket its session committed on last", "map-columns", view(ORCHESTRATOR)[1]["tree"])
    scratch_member = member_of(by_trailer)
    check("a member no turn links is in its unit's pages as it was opened", [{
        "url": scratch_member["url"], "id": scratch_member["id"], "artefact": str(note.resolve()), "linked": False, "ticket": "csv-import",
        "kind": "page", "title": "scratch.html", "lane": "output"}], [x for x in view(ORCHESTRATOR)[1]["pages"] if x["id"] == by_trailer["id"]])
    ticket(agent, "spike", "open", "map-columns")
    spike = open_page(page(agent / "show/spike/index.html"), SPIKER)
    (agent / "tickets/spike.md").unlink()
    spiker = view(spike["unit"])[1]
    check("a unit whose ticket left the tracker before it was ever read has no tree, is never visited, the ticket marked gone",
          (None, 0, [{"slug": "spike", "status": "gone", "title": "spike", "diff": []}]),
          (spiker.get("tree"), spiker.get("visited"), spiker.get("tickets")))

    # --- the tracker drives the hub tab

    ticket(agent, "csv-import", "done", "map-columns")
    status = lambda: next(t["status"] for t in view(ORCHESTRATOR)[1]["tickets"] if t["slug"] == "csv-import")
    check("a ticket's status in the tracker is the hub tab's", "done", status())
    commits = subprocess.run(["git", "log", "--reverse", "--format=%h", "-2"], cwd=alpha, capture_output=True,
                             text=True, check=True).stdout.split()
    # the agent repo's last commit adds show/csv-import/plan.md
    agent_range = "..".join(subprocess.run(["git", "log", "--reverse", "--format=%h", "-2"], cwd=agent, capture_output=True,
                                           text=True, check=True).stdout.split())
    ticket(agent, "map-columns")
    with (agent / "tickets/map-columns.md").open("r+") as f:
        text = f.read().replace("size: S\n", f"size: S\ndiff:\n  - code@{commits[0]}..{commits[1]}\n  - agent@{agent_range}\n")
        f.seek(0)
        f.write(text)
    # what the hub cached before it left agent ranges out: one page of both ranges, keyed by both
    old_specs = f"{alpha}@{commits[0]}..{commits[1]} {agent}@{agent_range}"
    page(SCRATCH / "state" / "diffs" / f"map-columns-{hashlib.sha1(old_specs.encode()).hexdigest()[:8]}.html", "stale render")
    recorded = {"url": "/diff?" + urllib.parse.urlencode({"tracker": str((agent / "tickets").resolve()), "ticket": "map-columns"}),
                "title": f"diff · code@{commits[0]}..{commits[1]}"}
    status_code, rendered = request("GET", recorded["url"])
    check("a ticket's recorded code range renders when opened", (200, True), (status_code, b"notes.txt" in rendered))
    check("...without its agent range, and never from a render cached with it", (False, False),
          (b"plan.md" in rendered, b"stale render" in rendered))
    renders = lambda: {p: p.stat().st_mtime_ns for p in (SCRATCH / "state" / "diffs").iterdir()}
    first_render = renders()
    check("...and once: opened again, the page already rendered is served", (200, first_render),
          (request("GET", recorded["url"])[0], renders()))
    from_view = request("POST", "/api/open", {"unit": ORCHESTRATOR, "target": recorded["url"], "title": recorded["title"],
                                              "by": "user"}, {"Origin": ORIGIN})[1]
    check("a recorded range clicked in the hub tab becomes a member of its unit, of its ticket", (ORCHESTRATOR, "diff", "map-columns"),
          (from_view["unit"], member_of(from_view)["kind"], member_of(from_view)["ticket"]))
    check("...under the title the hub tab gave it, opened by the user", (recorded["title"], "user"),
          (member_of(from_view)["title"], member_of(from_view)["by"]))
    open_page(ORIGIN + recorded["url"], ORCHESTRATOR)
    check("...and opened by an agent at the hub's own address, it widens nothing served", 403,
          request("GET", "/f" + urllib.parse.quote(str(page(HOME / "private.html"))))[0])
    check("a ticket with no range recorded has no diff to render", 404,
          request("GET", "/diff?" + urllib.parse.urlencode({"tracker": str(agent / "tickets"), "ticket": "drop-zone"}))[0])
    ticket(agent, "drop-zone")
    with (agent / "tickets/drop-zone.md").open("r+") as f:
        text = f.read().replace("size: S\n", f"size: S\ndiff:\n  - agent@{agent_range}\n")
        f.seek(0)
        f.write(text)
    check("a ticket recording only agent ranges has no diff to render", 404,
          request("GET", "/diff?" + urllib.parse.urlencode({"tracker": str(agent / "tickets"), "ticket": "drop-zone"}))[0])
    with (agent / "tickets/map-columns.md").open("r+") as f:
        text = f.read().replace(f"code@{commits[0]}..{commits[1]}", f"code@{commits[0]}..0123abc")
        f.seek(0)
        f.truncate()
        f.write(text)
    status_code, said = request("GET", recorded["url"])
    check("a recorded range diffview cannot render answers why, not that none is recorded", (502, True),
          (status_code, b"0123abc" in said))

    # --- the rail: the units whose sessions run, numbered by when each last finished a turn

    t0 = time.time()
    os.utime(alpha / f"agent/sessions/{ORCHESTRATOR}/index.html", (t0 - 100, t0 - 100))
    os.utime(alpha / f"agent/sessions/{WORKER}/index.html", (t0 - 10, t0 - 10))
    registered(ORCHESTRATOR, "idle", t0 - 50)
    registered(WORKER, "busy", t0 - 5)
    registered(SPIKER, "idle", t0 - 200)
    ours = lambda: [(u["unit"], u["number"] is not None) for u in rail() if u["unit"] in (ORCHESTRATOR, WORKER, SPIKER)]
    check("the rail numbers the idle sessions by their last turn's end, the latest first, and the busy after them",
          [(ORCHESTRATOR, True), (SPIKER, True), (WORKER, True)], ours())
    check("...a turn's end read off the session page's render where the registry has none",
          round(t0 - 10), round(next(u["last"] for u in rail() if u["unit"] == WORKER)))
    registered(SPIKER, "shell", t0 - 1)
    check("a session running a shell command is numbered with the busy, not with those waiting on you",
          [(ORCHESTRATOR, True), (WORKER, True), (SPIKER, True)], ours())
    registered(SPIKER, "idle", t0 - 200)
    registered(WORKER, "idle", t0)
    check("a session that finishes a turn is the first of them", [(WORKER, True), (ORCHESTRATOR, True), (SPIKER, True)], ours())
    check("...and 1 on the rail", 1, next(u["number"] for u in rail() if u["unit"] == WORKER))
    check("a session no running process registers is ended: no number, after every numbered unit", ("ended", None, True),
          (lambda us: (next(u["state"] for u in us if u["unit"] == STRANGER), next(u["number"] for u in us if u["unit"] == STRANGER),
                       all(u["number"] for u in us[:[x["unit"] for x in us].index(STRANGER)])))(rail()))
    gone_process = subprocess.Popen(["true"])
    gone_process.wait()
    registered(STRANGER, pid=gone_process.pid, started=None)
    registered(NOVICE, started=str(int(SELF_STARTED) + 1))
    check("...as is one whose registry file names a process that has exited, or a pid another process has taken since",
          ("ended", "ended"), (view(STRANGER)[1]["state"], view(NOVICE)[1]["state"]))
    registered(STRANGER, "idle", t0 + 1)
    check("a session resumed gets a number again", (True, "idle"), (view(STRANGER)[1]["number"] is not None, view(STRANGER)[1]["state"]))
    check("the ✕ takes a unit out of the numbers", (200, None, True),
          (request("POST", "/api/dismiss", {"unit": ORCHESTRATOR})[0], view(ORCHESTRATOR)[1]["number"], view(ORCHESTRATOR)[1]["dismissed"]))
    check("...listed after the numbered ones", True,
          (lambda us: all(u["number"] for u in us[:[x["unit"] for x in us].index(ORCHESTRATOR)]))(rail()))
    check("...while an agent opening a page there does not bring it back", None,
          (open_page(page(HOME / "notes" / "while-dismissed.html"), ORCHESTRATOR) and view(ORCHESTRATOR))[1]["number"])
    registered(ORCHESTRATOR, "idle", time.time() + 1)
    check("...and its session finishing a turn does, as 1", (1, False),
          (view(ORCHESTRATOR)[1]["number"], view(ORCHESTRATOR)[1]["dismissed"]))
    check("a dismissal is refused for a unit that does not exist", 404, request("POST", "/api/dismiss", {"unit": "no-such-unit"})[0])

    # --- hub-ui-nits 2: the statusline's numbers, from what the statusline keeps of each session's last render
    unit_context = lambda key: view(key)[1]["context"]
    check("a session with no statusline file shows no context use, nor any usage", (None, []),
          (unit_context(WORKER), request("GET", "/api/hub")[1]["usage"]))
    work = HOME / ".claude-work"
    statusline(WORKER, t0 - 30, context=(42.5, 85000), five_hour=(30, t0 + 3600), seven_day=(12, t0 + 3 * 86400))
    statusline(ORCHESTRATOR, t0 - 10, context=(81, 162000), five_hour=(35, t0 + 3500), seven_day=(13, t0 + 3 * 86400))
    statusline(SPIKER, t0 - 20, f"{work}/", context=(5, 9000), five_hour=(70, t0 - 60), seven_day=(40, t0 + 86400))
    statusline(NOVICE, t0, context=(90, 180000), five_hour=(99, t0 + 60), seven_day=(99, t0 + 60))
    statusline(STRANGER, t0 - 5, HOME / ".claude-pro", context=(20, 40000))
    statusline(SPIKER[:-1] + "9", t0 - 40, work, five_hour=(1, t0 + 60))  # the same account, spelled without the slash
    check("a running session shows its context use, as its statusline last had it",
          ({"used_percentage": 42.5, "total_input_tokens": 85000}, {"used_percentage": 81, "total_input_tokens": 162000}),
          (unit_context(WORKER), unit_context(ORCHESTRATOR)))
    check("...an ended one none", None, unit_context(NOVICE))
    check("the 5h and weekly usage, one entry per account, each from its newest statusline file, an ended session's too", [
        {"account": str(HOME / ".claude"), "at": t0, "five_hour": {"used_percentage": 99, "resets_at": t0 + 60},
         "seven_day": {"used_percentage": 99, "resets_at": t0 + 60}},
        {"account": str(HOME / ".claude-pro"), "at": t0 - 5, "five_hour": None, "seven_day": None},
        {"account": str(work), "at": t0 - 20, "five_hour": {"used_percentage": 70, "resets_at": t0 - 60},
         "seven_day": {"used_percentage": 40, "resets_at": t0 + 86400}}], request("GET", "/api/hub")[1]["usage"])

    # --- hub-layout-pass 5: a unit's account, the config dir its session runs under, which the rail ticks on and off
    novice_transcript = HOME / ".claude" / "projects" / "-home-repos-alpha" / f"{NOVICE}.jsonl"
    page(HOME / ".claude-pro" / "projects" / "-home-repos-beta" / f"{WORKER}.jsonl", "")
    check("an ended session's account is the one its transcript is under, a running session's the one its registry "
          "file is under, whatever transcript it has", (str(HOME / ".claude"), str(HOME / ".claude")),
          (view(NOVICE)[1]["account"], view(WORKER)[1]["account"]))
    (work / "projects" / "-home-repos-alpha").mkdir(parents=True)
    novice_transcript.rename(work / "projects" / "-home-repos-alpha" / novice_transcript.name)
    check("...a transcript moved to another account moving it there, as the rail has it", (str(work), str(work)),
          (view(NOVICE)[1]["account"], next(u["account"] for u in rail() if u["unit"] == NOVICE)))
    (work / "projects" / "-home-repos-alpha" / novice_transcript.name).unlink()
    check("...and one with no transcript left has none", None, view(NOVICE)[1]["account"])

    numbers = urllib.request.urlopen(f"{ORIGIN}/events", timeout=10)
    numbers.readline()
    statusline(WORKER, t0 + 1, context=(43, 86000), five_hour=(31, t0 + 3600), seven_day=(12, t0 + 3 * 86400))
    heard = None
    while heard not in ("numbers", "disk"):  # past what was told while no tab listened, which a tab hears first
        if (line := numbers.readline().decode()).startswith("data:"):
            heard = json.loads(line[5:])["type"]
    numbers.close()
    check("a listening hub tab hears of new numbers as numbers alone, which redraw the rail and leave the layout be",
          "numbers", heard)

    # --- answering a session from its unit: the hub tab's input box types into the session's tmux pane

    # The session's program, standing in for Claude Code: it asks its terminal for bracketed paste as Claude Code
    # does, and records every byte that reaches it, so what arrives is what typing in the pane would have sent.
    received = SCRATCH / "received"
    recorder = SCRATCH / "recorder.py"
    recorder.write_text("import os, sys, tty\ntty.setraw(0)\nos.write(1, b'\\x1b[?2004h')\nout = open(sys.argv[1], 'ab', buffering=0)\n"
                        "while data := os.read(0, 4096):\n    out.write(data)\n")
    tmux = lambda *args: subprocess.run([TMUX, "-S", TMUX_SOCKET, *args], env=ENV, capture_output=True, text=True, check=True).stdout.strip()
    # no config: the user's own would load plugins whose tmux calls name no socket
    tmux("-f", "/dev/null", "new-session", "-d", "-s", "answering", "-x", "100", "-y", "20", shlex.join(["exec", sys.executable, str(recorder), str(received)]))
    try:
        pane, pane_pid = tmux("display-message", "-p", "-t", "answering:", "#{pane_id} #{pane_pid}").split()
        deadline = time.monotonic() + 10
        while not received.exists() and time.monotonic() < deadline:
            time.sleep(0.05)
        started = Path(f"/proc/{pane_pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
        in_pane = lambda status="idle", **extra: registered(ANSWERER, status, pid=int(pane_pid), started=started, **extra)
        in_pane(tmux=f"answering:@0.{pane}")
        open_page(page(HOME / "notes" / "answering.html"), ANSWERER)
        check("a unit names the tmux pane its session runs in, as the registry does", (f"answering:@0.{pane}", "idle"),
              (view(ANSWERER)[1]["pane"], view(ANSWERER)[1]["state"]))

        tab_html = lambda dest: request("GET", "/", headers={"Sec-Fetch-Dest": dest})[1].decode()
        token_in = lambda page_html: re.search(r'<meta name="hub-token" content="([^"]*)">', page_html)[1]
        token = token_in(tab_html("document"))
        check("the hub tab loaded as a tab carries the token that lets it type", True, len(token) > 20)
        check("...a page in it that fetches the tab, or frames it, gets none", ("", ""), (token_in(tab_html("empty")), token_in(tab_html("iframe"))))
        typed = lambda body, token=token: request("POST", "/api/type", {"unit": ANSWERER, **body}, {"Origin": ORIGIN, "X-Hub-Token": token})
        arrived = lambda: received.read_bytes() if received.exists() else b""

        def arrives(expected: bytes) -> bytes:
            deadline = time.monotonic() + 5
            while arrived() != expected and time.monotonic() < deadline:
                time.sleep(0.05)
            return arrived()

        check("a page the hub serves cannot type into a session without the tab's token", ((403, 403), b""),
              ((typed({"text": "rm -rf ~"}, "")[0], typed({"text": "rm -rf ~"}, "guessed")[0]), arrives(b"")))
        status_code, answer = typed({"text": "go on, but\nleave the tests"})
        # a paste of the text, then Enter: what a terminal sends for the same text pasted in and Enter pressed
        check("the box's text arrives in the session's pane as a paste, then Enter", (200, pane, b"\x1b[200~go on, but\rleave the tests\x1b[201~\r"),
              (status_code, answer.get("pane"), arrives(b"\x1b[200~go on, but\rleave the tests\x1b[201~\r")))
        received.write_bytes(b"")
        check("nothing but whitespace is not sent", 400, typed({"text": " \n "})[0])
        in_pane("busy", tmux=f"answering:@0.{pane}")
        check("a working session takes it too, as its pane would queue it", (200, b"\x1b[200~and then this\x1b[201~\r"),
              (typed({"text": "and then this"})[0], arrives(b"\x1b[200~and then this\x1b[201~\r")))
        received.write_bytes(b"")
        in_pane("waiting", tmux=f"answering:@0.{pane}", waiting_for="permission prompt")
        check("a session blocked in its terminal shows as such, on what", ("waiting", "permission prompt"),
              (view(ANSWERER)[1]["state"], view(ANSWERER)[1]["waiting_for"]))
        status_code, answer = typed({"text": "yes"})
        check("...and is sent nothing, the hub saying why", (409, True, b""),
              (status_code, "permission prompt" in answer.get("error", ""), arrives(b"")))
        in_pane()
        check("a session with no tmux pane in the registry has none in its unit", None, view(ANSWERER)[1]["pane"])
        status_code, answer = typed({"text": "hello"})
        check("...and is sent nothing, the hub saying why", (409, True, b""), (status_code, "no tmux pane" in answer.get("error", ""), arrives(b"")))
        registered(ANSWERER, tmux=f"answering:@0.{pane}")  # the pane, but a process outside it
        status_code, answer = typed({"text": "hello"})
        check("a pane that does not hold the session's process is sent nothing", (409, True, b""),
              (status_code, "no longer holds" in answer.get("error", ""), arrives(b"")))
    finally:
        subprocess.run([TMUX, "-S", TMUX_SOCKET, "kill-server"], env=ENV, capture_output=True, check=False)
    registered(ANSWERER, pid=gone_process.pid, started=None, tmux=f"answering:@0.{pane}")
    status_code, answer = typed({"text": "hello"})
    check("an ended session is sent nothing", (409, True), (status_code, "ended" in answer.get("error", "")))

    screenshot = b"\x89PNG\r\n\x1a\n not really a png"
    dropped = lambda name, token=token: request(
        "POST", f"/api/drop?unit={ANSWERER}&name={urllib.parse.quote(name)}", None,
        {"Origin": ORIGIN, "X-Hub-Token": token, "Content-Type": "application/octet-stream"}, data=screenshot)
    status_code, answer = dropped("Screenshot from today.png")
    saved = Path(answer.get("path", "/nonexistent"))
    check("a file pasted or dropped into the box is saved where the session can read it, under its own name, typed bare",
          (200, HOME / ".cache/container-hub/drops" / ANSWERER, True, screenshot),
          (status_code, saved.parent, saved.name.endswith("-Screenshot-from-today.png"), saved.read_bytes() if saved.is_file() else None))
    check("...a second of the same name kept beside it", True, dropped("Screenshot from today.png")[1].get("path") != str(saved))
    check("...and not without the tab's token", 403, dropped("x.png", "")[0])
    check("...nor for a unit there is none of, whatever its name", (404, 404, False), (
        request("POST", "/api/drop?unit=no-such-unit&name=x.png", None, {"Origin": ORIGIN, "X-Hub-Token": token}, data=b"x")[0],
        request("POST", "/api/drop?unit=..&name=x.png", None, {"Origin": ORIGIN, "X-Hub-Token": token}, data=b"x")[0],
        any((HOME / ".cache/container-hub").glob("*x.png"))))

    # --- serving

    status_code, health = request("GET", "/.health")
    check("/.health says diffview pages can save", {"saves": True}, health)
    served = member_of(a)["url"]
    check("a member is served on the hub's origin", 200, request("GET", served)[0])
    check("a request for another Host is refused", 403, request("GET", served, headers={"Host": "attacker.example:80"})[0])
    secret = page(HOME / ".ssh" / "id_ed25519", "not a page")
    check("a file no agent opened, outside every agent directory, is not served", 403,
          request("GET", "/f" + urllib.parse.quote(str(secret)))[0])
    check("...and a page in the hub tab opening it gets its path to copy, and it is served no more than before",
          ((200, str(secret)), 403),
          ((lambda r: (r[0], r[1].get("copy")))(request("POST", "/api/open", {"unit": a["unit"], "target": str(secret)}, {"Origin": ORIGIN})),
           request("GET", "/f" + urllib.parse.quote(str(secret)))[0]))
    check("...nor opening a directory widens what is served, though its path comes back to copy", ((200, str(note.parent)), 403),
          ((lambda r: (r[0], r[1].get("copy")))(request("POST", "/api/open", {"unit": a["unit"], "target": str(note.parent)}, {"Origin": ORIGIN})),
           request("GET", "/f" + urllib.parse.quote(str(page(HOME / "beside-notes.html"))))[0]))
    check("the hub tab hears which links a click copies: a directory and an unserved file, not a page it serves",
          (200, {"copies": [f"file://{note.parent}", str(secret)]}),
          request("POST", "/api/copies", {"targets": [f"file://{note.parent}", str(secret), served, str(HOME / "gone")]}, {"Origin": ORIGIN}))
    check("a write for another Host is refused", 403,
          request("POST", "/api/open", {"target": str(note)}, {"Host": "attacker.example:80", "Origin": ORIGIN})[0])
    shown = page(HOME / "work" / "out" / "report" / "index.html")
    page(HOME / "work" / "out" / "secret.txt", "secret")
    open_page(shown.parent, ORCHESTRATOR, cwd=str(alpha))
    check("a directory an agent opens is served, and nothing beside it", (200, 403),
          (request("GET", "/f" + urllib.parse.quote(str(shown)))[0],
           request("GET", "/f" + urllib.parse.quote(str(HOME / "work" / "out" / "secret.txt")))[0]))
    check("a file git tracks in the repo around an agent directory is served", 200,
          request("GET", "/f" + urllib.parse.quote(str(alpha / "README.md")))[0])
    check("...an untracked one is not", 403, request("GET", "/f" + urllib.parse.quote(str(page(alpha / ".env", "KEY=1"))))[0])
    request("POST", "/api/open", {"unit": a["unit"], "target": str(alpha / "README.md"), "by": "user"}, {"Origin": ORIGIN})
    check("...not even once the hub tab opened a tracked file beside it", 403, request("GET", "/f" + urllib.parse.quote(str(alpha / ".env")))[0])
    page(alpha / "site" / "style.css", "p {}")
    git(alpha, "add", "site/style.css")
    git(alpha, "commit", "-q", "-m", "site")
    page(alpha / "site" / "index.html")
    check("...nor an untracked page reached through a directory git tracks files in", 403,
          request("GET", "/f" + urllib.parse.quote(str(alpha / "site")) + "/")[0])
    check("an open from another origin is refused", 403,
          request("POST", "/api/open", {"target": str(note)}, {"Origin": "http://attacker.example"})[0])
    diff_url = member_of(open_page(code_diff, ORCHESTRATOR))["url"]
    state = {"writer": "t", "savedAt": 1, "comments": []}
    check("a diffview page saves its comments through the hub", 204,
          request("POST", diff_url + ".state.json", state, {"Origin": ORIGIN})[0])
    check("...beside the page", state, json.loads(Path(f"{code_diff}.state.json").read_text()))
    check("a state write from another origin is refused", 403,
          request("POST", diff_url + ".state.json", state, {"Origin": "http://attacker.example"})[0])
    check("a page no diffview watches asking for a new summary is told none runs", 409,
          request("POST", diff_url + ".summary.json", {}, {"Origin": ORIGIN})[0])
    watch_record = Path(f"{code_diff}.watch.json")
    for garbage in ("not json", "[1]"):
        watch_record.write_text(garbage)
        check(f"a watch record that is no record ({garbage}) reads as none", (200, None), request("GET", diff_url + ".watch.json"))
    check("...and keeps its page in the unit", True, any(m["url"] == diff_url for m in view(ORCHESTRATOR)[1]["members"]))
    watch_record.unlink()
