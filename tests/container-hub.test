    (zeta / "agent/tickets/half-written.md").write_text("no frontmatter yet\n")  # `tracker data` refuses the whole tracker
    check("a unit whose tracker refuses its tickets for now is still there", (200, [z["id"]]),
          (lambda r: (r[0], [m["id"] for m in r[1].get("members", [])]))(view(z["unit"])))
    shutil.rmtree(delta / "agent" / "tickets")
    shutil.rmtree(epsilon)
    check("a unit whose tracker is gone is gone, its pages still there or not", (404, 404), (view(d["unit"])[0], view(e["unit"])[0]))
    check("...and left the rail", False, any(u["unit"] in (d["unit"], e["unit"]) for u in rail()))
    passing = "12345678-0000-4000-8000-00000000000a"
    fleeting_note = open_page(page(HOME / "notes" / "fleeting.html"), passing)
    (HOME / "notes" / "fleeting.html").unlink()
    check("a unit with no tree goes once every page of it is deleted", (passing, 404), (fleeting_note["unit"], view(passing)[0]))

    # --- claude-browser with a hub

    stubs = SCRATCH / "stubs"
    stubs.mkdir()
    record = SCRATCH / "browser"
    (stubs / "brave").write_text(f'#!/bin/sh\nprintf "%s\\n" "$@" > {record}\n')
    (stubs / "systemd-run").write_text('#!/bin/sh\nwhile [ "${1#--}" != "$1" ]; do shift; done\nexec "$@"\n')
    for s in stubs.iterdir():
        s.chmod(0o755)
    local_state = HOME / ".config/BraveSoftware/Brave-Browser/Local State"
    local_state.parent.mkdir(parents=True)
    local_state.write_text(json.dumps({"profile": {"info_cache": {"Default": {"name": "Personal"}}}}))

    def browse(*args: str, cwd: Path = gamma, port: int = PORT, **sessions: str) -> list[str]:
        """What claude-browser handed the browser; what it said on the way is in browse.said."""
        record.unlink(missing_ok=True)
        browse.said = subprocess.run([BIN / "claude-browser", *args], cwd=cwd, check=True, capture_output=True, timeout=30, text=True,
                                     env={**ENV, "CONTAINER_HUB_PORT": str(port), "CLAUDE_CODE_SESSION_ID": WORKER, **sessions,
                                          "PATH": f"{stubs}:{BIN}:{ENV['PATH']}"}).stderr
        deadline = time.monotonic() + 5
        while not record.exists() and time.monotonic() < deadline:
            time.sleep(0.05)
        return record.read_text().splitlines() if record.exists() else []

    fresh = page(gamma / "agent/show/one-flow/figure.svg", '<svg xmlns="http://www.w3.org/2000/svg"/>')
    tab_came_and_went()
    opened = browse("agent/show/one-flow/figure.svg")
    launching = browse.said
    g = open_page(fresh, WORKER)
    check("with no hub tab listening, claude-browser opens the hub tab at the unit and the page",
          ["--profile-directory=Default", f"{ORIGIN}/u/{WORKER}#{g['id']}"], opened)
    check("...and says which unit the page is in, on one line", (True, 1),
          (launching.startswith(f"claude-browser: in unit {WORKER}"), launching.count("\n")))
    check("...and the page is a member", True, any(m["path"] == str(fresh) for m in view(WORKER)[1]["members"]))
    check("a second page moments later opens no second hub tab", [],
          browse(str(page(gamma / "agent/show/one-flow/index.html"))))
    events = urllib.request.urlopen(f"{ORIGIN}/events", timeout=10)
    events.readline()
    by_origin = page(gamma / "agent/show/one-flow/origin.html")
    check("with a hub tab listening, a page claude-browser hands in opens no tab", [],
          browse(str(by_origin), MX_ORIGIN_SESSION=ORCHESTRATOR))
    check("...and lands in the unit of the session in MX_ORIGIN_SESSION, over the process's own", (True, False),
          (any(m["path"] == str(by_origin) for m in view(ORCHESTRATOR)[1]["members"]),
           any(m["path"] == str(by_origin) for m in view(WORKER)[1]["members"])))
    shown = open_page(fresh, WORKER)
    browse(str(fresh))
    check("...and prints the line the hub gave it", f"claude-browser: {shown['say']}\n", browse.said)
    check("a board claude-browser hands a listening hub tab opens no tab", ([], "claude-browser: the open hub tab shows the board over it\n"),
          (browse(str(board)), browse.said))
    events.close()
    tab_came_and_went()
    check("...and with none listening opens the hub tab at the unit, the board over it",
          ["--profile-directory=Default", f"{ORIGIN}/u/{WORKER}#board:{board_url}"], browse(str(board)))
    check("a worker's report starts no browser either", [], browse(str(report)))
    check("...and claude-browser prints why, as the hub put it", f"claude-browser: {skipped['say']}\n", browse.said)
    tab_came_and_went()
    unprofiled = subprocess.run([BIN / "claude-browser", str(by_origin)], cwd=gamma, capture_output=True,
                                timeout=30, text=True, env={**ENV, "CONTAINER_HUB_PORT": str(PORT), "CLAUDE_CONFIG_DIR": str(HOME / ".claude-nobody"),
                                                            "CLAUDE_CODE_SESSION_ID": WORKER, "PATH": f"{stubs}:{BIN}:{ENV['PATH']}"})
    check("a hub tab that has no Brave profile to open in is not said to open: only why not", (1, False, True),
          (unprofiled.returncode, "in unit" in unprofiled.stderr, "no profile named 'nobody'" in unprofiled.stderr))
    refused = subprocess.run([BIN / "claude-browser", "--nope", str(by_origin)], capture_output=True, text=True, timeout=30,
                             env={**ENV, "CONTAINER_HUB_PORT": str(PORT), "PATH": f"{stubs}:{BIN}:{ENV['PATH']}"})
    check("claude-browser refuses an option it does not have, naming it", (1, True),
          (refused.returncode, "no option --nope" in refused.stderr))
    lane_page = page(gamma / "agent/show/one-flow/demo.html")
    browse("--lane", "output", str(lane_page))
    in_lane = lambda: next(m["lane"] for m in view(WORKER)[1]["members"] if m["path"] == str(lane_page))
    check("claude-browser --lane puts a page in that lane", "output", in_lane())
    browse("--lane=code", str(lane_page))
    check("...as does --lane=<lane>", "code", in_lane())
    record.unlink(missing_ok=True)
    no_lane = subprocess.run([BIN / "claude-browser", "--lane", "diff", str(lane_page)], capture_output=True, text=True, timeout=30,
                             env={**ENV, "CONTAINER_HUB_PORT": str(PORT), "PATH": f"{stubs}:{BIN}:{ENV['PATH']}"})
    check("...and refuses a lane there is none of, opening nothing", (1, True, False, "code"),
          (no_lane.returncode, "no lane 'diff'" in no_lane.stderr, record.exists(), in_lane()))
    usage = subprocess.run([BIN / "claude-browser", "--help"], capture_output=True, text=True, timeout=30).stdout
    check("claude-browser --help says what --lane takes", True,
          "--lane" in usage and all(lane in usage for lane in ("session", "concept", "output", "code")))
    check("the hub's own pages open as tabs, not members", [ORIGIN + "/"], browse(ORIGIN + "/")[1:])
    check("...the hub tab at a unit among them, without a word", ([f"{ORIGIN}/u/{WORKER}"], ""), (browse(f"{ORIGIN}/u/{WORKER}")[1:], browse.said))
    check("claude-browser with no page opens a blank tab, without a word", (["about:blank"], ""), (browse()[1:], browse.said))
    check("...so no unit holds them", 404, view("loose")[0])

    # --- a page on another origin: framed in its unit's output lane, or listed where it refuses framing

    class Elsewhere(http.server.BaseHTTPRequestHandler):
        """A local server, another origin than the hub's, whose every path answers with the framing headers it names."""
        headers_of = {"/app": [], "/deny": [("X-Frame-Options", "DENY")],
                      "/self": [("Content-Security-Policy", "default-src 'self'; frame-ancestors 'self'")],
                      "/hub": [("X-Frame-Options", "DENY"), ("Content-Security-Policy", f"frame-ancestors 'self' http://127.0.0.1:{PORT}")],
                      "/moved": [("Location", "/deny")]}

        def do_GET(self):
            self.send_response(302 if self.path == "/moved" else 200)
            for k, v in self.headers_of.get(self.path.split("?")[0], []):
                self.send_header(k, v)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(b"<!doctype html><p>an app")

        def log_message(self, *_):
            pass

    elsewhere = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Elsewhere)
    threading.Thread(target=elsewhere.serve_forever, daemon=True).start()
    app = f"http://127.0.0.1:{elsewhere.server_address[1]}"
    member_at = lambda unit, url: next((m for m in view(unit)[1].get("members", []) if m["url"] == url), {})
    def handed(target: str, url: str | None = None) -> dict:
        """The member of WORKER's unit a page an agent hands in becomes; url where the hub spells it otherwise."""
        open_page(target, WORKER)
        return member_at(WORKER, url or target)

    clicked = lambda target: request("POST", "/api/open", {"unit": WORKER, "target": target, "by": "user"}, {"Origin": ORIGIN})[1]
    events = urllib.request.urlopen(f"{ORIGIN}/events", timeout=10)
    events.readline()
    check("one-hub-tab#P7: a page on another origin handed in through claude-browser gets no tab, framing allowed or refused",
          ([], []), (browse(f"{app}/app", MX_ORIGIN_SESSION=ORCHESTRATOR), browse(f"{app}/deny", MX_ORIGIN_SESSION=ORCHESTRATOR)))
    check("...and claude-browser says the one that refuses is listed, and why", (True, True),
          ("listed on its session page" in browse.said, "X-Frame-Options is DENY" in browse.said))
    check("a local server that allows framing is a member in the output lane of the opening session's unit", ("output", None),
          (member_at(ORCHESTRATOR, f"{app}/app").get("lane"), member_at(ORCHESTRATOR, f"{app}/app").get("tab")))
    listed = next((p for p in view(ORCHESTRATOR)[1]["pages"] if p["url"] == f"{app}/deny"), {})
    check("a page that refuses framing is listed on the session page, marked as one that opens as a tab", (False, True),
          (listed.get("linked"), "X-Frame-Options" in listed.get("tab", "")))
    Elsewhere.headers_of["/app"] = [("X-Frame-Options", "SAMEORIGIN")]
    browse(f"{app}/app", MX_ORIGIN_SESSION=ORCHESTRATOR)
    check("...the hub asking the page again at every open", True, "SAMEORIGIN" in member_at(ORCHESTRATOR, f"{app}/app").get("tab", ""))
    check("frame-ancestors that names the hub's origin allows framing, over X-Frame-Options", None,
          handed(f"{app}/hub").get("tab"))
    check("...and one that does not refuses it, as a redirect to a page that refuses does", (True, True),
          ("frame-ancestors 'self'" in handed(f"{app}/self").get("tab", ""),
           "DENY" in handed(f"{app}/moved").get("tab", "")))
    dead = f"http://127.0.0.1:{free_port()}"
    check("a server that does not answer yet is framed, under the address a browser gives it", ("output", None),
          (lambda m: (m.get("lane"), m.get("tab")))(handed(dead, f"{dead}/")))
    check("a framed app keeps the screen its address opens at", True, bool(handed(f"{app}/app3#/dashboard")))
    check("an address no frame shows, a mailto: one, is listed", True, "http or https" in handed("mailto:x@example.com").get("tab", ""))
    refusing_click = clicked(f"{app}/deny?a=b#part")
    check("a link clicked in the hub tab to a page that refuses framing is answered as a tab, the URL as given", (True, f"{app}/deny?a=b#part"),
          ("tab" in refusing_click, refusing_click.get("open")))
    check("...and joins no unit", {}, member_at(WORKER, f"{app}/deny?a=b"))
    framing_click = clicked(f"{app}/app2")
    check("...and one to a page that allows framing becomes a member of the unit it was clicked in, by the user", (WORKER, None, "user"),
          (framing_click.get("unit"), framing_click.get("tab"), member_at(WORKER, f"{app}/app2").get("by")))
    events.close()
    tab_came_and_went()
    launched = browse(f"{app}/self")
    check("with no hub tab listening, a page that refuses framing opens the hub tab at its unit, never a tab of its own",
          ["--profile-directory=Default", f"{ORIGIN}/u/{WORKER}#{open_page(f'{app}/self', WORKER)['id']}"], launched)
    elsewhere.shutdown()
    missing = "agent/show/one-flow/never-written.html"
    check("a page the hub refuses opens as a plain tab", ["--profile-directory=Default", missing], browse(missing))
    check("...and claude-browser says why", True, "refused the page (404" in browse.said and "does not exist" in browse.said)

    class NotAHub(http.server.BaseHTTPRequestHandler):
        def do_POST(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(b"<!doctype html><p>some other service")

        def log_message(self, *_):
            pass

    other = http.server.ThreadingHTTPServer(("127.0.0.1", 0), NotAHub)
    threading.Thread(target=other.serve_forever, daemon=True).start()
    check("a service on the hub's port that answers 200 but is no hub: a plain tab", ["--profile-directory=Default", f"file://{fresh}"],
          browse(str(fresh), port=other.server_address[1]))
    check("...and claude-browser says so", True, "no container hub" in browse.said)
    other.shutdown()
    loose = open_page(page(HOME / "notes" / "unclaimed.html"))
    check("a page no session opened lands with the loose pages", "loose", loose["unit"])
    check("...a unit of that name, with no session to resume, no number on the rail and no account", ("loose pages", "", None, None, None),
          (lambda u: (u["title"], u["resume"], u["state"], u["number"], u["account"]))(view("loose")[1]))

    # one-hub-tab#P2 where no session page lists a unit's pages, a stand-in in the session lane does, until one exists
    standing = lambda key: request("GET", "/pages/" + urllib.parse.quote(key, safe=""))
    check("the loose pages have a stand-in for a session page, which the hub serves with the column the hub tab fills",
          ("/pages/loose", 200, True), (view("loose")[1]["session_page"]["url"], standing("loose")[0], b'id="artefacts"' in standing("loose")[1]))
    # the hub tab has a page's links from the page's first script on, the page still in standards mode
    calls_first = lambda body: body.lower().startswith(b"<!doctype html><script>") and b"wcCatch" in body.split(b"</script>")[0]
    check("a page the hub serves, a shared directory's listing and a stand-in each start with a script handing the hub tab their links",
          [True] * 3, [calls_first(request("GET", url)[1]) for url in (shared["url"] + "nested/review.html", shared["url"], "/pages/loose")])
    late = open_page(page(alpha / "agent/show/csv-import/late.html"), LATECOMER)
    stand_in = view(LATECOMER)[1]["session_page"]
    check("so has a session's unit before its session page is rendered", f"/pages/{LATECOMER}", stand_in["url"])
    request("POST", "/api/open", {"unit": LATECOMER, "target": stand_in["url"], "by": "user"}, {"Origin": ORIGIN})
    check("...which, opened from the hub tab, heads the unit as its session page, and lists the unit's pages but itself",
          ([("session", "session")], [late["id"]]),
          (lambda u: ([(m["kind"], m["lane"]) for m in u["members"] if m["url"] == stand_in["url"]], [p["id"] for p in u["pages"]]))(view(LATECOMER)[1]))
    real = page(alpha / f"agent/sessions/{LATECOMER}/index.html")
    real_url = "/f" + urllib.parse.quote(str(real.resolve()))
    check("...and goes once the session page exists, which takes its place in the unit", (real_url, [real_url]),
          (lambda u: (u["session_page"]["url"], [m["url"] for m in u["members"] if m["kind"] == "session"]))(view(LATECOMER)[1]))
    check("a unit unknown to the hub has no stand-in", 404, standing("no-such-unit")[0])

    # --- hub-rail-marks-sessions-needing-you: what an idle session's page says it needs
    if not READER:
        print("skip: no mx plugin here, whose session page reader the rail reads a page by")
    else:
        asking = alpha / f"agent/sessions/{ASKER}"
        turn_record(asking, 1, "Two ways to import, Q1 picks", ("Q1",), at=time.time() - 100)
        open_page(page(asking / "index.html"), ASKER)
        registered(ASKER, "idle")
        request("POST", "/api/visit", {"unit": ASKER})
        asker = lambda: (lambda u: (u["state"], u["needs_you"], u["status_line"]))(view(ASKER)[1])
        check("an idle session whose page has an open question, every record seen, needs you for the question",
              ("idle", {"questions": 1, "unseen": False}, "Two ways to import, Q1 picks"), asker())
        registered(ASKER, "busy")
        check("hub-rail-marks-sessions-needing-you#P2: a busy session shows busy, whatever its page holds", ("busy", None), asker()[:2])
        registered(ASKER, "waiting", waiting_for="permission prompt")
        check("...and a blocked one blocked", ("waiting", None), asker()[:2])
        registered(ASKER, "idle")
        turn_record(asking, 2, "Imported the CSV files as Q1 (a) has it", answered={"Q1": "a"})
        check("hub-rail-marks-sessions-needing-you#P1: a turn record written since the last visit marks it, the question it answered not",
              ("idle", {"questions": 0, "unseen": True}, "Imported the CSV files as Q1 (a) has it"), asker())
        request("POST", "/api/visit", {"unit": ASKER})
        check("...and once visited, nothing open, it does not need you", None, asker()[1])
        long_ago = time.time() - 1000  # its last turn's end, older than any other running session's
        os.utime(asking / "index.html", (long_ago, long_ago))
        registered(ASKER, "idle", long_ago)
        numbered_units = lambda: [u["unit"] for u in rail() if u["number"]]
        unneeded = numbered_units()
        check("...numbered by its last turn's end, after the idle sessions that finished one since", True,
              unneeded.index(ASKER) > 0)
        time.sleep(1)  # a chat turn's time is to the second
        chat_turn(asking, "```text\nimport running\n```\n\n## **Waiting** on the worker\n\nI report once it lands.", time.time())
        check("a chat turn after it marks nothing, and is the status line, its first line of prose without its markup",
              (None, "Waiting on the worker"), asker()[1:])
        turn_record(asking, 3, "Two more calls", ("Q2", "Q3"))
        turn_record(asking, 4, "Q2 settled, Q3 stands", answered={"Q2": "b"})
        request("POST", "/api/visit", {"unit": ASKER})
        check("a question asked in an earlier record stays open beside one answered, whichever turn asked it",
              ({"questions": 1, "unseen": False}, "Q2 settled, Q3 stands"), asker()[1:])
        check("a session that needs you is 1 on the rail, however long ago its turn ended, and the rest keep their order",
              [ASKER, *(u for u in unneeded if u != ASKER)], numbered_units())
        (asking / "turns/05.md").write_text("no frontmatter\n")
        check("a record the reader refuses leaves the unit there, needing nothing and saying nothing", (200, None, ""),
              (lambda r: (r[0], r[1]["needs_you"], r[1]["status_line"]))(view(ASKER)))
    eta = repo("eta", [("lonely", None, STRANGER)])
    open_page(page(eta / "agent/show/lonely/index.html"))
    view("loose")
    (eta / "agent/tickets/lonely.md").unlink()
    check("...which a tree retired does not take, the loose pages of no tree still in it", (200, True),
          (lambda r: (r[0], loose["id"] in [m["id"] for m in r[1].get("members", [])]))(view("loose")))

    closing = http.client.HTTPConnection("127.0.0.1", PORT, timeout=10)
    closing.request("GET", "/events")
    stream = closing.getresponse()
    stream.readline(), stream.readline()
    showing = open_page(fresh, WORKER)
    check("with a hub tab listening, an open launches none, and gives its caller nothing to open", (False, None),
          (showing["launch"], showing["open"]))
    stream.readline(), stream.readline()  # read to the end, as a tab does: it closes then with a FIN, never a reset
    stream.close()
    closing.close()
    time.sleep(2)  # the hub looks for a closed tab once a second
    closed = open_page(fresh, WORKER)
    check("...and once that tab closes, the next open launches one, at the unit and the member", (True, f"{ORIGIN}/u/{WORKER}#{closed['id']}"),
          (closed["launch"], closed["open"]))
    check("...saying something else than an open into a listening tab", True, closed["say"] != showing["say"])
    killed = socket.create_connection(("127.0.0.1", PORT), timeout=10)
    killed.sendall(f"GET /events HTTP/1.1\r\nHost: 127.0.0.1:{PORT}\r\n\r\n".encode())
    killed.recv(4096)
    check("a hub tab whose browser is killed launches none while it listens", False, open_page(fresh, WORKER)["launch"])
    killed.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
    killed.close()  # with what the hub sent it unread, which closes with a reset
    time.sleep(2)
    check("...and once it is gone, the next open launches one", True, open_page(fresh, WORKER)["launch"])
    check("a board handed in while that tab has not listened yet launches no second one", False, open_page(board, WORKER)["launch"])
    late = urllib.request.urlopen(f"{ORIGIN}/events", timeout=10)
    while not (line := late.readline().decode()).startswith("data:"):
        pass
    check("...and the tab hears of it once it listens", ("board", board_url, WORKER),
          tuple(json.loads(line[5:])[k] for k in ("type", "url", "unit")))
    late.close()
    time.sleep(2)  # the hub looks for a closed tab once a second

    # --- a watched diffview: in the unit of the session that started it, while its worktree exists

    worktree = HOME / "repos" / "alpha-csv-import"
    git(alpha, "worktree", "add", "-q", "-b", "csv-import", str(worktree))
    (worktree / "notes.txt").write_text("one\ntwo\n")
    watcher = subprocess.Popen([BIN / "diffview", f"{worktree}@HEAD..", "--watch", "--open", "--no-auto-summary"],
                               cwd=alpha, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True,
                               env={**ENV, "CONTAINER_HUB_PORT": str(PORT), "CLAUDE_CODE_SESSION_ID": ORCHESTRATOR,
                                    "DIFFVIEW_BROWSER": "claude-browser", "PATH": f"{stubs}:{BIN}:{ENV['PATH']}"})
    try:
        said = []
        while (line := watcher.stdout.readline()) and "watching" not in line:
            said.append(line)
        live = line.split("live page at ")[-1].split()[0] if "live page at " in line else line
        check("--watch prints the hub's address of its page", True, live.startswith(f"{ORIGIN}/f/"))
        check("...and its watcher listens on no port", [], listening_ports(watcher.pid))
        watched = Path(urllib.parse.unquote(urllib.parse.urlsplit(live).path.removeprefix("/f")))
        member = lambda: next((m for m in view(ORCHESTRATOR)[1].get("members", []) if m["path"] == str(watched)), None)
        deadline = time.monotonic() + 30
        while not member() and time.monotonic() < deadline:
            time.sleep(0.2)
        check("--watch --open puts the page in the unit of the session that started it", True, member() is not None)
        check("the hub says its watcher runs", True, member() and request("GET", member()["url"] + ".watch.json")[1].get("alive"))
        record = "/f" + urllib.parse.quote(str(watched)) + ".watch.json"
        git(alpha, "worktree", "remove", "--force", str(worktree))
        check("the watcher stops once its worktree is removed", 0, watcher.wait(timeout=30))
        check("...and the hub says it stopped for good", (False, True),
              (request("GET", record)[1].get("alive"), request("GET", record)[1].get("gone")))
        check("...and the page leaves its unit", None, member())
        check("...though its file stays", True, watched.is_file())
    finally:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(watcher.pid, signal.SIGKILL)   # `uv run` leads the group; the watcher is its child
        watcher.wait()

    # --- a damaged state file; the containers' state of the hub before units

    def restart() -> subprocess.Popen:
        os.killpg(hub.pid, signal.SIGKILL)
        hub.wait()
        # `uv run` leads the group and is reaped first; the server holds the port until it is gone too
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            try:
                os.killpg(hub.pid, 0)
                time.sleep(0.05)
            except ProcessLookupError:
                break
        started = subprocess.Popen([BIN / "container-hub", "--port", str(PORT), "--state", str(SCRATCH / "state"), *HUB_FLAGS],
                                   env=ENV, stdout=subprocess.DEVNULL, stderr=(SCRATCH / "hub.log").open("a"), start_new_session=True)
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline and started.poll() is None:
            try:
                socket.create_connection(("127.0.0.1", PORT), timeout=1).close()
                break
            except OSError:
                time.sleep(0.1)
        return started

    (SCRATCH / "state/units/damaged.json").write_text("{not json")
    UNREADABLE = os.geteuid() != 0  # mode 0 stops no read by root
    if UNREADABLE:
        unreadable = SCRATCH / "state/units/unreadable.json"
        unreadable.write_text('{"key": "unreadable", "members": []}\n')
        unreadable.chmod(0)  # read, it raises; nothing can tell what it holds
    fleeting = page(HOME / "fleeting.html")
    request("POST", "/api/serve", {"path": str(fleeting)})
    fleeting.unlink()
    MIGRANT = "99999999-0000-4000-8000-00000000000b"
    old_member = {"id": "m0123456789", "url": "/f" + urllib.parse.quote(str(note)), "path": str(note), "group": MIGRANT,
                  "ticket": None, "kind": "page", "title": "scratch.html", "first": 1.0, "at": 2.0, "by": "agent", "closed": False, "agent": True}
    old_board = {**old_member, "id": "mboard00000", "url": board_url, "path": str(board), "kind": "board", "title": "board.html"}
    old_tracker = str((alpha / "agent/tickets").resolve())
    page(SCRATCH / "state/containers/session-old.json", json.dumps({
        "key": "session-old", "name": "session old", "tracker": old_tracker, "members": [old_member, old_board],
        "seen": {"/f/an/old/page.html": 3.0}, "visited": {MIGRANT: 4.0}}))
    page(SCRATCH / "state/seen.json", json.dumps({"/f/an/old/page.html": 3.0}))
    LEGACY = "99999999-0000-4000-8000-00000000000c"
    page(SCRATCH / f"state/units/{LEGACY}.json", json.dumps({
        "key": LEGACY, "session": LEGACY, "tracker": old_tracker, "roots": {}, "visited": 0, "dismissed": 0,
        "members": [{**old_member, "id": "m1111111111"}, {**old_board, "id": "mboard11111"}]}))
    hub = restart()
    check("a unit an earlier hub kept has its board dropped on a restart, the board being the rail's", ["m1111111111"],
          [m["id"] for m in view(LEGACY)[1].get("members", [])])
    check("...and its tracker moved onto its pages", ([old_tracker], False),
          ([m.get("tracker") for m in view(LEGACY)[1]["members"]], "tracker" in json.loads((SCRATCH / f"state/units/{LEGACY}.json").read_text())))
    check("a shared page deleted before a restart leaves the list of what is shared", False,
          str(fleeting) in json.loads((SCRATCH / "state/served.json").read_text()))
    check("a damaged state file does not keep the hub from starting", (None, 200), (hub.poll(), request("GET", "/api/hub")[0]))
    check("...and the units beside it are still there", 200, view(WORKER)[0])
    check("...and it is moved aside, not left for the next save to overwrite", (False, 1),
          ((SCRATCH / "state/units/damaged.json").exists(), len(list((SCRATCH / "state/units").glob("damaged.json.unreadable-*")))))
    check("a page an agent opened outside every agent directory is served after a restart", 200,
          request("GET", "/f" + urllib.parse.quote(str(note)))[0])
    check("a container the hub kept before units has its pages moved into their session's unit, but its board", (["m0123456789"], 4.0),
          (lambda r: ([m["id"] for m in r.get("members", [])], r.get("visited")))(view(MIGRANT)[1]))
    check("...each page with the container's tracker", [old_tracker], [m.get("tracker") for m in view(MIGRANT)[1]["members"]])
    check("...its seen marks dropped, as the seen marks an earlier hub kept are", (False, False),
          ("seen" in request("GET", "/api/hub")[1], (SCRATCH / "state/seen.json").exists()))
    check("...and the containers set aside", (False, 1),
          ((SCRATCH / "state/containers").exists(), len(list((SCRATCH / "state").glob("containers.before-units-*")))))
    if UNREADABLE:
        check("the rail still lists the rest beside a state file it cannot read", True, any(u["unit"] == WORKER for u in rail()))
        check("...and a page opened into its unit is refused, not written over it", 500,
              request("POST", "/api/open", {"target": str(note), "session": "unreadable"})[0])
        unreadable.chmod(0o644)
        check("...which is as it was", '{"key": "unreadable", "members": []}\n', unreadable.read_text())
    check("what was shared before the restart is served after it", (200, 200),
          (request("GET", shared["url"] + "nested/review.html")[0], request("GET", shared_page["url"])[0]))
    served_list = SCRATCH / "state/served.json"
    if UNREADABLE:
        listed = served_list.read_text()
        served_list.chmod(0)
        hub = restart()
        check("an unreadable list of shared pages does not keep the hub from starting", (None, 200), (hub.poll(), request("GET", "/api/hub")[0]))
        check("...and sharing is refused rather than written over it, asked twice", [500, 500],
              [request("POST", "/api/serve", {"path": str(alone)})[0] for _ in range(2)])
        check("...nor served", 403, request("GET", shared_page["url"])[0])
        served_list.chmod(0o644)
        check("...which is as it was", listed, served_list.read_text())
    else:
        print("skip: the unreadable-file checks, since root reads a file of mode 0")

    # --- a hub as its user service runs it: no tracker on PATH, the mx plugin's under HOME; and here no diffview beside it

    lone_bin = SCRATCH / "lone-bin"
    lone_bin.mkdir()
    for name in ("container-hub", "container-hub.html"):
        shutil.copy2(BIN / name, lone_bin / name)
    service_home = SCRATCH / "service-home"
    cache = service_home / ".claude/plugins/cache/market/mx"
    for version, script in (("1.0.9", "#!/bin/sh\nexit 1\n"), ("1.0.10", f'#!/bin/sh\nexec {shutil.which("tracker", path=ENV["PATH"])} "$@"\n')):
        (cache / version / "skills/tracker").mkdir(parents=True)
        (cache / version / "skills/tracker/tracker.py").write_text(script)
        (cache / version / "skills/tracker/tracker.py").chmod(0o755)
    # a reader from before chat turns: no in_order, no Chat
    (cache / "1.0.10/skills/session-page").mkdir(parents=True)
    (cache / "1.0.10/skills/session-page/session_page.py").write_text("def read_session(directory, transcript):\n    pass\n")
    service_port = free_port()
    service_hub = subprocess.Popen(
        [lone_bin / "container-hub", "--port", str(service_port), "--state", str(SCRATCH / "service-state"), *HUB_FLAGS],
        env={**ENV, "HOME": str(service_home), "PATH": ":".join(d for d in ENV["PATH"].split(":") if not (Path(d) / "tracker").exists())},
        stdout=subprocess.DEVNULL, stderr=(SCRATCH / "service-hub.log").open("w"), start_new_session=True)
    try:
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline and service_hub.poll() is None:
            try:
                socket.create_connection(("127.0.0.1", service_port), timeout=1).close()
                break
            except OSError:
                time.sleep(0.1)
        check("the hub as its service runs it starts", None, service_hub.poll())
        service = lambda *args: request(*args, origin=f"http://127.0.0.1:{service_port}")
        service("POST", "/api/open", {"target": str(alpha / "agent/show/csv-import/index.html"), "session": WORKER})
        check("with no tracker on PATH, the hub reads the tracker of the newest mx plugin", "map-columns",
              service("GET", f"/api/u/{WORKER}")[1].get("tree"))
        check("...and with a session page reader it cannot use, marks nothing and serves the rail all the same",
              (200, None, ""), (lambda r: (r[0], r[1].get("needs_you"), r[1].get("status_line")))(service("GET", f"/api/u/{WORKER}")))
        check("a hub with no diffview beside it says its pages cannot save", (200, {"saves": False}), service("GET", "/.health"))
        check("...and refuses a save, as no route it has", 404,
              service("POST", "/f" + urllib.parse.quote(str(code_diff)) + ".state.json", {}, {"Origin": f"http://127.0.0.1:{service_port}"})[0])
    finally:
        os.killpg(service_hub.pid, signal.SIGKILL)
        service_hub.wait()
    check("no tmux call, the hub's or the test's, went to a server other than the test's own", "",
          TMUX_REFUSED.read_text() if TMUX_REFUSED.exists() else "")
finally:
    os.killpg(hub.pid, signal.SIGKILL)  # `uv run` leads the group; the server is its child
    hub.wait()
    shutil.rmtree(SCRATCH, ignore_errors=True)

print()
print("FAILED" if failures else "all ok")
sys.exit(1 if failures else 0)
