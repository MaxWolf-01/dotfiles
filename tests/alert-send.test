#!/usr/bin/env bash
# Drive bin/alert-send against a stubbed curl and check what it would have
# submitted. Run it directly; no framework.
#
# The promises here: the subject and body survive UTF-8, the attachment rides
# along, a missing attachment costs a note rather than the alert, the
# credential never touches the command line, every failure — config, token,
# SMTP — comes back as the exit code the callers record, a call without
# --inline builds the message it built before --inline existed, and --inline
# shows its images in an HTML version of the body.

set -uo pipefail

bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# The stub records curl's argv and the raw message file, so the cases below can
# look at both the wire arguments and the MIME the script built. STUB_CURL_EXIT
# lets a case play the server rejecting the submission.
mkdir -p "$work/stub"
cat >"$work/stub/curl" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$@" > "$WORK/argv"
msg="" prev=""
for a in "$@"; do
    [ "$prev" = "--upload-file" ] && msg="$a"
    prev="$a"
done
[ -n "$msg" ] && cp "$msg" "$WORK/message"
exit "${STUB_CURL_EXIT:-0}"
STUB
chmod +x "$work/stub/curl"
export PATH="$work/stub:$PATH"
export WORK="$work"

export HOME="$work/home"
mkdir -p "$HOME/.dotfiles/secrets/monitoring"
cat >"$HOME/.dotfiles/secrets/monitoring/alert.conf" <<'CONF'
smtp_url="smtp://localhost:587"
smtp_user="test@example.invalid"
password_command="echo test-token"
mail_from="from@example.invalid"
mail_to="to@example.invalid"
CONF

decoded_subject() { sed -n 's/^Subject: =?UTF-8?B?\(.*\)?=$/\1/p' "$work/message" | base64 -d; }
decoded_body() {
    awk '/^Content-Transfer-Encoding: base64$/{f=1;next} f&&/^$/{b=1;next} b&&/^--/{exit} b{print}' \
        "$work/message" | base64 -d
}

# --- the happy path: subject, body and attachment all arrive intact

printf 'attached payload\n' > "$work/payload.log"
printf 'body line one\nbody line two\n' \
    | "$bin_dir/alert-send" "⚠️ unit-x - Integrity Check Failed" --attach "$work/payload.log"
check "a delivered alert exits 0" 0 "$?"
check "the UTF-8 subject survives the encoding" \
    "⚠️ unit-x - Integrity Check Failed" "$(decoded_subject)"
check "the body survives it too" \
    "body line one
body line two" "$(decoded_body)"
check "the attachment is a named MIME part" \
    "yes" \
    "$(grep -q 'Content-Disposition: attachment; filename="payload.log"' "$work/message" && echo yes || echo no)"
check "the attachment content rides along" \
    "yes" \
    "$(grep -q "$(printf 'attached payload\n' | base64)" "$work/message" && echo yes || echo no)"
check "the sender and recipient come from the config" \
    "yes" \
    "$(grep -q '^From: from@example.invalid$' "$work/message" \
        && grep -q '^To: to@example.invalid$' "$work/message" && echo yes || echo no)"
check "the token never touches curl's command line" \
    "" "$(grep -o 'test-token' "$work/argv")"
check "the submission asks for TLS and CRLF" \
    "yes" \
    "$(grep -qx -- '--ssl-reqd' "$work/argv" && grep -qx -- '--crlf' "$work/argv" && echo yes || echo no)"

# --- a missing attachment costs a note, never the alert

rm -f "$work/message"
echo body | "$bin_dir/alert-send" "subject" --attach "$work/does-not-exist.log"
check "a missing attachment still sends, exit 0" 0 "$?"
check "...with the missing file named in the body" \
    "yes" \
    "$(decoded_body | grep -q 'attachment missing or unreadable: .*does-not-exist' && echo yes || echo no)"

# --- without --inline, the message is the one alert-send built before --inline
# existed: tests/fixtures/alert-send/without-inline.eml is that version's output,
# with the date and the boundary, which change on every call, blanked out.

normalised() {
    sed -e 's/^Date: .*/Date: DATE/' -e 's/alert-send-[0-9]*-[0-9]*/BOUNDARY/g' "$work/message"
}
printf 'body line one\nbody line two\n' \
    | "$bin_dir/alert-send" "⚠️ unit-x - Integrity Check Failed" --attach "$work/payload.log"
check "a call without --inline builds today's message" \
    "$(cat "$bin_dir/../tests/fixtures/alert-send/without-inline.eml")" "$(normalised)"

# --- --inline: the body as text and as HTML, the image shown by cid: in the HTML,
# the attachment still beside them. Python's email parser is the independent
# reader of the MIME.

printf '\x89PNG\r\n\x1a\nnot really an image' > "$work/code.png"
printf 'Amount: 1 < 2 & 3\n' \
    | "$bin_dir/alert-send" "subject" --inline "$work/code.png" --attach "$work/payload.log"
check "a message with an inline image exits 0" 0 "$?"
check "it parses as MIME with text, HTML, the image by cid: and the attachment" "ok" \
    "$(uv run --no-project --quiet python - "$work/message" "$work/code.png" <<'PY2'
import email, email.policy, sys
msg = email.message_from_binary_file(open(sys.argv[1], "rb"), policy=email.policy.default)
image = open(sys.argv[2], "rb").read()
problems = [f"defect: {d!r}" for part in msg.walk() for d in part.defects]
shape = [part.get_content_type() for part in msg.walk()]
want = ["multipart/mixed", "multipart/related", "multipart/alternative",
        "text/plain", "text/html", "image/png", "application/octet-stream"]
if shape != want:
    problems.append(f"shape {shape}")
else:
    parts = list(msg.walk())
    text, html, png = parts[3].get_content(), parts[4].get_content(), parts[5]
    cid = png["Content-ID"].strip("<>")
    if text != "Amount: 1 < 2 & 3\n":
        problems.append(f"text {text!r}")
    if "Amount: 1 &lt; 2 &amp; 3" not in html:
        problems.append("the HTML does not carry the escaped body")
    if f'src="cid:{cid}"' not in html:
        problems.append(f"the HTML does not show cid:{cid}")
    if png.get_content() != image or png.get_content_disposition() != "inline":
        problems.append("the image is not the file, inline")
    if parts[6].get_filename() != "payload.log":
        problems.append("the attachment is gone")
print("\n".join(problems) or "ok")
PY2
)"

rm -f "$work/message"
echo body | "$bin_dir/alert-send" "subject" --inline "$work/gone.png"
check "a missing inline image still sends, exit 0" 0 "$?"
check "...with the missing image named in the body" \
    "yes" \
    "$(decoded_body | grep -q 'inline image missing or unreadable: .*gone.png' && echo yes || echo no)"

rm -f "$work/message"
echo body | "$bin_dir/alert-send" "subject" --inline "$work/payload.log" 2>/dev/null
check "--inline with a file that is not an image exits 2" 2 "$?"
check "...and sends nothing" "no" "$([ -e "$work/message" ] && echo yes || echo no)"

# --- every failure is the exit code the run logs record

echo body | STUB_CURL_EXIT=67 "$bin_dir/alert-send" "subject" 2>/dev/null
check "an SMTP rejection exits 1" 1 "$?"

echo body | "$bin_dir/alert-send" 2>/dev/null
check "a missing subject exits 2" 2 "$?"

echo 'password_command="false"' >> "$HOME/.dotfiles/secrets/monitoring/alert.conf"
echo body | "$bin_dir/alert-send" "subject" 2>/dev/null
check "a failing password command exits 2" 2 "$?"
sed -i '$d' "$HOME/.dotfiles/secrets/monitoring/alert.conf"

HOME="$work/nowhere" bash -c 'echo body | "$0" "subject"' "$bin_dir/alert-send" 2>/dev/null
check "a missing channel config exits 2" 2 "$?"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
    exit 0
fi
echo "$failures check(s) failed"
exit 1
