#!/usr/bin/env bash
# Drive vpn-pick's status parsing. Run it directly; no framework.
#
# The watcher acts on two fields it digs out of a `tailscale status --json`
# blob, and each of the shapes that blob can take steers a different branch:
# a live node, a dead node it must re-pick, the VPN deliberately off, and
# tailscale not answering at all. Reading one of those as another either
# rotates the exit node for no reason or leaves a dead one in place, so this
# pins the mapping from blob to fields.

set -uo pipefail

vpn_pick="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/vpn-pick"
# Belt and braces: the script's own guard already refuses to dispatch when
# sourced, and this makes a run of these tests harmless even if that guard is
# ever dropped. Dispatching would rotate the live exit node.
export VPN_PICK_NO_DISPATCH=1
# shellcheck source=../bin/vpn-pick
source "$vpn_pick"

failures=0

check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# Drives the real function watch() calls, not a copy of it, so a regression in
# either the jq filter or the bash-side assembly shows up here.
fields() {  # fields <status-json>
    local id online
    read_exit_node "$1"
    echo "id=$id online=$online"
}

# --- the four shapes the blob takes in the wild

check "live node keeps its id and reads online" \
    "id=nodeABC online=true" \
    "$(fields '{"ExitNodeStatus":{"ID":"nodeABC","Online":true}}')"

# The branch that matters: `online` must survive as the literal false, or the
# watcher never re-picks a dead node -- the failure it exists to catch.
check "dead node reads false, not empty" \
    "id=nodeABC online=false" \
    "$(fields '{"ExitNodeStatus":{"ID":"nodeABC","Online":false}}')"

check "vpn off leaves the id empty" \
    "id= online=null" \
    "$(fields '{"ExitNodeStatus":null}')"

check "tailscale down leaves both empty" \
    "id= online=" \
    "$(fields '')"

check "unparseable blob leaves both empty" \
    "id= online=" \
    "$(fields 'not json at all')"

# --- the watch loop fetches with --peers=false, so ExitNodeStatus has to come
# --- out of a blob with no peers in it. Shape captured from the live daemon.

check "peerless blob still carries both fields" \
    "id=nMQ9SbK6Q721CNTRL online=true" \
    "$(fields '{"BackendState":"Running","Peer":null,"Self":{"HostName":"zephylux"},"ExitNodeStatus":{"ID":"nMQ9SbK6Q721CNTRL","Online":true,"TailscaleIPs":["100.83.36.108/32"]}}')"

# --- exit_node_name reads the peer list, which only the full status carries

check "names the peer acting as exit node" "de-dus-wg-101" \
    "$(exit_node_name '{"Peer":{"a":{"HostName":"pc","ExitNode":false},"b":{"HostName":"de-dus-wg-101","ExitNode":true}}}')"

check "no exit-node peer names nothing" "" \
    "$(exit_node_name '{"Peer":{"a":{"HostName":"pc","ExitNode":false}}}')"

check "a peerless blob names nothing" "" \
    "$(exit_node_name '{"Peer":null}')"

# --- the heartbeat is the only thing that can catch --peers=false going blind
#
# Its inputs are stubbed so these drive the decision rather than the machine's
# real tailscale state. `outcome reason` is what reaches the run log.

beat() {  # beat <full-status-json> <poll-blob> <exit-node-id>
    # Not `full`: bash scopes dynamically, and heartbeat's own `local full`
    # would shadow it by the time the stub is called.
    local _beat_status="$1"
    tailscale() { printf '%s' "$_beat_status"; }
    vesktop_running() { return 1; }
    log_run() { echo "$2 ${3:-}"; }
    heartbeat "$2" "$3"
    unset -f tailscale vesktop_running log_run
}

peer_is_exit='{"Peer":{"b":{"HostName":"de-dus-wg-101","ExitNode":true}}}'
no_peer_exit='{"Peer":{"a":{"HostName":"pc","ExitNode":false}}}'

check "guarding a live node records ok" "ok " \
    "$(beat "$peer_is_exit" '{"ExitNodeStatus":{"ID":"nX","Online":true}}' nX)"

check "vpn genuinely off records ok" "ok " \
    "$(beat "$no_peer_exit" '{"ExitNodeStatus":null}' '')"

check "tailscale down records ok" "ok " \
    "$(beat '' '' '')"

# The regression this exists for: the poll saw no exit node, but the peer list
# says one is in use. That can only mean the field the poll reads stopped being
# filled — so the loop is idling while a pinned node has no failover.
check "poll blind to a live exit node records fail" \
    "fail a peer is acting as exit node but ExitNodeStatus was empty — the poll is blind to it" \
    "$(beat "$peer_is_exit" '{"ExitNodeStatus":null}' '')"

# --- a real blob carries the surrounding netmap; the fields still come out

check "fields survive a blob with peers around them" \
    "id=nodeXYZ online=true" \
    "$(fields '{"BackendState":"Running","Peer":{"n1":{"HostName":"de-ber","ExitNode":true}},"ExitNodeStatus":{"ID":"nodeXYZ","Online":true,"TailscaleIPs":["100.1.2.3"]}}')"

# --- sourcing this file must not dispatch: reaching here proves it did not

check "sourcing vpn-pick runs no subcommand" "sourced" "sourced"

echo
# --- the Vesktop gate: a symlink Electron holds while an instance is up
#
# It decides whether the loop probes Discord at all, so a wrong answer either
# leaves a blocked exit node unnoticed or probes against an app that is closed.

gate_dir=$(mktemp -d)
trap 'rm -rf "$gate_dir"' EXIT
VESKTOP_LOCK="$gate_dir/SingletonLock"

check "no lock means no instance" "closed" \
    "$(vesktop_running && echo open || echo closed)"

ln -sfn "$(hostname)-$$" "$VESKTOP_LOCK"
check "a lock naming a live pid means running" "open" \
    "$(vesktop_running && echo open || echo closed)"

# An unclean exit leaves the symlink behind. Reading it as a live instance
# would keep the loop probing Discord forever against an app that is gone.
# pid_max itself is the one number the allocator can never hand out.
ln -sfn "$(hostname)-$(cat /proc/sys/kernel/pid_max)" "$VESKTOP_LOCK"
check "a lock naming a dead pid is stale, not running" "closed" \
    "$(vesktop_running && echo open || echo closed)"

rm -f "$VESKTOP_LOCK"
mkdir -p "$VESKTOP_LOCK"
check "a plain directory where the lock goes is not an instance" "closed" \
    "$(vesktop_running && echo open || echo closed)"
rmdir "$VESKTOP_LOCK"

echo
if [ "$failures" -eq 0 ]; then
    echo "all checks passed"
    exit 0
fi
echo "$failures check(s) failed"
exit 1
