#!/usr/bin/env bash
# tier: fast
# Drive bin/worker-hosts with a stand-in ssh that plays each host's answer locally. Run it directly; no framework.
#
# What an orchestrator relies on: a host whose /home is locked shows as locked, with the command that unlocks it,
# rather than as an idle host ready for work; and the record printed for a host it cannot read is that host's own,
# whose "After a reboot" names the right unlock.

set -uo pipefail

bin="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"

# The stand-in: xmg19 answers as a host whose /home is not mounted, pc as one whose home is there, and any
# `cat HOST.md` fails, as it does while a home is locked or a host is off.
mkdir -p "$scratch/bin" "$scratch/home"
cat >"$scratch/bin/ssh" <<EOF
#!/usr/bin/env bash
while [[ \$1 == -o ]]; do shift 2; done
target=\$1; shift
[ "\$*" = "bash -s" ] || { echo "ssh: connect to host \$target port 22: Connection timed out" >&2; exit 255; }
case \$target in
    *@xmg19) HOME=$scratch/missing exec bash -s ;;
    *) HOME=$scratch/home exec bash -s ;;
esac
EOF
# Nor are the test runner's processes: claude runs twice as agent and once as agent-hl, as
# `pgrep -c -x claude -u <users>` counts them, and `id -un` answers agent.
cat >"$scratch/bin/pgrep" <<'EOF'
#!/usr/bin/env bash
users=${@: -1}; n=0
for u in ${users//,/ }; do case $u in agent) n=$((n + 2)) ;; agent-hl) n=$((n + 1)) ;; esac; done
echo $n
EOF
printf '#!/bin/sh\necho agent\n' >"$scratch/bin/id"
chmod +x "$scratch/bin/pgrep" "$scratch/bin/id"
# Neither the real GPU nor the test runner's tmux server is asked anything.
printf '#!/bin/sh\nexit 9\n' >"$scratch/bin/nvidia-smi"
chmod +x "$scratch/bin/ssh" "$scratch/bin/nvidia-smi"
export PATH="$scratch/bin:$PATH" TMUX_TMPDIR="$scratch"
unset TMUX

# --- the listing

out=$("$bin/worker-hosts")
section() { awk -v h="$1 — " 'index($0, h) == 1 {on = 1} on && NF == 0 {exit} on' <<<"$out"; }
[[ $(section agent@xmg19) == *'/home locked: no worker can run until `host-unlock xmg19` on zephylux'* ]] &&
    passed "a host whose home is locked shows as locked, with the unlock to run" ||
    fail "a host whose home is locked shows as locked, with the unlock to run" "$out"
[[ $(section agent@xmg19) != *"workers:"* ]] && passed "a locked host shows no resources as if ready" ||
    fail "a locked host shows no resources as if ready" "$out"
[[ $(section agent@pc) == *"sessions: none"* && $(section agent@pc) != *locked* ]] &&
    passed "a host whose home is there shows its resources, not locked" ||
    fail "a host whose home is there shows its resources, not locked" "$out"

[[ $(section agent@pc) == *"workers: 2 claude running here; 3 of 6 slots used on pc"* ]] &&
    passed "a host counts its user's claude, and the machine's slots used by every worker user on it" ||
    fail "a host counts its user's claude, and the machine's slots used by every worker user on it" "$(section agent@pc)"

# --- what placement reads

out=$("$bin/worker-hosts" --readings)
expected=$(printf '%s\t' agent@pc pc personal 6 agent-hl,agent - true up 2 3 12)
[[ $(grep '^agent@pc' <<<"$out") == "$expected"* ]] &&
    passed "a reading carries the record's slots, the machine's users and what its host counted" ||
    fail "a reading carries the record's slots, the machine's users and what its host counted" "$out"
expected=$(printf '%s\t' agent@xmg19 xmg19 personal 8 agent-hl,agent gpu true locked - - -)-
[[ $(grep '^agent@xmg19' <<<"$out") == "$expected" ]] &&
    passed "a locked host reads as locked, with nothing counted" ||
    fail "a locked host reads as locked, with nothing counted" "$out"

# --- one host's record, read from the checkout

out=$("$bin/worker-hosts" agent@xmg19 2>/dev/null)
[[ $out == *"host-unlock xmg19"* && $out == *gpu-run* && $out != *"host-unlock pc"* ]] &&
    passed "xmg19's record, read from the checkout, carries xmg19's body" ||
    fail "xmg19's record, read from the checkout, carries xmg19's body" "$out"
out=$("$bin/worker-hosts" agent-hl@pc 2>/dev/null)
[[ $out == *"host-unlock pc"* && $out != *"host-unlock xmg19"* ]] &&
    passed "pc's record, read from the checkout, carries pc's body" ||
    fail "pc's record, read from the checkout, carries pc's body" "$out"

finish
