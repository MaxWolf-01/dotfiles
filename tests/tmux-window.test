#!/usr/bin/env bash
# tier: fast
# Drive nix/home/tmux-window.sh against a stubbed tmux, restore and shell. Run it
# directly; no framework.
#
# The promises here: a window takes the lowest-numbered session no client is
# attached to, never a named one or the restore's "0"; with none free, the lowest
# free number; with no server, the save is restored before anything else; and a
# hung server or a tmux that fails leaves a plain shell, not a dead window.

set -uo pipefail

script="$(cd "$(dirname "${BASH_SOURCE[0]}")/../nix/home" && pwd)/tmux-window.sh"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"

# list-sessions prints $work/list and exits $LIST_EXIT (124 is what timeout returns for a hang);
# anything else is recorded in $work/calls, with whether TMUX reached it, and exits $RUN_EXIT.
cat >"$work/tmux" <<'STUB'
#!/usr/bin/env bash
if [ "$1" = list-sessions ]; then cat "$WORK/list"; exit "${LIST_EXIT:-0}"; fi
echo "tmux TMUX=${TMUX-unset} $*" >>"$WORK/calls"
exit "${RUN_EXIT:-0}"
STUB
# The restore brings sessions back: after it, the list is $work/restored.
cat >"$work/restore" <<'STUB'
#!/usr/bin/env bash
echo "restore $#" >>"$WORK/calls"
cp "$WORK/restored" "$WORK/list"
STUB
printf '#!/usr/bin/env bash\necho "shell" >>"$WORK/calls"\n' >"$work/shell"
chmod +x "$work/tmux" "$work/restore" "$work/shell"

export WORK="$work" SHELL="$work/shell" TERM=xterm TMUX=/tmp/outer,1,0

# window <list-sessions lines...>: runs the script on that list; sets calls (one line per call, joined by " | ").
window() {
    printf '%s\n' "$@" >"$work/list"
    rm -f "$work/calls"
    err=$(bash "$script" "$work/tmux" "$work/restore" 2>&1 >/dev/null)
    calls=$(paste -sd'|' "$work/calls" | sed 's/|/ | /g')
}

window "1 1" "0 2" "0 10" "0 hub" "0 0"
check "lowest free number, numerically" "tmux TMUX=unset new-session -A -s 2" "$calls"

window "0 hub" "0 yap" "1 1" "1 3" "0 0"
check "none free: the lowest number no session has" "tmux TMUX=unset new-session -A -s 2" "$calls"

window "0 hub"
check "only named sessions: session 1" "tmux TMUX=unset new-session -A -s 1" "$calls"

printf '%s\n' "0 hub" "0 4" >"$work/restored"
LIST_EXIT=1 window
check "no server: the restore runs first, then its sessions count" \
    "restore 2 | tmux TMUX=unset new-session -A -s 4" "$calls"

LIST_EXIT=124 window "0 1"
check "a hung server gets a shell and never a tmux call" "shell" "$calls"
check "and says why" "server did not answer" "$(grep -o 'server did not answer' <<<"$err")"

RUN_EXIT=1 window "0 1"
check "tmux failing gets a shell" "tmux TMUX=unset new-session -A -s 1 | shell" "$calls"
check "and says with which status" "status 1" "$(grep -o 'status 1' <<<"$err")"

finish
