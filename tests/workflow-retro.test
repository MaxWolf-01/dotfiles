#!/usr/bin/env bash
# tier: fast
# Drive bin/workflow-retro against a stub retro and check the job run log line each ending
# leaves. Run it directly; no framework.
#
# The promises under test. Every retro leaves exactly one line in its own job's log. Its outcome
# is one the watchdog can trust: a quiet week is a skip, never an ok. Its reason is the retro's
# own last word, also when the TERM a stopped unit sends stopped it. The workflow-retro unit runs
# the workflow retro alone. The repo-retros unit (--repos) runs each repo on the list of repo
# retros, in order, until a stop.

set -uo pipefail

wrapper="$(cd "$(dirname "${BASH_SOURCE[0]}")/../bin" && pwd)/workflow-retro"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
export RUN_LOG_DIR="$work/runs"
export REPO_RETROS="$work/no-repos"
: > "$REPO_RETROS"

. "$(dirname "${BASH_SOURCE[0]}")/check.sh"
needs jq setsid

# The agents repo, as far as the wrapper reaches into it: mx's retro, here a stub.
# - It appends its arguments as a line of $STUB_CALLS.
# - It prints $STUB_LINES as the retro prints its log, and exits $STUB_EXIT.
# - A file in $STUB_REPOS named for the repo it runs on sets those values for that repo.
# - With $STUB_READY set, a fifo, it instead writes a line to it and waits to be stopped.
agents="$work/agents"
mkdir -p "$agents/mx/bin"
cat > "$agents/mx/bin/retro" <<'STUB'
#!/usr/bin/env bash
echo "$*" >> "$STUB_CALLS"
[ -f "$STUB_REPOS/$(basename "$1")" ] && . "$STUB_REPOS/$(basename "$1")"
if [ -n "${STUB_READY:-}" ]; then
    trap 'echo "2026-10-19T00:10:00Z 2026-10-19T000000Z stopped: SIGTERM during collect, which ended with it" >&2; exit 143' TERM
    echo ready > "$STUB_READY"
    sleep infinity & wait $!
fi
printf '%s' "${STUB_LINES:-}" >&2
exit "${STUB_EXIT:-0}"
STUB
chmod +x "$agents/mx/bin/retro"
export STUB_CALLS="$work/calls" STUB_REPOS="$work/repos"
mkdir "$STUB_REPOS"

# The newest line of a job's run log, the workflow retro's by default, as "<outcome> | <reason> | <exit>".
logged() {
    tail -n1 "$RUN_LOG_DIR/${1:-workflow-retro}.jsonl" | jq -r '"\(.outcome) | \(.reason) | \(.stats.exit)"'
}

lines() {
    wc -l < "$RUN_LOG_DIR/workflow-retro.jsonl" | tr -d ' '
}

# --- a committed report is an ok, and the retro is asked to skip a quiet week

: > "$STUB_CALLS"
STUB_EXIT=0 STUB_LINES="2026-10-19T00:00:01Z 2026-10-19T000000Z started: $agents, ...
2026-10-19T01:30:00Z 2026-10-19T000000Z committed 1a2b3c4 in $agents/agent
" "$wrapper" "$agents" --data "$work/data" >/dev/null 2>&1
check "a committed run exits 0" 0 $?
check "a committed run is ok, with the retro's last line as its reason" \
    "ok | committed 1a2b3c4 in $agents/agent | 0" "$(logged)"
check "the retro runs on the agents repo, gated, with the options passed on" \
    "$agents --if-active --data $work/data" "$(cat "$STUB_CALLS")"

# --- a quiet week is a skip

STUB_EXIT=3 STUB_LINES="2026-10-19T00:00:01Z 2026-10-19T000000Z skipped: no session or commit of max's since 2026-10-12T00:00:00Z
" "$wrapper" "$agents" >/dev/null 2>&1
check "a skipped run exits 0" 0 $?
check "a quiet week is a skip, saying why" \
    "skip | skipped: no session or commit of max's since 2026-10-12T00:00:00Z | 3" "$(logged)"

# --- anything else is a fail

STUB_EXIT=1 STUB_LINES="2026-10-19T00:00:01Z 2026-10-19T000000Z started: x
2026-10-19T00:50:00Z 2026-10-19T000000Z not committed: $agents/agent is mid-rebase; the report stays in /d/runs/r
" "$wrapper" "$agents" >/dev/null 2>&1
check "an uncommitted report exits 1" 1 $?
check "an uncommitted report is a fail, saying why" \
    "fail | not committed: $agents/agent is mid-rebase; the report stays in /d/runs/r | 1" "$(logged)"

STUB_EXIT=1 STUB_LINES="no earlier run of this retro in /a/retro/report.md's history: pass --since
" "$wrapper" "$agents" >/dev/null 2>&1
check "an error the retro exits on is the reason as it printed it" \
    "fail | no earlier run of this retro in /a/retro/report.md's history: pass --since | 1" "$(logged)"

STUB_EXIT=137 STUB_LINES="" "$wrapper" "$agents" >/dev/null 2>&1
check "a retro that printed nothing still leaves a line" \
    "fail | the retro exited 137 and printed nothing | 137" "$(logged)"

before=$(lines)
"$wrapper" "$work/nowhere" >/dev/null 2>&1
check "no retro to run exits 1" 1 $?
check "no retro to run is a fail naming where it looked" \
    "fail | no retro at $work/nowhere/mx/bin/retro | null" "$(logged)"
check "each run leaves exactly one line" $((before + 1)) "$(lines)"

before=$(lines)
for args in "" "--focus x" "--repos" "--repos --since 2026-10-01"; do
    # shellcheck disable=SC2086  # each case is its words
    "$wrapper" $args >/dev/null 2>&1
    check "no agents repo given ('$args') exits 2" 2 $?
done
check "no agents repo given leaves no line" "$before" "$(lines)"
check "an option where the agents repo goes is named" \
    "workflow-retro: AGENTS_REPO comes before any retro option, got --focus" "$("$wrapper" --focus x 2>&1 >/dev/null | head -1)"
check "nor a line in the repo-retros log" "" "$(cat "$RUN_LOG_DIR/repo-retros.jsonl" 2>/dev/null)"

# --- the workflow retro runs alone, whatever the list of repo retros holds

list="$work/repo-retros"
cat > "$list" <<EOF
# the repos
~/.dotfiles

$work/jarvis   # trailing comment
$work/quartz ~/.dotfiles   # planned from the dotfiles' tracker
$work/old-notes
$work/yapit
EOF
cat > "$STUB_REPOS/.dotfiles" <<'EOF'
STUB_LINES="2026-10-20T02:00:00Z 2026-10-20T020000Z committed 9f8e7d6 in /home/max/.dotfiles/agent
"
EOF
cat > "$STUB_REPOS/jarvis" <<'EOF'
STUB_EXIT=3 STUB_LINES="2026-10-20T02:10:00Z 2026-10-20T021000Z skipped: no commit in /w/jarvis since 2026-10-13T02:00:00Z
"
EOF
cat > "$STUB_REPOS/quartz" <<'EOF'
STUB_LINES="2026-10-20T02:20:00Z 2026-10-20T022000Z committed 4d5e6f7 in /home/max/.dotfiles/agent
"
EOF
cat > "$STUB_REPOS/old-notes" <<'EOF'
STUB_EXIT=1 STUB_LINES="/w/old-notes/agent is no agent repo with a main checkout, a git repo of its own, which a retro's report is committed in; /mx:project-setup makes one
"
EOF
: > "$STUB_CALLS"
HOME="$work" REPO_RETROS="$list" STUB_EXIT=0 STUB_LINES="2026-10-19T00:00:01Z 2026-10-19T000000Z committed 1a2b3c4 in $agents/agent
" "$wrapper" "$agents" >/dev/null 2>&1
check "the workflow retro runs alone, a list of repo retros beside it" "$agents --if-active" "$(cat "$STUB_CALLS")"

# --- with --repos, each listed repo's retro in its own job's log, and no workflow retro

before=$(lines)
: > "$STUB_CALLS"
HOME="$work" REPO_RETROS="$list" STUB_EXIT=0 STUB_LINES="2026-10-20T03:00:00Z 2026-10-20T030000Z committed 5a6b7c8 in /w/yapit/agent
" "$wrapper" --repos "$agents" --data "$work/data" >/dev/null 2>&1
check "a refused repo retro fails the run" 1 $?
check "each listed repo's retro runs in the list's order, gated, a planned repo's with its project's tracker, with the options passed on" \
    "$work/.dotfiles --if-active --data $work/data|$work/jarvis --if-active --data $work/data|$work/quartz --if-active --tracker $work/.dotfiles --data $work/data|$work/old-notes --if-active --data $work/data|$work/yapit --if-active --data $work/data" \
    "$(paste -sd'|' "$STUB_CALLS")"
check "the repo retros leave no line in the workflow retro's log" "$before" "$(lines)"
check "a repo's committed report is an ok in its own job's log, named without the dot" \
    "ok | committed 9f8e7d6 in /home/max/.dotfiles/agent | 0" "$(logged repo-retro-dotfiles)"
check "a quiet repo is a skip" \
    "skip | skipped: no commit in /w/jarvis since 2026-10-13T02:00:00Z | 3" "$(logged repo-retro-jarvis)"
check "a repo with no agent repo of its own is a fail, with the refusal as its reason" \
    "fail | /w/old-notes/agent is no agent repo with a main checkout, a git repo of its own, which a retro's report is committed in; /mx:project-setup makes one | 1" \
    "$(logged repo-retro-old-notes)"
check "a refused repo stops no later one" "ok | committed 5a6b7c8 in /w/yapit/agent | 0" "$(logged repo-retro-yapit)"

REPO_RETROS="$work/no-such-list" "$wrapper" --repos "$agents" >/dev/null 2>&1
check "no list of repo retros exits 1" 1 $?
check "no list of repo retros is a fail in the repo-retros log, naming where it looked" \
    "fail | no list of repo retros at $work/no-such-list | null" "$(logged repo-retros)"

"$wrapper" --repos "$work/nowhere" >/dev/null 2>&1
check "no retro to run the repo retros with is a fail in the repo-retros log" \
    "fail | no retro at $work/nowhere/mx/bin/retro | null" "$(logged repo-retros)"

# --- a stopped run: TERM to every process at once, as systemd stops a unit

# Held open for reading and writing, so neither end blocks; a stub that never gets ready fails
# the checks below by name after 10 s, rather than hanging the file.
export STUB_READY="$work/ready"
mkfifo "$STUB_READY"
exec 3<>"$STUB_READY"
setsid "$wrapper" "$agents" >/dev/null 2>&1 &
pid=$!
read -r -t 10 _ <&3 || echo "the stub never got ready" >&2
kill -TERM -- "-$pid"
wait "$pid"
check "a stopped run exits 1" 1 $?
check "a stopped run is a fail, with the stage the retro ended" \
    "fail | stopped: SIGTERM during collect, which ended with it | 143" "$(logged)"

# --- a stop during a repo retro starts no later one

unset STUB_READY
echo "STUB_READY=$work/ready" > "$STUB_REPOS/jarvis"
: > "$STUB_CALLS"
HOME="$work" REPO_RETROS="$list" setsid "$wrapper" --repos "$agents" >/dev/null 2>&1 &
pid=$!
read -r -t 10 _ <&3 || echo "the stub never got ready" >&2
kill -TERM -- "-$pid"
wait "$pid"
check "a run stopped during a repo retro exits 1" 1 $?
check "the stopped repo's retro is a fail in its own job's log" \
    "fail | stopped: SIGTERM during collect, which ended with it | 143" "$(logged repo-retro-jarvis)"
check "no repo after it is started" "$work/.dotfiles --if-active|$work/jarvis --if-active" \
    "$(paste -sd'|' "$STUB_CALLS")"

finish
