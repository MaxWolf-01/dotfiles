#!/usr/bin/env bash
# Every machine dispatch can send workers to, and what each one is carrying now.
#
# The list is written down nowhere: a machine is a worker host exactly when it
# has a nix/home/hosts/<name>-agent/HOST.md in this repo, which is the config
# that gives it the agent user to begin with. Adding a machine is adding that
# config; there is no second place to forget.
#
# Probes run in parallel with a connect timeout, so an unreachable host costs
# that timeout and delays none of the others. Its description still prints --
# which is why the record's hand-written half lives here and not only on the
# host: you read a description when a machine is down and you need to know
# whether it was the one you wanted.
#
#   worker-hosts          every host, with live state
#   worker-hosts pc       one host's whole record, from the host while it is up
set -uo pipefail

repo="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
hosts_dir="$repo/nix/home/hosts"
connect_timeout=5

usage() { sed -n '2,/^set -uo/p' "${BASH_SOURCE[0]}" | sed 's/^# \?//;$d'; }
die() { echo "worker-hosts: $1" >&2; exit 2; }

# A frontmatter field of a HOST.md record.
field() { sed -n '2,/^---$/p' "$1" | sed -n "s/^$2: *//p" | head -1; }

# The paragraph under the title: what the machine is for, in its owner's words.
lead() {
  awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm { if ($0 == "---") fm = 0; next }
    /^# / { started = 1; next }
    started && NF == 0 && body != "" { exit }
    started && NF > 0 { body = body (body == "" ? "" : " ") $0 }
    END { print body }
  ' "$1"
}

# Runs on the host, one round trip. Everything the renderer needs comes back as
# key=value lines, so a field a host cannot answer is simply absent from them.
read -r -d '' remote_probe <<'REMOTE'
awk '{d = int($1 / 86400); h = int(($1 % 86400) / 3600); print "uptime=" d "d " h "h"}' /proc/uptime
echo "cores=$(nproc)"
awk '{print "load5=" $2}' /proc/loadavg
awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{print "memtotal_kb=" t; print "memavail_kb=" a}' /proc/meminfo
# The ZFS ARC is evictable but counts as used, so MemAvailable understates a
# host with a pool by the size of it -- gigabytes, on this one.
if [ -r /proc/spl/kstat/zfs/arcstats ]; then
    awk '$1 == "size" {print "arc_kb=" int($3 / 1024)}' /proc/spl/kstat/zfs/arcstats
fi
# The filesystems a worker writes to, rather than the machine's disks: a pool
# this user cannot reach never appears, and nothing here has to know that.
df -P -h "$HOME" /tmp | awk 'NR > 1 && !seen[$1]++ {print "df=" $6 "|" $4 "|" $2}'
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits |
        awk -F', *' '{print "gpu=" $1 "|" $2 "|" $3 "|" $4}'
fi
tmux list-panes -a -F 'worker=#{session_name}' 2>/dev/null | grep '^worker=dispatch-' | sort -u
exit 0
REMOTE

probe() {
  ssh -o BatchMode=yes -o ConnectTimeout=$connect_timeout -o StrictHostKeyChecking=accept-new \
    "$1" bash -s <<<"$remote_probe" 2>/dev/null
}

gib() { awk -v k="${1:-0}" 'BEGIN { g = k / 1048576; printf (g < 10 ? "%.1fG" : "%.0fG"), g }'; }

render() {
  local name=$1 record=$2 result=$3
  local uptime cores load5 memtotal memavail arc gpu gname gutil gused gtotal workers

  if [ -s "$result" ]; then
    uptime=$(sed -n 's/^uptime=//p' "$result")
    printf '%s — up %s\n' "$name" "${uptime:-?}"
  else
    printf '%s — unreachable\n' "$name"
  fi

  lead "$record" | fmt -w 76 | sed 's/^/  /'
  [ -s "$result" ] || { echo; return; }

  cores=$(sed -n 's/^cores=//p' "$result")
  load5=$(sed -n 's/^load5=//p' "$result")
  memtotal=$(sed -n 's/^memtotal_kb=//p' "$result")
  memavail=$(sed -n 's/^memavail_kb=//p' "$result")
  arc=$(sed -n 's/^arc_kb=//p' "$result")
  printf '  load %s of %s cores   mem %s free of %s' \
    "${load5:-?}" "${cores:-?}" \
    "$(gib $(( ${memavail:-0} + ${arc:-0} )))" "$(gib "${memtotal:-0}")"

  gpu=$(sed -n 's/^gpu=//p' "$result" | head -1)
  if [ -n "$gpu" ]; then
    IFS='|' read -r gname gutil gused gtotal <<<"$gpu"
    gname=${gname#NVIDIA }
    printf '   gpu %s %s%%, %s free' "$gname" "$gutil" "$(gib $(( (gtotal - gused) * 1024 )))"
  fi
  echo

  printf '  disk'
  sed -n 's/^df=//p' "$result" | while IFS='|' read -r mount avail size; do
    printf '   %s %s free of %s' "$mount" "$avail" "$size"
  done
  echo

  workers=$(sed -n 's/^worker=//p' "$result" | paste -sd', ' -)
  printf '  workers: %s\n\n' "${workers:-none}"
}

if [ $# -gt 0 ]; then
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -*) die "unknown argument: $1" ;;
  esac
fi

records=("$hosts_dir"/*-agent/HOST.md)
[ -e "${records[0]}" ] || die "no worker hosts: nothing matches $hosts_dir/*-agent/HOST.md"

if [ $# -gt 0 ]; then
  for record in "${records[@]}"; do
    [ "$(field "$record" host)" = "$1" ] || continue
    # The host's copy carries the generated toolchain and this one still has the
    # token in its place, so ask the host first and fall back to here.
    ssh -o BatchMode=yes -o ConnectTimeout=$connect_timeout "$(field "$record" user)@$1" cat HOST.md 2>/dev/null ||
      cat "$record"
    exit 0
  done
  die "no such worker host: $1 (have: $(for r in "${records[@]}"; do field "$r" host; done | paste -sd' ' -))"
fi

results=$(mktemp -d)
trap 'rm -rf "$results"' EXIT
for record in "${records[@]}"; do
  probe "$(field "$record" user)@$(field "$record" host)" > "$results/$(field "$record" host)" &
done
wait

for record in "${records[@]}"; do
  name=$(field "$record" host)
  render "$name" "$record" "$results/$name"
done
