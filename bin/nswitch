#!/usr/bin/env bash
# Rebuild this NixOS host's system and home-manager config from the flake.
# A script rather than a zsh alias, so agents' bash shells find it too.
set -euo pipefail
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac
if [ ! -e /etc/NIXOS ]; then
  echo "nswitch: not a NixOS host; hmswitch applies the home-manager config here" >&2
  exit 1
fi
exec sudo nixos-rebuild switch --flake ~/.dotfiles#"${NIX_HOST:-$(hostname)}"
