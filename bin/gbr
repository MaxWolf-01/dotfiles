#!/usr/bin/env bash
# Remote branches, one line each: name, last commit's age, author and subject.
# Newest last, so the fresh ones sit right above the prompt. They are only as
# fresh as the last fetch: `gf` first to see what the remote has now.
#
# Usage: gbr [-a] [git-for-each-ref args...]
#   -a    local branches too
#
# For example:
#   gbr                     every remote branch
#   gbr -a | tail -20       the twenty most recent, local ones included
#   gbr --color=always | less -R
set -eu

case "${1:-}" in -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;; esac

refs=(refs/remotes)
if [[ "${1:-}" == -a ]]; then refs+=(refs/heads); shift; fi

# origin/HEAD only points at the default branch, which is listed already.
git for-each-ref --sort=committerdate --exclude='refs/remotes/*/HEAD' \
  --format='%(color:yellow)%(align:40)%(refname:short)%(end)%(color:reset) %(color:green)%(align:15)%(committerdate:relative)%(end)%(color:reset) %(color:blue)%(authorname)%(color:reset)  %(subject)' \
  "$@" "${refs[@]}"
