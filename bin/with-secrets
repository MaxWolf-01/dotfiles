#!/usr/bin/env bash
# Run one command with sops-encrypted credentials in its environment, and nothing else's.
set -euo pipefail

ENV_DIR="$HOME/.dotfiles/secrets/creds/env"

usage() {
    cat <<USAGE
usage: with-secrets <name>[,<name>...] <command> [args...]
       with-secrets --list

Loads $ENV_DIR/<name>.env into the environment of <command> only.
Several names, comma-separated, are loaded left to right; a later file wins a
name collision.

  with-secrets pypi make publish
  with-secrets openai,openrouter zsh      # subshell holding both, gone on exit

--list prints every file and the variables it defines. Variable names are stored
in clear text, so this decrypts nothing.
USAGE
}

list_all() {
    local file name
    for file in "$ENV_DIR"/*.env; do
        [[ -e $file ]] || { echo "no credential files in $ENV_DIR" >&2; return 1; }
        name=$(basename "$file" .env)
        # Comment lines are encrypted whole and start with #ENC[, so they are dropped
        # by shape rather than by content.
        printf '%-24s %s\n' "$name" "$(grep -vE '^(sops_|#)' "$file" | cut -d= -f1 | paste -sd' ')"
    done
}

case ${1-} in
    -h|--help) usage; exit 0 ;;
    --list) list_all; exit 0 ;;
    '') usage >&2; exit 2 ;;
esac

names=$1
shift
[[ $# -gt 0 ]] || { echo "with-secrets: no command given" >&2; exit 2; }

IFS=',' read -ra requested <<<"$names"
first=${requested[0]}
rest=$(IFS=','; echo "${requested[*]:1}")

file="$ENV_DIR/$first.env"
[[ -f $file ]] || { echo "with-secrets: no credential file at $file" >&2; exit 1; }

# sops exec-env takes one command string and runs it through `sh -c`, so argv has
# to survive as a quoted string -- once per name, since each further name is another
# exec-env layer wrapped around the same command.
if [[ -n $rest ]]; then
    command_string=$(printf '%q ' "$0" "$rest" "$@")
else
    command_string=$(printf '%q ' "$@")
fi

exec sops exec-env "$file" "$command_string"
