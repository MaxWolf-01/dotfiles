#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Every machine max runs and the worker users dispatch sends workers to: what each is for, its state, and what it
is carrying now. Its subcommands act on the machines; with none, `hosts` is `hosts view`.

The list is nix/home/machines.nix, which Home Manager writes out as ~/.config/machines.json (MACHINES_FILE points
elsewhere). A machine carrying two worker users (pc) appears twice, once per account, each line showing that user's
workers. What each field of a machine's entry means is in nix/home/machines.nix.

Examples:

    hosts
    hosts --watch
    hosts agent@xmg19
    hosts place personal --needs gpu
    hosts unlock xmg19
"""

import json
import os
import pwd
import re
import subprocess
import sys
import textwrap
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Annotated, Literal, NoReturn, Union

import tyro
from tyro.conf import Positional, UseAppendAction, arg, subcommand

REPO = Path(__file__).resolve().parents[1]
HOSTS_DIR = REPO / "nix/home/hosts"
MACHINES = Path(
    os.environ.get("MACHINES_FILE")
    or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "machines.json"
)
# Trust on first use, as common.nix grants it per host: these are tailnet addresses, so a first connection is
# already inside WireGuard. Without it a machine that has never reached the host reports it down rather than new.
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new"]
WATCH_SECONDS = 10
# A worker fits where this much memory is free for workers: a claude's few hundred MB, and room for the checks it
# runs.
WORKER_KB = 2 * 1048576


# --- the commands


@dataclass(frozen=True)
class View:
    """Every worker user, with its machine's live state; or, named, one worker user's whole record.

    Probes run in parallel with a connect timeout, so an unreachable host costs that timeout and delays none of the
    others. An unreachable host's description still prints, which is why the record's hand-written half lives in
    the checkout, nix/home/hosts/<host>-<user>/HOST.md, and not only on the host: you read a description when a
    machine is down and you need to know whether it was the one you wanted.

    JSON (--json): a list of the readings placement decides from, null where a host did not answer, each with
    target, host, account, isolated, state (up, locked or unreachable), slots_held, slots, offers (a list),
    free_kb, most_kb, cpu_pressure, withholds (a list), placement and description.
    """

    host: Annotated[Positional[str | None], arg(metavar="HOST|USER@HOST")] = None
    """Print this worker user's record, read from the host while it is up; a machine prints each of its users'."""
    watch: bool = False
    """Redraw every 10 s until interrupted; with --json, one line of JSON every 10 s."""
    as_json: Annotated[bool, arg(name="json")] = False
    """The readings as JSON, with each worker user's description."""

    def run(self) -> None:
        if self.host and (self.watch or self.as_json):
            die("--watch and --json take no host")
        entries = worker_entries()
        if self.host:
            records(entries, self.host)
        elif self.watch:
            watch(entries, self.as_json)
        elif self.as_json:
            print(view_json(entries))
        else:
            print(view_text(entries), end="")


@dataclass(frozen=True)
class Place:
    """The user@hosts a spawn on ACCOUNT with every capability it needs may start on now, best first.

    Each line is user@host, a tab, and `isolated` or `not isolated`. The readings it chose from go to stderr.
    Exits 3 when no host can take it now but one may once a slot frees or a host is back, and 1 when none ever
    could.

    A spawn asks for capabilities by name, and a machine's are read off it where they are facts: its
    architecture (`x86_64`), `gpu`, and `mem=<N>G`, met where the workers may use N GiB; the entry's `has` adds to
    them and its `withholds` takes from them. A machine without slots (`host-slots`) is never chosen, only named.

    Placement keeps the hosts up on that account that have a slot free, offer every capability asked for, and have
    room for one more worker: 2G free. Of those it ranks a `placement = "last"` entry after every other, then first the
    machine whose tasks waited least for a CPU in the last 10 s (/proc/pressure/cpu), then the one holding fewer
    slots. Load average overstates a machine running many processes that its workers' CPU weights keep responsive;
    pressure measures how long its tasks waited for a CPU.
    """

    account: Annotated[Positional[str], arg(metavar="ACCOUNT")]
    """The account the spawn runs on."""
    needs: Annotated[tuple[str, ...], UseAppendAction, arg(metavar="CAPABILITY")] = ()
    """A capability the spawn needs: a word, or mem=<N>G."""

    def run(self) -> NoReturn:
        for need in self.needs:
            if not re.fullmatch(r"[a-z0-9_-]+|mem=[0-9]+G", need):
                die("--needs takes a capability: a word, or mem=<N>G")
        entries = worker_entries()
        readings = [reading(e, a) for e, a in zip(entries, probe_all(entries))]
        print("hosts: placing from these readings:", file=sys.stderr)
        print(show(readings), file=sys.stderr)
        chosen, code = place(readings, self.account, self.needs)
        for target, isolated in chosen:
            print(f"{target}\t{'isolated' if isolated else 'not isolated'}")
        offering = f" that offers {' '.join(self.needs)}" if self.needs else ""
        if code == 3:
            print(f"hosts: no host on account {self.account}{offering} can take a worker now; "
                  "the readings above say why", file=sys.stderr)
        elif code == 1:
            print(f"hosts: no host on account {self.account}{offering} counts slots; the readings above say why",
                  file=sys.stderr)
        sys.exit(code)


@dataclass(frozen=True)
class Unlock:
    """Unlock what HOST keeps locked after a boot, by running the steps of its machine's entry (`unlock`) in order,
    from zephylux, which holds the secrets.

    Safe to run again: whatever is already unlocked is left as it is. Exit 1: a step failed, and the ones after it
    were not run.
    """

    host: Annotated[Positional[str], arg(metavar="HOST")]
    """The machine, by its name in the list."""

    def run(self) -> None:
        unlock(self.host)


@dataclass(frozen=True)
class Targets:
    """Every user@host, one per line, nothing probed: the list itself, for a script that goes to the hosts on its
    own.

    JSON (--json): a list of {"target": "user@host", "account": the account or null}.
    """

    as_json: Annotated[bool, arg(name="json")] = False
    """Each worker user with its account, as JSON."""

    def run(self) -> None:
        targets = [(f"{w['user']}@{m['name']}", w.get("account")) for m in machines() for w in m.get("workers", [])]
        if self.as_json:
            print(json.dumps([{"target": t, "account": a} for t, a in targets], indent=2))
        else:
            print("".join(f"{t}\n" for t, _ in targets), end="")


@dataclass(frozen=True)
class Backups:
    """Which machine runs which restic backup: one `<unit><TAB><host>` line per unit, sorted.

    A backup repository is judged by the age of its newest snapshot, so when its target is away the only evidence
    left is the run log of the machine that makes the backup, and only the timer file its entry names (`timers`)
    says which machine that is. bin/overdue-check reads this for that.
    """

    def run(self) -> None:
        backups()


COMMANDS = {"view": View, "place": Place, "unlock": Unlock, "targets": Targets, "backups": Backups}


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] not in (*COMMANDS, "-h", "--help"):
        args = ["view", *args]
    # The list of subcommands gives each one's first paragraph; its own --help, the whole of it.
    listing = args[0] in ("-h", "--help")
    command = Union[tuple(
        Annotated[kind, subcommand(name, prefix_name=False, description=summary(kind) if listing else None)]
        for name, kind in COMMANDS.items())]
    tyro.cli(command, args=args, description=__doc__).run()


def summary(kind: type) -> str:
    return " ".join((kind.__doc__ or "").split("\n\n")[0].split())


def die(message: str) -> NoReturn:
    print(f"hosts: {message}", file=sys.stderr)
    sys.exit(2)


# --- the list


def machines() -> list[dict]:
    try:
        return json.loads(MACHINES.read_text())
    except OSError:
        die(f"no machines list at {MACHINES}; Home Manager writes it (nix/home/machines.nix)")


def worker_entries() -> list[dict]:
    """Every worker user's entry, its machine's name as `host`."""
    entries = [w | {"host": m["name"]} for m in machines() for w in m.get("workers", [])]
    if not entries:
        die(f"no worker hosts: no machine in {MACHINES} lists a worker user")
    return entries


def target(entry: dict) -> str:
    return f"{entry['user']}@{entry['host']}"


def record_file(entry: dict) -> Path:
    """The hand-written half of its record."""
    return HOSTS_DIR / f"{entry['host']}-{entry['user']}" / "HOST.md"


def lead(record: Path) -> str:
    """The paragraph under the title: what the machine is for, in its owner's words."""
    try:
        lines = record.read_text().splitlines()
    except OSError:
        return ""
    body: list[str] = []
    started = False
    for line in lines:
        if line.startswith("# "):
            started = True
        elif started and line.strip():
            body.append(line.strip())
        elif started and body:
            break
    return " ".join(body)


# --- probing


# Runs on the host, one round trip, in bash: a host may have no Python. Everything the renderer needs comes back as
# key=value lines, so a field a host cannot answer is simply absent from them.
REMOTE_PROBE = r"""
awk '{d = int($1 / 86400); h = int(($1 % 86400) / 3600); print "uptime=" d "d " h "h"}' /proc/uptime
echo "cores=$(nproc)"
# A home on a volume of its own that no boot opens (xmg19's) is missing until
# `hosts unlock`: the login still works, into /, but no worker can run.
[ -d "$HOME" ] || echo "locked=1"
awk -F': ' '/^model name/ {print "cpu=" $2; exit}' /proc/cpuinfo
echo "arch=$(uname -m)"
awk '$1 == "some" {sub("avg10=", "", $2); print "pressure=" $2}' /proc/pressure/cpu
awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{print "memtotal_kb=" t; print "memavail_kb=" a}' /proc/meminfo
# Every user's sessions share user.slice's ceiling, the workers' among them.
users=/sys/fs/cgroup/user.slice
# Its inactive file cache counts as used, but the kernel reclaims it on demand.
if grep -qx '[0-9]*' "$users/memory.max" 2>/dev/null; then
  echo "users_max_kb=$(($(cat "$users/memory.max") / 1024))"
  inactive=$(awk '$1 == "inactive_file" {print $2}' "$users/memory.stat")
  echo "users_used_kb=$(( ($(cat "$users/memory.current") - ${inactive:-0}) / 1024 ))"
  # What a user's slice is protected up to (max's sessions reserve) is never
  # the workers' to use.
  cat "$users"/user-*.slice/memory.low 2>/dev/null |
    awk '/^[0-9]+$/ {s += $1} END {print "users_reserved_kb=" int(s / 1024)}'
fi
# The ZFS ARC is evictable but counts as used, so MemAvailable understates a
# host with a pool by the size of it: gigabytes, on this one.
if [ -r /proc/spl/kstat/zfs/arcstats ]; then
  awk '$1 == "size" {print "arc_kb=" int($3 / 1024)}' /proc/spl/kstat/zfs/arcstats
fi
# The filesystems a worker writes to, rather than the machine's disks: a pool
# this user cannot reach never appears, and nothing here has to know that.
df -P -h "$HOME" /tmp | awk 'NR > 1 && !seen[$1]++ {print "df=" $6 "|" $4 "|" $2}'
# Asking the driver wakes a GPU that has powered itself off (xmg19's), so one
# that has is reported asleep, unasked.
if grep -qsx suspended /sys/bus/pci/drivers/nvidia/0000:*/power/runtime_status; then
  echo "gpu=asleep"
elif command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null |
    awk -F', *' 'NF == 4 && $2 ~ /^[0-9]+$/ {print "gpu=" $1 "|" $2 "|" $3 "|" $4}'
fi
echo "claude=$(pgrep -c -x claude -u "$(id -un)")"
if command -v host-slots >/dev/null 2>&1 && read -r held slots < <(host-slots count); then
  echo "held=$held"
  echo "slots=$slots"
fi
tmux list-panes -a -F 'worker=#{session_name}|#{pane_current_path}' 2>/dev/null | grep '^worker=dispatch-' | sort -u
exit 0
"""


@dataclass(frozen=True)
class Answer:
    """A host's answer to the probe: each key's values in the order it gave them, and its ssh's stderr."""

    values: dict[str, list[str]]
    error: str = ""

    def get(self, key: str) -> str | None:
        return self.values.get(key, [None])[0]

    def all(self, key: str) -> list[str]:
        return self.values.get(key, [])


def parse(out: str) -> dict[str, list[str]]:
    values: dict[str, list[str]] = {}
    for line in out.splitlines():
        key, sep, value = line.partition("=")
        if sep:
            values.setdefault(key, []).append(value)
    return values


def probe(entry: dict) -> Answer:
    # stderr is kept, not discarded: an unauthorized key and a machine that is off both produce no output, and only
    # the error tells you which one you are looking at. One of them you can fix in a minute.
    done = subprocess.run(["ssh", *SSH_OPTS, target(entry), "bash", "-s"], input=REMOTE_PROBE,
                          capture_output=True, text=True, check=False)
    return Answer(parse(done.stdout), done.stderr)


def probe_all(entries: list[dict]) -> list[Answer]:
    with ThreadPoolExecutor(max_workers=len(entries)) as pool:
        return list(pool.map(probe, entries))


# --- a reading


@dataclass(frozen=True)
class Reading:
    """What the placer, the view and --json read of one worker user; None where the host did not answer. Memory is
    in KiB, CPU pressure is avg10."""

    target: str
    host: str
    account: str | None
    isolated: bool | None
    state: Literal["up", "locked", "unreachable"]
    slots_held: int | None
    slots: int | None
    offers: list[str]
    free_kb: int | None
    most_kb: int | None
    cpu_pressure: float | None
    withholds: list[str]
    placement: str | None


def reading(entry: dict, answer: Answer) -> Reading:
    state = "unreachable" if not answer.values else "locked" if answer.get("locked") == "1" else "up"
    up = state == "up"
    free, most = memory(answer) if up else (None, None)
    return Reading(
        target=target(entry), host=entry["host"], account=entry.get("account"), isolated=entry.get("isolated"),
        state=state,
        slots_held=number(answer.get("held"), int) if up else None,
        slots=number(answer.get("slots"), int) if up else None,
        offers=capabilities(entry, answer if up else Answer({})),
        free_kb=free, most_kb=most,
        cpu_pressure=number(answer.get("pressure"), float) if up else None,
        withholds=list(entry.get("withholds") or []), placement=entry.get("placement"),
    )


def number(value: str | None, kind: type[int] | type[float]):
    try:
        return kind(value) if value is not None and re.fullmatch(r"[0-9.]+", value) else None
    except ValueError:
        return None


def capabilities(entry: dict, answer: Answer) -> list[str]:
    """What a spawn may ask of this worker user's host: what the probe read off the machine and the entry's has,
    less its withholds."""
    probed = [answer.get("arch")] if answer.get("arch") else []
    probed += ["gpu"] if answer.all("gpu") else []
    return sorted(set(probed + list(entry.get("has") or [])) - set(entry.get("withholds") or []))


def memory(answer: Answer) -> tuple[int | None, int | None]:
    """The memory free for workers and the most they may use, in KiB: the machine's, the ARC added back, held to
    what user.slice's ceiling leaves; the most, to that ceiling less what its slices reserve for their own users."""
    def kb(key: str) -> int:
        return int(answer.get(key) or 0)

    if not answer.get("memtotal_kb"):
        return None, None
    free, most = kb("memavail_kb") + kb("arc_kb"), kb("memtotal_kb")
    if answer.get("users_max_kb"):
        free = min(free, kb("users_max_kb") - kb("users_used_kb"))
        most = min(most, kb("users_max_kb") - kb("users_reserved_kb"))
    return max(free, 0), most


def here() -> str:
    return f"{pwd.getpwuid(os.getuid()).pw_name}@{os.uname().nodename}"


def place(readings: list[Reading], account: str, needs: tuple[str, ...]) -> tuple[list[tuple[str, bool]], int]:
    """The user@hosts, each with whether it is isolated, a spawn on account needing every capability may start on
    now, best first, and the exit code `hosts place` gives: 0 for some, 3 where one may later, 1 where none ever
    could. A host that is down may take the spawn once back, unless its entry withholds what the spawn needs. A
    record naming no account takes a spawn on any account from a dispatcher on its machine."""
    later = False
    fits: list[tuple[tuple, tuple[str, bool]]] = []
    for r in readings:
        if r.account != account and not (r.account is None and r.target == here()):
            continue
        if r.state != "up":
            if not set(needs) & set(r.withholds):
                later = True
            continue
        if r.slots is None or not all(offers(r, need) for need in needs):
            continue
        later = True
        if (r.slots_held is None or r.slots_held >= r.slots or r.free_kb is None or r.free_kb < WORKER_KB
                or r.cpu_pressure is None):
            continue
        fits.append(((r.placement == "last", r.cpu_pressure, r.slots_held, r.target), (r.target, r.isolated is True)))
    if fits:
        return [chosen for _, chosen in sorted(fits)], 0
    return [], 3 if later else 1


def offers(r: Reading, need: str) -> bool:
    if m := re.fullmatch(r"mem=([0-9]+)G", need):
        return r.most_kb is not None and r.most_kb >= int(m[1]) * 1048576
    return need in r.offers


def show(readings: list[Reading]) -> str:
    """The readings, one line each, as the placer shows what it chose from."""
    def dash(v) -> str:
        return "-" if v is None or v == [] else ",".join(v) if isinstance(v, list) else str(v)

    return "\n".join(
        f"  {r.target:<18} {dash(r.account):<11} {r.state:<11} {dash(r.slots_held)} of {dash(r.slots)} slots held on "
        f"{r.host}   cpu {pressure(r.cpu_pressure)}% waiting   "
        f"{'-' if r.free_kb is None else f'{r.free_kb / 1048576:.1f}G'} free for workers   offers {dash(r.offers)}"
        for r in readings)


def pressure(p: float | None) -> str:
    return "-" if p is None else f"{p:.2f}"


# --- the view


def view_json(entries: list[dict], indent: int | None = 2) -> str:
    rows = [row(reading(e, a), lead(record_file(e))) for e, a in zip(entries, probe_all(entries))]
    return json.dumps(rows, indent=indent, ensure_ascii=False)


def row(r: Reading, description: str) -> dict:
    """A reading as --json gives it, with its worker user's description."""
    return asdict(r) | {"description": description or None}


def view_text(entries: list[dict]) -> str:
    return "".join(render(reading(e, a), e, a) for e, a in zip(entries, probe_all(entries)))


def watch(entries: list[dict], as_json: bool) -> NoReturn:
    try:
        while True:
            if as_json:
                print(view_json(entries, indent=None), flush=True)
            else:
                # Drawn whole before the screen is cleared, so a slow probe never leaves it blank.
                out = view_text(entries)
                footer = paint(f"  {time.strftime('%H:%M:%S')}, every {WATCH_SECONDS} s; Ctrl-C ends it", DIM)
                print(f"\033[H\033[2J{out}\n\n{footer}", flush=True)
            time.sleep(WATCH_SECONDS)
    except KeyboardInterrupt:
        sys.exit(130)


BOLD, DIM, RED, GREEN, YELLOW = "1", "2", "31", "32", "33"


def paint(text: str, *codes: str) -> str:
    """text in the SGR codes given, where a person reads it: on a terminal, and never with NO_COLOR set."""
    if not codes or not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{';'.join(codes)}m{text}\033[0m"


def gib(kb: int | None) -> str:
    if kb is None:
        return "-"
    g = kb / 1048576
    return f"{g:.1f}G" if g < 10 else f"{g:.0f}G"


def render(r: Reading, entry: dict, answer: Answer) -> str:
    """One worker user as a person reads it: its state, slots, memory, pressure and offers from its reading, so it
    never shows what placement would read otherwise; the rest (uptime, CPU model, GPU, disks, sessions) from the
    probe."""
    def label(text: str) -> str:
        return paint(text, DIM)

    name = paint(r.target, BOLD)
    if r.state == "unreachable":
        why = answer.error.splitlines()[0] if answer.error.strip() else "no answer"
        out = f"{name} — {paint('unreachable', RED)}: {why}\n"
    else:
        out = f"{name} — {paint('up', GREEN)} {answer.get('uptime') or '-'}\n"
    out += "".join(f"  {line}\n" for line in textwrap.wrap(lead(record_file(entry)), 76))
    if r.state == "unreachable":
        return out + "\n"
    if r.state == "locked":
        return out + paint(f"  /home locked: no worker can run until `hosts unlock {r.host}` on zephylux", YELLOW) \
            + "\n\n"

    p = r.cpu_pressure
    waiting = paint(f"{pressure(p)}%", *(() if p is None else (GREEN,) if p < 5 else (YELLOW,) if p < 25 else (RED,)))
    line = (f"  {label('cpu')} {waiting} waiting, {answer.get('cores') or '-'} threads ({cpu_model(answer) or '-'})"
            f"   {label('mem')} {gib(r.free_kb)} free for workers of {gib(r.most_kb)}")
    gpu = answer.get("gpu")
    if gpu == "asleep":
        line += f"   {label('gpu')} asleep"
    elif gpu:
        gname, gutil, gused, gtotal = gpu.split("|")
        free = gib((int(gtotal) - int(gused)) * 1024)
        line += f"   {label('gpu')} {gname.removeprefix('NVIDIA ')} {gutil}%, {free} free"
    out += line + "\n"

    disks = "".join(f"   {mount} {avail} free of {size}"
                    for mount, avail, size in (d.split("|") for d in answer.all("df")))
    out += f"  {label('disk')}{disks}\n"

    held = f"{r.slots_held if r.slots_held is not None else '-'} of {r.slots} slots held on {r.host}" \
        if r.slots is not None else f"{r.host} has no slot count"
    out += f"  {label('workers:')} {answer.get('claude') or '-'} claude running here; {held}\n"
    out += f"  {label('offers:')} {', '.join(r.offers) or '-'}\n"
    # The worktree directory names the repo, feature and ticket a session is on, which its name alone does not on a
    # host shared by several dispatchers.
    sessions = ", ".join(f"{s} ({path.rsplit('/', 1)[-1]})"
                         for s, _, path in (w.partition("|") for w in answer.all("worker")))
    return out + f"  {label('sessions:')} {sessions or 'none'}\n\n"


def cpu_model(answer: Answer) -> str:
    """The model as the vendor writes it carries decoration no reader wants."""
    model = re.sub(r"\(R\)|\(TM\)", "", answer.get("cpu") or "")
    for pattern in (r" [0-9]*-Core Processor", r" Processor", r" CPU @.*"):
        model = re.sub(pattern, "", model, count=1)
    return re.sub(r" +", " ", model)


# --- one worker user's record


def records(entries: list[dict], name: str) -> None:
    """The record of each worker user `name` names, as user@host or as its machine."""
    chosen = [e for e in entries if name in (target(e), e["host"])]
    if not chosen:
        die(f"no such host or worker user: {name} (have: {' '.join(target(e) for e in entries)})")
    for i, entry in enumerate(chosen):
        if i:
            print()
        print(record(entry), end="")


def record(entry: dict) -> str:
    """One worker user's record. The host's copy carries the generated toolchain, so ask the host first and say when
    you got the checked-in one, its frontmatter the entry's. @BODY@ is the machine's shared tools-and-limits file
    beside the records, <host>-worker-body.md. A locked xmg19 lands here too: its HOST.md is in the home `hosts
    unlock` opens."""
    t = target(entry)
    remote = subprocess.run(["ssh", *SSH_OPTS, t, "cat", "HOST.md"], capture_output=True, text=True, check=False)
    if remote.returncode == 0:
        return remote.stdout
    print(f"hosts: {t} is unreachable; the checked-in record follows", file=sys.stderr)
    # A machine with no shared body (zephylux) has none to splice in.
    body_file = HOSTS_DIR / f"{entry['host']}-worker-body.md"
    body = body_file.read_text() if body_file.is_file() else ""
    try:
        own = record_file(entry).read_text()
    except OSError as e:
        print(f"hosts: {e}", file=sys.stderr)
        own = ""
    text = "".join(body if line == "@BODY@\n" else line for line in own.splitlines(keepends=True))
    frontmatter = (entry.get("frontmatter") or "").rstrip("\n")
    return f"{frontmatter}\n\n{text}".replace("@TOOLCHAIN@", "(unknown: the tool list is spliced in on the host)")


# --- unlock


def unlock(name: str) -> None:
    secrets = Path.home() / ".dotfiles/secrets"
    age_key = os.environ.get("SOPS_AGE_KEY_FILE", "")
    if not age_key:
        die("SOPS_AGE_KEY_FILE is not set; the Home Manager config of this host, in nix/home/hosts/, sets it")
    listed = machines()
    machine = next((m for m in listed if m["name"] == name and m.get("unlock")), None)
    if machine is None:
        die(f"no unlock known for '{name}' ({', '.join(m['name'] for m in listed if m.get('unlock'))})")
    if any(step.get("ageKey") for step in machine["unlock"]) and not os.access(age_key, os.R_OK):
        die(f"no age key at {age_key}")

    dest = machine["ssh"]
    for step in machine["unlock"]:
        # ssh joins its command's words with spaces, so the step's command goes as one.
        run = " ".join(step["run"])
        if step.get("secret"):
            sops = subprocess.Popen(["sops", "-d", str(secrets / "creds/raw" / step["secret"])], stdout=subprocess.PIPE)
            sent = subprocess.run(["ssh", dest, run], stdin=sops.stdout, check=False).returncode
            sops.stdout.close()
            ok = sops.wait() == 0 and sent == 0
        else:
            with open(age_key if step.get("ageKey") else os.devnull, "rb") as handed:
                ok = subprocess.run(["ssh", dest, run], stdin=handed, check=False).returncode == 0
        if not ok:
            print(f"hosts unlock: '{run}' on {dest} failed; the steps after it were not run", file=sys.stderr)
            sys.exit(1)


# --- backups


def backups() -> None:
    timer_files = {m["name"]: REPO / m["timers"] for m in machines() if m.get("timers")}
    if not timer_files:
        die(f"no machine in {MACHINES} names a timer file (`timers`), so nothing says which host runs a backup")
    pairs: set[tuple[str, str]] = set()
    for host, file in timer_files.items():
        if not file.is_file():
            die(f"no timer definitions at {file}, so nothing says which backups {host} runs")
        for conf in re.findall(r"backup/restic/[a-z0-9_-]+/[a-z0-9_-]+\.conf", file.read_text()):
            named = subprocess.run([str(REPO / "bin/restic-config-name"), conf], stdout=subprocess.PIPE, text=True,
                                   check=False)
            if named.returncode:
                sys.exit(2)
            pairs.add((named.stdout.strip(), host))
    # An empty answer would tell every reader that no host runs any backup: the watchdog would date each away
    # repository against the wrong host's log. A path spelled differently in a timer file is enough to get here.
    if not pairs:
        die(f"no restic backup found in {' '.join(map(str, timer_files.values()))}: either no timer runs one, "
            "or the paths there changed shape")
    # Two hosts backing up into one repository is a race nobody wrote down, and it would make the run log this
    # answer points at ambiguous.
    units = [unit for unit, _ in pairs]
    if clash := sorted({u for u in units if units.count(u) > 1}):
        die(f"these backups are run by more than one host: {' '.join(clash)}")
    print("".join(f"{unit}\t{host}\n" for unit, host in sorted(pairs)), end="")


if __name__ == "__main__":
    main()
