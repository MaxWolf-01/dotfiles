#!/usr/bin/env bash
# Run the workflow retro, then each listed repo's repo retro, each only when there is something
# new for it to read, and record how each ended.
#
# The retros are mx's, run from the agents repo's own checkout. Given --if-active a retro decides
# whether there is anything to read, and exits 3 when there is not. This adds the job run log
# line per retro the overdue watchdog reads.
set -uo pipefail

usage() {
    cat <<'EOF'
Usage: workflow-retro [AGENTS_REPO] [RETRO_OPTION...]

Runs `retro AGENTS_REPO --if-active RETRO_OPTION...` from AGENTS_REPO's own mx
(default ~/repos/github/MaxWolf-01/agents), then `retro REPO --if-active
RETRO_OPTION...` for each repo on the list of repo retros, one after another.
Each appends one line to its job run log in ~/logs/runs: workflow-retro.jsonl
for the workflow retro, repo-retro-<name>.jsonl for a repo's, <name> its
directory's name without a leading dot.

  ok    the retro committed its report
  skip  nothing new since its last run (the retro exited 3)
  fail  the retro was refused, failed, stopped, or left its report uncommitted

The list is nix/home/repo-retros in these dotfiles: one repo per line, `~` for
the home directory, `#` starting a comment. A stop ends the retro under way and
starts no later one. Exits 1 when any retro failed.

`retro --help` says what a run reads and writes; its runs.log, in the retro's
data directory, keeps every run's lines. Environment: RUN_LOG_DIR, as run-log;
REPO_RETROS, a list to read instead.
EOF
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

agents="${1:-$HOME/repos/github/MaxWolf-01/agents}"
[ $# -gt 0 ] && shift
# Reached relative to this script: the unit pins its own PATH, without ~/bin.
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
run_log="$here/run-log"
list="${REPO_RETROS:-$here/../nix/home/repo-retros}"
retro="$agents/mx/bin/retro"

if [ ! -x "$retro" ]; then
    echo "workflow-retro: no retro at $retro; is $agents the agents repo?" >&2
    "$run_log" workflow-retro fail --reason "no retro at $retro"
    exit 1
fi

# A stopped unit, its start timeout or a shutdown sends TERM to every process here at once.
# The retro ends its stage and logs why. This script and tee outlive the TERM and wait for it:
# the script so it can still write the job run log line and start no later retro, tee because
# a tee that died first would break the pipe the retro logs into.
stopped=0
trap 'stopped=1' TERM INT HUP
out=$(mktemp)
trap 'rm -f "$out"' EXIT

# One retro, and its job run log line: logged <job> <repo> [retro option...]. Fails when the run did.
logged() {
    local job=$1 repo=$2 rc last outcome
    shift 2
    "$retro" "$repo" --if-active "$@" </dev/null 2>&1 | (trap '' TERM INT HUP; exec tee "$out")
    rc=${PIPESTATUS[0]}
    # The retro's own lines are "<time> <run> <message>"; an error it exits on is the message alone.
    last=$(grep -v '^[[:space:]]*$' "$out" | tail -n1 \
        | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z [^ ]+ //')
    [ -n "$last" ] || last="the retro exited $rc and printed nothing"
    case $rc in
        0) outcome=ok ;;
        3) outcome=skip ;;
        *) outcome=fail ;;
    esac
    "$run_log" "$job" "$outcome" --reason "$last" --stats "$(jq -cn --argjson exit "$rc" '{exit: $exit}')"
    [ "$outcome" != fail ]
}

failed=0
logged workflow-retro "$agents" "$@" || failed=1

if [ ! -f "$list" ]; then
    echo "workflow-retro: no list of repo retros at $list" >&2
    exit 1
fi
mapfile -t repos < <(sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$list")
for repo in "${repos[@]}"; do
    [ "$stopped" = 1 ] && break
    repo="${repo/#\~/$HOME}"
    name=$(basename "$repo")
    logged "repo-retro-${name#.}" "$repo" "$@" || failed=1
done
exit "$failed"
