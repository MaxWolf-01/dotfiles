#!/usr/bin/env bash
# Run the workflow retro if max did anything since its last run, and record how it ended.
#
# The retro is mx's, run from the agents repo's own checkout. Given --if-active it decides
# whether there is anything to read, and exits 3 when there is not. This adds the job run
# log line the overdue watchdog reads.
set -uo pipefail

usage() {
    cat <<'EOF'
Usage: workflow-retro [AGENTS_REPO] [RETRO_OPTION...]

Runs `retro AGENTS_REPO --if-active RETRO_OPTION...` from AGENTS_REPO's own mx
(default ~/repos/github/MaxWolf-01/agents), then appends one line to the job run
log ~/logs/runs/workflow-retro.jsonl:

  ok    the retro committed its report
  skip  no message or commit of max's since the last run (the retro exited 3)
  fail  the retro failed, stopped, or left its report uncommitted

`retro --help` says what a run reads and writes; its runs.log, in the retro's
data directory, keeps every run's lines. Environment: RUN_LOG_DIR, as run-log.
EOF
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

agents="${1:-$HOME/repos/github/MaxWolf-01/agents}"
[ $# -gt 0 ] && shift
# Reached relative to this script: the unit pins its own PATH, without ~/bin.
run_log="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/run-log"
retro="$agents/mx/bin/retro"

if [ ! -x "$retro" ]; then
    echo "workflow-retro: no retro at $retro; is $agents the agents repo?" >&2
    "$run_log" workflow-retro fail --reason "no retro at $retro"
    exit 1
fi

# A stopped unit, its start timeout or a shutdown sends TERM to every process here at once.
# The retro ends its stage and logs why. This script and tee ignore the TERM and wait for it:
# the script so it can still write the job run log line, tee because a tee that died first
# would break the pipe the retro logs into.
trap : TERM INT HUP
out=$(mktemp)
trap 'rm -f "$out"' EXIT
"$retro" "$agents" --if-active "$@" 2>&1 | (trap '' TERM INT HUP; exec tee "$out")
rc=${PIPESTATUS[0]}

# The retro's own lines are "<time> <run> <message>"; an error it exits on is the message alone.
last=$(grep -v '^[[:space:]]*$' "$out" | tail -n1 \
    | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z [^ ]+ //')
[ -n "$last" ] || last="the retro exited $rc and printed nothing"
stats=$(jq -cn --argjson exit "$rc" '{exit: $exit}')

case $rc in
    0) outcome=ok ;;
    3) outcome=skip ;;
    *) outcome=fail ;;
esac
"$run_log" workflow-retro "$outcome" --reason "$last" --stats "$stats"
[ "$outcome" = fail ] && exit 1
exit 0
