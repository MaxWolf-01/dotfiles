#!/usr/bin/env bash
# Manage the tailnet ACL policy via the Tailscale API (the CLI has no ACL support).
#
# Policy source of truth: ~/.dotfiles/secrets/tailscale/policy.hujson (versioned).
# Token: sops-encrypted API access token in ~/.dotfiles/secrets/api_keys/tailscale.
#   Mint at https://login.tailscale.com/admin/settings/keys (expires <= 90 days;
#   only needed again for the next ACL change).
#
# Usage:
#   tailscale-acl get                      # fetch live policy from Tailscale (hujson)
#   tailscale-acl validate                 # validate local policy file via the API
#   tailscale-acl push                     # validate, then upload local policy file
#   tailscale-acl devices                  # list devices: id, hostname, tags
#   tailscale-acl tag <device-id> <tag..>  # replace a device's tags (e.g. tag:server)
set -euo pipefail

API=https://api.tailscale.com/api/v2
POLICY="$HOME/.dotfiles/secrets/tailscale/policy.hujson"
TOKEN_FILE="$HOME/.dotfiles/secrets/api_keys/tailscale"

api() {
  local token="${TS_API_TOKEN:-$(sops -d "$TOKEN_FILE")}"
  curl -sS --fail-with-body -H "Authorization: Bearer $token" "$@"
}

require_policy() {
  [ -f "$POLICY" ] || { echo "tailscale-acl: policy file not found: $POLICY" >&2; exit 1; }
}

cmd="${1:-}"
case "$cmd" in
  get)
    api -H "Accept: application/hujson" "$API/tailnet/-/acl"
    ;;
  validate)
    require_policy
    # Endpoint returns 200 with a JSON error body on invalid policy, non-2xx only on request errors.
    result=$(api -X POST --data-binary "@$POLICY" "$API/tailnet/-/acl/validate")
    if [ -n "$result" ] && jq -e '.message' <<<"$result" >/dev/null 2>&1; then
      echo "tailscale-acl: policy invalid:" >&2
      echo "$result" >&2
      exit 1
    fi
    echo "policy valid"
    ;;
  push)
    "$0" validate
    api -X POST -H "Content-Type: application/hujson" --data-binary "@$POLICY" "$API/tailnet/-/acl" >/dev/null
    echo "policy pushed"
    ;;
  devices)
    api "$API/tailnet/-/devices" | jq -r '.devices[] | [.id, .hostname, (.tags // [] | join(","))] | @tsv'
    ;;
  tag)
    device_id="${2:?usage: tailscale-acl tag <device-id> <tag...>}"
    shift 2
    [ $# -ge 1 ] || { echo "tailscale-acl: need at least one tag (e.g. tag:server)" >&2; exit 1; }
    tags=$(printf '%s\n' "$@" | jq -R . | jq -cs '{tags: .}')
    api -X POST -H "Content-Type: application/json" --data "$tags" "$API/device/$device_id/tags"
    echo "tagged $device_id: $*"
    ;;
  *)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
