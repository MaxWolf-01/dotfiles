#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Mirror WakaTime heartbeats into local per-day JSONL files.

Heartbeats are the raw layer of WakaTime: one record per editor or browser ping,
with the file or URL, project, branch, category and timestamp. Everything the
dashboard shows is derived from them, and the free plan hides all but the last
week in the dashboard while the API still serves every day since the account
was created. This keeps a complete local copy so history, queries and backups
do not depend on the plan.

One file per day, `<data-dir>/YYYY/YYYY-MM-DD.jsonl`, written whole and moved
into place, so a run is idempotent and a day is either fully present or absent.
An empty file means the day was fetched and had no activity. The last few days
are always fetched again, because plugins queue heartbeats while offline and
deliver them late.

The API key is read from ~/.wakatime.cfg. `--record` appends the run's outcome
to ~/logs/runs/wakatime-sync.jsonl via bin/run-log; a network that is down is
a skip, an API error is a fail.

JSON summary (--json):

    {"from": "YYYY-MM-DD", "to": "YYYY-MM-DD", "days": int, "heartbeats": int}

Examples:

    wakatime-sync                    # the last 3 days plus any day never fetched
    wakatime-sync --all              # everything since the account was created
    wakatime-sync --since 2025-01-01 --until 2025-01-31
    wakatime-sync --record           # the timer's invocation
"""

import base64
import configparser
import json as jsonlib
import os
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import date, datetime, timedelta

import tyro

API = "https://api.wakatime.com/api/v1/users/current"
DATA_DIR = pathlib.Path.home() / "data/wakatime/heartbeats"
CONFIG = pathlib.Path.home() / ".wakatime.cfg"
# By absolute path: the systemd unit pins a PATH without ~/bin.
RUN_LOG_BIN = pathlib.Path.home() / ".dotfiles/bin/run-log"
UNIT = "wakatime-sync"


@dataclass
class Args:
    since: str = ""
    """First day to fetch, YYYY-MM-DD. Default: the newest local day minus --refetch-days, or the account's first day when nothing is local yet."""
    until: str = ""
    """Last day to fetch, YYYY-MM-DD. Default: today."""
    all: bool = False
    """Fetch every day since the account was created, refreshing what is already local."""
    refetch_days: int = 3
    """How many of the newest local days to fetch again for late-arriving heartbeats."""
    data_dir: pathlib.Path = DATA_DIR
    """Where the per-day files live."""
    pause: float = 0.3
    """Seconds between requests, to stay clear of the API's rate limit."""
    record: bool = False
    """Append the outcome to the run log (bin/run-log). For the timer."""
    json: bool = False
    """Print the summary as JSON instead of prose."""


class Offline(Exception):
    """The network is unavailable; a precondition, not a failure of this job."""


class Api:
    def __init__(self, key: str) -> None:
        self.auth = "Basic " + base64.b64encode(key.encode()).decode()

    def get(self, path: str, **params: str) -> dict:
        url = f"{API}/{path}"
        if params:
            url += "?" + urllib.parse.urlencode(params)
        for attempt in range(6):
            req = urllib.request.Request(url, headers={"Authorization": self.auth})
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    return jsonlib.load(resp)
            except urllib.error.HTTPError as e:
                if e.code == 429 and attempt < 5:
                    time.sleep(int(e.headers.get("Retry-After", "60")))
                    continue
                raise RuntimeError(f"HTTP {e.code} for {path}: {e.read()[:200].decode(errors='replace')}") from e
            except urllib.error.URLError as e:
                raise Offline(str(e.reason)) from e
        raise RuntimeError(f"rate limited too often for {path}")


def api_key() -> str:
    cfg = configparser.ConfigParser()
    cfg.read(CONFIG)
    key = cfg.get("settings", "api_key", fallback="")
    if not key:
        raise RuntimeError(f"no api_key under [settings] in {CONFIG}")
    return key


def day_file(data_dir: pathlib.Path, day: date) -> pathlib.Path:
    return data_dir / f"{day:%Y}" / f"{day:%Y-%m-%d}.jsonl"


def newest_local_day(data_dir: pathlib.Path) -> date | None:
    files = sorted(data_dir.glob("*/*.jsonl"))
    return date.fromisoformat(files[-1].stem) if files else None


def write_day(path: pathlib.Path, heartbeats: list[dict]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".jsonl.tmp")
    with tmp.open("w") as f:
        for h in heartbeats:
            f.write(jsonlib.dumps(h, separators=(",", ":")) + "\n")
    os.replace(tmp, path)


def sync(args: Args) -> dict:
    api = Api(api_key())
    today = date.today()
    until = date.fromisoformat(args.until) if args.until else today

    if args.since:
        since = date.fromisoformat(args.since)
    elif args.all or newest_local_day(args.data_dir) is None:
        created = api.get("")["data"]["created_at"]
        since = datetime.fromisoformat(created.replace("Z", "+00:00")).date()
    else:
        since = newest_local_day(args.data_dir) - timedelta(days=args.refetch_days - 1)
    if since > until:
        raise RuntimeError(f"--since {since} is after --until {until}")

    days = 0
    total = 0
    day = since
    while day <= until:
        heartbeats = api.get("heartbeats", date=day.isoformat()).get("data", [])
        write_day(day_file(args.data_dir, day), heartbeats)
        days += 1
        total += len(heartbeats)
        day += timedelta(days=1)
        if day <= until:
            time.sleep(args.pause)
    return {"from": since.isoformat(), "to": until.isoformat(), "days": days, "heartbeats": total}


def log_run(outcome: str, reason: str = "", stats: dict | None = None) -> None:
    cmd = [str(RUN_LOG_BIN), UNIT, outcome]
    if reason:
        cmd += ["--reason", reason]
    if stats:
        cmd += ["--stats", jsonlib.dumps(stats)]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        print(f"{UNIT}: run-log failed: {proc.stderr.strip()}", file=sys.stderr)


def main(args: Args) -> int:
    try:
        stats = sync(args)
    except Offline as e:
        print(f"{UNIT}: offline, nothing fetched ({e})", file=sys.stderr)
        if args.record:
            log_run("skip", f"offline: {e}")
        return 0
    except Exception as e:
        print(f"{UNIT}: {e}", file=sys.stderr)
        if args.record:
            log_run("fail", str(e)[:300])
        return 1
    if args.record:
        log_run("ok", stats=stats)
    if args.json:
        print(jsonlib.dumps(stats))
    else:
        print(f"{stats['from']}..{stats['to']}: {stats['days']} days, {stats['heartbeats']} heartbeats -> {args.data_dir}")
    return 0


if __name__ == "__main__":
    sys.exit(main(tyro.cli(Args, description=__doc__, config=(tyro.conf.OmitArgPrefixes,))))
