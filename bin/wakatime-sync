#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Mirror WakaTime heartbeats into local per-day JSONL files.

Heartbeats are the raw layer of WakaTime: one record per editor or browser ping,
with the file or URL, project, branch, category and timestamp. Everything the
dashboard shows is derived from them, and the free plan hides all but the last
week in the dashboard while the API still serves every day since the account
was created. This keeps a complete local copy so history, queries and backups
do not depend on the plan.

A heartbeat names its plugin by id only, so every run also writes
`<data-dir>/user_agents.json`, the id to editor map the API serves.

One file per day, `<data-dir>/YYYY/YYYY-MM-DD.jsonl`, written whole and moved
into place, so a run is idempotent and a day is either fully present or absent.
An empty file means the day was fetched and had no activity. The last few days
are always fetched again, because plugins queue heartbeats while offline and
deliver them late.

The API is read with an OAuth token of a WakaTime app, whose id and secret come
from `with-secrets wakatime-lifelog-sync-oauth-app`; the API key in the
WakaTime config can only send heartbeats. `--login` authorizes the app once and
keeps the token in ~/.local/state/wakatime-sync/token.json. A token lives 365
days, and a run trades it for a new one once it is --renew-after-days old, so a
renewal that stops working fails a run eleven months before the token dies.

`--record` appends the run's outcome
to ~/logs/runs/wakatime-sync.jsonl via bin/run-log; a network that is down is
a skip, an API error is a fail.

JSON summary (--json):

    {"from": "YYYY-MM-DD", "to": "YYYY-MM-DD", "days": int, "heartbeats": int, "user_agents": int}

Examples:

    wakatime-sync                    # the last 3 days plus any day never fetched
    wakatime-sync --all              # everything since the account was created
    wakatime-sync --since 2025-01-01 --until 2025-01-31
    wakatime-sync --record           # the timer's invocation
    with-secrets wakatime-lifelog-sync-oauth-app wakatime-sync --login
"""

import json as jsonlib
import os
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import UTC, date, datetime, timedelta

import tyro

API = "https://api.wakatime.com/api/v1/users/current"
DATA_DIR = pathlib.Path.home() / "data/wakatime/heartbeats"
TOKEN = pathlib.Path.home() / ".local/state/wakatime-sync/token.json"
OAUTH = "https://wakatime.com/oauth"
# WakaTime's own page, which shows the code to paste instead of redirecting it anywhere.
REDIRECT_URI = "https://wakatime.com/oauth/test"
SCOPE = "read_heartbeats"
CREDS = "wakatime-lifelog-sync-oauth-app"
# By absolute path: the systemd unit pins a PATH without ~/bin.
RUN_LOG_BIN = pathlib.Path.home() / ".dotfiles/bin/run-log"
# monitoring: collector
UNIT = "wakatime-sync"
RATE_LIMIT_RETRIES = 5


@dataclass
class Args:
    since: str = ""
    """First day to fetch, YYYY-MM-DD. Default: the newest local day minus --refetch-days, or the account's first day when nothing is local yet."""
    until: str = ""
    """Last day to fetch, YYYY-MM-DD. Default: today."""
    all: bool = False
    """Fetch every day since the account was created, refreshing what is already local."""
    refetch_days: int = 3
    """How many of the newest local days to fetch again for late-arriving heartbeats."""
    data_dir: pathlib.Path = DATA_DIR
    """Where the per-day files live."""
    pause: float = 0.3
    """Seconds between requests, to stay clear of the API's rate limit."""
    record: bool = False
    """Append the outcome to the run log (bin/run-log). For the timer."""
    json: bool = False
    """Print the summary as JSON instead of prose."""
    login: bool = False
    """Authorize the app: print the URL to open, read the code the page shows from stdin, and save the token. Needs the app's credentials in the environment."""
    renew_after_days: int = 30
    """Trade the token for a new one once it is this many days old. Renewing needs the app's credentials in the environment."""


class Offline(Exception):
    """The network is unavailable; a precondition, not a failure of this job."""


def main(args: Args) -> int:
    if args.login:
        return login()
    try:
        stats = sync(args)
    except Offline as e:
        print(f"{UNIT}: offline, nothing fetched ({e})", file=sys.stderr)
        if args.record:
            log_run("skip", f"offline: {e}")
        return 0
    except Exception as e:
        print(f"{UNIT}: {e}", file=sys.stderr)
        if args.record:
            log_run("fail", str(e)[:300])
        return 1
    if args.record:
        log_run("ok", stats=stats)
    if args.json:
        print(jsonlib.dumps(stats))
    else:
        print(f"{stats['from']}..{stats['to']}: {stats['days']} days, {stats['heartbeats']} heartbeats, "
              f"{stats['user_agents']} user agents -> {args.data_dir}")
    return 0


def sync(args: Args) -> dict:
    api = Api(access_token(args.renew_after_days))
    today = date.today()
    until = date.fromisoformat(args.until) if args.until else today

    if args.since:
        since = date.fromisoformat(args.since)
    elif args.all or newest_local_day(args.data_dir) is None:
        created = api.get("")["data"]["created_at"]
        since = datetime.fromisoformat(created.replace("Z", "+00:00")).date()
    else:
        since = newest_local_day(args.data_dir) - timedelta(days=args.refetch_days - 1)
    if since > until:
        raise RuntimeError(f"--since {since} is after --until {until}")

    agents = write_user_agents(args.data_dir, api)
    days = 0
    total = 0
    day = since
    while day <= until:
        heartbeats = api.get("heartbeats", date=day.isoformat()).get("data", [])
        write_day(day_file(args.data_dir, day), heartbeats)
        days += 1
        total += len(heartbeats)
        day += timedelta(days=1)
        if day <= until:
            time.sleep(args.pause)
    return {"from": since.isoformat(), "to": until.isoformat(), "days": days, "heartbeats": total, "user_agents": agents}


class Api:
    def __init__(self, token: str) -> None:
        self.auth = f"Bearer {token}"

    def get(self, path: str, **params: str) -> dict:
        url = f"{API}/{path}"
        if params:
            url += "?" + urllib.parse.urlencode(params)
        retries = 0
        while True:
            req = urllib.request.Request(url, headers={"Authorization": self.auth})
            try:
                with urllib.request.urlopen(req, timeout=60) as resp:
                    return jsonlib.load(resp)
            except urllib.error.HTTPError as e:
                if e.code == 429 and retries < RATE_LIMIT_RETRIES:
                    retries += 1
                    time.sleep(int(e.headers.get("Retry-After", "60")))
                    continue
                raise RuntimeError(f"HTTP {e.code} for {path}: {e.read()[:200].decode(errors='replace')}") from e
            except urllib.error.URLError as e:
                raise Offline(str(e.reason)) from e
            except TimeoutError as e:  # a read that stalls after connecting is not wrapped in URLError
                raise Offline(f"timed out reading {path}") from e


def login() -> int:
    url = f"{OAUTH}/authorize?" + urllib.parse.urlencode(
        {"client_id": app_credentials()[0], "response_type": "code", "redirect_uri": REDIRECT_URI, "scope": SCOPE})
    print(f"Open this, authorize, and paste the code the page shows:\n\n  {url}\n", file=sys.stderr)
    save_token(request_token(grant_type="authorization_code", code=input("code: ").strip()))
    print(f"token saved to {TOKEN}")
    return 0


def access_token(renew_after_days: int) -> str:
    if not TOKEN.exists():
        raise RuntimeError(f"no token in {TOKEN}; run: with-secrets {CREDS} wakatime-sync --login")
    token = jsonlib.loads(TOKEN.read_text())
    if datetime.now(UTC) - datetime.fromisoformat(token["obtained_at"]) >= timedelta(days=renew_after_days):
        # merged: a response without a refresh_token leaves the old one in place
        token = save_token(token | request_token(grant_type="refresh_token", refresh_token=token["refresh_token"]))
    return token["access_token"]


def app_credentials() -> tuple[str, str]:
    app_id, secret = os.environ.get("WAKATIME_APP_ID"), os.environ.get("WAKATIME_APP_SECRET")
    if not (app_id and secret):
        raise RuntimeError(f"WAKATIME_APP_ID and WAKATIME_APP_SECRET are not set; run under: with-secrets {CREDS}")
    return app_id, secret


def request_token(**fields: str) -> dict:
    app_id, secret = app_credentials()
    data = urllib.parse.urlencode({"client_id": app_id, "client_secret": secret, "redirect_uri": REDIRECT_URI, **fields})
    try:
        with urllib.request.urlopen(f"{OAUTH}/token", data=data.encode(), timeout=60) as resp:
            return jsonlib.load(resp)
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"HTTP {e.code} from {OAUTH}/token: {e.read()[:200].decode(errors='replace')}") from e
    except urllib.error.URLError as e:
        raise Offline(str(e.reason)) from e


def save_token(token: dict) -> dict:
    token = token | {"obtained_at": datetime.now(UTC).isoformat()}
    TOKEN.parent.mkdir(parents=True, exist_ok=True)
    tmp = TOKEN.with_suffix(".json.tmp")
    tmp.touch(mode=0o600)
    tmp.write_text(jsonlib.dumps(token, indent=1))
    os.replace(tmp, TOKEN)
    return token


def day_file(data_dir: pathlib.Path, day: date) -> pathlib.Path:
    return data_dir / f"{day:%Y}" / f"{day:%Y-%m-%d}.jsonl"


def newest_local_day(data_dir: pathlib.Path) -> date | None:
    files = sorted(data_dir.glob("*/*.jsonl"))
    return date.fromisoformat(files[-1].stem) if files else None


def write_user_agents(data_dir: pathlib.Path, api: "Api") -> int:
    """The id to editor map, so a heartbeat's user_agent_id reads as Firefox, Brave, Claude Code, Neovim, Obsidian or Discord."""
    path = data_dir / "user_agents.json"
    agents = jsonlib.loads(path.read_text()) if path.exists() else {}  # merge: the API drops an agent once it goes unused
    page, pages = 1, 1
    while page <= pages:
        got = api.get("user_agents", page=str(page))
        pages = got.get("total_pages", 1)
        agents.update({a["id"]: {"editor": a.get("editor"), "last_seen_at": a.get("last_seen_at")} for a in got.get("data", [])})
        page += 1
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(jsonlib.dumps(agents, indent=1, sort_keys=True))
    os.replace(tmp, path)
    return len(agents)


def write_day(path: pathlib.Path, heartbeats: list[dict]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".jsonl.tmp")
    with tmp.open("w") as f:
        for h in heartbeats:
            f.write(jsonlib.dumps(h, separators=(",", ":")) + "\n")
    os.replace(tmp, path)


def log_run(outcome: str, reason: str = "", stats: dict | None = None) -> None:
    cmd = [str(RUN_LOG_BIN), UNIT, outcome]
    if reason:
        cmd += ["--reason", reason]
    if stats:
        cmd += ["--stats", jsonlib.dumps(stats)]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        print(f"{UNIT}: run-log failed: {proc.stderr.strip()}", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main(tyro.cli(Args, description=__doc__, config=(tyro.conf.OmitArgPrefixes,))))
