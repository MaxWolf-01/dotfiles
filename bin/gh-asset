#!/usr/bin/env bash
# Host images for a GitHub PR or issue in the repo they belong to, without
# committing them to any branch.
#
# Files go to refs/media/assets, a ref outside refs/heads/* and refs/tags/*.
# Git's default fetch refspec covers only those two, so nobody ever clones,
# fetches or pays for what is pushed here, while GitHub still serves every file
# by commit sha. The link works in a private repo: GitHub leaves a github.com
# image src alone rather than routing it through its camo proxy, so a reader's
# browser sends its own session cookie and gets a short-lived redirect to the
# file. A raw.githubusercontent.com link does not, and breaks for everyone.
#
# Usage:
#   gh-asset push <file>...        # push, print the markdown to paste
#   gh-asset list                  # what is in the ref, newest tree
#
# Deleting the ref does not unpublish. Measured: the contents API and the raw
# URL both still served a file the moment after its ref was deleted. Read access
# to the repo is what bounds the damage, because every link needs a session
# cookie carrying it, and the sha is unguessable. So a wrong image costs
# nothing, push the right one over it. A file that should never have left needs
# GitHub Support to purge it, the same escalation as a secret in a commit.
#
# A reviewer reading the PR in a notification email sees a broken image: email
# carries no session cookie. They see it on the web page.
set -euo pipefail

REF=refs/media/assets

die() { echo "gh-asset: $*" >&2; exit 1; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's/^# \?//;$d'; }

# owner/name from the origin remote, both URL forms.
origin_slug() {
  local url
  url=$(git remote get-url origin 2>/dev/null) || die "not in a git repo with an origin remote; pass --repo"
  # POSIX ERE has no lazy quantifier, so .git comes off before the match.
  url=${url%.git}
  [[ $url =~ github\.com[:/]([^/]+/[^/]+)$ ]] || die "origin is not a github remote: $url"
  echo "${BASH_REMATCH[1]}"
}

# The ref as origin has it. Absent on first use, which is not an error.
fetch_ref() {
  git fetch --quiet origin "+$REF:$REF" 2>/dev/null || true
  git rev-parse --quiet --verify "$REF" || true
}

cmd_push() {
  [ $# -gt 0 ] || die "nothing to push"
  local slug parent idx tree commit
  slug=$(origin_slug)
  parent=$(fetch_ref)

  idx=$(mktemp -u)  # git creates it; an existing empty file is not a valid index
  trap 'rm -f "$idx"' RETURN
  # A new tree keeps every earlier file, so one ref holds the whole history and
  # the shas already handed out keep resolving.
  [ -n "$parent" ] && GIT_INDEX_FILE="$idx" git read-tree "$parent"

  local f blob names=()
  for f in "$@"; do
    [ -f "$f" ] || die "no such file: $f"
    blob=$(git hash-object -w -- "$f")
    names+=("$(basename -- "$f")")
    GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$blob,${names[-1]}"
  done

  tree=$(GIT_INDEX_FILE="$idx" git write-tree)
  commit=$(git commit-tree "$tree" ${parent:+-p "$parent"} -m "assets: ${names[*]}")
  git push --quiet origin "$commit:$REF"

  local n
  for n in "${names[@]}"; do
    echo "![${n%.*}](https://github.com/$slug/raw/$commit/$n)"
  done
}

cmd_list() {
  local slug head
  slug=$(origin_slug)
  head=$(fetch_ref)
  [ -n "$head" ] || { echo "no assets in $slug"; return; }
  git ls-tree --name-only "$head" | sed "s|^|https://github.com/$slug/raw/$head/|"
}

case "${1:-}" in
  push) shift; cmd_push "$@" ;;
  list) cmd_list ;;
  ""|-h|--help) usage ;;
  *) die "unknown command: $1" ;;
esac
