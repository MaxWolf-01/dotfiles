#!/usr/bin/env bash
# The unit name of a restic backup config: <repo directory>-<file stem>.
#
# Usage: config-name <config-file>
#
# backup/restic/working/rsyncnet.conf is the working-rsyncnet unit: the name its
# runs are logged under (bin/run-log), the row the backups dashboard draws, the
# name the watchdog reports, and the title on its failure notification. Four
# readers derive it, so it is derived once.

set -uo pipefail

config="${1:-}"
if [ -z "$config" ]; then
    echo "config-name: expected a restic config path" >&2
    exit 2
fi

printf '%s-%s\n' "$(basename "$(dirname "$config")")" "$(basename "$config" .conf)"
