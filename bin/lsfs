#!/usr/bin/env bash
# The n largest entries under the current directory (default 10); a negative
# n lists the n smallest instead.
# Usage: lsfs [n]
set -eu
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac
n=${1:-10}
if (( n < 0 )); then
  du -ah | sort -h | head -n $(( -n ))
else
  du -ah | sort -hr | head -n "$n"
fi
