#!/usr/bin/env bash
# Which host runs which restic backup, read from the timer definitions.
#
# Usage: backup-hosts [UNIT]
#
# A repository is judged by the age of its newest snapshot, so when its target
# is away the only evidence left is the run log of the host that makes the
# backup — and which host that is, is decided in the timer files and nowhere
# else. Two readers ask: bin/overdue-check, which falls back to that log, and
# the backups dashboard, which draws each repo under its host.
#
# Output is tab separated, one unit per line, sorted:
#
#   encrypted-rsyncnet<TAB>pc
#   working-rsyncnet<TAB>zephylux

set -uo pipefail

# -P, because the timer files are found by walking up from here: ~/bin is a
# symlink into the store and the store entry a symlink back into ~/.dotfiles,
# so the logical path leads to ~/nix/home, which does not exist.
bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
config_name_bin="$bin_dir/config-name"
nix_home="$(dirname "$bin_dir")/nix/home"

# Each host, and the file that says what it runs.
declare -A TIMER_FILES=(
    [zephylux]="$nix_home/timers.nix"
    [pc]="$nix_home/pc-timers.nix"
)

usage() {
    cat <<EOF
Usage: $(basename "$0")

Prints '<unit><TAB><host>' for every restic backup a timer runs, read from:
$(printf '  %s\n' "${TIMER_FILES[@]}")
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") ;;
    *) echo "Unexpected argument: $1" >&2; usage >&2; exit 2 ;;
esac

pairs=""
for host in "${!TIMER_FILES[@]}"; do
    file="${TIMER_FILES[$host]}"
    if [ ! -f "$file" ]; then
        echo "No timer definitions at $file — nothing says which backups $host runs." >&2
        exit 2
    fi
    # Matched in bash: of the two systemd units that run this, one carries no
    # awk and no /usr/bin.
    while IFS= read -r line; do
        while [[ "$line" =~ (backup/restic/[a-z0-9_-]+/[a-z0-9_-]+\.conf) ]]; do
            conf="${BASH_REMATCH[1]}"
            line="${line#*"$conf"}"
            unit="$("$config_name_bin" "$conf")" || exit 2
            pairs="${pairs}${unit}	${host}"$'\n'
        done
    done < "$file"
done

# A unit two timers on one host both name is still one unit on one host.
pairs=$(sort -u <<<"${pairs%$'\n'}")

# An empty answer would tell every reader that no host runs any backup: the
# watchdog would date each away repository against the wrong host's log, and the
# dashboard would draw every repo as unscheduled. A path spelled differently in
# a timer file is enough to get here.
if [ -z "$pairs" ]; then
    echo "No restic backup found in ${TIMER_FILES[*]} — either no timer runs one, or the paths there changed shape." >&2
    exit 2
fi

# Two hosts backing up into one repository is a race nobody wrote down, and it
# would make the run log this answer points at ambiguous.
clash=$(cut -f1 <<<"$pairs" | uniq -d)
if [ -n "$clash" ]; then
    echo "These backups are run by more than one host: $(tr '\n' ' ' <<<"$clash")" >&2
    exit 2
fi

printf '%s\n' "$pairs"
