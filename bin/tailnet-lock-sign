#!/usr/bin/env bash
# Sign the Mullvad exit nodes that Tailnet Lock has locked out of the netmap.
#
# Tailnet Lock drops unsigned peers from the netmap entirely, so an unsigned
# Mullvad node is invisible to exit-node selection rather than broken. The pool
# of usable exit nodes therefore only shrinks as Mullvad adds and re-keys nodes.
# A device pinned to a single node (the Android app has no auto-select) loses
# internet the moment that node's key changes, until this runs.
#
# Run on a timer from every signing node, so each one can recover on its own.
# Requires a trusted tailnet-lock key on this host, and Mullvad access: nodes
# missing from this host's netmap cannot be signed.
#
# Needs root, or the operator grant (`tailscale set --operator=$USER`).
set -euo pipefail

status=$(tailscale lock status --json)

if [[ "$(jq -r '.Enabled' <<<"$status")" != "true" ]]; then
  echo "tailnet lock is not enabled; nothing to sign"
  exit 0
fi

peers=$(jq -c '.FilteredPeers // []' <<<"$status")

# Tailscale's own docs and mullvad-script select on .DNSName, which this struct
# has not had for years (ipnstate.TKAPeer names the field Name). Silently
# matching nothing would leave every exit node unsigned, so check rather than
# assume.
unnamed=$(jq '[.[] | select(.Name == null)] | length' <<<"$peers")
if [[ "$unnamed" != "0" ]]; then
  echo "tailnet-lock-sign: $unnamed locked-out peer(s) have no Name field" >&2
  echo "tailnet-lock-sign: the client's TKAPeer schema changed; refusing to guess" >&2
  exit 1
fi

foreign=$(jq -r '[.[] | select(.Name | endswith(".mullvad.ts.net.") | not) | .Name] | join(" ")' <<<"$peers")
if [[ -n "$foreign" ]]; then
  echo "tailnet-lock-sign: locked out and NOT signed by this script: $foreign" >&2
fi

mapfile -t targets < <(jq -r '.[] | select(.Name | endswith(".mullvad.ts.net.")) | "\(.Name)\t\(.NodeKey)"' <<<"$peers")

if [[ ${#targets[@]} -eq 0 ]]; then
  echo "no unsigned Mullvad exit nodes"
  exit 0
fi

failed=0
for target in "${targets[@]}"; do
  name=${target%%$'\t'*}
  nodekey=${target##*$'\t'}
  if tailscale lock sign "$nodekey"; then
    echo "signed $name"
  else
    echo "tailnet-lock-sign: failed to sign $name ($nodekey)" >&2
    failed=$((failed + 1))
  fi
done

echo "tailnet-lock-sign: signed $((${#targets[@]} - failed))/${#targets[@]} Mullvad exit node(s)"
[[ $failed -eq 0 ]]
