#!/usr/bin/env bash
# csvlens for any delimited text file; the default opener for CSV and TSV.
# csvlens reads only UTF-8, while bank and Excel exports are often Windows-1252,
# so a file that isn't UTF-8 is converted to a temporary copy first.

set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: csvlens-open <file>" >&2
  exit 2
fi
file="$1"

if iconv -f UTF-8 -t UTF-8 "$file" > /dev/null 2>&1; then
  exec csvlens -d auto "$file"
fi

# Same base name in a temp dir, so csvlens's status bar still shows it.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
copy="$tmp/$(basename "$file")"
iconv -f WINDOWS-1252 -t UTF-8 "$file" > "$copy"
csvlens -d auto "$copy"
