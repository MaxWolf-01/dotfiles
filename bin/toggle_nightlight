#!/usr/bin/env bash
# Turn GNOME's night light on if it is off, off if it is on.
# From https://gist.github.com/kapad/bdbf5df735690afd8cd36225becf7304

setting=$(gsettings get org.gnome.settings-daemon.plugins.color night-light-enabled)

if [[ $setting == "true" ]]; then
  gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled false
else
  gsettings set org.gnome.settings-daemon.plugins.color night-light-enabled true
fi
