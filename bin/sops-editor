#!/usr/bin/env bash
# SOPS_EDITOR wrapper: sops seeds new files with a "Welcome to SOPS!" example template.
# Blank it so a new secret opens as an empty buffer ready to paste into.
# The delete goes to the black-hole register (unnamed and "+ stay intact) and only lives
# in the buffer, so `u` restores it and a misdetection costs nothing.
set -euo pipefail

editor=${EDITOR:-vim}
file=$1

case "${editor##*/}" in
  vim | nvim) ;;
  *) exec "$editor" "$file" ;; # the -c flags below are vim-only
esac

if head -c 512 "$file" | grep -qF 'Welcome to SOPS! Edit this file as you please!'; then
  exec "$editor" -c 'silent! %d _' -c startinsert "$file"
fi

exec "$editor" "$file"
