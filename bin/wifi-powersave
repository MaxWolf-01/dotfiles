#!/usr/bin/env bash
# Wi-Fi power saving follows the power source: off on AC, on on battery.
#
# With power saving on, the Wi-Fi chip sleeps between packets and the access
# point holds what arrives for it until it wakes. That costs latency, which a
# game stream or a call shows as stutter, and saves power only a battery misses.
#
# NetworkManager turns power saving on at every connect (Ubuntu ships
# /etc/NetworkManager/conf.d/default-wifi-powersave-on.conf), so two events set
# it again: the mains supply changing, through a udev rule, and an interface
# coming up, through NetworkManager's dispatcher. The installed copy of this
# script is that dispatcher script, and the udev rule runs the same copy. The
# copy does not follow edits made here: `status` says when the two differ,
# `install` reinstalls.
#
# Usage:
#   wifi-powersave install   install the copy and the udev rule, and apply now
#   wifi-powersave status    power source, each interface's setting, what is installed
#   wifi-powersave reset     remove the copy and the rule; the setting stays as it is
#   wifi-powersave apply     set it for the current power source, as root

set -euo pipefail

# Overridable for tests/wifi-powersave.test.
POWER=${WIFI_POWERSAVE_POWER:-/sys/class/power_supply}
NET=${WIFI_POWERSAVE_NET:-/sys/class/net}
IW=${WIFI_POWERSAVE_IW:-/usr/sbin/iw}
# NetworkManager runs a dispatcher script only when root owns it and nobody else can write it.
INSTALLED=/etc/NetworkManager/dispatcher.d/90-wifi-powersave
RULE_PATH=/etc/udev/rules.d/99-wifi-powersave.rules

die() {
    echo "wifi-powersave: $*" >&2
    exit 1
}

on_ac() {
    local supply
    for supply in "$POWER"/*/type; do
        [ -r "$supply" ] || continue
        if [ "$(cat "$supply")" = Mains ] && [ "$(cat "${supply%/type}/online")" = 1 ]; then return 0; fi
    done
    return 1
}

interfaces() {
    local dir
    for dir in "$NET"/*/wireless; do
        [ -d "$dir" ] || continue
        dir=${dir%/wireless}
        echo "${dir##*/}"
    done
}

apply() {
    local want=on iface
    if on_ac; then want=off; fi
    for iface in $(interfaces); do
        "$IW" dev "$iface" set power_save "$want" ||
            die "could not set power_save $want on $iface. Run as root: sudo $0 apply"
    done
}

show() {
    local iface
    if on_ac; then echo "source: AC, power saving belongs off"; else echo "source: battery, power saving belongs on"; fi
    for iface in $(interfaces); do
        echo "$iface: $("$IW" dev "$iface" get power_save)"
    done
    if [ -f "$INSTALLED" ]; then
        if cmp -s "$0" "$INSTALLED"; then
            echo "installed copy: matches this script"
        else
            echo "installed copy: differs from this script ('wifi-powersave install' reinstalls)"
        fi
    else
        echo "installed copy: none"
    fi
    if [ -f "$RULE_PATH" ]; then echo "udev: $(basename "$RULE_PATH") installed"; else echo "udev: not installed"; fi
}

install_all() {
    sudo install -m 755 -o root -g root "$0" "$INSTALLED"
    # Mains only: the battery emits a change event on every capacity tick.
    sudo tee "$RULE_PATH" >/dev/null <<EOF
ACTION=="change", SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="Mains", RUN+="$INSTALLED apply"
EOF
    sudo udevadm control --reload
    sudo "$INSTALLED" apply
}

uninstall() {
    if [ -f "$RULE_PATH" ]; then
        sudo rm "$RULE_PATH"
        sudo udevadm control --reload
    fi
    [ -f "$INSTALLED" ] && sudo rm "$INSTALLED"
    return 0
}

# NetworkManager calls a dispatcher script as `<script> <interface> <action>`
# for every event, and names the action here too. It has set power saving by
# the time it reports the interface up.
if [ -n "${NM_DISPATCHER_ACTION:-}" ]; then
    if [ "$NM_DISPATCHER_ACTION" = up ]; then apply; fi
    exit 0
fi

case "${1:-}" in
    apply)
        apply
        ;;
    install)
        install_all
        echo "installed $INSTALLED and $(basename "$RULE_PATH")"
        show
        ;;
    status)
        show
        ;;
    reset)
        uninstall
        echo "removed $INSTALLED and $(basename "$RULE_PATH")"
        show
        ;;
    ''|-h|--help)
        awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"
        ;;
    *)
        die "unknown command '$1' (see --help)"
        ;;
esac
