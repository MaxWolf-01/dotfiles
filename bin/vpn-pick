#!/usr/bin/env bash
# Pick a Mullvad exit node that Cloudflare does not block.
#
# `tailscale set --exit-node=auto:any` ranks nodes by latency only. Cloudflare
# scores each egress IP separately and hard-blocks some Mullvad IPs for
# Chrome-family clients (every Electron app: Vesktop, ...), while Firefox from
# the same IP passes. So the browser works, the app shows "Temporary Network
# Error", and Tailscale's own health checks see nothing wrong. The block is
# per-node, not per-country, and reputations drift — a static pin or blacklist
# rots. This adds the missing application-level health check: enable auto:any
# (keeps auto-failover), probe the request class that actually fails (the
# Discord API with a Chrome UA), and only when the picked node is blocked,
# walk nearby nodes and pin the first clean one.
#
# The probe counts only a Cloudflare-signed 403 as blocked (Discord's own
# errors are JSON; Cloudflare's block page is HTML), and confirms it after
# CONFIRM_SECS before anyone rotates: a real IP block persists, a transient
# challenge clears — and every rotation is an IP change Discord's session
# heuristics get to see (rapid IP hopping is what triggers re-login prompts).
#
# Nothing here pops up a notification. A rotation is the design working, not a
# thing to act on, so every pick appends a line to ~/logs/runs/vpn-pick.jsonl
# instead (bin/run-log) and the dns/vpn dashboard reads the history out of it.
# The watcher writes its own hourly heartbeat to ~/logs/runs/vpn-watchdog.jsonl:
# systemd only ever saw this loop *start*, so without the heartbeat a watcher
# that died months ago and one running fine are the same fact, and a pinned exit
# node with no watcher has no failover at all.
#
#   vpn-pick             turn on + verify (what the vpn-on alias runs)
#   vpn-pick --check     report the current node's verdict, change nothing
#   vpn-pick --watch     persistent watcher (the vpn-watchdog user service).
#                        Polls local tailscale state every POLL_SECS — free, no
#                        network traffic — and probes Discord only on events:
#                        exit node changed (auto failover may have landed on a
#                        blocked node) or went offline (a pinned node has no
#                        native failover; this supplies it). A slow PROBE_SECS
#                        re-probe catches in-place reputation flips. All
#                        probing is gated on Vesktop actually running — the
#                        only Chrome-family client here; nothing to guard
#                        otherwise. Idles while no exit node is set (respects
#                        vpn-off); the offline/re-pick path stays active
#                        regardless of Vesktop (a dead node kills all egress,
#                        not just Discord).
#
# Needs curl + jq, and the tailscale operator grant (no sudo).
set -uo pipefail

CHROME_UA="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
CANARY=https://discord.com/api/v9/gateway  # unauthenticated, tiny JSON; the API is what Cloudflare blocks for the app
COUNTRIES=(Germany Austria Switzerland Netherlands)
MAX_PINS=8       # nodes to try after auto's pick before giving up
POLL_SECS=15     # local tailscale state poll (watch mode)
PROBE_SECS=600   # unconditional re-probe of an unchanged node (watch mode)
CONFIRM_SECS=45  # spacing before confirming a 403 — transients clear, real blocks persist
BACKOFF_SECS=300  # pause after a failed recovery before the loop resumes
HEARTBEAT_SECS=3600  # watch mode: how often the loop records that it is alive
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/vpn-pick.lock"

# Two run logs, because they answer two questions. Picks are events — a rotation
# should be rare, and bounding how long it has been since one would be nonsense.
# The heartbeat is a schedule, and it is the one the watchdog holds to a bound.
PICK_UNIT=vpn-pick
WATCH_UNIT=vpn-watchdog

# Reached relative to this script, not through PATH: the systemd unit pins its
# own PATH and it does not carry ~/bin.
RUN_LOG="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-log"

# Recording a run must never decide whether it succeeded.
log_run() {  # log_run <unit> <ok|skip|fail> [reason] [stats-json]
  local args=("$1" "$2")
  [ -n "${3:-}" ] && args+=(--reason "$3")
  [ -n "${4:-}" ] && args+=(--stats "$4")
  "$RUN_LOG" "${args[@]}" || echo "vpn-pick: could not write the run log for $1" >&2
}

pick() {  # serialized: the watcher and a manual run must not fight over the node
  (
    flock -w 90 9 || { echo "vpn-pick: another instance holds the lock" >&2; exit 1; }
    do_pick
  ) 9>>"$LOCKFILE"
}

do_pick() {
  tailscale set --exit-node=auto:any --exit-node-allow-lan-access=true
  if ! settle any; then
    echo "vpn-pick: egress never reached Mullvad — tailscale down? captive portal? (docs/dns.md)" >&2
    log_run "$PICK_UNIT" fail "egress never reached Mullvad — tailscale down, or a captive portal" \
      "$(pick_stats unreachable)"
    return 1
  fi
  local current verdict
  current=$(egress)
  probe && verdict=0 || verdict=$?
  if [[ $verdict -eq 0 ]]; then
    echo "exit node: $current (auto-failover on, canary clean)"
    log_run "$PICK_UNIT" ok "" "$(pick_stats clean "$current")"
    return 0
  fi
  # Not a verdict about the node: the canary itself could not be reached, so
  # there is nothing to rotate away from. A skip, not a failure of this job.
  if [[ $verdict -eq 2 ]]; then
    echo "vpn-pick: canary unreachable through $current — network trouble, not walking nodes" >&2
    log_run "$PICK_UNIT" skip "the Discord canary was unreachable through $current — network trouble, not a blocked node" \
      "$(pick_stats canary-unreachable "$current")"
    return 1
  fi

  echo "auto picked $current, Cloudflare blocks it — walking alternatives"
  local attempts=0 node short
  for node in $(candidates); do
    short=${node%%.*}
    [[ $short == "$current" ]] && continue
    (( ++attempts > MAX_PINS )) && break
    tailscale set --exit-node="$node" --exit-node-allow-lan-access=true
    settle "$short" || { echo "  $short: unreachable, skipping"; continue; }
    if probe_once; then  # unconfirmed is fine here: a false "blocked" just skips one candidate
      echo "pinned: $node (native failover off — the vpn-watchdog watcher covers it)"
      log_run "$PICK_UNIT" ok "" "$(pick_stats rotated "$current" "$short" "$attempts")"
      return 0
    fi
    echo "  $short: blocked too"
  done

  tailscale set --exit-node=auto:any --exit-node-allow-lan-access=true
  echo "vpn-pick: no clean node among $attempts candidates — left on auto:any; Discord will be broken" >&2
  log_run "$PICK_UNIT" fail "Cloudflare blocks $current and every one of $attempts alternatives tried; left on auto:any, so Discord and other Electron apps stay broken" \
    "$(pick_stats exhausted "$current" "" "$attempts")"
  return 1
}

# What a pick did, in the shape the dashboard reads. `node` is the node the run
# was about; `rotated_to` is set only when it actually moved, and `tried` counts
# the alternatives walked to get there.
pick_stats() {  # pick_stats <event> [node] [rotated_to] [tried]
  jq -c -n --arg event "$1" --arg node "${2:-}" --arg to "${3:-}" \
    --argjson tried "${4:-0}" \
    '{event: $event,
      node: (if $node == "" then null else $node end),
      rotated_to: (if $to == "" then null else $to end),
      tried: $tried}'
}

watch() {
  local st id online last_id="" last_probe=0 last_beat=0 now
  while true; do
    sleep "$POLL_SECS"
    now=$(date +%s)
    st=$(tailscale status --json 2>/dev/null) || st=""
    id=$(jq -r '.ExitNodeStatus.ID // empty' <<<"$st" 2>/dev/null)
    # Before any of the guards below, so the heartbeat keeps arriving while
    # tailscale is down or the VPN is off — the loop being alive is what it
    # reports, and both of those are states it is alive to observe.
    if (( now - last_beat >= HEARTBEAT_SECS )); then
      last_beat=$now
      heartbeat "$st" "$id"
    fi

    [[ -n $st ]] || { last_id=""; continue; }  # tailscale down
    [[ -n $id ]] || { last_id=""; continue; }  # vpn-off: respect it
    online=$(jq -r '.ExitNodeStatus.Online' <<<"$st")

    if [[ $online == false ]]; then
      echo "exit node offline — re-picking"
      recover; last_id=""; last_probe=$now
      continue
    fi
    if ! vesktop_running; then
      last_id=""  # forces a probe when Vesktop reopens on an unverified node
      continue
    fi
    if [[ $id != "$last_id" ]]; then
      [[ -n $last_id ]] && echo "exit node changed — probing the new one"
      last_id=$id; last_probe=$now
      settle any >/dev/null || continue  # give a fresh failover a moment to route
      probe_and_recover
      continue
    fi
    if (( now - last_probe >= PROBE_SECS )); then
      last_probe=$now
      probe_and_recover
    fi
  done
}

probe_and_recover() {
  probe && return 0
  if [[ $? -eq 1 ]]; then
    echo "current exit node is Cloudflare-blocked — rotating"
    recover
    return
  fi
  # Canary unreachable. Egress still answering means Discord itself is unwell —
  # rotating won't help. No egress at all means the node is dead or the network
  # is down; recovery handles the first and fails loud on the second.
  if [[ -n $(egress) ]]; then
    echo "egress fine, canary unreachable — not a node problem, not rotating"
    return 0
  fi
  echo "no egress through the exit node — re-picking"
  recover
}

recover() {
  pick && return 0
  echo "recovery failed — backing off ${BACKOFF_SECS}s"
  sleep "$BACKOFF_SECS"
}

check() {
  local node
  node=$(egress)
  [[ -n $node ]] || { echo "not egressing through Mullvad (vpn-off, or no connectivity)"; exit 1; }
  probe && { echo "$node: clean"; exit 0; }
  case $? in
    1) echo "$node: Cloudflare-blocked (Chrome-UA canary gets 403)"; exit 1 ;;
    2) echo "$node: canary unreachable"; exit 2 ;;
  esac
}

probe() {  # 0 clean, 1 blocked (Cloudflare 403, confirmed), 2 unreachable
  probe_once
  local first=$?
  (( first != 1 )) && return $first
  sleep "$CONFIRM_SECS"
  probe_once
}

probe_once() {  # single request: 0 clean, 1 blocked, 2 unreachable
  local body code first_char
  body=$(mktemp)
  code=$(curl -4 -s -m 10 -o "$body" -w '%{http_code}' -A "$CHROME_UA" "$CANARY")
  first_char=$(head -c1 "$body")
  rm -f "$body"
  case $code in
    403) [[ $first_char == "{" ]] && return 0 || return 1 ;;  # JSON = Discord's own answer, node fine; HTML = Cloudflare's block page
    000|5*) return 2 ;;
    *) return 0 ;;
  esac
}

vesktop_running() {  # no process is named "vesktop" — it's a bare electron binary; match the app path
  pgrep -f "Vesktop/resources/app.asar" >/dev/null
}

egress() {  # Mullvad node short name we currently egress through, or empty
  curl -4 -s -m 8 https://am.i.mullvad.net/json | jq -r '.mullvad_exit_ip_hostname // empty'
}

settle() {  # settle <short-name|any> — wait until egress goes through it
  local want=$1 got
  for _ in $(seq 1 20); do
    got=$(egress)
    [[ -n $got && ( $want == any || $got == "$want" ) ]] && return 0
    sleep 1
  done
  return 1
}

candidates() {  # exit nodes in COUNTRIES order, deduped ("Any"-city rows repeat nodes)
  local list country
  list=$(tailscale exit-node list)
  for country in "${COUNTRIES[@]}"; do
    awk -v c="$country" '$2 ~ /\.mullvad\.ts\.net$/ && $3 == c {print $2}' <<<"$list"
  done | awk '!seen[$0]++'
}

# One line an hour saying the loop is still turning, and what it sees. Always
# `ok`: neither a machine with the VPN off nor one with tailscale down is a
# watcher that stopped watching, and this log answers only that question.
heartbeat() {  # heartbeat <tailscale-status-json> <exit-node-id>
  local state node=""
  if [[ -z $1 ]]; then
    state=tailscale-down
  elif [[ -z $2 ]]; then
    state=no-exit-node
  else
    state=guarding
    node=$(jq -r 'first(.Peer[] | select(.ExitNode == true) | .HostName) // empty' <<<"$1" 2>/dev/null)
  fi
  log_run "$WATCH_UNIT" ok "" "$(jq -c -n --arg state "$state" --arg node "$node" \
    --argjson vesktop "$(vesktop_running && echo true || echo false)" \
    '{state: $state, exit_node: (if $node == "" then null else $node end), vesktop: $vesktop}')"
}

case "${1:-}" in
  "") pick ;;
  --check) check ;;
  --watch) watch ;;
  *) echo "usage: vpn-pick [--check|--watch]" >&2; exit 2 ;;
esac
