#!/usr/bin/env bash
# Open a page for max in Brave, in the profile signed into this Claude Code
# session's account: in its orchestrator's unit of the hub tab when the
# container hub is up, else as a plain tab.
#
# Usage: claude-browser [URL|FILE]
#   URL|FILE    anything Brave renders: an HTML page, an SVG, a PNG, a PDF, at a
#               URL or a path anywhere on disk. Without one, a blank tab.
#
# Where the page lands:
#   With the hub (container-hub on 127.0.0.1:$CONTAINER_HUB_PORT, default 8377),
#   the page becomes a member of the unit of the session in $MX_ORIGIN_SESSION,
#   else of this session ($CLAUDE_CODE_SESSION_ID), so a dispatched worker's
#   page lands with its orchestrator. A hub tab that listens shows it, and
#   nothing opens; only when no hub tab listens does the hub tab open, at the
#   unit and the page. A page meant for agents opens nowhere; a page on another
#   site opens as a plain tab. The hub's own pages (the hub tab, at / or at a
#   unit's /u/<session id>) and a blank tab always open as plain tabs.
#   Without the hub, or with a hub that refuses the page, it opens as a plain
#   tab.
#
# What it prints, on stderr:
#   claude-browser: <the hub's line>
#       the hub took the page: which unit it joined, and whether the hub tab
#       opens; or why it opens nowhere or as a plain tab.
#   claude-browser: what answers at <hub> is no container hub, ...
#       something else holds the hub's port; the page opens as a plain tab.
#   claude-browser: the container hub at <hub> refused the page (<status>: <why>), ...
#       the page opens as a plain tab; <why> is the hub's own reason.
#   Nothing: no hub answers, or the page is a blank tab or one of the hub's own.
#   Any other line comes with exit 1, and the page was not opened; the line
#   says what to fix.
#
# Exit codes:
#   0  the page was handed to Brave, the listening hub tab shows it, or the hub
#      said it opens nowhere
#   1  no Brave profile to open it in (the line printed says why), or an
#      option it does not have
set -euo pipefail

case "${1:-}" in
  -h|--help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;$d'; exit 0 ;;
  -*) echo "claude-browser: no option $1; see claude-browser --help" >&2; exit 1 ;;
esac

# Always a URL: a bare `brave --profile-directory=X` opens a second window when
# one already exists, a URL lands as a tab in the existing one. A file may live
# anywhere, /tmp included: Brave is not firejailed the way Firefox (the browsing
# browser) is, and holds only what an agent opened.
target="${1:-about:blank}"
open=$target
[[ -e "$target" ]] && { open=$(realpath "$target"); target="file://$open"; }

# what this prints once Brave has the page, since a missing profile can still stop it
say=""
hub="http://127.0.0.1:${CONTAINER_HUB_PORT:-8377}"
# the hub's own pages (the hub tab, at its root or at a unit, or at a container view's old address) are tabs, not members
if [[ "$target" != about:blank && "$target" != "$hub/" && "$target" != "$hub/u/"* && "$target" != "$hub/c/"* ]]; then
  body=$(jq -nc --arg target "$open" --arg cwd "$PWD" \
    --arg session "${MX_ORIGIN_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}" \
    '{target: $target, cwd: $cwd} + (if $session != "" then {session: $session} else {} end)')
  # no answer at all (status 000) is a host without the hub, which says nothing
  answer=$(curl -s --connect-timeout 1 --max-time 8 -w '\n%{http_code}' -H 'Content-Type: application/json' \
    --data "$body" "$hub/api/open" 2>/dev/null) || true
  status=${answer##*$'\n'} answer=${answer%$'\n'*}
  if [[ $status == 200 ]] && jq -e '(.say | type) == "string" and has("open")' <<<"$answer" >/dev/null 2>&1; then
    say=$(jq -r '"claude-browser: \(.say)"' <<<"$answer")
    target=$(jq -r '.open // empty' <<<"$answer")
    [[ -n $target ]] || { echo "$say" >&2; exit 0; }
  elif [[ $status == 200 ]]; then
    say="claude-browser: what answers at $hub is no container hub, so this opens as a plain tab"
  elif [[ -n $status && $status != 000 ]]; then
    said=$(jq -r '.error // empty' <<<"$answer" 2>/dev/null) || said=""
    say="claude-browser: the container hub at $hub refused the page ($status${said:+: $said}), so it opens as a plain tab"
  fi
fi

# Claude in Chrome pairs per (browser profile, claude.ai account): the extension
# in a profile serves exactly the account it is signed into, and a profile with
# no open window has no extension worker, so Claude Code cannot see it at all.
# Each Claude Code account therefore has its own Brave profile, named after its
# config dir: ~/.claude is "Personal", ~/.claude-<x> is "<x>" (case-insensitive).
# The session's account comes from CLAUDE_CONFIG_DIR (direnv sets it per work dir).
config_dir=$(basename "${CLAUDE_CONFIG_DIR:-$HOME/.claude}")
case "$config_dir" in
  .claude)   profile_name="Personal" ;;
  .claude-?*) profile_name="${config_dir#.claude-}" ;;
  *)
    echo "claude-browser: CLAUDE_CONFIG_DIR=$config_dir is not ~/.claude or ~/.claude-<name>, so no Brave profile name follows from it" >&2
    exit 1 ;;
esac

# The profile's on-disk directory is looked up by its name, so Brave renumbering
# its profiles cannot break this.
local_state="$HOME/.config/BraveSoftware/Brave-Browser/Local State"
if [[ ! -f "$local_state" ]]; then
  echo "claude-browser: $local_state not found — Brave has never been started on this machine" >&2
  exit 1
fi
profile_dir=$(jq -r --arg n "$profile_name" \
  '.profile.info_cache | to_entries[] | select(.value.name | ascii_downcase == ($n | ascii_downcase)) | .key' "$local_state")
if [[ -z "$profile_dir" ]]; then
  echo "claude-browser: Brave has no profile named '$profile_name' — create one with that name (brave://settings/manageProfile) for the $config_dir account" >&2
  exit 1
fi

# --profile-directory also skips Brave's startup profile picker. Brave runs in
# its own systemd scope, so systemd-oomd, which kills whole scopes, charges
# Brave's memory to Brave and not to the pane that opened it.
[[ -z $say ]] || echo "$say" >&2
setsid -f systemd-run --user --scope --quiet --collect --unit="claude-browser-$$" \
  brave --profile-directory="$profile_dir" "$target" >/dev/null 2>&1
