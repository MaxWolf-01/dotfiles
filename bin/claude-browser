#!/usr/bin/env bash
# Open the Brave profile whose Claude extension is signed into this Claude Code
# session's account, at URL (default: a blank tab).
#
# Claude in Chrome pairs per (browser profile, claude.ai account): the extension
# in a profile serves exactly the account it is signed into, and a profile with
# no open window has no extension worker, so Claude Code cannot see it at all.
# Each Claude Code account therefore has its own Brave profile, and this is the
# one place that says which is which. The session's account comes from
# CLAUDE_CONFIG_DIR (direnv sets it per work dir); the profile's on-disk
# directory is looked up by display name so Brave renumbering cannot break it.
#
# Always passes a URL: a bare `brave --profile-directory=X` opens a second
# window when one already exists, a URL lands as a tab in the existing one.
# --profile-directory also skips Brave's startup profile picker.
#
# Usage: claude-browser [URL]
set -euo pipefail

config_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
case "$(basename "$config_dir")" in
  .claude)            profile_name="Personal" ;;
  .claude-helferline) profile_name="HELFERLINE" ;;
  *)
    echo "claude-browser: no Brave profile mapped for CLAUDE_CONFIG_DIR=$config_dir (edit the case table in $0)" >&2
    exit 1 ;;
esac

local_state="$HOME/.config/BraveSoftware/Brave-Browser/Local State"
if [[ ! -f "$local_state" ]]; then
  echo "claude-browser: $local_state not found — Brave has never been started on this machine" >&2
  exit 1
fi
profile_dir=$(jq -r --arg n "$profile_name" \
  '.profile.info_cache | to_entries[] | select(.value.name == $n) | .key' "$local_state")
if [[ -z "$profile_dir" ]]; then
  echo "claude-browser: Brave has no profile named '$profile_name' — check brave://settings/manageProfile or $local_state" >&2
  exit 1
fi

setsid -f brave --profile-directory="$profile_dir" "${1:-about:blank}" >/dev/null 2>&1
