#!/usr/bin/env bash
# Open a page for max: in its container when the container hub is up, else in
# the Brave profile whose Claude extension is signed into this Claude Code
# session's account, at a URL or a local file (default: a blank tab).
#
# This is how an agent puts a page in front of max: Firefox is the browsing
# browser and runs firejailed with a home whitelist, Brave is not jailed and
# holds only what an agent opened — review pages, prototypes, figures — so a
# file may live anywhere, /tmp included.
#
# With the hub (bin/container-hub) answering on 127.0.0.1:$CONTAINER_HUB_PORT
# (8377), the page becomes a member of its container, which the hub derives
# from the page's path, the tracker and this session; an open container view
# brings it forward, and with none showing the view opens as a tab. Pages for
# agents (worker reports, diffviews of tracker files) open nowhere. Without the
# hub, the page opens as a plain tab, as below.
#
# Claude in Chrome pairs per (browser profile, claude.ai account): the extension
# in a profile serves exactly the account it is signed into, and a profile with
# no open window has no extension worker, so Claude Code cannot see it at all.
# Each Claude Code account therefore has its own Brave profile, named after its
# config dir: ~/.claude is "Personal", ~/.claude-<x> is "<x>" (case-insensitive).
# The session's account comes from CLAUDE_CONFIG_DIR (direnv sets it per work
# dir); the profile's on-disk directory is looked up by that name so Brave
# renumbering cannot break it.
#
# Always passes a URL: a bare `brave --profile-directory=X` opens a second
# window when one already exists, a URL lands as a tab in the existing one.
# --profile-directory also skips Brave's startup profile picker.
#
# Brave runs in its own systemd scope, so systemd-oomd, which kills whole
# scopes, charges Brave's memory to Brave and not to the pane that opened it.
#
# Usage: claude-browser [--container NAME] [URL|FILE]
#   Anything Brave renders: an HTML page, an SVG, a PNG, a PDF.
#   --container puts the page in the container NAME rather than the derived one.
set -euo pipefail

container=""
case "${1:-}" in
  -h|--help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;$d'; exit 0 ;;
  --container) container=${2:?--container needs a name}; shift 2 ;;
esac

target="${1:-about:blank}"
open=$target
[[ -e "$target" ]] && { open=$(realpath "$target"); target="file://$open"; }

hub="http://127.0.0.1:${CONTAINER_HUB_PORT:-8377}"
# the hub's own pages (its index, a container's view) are tabs, not members
if [[ "$target" != about:blank && "$target" != "$hub/" && "$target" != "$hub/c/"* ]]; then
  body=$(jq -nc --arg target "$open" --arg container "$container" --arg cwd "$PWD" \
    --arg session "${MX_ORIGIN_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}" \
    '{target: $target, cwd: $cwd} + (if $session != "" then {session: $session} else {} end)
     + (if $container != "" then {container: $container} else {} end)')
  if answer=$(curl -sf --max-time 3 -H 'Content-Type: application/json' --data "$body" "$hub/api/open" 2>/dev/null) &&
     jq -e '.container or .skipped' <<<"$answer" >/dev/null 2>&1; then
    if skipped=$(jq -er '.skipped // empty' <<<"$answer"); then
      echo "claude-browser: not opened, $skipped" >&2
      exit 0
    fi
    jq -r '"claude-browser: in container \(.container)"' <<<"$answer" >&2
    jq -e '.launch' <<<"$answer" >/dev/null || exit 0
    target="$hub$(jq -r '"\(.view)#\(.id)"' <<<"$answer")"
  fi
fi

config_dir=$(basename "${CLAUDE_CONFIG_DIR:-$HOME/.claude}")
case "$config_dir" in
  .claude)   profile_name="Personal" ;;
  .claude-?*) profile_name="${config_dir#.claude-}" ;;
  *)
    echo "claude-browser: CLAUDE_CONFIG_DIR=$config_dir is not ~/.claude or ~/.claude-<name>, so no Brave profile name follows from it" >&2
    exit 1 ;;
esac

local_state="$HOME/.config/BraveSoftware/Brave-Browser/Local State"
if [[ ! -f "$local_state" ]]; then
  echo "claude-browser: $local_state not found — Brave has never been started on this machine" >&2
  exit 1
fi
profile_dir=$(jq -r --arg n "$profile_name" \
  '.profile.info_cache | to_entries[] | select(.value.name | ascii_downcase == ($n | ascii_downcase)) | .key' "$local_state")
if [[ -z "$profile_dir" ]]; then
  echo "claude-browser: Brave has no profile named '$profile_name' — create one with that name (brave://settings/manageProfile) for the $config_dir account" >&2
  exit 1
fi

setsid -f systemd-run --user --scope --quiet --collect --unit="claude-browser-$$" \
  brave --profile-directory="$profile_dir" "$target" >/dev/null 2>&1
