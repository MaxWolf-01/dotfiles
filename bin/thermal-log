#!/usr/bin/env bash
# Sample temperatures, fan speeds, CPU power caps and load into a daily CSV.
#
# Exists to answer "why did it die?" after the fact. A hard power cut leaves
# nothing in the journal, so these samples are the only record of what the
# machine was doing in its last seconds. Each line is fsynced for that reason —
# without it the tail of the file dies in the page cache along with everything
# else.
#
# Logs the two ASUS EC power rails as well (see asus-power-cap): a profile
# switch can silently drop the cap, and that shows up here as the rails moving.
#
# Usage:   thermal-log [interval-seconds]     default 5
# Output:  ~/.local/state/thermal-log/YYYY-MM-DD.csv, pruned after 14 days
# Read it: column -s, -t ~/.local/state/thermal-log/$(date +%F).csv | less -S

set -uo pipefail

INTERVAL=${1:-5}
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/thermal-log"
KEEP_DAYS=14
HEADER="time,pkg_c,cpu_c,board_c,cpu_rpm,gpu_rpm,mhz_max,load1,profile,spl_w,sppt_w,ac,bat_pct,bat_w"

ATTRS=/sys/class/firmware-attributes/asus-armoury/attributes

main() {
    mkdir -p "$LOGDIR" || { echo "thermal-log: cannot create $LOGDIR" >&2; exit 1; }
    find "$LOGDIR" -name '*.csv' -mtime "+$KEEP_DAYS" -delete
    resolve_sensors
    while :; do
        write_sample
        sleep "$INTERVAL"
    done
}

write_sample() {
    local file="$LOGDIR/$(date +%F).csv"
    [ -f "$file" ] || echo "$HEADER" > "$file"
    row >> "$file"
    sync --data "$file"
}

row() {
    printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
        "$(date +'%F %T')" \
        "$(millideg "$ZONE_PKG")" \
        "$(millideg "$ZONE_CPU")" \
        "$(millideg "$ZONE_BOARD")" \
        "$(rd "$FAN_CPU")" \
        "$(rd "$FAN_GPU")" \
        "$(cpu_mhz_max)" \
        "$(load1)" \
        "$(rd /sys/firmware/acpi/platform_profile)" \
        "$(rd $ATTRS/ppt_pl1_spl/current_value)" \
        "$(rd $ATTRS/ppt_pl2_sppt/current_value)" \
        "$(rd "$AC_ONLINE")" \
        "$(rd /sys/class/power_supply/BAT0/capacity)" \
        "$(microwatts /sys/class/power_supply/BAT0/power_now)"
}

# Zone and hwmon numbering is not stable across boots, so match on the names.
resolve_sensors() {
    ZONE_PKG=$(zone_by_type x86_pkg_temp)
    ZONE_CPU=$(zone_by_type TCPU)
    ZONE_BOARD=$(zone_by_type acpitz)
    AC_ONLINE=$(mains_online)

    local asus
    asus=$(hwmon_by_name asus)
    FAN_CPU=${asus:+$asus/fan1_input}
    FAN_GPU=${asus:+$asus/fan2_input}
}

zone_by_type() {
    local zone
    for zone in /sys/class/thermal/thermal_zone*; do
        [ "$(rd "$zone/type")" = "$1" ] && { printf '%s' "$zone/temp"; return; }
    done
}

hwmon_by_name() {
    local mon
    for mon in /sys/class/hwmon/hwmon*; do
        [ "$(rd "$mon/name")" = "$1" ] && { printf '%s' "$mon"; return; }
    done
}

mains_online() {
    local supply
    for supply in /sys/class/power_supply/*; do
        [ "$(rd "$supply/type")" = Mains ] && { printf '%s' "$supply/online"; return; }
    done
}

millideg() {
    local raw
    raw=$(rd "${1:-}")
    [ -n "$raw" ] && printf '%d' "$((raw / 1000))"
}

microwatts() {
    local raw
    raw=$(rd "${1:-}")
    [ -n "$raw" ] && awk -v uw="$raw" 'BEGIN { printf "%.1f", uw / 1000000 }'
}

cpu_mhz_max() {
    awk '/^cpu MHz/ { if ($4 > peak) peak = $4 } END { printf "%d", peak }' /proc/cpuinfo
}

load1() {
    local one rest
    read -r one rest < /proc/loadavg
    printf '%s' "$one"
}

# Never fail on a sensor that vanished — a missing reading is an empty field,
# not a dead logger.
rd() {
    local value=""
    [ -n "${1:-}" ] && [ -r "$1" ] && read -r value < "$1"
    printf '%s' "$value"
}

main "$@"
