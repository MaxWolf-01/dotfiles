#!/usr/bin/env bash
# Switch which Claude account every claude started on zephylux runs on.
#
# With no switch, each profile (~/.claude, ~/.claude-<name>) runs on its own
# /login. `claude-account <account>` puts every claude started from then on, in
# any profile and from any launcher (a shell, the hub, a tmux-save restore), on
# that account's setup-token, from secrets/creds/env/claude-<account>.env.
# Sessions already running keep the login they started on. The scheduled units
# that run claude (claude-ping, the retros) are never switched.
#
# The switch is the account's name in ~/.config/claude-account, which the
# wrapper (nix/home/claude-token.sh) reads at every start. pc's wrapper ignores
# it: there every profile always runs on its own account's token.
#
# Usage:
#   claude-account             print which account is in force
#   claude-account <account>   switch to it (personal, helferline, ...)
#   claude-account off         back to each profile's own /login
set -uo pipefail

state="$HOME/.config/claude-account"
creds="$HOME/.dotfiles/secrets/creds/env"

usage() { sed -n '2,/^set -uo/p' "${BASH_SOURCE[0]}" | sed 's/^# \?//;$d'; }
die() { echo "claude-account: $1" >&2; exit 2; }

case ${1:-} in
    -h|--help) usage; exit 0 ;;
    -*) die "unknown argument: $1" ;;
    "")
        if [ -s "$state" ]; then
            read -r account <"$state"
            echo "$account (every profile on its token)"
        else
            echo "off (each profile on its own /login)"
        fi
        exit 0 ;;
    off)
        rm -f "$state"
        echo "off: claude started from now on runs on its profile's own /login"
        exit 0 ;;
esac

[ $# -eq 1 ] || die "takes one account, got: $*"
account=$1
file="$creds/claude-$account.env"
[ -f "$file" ] || die "no account '$account': $file does not exist (accounts: $(cd "$creds" 2>/dev/null && ls claude-*.env 2>/dev/null | sed 's/^claude-//; s/\.env$//' | tr '\n' ' '))"
# sops leaves an empty value as plain text, so an unminted token shows without decrypting.
grep -q '^CLAUDE_CODE_OAUTH_TOKEN=ENC\[' "$file" \
    || die "'$account' holds no token yet: mint one with \`claude setup-token\` and write it with \`sops $file\`"

mkdir -p "$(dirname "$state")"
echo "$account" >"$state"
echo "$account: claude started from now on runs on its token, in every profile; running sessions keep theirs"
