#!/usr/bin/env bash
# bt-audio-fix — recover a Bluetooth headset stuck without A2DP (high-quality audio).
#
# Symptom: earbuds/headphones connect but there's no sound, or only telephony-quality
# mono (GNOME sound output shows "Handsfree"). Cause: bluetoothd holds a stale AVDTP
# session and answers every A2DP connect with "Device or resource busy" — typically
# after switching between two Bluetooth audio devices or an unclean transport death.
# An adapter power cycle does NOT clear this; only restarting bluetoothd does.
#
# Needs passwordless 'systemctl restart bluetooth' — install via: ./setup bt_sudoers
set -euo pipefail

a2dp_active() {
  pw-dump 2>/dev/null | jq -e \
    '[.[] | select(.info.props."api.bluez5.profile" // "" | test("^(a2dp|bap)-sink$"))] | length > 0' \
    >/dev/null
}

mapfile -t connected < <(bluetoothctl devices Connected | awk '{print $2}')
audio_macs=()
for mac in "${connected[@]}"; do
  if bluetoothctl info "$mac" | grep -q 'UUID: Audio Sink'; then
    audio_macs+=("$mac")
  fi
done

if [ ${#audio_macs[@]} -eq 0 ]; then
  echo "No connected Bluetooth audio device. Connect the headset first (even if it gets no sound), then re-run." >&2
  exit 1
fi

if a2dp_active; then
  echo "A2DP already active — the audio path is fine. If sound is still wrong, check the selected output in sound settings."
  exit 0
fi

echo "Audio device(s) connected without A2DP: ${audio_macs[*]}"
echo "Restarting bluetoothd to clear stale audio session state..."

for mac in "${audio_macs[@]}"; do
  bluetoothctl disconnect "$mac" >/dev/null 2>&1 || true
done

if ! sudo -n /usr/bin/systemctl restart bluetooth 2>/dev/null; then
  echo "Passwordless restart not configured. Run: ~/.dotfiles/setup bt_sudoers" >&2
  echo "(or manually: sudo systemctl restart bluetooth, then re-run this script)" >&2
  exit 1
fi

sleep 2
bluetoothctl power on >/dev/null

# Devices usually auto-reconnect after the restart; a manual connect can race that
# and report "busy" — 'Connected: yes' counts as success either way.
for mac in "${audio_macs[@]}"; do
  for _ in $(seq 1 10); do
    bluetoothctl connect "$mac" >/dev/null 2>&1 || true
    if bluetoothctl info "$mac" | grep -q 'Connected: yes'; then
      break
    fi
    sleep 2
  done
done

for _ in $(seq 1 10); do
  if a2dp_active; then
    codec=$(pw-dump | jq -r \
      '[.[] | select(.info.props."api.bluez5.profile" // "" | test("^(a2dp|bap)-sink$"))][0].info.props."api.bluez5.codec"')
    echo "OK: A2DP active (codec: ${codec})."
    exit 0
  fi
  sleep 1
done

echo "FAILED: device reconnected but A2DP still won't come up." >&2
echo "Most likely another host (your phone?) is holding the earbuds' audio stream:" >&2
echo "disable Bluetooth on the phone or unpair the buds there, then re-run." >&2
exit 1
