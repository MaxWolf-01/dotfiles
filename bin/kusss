#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro", "requests", "beautifulsoup4", "lxml"]
# ///
"""Read JKU's KUSSS: the course catalogue and Studienhandbuch without logging in, and max's own registrations signed in.

KUSSS (kusss.jku.at) publishes the whole course catalogue anonymously: the curriculum tree,
each course's classes, every LVA (group) with dates, rooms, lecturer, seats and today's
registration counts. This tool turns those pages into JSON, answers "is there a seat" for
given course classes, and can watch full courses for a freed seat.

`mine` signs in as max through JKU's Shibboleth login with the username and password in the
sops file `jku` (JKU__USERNAME, JKU__PASSWORD); started without them, it re-runs itself under
`with-secrets jku`. It keeps no session on disk. It reads, and nothing it sends can act: besides
the sign-in's form posts, its requests are GETs of the pages it lists in READS, with exactly the
parameters listed there; anything else is refused before it goes out.

Vocabulary (KUSSS German → what it is):
- Kursklasse / courseclass: one course as it appears in a curriculum (e.g. "UE Reinforcement Learning");
  its numeric id is stable across semesters and is what `seats`/`watch` take.
- LVA: one concrete group of a course class, numbered like 344.125 (a letter may appear: 344.W01).
- Mögl. / bisher / zugeteilt: seats, registrations still pending allocation, registrations already
  assigned. Direktzuteilung courses assign instantly (all in "zugeteilt"); Vorrangzahl and
  Reihenfolge courses hold everything in "bisher" until the window closes. Fill = bisher + zugeteilt.
- Art: Präsenz or Fernstudium (distance). Hybrid groups are Präsenz with "distance" in their info text.

JSON schema (scrape):

    [{"grpCode": "str", "type": "UE|VL|VO|KV|KS|PR|SE|VU", "name": "str", "ects": 1.5, "subject": "str",
      "courseclasses": [{"courseclass": "str", "cc_name": "str", "n_current_term": 0,
        "registration_window": "str|null", "allocation": "str|null", "waitlist": 0,
        "lvas": [{"lva_nr": "344.125", "coursegroupid": "str|null", "course_id": "str|null",
          "first_day": "str", "first_date": "str", "first_time": "str", "lecturer": "str",
          "capacity": "str", "registered": "str", "assigned": "str", "art": "str", "info": "str",
          "language": "str|null", "institute": "str|null",
          "dates": [{"day": "Do.", "date": "08.10.26", "time": "15:30 – 16:15", "room": "str"}]}]}]}]

JSON schema (seats --json):

    [{"courseclass": "str", "course": "str", "allocation": "str|null", "lva": "str", "lecturer": "str",
      "art": "str", "capacity": 0, "pending": 0, "assigned": 0, "free": true}]

Examples:

    kusss scrape --curriculum 376 --out kusss.json
    kusss handbook --curriculum 1174 --out studienhandbuch.json --extra 536DASCICSV26
    kusss seats 37357 37359
    kusss seats 46721 --json | jq '.[] | select(.free)'
    kusss watch 37357 37359 --once --until 2026-10-08 --run-log kusss-watch
    kusss check --curriculum 376
    kusss mine | jq '.courses[] | {lva_nr, title, group, status, deregistration_deadline}'
    kusss mine --semester 2026S | jq '.exams[] | select(.status == "registered")'
"""

from __future__ import annotations

import json as jsonlib
import os
import re
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass, field
from datetime import date, datetime
from pathlib import Path
from typing import Annotated
from urllib.parse import urljoin, urlparse

import requests
import tyro
from bs4 import BeautifulSoup, Tag
from tyro.extras import SubcommandApp

KUSSS = "https://kusss.jku.at/kusss/"
HANDBOOK = "https://studienhandbuch.jku.at/"
LVA_NR = re.compile(r"^\d{3}\.[A-Z0-9]\d{2}$")
ALLOCATION = re.compile(r"Zuteilung nach Vorrangzahl|Zuteilung nach Reihenfolge|Direktzuteilung|Zuteilung erfolgt manuell[^.]{0,40}")
TYPES = ("VL", "VO", "UE", "KV", "KS", "PR", "SE", "VU")

S = requests.Session()
S.headers["User-Agent"] = "Mozilla/5.0 (kusss cli; course planning)"

app = SubcommandApp()


def get(url: str) -> BeautifulSoup:
    r = S.get(url, timeout=60)
    r.raise_for_status()
    r.encoding = "utf-8"
    return BeautifulSoup(r.text, "lxml")


def clean(s: str) -> str:
    return re.sub(r"\s+", " ", s.replace("\xa0", " ").replace("(*)", "")).strip()


def norm_time(t: str) -> str:
    """One spelling for '10:15 – 11:45' / '10:15 - 11:45' / non-breaking spaces, so equal slots compare equal."""
    return re.sub(r"\s*[–-]\s*", " – ", clean(t))


# ----------------------------------------------------------------------------- KUSSS pages

def catalogue(curriculum: int) -> list[dict]:
    """Curriculum tree → one slot per (type, name) with grpCode, ECTS and the subject path."""
    soup = get(KUSSS + f"coursecatalogue-get-currbranches-or-segments.action?set.listsubjects-overview.treeView.expandAll=true&curId={curriculum}")
    slots, path = [], []
    for tr in soup.select("table tr"):
        tds = tr.find_all("td")
        if len(tds) < 3:
            continue
        text = tds[1].get_text(" ", strip=True)
        depth = len(re.match(r"^[. ]*", text).group(0).replace(" ", "")) // 8
        label = text.lstrip(". ").strip()
        ects = tds[2].get_text(strip=True).replace(",", ".")
        link = tds[1].find("a", href=re.compile("grpCode="))
        if link:
            m = re.match(r"^(" + "|".join(TYPES) + r")\s+(.*)$", label)
            if not m:  # e.g. the semester selector row, which also carries a grpCode link
                continue
            slots.append({"grpCode": re.search(r"grpCode=(\d+)", link["href"]).group(1), "type": m.group(1), "name": m.group(2),
                          "ects": float(ects) if ects else None, "subject": " / ".join(path[:depth])})
        elif label:
            path = path[:depth] + [label]
    return slots


def courseclasses(curriculum: int, grp: str) -> list[dict]:
    """A grpCode page lists the same course class once per curriculum version; dedupe by id."""
    soup = get(KUSSS + f"coursecatalogue-get-courseclasses.action?curId={curriculum}&segId=1&grpCode={grp}")
    out: dict[str, dict] = {}
    for tr in soup.select("table tr"):
        a = tr.find("a", href=re.compile("courseclass="))
        if not a:
            continue
        tds = tr.find_all("td")
        n = tds[2].get_text(strip=True) if len(tds) > 2 else ""
        cc = re.search(r"courseclass=(\d+)", a["href"]).group(1)
        cur = out.setdefault(cc, {"courseclass": cc, "cc_name": a.get_text(strip=True), "n_current_term": 0})
        cur["n_current_term"] = max(cur["n_current_term"], int(n) if n.isdigit() else 0)
    return list(out.values())


def lva_rows(courseclass: str) -> dict:
    """The registration page of a course class: window, allocation mode, and one row per LVA.

    Rows without dates ('Keine Termine gefunden', 'Blocktermin') merge the three date columns into one;
    info rows (Abhaltungsinformation / Zusatzinfo / Untertitel) follow their LVA row.
    """
    soup = get(KUSSS + f"lvaregistrationlist.action?courseclass={courseclass}")
    head = clean(soup.get_text(" ", strip=True))
    title = re.search(r"((?:" + "|".join(TYPES) + r")\s*:\s*.+?)\s*\[", head)
    reg = re.search(r"Anmeldung vom ([^|]+?)\s*\|", head)
    wl = re.search(r"Wartelistenplätze:\s*(\d+)", head)
    alloc = ALLOCATION.search(head)
    rows = soup.select("table tr")
    lvas = []
    for idx, tr in enumerate(rows):
        tds = [clean(td.get_text(" ", strip=True)) for td in tr.find_all("td")]
        if len(tds) < 7 or not LVA_NR.match(tds[0]):
            continue
        if len(tds) < 9:
            tds = tds[:2] + [tds[2], "", ""] + tds[3:]
        a = tr.find("a", href=re.compile(r"selectcoursegroup\.action\?coursegroupid=\d+"))
        grp = re.search(r"coursegroupid=(\d+)", a["href"]).group(1) if a else None
        det = re.search(r"showdetails=(\d+)", a["href"]) if a else None
        info = []
        for nxt in rows[idx + 1: idx + 4]:
            if len(nxt.find_all("td")) >= 7:
                break
            t = clean(nxt.get_text(" ", strip=True))
            if re.search(r"Abhaltungsinformation|Zusatzinfo|Untertitel", t):
                info.append(t)
        lvas.append({"lva_nr": tds[0], "coursegroupid": grp, "course_id": det.group(1) if det else None,
                     "first_day": tds[2], "first_date": tds[3], "first_time": norm_time(tds[4]) if tds[4] else "",
                     "lecturer": tds[5].strip(" ,"), "capacity": tds[6], "registered": tds[7], "assigned": tds[8],
                     "art": tds[9] if len(tds) > 9 else "", "info": " ".join(dict.fromkeys(info))})
    return {"course": re.sub(r"\s*:\s*", " ", clean(title.group(1)), count=1) if title else None, "registration_window": clean(reg.group(1)) if reg else None,
            "allocation": alloc.group(0) if alloc else None, "waitlist": int(wl.group(1)) if wl else None, "lvas": lvas}


def lva_dates(lva: dict, courseclass: str) -> dict:
    """All dates/rooms of one LVA plus language and institute. LVAs without a detail id have no dates."""
    if not lva.get("course_id"):
        return {"dates": [], "language": None, "institute": None}
    try:
        soup = get(KUSSS + f"selectcoursegroup.action?coursegroupid={lva['coursegroupid']}&showdetails={lva['course_id']}&courseclassid={courseclass}")
    except requests.RequestException as e:
        print(f"detail failed {lva['lva_nr']}: {e}", file=sys.stderr)
        return {"dates": [], "language": None, "institute": None}
    txt = soup.get_text("\n", strip=True)
    lang = re.search(r"Abhaltungs-Sprache:\s*\n?\s*([^\n]+)", txt)
    inst = re.search(r"Institut:\s*\n?\s*([^\n]+)", txt)
    dates = []
    for tr in soup.select("table tr"):
        tds = [clean(td.get_text(" ", strip=True)) for td in tr.find_all("td")]
        if len(tds) == 4 and re.match(r"\d\d\.\d\d\.\d\d", tds[1]):
            dates.append({"day": tds[0], "date": tds[1], "time": norm_time(tds[2]), "room": tds[3]})
    return {"dates": dates, "language": clean(lang.group(1)) if lang else None, "institute": clean(inst.group(1)) if inst else None}


def fill(l: dict) -> tuple[int, int, int] | None:
    """(seats, pending, assigned), or None when a count is not a number: a markup change, not an empty course."""
    vals = [l[k] for k in ("capacity", "registered", "assigned")]
    if not all(v.isdigit() for v in vals):
        return None
    return tuple(int(v) for v in vals)  # type: ignore[return-value]


# ----------------------------------------------------------------------------- subcommands

@dataclass
class Scrape:
    curriculum: int = 376
    """KUSSS curriculum id (curId in the catalogue URL). 376 = BSc Artificial Intelligence."""
    out: Path = Path("kusss.json")
    """Where to write the JSON."""
    workers: int = 8
    """Parallel requests."""


@app.command(name="scrape")
def scrape(args: Scrape) -> None:
    """Dump the whole curriculum: slots, course classes, LVAs, dates. A few minutes for a full curriculum."""
    slots = catalogue(args.curriculum)
    print(f"{len(slots)} slots", file=sys.stderr)
    with ThreadPoolExecutor(args.workers) as ex:
        for slot, ccs in zip(slots, ex.map(lambda s: courseclasses(args.curriculum, s["grpCode"]), slots)):
            slot["courseclasses"] = ccs
    jobs = [cc for s in slots for cc in s["courseclasses"]]
    print(f"{len(jobs)} course classes", file=sys.stderr)
    with ThreadPoolExecutor(args.workers) as ex:
        for cc, info in zip(jobs, ex.map(lambda c: lva_rows(c["courseclass"]), jobs)):
            cc.update({k: v for k, v in info.items() if k != "course"})
    djobs = [(cc, l) for cc in jobs for l in cc["lvas"]]
    print(f"{len(djobs)} LVAs", file=sys.stderr)
    with ThreadPoolExecutor(args.workers) as ex:
        for (cc, l), d in zip(djobs, ex.map(lambda j: lva_dates(j[1], j[0]["courseclass"]), djobs)):
            l.update(d)
    args.out.write_text(jsonlib.dumps(slots, indent=1, ensure_ascii=False))
    print(f"wrote {args.out}", file=sys.stderr)


@dataclass
class Handbook:
    curriculum: int = 1174
    """Studienhandbuch curriculum id (studienhandbuch.jku.at/curr/<id>). 1174 = BSc AI, version 2025W."""
    out: Path = Path("studienhandbuch.json")
    """Where to write the JSON."""
    extra: list[str] = field(default_factory=list)
    """Course codes (klaId, e.g. 536DASCICSV26) not in the curriculum listing but referenced by KUSSS."""
    workers: int = 8
    """Parallel requests."""


HB_FIELDS = ["Beurteilungskriterien", "Lehrmethoden", "Abhaltungssprache", "Literatur", "Lehrinhalte wechselnd?",
             "Anmeldevoraussetzungen", "Äquivalenzen", "Teilungsziffer", "Zuteilungsverfahren", "Quellcurriculum",
             "Lehrinhalte", "Sonstige Informationen", "Frühere Varianten", "Ist gemeinsam abzuhalten mit", "Studienfach", "Lernergebnisse"]


def handbook_course(item: dict) -> dict:
    d = dict(item)
    try:
        soup = get(HANDBOOK + item["id"])
    except requests.RequestException as e:
        print(f"failed {item['id']}: {e}", file=sys.stderr)
        return d
    txt = soup.get_text("\n", strip=True)
    h = soup.find("h3") or soup.find("h2")
    m = re.match(r"\[\s*(\S+)\s*\]\s*(" + "|".join(TYPES) + r")\s*(.*)", clean(h.get_text(" ", strip=True)) if h else "")
    if m:
        d["code"], d["type"], d["name"] = m.group(1), m.group(2), m.group(3).strip()
    t = next((t for t in soup.find_all("table") if t.find("tr") and "Workload" in [clean(x.get_text()) for x in t.find("tr").find_all(["th", "td"])]), None)
    if t and len(t.find_all("tr")) >= 2:
        rows = t.find_all("tr")
        d["meta"] = dict(zip([clean(x.get_text()) for x in rows[0].find_all(["th", "td"])], [clean(x.get_text()) for x in rows[1].find_all(["th", "td"])]))
    lr = {}
    for key in ["Kompetenzen", "Fertigkeiten", "Kenntnisse"]:
        cell = soup.find(lambda tag, k=key: tag.name in ("strong", "small", "b") and tag.get_text(strip=True) == k)
        if cell and cell.find_parent("td") and cell.find_parent("td").find_next("td"):
            lr[key] = clean(cell.find_parent("td").find_next("td").get_text(" ", strip=True))
    d["learning_outcomes"] = lr
    stop = "|".join(map(re.escape, HB_FIELDS + ["Präsenzlehrveranstaltung", "Fernlehrveranstaltung", "Version v"]))
    for f in HB_FIELDS:
        m = re.search(r"\n" + re.escape(f) + r"\n(.*?)(?=\n(?:" + stop + r")\n|\Z)", txt, re.S)
        if m:
            d[f] = clean(m.group(1)).replace("Version v1.0.25 Impressum", "").strip()
    return d


@app.command(name="handbook")
def handbook(args: Handbook) -> None:
    """Dump every course page of a Studienhandbuch curriculum: competences, assessment, allocation, prerequisites."""
    soup = get(HANDBOOK + f"curr/{args.curriculum}")
    items, path = [], []
    for tr in soup.select("table tr"):
        tds = tr.find_all("td")
        if len(tds) < 2:
            continue
        text = tds[0].get_text(" ", strip=True)
        depth = len(re.match(r"^[. ]*", text).group(0).replace(" ", "")) // 8
        label = clean(text.lstrip(". "))
        a = tds[0].find("a", href=re.compile(r"(\d{6})$"))
        if a:
            items.append({"id": re.search(r"(\d{6})$", a["href"]).group(1), "label": label, "subject": " / ".join(path[:depth])})
        elif label:
            path = path[:depth] + [label]
    items += [{"id": f"detail.php?lang=de&klaId={k}", "label": k, "subject": "?"} for k in args.extra]
    print(f"{len(items)} courses", file=sys.stderr)
    with ThreadPoolExecutor(args.workers) as ex:
        data = list(ex.map(handbook_course, items))
    args.out.write_text(jsonlib.dumps(data, indent=1, ensure_ascii=False))
    print(f"wrote {args.out}", file=sys.stderr)


@dataclass
class Seats:
    courseclasses: Annotated[list[str], tyro.conf.Positional]
    """KUSSS course class ids (the courseclass= number in a registration URL)."""
    json: bool = False
    """Emit JSON to stdout. Pipe to jq for filtering."""


def seat_rows(courseclasses: list[str]) -> list[dict]:
    out = []
    for cc in courseclasses:
        info = lva_rows(cc)
        for l in info["lvas"]:
            f = fill(l)
            if f is None:
                print(f"{cc} {l['lva_nr']}: counts not numeric ({l['capacity']!r}, {l['registered']!r}, {l['assigned']!r})", file=sys.stderr)
                continue
            cap, pend, ass = f
            out.append({"courseclass": cc, "course": info["course"], "allocation": info["allocation"], "lva": l["lva_nr"],
                        "lecturer": l["lecturer"], "art": l["art"], "capacity": cap, "pending": pend, "assigned": ass,
                        "free": bool(cap) and pend + ass < cap})
    return out


@app.command(name="seats")
def seats(args: Seats) -> None:
    """Live fill of every LVA in the given course classes (pending + assigned against seats)."""
    rows = seat_rows(args.courseclasses)
    if args.json:
        print(jsonlib.dumps(rows, indent=1, ensure_ascii=False))
        return
    for cc in dict.fromkeys(r["courseclass"] for r in rows):
        rs = [r for r in rows if r["courseclass"] == cc]
        print(f"\n{rs[0]['course']}  [{cc}]  {rs[0]['allocation'] or '?'}")
        for r in rs:
            print(f"  {r['lva']}  {r['pending'] + r['assigned']:>4}/{r['capacity']:<4} {'free' if r['free'] else 'full'}  {r['art']:<11} {r['lecturer'][:40]}")


@dataclass
class Watch:
    courseclasses: Annotated[list[str], tyro.conf.Positional]
    """Course classes to watch, typically ones that are full."""
    once: bool = False
    """Check once and exit (for a systemd timer). Default loops with --interval."""
    interval: int = 180
    """Seconds between checks when looping."""
    until: str = ""
    """ISO date; after it, record a skip and exit 0 without checking (course start, when deregistration ends)."""
    notify: bool = True
    """Desktop notification (notify-send) when a seat opens."""
    alert: bool = False
    """Also email via alert-send (the unattended alert channel) when a seat opens."""
    run_log: str = ""
    """Unit name for bin/run-log: every pass records ok / skip / fail there with the fills as stats. Empty disables."""
    state: Path = Path.home() / ".local/state/kusss/watch.json"
    """Remembers what was already announced, so a free seat is announced once, then every 30 min while it stays free."""


def record(args: Watch, outcome: str, reason: str | None, stats: dict) -> None:
    if not args.run_log:
        return
    cmd = ["run-log", args.run_log, outcome, "--stats", jsonlib.dumps(stats)]
    if reason:
        cmd += ["--reason", reason]
    subprocess.run(cmd, check=False)


def announce(title: str, body: str, args: Watch) -> list[str]:
    """Returns the channels that failed, so the run log can say a seat opened and nobody was told."""
    failed = []
    if args.notify and subprocess.run(["notify-send", "-u", "critical", title, body], check=False).returncode:
        failed.append("notify-send")
    if args.alert and subprocess.run(["alert-send", title], input=body.encode(), check=False).returncode:
        failed.append("alert-send")
    return failed


def watch_once(args: Watch) -> None:
    """One pass over all watched course classes; records the outcome via run-log."""
    args.state.parent.mkdir(parents=True, exist_ok=True)
    st = jsonlib.loads(args.state.read_text()) if args.state.exists() else {}
    now = time.time()
    fills: dict[str, str] = {}
    errors: list[str] = []
    free_seats: list[str] = []
    for cc in args.courseclasses:
        try:
            info = lva_rows(cc)
        except requests.RequestException as e:
            errors.append(f"{cc}: {e}")
            continue
        if not info["lvas"]:
            errors.append(f"{cc}: no LVA rows parsed")
        for l in info["lvas"]:
            f = fill(l)
            if f is None:
                errors.append(f"{cc} {l['lva_nr']}: counts not numeric")
                continue
            cap, pend, ass = f
            free = bool(cap) and pend + ass < cap
            key = f"{cc}/{l['lva_nr']}"
            fills[key] = f"{pend + ass}/{cap}"
            print(f"{datetime.now():%Y-%m-%d %H:%M} {l['lva_nr']} {info['course']}: {pend + ass}/{cap}{'  FREE SEAT' if free else ''}")
            if free:
                free_seats.append(key)
                if now - st.get(key, 0) > 1800:
                    failed = announce(f"KUSSS seat open: {info['course']}", f"{l['lva_nr']} {pend + ass}/{cap}\n{KUSSS}lvaregistrationlist.action?courseclass={cc}", args)
                    errors += [f"{key}: {ch} failed" for ch in failed]
                    st[key] = now
            else:
                st.pop(key, None)
    args.state.write_text(jsonlib.dumps(st))
    stats = {"fills": fills, "free": free_seats}
    if errors:
        print("\n".join(errors), file=sys.stderr)
        record(args, "fail", "; ".join(errors)[:500], stats)
    else:
        record(args, "ok", None, stats)


@app.command(name="watch")
def watch(args: Watch) -> None:
    """Announce when a full course gets a free seat (someone deregistered; Direktzuteilung seats go to the first click)."""
    if args.until and date.today() > date.fromisoformat(args.until):
        print(f"past {args.until}, nothing to watch", file=sys.stderr)
        record(args, "skip", f"past --until {args.until}", {})
        return
    if args.once:
        watch_once(args)
        return
    while True:
        watch_once(args)
        time.sleep(args.interval)


@dataclass
class Check:
    curriculum: int = 376
    """KUSSS curriculum id."""
    sample: int = 12
    """How many course classes to sample for row-shape checks."""


@app.command(name="check")
def check(args: Check) -> None:
    """Sanity-check the parser against live pages and report what looks new: rows the parser skips,
    LVA numbers with unseen shapes, allocation modes or Art values not seen before, empty fields.
    Run this before trusting a scrape at the start of a new registration round.
    """
    slots = catalogue(args.curriculum)
    problems = []
    if len(slots) < 50:
        problems.append(f"only {len(slots)} slots in the curriculum tree; the tree markup may have changed")
    ccs = []
    for s in slots[:: max(1, len(slots) // args.sample)]:
        ccs += [c["courseclass"] for c in courseclasses(args.curriculum, s["grpCode"]) if c["n_current_term"]]
    ccs = ccs[: args.sample]
    known_art, known_alloc = {"Präsenz", "Fernstudium", "MuSSS", "MMJUS", "SBP", ""}, set()
    for cc in ccs:
        soup = get(KUSSS + f"lvaregistrationlist.action?courseclass={cc}")
        info = lva_rows(cc)
        if info["allocation"]:
            known_alloc.add(info["allocation"])
        else:
            problems.append(f"{cc}: no allocation mode found in page text")
        for tr in soup.select("table tr"):
            tds = [clean(td.get_text(" ", strip=True)) for td in tr.find_all("td")]
            if len(tds) >= 7 and re.match(r"^\d{3}\.", tds[0]) and not LVA_NR.match(tds[0]):
                problems.append(f"{cc}: LVA number with unseen shape: {tds[0]!r}")
        for l in info["lvas"]:
            if l["art"] not in known_art:
                problems.append(f"{cc} {l['lva_nr']}: unseen Art value {l['art']!r}")
            if not l["capacity"].isdigit():
                problems.append(f"{cc} {l['lva_nr']}: capacity not numeric: {l['capacity']!r}")
            if re.search(r"\d{1,2}[:.]\d{2}\s*-\s*\d{1,2}[:.]\d{2}", l["info"]) and not l["course_id"]:
                pass  # schedule only in the info text: expected for date-less groups, the consumer parses it
    print(f"sampled {len(ccs)} course classes; allocation modes seen: {sorted(known_alloc)}")
    if problems:
        print("\n".join("! " + p for p in problems))
        sys.exit(1)
    print("no parser surprises")


# ----------------------------------------------------------------------------- signed in as max

SECRETS = "jku"
ME = "https://www.kusss.jku.at/kusss/"  # the sign-in lands on www.; its session cookie is not sent to kusss.jku.at
MYJKU = "https://my.jku.at"
IDP_HOST = "shibboleth.im.jku.at"
SEMESTER = r"\d{4}[WS]"
# Every page the signed-in session opens, with the parameters each must carry: name -> pattern its
# value must match. Anything else is refused before the request goes out. KUSSS acts through pages
# of the same kind (results-cancel-assignment.action deregisters from a course, examinationreg.action
# registers for an exam), and select-term.action runs whichever action its reloadAction names.
READS: dict[str, dict[str, str]] = {
    ME + "login.action": {},
    ME + "assignment-results.action": {},
    ME + "select-term.action": {"term": SEMESTER, "reloadAction": r"assignment-results\.action"},
    ME + "szsearchexam.action": {"search": "true", "searchType": "mylvas"},
    ME + "gradeinfo.action": {},
    ME + "outbound/myjku/fee": {},
    MYJKU + "/api2/student/fee": {},
}
# Where the sign-in's forms may post: the JKU login, and the SAML endpoints of KUSSS and myJKU.
SIGN_IN_POSTS = (f"https://{IDP_HOST}/idp/profile/SAML2/", "https://www.kusss.jku.at/Shibboleth.sso/SAML2/POST",
                 MYJKU + "/Shibboleth.sso/SAML2/POST")
DATE = re.compile(r"(\d\d)\.(\d\d)\.(\d{4}|\d\d)(?:\s+(\d\d:\d\d))?")
EXAM_COURSE = re.compile(r"^(.*?)\s*\((\w{6}),(" + SEMESTER + r")\)\s*(.*)$")


class Unreadable(Exception):
    """A page that does not look the way this tool reads it: KUSSS changed, or showed something else."""


class Session:
    """Signed in as max, and able only to read: GETs of READS, and the sign-in's form posts."""

    def __init__(self) -> None:
        self.s = requests.Session()
        self.s.headers["User-Agent"] = "Mozilla/5.0 (kusss cli; read-only)"

    def get(self, url: str, **params: str) -> requests.Response:
        allowed = READS.get(url)
        if allowed is None or set(params) != set(allowed) or not all(re.fullmatch(allowed[k], v) for k, v in params.items()):
            raise ValueError(f"refusing to open {url} with {params}: not a page this tool reads")
        r = self.s.get(url, params=params, timeout=60)
        r.raise_for_status()
        return r

    def soup(self, url: str, **params: str) -> BeautifulSoup:
        """From the bytes: these pages are ISO-8859-1, which BeautifulSoup reads off their meta tag."""
        return BeautifulSoup(self.get(url, **params).content, "lxml")

    def through_login(self, r: requests.Response, username: str, password: str) -> requests.Response:
        """Post the JKU login's forms (local-storage probe, username/password, SAML response) until a page off the login is reached.

        Returns early on the login page when it shows the password form a second time: the credentials were refused.
        """
        password_page = None
        for _ in range(6):
            form = BeautifulSoup(r.text, "lxml").find("form")
            if urlparse(r.url).hostname != IDP_HOST or not form:
                return r
            target = urljoin(r.url, form.get("action", ""))
            if not target.startswith(SIGN_IN_POSTS):
                raise ValueError(f"refusing to post the sign-in form to {target}: not JKU's login or a SAML endpoint")
            data = {i["name"]: i.get("value", "") for i in form.find_all("input") if i.get("name")}
            if "j_username" in data:
                if r.url == password_page:
                    return r
                password_page = r.url
                data |= {"j_username": username, "j_password": password}
            data["_eventId_proceed"] = ""
            r = self.s.post(target, data=data, timeout=60)
        return r

    def sign_in(self, username: str, password: str) -> None:
        r = self.through_login(self.get(ME + "login.action"), username, password)
        if "logout-confirm.action" not in r.text:
            error = BeautifulSoup(r.text, "lxml").select_one(".output--failure, .form-error, .alert-danger")
            why = clean(error.get_text(" ")) if error else f"the sign-in ended on {r.url}, not on a KUSSS page"
            sys.exit(f"kusss: sign-in failed: {why}\n"
                     f"Check the username and password in the sops file `{SECRETS}` (sops-editor), and that JKU's login works in a browser.")

    def fee(self, username: str, password: str) -> dict:
        """myJKU's answer for the fee: its sign-in, which KUSSS's Studienbeitrag link starts, then its API."""
        r = self.through_login(self.get(ME + "outbound/myjku/fee"), username, password)
        if not r.url.startswith(MYJKU + "/"):
            raise Unreadable(f"the myJKU sign-in ended on {r.url}")
        return self.get(MYJKU + "/api2/student/fee").json()


def connect() -> tuple[Session, tuple[str, str]]:
    """Sign in with the credentials from the environment, re-running under with-secrets when they are missing."""
    user, password = os.environ.get("JKU__USERNAME"), os.environ.get("JKU__PASSWORD")
    if not (user and password):
        if os.environ.get("KUSSS_CLI_REEXEC"):
            sys.exit(f"kusss: JKU__USERNAME / JKU__PASSWORD missing even under `with-secrets {SECRETS}`; check the sops file `{SECRETS}`")
        os.environ["KUSSS_CLI_REEXEC"] = "1"
        os.execvp("with-secrets", ["with-secrets", SECRETS, sys.argv[0], *sys.argv[1:]])
    k = Session()
    k.sign_in(user, password)
    return k, (user, password)


def iso(text: str) -> str | None:
    """'Do. 15.10.26 09:15' -> '2026-10-15T09:15', '04.02.2027' -> '2027-02-04'; None when the text holds no date."""
    m = DATE.search(text)
    if not m:
        return None
    d, mo, y, t = m.groups()
    return f"{y if len(y) == 4 else '20' + y}-{mo}-{d}" + (f"T{t}" if t else "")


def number(text: str) -> float | None:
    return float(text.replace(",", ".")) if re.fullmatch(r"\d+(,\d+)?", text) else None


def lva_nr(digits: str) -> str:
    return f"{digits[:3]}.{digits[3:]}"


def header_rows(table: Tag) -> list[dict[str, Tag]]:
    """Each row of a KUSSS list as header -> cell. A header keeps its words only: 'ECTS*' is 'ECTS', 'Warte- bonus**' 'Warte-bonus'.
    Rows that span the table ('Keine offenen Anmeldungen!') are not rows of it."""
    head = [re.sub(r"[^\w.]+$", "", re.sub(r"-\s+", "-", clean(th.get_text(" ")))) for th in table.find("tr").find_all("th")]
    rows = []
    for tr in table.find_all("tr")[1:]:
        tds = tr.find_all("td", recursive=False)
        if len(tds) == len(head):
            rows.append(dict(zip(head, tds)))
    return rows


def text(cell: Tag | None) -> str:
    return clean(cell.get_text(" ")) if cell else ""


# ----------------------------------------------------------------------------- what the pages say

def shown_semester(soup: BeautifulSoup) -> str:
    h = soup.find("h3", string=re.compile(r"Zugeteilte Lehrveranstaltungen für das Semester"))
    m = re.search(SEMESTER, text(h))
    if not m:
        raise Unreadable("'Meine Anmeldungen' has no 'Zugeteilte Lehrveranstaltungen für das Semester' heading")
    return m.group(0)


def courses(soup: BeautifulSoup) -> list[dict]:
    """'Meine Anmeldungen': the courses under 'Angemeldete' (registered, not yet allocated) and 'Zugeteilte Lehrveranstaltungen'."""
    out = []
    for h in soup.find_all("h3", string=re.compile(r"(Angemeldete|Zugeteilte) Lehrveranstaltungen für das Semester")):
        pending = text(h).startswith("Angemeldete")
        for row in header_rows(h.find_next("table")):
            title = row["Titel"]
            link = title.find("a")
            name = text(link) if link else text(title)
            rest = text(title).removeprefix(name).strip()
            cc = re.search(r"courseclass=(\d+)", link.get("href", "")) if link else None
            act = row.get("Abmelden") or row.get("Anmeldung löschen")
            out.append({
                "lva_nr": text(row.get("LVA-Nr.")) or None,
                "type": text(row.get("Typ")),
                "title": name,
                "group": re.sub(r"^\((.*)\)$", r"\1", rest) or None,
                "lecturers": [clean(s) for s in row["LeiterIn"].get_text("\n").split("\n") if clean(s)] if "LeiterIn" in row else [],
                "ects": number(text(row.get("ECTS"))),
                "status": text(row.get("Status")) or ("Angemeldet" if pending else None),
                "since": iso(text(row.get("Zuteilung") or row.get("Anmeldedatum"))),
                "course_class": text(row.get("Klasse")) or None,
                "courseclass": cc.group(1) if cc else None,
                "skz": text(row.get("SKZ")) or None,
                "deregistration_deadline": iso(text(row.get("Abmeldefrist"))),
                "can_deregister": bool(act and act.find(["input", "button"])),
                "registration_deadline": iso(text(row.get("Anmeldeschluss"))),
                "rank": text(row.get("Ränge")) or None,
            })
    return out


def exams(soup: BeautifulSoup) -> list[dict]:
    """The exam page after the search for max's courses: the exams he could register for (form examinationreg.action,
    'Auswahl' a checkbox when he can, '--' when not) and the ones he is registered for (form examinationregunreg.action)."""
    if not soup.find("h3", string=re.compile("Aktuelle Prüfungsanmeldungen")):
        raise Unreadable("the exam page has no 'Aktuelle Prüfungsanmeldungen' heading")
    out = []
    for action, registered in (("examinationreg.action", False), ("examinationregunreg.action", True)):
        form = soup.find("form", action=action)
        if not form:
            continue
        exam = None
        for tr in form.find_all("tr"):
            m = EXAM_COURSE.match(text(tr.find("strong")))
            if m:
                tds = [text(td) for td in tr.find_all("td", recursive=False)]
                day = next((t for t in tds if re.fullmatch(r"\d\d\.\d\d\.\d{4}", t)), "")
                slot = re.search(r"(\d\d:\d\d)\s*-\s*(\d\d:\d\d)\s*Uhr\s*/\s*(.*)", next((t for t in tds if "Uhr" in t), ""))
                exam = {"course": m.group(1), "lva_nr": lva_nr(m.group(2)), "semester": m.group(3), "date": iso(day),
                        "start": f"{iso(day)}T{slot.group(1)}" if slot else None, "end": f"{iso(day)}T{slot.group(2)}" if slot else None,
                        "place": slot.group(3) if slot else None, "capacity": None, "registrations": None,
                        "registration_opens": None, "registration_closes": None, "deregistration_deadline": None,
                        "status": "registered" if registered else "open" if tr.find("input", type="checkbox") else "closed", "notes": []}
                out.append(exam)
            elif exam and "TeilnehmerInnenzahl" in text(tr):
                about = text(tr)
                cap = re.search(r"TeilnehmerInnenzahl:\s*(\d+)", about)
                count = re.search(r"Bisherige Anmeldungen:\s*(\d+)", about)
                window = re.search(r"Anmeldezeitraum:\s*(.*?\d\d:\d\d)\s*-\s*(.*?\d\d:\d\d)", about)
                exam |= {"capacity": int(cap.group(1)) if cap else None, "registrations": int(count.group(1)) if count else None,
                         "registration_opens": iso(window.group(1)) if window else None,
                         "registration_closes": iso(window.group(2)) if window else None,
                         "deregistration_deadline": iso(about.split("Abmeldeschluss:", 1)[1]) if "Abmeldeschluss:" in about else None}
                why = text(tr.find(class_="error_icon"))
                if exam["status"] == "closed" and why:
                    exam["status"] = "outside-window" if "Anmeldezeitraum" in why else "full"
            elif exam and text(tr):
                exam["notes"].append(text(tr))
    return out


def grades(soup: BeautifulSoup) -> list[dict]:
    """'Notenauskunft', all months: each list (provisional, course grades, exams, recognised ones) under its own heading."""
    out = []
    for table in soup.find_all("table"):
        first = table.find("tr")
        if not first or [text(th) for th in first.find_all("th")][:3] != ["Datum", "Titel", "Note"]:
            continue
        kind = text(table.find_previous("h3"))
        for row in header_rows(table):
            m = EXAM_COURSE.match(text(row["Titel"]))
            out.append({"kind": kind, "date": iso(text(row["Datum"])), "title": m.group(1) if m else text(row["Titel"]),
                        "lva_nr": lva_nr(m.group(2)) if m else None, "semester": m.group(3) if m else None,
                        "info": (m.group(4) or None) if m else None, "grade": text(row["Note"]),
                        "course_class": text(row.get("Kurzbez.")) or None, "type": text(row.get("Typ")),
                        "ects": number(text(row.get("ECTS"))), "sws": number(text(row.get("SWSt"))), "skz": text(row.get("SKZ")) or None})
    if not out and "Keine Noten vorhanden" not in soup.get_text():
        raise Unreadable("'Notenauskunft' has neither a grade list nor 'Keine Noten vorhanden'")
    return out


def fee(answer: dict) -> dict:
    return {"semester": answer.get("termId"), "state": answer.get("state"), "paid": answer.get("state") == "PAID",
            "owed": answer.get("obligationToPay"), "amount": answer.get("totalFeeAmount"), "payment_deadline": answer.get("paymentPeriodEnd")}


def read_mine(k: Session, credentials: tuple[str, str], semester: str = "") -> dict:
    """Everything `mine` prints. A part that cannot be read is left empty and listed under "gaps" with the reason."""
    out: dict = {"semester": None, "courses": [], "exams": [], "fee": None, "grades": [], "gaps": []}

    def part(name: str, read):
        try:
            return read()
        except (requests.RequestException, Unreadable) as e:
            out["gaps"].append({"where": name, "reason": str(e)})

    def my_courses() -> tuple[str, list[dict]]:
        soup = k.soup(ME + "assignment-results.action")
        if semester and shown_semester(soup) != semester:
            soup = k.soup(ME + "select-term.action", term=semester, reloadAction="assignment-results.action")
            if shown_semester(soup) != semester:
                raise Unreadable(f"KUSSS still shows {shown_semester(soup)} after switching to {semester}; it may not offer {semester}")
        return shown_semester(soup), courses(soup)

    out["semester"], out["courses"] = part("courses", my_courses) or (semester or None, [])
    out["exams"] = part("exams", lambda: exams(k.soup(ME + "szsearchexam.action", search="true", searchType="mylvas"))) or []
    out["grades"] = part("grades", lambda: grades(k.soup(ME + "gradeinfo.action"))) or []
    out["fee"] = part("fee", lambda: fee(k.fee(*credentials)))
    return out


@dataclass
class Mine:
    semester: str = ""
    """Semester whose courses to read, e.g. 2026S. Empty: the one KUSSS opens on, the current one."""


@app.command(name="mine")
def mine(args: Mine) -> None:
    """Sign in as max and print, as JSON, his courses of a semester, his exams, his grades and the semester fee.

    courses are 'Meine Anmeldungen' for the semester: allocated ones with KUSSS's status ("Zugeteilt"), and ones
    registered but not yet allocated ("Angemeldet"). exams are every exam of his courses KUSSS offers, whatever
    the semester, with his status: registered, open (he can register), full, outside-window, closed (KUSSS gives
    no reason). grades are 'Notenauskunft' over all months. fee is myJKU's answer for the semester it is
    collecting, which may not be --semester; paid is true only when myJKU says PAID.

    Times are KUSSS's local time, as YYYY-MM-DD or YYYY-MM-DDTHH:MM. A part that could not be read is empty and
    listed under gaps; then the command exits 1.

    JSON schema:

        {"semester": "2026W",
         "courses": [{"lva_nr": "344.125", "type": "UE", "title": "str", "group": "str|null", "lecturers": ["str"],
           "ects": 1.5, "status": "Zugeteilt|Angemeldet|...", "since": "time allocated or registered",
           "course_class": "536MLPEREIU20", "courseclass": "46721", "skz": "536", "deregistration_deadline": "time|null",
           "can_deregister": false, "registration_deadline": "time|null", "rank": "str|null"}],
         "exams": [{"course": "str", "lva_nr": "365.074", "semester": "2026W", "date": "2027-02-04", "start": "time",
           "end": "time", "place": "str", "capacity": "int|null (unlimited)", "registrations": 0,
           "registration_opens": "time", "registration_closes": "time", "deregistration_deadline": "time",
           "status": "registered|open|full|outside-window|closed", "notes": ["str"]}],
         "fee": {"semester": "2026W", "state": "PAID|NOT_PAID|...", "paid": true, "owed": false, "amount": 0.0,
           "payment_deadline": "str|null"},
         "grades": [{"kind": "the list's heading", "date": "2026-07-27", "title": "str", "lva_nr": "str|null",
           "semester": "str|null", "info": "str|null", "grade": "sehr gut", "course_class": "str", "type": "UE",
           "ects": 1.5, "sws": 1.0, "skz": "536"}],
         "gaps": [{"where": "courses|exams|grades|fee", "reason": "str"}]}
    """
    if args.semester and not re.fullmatch(SEMESTER, args.semester):
        sys.exit(f"kusss: --semester {args.semester!r} is not a semester like 2026W or 2027S")
    k, credentials = connect()
    out = read_mine(k, credentials, args.semester)
    print(jsonlib.dumps(out, indent=1, ensure_ascii=False))
    for g in out["gaps"]:
        print(f"kusss: {g['where']} could not be read: {g['reason']}", file=sys.stderr)
    sys.exit(1 if out["gaps"] else 0)


if __name__ == "__main__":
    app.cli(description=__doc__, config=(tyro.conf.OmitArgPrefixes,))
