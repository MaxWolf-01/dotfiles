#!/usr/bin/env bash
# Pull the Proton mailbox into ~/data/proton-mail through Proton Mail Bridge,
# then index it for notmuch. Setup and what the mirror does and does not do:
# nix/home/proton-mail.nix.
#
# Every run leaves one line in ~/logs/runs/proton-mail-mirror.jsonl
# (bin/run-log): skip when Bridge is not running, fail when mbsync or notmuch
# fails, ok with the message count and the Maildir's size otherwise.
#
# Usage: proton-mail-mirror
set -uo pipefail
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac

unit=proton-mail-mirror
run_log_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-log"
record() {
    "$run_log_bin" "$unit" "$@" || true
}

# PassCmd in the mbsync config is sops, and a systemd unit does not say where
# the age key lives.
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.local/secrets/age-key.txt}"

if ! systemctl --user is-active --quiet protonmail-bridge; then
    echo "proton-mail-mirror: protonmail-bridge is not running; nothing pulled. Check: systemctl --user status protonmail-bridge" >&2
    record skip --reason "protonmail-bridge is not running"
    exit 0
fi

if ! out=$(mbsync proton 2>&1); then
    printf '%s\n' "$out" >&2
    echo "proton-mail-mirror: mbsync failed. If it cannot log in, Bridge may be logged out: protonmail-bridge --cli, see nix/home/proton-mail.nix" >&2
    record fail --reason "mbsync: $(tail -n 1 <<<"$out")"
    exit 1
fi

if ! out=$(notmuch new --quiet 2>&1); then
    printf '%s\n' "$out" >&2
    echo "proton-mail-mirror: the mail was pulled, but notmuch could not index it" >&2
    record fail --reason "notmuch new: $(tail -n 1 <<<"$out")"
    exit 1
fi

# The mail is in; a count that cannot be read costs the numbers, not the run.
maildir=$(notmuch config get database.mail_root)
messages=$(notmuch count '*')
bytes=$(du -sb "$maildir" | cut -f1)
record ok --stats "$(jq -n \
    --argjson messages "${messages:-null}" \
    --argjson bytes "${bytes:-null}" \
    '{messages: $messages, bytes: $bytes}')"
