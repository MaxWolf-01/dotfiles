#!/usr/bin/env bash
# Commit everything in the knowledge-base vault, pull and push, then do the same
# for its .obsidian settings repo. The vault's commit message starts with
# "Android" on Android and "Vault" everywhere else.

vault_name="Vault"
if [[ $(uname -a) == *Android* ]]; then
    vault_name="Android"
fi

# Main repo
cd ~/repos/obsidian/knowledge-base || exit 1
git add .
git commit -a -m "$vault_name backup: $(date +'%Y-%m-%d %H:%M:%S')"
git pull --no-ff
git push

# Settings
cd .obsidian || exit 1
git add .
git commit -a -m "Obsidian settings backup: $(date +'%Y-%m-%d %H:%M:%S')"
git pull --no-ff
git push
