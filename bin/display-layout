#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro", "tomlkit"]
# ///
"""Save monitor arrangements under a name, put them back, and draw them in the terminal.

A layout is one arrangement of monitors: each monitor's position, mode, scale,
rotation, and which one is primary. `save` writes layouts to
desktop/display-layouts.toml in the dotfiles, or to the file DISPLAY_LAYOUTS
names. A layout names its monitors by alias, and an alias stands for a vendor
and product as gdctl show prints them, never for a connector, so a layout is
found whichever port its monitors are plugged into. An alias carries a serial
only to tell two monitors of one model apart, and the serial counts only while
both are connected.

    [aliases]
    laptop = { vendor = "AUO", product = "0xc199" }
    arzopa = { vendor = "GWD", product = "ARZOPA" }

    [layouts.travel]
    arzopa = { x = 0, y = 168, mode = "2560x1600@59.997", scale = 1.3333333730697632 }
    laptop = { x = 1920, y = 0, mode = "2560x1600@165.040", scale = 1.3333333730697632, primary = true }

A monitor's entry in a layout has scale 1, transform normal and primary false
unless it says otherwise. `save` gives a monitor it has not seen an alias named
from its model; renaming an alias means renaming it in [aliases] and in every
layout. A layout fits when its monitors are exactly the ones connected, where a
closed laptop lid takes the panel out of the connected set, as it does for
mutter.

`use` and `save` record the layout they leave on screen, and `show` compares
the live arrangement with it. The record is $XDG_STATE_HOME/display-layout/recent.

A drawing is to scale, one colour per alias, with ★ on the primary monitor, ↻
on one turned right (gdctl's transform 90) and ↺ on one turned left (270). It
is drawn in outline when stdout is not a terminal or NO_COLOR is set.

`watch` looks after monitor sets that have no layout. GNOME keys the layouts it
saves in ~/.config/monitors.xml on each monitor's connector name plus its EDID.
One monitor reaches a different connector through a different port: HDMI on
the discrete GPU, DP-1 or DP-2 on the USB-C ports. A layout GNOME saved on one
port is then not found on another, and mutter lays the monitors out in a
left-to-right row. `watch` recognises that row and replaces it: externals along
the top in the order mutter lists them, laptop panel centred below it and made
primary. Modes, scales and transforms are carried over untouched; only
positions change.

Every arrangement applied here lasts for the session, and gdctl's --persistent
is deliberately left out of every call. mutter makes a person confirm any
display configuration a D-Bus client saves, so saving one would raise the
keep-these-settings dialog on every replug. Nothing is written to monitors.xml.

Reads and writes display state through gdctl(1).

Examples:

    display-layout save desk-tall
    display-layout use desk-tall
    display-layout list
    display-layout show
    display-layout show --json
    display-layout apply --dry-run
    display-layout watch
"""

import ctypes
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from collections.abc import Iterable
from dataclasses import dataclass, field, replace
from pathlib import Path
from typing import Annotated, Literal, NoReturn

import tomlkit
import tyro
from tyro.extras import SubcommandApp

app = SubcommandApp()

# Reached relative to this script, not through PATH: the systemd unit pins its
# own PATH and it does not carry ~/bin.
RUN_LOG = Path(__file__).resolve().parent / "run-log"

PR_SET_PDEATHSIG = 1
"""prctl(2) option: signal this process when its parent dies."""

SYSTEM_PATH = "/usr/local/bin:/usr/bin:/bin"
"""Where gdctl and gdbus are looked up.

gdctl is a system GNOME tool that imports the system python3's GObject
bindings. The uv virtualenv this script runs in puts its own python3 ahead of
the system one, and those bindings are not installed there.
"""

BUILTIN_PREFIXES = ("eDP", "LVDS", "DSI")
"""Connector types mutter treats as the built-in panel (meta_monitor_is_builtin)."""

TREE = re.compile(r"^(?P<prefix>[│ ]*)[├└]──(?P<text>.*)$")
"""One row of gdctl's box-drawing tree. Indent is 4 columns per level."""

RESOLUTION = re.compile(r"^(\d+)x(\d+)@")
POSITION = re.compile(r"^Position: \((-?\d+), (-?\d+)\)$")

TURNED = ("90", "270", "flipped-90", "flipped-270")
"""Transforms that put the mode's height along the layout's x axis."""

ADJACENCY_TOLERANCE = 2
"""Pixels of slack when testing whether two logical monitors touch.

mutter rounds logical sizes to whole pixels, so a row's x offsets need not be an
exact running sum of the widths computed here.
"""


class ParseError(Exception):
    pass


class CommandError(RuntimeError):
    """gdctl or gdbus exited non-zero."""


@dataclass
class Monitor:
    connector: str
    mode: str = ""
    vendor: str = ""
    product: str = ""
    serial: str = ""

    @property
    def is_builtin(self) -> bool:
        return self.connector.startswith(BUILTIN_PREFIXES)

    @property
    def resolution(self) -> tuple[int, int]:
        m = RESOLUTION.match(self.mode)
        if not m:
            raise ParseError(f"{self.connector}: unreadable mode {self.mode!r}")
        return int(m[1]), int(m[2])


@dataclass
class Logical:
    x: int = 0
    y: int = 0
    scale: float = 1.0
    transform: str = "normal"
    primary: bool = False
    connectors: list[str] = field(default_factory=list)

    @property
    def is_turned(self) -> bool:
        """Whether the transform puts the mode's height along the layout's x axis."""
        return self.transform in TURNED


@dataclass
class State:
    monitors: dict[str, Monitor]
    logicals: list[Logical]

    def size_of(self, logical: Logical) -> tuple[int, int]:
        """Logical size in the layout's coordinate space.

        gdctl rejects a logical monitor whose monitors differ in resolution, so
        the first one speaks for all of them.
        """
        monitor = self.monitors[logical.connectors[0]]
        return logical_size(monitor.resolution, logical.transform, logical.scale)


def logical_size(resolution: tuple[int, int], transform: str, scale: float) -> tuple[int, int]:
    """A monitor's width and height in the layout's coordinate space."""
    w, h = resolution
    if transform in TURNED:
        w, h = h, w
    return round(w / scale), round(h / scale)


def read_state() -> State:
    return parse_show(run(["gdctl", "show"]))


def parse_show(out: str) -> State:
    """Turn `gdctl show` output into monitors and the logical monitors they sit in."""
    monitors: dict[str, Monitor] = {}
    logicals: list[Logical] = []
    section = ""
    monitor: Monitor | None = None
    logical: Logical | None = None
    expect = ""

    for line in out.splitlines():
        if line == "Monitors:":
            section, expect = "monitors", ""
            continue
        if line == "Logical monitors:":
            section, expect = "logical", ""
            continue
        row = TREE.match(line)
        if not row:
            continue
        level = (len(row["prefix"]) + 1) // 4
        text = row["text"]

        if level < 2:
            expect = ""

        if section == "monitors":
            if level == 0 and text.startswith("Monitor "):
                monitor = Monitor(connector=text.split()[1])
                monitors[monitor.connector] = monitor
            elif level == 1 and text in ("Current mode", "Preferred mode"):
                expect = "mode"
            elif level == 1 and monitor and text.startswith("Vendor: "):
                monitor.vendor = text.removeprefix("Vendor: ")
            elif level == 1 and monitor and text.startswith("Product: "):
                monitor.product = text.removeprefix("Product: ")
            elif level == 1 and monitor and text.startswith("Serial: "):
                monitor.serial = text.removeprefix("Serial: ")
            elif level == 2 and expect == "mode" and monitor:
                monitor.mode = text
                expect = ""

        elif section == "logical":
            if level == 0 and text.startswith("Logical monitor #"):
                logical = Logical()
                logicals.append(logical)
            elif logical is None:
                continue
            elif pos := POSITION.match(text):
                logical.x, logical.y = int(pos[1]), int(pos[2])
            elif text.startswith("Scale: "):
                logical.scale = float(text.removeprefix("Scale: "))
            elif text.startswith("Transform: "):
                logical.transform = text.removeprefix("Transform: ")
            elif text.startswith("Primary: "):
                logical.primary = text.endswith("yes")
            elif text.startswith("Monitors: ("):
                expect = "connectors"
            elif level == 2 and expect == "connectors":
                logical.connectors.append(text.split()[0])

    if not monitors:
        raise ParseError("gdctl show listed no monitors")
    for name, mon in monitors.items():
        if not mon.mode:
            raise ParseError(f"{name}: gdctl show reported no mode")
    return State(monitors=monitors, logicals=logicals)


def is_mutter_row(state: State) -> bool:
    """True when the layout is what mutter's create_linear() emits.

    Every logical monitor sits at y=0 and each one starts where the previous
    ended, in the order mutter itself lists them. A single monitor is trivially
    such a row and is never worth rearranging.
    """
    if len(state.logicals) < 2:
        return False
    edge = 0
    for logical in state.logicals:
        if logical.y != 0 or abs(logical.x - edge) > ADJACENCY_TOLERANCE:
            return False
        edge += state.size_of(logical)[0]
    return True


def plan(state: State) -> list[str]:
    """gdctl arguments placing the externals in a row with the panel centred below.

    Empty when there is nothing to arrange: no external, no built-in panel, or a
    mirrored logical monitor, which is always deliberate.
    """
    if any(len(logical.connectors) > 1 for logical in state.logicals):
        return []

    by_connector = {
        logical.connectors[0]: logical
        for logical in state.logicals
        if logical.connectors
    }
    externals = [
        c for c, m in state.monitors.items() if not m.is_builtin and c in by_connector
    ]
    builtins = [
        c for c, m in state.monitors.items() if m.is_builtin and c in by_connector
    ]
    if not externals or not builtins:
        return []

    panel = builtins[0]
    sizes = {c: state.size_of(by_connector[c]) for c in externals + [panel]}
    top_width = sum(sizes[c][0] for c in externals)
    top_height = max(sizes[c][1] for c in externals)

    panel_x = (top_width - sizes[panel][0]) // 2
    shift = max(0, -panel_x)  # a panel wider than the row pushes the row right

    args: list[str] = []  # --persistent is left out on purpose; see this module's docstring
    x = shift
    for connector in externals:
        args += monitor_args(state, connector, x, 0)
        x += sizes[connector][0]
    args += monitor_args(state, panel, panel_x + shift, top_height, primary=True)
    return args


def monitor_args(
    state: State, connector: str, x: int, y: int, primary: bool = False
) -> list[str]:
    """One --logical-monitor group for gdctl set.

    Mode and transform are spelled out rather than left to gdctl, which fills a
    missing mode with the monitor's preferred one. That would drop a chosen
    refresh rate, and every variable-refresh mode, since those are separate
    non-preferred modes of their own ("2560x1600@165.040+vrr").
    """
    logical = next(
        lo for lo in state.logicals if connector in lo.connectors
    )
    screen = Screen(connector, state.monitors[connector].mode, x, y, logical.scale, logical.transform, primary)
    return group_args(screen, connector)


def group_args(s: "Screen", connector: str) -> list[str]:
    """One --logical-monitor group for gdctl set, the screen on `connector`."""
    args = ["--logical-monitor", "--x", str(s.x), "--y", str(s.y),
            "--scale", repr(s.scale), "--transform", s.transform]
    if s.primary:
        args.append("--primary")
    return args + ["--monitor", connector, "--mode", s.mode]


def describe(state: State) -> dict:
    return {
        "monitors": {
            c: {"mode": m.mode, "builtin": m.is_builtin}
            for c, m in state.monitors.items()
        },
        "logicals": [
            {
                "x": logical.x,
                "y": logical.y,
                "scale": logical.scale,
                "primary": logical.primary,
                "connectors": logical.connectors,
            }
            for logical in state.logicals
        ],
        "is_mutter_row": is_mutter_row(state),
    }


# --- named layouts
#
# tests/properties/display-layout.test holds the properties these have to meet.

UNBUILT = "agent/tickets/display-layouts/{}.md"
"""The ticket that builds a stub, in the private secrets repo."""


@dataclass(frozen=True)
class Model:
    """What an alias recognises a monitor by. Never its connector."""

    vendor: str
    product: str
    serial: str = ""
    """Set only to tell two identical monitors apart."""


@dataclass(frozen=True)
class Screen:
    """One monitor's place in an arrangement."""

    name: str
    """The monitor's alias, or its connector where no layouts file is involved."""
    mode: str
    """As gdctl spells it, refresh rate included: 2560x1600@59.997."""
    x: int
    y: int
    scale: float = 1.0
    transform: str = "normal"
    primary: bool = False


Arrangement = tuple[Screen, ...]


@dataclass
class Store:
    """The layouts file, read."""

    aliases: dict[str, Model]
    layouts: dict[str, Arrangement]
    """Each layout's screens are named by alias."""


def match(store: Store, monitors: list[Monitor]) -> dict[str, dict[str, str]]:
    """The layouts that fit these monitors, each with its aliases bound to connectors.

    A layout fits when its aliases and the monitors pair up one to one by vendor
    and product. An alias's serial counts only while two monitors of its model
    are connected.
    """
    fitting = {}
    for name, layout in store.layouts.items():
        binding = bind([s.name for s in layout], store.aliases, monitors)
        if binding is not None:
            fitting[name] = binding
    return fitting


def bind(
    aliases: list[str], models: dict[str, Model], monitors: list[Monitor]
) -> dict[str, str] | None:
    """Each alias's connector, or None when the aliases and monitors do not pair up.

    Among several monitors of one model, an alias with a serial takes the monitor
    with that serial, and aliases without one take the rest in connector order.
    """
    if len(aliases) != len(monitors):
        return None
    binding: dict[str, str] = {}
    for model, group in by_model(monitors).items():
        wanting = [a for a in aliases if model_of(models[a]) == model]
        if len(wanting) != len(group):
            return None
        if len(group) == 1:
            binding[wanting[0]] = group[0].connector
            continue
        left = sorted(group, key=lambda m: m.connector)
        for alias in [a for a in wanting if models[a].serial]:
            mon = next((m for m in left if m.serial == models[alias].serial), None)
            if mon is None:
                return None
            binding[alias] = mon.connector
            left.remove(mon)
        for alias, mon in zip([a for a in wanting if not models[a].serial], left):
            binding[alias] = mon.connector
    return binding if len(binding) == len(aliases) else None


def model_of(m: Model | Monitor) -> tuple[str, str]:
    return m.vendor, m.product


def by_model(monitors: list[Monitor]) -> dict[tuple[str, str], list[Monitor]]:
    groups: dict[tuple[str, str], list[Monitor]] = {}
    for mon in monitors:
        groups.setdefault(model_of(mon), []).append(mon)
    return groups


def connected(state: State, lid_closed: bool) -> list[Monitor]:
    """The monitors a layout has to cover.

    A closed lid takes the built-in panel out, unless it is the only monitor,
    which is how mutter keys its own saved configurations
    (meta_create_monitors_config_key_for_current_state).
    """
    monitors = list(state.monitors.values())
    if not lid_closed:
        return monitors
    externals = [m for m in monitors if not m.is_builtin]
    return externals or monitors


def name_monitors(
    aliases: dict[str, Model], monitors: list[Monitor]
) -> tuple[dict[str, str], dict[str, Model]]:
    """An alias for each monitor's connector, and the aliases once those are added.

    A monitor alone of its model takes that model's alias. Among several of one
    model, a monitor takes the alias with its serial; the rest take the model's
    aliases without a serial, which then get theirs, and after those new ones.
    A monitor left without an alias gets a new one named from its model. No
    alias names two monitors.
    """
    aliases = dict(aliases)
    names: dict[str, str] = {}
    for model, group in by_model(monitors).items():
        known = [a for a, m in aliases.items() if model_of(m) == model]
        if len(group) == 1:
            mon = group[0]
            names[mon.connector] = alias_of_one(mon, known, aliases) or new_alias(mon, aliases)
            continue
        unnamed = []
        for mon in sorted(group, key=lambda m: m.connector):
            alias = next((a for a in known if aliases[a].serial and aliases[a].serial == mon.serial), None)
            if alias:
                names[mon.connector] = alias
                known.remove(alias)
            else:
                unnamed.append(mon)
        bare = [a for a in known if not aliases[a].serial]
        for mon in unnamed:
            if bare:
                alias = bare.pop(0)
                aliases[alias] = replace(aliases[alias], serial=mon.serial)
            else:
                alias = new_alias(mon, aliases, mon.serial)
            names[mon.connector] = alias
    return names, aliases


def alias_of_one(mon: Monitor, known: list[str], aliases: dict[str, Model]) -> str | None:
    """The alias for the one connected monitor of its model, among that model's `known` aliases."""
    for alias in known:
        if aliases[alias].serial == mon.serial:
            return alias
    for alias in known:
        if not aliases[alias].serial:
            return alias
    return known[0] if known else None


def new_alias(mon: Monitor, aliases: dict[str, Model], serial: str = "") -> str:
    """Add an alias for this monitor to `aliases`, and return its name."""
    name = fresh_alias(mon, aliases)
    aliases[name] = Model(mon.vendor, mon.product, serial)
    return name


def known_names(aliases: dict[str, Model], monitors: list[Monitor]) -> dict[str, str]:
    """Each monitor's alias, or its connector for a monitor no alias stands for."""
    names, _ = name_monitors(aliases, monitors)
    return {c: a if a in aliases else c for c, a in names.items()}


def fresh_alias(mon: Monitor, taken: Iterable[str]) -> str:
    """A short name from the model: laptop for the built-in panel, else the product's first word."""
    base = "laptop" if mon.is_builtin else model_word(mon.product) or model_word(mon.vendor) or "monitor"
    taken = set(taken)
    name, n = base, 1
    while name in taken:
        n += 1
        name = f"{base}-{n}"
    return name


def model_word(text: str) -> str:
    """The first word, lowercased and cut to letters, digits and -. Empty for a code such as 0xc199."""
    word = re.sub(r"[^a-z0-9-]", "", (text.split() or [""])[0].lower())
    return word if word[:1].isalpha() and not re.fullmatch(r"0x[0-9a-f]+", word) else ""


class LayoutError(Exception):
    """The display cannot be saved as a layout, or a layout cannot be applied to it."""


def live(state: State, names: dict[str, str]) -> Arrangement:
    """The arrangement on screen, each monitor named as `names` has its connector.

    Monitors mirroring each other are one screen, their names joined by +.
    """
    screens = []
    for lo in state.logicals:
        c = lo.connectors[0]
        name = "+".join(names.get(m, m) for m in lo.connectors)
        screens.append(Screen(name, state.monitors[c].mode, lo.x, lo.y, lo.scale, lo.transform, lo.primary))
    return tuple(sorted(screens, key=lambda s: (s.x, s.y)))


def check_savable(state: State, monitors: list[Monitor]) -> None:
    """Raise LayoutError unless each connected monitor, and only those, is on screen on its own."""
    for lo in state.logicals:
        if len(lo.connectors) > 1:
            raise LayoutError(f"{' and '.join(lo.connectors)} mirror each other, and a layout cannot hold a mirror")
    shown = {c for lo in state.logicals for c in lo.connectors}
    off = [m.connector for m in monitors if m.connector not in shown]
    if off:
        raise LayoutError(
            f"{', '.join(off)} {'is' if len(off) == 1 else 'are'} connected but off, "
            "and a layout covers every connected monitor"
        )
    lidded = sorted(shown - {m.connector for m in monitors})
    if lidded:
        raise LayoutError(f"{', '.join(lidded)} is on with the lid closed; open the lid, or turn the panel off")


def layout_args(arrangement: Arrangement, binding: dict[str, str]) -> list[str]:
    """gdctl set arguments for a layout, its aliases bound to connectors, moved to start at (0, 0).

    --persistent is left out on purpose; see this module's docstring.
    """
    return [arg for s in at_origin(arrangement) for arg in group_args(s, binding[s.name])]


def changes(saved: Arrangement, now: Arrangement) -> list[str]:
    """How the arrangement on screen differs from a saved one, per monitor. Empty when it does not."""
    was = {s.name: s for s in at_origin(saved)}
    out = []
    for s in at_origin(now):
        old = was.get(s.name)
        if old is None:
            out.append(f"{s.name} added")
            continue
        what = [
            word
            for word, differs in (
                ("moved", (s.x, s.y) != (old.x, old.y)),
                ("turned", s.transform != old.transform),
                ("rescaled", not math.isclose(s.scale, old.scale, rel_tol=1e-6)),
                ("in another mode", s.mode != old.mode),
                ("made primary", s.primary and not old.primary),
            )
            if differs
        ]
        if what:
            out.append(f"{s.name} {' and '.join(what)}")
    out += [f"{name} gone" for name in was if name not in {s.name for s in now}]
    return out


def at_origin(arrangement: Arrangement) -> Arrangement:
    x0 = min(s.x for s in arrangement)
    y0 = min(s.y for s in arrangement)
    return tuple(replace(s, x=s.x - x0, y=s.y - y0) for s in arrangement)


class StoreError(Exception):
    """The layouts file does not say what a layout needs."""


def parse_store(text: str) -> Store:
    """Read the layouts file's TOML. The module docstring shows its shape."""
    try:
        data = tomlkit.parse(text).unwrap()
    except tomlkit.exceptions.TOMLKitError as exc:
        raise StoreError(str(exc)) from None
    unknown = set(data) - {"aliases", "layouts"}
    if unknown:
        raise StoreError(f"unknown table {', '.join(sorted(unknown))}; there are [aliases] and [layouts.<name>]")

    for table in ("aliases", "layouts"):
        if not isinstance(data.get(table, {}), dict):
            raise StoreError(f"{table} is a table: [{table}]")
    aliases = {}
    for name, entry in data.get("aliases", {}).items():
        where = f"alias {name}"
        entry = fields(where, entry, required={"vendor": str, "product": str}, optional={"serial": str})
        aliases[name] = Model(entry["vendor"], entry["product"], entry.get("serial", ""))

    layouts = {}
    for name, screens in data.get("layouts", {}).items():
        if not isinstance(screens, dict) or not screens:
            raise StoreError(f"layout {name} lists no monitors")
        arrangement = []
        for alias, entry in screens.items():
            where = f"layout {name}, {alias}"
            if alias not in aliases:
                raise StoreError(f"{where}: no such alias in [aliases]")
            entry = fields(
                where, entry,
                required={"x": int, "y": int, "mode": str},
                optional={"scale": (int, float), "transform": str, "primary": bool},
            )
            if entry.get("transform", "normal") not in TRANSFORMS:
                raise StoreError(f"{where}: transform is one of {', '.join(TRANSFORMS)}")
            screen = Screen(alias, entry["mode"], entry["x"], entry["y"], float(entry.get("scale", 1.0)),
                            entry.get("transform", "normal"), entry.get("primary", False))
            if not RESOLUTION.match(screen.mode):
                raise StoreError(f"{where}: mode is WIDTHxHEIGHT@RATE as gdctl show prints it, not {screen.mode!r}")
            arrangement.append(screen)
        if sum(s.primary for s in arrangement) != 1:
            raise StoreError(f"layout {name}: exactly one monitor has primary = true")
        layouts[name] = tuple(arrangement)
    return Store(aliases, layouts)


def fields(where: str, entry: object, required: dict, optional: dict) -> dict:
    if not isinstance(entry, dict):
        raise StoreError(f"{where}: expected a table, got {entry!r}")
    extra = sorted(set(entry) - set(required) - set(optional))
    if extra:
        raise StoreError(f"{where}: unknown key {extra[0]}; keys are {', '.join([*required, *optional])}")
    for key in required:
        if key not in entry:
            raise StoreError(f"{where}: {key} is missing")
    for key, kind in (required | optional).items():
        if key in entry and (not isinstance(entry[key], kind) or (kind is int and isinstance(entry[key], bool))):
            raise StoreError(f"{where}: {key} = {entry[key]!r} is not {getattr(kind, '__name__', 'a number')}")
    return entry


def with_layout(text: str, name: str, arrangement: Arrangement, aliases: dict[str, Model]) -> str:
    """The layouts file's text with `name` set to `arrangement` and `aliases` added or updated.

    Everything else in the file, comments included, is kept as it was.
    """
    doc = tomlkit.parse(text) if text.strip() else tomlkit.document()
    if not text.strip():
        doc.add(tomlkit.comment("Named display layouts. Format and commands: display-layout --help"))
    if "aliases" not in doc:
        doc.add("aliases", tomlkit.table())
    if "layouts" not in doc:
        doc.add("layouts", tomlkit.table(is_super_table=True))
    for alias, model in aliases.items():
        entry = {"vendor": model.vendor, "product": model.product} | ({"serial": model.serial} if model.serial else {})
        if doc["aliases"].get(alias) != entry:
            doc["aliases"][alias] = inline(entry)
    table = tomlkit.table()
    for s in arrangement:
        entry: dict = {"x": s.x, "y": s.y, "mode": s.mode}
        if s.scale != 1.0:
            entry["scale"] = s.scale
        if s.transform != "normal":
            entry["transform"] = s.transform
        if s.primary:
            entry["primary"] = True
        table.add(s.name, inline(entry))
    doc["layouts"][name] = table
    return tomlkit.dumps(doc)


def inline(entry: dict):
    table = tomlkit.inline_table()
    table.update(entry)
    return table


def layouts_file() -> Path:
    return Path(os.environ.get("DISPLAY_LAYOUTS") or Path(__file__).resolve().parents[1] / "desktop" / "display-layouts.toml")


def load_store() -> Store:
    return read_store()[2]


def read_store() -> tuple[Path, str, Store]:
    """The layouts file's path, its text, and the store it holds. Empty when there is no file."""
    path = layouts_file()
    text = path.read_text() if path.exists() else ""
    try:
        return path, text, parse_store(text)
    except StoreError as exc:
        raise StoreError(f"{path}: {exc}") from None


def recent_file() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state"
    return Path(state) / "display-layout" / "recent"


def recent() -> list[str]:
    """Layout names, the one most recently put on screen first."""
    path = recent_file()
    return path.read_text().split() if path.exists() else []


def remember(name: str) -> None:
    path = recent_file()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("".join(f"{n}\n" for n in [name, *(n for n in recent() if n != name)]))


def lid_closed() -> bool:
    """UPower's LidIsClosed, which mutter follows too. False where there is no lid or no answer."""
    try:
        out = run([
            "gdbus", "call", "--system", "--dest", "org.freedesktop.UPower",
            "--object-path", "/org/freedesktop/UPower",
            "--method", "org.freedesktop.DBus.Properties.Get", "org.freedesktop.UPower", "LidIsClosed",
        ])
    except (CommandError, OSError):
        return False
    return "true" in out


@dataclass(frozen=True)
class Current:
    """The arrangement on screen, named by alias, and which saved layout it is."""

    arrangement: Arrangement
    layout: str | None
    """The saved layout it matches, else the one it was last put on screen as."""
    changed: tuple[str, ...]
    """What differs from that layout. Empty when it is on screen as saved."""


def current(state: State, monitors: list[Monitor], store: Store, recent: list[str]) -> Current:
    """Name the monitors on screen and find the layout it came from.

    A fitting layout identical to the screen wins, the most recently used first.
    Otherwise the one last used with these monitors is reported with what
    changed since.
    """
    if any(len(lo.connectors) > 1 for lo in state.logicals):
        return Current(live(state, known_names(store.aliases, monitors)), None, ())
    fitting = match(store, monitors)
    order = [n for n in recent if n in fitting] + [n for n in fitting if n not in recent]
    seen = {}
    for name in order:
        now = live(state, {c: a for a, c in fitting[name].items()})
        seen[name] = now
        if not changes(store.layouts[name], now):
            return Current(now, name, ())
    last = next((n for n in recent if n in fitting), None)
    if last:
        return Current(seen[last], last, tuple(changes(store.layouts[last], seen[last])))
    return Current(live(state, known_names(store.aliases, monitors)), None, ())


@dataclass(frozen=True)
class Rotate:
    """Turn a monitor to landscape, or to what GNOME Settings calls Portrait Left or Right."""

    name: str
    to: Literal["left", "right", "normal"]


@dataclass(frozen=True)
class Place:
    name: str
    side: Literal["left-of", "right-of", "above", "below"]
    other: str


@dataclass(frozen=True)
class Primary:
    name: str


@dataclass(frozen=True)
class Scale:
    name: str
    factor: float


Verb = Rotate | Place | Primary | Scale


def edit(arrangement: Arrangement, verb: Verb) -> Arrangement:
    """The arrangement with the one thing the verb names changed."""
    raise NotImplementedError(UNBUILT.format("04-edit-verbs"))


def snap(arrangement: Arrangement, moved: str) -> Arrangement:
    """Put the moved screen back against its neighbours, the way GNOME Settings does."""
    raise NotImplementedError(UNBUILT.format("05-interactive-mode"))


def cells(arrangement: Arrangement, width: int) -> list[list[str | None]]:
    """Which screen each cell of the arrangement's terminal drawing belongs to.

    The drawing is `width` cells across and made of half-block characters (▀),
    two cells to a character, one above the other, so a cell is as tall as it
    is wide. A cell belongs to the screen its centre lies in. A screen too small
    to hold any centre still gets the cell nearest its own.
    """
    rects = {s.name: bounds(s) for s in arrangement}
    x0 = min(r[0] for r in rects.values())
    y0 = min(r[1] for r in rects.values())
    x1 = max(r[2] for r in rects.values())
    y1 = max(r[3] for r in rects.values())
    cell = (x1 - x0) / width
    rows = max(1, round((y1 - y0) / cell))
    grid: list[list[str | None]] = [[None] * width for _ in range(rows)]
    for r in range(rows):
        cy = y0 + (r + 0.5) * cell
        for c in range(width):
            cx = x0 + (c + 0.5) * cell
            grid[r][c] = next(
                (n for n, (sx1, sy1, sx2, sy2) in rects.items() if sx1 <= cx < sx2 and sy1 <= cy < sy2),
                None,
            )
    drawn = {n for row in grid for n in row}
    for name, (sx1, sy1, sx2, sy2) in rects.items():
        if name not in drawn:
            c = min(width - 1, int(((sx1 + sx2) / 2 - x0) / cell))
            r = min(rows - 1, int(((sy1 + sy2) / 2 - y0) / cell))
            grid[r][c] = name
    return grid


def bounds(s: Screen) -> tuple[int, int, int, int]:
    """x1, y1, x2, y2 of a screen in logical pixels."""
    w, h = logical_size(Monitor(s.name, s.mode).resolution, s.transform, s.scale)
    return s.x, s.y, s.x + w, s.y + h


TRANSFORMS = ("normal", "90", "180", "270", "flipped", "flipped-90", "flipped-180", "flipped-270")
ARROWS = {"90": "↻", "270": "↺", "180": "↻↻"}
"""The rotation mark in a label. gdctl's 90 is what GNOME Settings calls Portrait Right."""

EARTH = {"laptop": "#5f6f52", "hp": "#8a6a52", "lg": "#6f5e70", "arzopa": "#56657a"}
"""Fill colour per alias: sage, clay, mauve, slate."""
MORE_EARTH = ("#7a6d48", "#4f6b66", "#7a5550", "#5d5a4c")
"""Fills for the aliases EARTH has no colour for, in turn: ochre, pine, rust, umber."""
SAND = "#ede3d2"
"""Label text on a fill."""
MAX_COLUMNS = 72
MAX_ROWS = 22
"""The largest drawing, in terminal characters, however large the terminal is."""


def palette(names: Iterable[str]) -> dict[str, str]:
    """A fill for each name: its own from EARTH, else the next unused one, in the order given."""
    names = list(dict.fromkeys(names))
    own = {EARTH[n] for n in names if n in EARTH}
    spare = [*MORE_EARTH, *(c for c in EARTH.values() if c not in own)]
    others = [n for n in names if n not in EARTH]
    return {n: EARTH[n] for n in names if n in EARTH} | {n: spare[i % len(spare)] for i, n in enumerate(others)}


def fit_width(arrangement: Arrangement, columns: int) -> int:
    """Columns for a drawing that fits `columns` and stays within MAX_COLUMNS by MAX_ROWS."""
    rects = [bounds(s) for s in arrangement]
    w = max(r[2] for r in rects) - min(r[0] for r in rects)
    h = max(r[3] for r in rects) - min(r[1] for r in rects)
    return max(8, min(columns, MAX_COLUMNS, math.floor(MAX_ROWS * 2 * w / h)))


def draw(arrangement: Arrangement, width: int, colours: dict[str, str] | None) -> str:
    """The arrangement drawn `width` columns wide: filled blocks in `colours`, or outlined when it is None."""
    grid = cells(arrangement, width)
    screens = {s.name: s for s in arrangement}
    if colours is None:
        return outline(grid, screens)
    return blocks(grid, screens, colours)


def label(s: Screen) -> list[str]:
    x1, y1, x2, y2 = bounds(s)
    turn = ARROWS.get(s.transform, "" if s.transform == "normal" else s.transform)
    return [s.name + (" ★" if s.primary else ""), f"{x2 - x1}×{y2 - y1}" + (f" {turn}" if turn else "")]


def span(grid: list[list[str | None]], name: str) -> tuple[int, int, int, int]:
    """First and last row, first and last column of the cells a screen owns."""
    rows = [r for r, row in enumerate(grid) if name in row]
    cols = [c for row in grid for c, owner in enumerate(row) if owner == name]
    return rows[0], rows[-1], min(cols), max(cols)


def place_label(lines: list[str], rows: range, c0: int, c1: int) -> dict[tuple[int, int], str]:
    """Label characters by (text row, column), centred in the rows and columns given, cut to fit."""
    room = c1 - c0 + 1
    lines = [t if len(t) <= room else t[: max(0, room - 1)] + "…" for t in lines][: len(rows)]
    top = rows.start + (len(rows) - len(lines)) // 2
    out = {}
    for i, text in enumerate(lines):
        start = c0 + (room - len(text)) // 2
        for j, ch in enumerate(text):
            out[(top + i, start + j)] = ch
    return out


def rgb(hex_: str) -> str:
    return ";".join(str(int(hex_[i : i + 2], 16)) for i in (1, 3, 5))


def blocks(grid: list[list[str | None]], screens: dict[str, Screen], colours: dict[str, str]) -> str:
    """Filled rectangles in half-block characters, a blank line of cells between neighbours."""
    height, width = len(grid), len(grid[0])
    gapped = [row[:] for row in grid]
    for r in range(height):
        for c in range(width):
            o = grid[r][c]
            right = grid[r][c + 1] if c + 1 < width else None
            below = grid[r + 1][c] if r + 1 < height else None
            if o and ((right and right != o) or (below and below != o)):
                gapped[r][c] = None
    if height % 2:
        gapped.append([None] * width)

    text: dict[tuple[int, int], tuple[str, str]] = {}
    for name, screen in screens.items():
        if not any(name in row for row in gapped):
            continue
        r0, r1, c0, c1 = span(gapped, name)
        whole = range((r0 + 1) // 2, (r1 + 1) // 2)  # text rows with both halves inside
        for at, ch in place_label(label(screen), whole, c0, c1).items():
            text[at] = (ch, name)

    out = []
    for tr in range(len(gapped) // 2):
        line, style = [], ""
        for c in range(width):
            top, bottom = gapped[2 * tr][c], gapped[2 * tr + 1][c]
            if (tr, c) in text:
                ch, name = text[(tr, c)]
                bold = "1;" if screens[name].primary else ""
                want, glyph = f"{bold}38;2;{rgb(SAND)};48;2;{rgb(colours[name])}", ch
            elif top and bottom:
                want, glyph = f"38;2;{rgb(colours[top])};48;2;{rgb(colours[bottom])}", "▀"
            elif top:
                want, glyph = f"38;2;{rgb(colours[top])}", "▀"
            elif bottom:
                want, glyph = f"38;2;{rgb(colours[bottom])}", "▄"
            else:
                want, glyph = "", " "
            if want != style:
                line.append(f"\x1b[0m\x1b[{want}m" if want else "\x1b[0m")
                style = want
            line.append(glyph)
        if style:
            line.append("\x1b[0m")
        out.append("".join(line).rstrip())
    return "\n".join(out)


def outline(grid: list[list[str | None]], screens: dict[str, Screen]) -> str:
    """Box-drawing rectangles, heavy for the primary monitor, one text row per two cells."""
    height, width = (len(grid) + 1) // 2, len(grid[0])
    chars = [[" "] * width for _ in range(height)]
    for name, s in screens.items():
        r0, r1, c0, c1 = span(grid, name)
        # Text row t holds cells 2t and 2t+1. A screen takes the rows whose top
        # cell is its own, so two stacked screens never share a row.
        t0 = min((r0 + 1) // 2, height - 1)
        t1 = min(max(t0, (r1 + 2) // 2 - 1), height - 1)
        h, v, tl, tr, bl, br = ("━", "┃", "┏", "┓", "┗", "┛") if s.primary else ("─", "│", "╭", "╮", "╰", "╯")
        for c in range(c0 + 1, c1):
            chars[t0][c] = h
            chars[t1][c] = h
        for r in range(t0 + 1, t1):
            chars[r][c0] = v
            chars[r][c1] = v
        chars[t0][c0], chars[t0][c1], chars[t1][c0], chars[t1][c1] = tl, tr, bl, br
        for (r, c), ch in place_label(label(s), range(t0 + 1, t1), c0 + 1, c1 - 1).items():
            chars[r][c] = ch
    return "\n".join("".join(row).rstrip() for row in chars)


@dataclass(frozen=True)
class Recall:
    """Apply a saved layout."""

    layout: str
    argv: tuple[str, ...]
    """gdctl set arguments."""


@dataclass(frozen=True)
class Fallback:
    """Apply the arrangement for a set with no layout: externals on top, panel below."""

    argv: tuple[str, ...]
    """gdctl set arguments."""


@dataclass(frozen=True)
class Decision:
    """What the watcher does about one look at the display."""

    settled: tuple[str, ...] | None
    """The connected set dealt with once this is carried out."""
    apply: Recall | Fallback | None
    """None leaves the display alone."""


def decide(
    settled: tuple[str, ...] | None, state: State, store: Store, recent: list[str]
) -> Decision:
    """The watcher's choice. `recent` lists layout names, the most recently used first."""
    raise NotImplementedError(UNBUILT.format("06-watcher-last-used"))


def die_with_parent() -> None:
    """Ask the kernel to kill this child when its parent goes (PR_SET_PDEATHSIG).

    The `finally` around the watch loop covers the orderly exits. This covers the
    rest -- SIGKILL, a crash, a signal arriving inside a syscall -- where the
    parent never runs another line and gdbus would otherwise be left reparented
    to the session manager, holding a bus connection nobody reads.
    """
    ctypes.CDLL("libc.so.6", use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGTERM)


def system_env() -> dict[str, str]:
    """The session's environment with this script's virtualenv taken back out."""
    env = {
        k: v
        for k, v in os.environ.items()
        if k not in ("VIRTUAL_ENV", "PYTHONHOME", "PYTHONPATH")
    }
    env["PATH"] = SYSTEM_PATH
    return env


def run(argv: list[str]) -> str:
    proc = subprocess.run(argv, capture_output=True, text=True, env=system_env())
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip()
        raise CommandError(f"{' '.join(argv)} failed: {detail}")
    return proc.stdout


def log_run(outcome: str, reason: str, stats: dict) -> None:
    """Record one outcome via bin/run-log."""
    proc = subprocess.run(
        [
            str(RUN_LOG),
            "display-layout",
            outcome,
            "--reason",
            reason,
            "--stats",
            json.dumps(stats),
        ],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        print(f"display-layout: run-log failed: {proc.stderr.strip()}", file=sys.stderr)


def fail(message: str) -> NoReturn:
    raise SystemExit(f"display-layout: {message}")


def picture(now: Current, store: Store) -> str:
    """The drawing of what is on screen, under a line naming the layout it is."""
    if now.layout and not now.changed:
        head = f"{now.layout}, as saved"
    elif now.layout:
        head = f"last used with these monitors: {now.layout}; since then {', '.join(now.changed)}"
    else:
        head = "not a saved layout"
    colour = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    colours = palette([*store.aliases, *(s.name for s in now.arrangement)]) if colour else None
    width = fit_width(now.arrangement, shutil.get_terminal_size((80, 24)).columns)
    return head + "\n\n" + draw(now.arrangement, width, colours)


def on_screen(store: Store) -> Current:
    state = read_state()
    return current(state, connected(state, lid_closed()), store, recent())


def describe_connected(monitors: list[Monitor], store: Store) -> str:
    names = known_names(store.aliases, monitors)
    return ", ".join(
        f"{names[m.connector]} on {m.connector}" if names[m.connector] != m.connector
        else f"{m.connector} ({m.vendor} {m.product}, no alias)"
        for m in monitors
    )


@dataclass
class UseArgs:
    name: Annotated[str, tyro.conf.Positional, tyro.conf.arg(metavar="NAME")]
    """The layout to put on screen."""


@app.command(name="use")
def use(args: UseArgs) -> None:
    """Put a saved layout on screen, and draw it.

    The layout's monitors have to be the ones connected, on whichever ports.
    """
    store = load_store()
    if args.name not in store.layouts:
        raise LayoutError(f"no layout named {args.name}; saved: {', '.join(store.layouts) or 'none'}")
    state = read_state()
    monitors = connected(state, lid_closed())
    binding = match(store, monitors).get(args.name)
    if binding is None:
        wants = ", ".join(s.name for s in store.layouts[args.name])
        raise LayoutError(f"{args.name} is for {wants}; connected: {describe_connected(monitors, store)}")
    run(["gdctl", "set", *layout_args(store.layouts[args.name], binding)])
    remember(args.name)
    print(picture(on_screen(store), store))


@dataclass
class SaveArgs:
    name: Annotated[str, tyro.conf.Positional, tyro.conf.arg(metavar="NAME")]
    """The layout's name. Saving under a name already taken replaces that layout."""


@app.command(name="save")
def save(args: SaveArgs) -> None:
    """Save the arrangement on screen as a layout in the layouts file, and draw it."""
    if not re.fullmatch(r"[A-Za-z0-9_-]+", args.name):
        raise LayoutError(f"{args.name!r}: a layout name is letters, digits, - and _")
    path, text, store = read_store()
    state = read_state()
    monitors = connected(state, lid_closed())
    check_savable(state, monitors)
    names, aliases = name_monitors(store.aliases, monitors)
    arrangement = at_origin(live(state, names))
    added = {a: m for a, m in aliases.items() if store.aliases.get(a) != m}
    text = with_layout(text, args.name, arrangement, added)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    remember(args.name)
    for alias, model in added.items():
        verb = "updated" if alias in store.aliases else "new"
        print(f"{verb} alias {alias}: {model.vendor} {model.product}" + (f" {model.serial}" if model.serial else ""))
    print(f"saved {args.name} in {path}\n")
    store = parse_store(text)
    print(picture(current(state, monitors, store, recent()), store))


@dataclass
class ListArgs:
    json: bool = False
    """Emit JSON instead of text."""


@app.command(name="list")
def list_(args: ListArgs) -> None:
    """List the saved layouts, marking those that fit the monitors connected now.

    JSON schema (--json):

        [{"name": "str", "fits": bool, "monitors": ["alias"]}]
    """
    store = load_store()
    state = read_state()
    fitting = match(store, connected(state, lid_closed()))
    if args.json:
        print(json.dumps([
            {"name": name, "fits": name in fitting, "monitors": [s.name for s in layout]}
            for name, layout in store.layouts.items()
        ], indent=2))
        return
    if not store.layouts:
        print(f"no layouts in {layouts_file()}; display-layout save NAME saves the one on screen")
        return
    wide = max(len(name) for name in store.layouts)
    for name, layout in store.layouts.items():
        print(f"{'fits' if name in fitting else '':4}  {name:{wide}}  {', '.join(s.name for s in layout)}")


@dataclass
class ShowArgs:
    json: bool = False
    """Emit what gdctl reports, the layout on screen, and what `apply` would do, as JSON instead of the drawing."""


@app.command(name="show")
def show(args: ShowArgs) -> None:
    """Draw the arrangement on screen, and say which saved layout it is.

    When the screen matches no saved layout, the one last put on screen by
    `use` or `save` for these monitors is named, with what changed since.

    JSON schema (--json), where layout is null for no saved layout and changed
    lists what differs from it:

        {"monitors": {"<connector>": {"mode": "str", "builtin": bool}},
         "logicals": [{"x": int, "y": int, "scale": float,
                       "primary": bool, "connectors": ["str"]}],
         "is_mutter_row": bool,
         "plan": ["str"],
         "layout": "str|null",
         "changed": ["str"]}
    """
    store = load_store()
    state = read_state()
    now = current(state, connected(state, lid_closed()), store, recent())
    if args.json:
        report = describe(state) | {"plan": plan(state), "layout": now.layout, "changed": list(now.changed)}
        print(json.dumps(report, indent=2))
        return
    print(picture(now, store))


@dataclass
class ApplyArgs:
    dry_run: bool = False
    """Print the gdctl command without running it."""


@app.command(name="apply")
def apply(args: ApplyArgs) -> None:
    """Arrange the current monitors now, whatever the layout already is.

    For the session only. `save` keeps an arrangement for `use` to put back.
    """
    state = read_state()
    argv = plan(state)
    if not argv:
        print("nothing to arrange", file=sys.stderr)
        raise SystemExit(1)
    print("gdctl set " + " ".join(argv))
    if not args.dry_run:
        run(["gdctl", "set", *argv])
        store = load_store()
        print("\n" + picture(on_screen(store), store))


@dataclass
class WatchArgs:
    settle: float = 2.0
    """Seconds to wait after a change before looking, so a hotplug can finish."""


@app.command(name="watch")
def watch(args: WatchArgs) -> None:
    """Replace mutter's row with the arrangement whenever mutter falls back to it.

    Listens for MonitorsChanged on the session bus, and looks once on startup at
    a display that was already connected.

    Arranges only when the set of connected monitors has changed, which is the
    only way mutter reaches the row. Rearranging monitors by hand leaves that set
    alone, so an arrangement made during a session is never overwritten -- a
    deliberate side-by-side one is indistinguishable from the row, and survives
    on that rule alone.

    Records one line per resolved change via bin/run-log.
    """
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    monitor = subprocess.Popen(
        ["gdbus", "monitor", "--session", "--dest", "org.gnome.Mutter.DisplayConfig"],
        stdout=subprocess.PIPE,
        text=True,
        env=system_env(),
        preexec_fn=die_with_parent,
    )
    assert monitor.stdout
    try:
        follow(monitor.stdout, args.settle)
    finally:
        monitor.terminate()
        monitor.wait(timeout=5)
    raise SystemExit("gdbus monitor exited")


def follow(stream, settle: float) -> None:
    """Arrange once per change of the connected set, and only out of the row.

    The display is looked at once on startup too, because a monitor plugged in
    before the session began has already had its fallback and will send no
    signal about it.
    """
    settled = arrange(None)
    for line in stream:
        if "MonitorsChanged" not in line:
            continue
        time.sleep(settle)
        settled = arrange(settled)


def arrange(settled: tuple[str, ...] | None) -> tuple[str, ...] | None:
    """Replace the row if mutter has just fallen back into it.

    Takes the connected set this already dealt with, and returns the set it
    leaves dealt with -- which is the old one whenever nothing was resolved, so
    a display that could not be read or arranged is tried again on the next
    signal rather than written off.

    Acting only on a change of the set is what keeps this off an arrangement
    made by hand: mutter reaches the row by falling back, which follows a plug
    or an unplug, and rearranging monitors never touches the set.
    """
    try:
        state = read_state()
    except (ParseError, RuntimeError) as exc:
        log_run("fail", str(exc), {})
        return settled

    connectors = tuple(state.monitors)
    if connectors == settled:
        return settled
    stats = {"monitors": list(connectors)}

    if not is_mutter_row(state):
        log_run("skip", "layout is not the row", stats)
        return connectors
    argv = plan(state)
    if not argv:
        log_run("skip", "nothing to arrange", stats)
        return connectors
    try:
        run(["gdctl", "set", *argv])
    except RuntimeError as exc:
        log_run("fail", str(exc), stats)
        return settled
    log_run("ok", "replaced mutter's row", stats)
    return connectors


REFUSALS = (StoreError, LayoutError, ParseError, CommandError)
"""Errors a command ends on with their message alone, no traceback."""


if __name__ == "__main__":
    try:
        app.cli(description=__doc__, config=(tyro.conf.OmitArgPrefixes,))
    except REFUSALS as exc:
        fail(str(exc))
