#!/usr/bin/env bash
# Anchor the Claude 5-hour usage window.
#
# The window starts with the first message you send, not at a fixed clock time.
# Sending one cheap message at a fixed hour therefore pins the reset grid: a
# ping at 08:30 means resets at 13:30, 18:30, 23:30 instead of a schedule that
# drifts with whenever you happened to start working.
#
# A ping that lands inside an already-open window does nothing, so extra pings
# are free — except one that opens a window shortly *before* an anchor, which
# swallows it. See the schedule in nix/home/timers.nix.
set -euo pipefail

if ! command -v claude >/dev/null; then
    echo "claude-ping: claude CLI not on PATH ($PATH)" >&2
    exit 1
fi

# haiku so the ping never eats the weekly Opus budget. No MCP servers, no saved
# session, no skills: the cheapest round trip that still opens a window.
if ! timeout 120 claude -p ping \
    --model haiku \
    --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
    --no-session-persistence \
    --disable-slash-commands; then
    status=$?
    echo "claude-ping: ping failed (exit $status). Check network, then 'claude auth' — an expired login fails silently apart from this." >&2
    exit "$status"
fi
