#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Redact API keys, tokens and passwords from old Claude Code conversation transcripts.

Transcripts under ~/.claude keep everything an agent ever printed, including secrets that
leaked through `env`, `ps`, `docker top` or a curl command line. This rewrites each match in
place as <REDACTED:kind:hash> and reports what it found, so you know what to rotate.

The hash is the first 8 hex chars of the secret's sha256 — it lets you tell whether two
redactions were the same secret without storing the secret. Files keep their mtime and mode.

Dry run by default. Nothing is written until you pass --apply, and there are no backups —
a backup of a file full of secrets defeats the point.

Examples:

    claude-redact-secrets                     # dry run over transcripts older than 10 days
    claude-redact-secrets --apply             # same set, actually rewrite
    claude-redact-secrets --verbose           # list every occurrence with file:line
    claude-redact-secrets --scope all --min-age-days 0 --apply
    claude-redact-secrets --json | jq -r '.[] | "\\(.kind) \\(.env_var // "-")"'
"""

from __future__ import annotations

import hashlib
import json as jsonlib
import math
import os
import re
import sys
import time
from collections import Counter
from dataclasses import dataclass, field
from pathlib import Path
from typing import Literal

import tyro

# ---------------------------------------------------------------- rules


@dataclass(frozen=True)
class Rule:
    kind: str
    """Short name for the secret type. Ends up in the redaction marker."""
    pattern: re.Pattern[str]
    """Regex whose group 'secret' (or group 0) is the part that gets replaced."""
    markers: tuple[str, ...]
    """Lowercase literals, at least one of which must occur for the pattern to match.

    A substring test in C is far cheaper than a regex scan, and transcripts run to gigabytes.
    Every marker must be implied by the pattern or the rule silently stops firing.
    """
    blob_guard: bool = True
    """Reject matches embedded in a longer base64 run (image data, diffs of binaries)."""
    heuristic: bool = False
    """Shape-based rather than format-based; higher false-positive risk."""

    def possible_in(self, lowered: str) -> bool:
        return any(marker in lowered for marker in self.markers)


def _r(pattern: str) -> re.Pattern[str]:
    return re.compile(pattern)


# Left boundary shared by the vendor-prefix rules: a secret never starts mid-word.
_L = r"(?<![A-Za-z0-9_/+-])"

RULES: tuple[Rule, ...] = (
    Rule("github_pat", _r(_L + r"github_pat_[A-Za-z0-9]{20,30}_[A-Za-z0-9]{50,}"), ("github_pat_",)),
    Rule("github_token", _r(_L + r"gh[pousr]_[A-Za-z0-9]{36,251}"), ("ghp_", "gho_", "ghu_", "ghs_", "ghr_")),
    Rule("anthropic", _r(_L + r"sk-ant-[a-z]{3}[0-9]{2}-[A-Za-z0-9_-]{40,}"), ("sk-ant-",)),
    Rule("openai", _r(_L + r"sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,}"), ("sk-",)),
    Rule("openrouter", _r(_L + r"sk-or-v1-[a-f0-9]{64}"), ("sk-or-v1-",)),
    Rule("google_api", _r(_L + r"AIzaSy[A-Za-z0-9_-]{28,36}"), ("aizasy",)),
    Rule("aws_access_key", _r(_L + r"(?:AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16}(?![A-Za-z0-9])"), ("akia", "asia", "abia", "acca")),
    Rule("slack_token", _r(_L + r"xox[baprse]-[0-9A-Za-z-]{10,}"), ("xox",)),
    Rule("slack_webhook", _r(r"https://hooks\.slack\.com/services/[A-Za-z0-9/+]{40,}"), ("hooks.slack.com",)),
    Rule("gitlab_pat", _r(_L + r"glpat-[A-Za-z0-9_-]{20,}"), ("glpat-",)),
    Rule("huggingface", _r(_L + r"hf_[A-Za-z]{34,40}"), ("hf_",)),
    Rule("pypi_token", _r(_L + r"pypi-AgE[A-Za-z0-9_-]{50,}"), ("pypi-age",)),
    Rule("npm_token", _r(_L + r"npm_[A-Za-z0-9]{36}"), ("npm_",)),
    Rule("stripe", _r(_L + r"[sr]k_(?:live|test)_[A-Za-z0-9]{24,}"), ("sk_live_", "sk_test_", "rk_live_", "rk_test_")),
    Rule("sendgrid", _r(_L + r"SG\.[A-Za-z0-9_-]{22}\.[A-Za-z0-9_-]{43}"), ("sg.",)),
    Rule("tailscale", _r(_L + r"tskey-(?:auth|api|client)-[A-Za-z0-9]+-[A-Za-z0-9]+"), ("tskey-",)),
    Rule(
        "discord_bot",
        _r(_L + r"[MNO][A-Za-z0-9_-]{23,26}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27,}"),
        ("discord", "bot_token", "bot token"),
    ),
    Rule("jwt", _r(_L + r"eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{20,}"), ("eyj",)),
    # PEM blocks appear both raw and with JSON-escaped newlines, hence the (?:\\n|\n).
    Rule(
        "private_key",
        _r(r"-----BEGIN [A-Z ]*PRIVATE KEY-----(?:\\n|\n|[A-Za-z0-9+/=\s])+?-----END [A-Z ]*PRIVATE KEY-----"),
        ("private key-----",),
        blob_guard=False,
    ),
    # NAME=value / "name": "value" where the name says it holds a credential.
    #
    # Anchored on the credential word rather than on the identifier that contains it. The
    # obvious spelling — [A-Za-z_][A-Za-z0-9_]*(?:TOKEN|KEY|...) — makes the engine walk an
    # identifier run at every offset in a 1.7 GB corpus and costs about six times as much as
    # every other rule combined. The full variable name is recovered afterwards by env_var_for.
    Rule(
        "env_assignment",
        re.compile(
            r"(?:token|secret|password|passwd|apikey|api_key|private_key|access_key|_key|_pat|credentials?)"
            r"\s*[=:]\s*['\"`]?"
            r"(?P<secret>[^\s'\"`\\,;{}()\[\]]{12,200})",
            re.IGNORECASE,
        ),
        ("token", "secret", "password", "passwd", "apikey", "api_key", "_key", "_pat", "credential"),
        blob_guard=False,
        heuristic=True,
    ),
)

RULES_BY_KIND = {rule.kind: rule for rule in RULES}

# Values that look like a secret slot but hold nothing worth redacting.
_PLACEHOLDER = re.compile(
    r"^(?:x{3,}|\.{3,}|-+|none|null|nil|true|false|unset|empty|changeme|redacted|secret|dummy|example"
    r"|your[_-]?\w*|my[_-]?\w*|<[^>]*>|\{\{?[^}]*\}?\}|\$\w+|\$\{[^}]*\}|%\w+%|\*+|\d+)$",
    re.IGNORECASE,
)
_ALREADY_REDACTED = re.compile(r"^<REDACTED:")


def shannon_entropy(value: str) -> float:
    """Bits of entropy per character. Random tokens sit above ~3.2, English words below ~3.0."""
    if not value:
        return 0.0
    counts = Counter(value)
    return -sum((n / len(value)) * math.log2(n / len(value)) for n in counts.values())


def plausible_secret(value: str) -> bool:
    """Reject placeholders, shell variable references, paths and config words.

    The discriminator that does most of the work is character-class diversity: generated
    credentials mix cases and digits, while `LOG_KEY=timestamp_field` does not. Entropy alone
    does not separate those two — `timestamp_field` scores 3.4 bits/char.
    """
    if _PLACEHOLDER.match(value) or _ALREADY_REDACTED.match(value):
        return False
    if value.startswith(("$", "<", "{", "%", "/", "~", "./", "http://", "https://")):
        return False
    if len(set(value)) < 6:
        return False
    # Source code, not credentials: `apiKey: Type.Optional`, `credentials: Record<string`,
    # `token = opts.getApiKey`. Attribute access, generics and digit-free identifiers are the
    # giveaway — generated credentials essentially always carry digits and never carry dots.
    if any(c in value for c in ".<>") or "::" in value:
        return False
    if not any(c.isdigit() for c in value):
        return False
    classes = sum(bool(re.search(p, value)) for p in (r"[a-z]", r"[A-Z]", r"[0-9]"))
    if classes < 2:
        return False
    return shannon_entropy(value) >= 3.0


_BLOB_CHARS = re.compile(r"[A-Za-z0-9+/]")


def inside_blob(line: str, start: int, end: int, slack: int = 20) -> bool:
    """True if the match sits inside a much longer unbroken base64 run.

    Base64 image data reliably produces AKIA…/AIza…-shaped substrings by chance. A real secret
    is delimited by a quote, space, equals sign or newline; a chance hit inside a blob is not.
    """
    left = start
    while left > 0 and _BLOB_CHARS.match(line[left - 1]):
        left -= 1
    right = end
    while right < len(line) and _BLOB_CHARS.match(line[right]):
        right += 1
    return (right - left) - (end - start) > slack


_ENV_CONTEXT = re.compile(
    r"(?P<var>[A-Za-z_][A-Za-z0-9_]*)\s*[=:]\s*(?:Bearer\s+|token\s+)?['\"]?$"
)


def env_var_for(line: str, start: int) -> str | None:
    """Name of the variable or JSON field the secret was assigned to, if any.

    Only names shaped like identifiers (ALL_CAPS, snake_case or camelCase) count, so that prose
    such as "here is my key: <secret>" is not reported as a variable named `key`.
    """
    match = _ENV_CONTEXT.search(line[:start])
    if not match:
        return None
    var = match.group("var")
    return var if "_" in var or not var.islower() else None


# ---------------------------------------------------------------- scanning


@dataclass
class Finding:
    kind: str
    secret: str
    env_var: str | None
    path: Path
    line_no: int

    @property
    def digest(self) -> str:
        return hashlib.sha256(self.secret.encode()).hexdigest()[:8]

    @property
    def marker(self) -> str:
        return f"<REDACTED:{self.kind}:{self.digest}>"


def scan_line(line: str, path: Path, line_no: int, rules: tuple[Rule, ...]) -> list[Finding]:
    findings: list[Finding] = []
    claimed: list[tuple[int, int]] = []  # spans already taken by an earlier, stricter rule
    lowered = line.lower()

    for rule in rules:
        if not rule.possible_in(lowered):
            continue
        for match in rule.pattern.finditer(line):
            groups = match.groupdict()
            secret = groups.get("secret") or match.group(0)
            span = match.span("secret") if "secret" in groups else match.span()

            if any(span[0] < c_end and c_start < span[1] for c_start, c_end in claimed):
                continue
            if rule.blob_guard and inside_blob(line, *span):
                continue
            if rule.heuristic and not plausible_secret(secret):
                continue

            claimed.append(span)
            findings.append(
                Finding(
                    kind=rule.kind,
                    secret=secret,
                    env_var=groups.get("var") or env_var_for(line, span[0]),
                    path=path,
                    line_no=line_no,
                )
            )
    return findings


def redact_text(text: str, findings: list[Finding]) -> str:
    """Replace every occurrence of every found secret, longest first so that no secret which
    contains another gets half-rewritten.

    Replacement is whole-file, not per-match: once a string is known to be a secret, every copy
    of it goes, including copies the per-line rules skipped. The cost is that a chance
    occurrence of the same string inside a base64 blob is also rewritten — harmless, and the
    safer direction to err in.
    """
    for finding in sorted({(f.secret, f.marker) for f in findings}, key=lambda p: -len(p[0])):
        text = text.replace(finding[0], finding[1])
    return text


SKIP_NAMES = frozenset({".credentials.json"})
SKIP_DIRS = frozenset({"plugins", "statsig", "image-cache", "node_modules", ".git"})


def collect_files(root: Path, scope: Literal["transcripts", "all"], min_age_days: float) -> tuple[list[Path], int]:
    """Return (eligible files, number skipped for being too recent)."""
    if scope == "transcripts":
        candidates = sorted(root.glob("projects/**/*.jsonl"))
        history = root / "history.jsonl"
        if history.exists():
            candidates.append(history)
    else:
        candidates = [p for p in sorted(root.rglob("*")) if p.is_file() and not p.is_symlink()]

    cutoff = time.time() - min_age_days * 86400
    eligible, too_recent = [], 0
    for path in candidates:
        if path.name in SKIP_NAMES or SKIP_DIRS & set(path.relative_to(root).parts[:-1]):
            continue
        if path.stat().st_mtime > cutoff:
            too_recent += 1
            continue
        eligible.append(path)
    return eligible, too_recent


def process(path: Path, rules: tuple[Rule, ...], apply: bool) -> list[Finding]:
    try:
        text = path.read_text(encoding="utf-8", errors="surrogateescape")
    except (OSError, UnicodeError):
        return []
    if "\0" in text[:8192]:  # binary
        return []

    lowered = text.lower()
    live_rules = tuple(rule for rule in rules if rule.possible_in(lowered))
    if not live_rules:
        return []
    del lowered

    findings = [f for n, line in enumerate(text.splitlines(), 1) for f in scan_line(line, path, n, live_rules)]
    if not findings or not apply:
        return findings

    stat = path.stat()
    tmp = path.with_name(f".{path.name}.redact-{os.getpid()}")
    tmp.write_text(redact_text(text, findings), encoding="utf-8", errors="surrogateescape")
    os.chmod(tmp, stat.st_mode)
    os.replace(tmp, path)
    os.utime(path, (stat.st_atime, stat.st_mtime))  # keep age, keep session ordering
    return findings


# ---------------------------------------------------------------- reporting


@dataclass
class Args:
    apply: bool = False
    """Rewrite the files. Without this, only report what would be redacted."""
    min_age_days: float = 10.0
    """Only touch files whose mtime is at least this old. 0 scans everything."""
    scope: Literal["transcripts", "all"] = "transcripts"
    """transcripts: projects/**/*.jsonl plus history.jsonl. all: every file under --root."""
    root: Path = Path.home() / ".claude"
    """Directory to scan."""
    prefix_chars: int = 16
    """How many leading characters of each secret to show. Enough to identify, not to use."""
    include_heuristic: bool = True
    """Include shape-based rules (NAME=value assignments), not just known vendor formats."""
    only: list[str] = field(default_factory=list)
    """Restrict to these rule kinds, e.g. --only github_pat anthropic. Empty means all."""
    verbose: bool = False
    """List every occurrence with file and line number."""
    json: bool = False
    """Emit findings as JSON. Schema: [{kind, digest, prefix, env_var, occurrences, files:[str]}]"""


def main(args: Args) -> None:
    if not args.root.is_dir():
        sys.exit(f"no such directory: {args.root}")

    rules = tuple(r for r in RULES if args.include_heuristic or not r.heuristic)
    if args.only:
        unknown = set(args.only) - RULES_BY_KIND.keys()
        if unknown:
            sys.exit(f"unknown rule kind(s): {', '.join(sorted(unknown))}\nknown: {', '.join(RULES_BY_KIND)}")
        rules = tuple(r for r in rules if r.kind in args.only)

    files, too_recent = collect_files(args.root, args.scope, args.min_age_days)
    findings = [f for path in files for f in process(path, rules, args.apply)]

    groups: dict[str, list[Finding]] = {}
    for finding in findings:
        groups.setdefault(finding.digest, []).append(finding)

    if args.json:
        print(
            jsonlib.dumps(
                [
                    {
                        "kind": g[0].kind,
                        "digest": digest,
                        "prefix": g[0].secret[: args.prefix_chars],
                        "env_var": g[0].env_var,
                        "occurrences": len(g),
                        "files": sorted({str(f.path) for f in g}),
                    }
                    for digest, g in sorted(groups.items(), key=lambda kv: -len(kv[1]))
                ],
                indent=2,
            )
        )
        return

    verb = "redacted" if args.apply else "would redact"
    print(f"scanned {len(files)} files under {args.root} ({too_recent} skipped as newer than {args.min_age_days:g}d)")
    if not findings:
        print("no secrets found")
        return

    touched = sorted({f.path for f in findings})
    print(f"{verb} {len(findings)} occurrences of {len(groups)} distinct secrets across {len(touched)} files\n")

    width = max(len(g[0].kind) for g in groups.values())
    for digest, group in sorted(groups.items(), key=lambda kv: (kv[1][0].kind, -len(kv[1]))):
        head = group[0]
        env = f"  env: {head.env_var}" if head.env_var else ""
        prefix = head.secret[: args.prefix_chars] + ("…" if len(head.secret) > args.prefix_chars else "")
        print(
            f"  {head.kind:<{width}}  {prefix:<{args.prefix_chars + 1}}  "
            f"[{digest}]  {len(group)}x in {len({f.path for f in group})} files{env}"
        )
        if args.verbose:
            for finding in group:
                print(f"      {finding.path}:{finding.line_no}")

    if not args.apply:
        print("\ndry run — nothing written. Re-run with --apply to redact.")
    print("\nRotate anything listed above: redaction removes the copy, not the credential.")


if __name__ == "__main__":
    main(tyro.cli(Args, description=__doc__))
