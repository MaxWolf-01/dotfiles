#!/usr/bin/env bash
# Report monitored units that have gone too long without succeeding.
#
# A scheduled job that skips — locked ZFS dataset, phone away, nothing new to
# fetch — exits 0 and notifies nobody, so "healthy" and "dead for months" look
# identical from the outside. This is the one scheduled alerter in the setup: it
# ignores runs and asks, per unit, how long it has been since the last real
# success. Anything over its bound goes into one alert email; otherwise silence.
#
# Two kinds of unit, two kinds of evidence:
#
#   restic repos     the age of the newest snapshot, against max_age_days in the
#                    repo's own conf — the same files restic_backup.sh consumes.
#   everything else  the last success recorded by whichever witness the config
#                    names, against the bound it gives. The config is also the
#                    written answer to "unit X hasn't run in N days — is that a
#                    problem?".
#
# The witness is named per unit and never guessed. `run-log` means the last `ok`
# line in ~/logs/runs/<unit>.jsonl (bin/run-log); a job that keeps one exits 0
# when it deliberately does nothing, so only its own record can tell a real run
# from a skip. `systemd` means the last time the unit's start job finished
# cleanly, which is all there is to go on for a job that records nothing — and
# is why falling back to it when a run log goes missing would be a downgrade
# with no announcement.
#
# Units on another host are read over ssh. A target that is merely away — a host
# that is off, a repository whose server is down — is expected unavailability,
# not an alert: it is skipped and reported on stdout. A dead pc still surfaces
# here, through the rsync.net repos it stops writing to.
#
# An away streak is bounded, because it would otherwise be indistinguishable
# from health: a repository can only be dated from inside itself, and most of
# them sit on one provider, which one outage takes out at once. When the probe
# cannot reach a repository, the run log of the host that makes that backup
# (bin/backup-hosts) is read instead, and the same max_age_days applies to the
# age of its last success.

set -uo pipefail

DEFAULT_MAX_AGE_DAYS=14
RESTIC_CONFIG_GLOB="$HOME/.dotfiles/secrets/backup/restic/*/*.conf"

# systemd logs this message id when a unit's job finishes; JOB_RESULT says how it
# went, so "done" is the last clean finish and failures never match.
SYSTEMD_UNIT_STARTED=39f53479d3a045ac8e11786248231fbf

usage() {
    cat <<EOF
Usage: $(basename "$0") [--extra-days N] [--config FILE] [--dry-run] [RESTIC_CONFIG...]

Checks every restic config's newest snapshot against its max_age_days (default
$DEFAULT_MAX_AGE_DAYS), and every unit in the config file against its bound there.
With no positional arguments, checks every restic config under
  $RESTIC_CONFIG_GLOB
Repos on a filesystem path that doesn't exist here are skipped: they belong to
another host. A repo whose target cannot be reached is dated from the run log
of the host that makes that backup (bin/backup-hosts), against the same
max_age_days — expected unavailability stays quiet, an outage longer than the
bound alerts.

Exits 1 when it found something overdue or unreadable, 2 when the check itself
could not run. The units treat 1 as success, so a red unit means a broken
watchdog rather than an overdue backup.

  --extra-days N  add N days to every bound, restic and unit alike. Two hosts
                  running this both cover everything, but the one with the
                  offset stays quiet unless the other stopped alerting (i.e.
                  died), so a healthy setup alerts only once.
  --config FILE   unit bounds (default: the file bin/overdue-conf reads, which
                  is also where the syntax is described).
  --dry-run       check everything and print what would have been sent, without
                  sending it or recording this run. For trying out a config
                  change without it reaching a phone.

Findings are delivered by bin/alert-send. Environment:
  RUN_LOG_DIR     where this host's run logs live (default ~/logs/runs).
EOF
}

extra_days=0
unit_config=""
dry_run=false
restic_configs=()
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --dry-run) dry_run=true; shift ;;
        --extra-days) extra_days="${2:?--extra-days needs a value}"; shift 2 ;;
        --extra-days=*) extra_days="${1#*=}"; shift ;;
        --config) unit_config="${2:?--config needs a value}"; shift 2 ;;
        --config=*) unit_config="${1#*=}"; shift ;;
        -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
        *) restic_configs+=("$1"); shift ;;
    esac
done

if ! [[ "$extra_days" =~ ^[0-9]+$ ]]; then
    echo "--extra-days must be a non-negative integer, got: $extra_days" >&2
    exit 2
fi

# Reached relative to this script, not through PATH: the systemd units pin their
# own PATH and none of them carries ~/bin.
bin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
run_log_bin="$bin_dir/run-log"
unreachable_reason="$bin_dir/restic-unreachable-reason"
config_name_bin="$bin_dir/restic-config-name"
backup_hosts_bin="$bin_dir/backup-hosts"
alert_send_bin="$bin_dir/alert-send"

# Read before any repo is probed, so a config nobody can parse costs a message
# rather than two minutes of ssh timeouts first.
conf_arg=()
[ -n "$unit_config" ] && conf_arg=("$unit_config")
if ! unit_records=$("$bin_dir/overdue-conf" "${conf_arg[@]}"); then
    exit 2
fi

# Read here too. It is only needed once a repository turns out to be away, and
# discovering then that this run cannot name the host that logs that backup
# would leave the outage reported as health.
if ! backup_hosts=$("$backup_hosts_bin"); then
    exit 2
fi

this_host="$(uname -n)"
run_log_dir="${RUN_LOG_DIR:-$HOME/logs/runs}"
now=$(date +%s)

# Run a read-only probe here or on another host. Every argument is a plain token
# — no globs, pipes or quotes — so the remote shell cannot mangle it. -n because
# ssh would otherwise drain the config file the caller is reading.
run_on() {
    local host="$1"; shift
    if [ "$host" = "$this_host" ]; then
        "$@"
    else
        ssh -n -o BatchMode=yes -o ConnectTimeout=10 "$host" "$@"
    fi
}

# Remote paths resolve against the remote $HOME. RUN_LOG_DIR redirects the local
# log only, which is what a test driving this script needs.
run_log_path() {
    local host="$1" unit="$2"
    if [ "$host" = "$this_host" ]; then
        echo "$run_log_dir/$unit.jsonl"
    else
        echo "logs/runs/$unit.jsonl"
    fi
}

# When did this unit last succeed, according to the witness the config named?
# Prints epoch seconds on stdout.
#   0  found   1  nothing on record   2  host unreachable   3  no record kept
last_success() {
    local host="$1" unit="$2" witness="$3" body rc ts epoch scope

    if [ "$witness" = "run-log" ]; then
        body=$(run_on "$host" cat "$(run_log_path "$host" "$unit")" 2>/dev/null)
        rc=$?
        [ "$rc" -eq 255 ] && [ "$host" != "$this_host" ] && return 2
        # A missing file is "no record", not a cue to go asking systemd: a unit
        # declared to keep a run log and then not keeping one is a breakage, and
        # it should read as one rather than quietly fall back to weaker evidence.
        # It is its own answer, though: a host that keeps no log at all and one
        # whose log holds nothing but failures are different things to say.
        [ "$rc" -eq 0 ] || return 3
        ts=$(jq -r 'select(.outcome == "ok") | .ts' <<<"$body" 2>/dev/null | tail -1)
        [ -n "$ts" ] || return 1
        epoch=$(date -d "$ts" +%s 2>/dev/null) || return 1
        echo "$epoch"
        return 0
    fi

    # The user manager first — that is where nearly everything lives — then the
    # system one, for the few units that run as root.
    for scope in --user --system; do
        body=$(run_on "$host" journalctl "$scope" -u "$unit.service" \
            "MESSAGE_ID=$SYSTEMD_UNIT_STARTED" JOB_RESULT=done \
            -n 1 -o json --no-pager 2>/dev/null)
        rc=$?
        [ "$rc" -eq 255 ] && [ "$host" != "$this_host" ] && return 2
        ts=$(jq -r '.__REALTIME_TIMESTAMP // empty' <<<"$body" 2>/dev/null)
        if [ -n "$ts" ]; then
            echo $((ts / 1000000))
            return 0
        fi
    done
    return 1
}

# How long has a repository nobody could reach been away? Its own snapshots are
# the only thing that can date it, so the fallback is the run log of the host
# that makes the backup: while that host keeps recording successes the outage is
# recent, and once its last success is older than the repo's bound the silence
# has lasted longer than the backup is allowed to.
#
# Prints the line to report. Exit 0 to leave it alone, 1 to alert about it.
away_verdict() {
    local name="$1" reason="$2" limit="$3" host="" last age unit on_host

    while IFS=$'\t' read -r unit on_host; do
        [ "$unit" = "$name" ] && { host="$on_host"; break; }
    done <<<"$backup_hosts"
    # A repository no timer runs has no other host to ask, and whatever this one
    # recorded is the whole story — usually nothing, which reads as overdue.
    [ -n "$host" ] || host="$this_host"

    last=$(last_success "$host" "$name" run-log)
    case $? in
        2)  # Both the repository and the host that writes it are away, so
            # nothing can date this backup. Alerting would fire every time the
            # laptop slept through pc's watchdog; the host's own copy of this
            # check judges it from its own log the moment it is back.
            echo "$reason; $host is away too, so nothing here can date this backup"
            return 0 ;;
        3)  echo "$reason; $host keeps no run log for this backup, so nothing can date it"
            return 1 ;;
        1)  echo "$reason; no successful backup on record on $host"
            return 1 ;;
    esac

    age=$(( (now - last) / 86400 ))
    if [ "$age" -gt "$limit" ]; then
        echo "$reason; no backup for ${age}d (limit ${limit}d), $(date -d "@$last" +%F)"
        return 1
    fi
    echo "$reason; last backup ${age}d ago (limit ${limit}d)"
    return 0
}

overdue=""
unchecked=""
unreachable=""
overdue_count=0
unchecked_count=0
unreachable_count=0
ok_count=0

# --- restic repos: the age of the newest snapshot

if [ ${#restic_configs[@]} -eq 0 ]; then
    # nullglob, so a glob that matches nothing yields no configs rather than the
    # pattern itself — a run with no repos to check must not demand the age key.
    shopt -s nullglob
    restic_configs=($RESTIC_CONFIG_GLOB)
    shopt -u nullglob
fi

# Without the key every repo would read as unreadable, which is seven confusing
# lines in place of one true one. Report it once and drop the repos — but carry
# on: the unit checks need no key, and on pc the key lives on tmpfs and is only
# decrypted at the first interactive login, so every run after a reboot lands
# here. Giving up would leave that reboot silent in both directions.
age_key="${SOPS_AGE_KEY_FILE:-$HOME/.local/secrets/age-key.txt}"
if [ ${#restic_configs[@]} -gt 0 ] && [ ! -f "$age_key" ]; then
    unchecked="  restic repos: age key not available at $age_key (decrypt it first)"$'\n'
    unchecked_count=1
    restic_configs=()
fi

probe_err=$(mktemp)
trap 'rm -f "$probe_err"' EXIT

for config in "${restic_configs[@]}"; do
    [ -f "$config" ] || continue
    name="$("$config_name_bin" "$config")" || exit 2

    # Source in a subshell and print the fields, so one config's values can't
    # leak into the next. Unit separator, not tab: tab is IFS whitespace, so
    # consecutive tabs around an empty field would collapse and shift the rest.
    #
    # SOPS_AGE_KEY_FILE comes along because the config exports it for the
    # password command's benefit, and that export dies with the subshell — so it
    # has to be put back on the restic call by hand, or sops finds no key and
    # every repo reads as unreadable.
    IFS=$'\x1f' read -r repo repo_local password_command max_age age_key_file < <(
        source "$config" 2>/dev/null
        printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
            "${repo_path:-}" \
            "${repo_path_local:-}" \
            "${password_command:-}" \
            "${max_age_days:-$DEFAULT_MAX_AGE_DAYS}" \
            "${SOPS_AGE_KEY_FILE:-$age_key}"
    )
    max_age=$((max_age + extra_days))

    # A config may name the same repo twice: once as other hosts reach it, once
    # as the host storing it does (pc has no ssh alias for itself). Take the
    # local path only when it's actually here, so both hosts resolve correctly.
    if [ -n "$repo_local" ] && [ -d "$repo_local" ]; then
        repo="$repo_local"
    fi

    if [ -z "$repo" ] || [ -z "$password_command" ]; then
        unchecked="${unchecked}  ${name}: config missing repo_path or password_command"$'\n'
        unchecked_count=$((unchecked_count + 1))
        continue
    fi

    # A bare filesystem path that isn't here means the repo lives on another
    # host (phone/pc.conf seen from the laptop) — not this host's to monitor.
    if [[ "$repo" != *:* ]] && [ ! -d "$repo" ]; then
        continue
    fi

    # --no-lock: listing snapshots only reads, and a lock an interrupted run
    # left behind must not be read as a repository nobody can open.
    latest=$(SOPS_AGE_KEY_FILE="$age_key_file" \
        restic --repo "$repo" --password-command "$password_command" \
        snapshots --no-lock --json 2>"$probe_err" | jq -r 'max_by(.time).time // empty')

    if [ -z "$latest" ]; then
        # A target that is down is the skip the backup itself recorded; only a
        # repository that answers and still cannot be read needs a person.
        if reason=$("$unreachable_reason" "$probe_err"); then
            if verdict=$(away_verdict "$name" "$reason" "$max_age"); then
                unreachable="${unreachable}  ${name}: $verdict"$'\n'
                unreachable_count=$((unreachable_count + 1))
            else
                overdue="${overdue}  ${name}: target away — $verdict"$'\n'
                overdue_count=$((overdue_count + 1))
            fi
        else
            unchecked="${unchecked}  ${name}: no snapshots, or repo unreadable"$'\n'
            unchecked_count=$((unchecked_count + 1))
        fi
        continue
    fi

    age_days=$(( (now - $(date -d "$latest" +%s)) / 86400 ))
    if [ "$age_days" -gt "$max_age" ]; then
        overdue="${overdue}  ${name}: newest snapshot ${age_days}d old (limit ${max_age}d), ${latest:0:10}"$'\n'
        overdue_count=$((overdue_count + 1))
    else
        ok_count=$((ok_count + 1))
        echo "ok: $name — newest snapshot ${age_days}d old (limit ${max_age}d)"
    fi
done

# --- everything else: time since the last successful run

# fd 3, not stdin: an ssh in here would otherwise drain the records still to read.
while IFS=$'\t' read -r -u 3 kind unit host days witness; do
    [ -n "$kind" ] || continue
    if [ "$kind" = file ]; then
        continue
    fi
    # Everything else has to be a unit line. A record kind this does not know
    # would otherwise be read as one, with empty fields, and check nothing.
    if [ "$kind" != unit ]; then
        echo "overdue-conf printed a record this check cannot read: $kind" >&2
        exit 2
    fi

    limit=$((days + extra_days))
    label="$unit ($host)"

    last=$(last_success "$host" "$unit" "$witness")
    case $? in
        2)
            unreachable="${unreachable}  ${label}: $host not reachable"$'\n'
            unreachable_count=$((unreachable_count + 1))
            continue ;;
        1|3)
            overdue="${overdue}  ${label}: no successful run on record (limit ${limit}d)"$'\n'
            overdue_count=$((overdue_count + 1))
            continue ;;
    esac

    age_days=$(( (now - last) / 86400 ))
    if [ "$age_days" -gt "$limit" ]; then
        overdue="${overdue}  ${label}: ${age_days}d since last success (limit ${limit}d), $(date -d "@$last" +%F)"$'\n'
        overdue_count=$((overdue_count + 1))
    else
        ok_count=$((ok_count + 1))
        echo "ok: $label — ${age_days}d since last success (limit ${limit}d)"
    fi
done 3<<<"$unit_records"

[ -n "$unreachable" ] && printf 'Not checked, target away:\n%s' "$unreachable"

message=""
[ -n "$overdue" ] && message="Overdue:"$'\n'"$overdue"
[ -n "$unchecked" ] && message="${message}Could not check:"$'\n'"$unchecked"
[ -n "$message" ] && message="${message}"$'\n'"$ok_count unit(s) fine."

# On a phone the subject is the whole alert until someone opens it, so it names
# the counts and the first unit behind them. It also has to differ between runs:
# Proton threads by subject and participants, and a subject that never changes
# folds every alert this host ever sent into one conversation.
#
# Overdue leads when both are present. A unit past its bound is the alarm;
# evidence that could not be read is a second-order problem, and its count says
# enough. The words are the body's two section headings, so the subject and what
# it opens onto name the same things.
alert_subject() {
    local first more
    if [ "$overdue_count" -gt 0 ]; then
        first=$(head -1 <<<"$overdue" | sed 's/^  //; s/: .*//')
        more=""
        [ "$overdue_count" -gt 1 ] && more=" +$((overdue_count - 1))"
        printf '🕸️ %d overdue: %s%s' "$overdue_count" "$first" "$more"
        [ "$unchecked_count" -gt 0 ] && printf ' (+%d unchecked)' "$unchecked_count"
        return 0
    fi
    first=$(head -1 <<<"$unchecked" | sed 's/^  //; s/: .*//')
    more=""
    [ "$unchecked_count" -gt 1 ] && more=" +$((unchecked_count - 1))"
    printf '🕸️ %d unchecked: %s%s' "$unchecked_count" "$first" "$more"
    return 0
}

# A dry run neither sends nor records — it is a rehearsal, and the other host
# should not read its line as the watchdog's own timer still firing.
if [ "$dry_run" = true ]; then
    if [ -z "$message" ]; then
        echo "All $ok_count monitored unit(s) are within their bounds."
        exit 0
    fi
    echo "Subject: $(alert_subject)"
    echo "$message"
    echo "--dry-run: nothing sent"
    exit 1
fi

# The findings go out by email before the run is recorded, so the record can
# say what became of them.
alert=""
if [ -n "$message" ]; then
    echo "$message" >&2
    if "$alert_send_bin" "$(alert_subject)" <<<"$message"; then
        alert="delivered"
    else
        alert="delivery failed (alert-send exited $?)"
    fi
fi

# `ok` means the check completed and whatever it found went out. A run whose
# alert could not be delivered is recorded as `fail`: that is what makes a dead
# channel visible — a red dashboard row here, and once the ok lines stop, an
# alert from the other host, which watches this unit's run log (ADR 0002).
# Recording still never decides the exit code below.
outcome=ok
reason_args=()
if [ -n "$alert" ] && [ "$alert" != "delivered" ]; then
    outcome=fail
    reason_args=(--reason "found overdue units but the alert was not delivered")
fi
"$run_log_bin" overdue-check "$outcome" "${reason_args[@]}" --stats "$(jq -n \
    --argjson overdue "$overdue_count" \
    --argjson unchecked "$unchecked_count" \
    --argjson unreachable "$unreachable_count" \
    --argjson ok "$ok_count" \
    --arg alert "$alert" \
    '$ARGS.named | if .alert == "" then del(.alert) else . end')" || true

if [ -z "$message" ]; then
    echo "All $ok_count monitored unit(s) are within their bounds."
    exit 0
fi

exit 1
