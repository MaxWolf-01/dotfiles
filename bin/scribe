<script>
const D = JSON.parse(document.getElementById("data").textContent)
const PAL = { day: __PALETTE_LIGHT__, night: __PALETTE_DARK__ }
const $ = (s) => document.querySelector(s)
const NS = "http://www.w3.org/2000/svg"
const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c])
const hms = (t) => { t = Math.round(t); const h = Math.floor(t / 3600), m = Math.floor(t % 3600 / 60), s = t % 60, p = (n) => String(n).padStart(2, "0"); return h ? `${h}:${p(m)}:${p(s)}` : `${m}:${p(s)}` }
const svg = (tag, attrs = {}, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs) e.setAttribute(k, attrs[k]); if (parent) parent.append(e); return e }
const root = document.documentElement
const turnById = Object.fromEntries(D.turns.map((t) => [t.id, t]))
const spk = Object.fromEntries(D.speakers.map((s) => [s.id, s]))
const people = D.speakers.filter((s) => s.kind === "person")
const A = D.analysis, S = D.stats, dur = D.meta.duration
const colour = (id) => { const s = spk[id]; if (!s || s.c < 0) return "var(--muted)"; return `var(--s${s.c})` }

function paintPalette() {
  const night = root.dataset.theme === "night"
  PAL[night ? "night" : "day"].forEach((c, i) => root.style.setProperty(`--s${i}`, c))
}
const theme = new URLSearchParams(location.search).get("theme")
const setTheme = (night) => { root.dataset.theme = night ? "night" : "day"; paintPalette(); drawCharts(); drawMini() }
$("#scheme").addEventListener("click", () => setTheme(root.dataset.theme !== "night"))

// references like [t12, t40] become time links
const refs = (text) => esc(text).replace(/\s*\[(t\d+(?:\s*,\s*t\d+)*)\]/g, (_, ids) => {
  const shown = ids.split(",").map((x) => x.trim()).filter((x) => turnById[x])
  return shown.length ? ` <span class="refs">(${shown.map((x) => `<a class="ref" href="#${x}" data-t="${x}">${esc(spk[turnById[x].spk]?.name)} ${hms(turnById[x].s)}</a>`).join("; ")})</span>` : ""
})
const refList = (ids, text = "") => (ids || []).filter((x) => turnById[x] && !new RegExp(`\\b${x}\\b`).test(text)).map((x) => `<a class="ref" href="#${x}" data-t="${x}">${esc(spk[turnById[x].spk]?.name)} ${hms(turnById[x].s)}</a>`).join(" ")

// ---------------------------------------------------------------- header and notes
const title = A.title || D.meta.source.replace(/\.[^.]+$/, "")
$("#title").textContent = title
document.title = title
if (!A.generated) for (const el of document.querySelectorAll(".notes")) el.classList.add("hidden")
$("#summary").innerHTML = refs(A.summary)
$("#meta").textContent = [D.meta.date, hms(dur), `${people.length} speakers`, `${S.words.toLocaleString("en")} words`].join("  ·  ").toLowerCase()
$("#foot").textContent = [D.meta.source, `transcribed by ${D.meta.transcription}`, A.generated && `notes by claude ${A.generated.model}`, `built ${D.built}`].filter(Boolean).join(" · ").toLowerCase()

const sketch = Object.fromEntries((A.people || []).map((p) => [p.speaker, p.sketch]))
$("#people").innerHTML = people.map((p) => {
  const pp = S.per_person[p.id]
  return `<div class="person"><div class="row"><span class="dot" style="background:${colour(p.id)}"></span><span class="v-h3">${esc(p.name)}</span><span class="v-meta">${pp.share}% · ${hms(pp.airtime)} · ${pp.words.toLocaleString("en")} words</span></div>
    <div class="bar"><i style="width:${pp.share}%;background:${colour(p.id)}"></i></div>
    <p class="v-small muted">${refs(sketch[p.name] || "")}</p></div>`
}).join("")

const chapters = (A.chapters || []).map((c, i, all) => {
  const s = turnById[c.start_turn].s
  const e = i + 1 < all.length ? turnById[all[i + 1].start_turn].s : dur
  return { ...c, s, e }
})
function mixIn(s, e) {
  const share = {}
  for (const p of people) share[p.id] = 0
  const b = S.bin
  for (const p of people) S.lanes[p.id].forEach((v, i) => { const t = i * b; if (t >= s && t < e) share[p.id] += v })
  const tot = Object.values(share).reduce((a, x) => a + x, 0) || 1
  return people.map((p) => ({ id: p.id, f: share[p.id] / tot }))
}
$("#chapters").innerHTML = chapters.map((c) => {
  const mix = mixIn(c.s, c.e).filter((m) => m.f > 0.01).map((m) => `<i title="${esc(spk[m.id].name)} ${Math.round(m.f * 100)}%" style="flex:${m.f};background:${colour(m.id)}"></i>`).join("")
  return `<li><a class="v-meta ref" href="#${c.start_turn}" data-t="${c.start_turn}">${hms(c.s)}</a><div><a class="v-h3" href="#${c.start_turn}" data-t="${c.start_turn}">${esc(c.title)}</a>
    <span class="v-meta"> ${Math.round((c.e - c.s) / 60)} min</span><div class="mix">${mix}</div><p class="v-small muted measure">${refs(c.summary)}</p></div></li>`
}).join("")

for (const key of ["follow_ups", "open_threads"]) {
  const items = A[key] || []
  $("#" + key).innerHTML = items.length ? items.map((x) => `<li class="v-small">${refs(x.text)} ${refList(x.turns, x.text)}</li>`).join("") : `<li class="v-small muted">none found</li>`
}
$("#quotes").innerHTML = (A.quotes || []).map((q) => {
  const t = turnById[q.turn]
  return `<div class="quote"><p class="q">"${esc(q.text)}"</p><p class="v-meta"><a class="ref" href="#${t.id}" data-t="${t.id}">${esc(spk[t.spk]?.name)} ${hms(t.s)}</a></p><p class="v-small muted">${refs(q.note)}</p></div>`
}).join("")
$("#mentions").innerHTML = (A.mentions || []).map((m) =>
  `<div class="v-small"><span style="color:var(--strong);font-weight:600">${esc(m.name)}</span> <span class="v-meta">${esc(m.kind)}</span> <span class="muted">${refs(m.note)}</span> ${refList(m.turns, m.note)}</div>`).join("")

// ---------------------------------------------------------------- transcript
const starts = Object.fromEntries(chapters.map((c) => [c.start_turn, c]))
$("#transcript").innerHTML = D.turns.map((t) => {
  const ch = starts[t.id] ? `<h3 class="v-h3" id="ch-${t.id}">${esc(starts[t.id].title)} <span class="v-meta">${hms(t.s)}</span></h3>` : ""
  const s = spk[t.spk] || { name: t.spk }
  const words = t.w.map(([x]) => { const lead = x.match(/^\s*/)[0]; return `${lead}<span class="w">${esc(x.slice(lead.length))}</span>` }).join("")
  return `${ch}<div class="turn" id="${t.id}" style="--c:${colour(t.spk)}"><span class="ts v-meta" data-play="${t.s}">${hms(t.s)}</span><p class="body"><span class="who">${esc(s.name)}</span>${words}</p></div>`
}).join("")
const turnEls = D.turns.map((t) => document.getElementById(t.id))
const wordEls = [...document.querySelectorAll("#transcript .w")]
const wordStarts = D.turns.flatMap((t) => t.w.map((w) => w[1]))
const lastAtOrBefore = (xs, v) => { let lo = 0, hi = xs.length - 1; while (lo < hi) { const m = (lo + hi + 1) >> 1; if (xs[m] <= v) lo = m; else hi = m - 1 } return lo }
const turnStarts = D.turns.map((t) => t.s)
const turnAt = (time) => lastAtOrBefore(turnStarts, time)

const audio = $("#audio")
// the report travels without its audio as often as with it: a missing file hides the player
const sources = [D.audio, D.share?.url].filter(Boolean)
let hasAudio = sources.length > 0
const noAudio = () => { hasAudio = false; $("#player").style.display = "none"; $(".follow").style.display = "none"; $(".rail").classList.add("noaudio"); document.body.classList.remove("hasaudio"); document.body.classList.add("noaudio"); $("#plays").textContent = "" }
const tryNext = () => {
  const src = sources.shift()
  if (!src) return noAudio()
  audio.src = src
  $("#plays").textContent = src === D.share?.url && D.share.until ? `the audio plays from a shared link until ${D.share.until}` : ""
}
audio.addEventListener("error", tryNext)
if (hasAudio) { document.body.classList.add("hasaudio"); tryNext() } else noAudio()
function jump(id, play) {
  const el = document.getElementById(id); if (!el) return
  el.scrollIntoView({ behavior: "smooth", block: "start" })
  el.classList.remove("flash"); void el.offsetWidth; el.classList.add("flash"); setTimeout(() => el.classList.remove("flash"), 1400)
  if (play && hasAudio) { audio.currentTime = turnById[id].s; audio.play() }
}
document.addEventListener("click", (ev) => {
  const a = ev.target.closest("[data-t]"); if (a) { ev.preventDefault(); jump(a.dataset.t, false); history.replaceState(null, "", "#" + a.dataset.t); return }
  const p = ev.target.closest("[data-play]"); if (p && hasAudio) { audio.currentTime = +p.dataset.play; audio.play(); return }
  // a click on a word plays from that word; a drag that selects text does not
  const w = ev.target.closest("#transcript .w")
  if (w && hasAudio && !String(getSelection())) { audio.currentTime = wordStarts[wordEls.indexOf(w)]; audio.play() }
})
let current = -1
// ---------------------------------------------------------------- player controls
const total = () => (isFinite(audio.duration) && audio.duration) || dur
const seek = $("#seek"), speed = $("#speed")
let dragging = false
const fill = (el, p) => el.style.setProperty("--p", p + "%")
function setSpeed(r) {
  r = Math.round(Math.min(4, Math.max(0.5, r)) * 20) / 20
  audio.playbackRate = r; speed.value = r; fill(speed, ((r - 0.5) / 3.5) * 100)
  $("#rate").textContent = r.toFixed(2) + "×"
  try { localStorage.setItem("scribe-speed", r) } catch {}
}
speed.addEventListener("input", () => setSpeed(+speed.value))
$("#rate").addEventListener("click", () => setSpeed(1))
try { setSpeed(+(localStorage.getItem("scribe-speed") || 1)) } catch { setSpeed(1) }
const toggle = () => (audio.paused ? audio.play() : audio.pause())
const nudge = (s) => { audio.currentTime = Math.max(0, Math.min(total(), audio.currentTime + s)) }
$("#play").addEventListener("click", toggle)
for (const b of document.querySelectorAll("[data-skip]")) b.addEventListener("click", () => nudge(+b.dataset.skip))
// YouTube's keys; space and up/down keep scrolling the page
document.addEventListener("keydown", (ev) => {
  if (!hasAudio || ev.ctrlKey || ev.metaKey || ev.altKey || ev.target.closest("input, textarea")) return
  const act = { k: toggle, j: () => nudge(-10), l: () => nudge(10), ArrowLeft: () => nudge(-5), ArrowRight: () => nudge(5), "<": () => setSpeed(audio.playbackRate - 0.25), ">": () => setSpeed(audio.playbackRate + 0.25) }[ev.key]
  if (act) { ev.preventDefault(); act() }
})
seek.addEventListener("input", () => { dragging = true; audio.currentTime = (seek.value / 1000) * total(); follow(true) })
seek.addEventListener("change", () => { dragging = false })

// Follow the current word. The view scrolls only when that word leaves the middle of the
// screen, and not for 8 s after the reader scrolls on their own.
let curWord = -1, scrolledByReader = 0, scrollingUntil = 0
addEventListener("wheel", () => (scrolledByReader = Date.now()), { passive: true })
addEventListener("touchmove", () => (scrolledByReader = Date.now()), { passive: true })
function follow(jumped) {
  const t = audio.currentTime, p = (100 * t) / total()
  $("#tcur").textContent = hms(t); $("#ttot").textContent = hms(total())
  if (!dragging) seek.value = Math.round(p * 10)
  fill(seek, p)
  const c = chapterAt(t); $("#nowch").textContent = c ? c.title : ""
  const started = t > 0 || !audio.paused
  const ti = started ? turnAt(t) : -1
  if (ti !== current) { turnEls[current]?.classList.remove("now"); current = ti; turnEls[ti]?.classList.add("now") }
  const wi = started && wordStarts.length ? lastAtOrBefore(wordStarts, t) : -1
  if (wi !== curWord) { wordEls[curWord]?.classList.remove("cur"); curWord = wi; wordEls[wi]?.classList.add("cur") }
  drawCursor()
  const now = Date.now(), el = wordEls[wi] || turnEls[ti]
  if (!el || !$("#followbox").checked) return
  if (!jumped && (now < scrollingUntil || audio.paused || now - scrolledByReader < 8000)) return
  const r = el.getBoundingClientRect(), dy = r.top - innerHeight * 0.38
  if (r.top < innerHeight * 0.2 || r.bottom > innerHeight * 0.7) {
    // a jump, or a gap of more than a screen and a half, moves at once; drifting while playing glides
    const far = jumped || Math.abs(dy) > innerHeight * 1.5
    scrollBy({ top: dy, behavior: far ? "auto" : "smooth" })
    scrollingUntil = far ? 0 : now + 500
  }
}
let raf = 0
const tick = () => { follow(false); if (!audio.paused) raf = requestAnimationFrame(tick) }
audio.addEventListener("play", () => { document.body.classList.add("playing"); cancelAnimationFrame(raf); tick() })
audio.addEventListener("pause", () => { document.body.classList.remove("playing"); follow(false) })
audio.addEventListener("seeked", () => follow(true))
audio.addEventListener("loadedmetadata", () => follow(false))

// ---------------------------------------------------------------- tooltip
const tip = $("#tip")
const showTip = (ev, html) => { tip.innerHTML = html; tip.style.opacity = 1; const x = Math.min(ev.clientX + 14, innerWidth - tip.offsetWidth - 8); tip.style.left = x + "px"; tip.style.top = (ev.clientY + 14) + "px" }
const hideTip = () => { tip.style.opacity = 0 }
const chapterAt = (t) => chapters.find((c) => t >= c.s && t < c.e)

// ---------------------------------------------------------------- charts
function frame(title, caption) {
  const d = document.createElement("div"); d.className = "chart"
  d.innerHTML = `<p class="v-h3" style="margin-bottom:0.6rem">${title}</p>`
  const s = svg("svg"), wrap = document.createElement("div")
  wrap.className = "scroll"; wrap.append(s); d.append(wrap)
  if (caption) { const c = document.createElement("p"); c.className = "cap v-small muted"; c.textContent = caption; d.append(c) }
  return [d, s]
}
function timeAxis(g, x, y, w) {
  // the smallest round step that leaves room for a label such as 1:00:00 between ticks
  const perSecond = (x(dur) - x(0)) / dur
  const step = [30, 60, 120, 300, 600, 900, 1800, 3600, 7200].find((s) => s * perSecond >= 64) || 7200
  for (let t = 0; t <= dur; t += step) {
    svg("line", { x1: x(t), x2: x(t), y1: 0, y2: y, stroke: "var(--edge)", "stroke-width": 1 }, g)
    svg("text", { x: x(t), y: y + 16, "text-anchor": x(t) > x(dur) - 30 ? "end" : "middle", fill: "var(--muted)", "font-family": "var(--font-mono)", "font-size": 11 }, g).textContent = hms(t)
  }
}

function drawTimeline(box) {
  const [d, s] = frame("Who spoke when", `Each lane is one person; the darker a ${S.bin}-second slot, the more of it they spent talking. The band on top is the chapters; the bars under the lanes count how often the floor changed hands each minute.`)
  box.append(d)
  const W = Math.max(560, d.clientWidth || 900), L = 90, lane = 22, gap = 6, top = 26, H = top + people.length * (lane + gap) + 70
  s.setAttribute("viewBox", `0 0 ${W} ${H}`); s.style.minWidth = W + "px"
  const x = (t) => L + (t / dur) * (W - L - 4)
  chapters.forEach((c, i) => {
    const r = svg("rect", { x: x(c.s) + 1, y: 0, width: Math.max(1, x(c.e) - x(c.s) - 2), height: 16, rx: 2, fill: i % 2 ? "var(--wash-ink)" : "var(--ground-2)", stroke: "var(--edge)", "stroke-width": 1, style: "cursor:pointer" }, s)
    r.addEventListener("mousemove", (ev) => showTip(ev, `<span class="v-meta">${hms(c.s)} to ${hms(c.e)}</span><br><b>${esc(c.title)}</b>`))
    r.addEventListener("mouseleave", hideTip)
    r.addEventListener("click", () => jump(c.start_turn))
    const room = x(c.e) - x(c.s) - 10, fit = Math.floor(room / 6.2)
    if (fit >= 6) {
      const label = svg("text", { x: x(c.s) + 6, y: 12, fill: "var(--muted)", "font-size": 10.5, "pointer-events": "none" }, s)
      label.textContent = c.title.length > fit ? c.title.slice(0, fit - 1) + "…" : c.title
    }
  })
  people.forEach((p, i) => {
    const y0 = top + i * (lane + gap)
    svg("text", { x: L - 10, y: y0 + lane / 2 + 4, "text-anchor": "end", fill: "var(--body)", "font-size": 13 }, s).textContent = p.name
    svg("rect", { x: L, y: y0, width: W - L - 4, height: lane, fill: "var(--wash-ink)", rx: 2 }, s)
    const bw = Math.max(1, (S.bin / dur) * (W - L - 4))
    S.lanes[p.id].forEach((v, k) => { if (v > 0.02) svg("rect", { x: x(k * S.bin), y: y0, width: bw + 0.4, height: lane, fill: colour(p.id), opacity: (0.15 + 0.85 * v).toFixed(2) }, s) })
  })
  const yb = top + people.length * (lane + gap) + 4, bh = 30
  const maxv = Math.max(1, ...S.per_minute)
  S.per_minute.forEach((v, m) => {
    const h = (v / maxv) * bh
    svg("rect", { x: x(m * 60) + 1, y: yb + bh - h, width: Math.max(1, x(60) - x(0) - 2), height: h, fill: "var(--muted)", rx: 1, opacity: 0.7 }, s)
  })
  svg("text", { x: L - 10, y: yb + bh - 2, "text-anchor": "end", fill: "var(--muted)", "font-family": "var(--font-mono)", "font-size": 11 }, s).textContent = "handovers"
  const g = svg("g", { transform: `translate(0, ${yb + bh + 2})` }, s)
  timeAxis(g, x, 0, W)
  const hit = svg("rect", { x: L, y: top, width: W - L - 4, height: people.length * (lane + gap) + bh + 4, fill: "transparent", style: "cursor:pointer" }, s)
  const cursor = svg("line", { y1: 0, y2: yb + bh, stroke: "var(--strong)", "stroke-width": 1, opacity: 0 }, s)
  const tAt = (ev) => { const r = s.getBoundingClientRect(); return Math.max(0, Math.min(dur, ((ev.clientX - r.left) * (W / r.width) - L) / (W - L - 4) * dur)) }
  hit.addEventListener("mousemove", (ev) => {
    const t = tAt(ev), k = Math.floor(t / S.bin), c = chapterAt(t)
    cursor.setAttribute("x1", x(t)); cursor.setAttribute("x2", x(t)); cursor.setAttribute("opacity", 0.5)
    const who = people.filter((p) => S.lanes[p.id][k] > 0.05).map((p) => `<span class="dot" style="background:${colour(p.id)}"></span> ${esc(p.name)} ${Math.round(S.lanes[p.id][k] * 100)}%`).join("<br>")
    showTip(ev, `<span class="v-meta">${hms(t)}${c ? " · " + esc(c.title) : ""}</span><br>${who || '<span class="muted">nobody</span>'}<br><span class="v-meta">${S.per_minute[Math.floor(t / 60)] ?? 0} handovers that minute · click to read</span>`)
  })
  hit.addEventListener("mouseleave", () => { hideTip(); cursor.setAttribute("opacity", 0) })
  hit.addEventListener("click", (ev) => jump(D.turns[turnAt(tAt(ev))].id))
}

function drawCumulative(box) {
  const [d, s] = frame("Talking time, adding up", "Minutes each person has talked since the start. A steeper line means they held the floor more in that stretch; where lines cross, one person overtook another.")
  box.append(d)
  const W = d.clientWidth || 440, H = 240, L = 36, R = 80, T = 8, B = 26
  s.setAttribute("viewBox", `0 0 ${W} ${H}`)
  const n = S.per_minute.length, maxv = Math.max(1, ...people.map((p) => S.cumulative[p.id][n - 1]))
  const x = (m) => L + (m / n) * (W - L - R), y = (v) => T + (1 - v / maxv) * (H - T - B)
  for (let v = 0; v <= maxv; v += Math.max(1, Math.ceil(maxv / 4 / 5) * 5)) {
    svg("line", { x1: L, x2: W - R, y1: y(v), y2: y(v), stroke: "var(--edge)", "stroke-width": 1 }, s)
    svg("text", { x: L - 6, y: y(v) + 4, "text-anchor": "end", fill: "var(--muted)", "font-family": "var(--font-mono)", "font-size": 11 }, s).textContent = v
  }
  const g = svg("g", { transform: `translate(0, ${H - B})` }, s)
  timeAxis(g, (t) => x(t / 60), 0, W)
  people.forEach((p) => {
    const pts = [[x(0), y(0)], ...S.cumulative[p.id].map((v, m) => [x(m + 1), y(v)])]
    svg("path", { d: "M" + pts.map((q) => q.join(",")).join("L"), fill: "none", stroke: colour(p.id), "stroke-width": 2, "stroke-linejoin": "round" }, s)
    const last = pts[pts.length - 1]
    svg("text", { x: last[0] + 6, y: last[1] + 4, fill: "var(--body)", "font-size": 12 }, s).textContent = `${p.name} ${Math.round(S.cumulative[p.id][n - 1])}`
  })
  const hit = svg("rect", { x: L, y: T, width: W - L - R, height: H - T - B, fill: "transparent" }, s)
  const cursor = svg("line", { y1: T, y2: H - B, stroke: "var(--strong)", "stroke-width": 1, opacity: 0 }, s)
  hit.addEventListener("mousemove", (ev) => {
    const r = s.getBoundingClientRect(), m = Math.max(0, Math.min(n - 1, Math.floor(((ev.clientX - r.left) * (W / r.width) - L) / (W - L - R) * n)))
    cursor.setAttribute("x1", x(m + 1)); cursor.setAttribute("x2", x(m + 1)); cursor.setAttribute("opacity", 0.5)
    showTip(ev, `<span class="v-meta">at ${hms((m + 1) * 60)}</span><br>` + people.map((p) => `<span class="dot" style="background:${colour(p.id)}"></span> ${esc(p.name)} ${S.cumulative[p.id][m].toFixed(1)} min`).join("<br>"))
  })
  hit.addEventListener("mouseleave", () => { hideTip(); cursor.setAttribute("opacity", 0) })
}

function drawHandover(box) {
  const [d, s] = frame("Who hands the floor to whom", "Each cell counts how often the row's speaker was followed directly by the column's.")
  box.append(d)
  const n = people.length, cell = Math.max(44, 8 * Math.max(...people.map((p) => p.name.length))), L = 90, T = 22, W = L + n * cell + 8, H = T + n * cell + 4
  s.setAttribute("viewBox", `0 0 ${W} ${H}`); s.style.maxWidth = W + "px"
  const all = people.flatMap((a) => people.map((b) => S.handover[a.id][b.id])), maxv = Math.max(1, ...all)
  people.forEach((b, j) => svg("text", { x: L + j * cell + cell / 2, y: T - 8, "text-anchor": "middle", fill: "var(--muted)", "font-size": 12 }, s).textContent = b.name)
  people.forEach((a, i) => {
    svg("text", { x: L - 8, y: T + i * cell + cell / 2 + 4, "text-anchor": "end", fill: "var(--body)", "font-size": 13 }, s).textContent = a.name
    people.forEach((b, j) => {
      const v = S.handover[a.id][b.id]
      const r = svg("rect", { x: L + j * cell + 1, y: T + i * cell + 1, width: cell - 2, height: cell - 2, rx: 3, fill: i === j ? "var(--wash-ink)" : "var(--accent)", "fill-opacity": i === j ? 1 : (0.08 + 0.8 * v / maxv).toFixed(2) }, s)
      if (i !== j) {
        svg("text", { x: L + j * cell + cell / 2, y: T + i * cell + cell / 2 + 4, "text-anchor": "middle", fill: v / maxv > 0.55 ? "var(--ground)" : "var(--body)", "font-family": "var(--font-mono)", "font-size": 12 }, s).textContent = v
        r.addEventListener("mousemove", (ev) => showTip(ev, `${esc(a.name)} → ${esc(b.name)}: <b>${v}</b> times`))
        r.addEventListener("mouseleave", hideTip)
      }
    })
  })
}

function drawTable(box) {
  const d = document.createElement("div"); d.className = "chart"
  const rows = [
    ["Talking time", (p) => hms(p.airtime)], ["Share of talking time", (p) => p.share + "%"], ["Words", (p) => p.words.toLocaleString("en")],
    ["Words per minute", (p) => p.wpm], ["Turns", (p) => p.turns], ["Average turn", (p) => p.avg_turn + " s"],
    ["Longest turn", (p) => `<a class="ref" href="#${p.longest_turn_id}" data-t="${p.longest_turn_id}">${p.longest_turn} s</a>`],
    ["Median pause before speaking", (p) => p.median_gap == null ? "" : p.median_gap + " s"],
  ]
  const note = `Computed from the times of the transcript's words. The pause before speaking runs from the previous speaker's last word to this speaker's first. The floor changed hands ${S.turn_changes.toLocaleString("en")} times, ${S.changes_per_minute} times a minute on average.`
  d.innerHTML = `<p class="v-h3" style="margin-bottom:0.6rem">Per person</p><div class="scroll"><table><thead><tr><th></th>${people.map((p) => `<th><span class="dot" style="background:${colour(p.id)}"></span> ${esc(p.name)}</th>`).join("")}</tr></thead><tbody>${
    rows.map(([label, f]) => `<tr><td>${label}</td>${people.map((p) => `<td>${f(S.per_person[p.id])}</td>`).join("")}</tr>`).join("")}</tbody></table></div>
    <p class="cap v-small muted" style="margin-top:0.6rem">${note} The longest silence is ${S.longest_silence.sec} s, at ${hms(S.longest_silence.at)}; the floor changed hands most often at ${hms(S.busiest_minute.minute * 60)}, ${S.busiest_minute.changes} times in that minute.</p>`
  box.append(d)
}

function drawCharts() {
  const box = $("#charts"); box.innerHTML = ""
  drawTimeline(box)
  const two = document.createElement("div"); two.className = "two"; box.append(two)
  drawCumulative(two); drawHandover(two)
  drawTable(box)
}

// ---------------------------------------------------------------- minimap beside the transcript
let miniState = null
function drawMini() {
  const box = $("#mini"); box.innerHTML = ""
  const W = box.clientWidth || 200, H = box.clientHeight || 500
  const s = svg("svg", { viewBox: `0 0 ${W} ${H}`, preserveAspectRatio: "none" }, box)
  const lw = Math.min(14, (W * 0.35) / Math.max(1, people.length)), L = 4
  const y = (t) => (t / dur) * H
  people.forEach((p, i) => {
    const x0 = L + i * (lw + 2)
    S.lanes[p.id].forEach((v, k) => { if (v > 0.05) svg("rect", { x: x0, y: y(k * S.bin), width: lw, height: Math.max(1, y(S.bin)) + 0.3, fill: colour(p.id), opacity: (0.2 + 0.8 * v).toFixed(2) }, s) })
  })
  const tx = L + people.length * (lw + 2) + 6
  chapters.forEach((c) => {
    svg("line", { x1: tx - 4, x2: W, y1: y(c.s), y2: y(c.s), stroke: "var(--edge)", "stroke-width": 1 }, s)
    const fit = Math.floor((W - tx) / 5.4)
    if (y(c.e) - y(c.s) > 13) svg("text", { x: tx, y: y(c.s) + 12, fill: "var(--muted)", "font-size": 11 }, s).textContent = c.title.length > fit ? c.title.slice(0, fit - 1) + "…" : c.title
  })
  const view = svg("rect", { x: 0, width: W, fill: "var(--wash)", stroke: "var(--accent)", "stroke-width": 1, rx: 2 }, s)
  const cur = svg("line", { x1: 0, x2: W, stroke: "var(--accent)", "stroke-width": 2, opacity: 0 }, s)
  miniState = { view, cur, y }
  s.addEventListener("click", (ev) => { const r = s.getBoundingClientRect(); jump(D.turns[turnAt((ev.clientY - r.top) / r.height * dur)].id) })
  s.addEventListener("mousemove", (ev) => { const r = s.getBoundingClientRect(), t = (ev.clientY - r.top) / r.height * dur, c = chapterAt(t); showTip(ev, `<span class="v-meta">${hms(t)}</span>${c ? "<br>" + esc(c.title) : ""}`) })
  s.addEventListener("mouseleave", hideTip)
  drawView(); drawCursor()
}
function drawView() {
  if (!miniState) return
  let first = null, last = null
  for (const el of turnEls) { const r = el.getBoundingClientRect(); if (r.bottom > 0 && r.top < innerHeight) { if (!first) first = el; last = el } }
  if (!first) { miniState.view.setAttribute("height", 0); return }
  const a = turnById[first.id].s, b = turnById[last.id].e
  miniState.view.setAttribute("y", miniState.y(a)); miniState.view.setAttribute("height", Math.max(2, miniState.y(b) - miniState.y(a)))
}
function drawCursor() {
  if (!miniState || !hasAudio) return
  miniState.cur.setAttribute("y1", miniState.y(audio.currentTime)); miniState.cur.setAttribute("y2", miniState.y(audio.currentTime))
  miniState.cur.setAttribute("opacity", audio.currentTime > 0 ? 1 : 0)
}
addEventListener("scroll", () => requestAnimationFrame(drawView), { passive: true })
addEventListener("resize", () => { drawCharts(); drawMini() })

// ---------------------------------------------------------------- export
$("#copy").addEventListener("click", async () => {
  try { await navigator.clipboard.writeText(D.md) } catch { const t = document.createElement("textarea"); t.value = D.md; document.body.append(t); t.select(); document.execCommand("copy"); t.remove() }
  $("#copy").textContent = "copied"; setTimeout(() => ($("#copy").textContent = "copy as markdown"), 1500)
})
$("#download").addEventListener("click", () => {
  const a = document.createElement("a")
  a.href = URL.createObjectURL(new Blob([D.md], { type: "text/markdown" }))
  a.download = `${D.meta.date}-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}.md`
  a.click()
})

setTheme(theme ? theme === "night" : matchMedia("(prefers-color-scheme: dark)").matches)
if (location.hash) setTimeout(() => jump(location.hash.slice(1)), 100)
</script>
</body>
</html>
