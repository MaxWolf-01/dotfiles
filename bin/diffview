#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Render diffs from several sources as ONE self-contained HTML review page.

The page is the human-in-the-loop review surface: file tree + side-by-side diff,
keyboard-driven (press ? in the page), line/hunk comments that export as markdown
via the copy button, ready to paste back to the authoring agent; the diff itself
copies too, as a patch, with those comments inline or without. Comments are saved
to a file beside the page and read back from it on load; only a page the container
hub serves can write it (see --serve); opened as a plain file, the page is read-only
and says so.

A changed image shows on its card, both versions side by side or overlaid, baked
into the page like the text around it; a version too big to bake says so on its
card. A card without lines (an image, any other binary file) takes a comment on the
file as a whole, and the export describes the image where a line comment quotes lines.

The page's own path is the review's identity: rendering to the same path again --
after review fixes, with the new range appended -- finds the comments already
there. Unnamed output lands in ~/Downloads/diffview under a name derived from the
sources, so unrelated renders never collide.

Source specs (positional, several allowed; one page with a section per source):
- REPO@A..B      git range in REPO (A...B also works)
- REPO@A..       A versus the working tree, uncommitted and untracked files included (HEAD.. = just those)
- REPO@A...      the branch's own work: where it forked from A versus the working tree. A.. also
                 shows what A gained since the fork, in reverse; A... does not, until a rebase or merge takes it in
- A..B           git range in the current directory
- OLD=NEW        two directories or two files, no git metadata needed

Examples:

    diffview 'v1.2..v1.3'
    diffview '~/.dotfiles@b60041c..master' '~/.dotfiles/secrets@e18667c..master'
    diffview 'old-config/=new-config/' --title "config migration"
"""

import base64
import fcntl
import hashlib
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Annotated

import tyro

# ---------------------------------------------------------------- CLI


@dataclass
class Args:
    sources: Annotated[list[str], tyro.conf.Positional]
    """Source specs: REPO@RANGE, RANGE (cwd), or OLD=NEW paths."""
    output: Annotated[str, tyro.conf.arg(aliases=["-o"])] = ""
    """Path of the generated HTML file. The path is the review's identity: render to it again and the comments already on it are still there. Leave this empty and the name is derived from the sources instead, under ~/Downloads/diffview, and that page is served by the container hub so it can take comments. A derived name is pinned to those exact diffs, so a review that will gain ranges over later rounds needs a path you choose."""
    summary: str = ""
    """One plain-English paragraph on what this change is about (shown at the top; inline markdown ok)."""
    auto_summary: bool = True
    """Generate the summary with `change-summary` after the page opens; it fills in when ready. Ignored when --summary is given; with --no-auto-summary, a watched page offers to write one on request."""
    summary_model: str = ""
    """Model for the auto-summary, passed to `change-summary --model`; empty keeps its default."""
    title: str = ""
    """Page title; derived from the sources when empty."""
    open: bool = False
    """Open the generated page in the browser ($DIFFVIEW_BROWSER, else xdg-open), served by the container hub so it can take comments."""
    watch: bool = False
    """Regenerate whenever the sources change; the page, served by the container hub, reloads itself on each change. Runs until Ctrl-C or until a repo it reads is removed, so start it as a background task; the page says when it has stopped and how to start it again. The summary is written once; the ↻ beside it says how far the diff has moved since and rewrites it on request. Starts fine on sources with no changes yet: the page says so and fills in. The written file stays a plain snapshot you can share."""
    notes: str = ""
    """JSON file holding the agent's side of the review, shown inline in the diff. Schema: {"notes": [{"id": 3, "path": "a/b.py", "text": "why this changed", "line": 42, "end": 44, "side": "new"|"old", "source": "~/repo"}], "resolved": ["C1", "C4"]}. A note's id is the handle the page shows as A3; ids must be unique. line/end/side/source are optional, a line-less note attaches to the whole file. source names the section a note belongs to, by that source's root (a repo's toplevel, or the NEW of an OLD=NEW), and the note lands in that section only; without one it lands in whichever section holds its path, the one holding its line first. A note on a file the diff does not touch puts that file on the page too (in its source's section, or the first holding it), read-only, opened at the noted lines (line-less: at its top; an image other than SVG, whole): the place to say what was read and deliberately left alone. A note with "re": "C4" answers that review comment: it sits under it, indented, and needs no path or line of its own; the thread can go on from there (the reviewer replies to a note with c or its reply button, and the reply carries "re A3"). Answering a comment does not resolve it. "resolved" lists the review comments the agent has addressed, written the way the export shows them. Note text is never part of the comment export; the export does name the notes the reviewer marked seen without replying, so silence and "read, fine" stay distinguishable. In --watch mode the page refreshes when this file changes."""
    serve: str = ""
    """Have the container hub (container-hub, on $CONTAINER_HUB_PORT, else 8377) serve this already-rendered page, or this directory of them, so they can save comments to disk, print its address there, and exit. Starts the hub when it is down: its user service where that is installed and serves the port, else a hub of its own. A page opened as a file cannot write anywhere, so it is read-only; served, it stores comments beside itself. Idempotent. A page cut off from the hub says so and keeps what you type in the browser until the hub is back: run this again."""
    context: int = 3
    """Context lines around each hunk (git diff -U)."""
    sources_of: str = ""
    """Print the sources the already-rendered page at this path shows, one spec a line, as the page pins them (REPO@A..B with short SHAs, A empty-ended for a worktree range; OLD=NEW as absolute paths), and exit."""


def main(args: Args) -> None:
    if args.serve:
        serve_root(args.serve)
        return
    if args.sources_of:
        print(*page_sources(Path(args.sources_of).expanduser()), sep="\n")
        return
    derived = not args.output
    out = Path(args.output).expanduser() if args.output else default_output(args.sources)
    out.parent.mkdir(parents=True, exist_ok=True)
    if derived:
        warn_displaced(out)
    if args.watch and (held_by := watch_record(out)) and held_by["alive"]:
        sys.exit(f"diffview: {out} is already watched by another diffview --watch; stop that one first")
    page = build(args, out, args.summary)
    if args.watch:
        watch(args, out, page)
        return
    drop_watch_record(out)
    # a derived page is the throwaway case, so serve it: the url this prints should be
    # one you can comment on, not a read-only file
    url = page_url(out) if args.open or derived else f"file://{out.resolve()}"
    print(url, flush=True)
    if args.open:
        launch(url)


def warn_displaced(out: Path) -> None:
    """An earlier page for these sources whose comments this render will not inherit."""
    stem = out.name.rsplit("-", 1)[0]
    for other in sorted(out.parent.glob(f"{stem}-*.html")):
        if other != out and state_path(other).is_file():
            print(f"diffview: {other.name} is an earlier page for {stem} and holds comments this one "
                  f"will not; -o keeps a review on one page across rounds", file=sys.stderr)
            return


def build(args: Args, out: Path, summary: str, awaiting: bool = False) -> dict:
    """Collect, render, write. Returns the page data, so watch mode can reuse the summary and stamp.

    awaiting says a summary asked for by an earlier build is still being written, so this
    page keeps the slot open for it rather than starting a second model call.
    """
    sources = [collect_source(spec, args.context) for spec in args.sources]
    empty = not any(s["files"] for s in sources)
    if empty and not args.watch:
        sys.exit("diffview: no changes found in any source")
    # under --watch an empty diff is a state the page shows, not an error: the work it is
    # meant to follow may not have started, and the page fills in as the sources change

    title = args.title or " + ".join(f"{s['label']} {s['detail']}" for s in sources)
    generate = not empty and not summary and args.auto_summary
    body = summary_body(sources) if generate else ""
    for s in sources:
        s.pop("_patch", None)

    saved = load_saved_state(state_path(out))
    notes, agent_resolved = load_notes(args.notes)
    name_sources(notes, sources, args.notes)
    inherit_anchors(notes, saved, sources, args.notes)
    size = diff_size(sources)   # of the changed files; the untouched cards that join next are not part of it
    attach_untouched(sources, notes, args.context)
    for s in sources:
        for f in s["files"]:
            if f["status"] in ("modified", "renamed") and f["hunks"]:   # what a gap between hunks opens from; a card without one shows no gap
                f["content"] = file_lines(s, f["path"])
            if image := image_versions(s, f):
                f["image"] = image
        s.pop("_sides", None)

    langs = {f["lang"] for s in sources for f in s["files"] if f["lang"]}

    data = {
        "title": title,
        "generated": datetime.now().astimezone().isoformat(timespec="seconds"),
        "sources": sources,
        "size": size,
        "context": args.context,
        "imageLimit": MAX_IMAGE_BYTES,
        "summary": summary,
        "summaryPending": generate or awaiting,
        "notes": notes,
        "agentResolved": agent_resolved,
        "saved": saved,
        "key": str(out.resolve()),
        "session": (session := origin_session()),
        "resume": resume_command(session) if session else "",
        # what to run again when the watcher is gone: the page has no other way to know it
        "restart": shlex.join([Path(sys.argv[0]).name, *sys.argv[1:]]) if args.watch else "",
    }

    hljs = fetch_hljs(langs)
    write_page(out, data, hljs)
    print(f"{out.resolve()}  ({size['files']} files, +{size['adds']} -{size['dels']}, {out.stat().st_size // 1024} KB)")
    if generate:
        finish_summary(out, body, args.summary_model, data, hljs, page_id(out))
    return data


def origin_session() -> str:
    """The Claude Code session the page was rendered for, empty outside one. A session that hands
    work to a separate `claude` process names itself in MX_ORIGIN_SESSION, since that process
    runs under an id of its own."""
    return os.environ.get("MX_ORIGIN_SESSION") or os.environ.get("CLAUDE_CODE_SESSION_ID", "")


def resume_command(session: str) -> str:
    """The command that picks the session up in the directory it ran in, which its transcript
    records; the newest transcript answers, since a session resumed elsewhere writes a second one.
    Without a transcript on this machine, or with its directory gone, the resume alone. A session
    of an account other than ~/.claude resumes under its own config dir, which the command names:
    the container hub, a user service, runs under none of them."""
    home = Path.home() / ".claude"
    configs = [Path(os.environ["CLAUDE_CONFIG_DIR"])] if os.environ.get("CLAUDE_CONFIG_DIR") else \
        [home, *sorted(p for p in Path.home().glob(".claude-*") if p.is_dir())]
    written = sorted((t for c in configs for t in (c / "projects").glob(f"*/{session}.jsonl")), key=lambda p: p.stat().st_mtime)
    account = f"CLAUDE_CONFIG_DIR={shlex.quote(str(written[-1].parents[2]))} " if written and written[-1].parents[2] != home else ""
    cwd = ""
    if written:
        with written[-1].open(errors="replace") as transcript:
            for line in transcript:
                if '"cwd"' not in line:
                    continue
                try:
                    cwd = json.loads(line).get("cwd") or ""
                except json.JSONDecodeError:
                    continue
                if cwd:
                    break
    if cwd and Path(cwd).is_dir():
        return f"cd {shlex.quote(cwd)} && {account}claude --resume {session}"
    return f"{account}claude --resume {session}"


def write_page(out: Path, data: dict, hljs: str) -> None:
    """Render the page and move it into place atomically, so no request sees it half written."""
    template = (Path(__file__).resolve().parent / "diffview.html").read_text()
    payload = json.dumps(data, ensure_ascii=False).replace("</", "<\\/").replace("<!--", "<\\u0021--")
    page = (
        template.replace("__TITLE__", data["title"].replace("<", "&lt;"))
        .replace("__HLJS__", hljs)
        .replace('"__DATA__"', payload)
    )
    tmp = out.with_name(f"{out.name}.{os.getpid()}.tmp")  # per-writer, so a background summary and a rebuild never share one
    tmp.write_text(page)
    os.replace(tmp, out)


def page_sources(page: Path) -> list[str]:
    """The spec of each source a rendered page shows, read from the data it carries."""
    try:
        text = page.read_text()
        data, _ = json.JSONDecoder().raw_decode(text, text.index("const DATA = ") + len("const DATA = "))
        specs = [s["spec"] for s in data["sources"]]
    except (OSError, ValueError, KeyError, TypeError) as e:
        sys.exit(f"diffview: {page} is no diffview page that names its sources ({type(e).__name__}: {e})")
    return specs


def state_path(out: Path) -> Path:
    return Path(str(out) + ".state.json")


def summary_path(out: Path) -> Path:
    return Path(str(out) + ".summary.json")


def page_id(out: Path) -> tuple[int, int]:
    """Which page is at this path right now. Every render replaces the file, so both halves change."""
    st = out.stat()
    return st.st_ino, st.st_mtime_ns


def load_sidecar(out: Path) -> dict:
    """What the background summary landed beside this page: the paragraph or the reason there is none, and the diff it saw."""
    try:
        sidecar = json.loads(summary_path(out).read_text())
    except (OSError, ValueError):
        return {}
    return sidecar if isinstance(sidecar, dict) else {}


def load_summary(out: Path) -> str:
    return load_sidecar(out).get("summary", "")


def write_summary(out: Path, summary: str, error: str, written_for: dict) -> None:
    """The summary sidecar. written_for is the diff size the paragraph describes, which is what lets a
    served page say how far the diff has moved since; the time of writing joins it, unless it is an
    earlier record going back as it was."""
    sidecar = summary_path(out)
    tmp = sidecar.with_name(f"{sidecar.name}.{os.getpid()}.tmp")
    record = {"at": datetime.now().astimezone().isoformat(timespec="seconds"), **written_for}
    tmp.write_text(json.dumps({"summary": summary, "error": error, "for": record}))
    os.replace(tmp, sidecar)


def diff_size(sources: list[dict]) -> dict:
    """How much diff there is: changed files, lines added, lines removed."""
    files = [f for s in sources for f in s["files"]]
    return {"files": len(files), "adds": sum(f["adds"] for f in files), "dels": sum(f["dels"] for f in files)}


def default_output(specs: list[str]) -> Path:
    """One page per source list: a readable stem plus a digest of the canonical specs.

    The stem is only there to be recognised; the digest does the distinguishing, and
    it follows the specs, so a page reached this way is pinned to the diffs it was
    rendered from. A review that will gain ranges over later rounds needs an explicit
    -o, which is what makes the growing page one review.
    """
    parts = [canonical_spec(s) for s in specs]
    digest = hashlib.sha256("\n".join(c for _, c in parts).encode()).hexdigest()[:8]
    stem = re.sub(r"[^A-Za-z0-9._-]+", "-", parts[0][0])[:40]
    return Path.home() / "Downloads" / "diffview" / f"{stem}-{digest}.html"


def canonical_spec(spec: str) -> tuple[str, str]:
    """(label, identity) — what a spec denotes rather than how it was typed.

    Both sides are canonical, so the same review names the same page from any
    directory, and a HEAD-relative range names a different one once another commit
    lands under it.
    """
    if "=" in spec and ".." not in spec.split("=")[0]:
        old, new = (str(Path(p).expanduser().resolve()) for p in spec.split("=", 1))
        return Path(new).name, f"{old}={new}"
    repo, range_ = spec.rsplit("@", 1) if "@" in spec else (".", spec)
    root = git_root(repo)
    return Path(root).name, f"{root}@{range_}@{resolved_revs(root, range_)}"


def git_root(repo: str) -> str:
    """The repo's toplevel, so a spec written from a subdirectory still names the repo."""
    path = str(Path(repo).expanduser().resolve())
    proc = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return proc.stdout.strip() or path


def resolved_revs(root: str, range_: str) -> str:
    """The range's endpoints as shas; empty when they don't resolve, which build reports properly."""
    try:
        revs = [diff_base(root, range_)] if is_worktree(range_) else [r for r in re.split(r"\.{2,3}", range_) if r]
    except SystemExit:
        return ""
    proc = subprocess.run(["git", "-C", root, "rev-parse", *revs], capture_output=True, text=True)
    return proc.stdout.strip() if proc.returncode == 0 else ""


def load_saved_state(sp: Path) -> dict | None:
    """Review state (comments, verdicts, seen marks) saved beside the page while it was served; None when there is none to read."""
    if not sp.is_file():
        return None
    try:
        saved = json.loads(sp.read_text())
    except (OSError, json.JSONDecodeError) as e:
        print(f"diffview: warning: ignoring unreadable state file {sp} ({e})", file=sys.stderr)
        return None
    if not isinstance(saved, dict):
        print(f"diffview: warning: ignoring malformed state file {sp}", file=sys.stderr)
        return None
    return saved


def load_notes(path: str) -> tuple[list[dict], list[int]]:
    """The agent's side of the review: inline notes, plus the comment ids it says it has addressed."""
    if not path:
        return [], []
    try:
        blob = json.loads(Path(path).expanduser().read_text())
    except (OSError, json.JSONDecodeError) as e:
        sys.exit(f"diffview: cannot read --notes {path}: {e}")
    if not isinstance(blob, dict) or not isinstance(blob.get("notes"), list):
        sys.exit(f'diffview: --notes {path} must be a JSON object with a "notes" list (see --help)')
    notes = blob["notes"]
    if not all(isinstance(n, dict) and n.get("text") and "id" in n and (n.get("path") or n.get("re")) for n in notes):
        sys.exit(f"diffview: --notes {path}: every note needs 'id', 'text', and a 'path' or a 're' comment it answers")
    seen: set[int] = set()
    for n in notes:
        n["id"] = as_int(n["id"], f"--notes {path}: 'id' (note on {n.get('path') or n.get('re')})")
        if n["id"] in seen:
            sys.exit(f"diffview: --notes {path}: two notes share id {n['id']}; ids are handles the agent refers to and must be unique")
        seen.add(n["id"])
        for key in ("line", "end"):
            if key in n:
                n[key] = as_int(n[key], f"--notes {path}: {key!r} (note A{n['id']})")
        if "side" in n and n["side"] not in ("old", "new"):
            sys.exit(f"diffview: --notes {path}: 'side' must be \"old\" or \"new\" (note A{n['id']})")
        if "re" in n:
            n["re"] = comment_id(n["re"], path)
    return notes, [comment_id(item, path) for item in resolved_list(blob.get("resolved", []), path)]


def name_sources(notes: list[dict], sources: list[dict], path: str) -> None:
    """A note's source, written as the root of the section it belongs to, the way that section's
    root reads, so the page can match it by equality."""
    roots = {Path(s["root"]).resolve(): s["root"] for s in sources}
    for n in notes:
        if "source" not in n:
            continue
        root = roots.get(Path(str(n["source"])).expanduser().resolve())
        if root is None:
            sys.exit(f"diffview: --notes {path}: note A{n['id']} names source {n['source']!r}, the root of no section on the page")
        n["source"] = root


def inherit_anchors(notes: list[dict], saved: dict | None, sources: list[dict], path: str) -> None:
    """A note answering a comment sits under it, so it may leave its place unsaid: the comment's
    file, section and lines fill in, and stay with the note should the comment be deleted later (a note
    under a whole-hunk comment then lands at the file's top). The comment must be on the page for
    that; a note answering one that is gone needs a path of its own to land anywhere. A note
    answering a comment written with commits selected carries that comment's file key, as lensKey."""
    comments = {c.get("id"): c for c in (saved or {}).get("comments", []) if isinstance(c, dict)}
    for n in notes:
        if "re" not in n:
            continue
        c = comments.get(n["re"])
        if c is None:
            if not n.get("path"):
                sys.exit(f"diffview: --notes {path}: note A{n['id']} answers C{n['re']}, which is not on the page; give it a path")
            continue
        key = str(c.get("fileKey", ""))
        n.setdefault("path", key.split(":", 1)[-1])
        if key.startswith("@"):   # a comment written with commits selected: the answer sits under it there, not on the full diff
            n["lensKey"] = key
        elif (si := key.split(":", 1)[0]).isdigit() and int(si) < len(sources):
            n.setdefault("source", sources[int(si)]["root"])
        if "line" not in n and c.get("side") in ("old", "new"):
            n["side"], n["line"], n["end"] = c["side"], c["start"], c["end"]


def as_int(value: object, where: str) -> int:
    if isinstance(value, str) and value.isdigit():
        return int(value)
    if not isinstance(value, int) or isinstance(value, bool):
        sys.exit(f"diffview: {where} must be an integer")
    return value


def resolved_list(raw: object, path: str) -> list:
    if not isinstance(raw, list):
        sys.exit(f'diffview: --notes {path}: "resolved" must be a list of comment ids like ["C1", "C4"]')
    return raw


def comment_id(item: object, path: str) -> int:
    """A comment id written the way the export prints it ("C4")."""
    m = re.fullmatch(r"[Cc]?(\d+)", str(item).strip())
    if not m:
        sys.exit(f'diffview: --notes {path}: {item!r} is not a comment id; write them as the export shows them ("C4")')
    return int(m[1])


# ---------------------------------------------------------------- serving, through the container hub

HUB_PORT = int(os.environ.get("CONTAINER_HUB_PORT") or 8377)
HUB_SERVICE_PORT = 8377   # the port the container-hub user service answers on
MAX_STATE_BYTES = 4_000_000   # a real state file is under 20 KB; anything near this is not a page saving


def page_url(out: Path) -> str:
    """The url to hand someone: on the container hub, so the page can take comments; the file when it cannot be."""
    url, why = hub_address(out)
    if url is None:
        print(f"diffview: {why}; read-only", file=sys.stderr)
        return f"file://{out.resolve()}"
    return url


def launch(url: str) -> None:
    browser = os.environ.get("DIFFVIEW_BROWSER") or "xdg-open"
    subprocess.Popen([browser, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def serve_root(root_spec: str) -> None:
    """Have the hub serve an already-rendered page, or a tree of them, and say where."""
    root = Path(root_spec).expanduser().resolve()
    if not root.exists():
        sys.exit(f"diffview: --serve {root} does not exist")
    url, why = hub_address(root)
    if url is None:
        sys.exit(f"diffview: cannot serve {root}: {why}")
    print(f"diffview: serving {root} at {url}")


def hub_address(path: Path) -> tuple[str | None, str]:
    """Where the container hub serves path, a page or a directory of them, the hub started if it is down;
    else None and why not."""
    origin = f"http://127.0.0.1:{HUB_PORT}"
    ask = urllib.request.Request(f"{origin}/api/serve", json.dumps({"path": str(path.resolve())}).encode(),
                                 {"Content-Type": "application/json"})
    for started in (False, True):
        try:
            with urllib.request.urlopen(ask, timeout=30) as r:
                return origin + json.loads(r.read())["url"], ""
        except urllib.error.HTTPError as e:
            said = e.read().decode(errors="replace")
            try:
                said = json.loads(said)["error"]
            except (ValueError, KeyError, TypeError):
                pass
            return None, f"the container hub at {origin} refused it: {said}"
        except (OSError, ValueError) as e:
            if started:
                return None, f"the container hub at {origin} did not answer: {e}"
            if why := start_hub(origin):
                return None, why
    raise AssertionError("unreachable")


def start_hub(origin: str) -> str:
    """Bring the hub up: its user service, where that is installed and answers on this port, else a hub of
    this command's own, in a session of its own so it outlives it. Empty once it answers, else why not."""
    log = Path.home() / ".local" / "state" / "container-hub" / "hub.log"
    # under a minute in all: `board` gives `diffview --serve` 60 s before it opens the page as a file
    deadline = time.monotonic() + 45
    try:
        service = HUB_PORT == HUB_SERVICE_PORT and subprocess.run(
            ["systemctl", "--user", "start", "container-hub"], capture_output=True, timeout=20, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        service = False
    if not service:
        hub = Path(__file__).resolve().parent / "container-hub"
        log.parent.mkdir(parents=True, exist_ok=True)
        try:
            with log.open("a") as out:
                subprocess.Popen([str(hub), "--port", str(HUB_PORT)],
                                 stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        except OSError as e:
            return f"the container hub could not be started from {hub}: {e}"
    while time.monotonic() < deadline:   # a first run has uv resolve the hub's dependencies
        try:
            with urllib.request.urlopen(f"{origin}/.health", timeout=1):
                return ""
        except OSError:
            time.sleep(0.2)
    where = "journalctl --user -u container-hub" if service else str(log)
    return f"the container hub did not come up at {origin} within 45 s; see {where}"


def local_request(handler) -> bool:
    """Binding to loopback stops remote sockets, not a web page that points a name at 127.0.0.1."""
    host = (handler.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
    return host in ("127.0.0.1", "localhost", "::1", "")


def write_refusal(handler) -> tuple[int, bytes] | None:
    """Why a write is not taken, as (status, body); None when it may go ahead.

    A page on another site can send a form-shaped POST to loopback without a preflight, and
    the browser hides the answer but the server would still act. Browsers put the sending
    page's origin on every POST, so a write is taken only from this server's own origin;
    nothing but a page saves state, so a missing Origin has no honest sender. The body is
    bounded and must announce its length, so the read that follows is never open-ended.
    """
    if not local_request(handler):
        return 403, b"forbidden"
    port = handler.server.server_address[1]
    if handler.headers.get("Origin") not in (f"http://127.0.0.1:{port}", f"http://localhost:{port}"):
        return 403, b"forbidden"
    length = handler.headers.get("Content-Length", "")
    if not length.isdigit():
        return 411, b"length required"
    if int(length) > MAX_STATE_BYTES:
        return 413, b"too large"
    return None


BESIDE = (".state.json", ".summary.json", ".watch.json")   # what diffview keeps beside a page for the page to read


def page_beside(target: Path, kinds: tuple[str, ...] = BESIDE) -> Path | None:
    """The page a file diffview keeps beside one would belong to, existing or not; None for any other file."""
    return next((target.with_name(target.name.removesuffix(k)) for k in kinds if target.name.endswith(".html" + k)), None)


def is_beside_page(target: Path, kinds: tuple[str, ...] = BESIDE) -> bool:
    """A file diffview keeps beside a page that exists, written yet or not."""
    page = page_beside(target, kinds)
    return page is not None and page.is_file()


def is_state_file(target: Path) -> bool:
    """A state file of a page that exists: the only path a write to the container hub may land on."""
    return is_beside_page(target, (".state.json",))


STATE_WRITE = threading.Lock()   # a review's state is read, judged and replaced as one step, never interleaved


def write_state(target: Path, raw: bytes) -> tuple[int, bytes]:
    """Persist a page's review state atomically; answer the write with the status it earns.

    A page sends the whole state every time, so two pages on one review erase each other by
    turns. Every write names the page it came from and the savedAt that page loaded: a write
    from a page that never saw what is on the file is refused, and that page merges the file
    in and writes again. Writes from the page that owns the file always pass, so nothing here
    depends on two of them arriving in the order they were sent.

    One page is enough to put two writes in flight, and a state file half of one write and
    half of another reads as no state at all -- which would wave the next write through.
    """
    try:
        blob = json.loads(raw)
        if not isinstance(blob, dict):
            raise ValueError("state must be a JSON object")
    except ValueError:
        return 400, b"bad state"
    with STATE_WRITE:
        held = load_saved_state(target)
        if held is not None and held.get("writer") != blob.get("writer") and held.get("savedAt") != blob.get("since"):
            return 409, json.dumps({"savedAt": held.get("savedAt")}).encode()
        blob.pop("since", None)   # what a write was based on is spent once checked; the file states what it holds
        try:
            tmp = target.with_name(f"{target.name}.{os.getpid()}.tmp")  # per-writer, as everything written beside a page is
            tmp.write_text(json.dumps(blob))
            os.replace(tmp, target)
        except (OSError, TypeError):
            return 400, b"bad state"
    return 204, b""


# ---------------------------------------------------------------- watch mode


def watch(args: Args, out: Path, page: dict) -> None:
    """Regenerate when the sources change; the hub serves the page, which reloads itself off the watch record."""
    restore_request(out)
    summary = page["summary"]
    expecting = page["summaryPending"]  # the first build asked for a summary that is still being written
    if expecting:
        args.auto_summary = False  # asked once; never re-pay per rebuild
    watched = watched_repos(args)
    publish = lambda page, held: publish_watch(out, {"g": page["generated"], "watches": watched}, held)
    held = publish(page, None)
    url = page_url(out)
    last = sources_sig(args)   # taken before the announcement, so "watching" means: from here on
    where = f"live page at {url}" if url.startswith("http") else f"page at {url}, which does not reload itself"
    print(f"diffview: watching {len(args.sources)} source(s); {where}  (Ctrl-C stops)", flush=True)
    signal.signal(signal.SIGTERM, signal.default_int_handler)   # a stop by kill ends the watch as Ctrl-C does
    if args.open:
        launch(url)

    try:
        while True:
            time.sleep(2)
            # a removed worktree is the end of the work this page followed, not a state to wait out
            if gone := next((p for p in watched if not Path(p).exists()), None):
                print(f"diffview: {gone} is gone; watch stopped, the written file stays valid", flush=True)
                return
            try:
                if (superseded := take_request(out)) is not None:
                    text, page = rewrite_summary(args, out, superseded)
                    if page:
                        summary = text
                        held = publish(page, held)
                sig = sources_sig(args)
                if sig == last:
                    continue
                last = sig
                if expecting and not summary:   # only a summary this run asked for; a sidecar left by an earlier round is not one
                    summary = load_summary(out)
                page = build(args, out, summary, awaiting=expecting and not summary)
                held = publish(page, held)
                if args.auto_summary and page["summaryPending"]:  # the first build with anything in it asks for the summary
                    expecting, args.auto_summary = True, False
                print(f"diffview: sources changed, regenerated ({datetime.now():%H:%M:%S})", flush=True)
            except (SystemExit, OSError) as e:
                # transient states are normal mid-review: a rebase in flight, a branch reset to base
                print(f"diffview: sources unreadable right now, still serving the last page ({e})", flush=True)
    except KeyboardInterrupt:
        print("\ndiffview: watch stopped; the written file stays valid")
    finally:
        restore_request(out)   # a ↻ pressed in the watcher's last tick is never answered


def watched_repos(args: Args) -> list[str]:
    """The repos the git sources are read from. An OLD=NEW side is left out: a file rewritten by removing it
    first is missing for a moment, which a repo never is until its worktree is removed for good."""
    return list(dict.fromkeys(str(Path(spec.rsplit("@", 1)[0] if "@" in spec else ".").expanduser().resolve())
                              for spec in args.sources if not ("=" in spec and ".." not in spec.split("=")[0])))


def watch_path(out: Path) -> Path:
    return Path(str(out) + ".watch.json")


def request_path(out: Path) -> Path:
    return Path(str(out) + ".summary.request.json")


def publish_watch(out: Path, record: dict, held: int | None) -> int:
    """Write the watch record beside the page and hold it locked for as long as this watcher runs: a lock
    goes with its process, a killed one included, so whoever reads the record can tell a live watcher from
    one that exited. The record is replaced whole, and the new file is locked before it replaces the old
    one, which is let go only after; so the record in place is never unlocked while the watcher lives.
    Returns the descriptor now held."""
    target = watch_path(out)
    tmp = target.with_name(f"{target.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    fcntl.flock(fd, fcntl.LOCK_EX)
    os.write(fd, json.dumps(record).encode())
    os.replace(tmp, target)
    if held is not None:
        os.close(held)
    return fd


def watch_record(out: Path) -> dict | None:
    """The watch record beside a page, with "alive" saying whether its watcher still runs and "gone" whether
    a repo it watched has been removed; None for a page no watcher ever wrote."""
    target = watch_path(out)
    for _ in range(10):
        try:
            fd = os.open(target, os.O_RDONLY)
        except FileNotFoundError:
            return None
        with os.fdopen(fd, "rb") as f:
            try:
                fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                alive = False
            except BlockingIOError:
                alive = True
            try:
                current = os.stat(target).st_ino == os.fstat(fd).st_ino
            except FileNotFoundError:
                current = False
            if not alive and not current:
                continue   # unlocked because the watcher had just moved its record on: read the new one
            raw = f.read()
        try:
            record = json.loads(raw)
        except ValueError:
            return None
        if not isinstance(record, dict):
            return None
        return {**record, "alive": alive, "gone": any(not Path(p).exists() for p in record.get("watches") or [])}
    return None


def drop_watch_record(out: Path) -> None:
    """A page rendered again without --watch is no longer watched; what an exited watcher left beside it goes."""
    if (record := watch_record(out)) and not record["alive"]:
        restore_request(out)
        watch_path(out).unlink(missing_ok=True)


def watched_repo_gone(out: Path) -> bool:
    """The page was watched and a repo it was read from has been removed: its worktree merged and gone."""
    return bool((record := watch_record(out)) and record["gone"])


SUMMARY_REQUEST = threading.Lock()


def request_summary(out: Path) -> bool:
    """Ask the page's watcher to write its summary again; False when no watcher runs to do it.

    The sidecar moves into the request, so a page polling for the new summary waits for it rather than
    reading the old one back, and the watcher still has the old one to put back when the model call fails."""
    if not ((record := watch_record(out)) and record["alive"]):
        return False
    with SUMMARY_REQUEST:
        request = request_path(out)
        if not request.exists():   # a request already waiting is the same request
            try:
                os.replace(summary_path(out), request)
            except FileNotFoundError:
                request.write_text("{}")
    return True


def take_request(out: Path) -> dict | None:
    """The summary a request superseded, once the request is taken; None when nothing asked."""
    request = request_path(out)
    try:
        raw = request.read_text()
    except FileNotFoundError:
        return None
    request.unlink(missing_ok=True)
    try:
        superseded = json.loads(raw)
    except ValueError:
        superseded = {}
    # asked again while a rewrite ran, the request found no sidecar: the one that rewrite left is the old one now
    return superseded if isinstance(superseded, dict) and superseded else load_sidecar(out)


def restore_request(out: Path) -> None:
    """A request an exited watcher never took: the page that made it is no longer waiting, so the summary it
    moved aside goes back."""
    request = request_path(out)
    if request.exists() and not summary_path(out).exists() and request.read_text().strip() not in ("", "{}"):
        os.replace(request, summary_path(out))
    request.unlink(missing_ok=True)


def rewrite_summary(args: Args, out: Path, previous: dict) -> tuple[str, dict | None]:
    """The summary written again for the diff as it is now, and the page rebuilt around it.

    Returns ("", None) when the model call fails or the sources cannot be read; the previous
    sidecar then goes back with the reason, so the page keeps its paragraph and says why.
    """
    try:
        sources = [collect_source(spec, args.context) for spec in args.sources]
        size = diff_size(sources)   # what the model sees; the tree may move on while it writes
        text, error = generate_summary(summary_body(sources), args.summary_model)
        if text:
            page = build(args, out, text)
            write_summary(out, text, "", size)
            print(f"diffview: summary rewritten ({datetime.now():%H:%M:%S})", flush=True)
            return text, page
    except (SystemExit, OSError) as e:
        error = str(e)
    write_summary(out, previous.get("summary", ""), error, previous.get("for", {}))
    print(f"diffview: summary not rewritten: {error}", flush=True)
    return "", None


def sources_sig(args: Args) -> str:
    h = hashlib.sha256()
    for spec in args.sources:
        if "=" in spec and ".." not in spec.split("=")[0]:
            old, new = (str(Path(p).expanduser()) for p in spec.split("=", 1))
            patch = run_git(["diff", "--no-color", "--no-ext-diff", "--no-index", "--", old, new], ok_codes=(0, 1))
        else:
            repo, range_ = spec.rsplit("@", 1) if "@" in spec else (".", spec)
            repo = str(Path(repo).expanduser().resolve())
            patch = run_git(["-C", repo, "diff", "--no-color", "--no-ext-diff", *rev_args(repo, range_)])
            # a new commit changes the page's history panel even when the diff stays the same
            patch += run_git(["-C", repo, "rev-parse", "HEAD" if is_worktree(range_) else re.split(r"\.{2,3}", range_)[-1] or "HEAD"])
            if is_worktree(range_):
                root, names = untracked_files(repo)
                for name in names:   # name, size and mtime stand in for the content; cheaper than diffing each file every tick
                    try:
                        st = os.stat(os.path.join(root, name))
                    except OSError:
                        continue   # gone between the listing and the stat; the next tick's listing says so
                    patch += f"\0{name}\0{st.st_size}\0{st.st_mtime_ns}"
        h.update(patch.encode())
    if args.notes and Path(args.notes).expanduser().is_file():
        h.update(Path(args.notes).expanduser().read_bytes())
    return h.hexdigest()


# ---------------------------------------------------------------- source collection


def collect_source(spec: str, context: int) -> dict:
    if "=" in spec and ".." not in spec.split("=")[0]:
        old, new = (str(Path(p).expanduser()) for p in spec.split("=", 1))
        patch = run_git(["diff", "--no-color", "--no-ext-diff", f"-U{context}", "--no-index", "--", old, new], ok_codes=(0, 1))
        files = parse_patch(patch, strip_roots=(old, new))
        return {"label": Path(new).name, "kind": "paths", "detail": f"{old} → {new}", "root": str(Path(new).resolve()),
                "spec": f"{Path(old).resolve()}={Path(new).resolve()}", "files": files, "commits": None, "_patch": patch, "_sides": {"old": (old, None), "new": (new, None)}}

    if "@" in spec:
        repo, range_ = spec.rsplit("@", 1)
    else:
        repo, range_ = ".", spec
    repo = str(Path(repo).expanduser().resolve())
    if ".." not in range_:
        sys.exit(f"diffview: bad spec {spec!r}; need REPO@A..B, A..B, or OLD=NEW (see --help)")

    patch = run_git(["-C", repo, "diff", "--no-color", "--no-ext-diff", "-M", f"-U{context}", *rev_args(repo, range_)])
    base = diff_base(repo, range_)
    root = git_root(repo)   # the diff's paths are the repo's, whichever directory the spec named
    if is_worktree(range_):
        untracked = untracked_patch(repo, context)
        patch += untracked
        commits = collect_commits(repo, f"{base}..HEAD", context)
        pending = run_git(["-C", repo, "diff", "--no-color", "--no-ext-diff", "--raw", "-p", "--no-abbrev", "-M", f"-U{context}", "HEAD"]) + untracked
        if files := with_blobs(pending):
            commits.append(commit_record("worktree", "", "", "uncommitted changes", "", files))
        detail = f"{abbreviated(repo, worktree_left(range_))}{'...' if range_.endswith('...') else '..'}worktree"
        rev = None
    else:
        commits = collect_commits(repo, range_, context)
        detail = abbreviated(repo, range_)
        rev = re.split(r"\.{2,3}", range_)[-1] or "HEAD"
    files = parse_patch(patch)
    # the range pinned to the commits it showed, so the spec still names this diff once a branch moves
    short = lambda r: run_git(["-C", repo, "rev-parse", "--short", r]).strip()
    spec = f"{root}@{short(base)}..{short(rev) if rev else ''}"
    return {"label": Path(repo).name, "kind": "git", "detail": detail, "root": root, "spec": spec, "files": files, "commits": commits,
            "historyBlobs": history_blobs(root, commits),
            "_patch": patch, "_sides": {"old": (root, base), "new": (root, rev)}}


MAX_BAKED_BYTES = 1_000_000   # a lockfile or generated blob in the diff must not turn the page into a copy of it
MAX_IMAGE_BYTES = 5 * 1024 * 1024   # an image is what is under review, not context around it, so it gets more room than text
IMAGE_TYPES = {
    ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp",
    ".avif": "image/avif", ".bmp": "image/bmp", ".ico": "image/x-icon", ".svg": "image/svg+xml",
}


def file_bytes(source: dict, path: str, side: str = "new") -> bytes | None:
    """One side of a file in this source, whole; None when the source has no such file.

    The new side is the range's right-hand rev, or the disk for a worktree or OLD=NEW compare.
    The old side is the rev the diff starts from, or the OLD path.
    """
    where, rev = source["_sides"][side]
    root = Path(where).resolve()
    if rev is not None:
        # through the filters a checkout runs (a Git LFS smudge, eol conversion), so a rev gives what a disk read would
        proc = subprocess.run(["git", "-C", str(root), "cat-file", "--filters", f"{rev}:{path}"], capture_output=True)
        return proc.stdout if proc.returncode == 0 else None
    if root.is_file():   # file=file compare: each side holds exactly one file
        target = root if side == "old" or path == root.name else None
    else:
        target = (root / path).resolve()
        if not target.is_relative_to(root):   # a note names a path; it must not pull anything outside the source in
            target = None
    try:
        return target.read_bytes() if target else None
    except OSError:
        return None


def file_lines(source: dict, path: str) -> list[str] | None:
    """The new side of a file in this source, as lines; None when the source has no such file, or it is too big to bake.

    Unchanged regions are identical on both sides, so the new side is enough for the page
    to open any gap between hunks, and the old line numbers follow from the offset.
    """
    raw = file_bytes(source, path)
    if raw is None or len(raw) > MAX_BAKED_BYTES:
        return None
    lines = raw.decode(errors="replace").split("\n")   # git counts \n only; splitlines() would also break on \f, \v, U+2028…
    return lines[:-1] if lines and lines[-1] == "" else lines


def image_type(path: str) -> str | None:
    """The MIME type of an image a browser shows, by the path's extension; None for any other file."""
    return IMAGE_TYPES.get(Path(path).suffix.lower())


def image_versions(source: dict, f: dict) -> dict | None:
    """The versions of an image file its card shows, keyed "old" and "new"; None when neither side is an image.

    A version too big to bake, or one the source cannot give back, still carries its size
    (None when unreadable), so the card can say why that image is missing.
    """
    paths = {"old": None if f["status"] in ("added", "untouched") else f["oldPath"] or f["path"],
             "new": None if f["status"] == "deleted" else f["path"]}
    return {side: image_version(source, path, side) for side, path in paths.items() if path and image_type(path)} or None


def image_version(source: dict, path: str, side: str) -> dict:
    raw = file_bytes(source, path, side)
    version = {"type": image_type(path), "size": None if raw is None else len(raw)}
    if raw is not None and len(raw) <= MAX_IMAGE_BYTES:
        version["src"] = f"data:{version['type']};base64,{base64.b64encode(raw).decode()}"
    return version


TOP_WINDOW = 20   # what a line-less note on an untouched file opens: the top of the file, one expansion step's worth


def attach_untouched(sources: list[dict], notes: list[dict], context: int) -> None:
    """A note on a file outside the diff puts that file on the page, opened at the noted lines.

    The file joins the note's source, or without one the first source that has it, as a card with no changes and one all-context
    hunk per noted window, so the page treats it like any other file: the note anchors to
    its lines, comments attach, and the hunk expands from the baked content like the rest.
    An image other than SVG has no lines to open at, so it joins with no hunks and its card shows the image.
    """
    by_place: dict[tuple[str | None, str], list[dict]] = {}
    for n in notes:
        if not n.get("lensKey"):
            by_place.setdefault((n.get("source"), n["path"]), []).append(n)
    for (root, path), ns in by_place.items():
        scope = [s for s in sources if root in (None, s["root"])]
        # read as it stands, so a file an earlier note brought in is not brought in twice
        if any(names_file(f["path"], path) for s in scope for f in s["files"]):
            continue
        for s in scope:
            if image_type(path) not in (None, "image/svg+xml"):
                if file_bytes(s, path) is None:
                    continue
                lines, hunks = None, []
            else:
                lines = file_lines(s, path)
                if lines is None:
                    continue
                windows = merge_windows([note_window(n, len(lines), context) for n in ns])
                # no old side: nothing to compare against, so only the new gutter takes comments
                hunks = [{"os": a, "ns": a, "header": "", "lines": [[0, None, no, lines[no - 1]] for no in range(a, b + 1)]}
                         for a, b in windows]
            f = {"path": path, "oldPath": None, "status": "untouched", "adds": 0, "dels": 0, "binary": lines is None,
                 "lang": None, "hunks": hunks, "content": lines}
            f["lang"] = guess_lang(f)
            s["files"].append(f)
            break
        else:
            where = f"not in source {root}" if root else "in no source"
            print(f"diffview: warning: --notes path {path!r} is {where}, changed or not; that note is shown nowhere", file=sys.stderr)


def names_file(shown: str, path: str) -> bool:
    """Whether a note on path is about the file a section shows as shown: the same path, or one
    ending in it. The page matches a note to its file the same way."""
    return shown == path or shown.endswith("/" + path)


def note_window(n: dict, n_lines: int, context: int) -> tuple[int, int]:
    """The lines an untouched-file note opens: the noted range plus --context around it, or the top of the file."""
    if n.get("line") is None:
        return 1, min(TOP_WINDOW, n_lines)
    start, end = min(n["line"], n_lines), min(n.get("end") or n["line"], n_lines)
    return max(1, start - context), min(n_lines, end + context)


def merge_windows(windows: list[tuple[int, int]]) -> list[tuple[int, int]]:
    out: list[tuple[int, int]] = []
    for a, b in sorted(windows):
        if out and a <= out[-1][1] + 1:
            out[-1] = (out[-1][0], max(out[-1][1], b))
        else:
            out.append((a, b))
    return out


def is_worktree(range_: str) -> bool:
    """Nothing after the dots means: compare against the working tree, uncommitted changes included."""
    return range_.endswith("..")


def diff_base(repo: str, range_: str) -> str:
    """The commit a range's diff starts from.

    `A..B` and `A..` start at A itself. `A...B` and `A...` start where the two sides forked
    (the merge-base of A with B, or with HEAD), so commits A gained since, which the other
    side does not have, do not show up as its changes; the base moves only when a rebase or
    merge takes them in.
    """
    left, right = re.split(r"\.{2,3}", range_, maxsplit=1)
    if "..." not in range_:
        return left or "HEAD"
    return run_git(["-C", repo, "merge-base", left or "HEAD", right or "HEAD"]).strip()


def abbreviated(repo: str, range_: str) -> str:
    """The range with each full commit id in it shortened the way git shortens it in this repo."""
    return re.sub(r"\b[0-9a-f]{40}\b", lambda m: run_git(["-C", repo, "rev-parse", "--short", m[0]]).strip(), range_)


def worktree_left(range_: str) -> str:
    """The rev before the dots, as typed; `..` alone means HEAD."""
    return range_.rstrip(".") or "HEAD"


def untracked_files(repo: str) -> tuple[str, list[str]]:
    """The repo root and the files git neither tracks nor ignores, root-relative.

    A nested repository is listed as one entry with a trailing slash and is left out: it is
    not a file, and its contents are that repository's business.
    """
    root = git_root(repo)
    names = run_git(["-C", root, "ls-files", "--others", "--exclude-standard", "--full-name", "-z"]).split("\0")
    return root, [n for n in names if n and not n.endswith("/")]


def untracked_patch(repo: str, context: int) -> str:
    """Untracked files as new-file diffs, for a worktree compare to append to `git diff`.

    `git diff` shows what the index knows, and the files a session creates are exactly what
    it does not: a review of fresh work would show nothing until someone staged it. Diffing
    each file against /dev/null reads the tree and leaves the index alone.
    """
    root, names = untracked_files(repo)
    return "".join(
        run_git(["-C", root, "diff", "--no-color", "--no-ext-diff", f"-U{context}", "--no-index", "--", "/dev/null", name], ok_codes=(0, 1))
        for name in names
    )


def rev_args(repo: str, range_: str) -> list[str]:
    return [diff_base(repo, range_)] if is_worktree(range_) else [range_]


def collect_commits(repo: str, range_: str, context: int) -> list[dict]:
    """The range's commits, oldest first with each one after its parents, each carrying its own diff.
    The page's history panel lists them, and selecting some there shows only what they changed."""
    fmt = "%x1e%H%x1f%an%x1f%aI%x1f%s%x1f%b%x1f"
    raw = run_git(["-C", repo, "log", "--no-merges", "--topo-order", "--reverse", "-p", "--raw", "--no-abbrev", "-M", "--no-color",
                   "--no-ext-diff", f"-U{context}", f"--format={fmt}", range_])
    records = [rec.split("\x1f", 5) for rec in raw.split("\x1e") if rec.strip()]
    # --no-abbrev, which the blob ids need, writes %h out in full too
    short = dict(line.split() for line in run_git(["-C", repo, "log", "--no-merges", "--format=%H %h", range_]).splitlines())
    return [commit_record(short[sha], author, date, subject, body, with_blobs(patch)) for sha, author, date, subject, body, patch in records]


RAW_RE = re.compile(r"^:\d+ \d+ ([0-9a-f]+) ([0-9a-f]+) [A-Z]\d*\t(?:[^\t]*\t)?(.*)$")


def with_blobs(patch: str) -> list[dict]:
    """The files a `--raw -p` diff changes, each with "blobs": the blob ids of its old and new side,
    None for a side git has no blob for (a file added or deleted, or the working tree's side)."""
    files = parse_patch(patch)
    blobs = {}
    for line in patch.splitlines():
        if line.startswith("diff --git "):
            break
        if m := RAW_RE.match(line):
            blobs[m[3].strip('"')] = [None if not m[i].strip("0") else m[i] for i in (1, 2)]
    for f in files:
        f["blobs"] = blobs.get(f["path"], [None, None])
    return files


def commit_record(short: str, author: str, date: str, subject: str, body: str, files: list[dict]) -> dict:
    body = re.sub(r"^(Co-Authored-By|Signed-off-by|Reviewed-by):.*$", "", body, flags=re.M | re.I).strip()
    return {"short": short, "author": author, "date": date, "subject": subject, "body": body,
            "adds": sum(f["adds"] for f in files), "dels": sum(f["dels"] for f in files), "files": files}


def history_blobs(root: str, commits: list[dict]) -> dict:
    """The file versions, by blob id, that the page cannot derive from the commits' own diffs.

    A commit's diff turns the version it starts from into the version it ends at, so the page
    derives every version a commit in the list ends at. What it cannot derive is a version a commit
    starts from that no earlier commit in the list ended at: the files as they were before the range,
    and whatever a commit left out of the list brought in, such as a merge. Those are baked here.

    Each value is the file's lines, split as the diffs split them, or false where the page carries no
    text of it because it is binary or over the size limit.
    """
    known: set[str] = set()
    blobs: dict[str, list[str] | bool] = {}
    for c in commits:
        for f in c["files"]:
            old, new = f["blobs"]
            if old and old not in known:
                raw = subprocess.run(["git", "-C", root, "cat-file", "blob", old], capture_output=True).stdout
                blobs[old] = False if b"\0" in raw or len(raw) > MAX_BAKED_BYTES else raw.decode(errors="replace").splitlines()
                known.add(old)
            if new:
                known.add(new)
    return blobs


def run_git(git_args: list[str], ok_codes: tuple[int, ...] = (0,)) -> str:
    # a diff prints file content as git stores it, which need not be UTF-8
    proc = subprocess.run(["git", *git_args], capture_output=True, text=True, errors="replace")
    if proc.returncode not in ok_codes:
        sys.exit(f"diffview: git {' '.join(git_args[:4])}… failed:\n{proc.stderr.strip()}")
    return proc.stdout


# ---------------------------------------------------------------- patch parsing

HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@ ?(.*)")


def parse_patch(text: str, strip_roots: tuple[str, ...] = ()) -> list[dict]:
    """Parse `git diff` output into file dicts with hunks and numbered lines."""
    files: list[dict] = []
    lines = text.splitlines()
    i = 0
    cur: dict | None = None

    def clean(p: str) -> str:
        p = p.removesuffix("\t")   # git tab-terminates a name with a space in it, as unified diff has always done
        p = p.strip('"')
        p = re.sub(r"^[ab]/", "", p)
        orig = p
        for root in strip_roots:
            p = p.removeprefix(root.lstrip("/")).lstrip("/")
        return p or Path(orig).name  # file=file compare strips the whole path — keep the basename

    def header_path(line: str) -> str:
        """The new-side path in a `diff --git` line: a binary file's diff names it nowhere else.

        A space in the name makes the line ambiguous, so take the split that names the same file
        on both sides, or the only split there is. A rename, whose sides differ, repeats its path
        in `rename to`, and a text file in its `+++` line.
        """
        body = line.removeprefix("diff --git ")
        sides = [(body[:at], body[at + 1:]) for at, ch in enumerate(body) if ch == " "]
        sides = [(clean(a), clean(b)) for a, b in sides if a.lstrip('"').startswith("a/") and b.lstrip('"').startswith("b/")]
        for a, b in sides:
            if a == b:
                return a
        return sides[0][1] if len(sides) == 1 else ""

    while i < len(lines):
        line = lines[i]
        if line.startswith("diff --git "):
            cur = {"path": header_path(line), "oldPath": None, "status": "modified", "mode": None, "adds": 0, "dels": 0, "binary": False, "lang": None, "hunks": []}
            files.append(cur)
        elif cur is not None and line.startswith("new file mode "):
            cur["status"], cur["mode"] = "added", line[14:]
        elif cur is not None and line.startswith("deleted file mode "):
            cur["status"], cur["mode"] = "deleted", line[18:]
        elif cur is not None and line.startswith("rename from "):
            cur["oldPath"] = clean(line[12:])
            cur["status"] = "renamed"
        elif cur is not None and line.startswith("rename to "):
            cur["path"] = clean(line[10:])
        elif cur is not None and (line.startswith("Binary files ") or line.startswith("GIT binary patch")):
            cur["binary"] = True
        elif cur is not None and line.startswith("--- "):   # unambiguous, unlike the header it overwrites
            if line[4:] != "/dev/null" and cur["status"] != "renamed":
                cur["oldPath"] = None  # same-path modify; only renames keep oldPath
                cur["path"] = clean(line[4:])
        elif cur is not None and line.startswith("+++ "):
            if line[4:] != "/dev/null":
                cur["path"] = clean(line[4:])
            elif not cur["path"] and cur["oldPath"]:
                cur["path"] = cur["oldPath"]
        elif cur is not None and (m := HUNK_RE.match(line)):
            old_no, old_count = int(m[1]), int(m[2] or "1")
            new_no, new_count = int(m[3]), int(m[4] or "1")
            hunk = {"os": old_no, "ns": new_no, "header": m[5], "lines": []}
            cur["hunks"].append(hunk)
            i += 1
            while i < len(lines) and (old_count > 0 or new_count > 0):
                body = lines[i]
                tag = body[:1]
                content = body[1:]
                if tag == " ":
                    hunk["lines"].append([0, old_no, new_no, content])
                    old_no += 1
                    new_no += 1
                    old_count -= 1
                    new_count -= 1
                elif tag == "+":
                    hunk["lines"].append([1, None, new_no, content])
                    new_no += 1
                    new_count -= 1
                    cur["adds"] += 1
                elif tag == "-":
                    hunk["lines"].append([2, old_no, None, content])
                    old_no += 1
                    old_count -= 1
                    cur["dels"] += 1
                elif tag == "\\":
                    pass  # "no newline at end of file"
                else:
                    break
                i += 1
            continue
        i += 1

    for f in files:
        if not f["path"] and f["oldPath"]:
            f["path"] = f["oldPath"]
        f["lang"] = guess_lang(f)
    return [f for f in files if f["path"]]


EXT_LANG = {
    ".py": "python", ".nix": "nix", ".sh": "bash", ".bash": "bash", ".zsh": "bash",
    ".md": "markdown", ".json": "json", ".yml": "yaml", ".yaml": "yaml",
    ".toml": "ini", ".ini": "ini", ".conf": "ini", ".env": "bash", ".test": "bash",
    ".service": "ini", ".timer": "ini",
    ".js": "javascript", ".mjs": "javascript", ".cjs": "javascript", ".jsx": "javascript",
    ".ts": "typescript", ".tsx": "typescript",
    ".css": "css", ".scss": "scss", ".less": "less",
    ".html": "xml", ".xml": "xml", ".vue": "xml", ".cshtml": "xml", ".razor": "xml",
    ".csproj": "xml", ".props": "xml", ".targets": "xml", ".nuspec": "xml",
    ".c": "c", ".h": "c", ".cpp": "cpp", ".cs": "csharp", ".java": "java",
    ".kt": "kotlin", ".dart": "dart", ".go": "go", ".rs": "rust", ".swift": "swift", ".lua": "lua",
    ".rb": "ruby", ".php": "php", ".pl": "perl", ".r": "r", ".m": "matlab",
    ".sql": "sql", ".proto": "protobuf", ".graphql": "graphql", ".gql": "graphql",
    ".dockerfile": "dockerfile",
    ".txt": None, ".lock": None,
}

NAME_LANG = {"dockerfile": "dockerfile", "makefile": "makefile"}


def guess_lang(f: dict) -> str | None:
    path = Path(f["path"])
    name, ext = path.name.lower(), path.suffix.lower()
    if name in NAME_LANG:
        return NAME_LANG[name]
    if ext in EXT_LANG:
        return EXT_LANG[ext]
    base = name.split(".", 1)[0]  # Dockerfile.dev, Makefile.inc
    if base in NAME_LANG:
        return NAME_LANG[base]
    if ext:
        return None
    first = next((ln[3] for h in f["hunks"] for ln in h["lines"] if (h["ns"] == 1 or h["os"] == 1)), "")
    if first.startswith("#!"):
        if "python" in first:
            return "python"
        if re.search(r"\b(ba|z)?sh\b", first):
            return "bash"
    parts = Path(f["path"]).parts
    if "bin" in parts or "scripts" in parts:
        return "bash"
    return None


# ---------------------------------------------------------------- auto summary

def summary_body(sources: list[dict]) -> str:
    """The diff as the model sees it, trimmed so several sources share one context."""
    budget = 400_000 // max(len(sources), 1)
    return "\n\n".join(f"### {s['label']} ({s['detail']})\n{s['_patch'][:budget]}" for s in sources)


def generate_summary(body: str, model: str) -> tuple[str, str]:
    """change-summary's paragraph for this diff, or ("", reason) when it has none."""
    try:
        proc = subprocess.run(["change-summary", *(["--model", model] if model else [])], input=body, capture_output=True, text=True, timeout=900)
    except (OSError, subprocess.TimeoutExpired) as e:
        return "", str(e)
    if proc.returncode != 0:
        return "", proc.stderr.strip()[-500:] or f"change-summary exited {proc.returncode}"
    return proc.stdout.strip(), ""


def finish_summary(out: Path, body: str, model: str, data: dict, hljs: str, rendered: tuple[int, int]) -> None:
    """Summarize in a detached child, once the page it belongs to is already on screen.

    The model call costs seconds, which is the whole reason it happens here rather than
    before the browser opens. A served page picks the paragraph up from the sidecar
    written here; the page file is rewritten too, so a copy shared later carries it.
    A failure reaches the page the same way, never the terminal -- by the time it is
    known the command has returned and the page is where anyone is still looking.
    """
    pid = os.fork()
    if pid:
        os.waitpid(pid, 0)  # the intermediate exits at once, and reaping it leaves no zombie behind
        return
    if os.fork():
        os._exit(0)
    os.setsid()
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    try:
        summary, error = generate_summary(body, model)
        write_summary(out, summary, error, data["size"])
        # rendering to this path again while the model ran makes the page on disk somebody
        # else's; the sidecar still stands, so a page open on it is not left waiting
        if summary and page_id(out) == rendered:
            data["summary"] = summary
            data["summaryPending"] = False
            data["saved"] = load_saved_state(state_path(out))  # the page has been open and commentable all along
            write_page(out, data, hljs)
    except OSError:
        pass
    os._exit(0)


# ---------------------------------------------------------------- highlight.js (fetched once, checked, cached, inlined)

HLJS_VERSION = "11.11.1"
HLJS_BASE = f"https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@{HLJS_VERSION}/build/"
HLJS = {  # sha256 of each file at HLJS_VERSION; moving the version moves every one of these with it
    "highlight.min.js": "c4a399dd6f488bc97a3546e3476747b3e714c99c57b9473154c6fb8d259b9381",
    "languages/dart.min.js": "81eb3deaf0eaaab99e82dbbda1f0d18ce70a2ad8156413e4fc1098ad07c605ce",
    "languages/dockerfile.min.js": "7b11edef6889d2bf9dd30799ce2212bae9b469cbb1793d4d216b65c274c96079",
    "languages/matlab.min.js": "03b56d633e41ef2bfec8c1c005fe4290ae4583f444e9ffd0065e9ec9091ec6fc",
    "languages/nix.min.js": "8f8766b6bafca94383a080ae3ac8278f5a234c09b16ca7b4d26139b1f1250bf2",
    "languages/protobuf.min.js": "cd2c97c8f6620b9c6c85afa013c614c1d5ad6aac115fc47717401c832a0ba76d",
}
HLJS_COMMON = {  # bundled in highlight.min.js
    "bash", "c", "cpp", "csharp", "css", "diff", "go", "graphql", "ini", "java",
    "javascript", "json", "kotlin", "less", "lua", "makefile", "markdown", "objectivec",
    "perl", "php", "plaintext", "python", "r", "ruby", "rust", "scss", "shell", "sql",
    "swift", "typescript", "xml", "yaml",
}


def fetch_hljs(langs: set[str]) -> str:
    """highlight.js and the languages it lacks for this diff, each checked against its pin; "" without the core."""
    core = hljs_file("highlight.min.js")
    if core is None:
        return ""
    return "\n".join([core] + [js for lang in sorted(langs - HLJS_COMMON) if (js := hljs_file(f"languages/{lang}.min.js"))])


def hljs_file(name: str) -> str | None:
    """A cached file is checked on every use: the pin, not where the file came from, is what is trusted."""
    pin = HLJS.get(name)
    if pin is None:
        print(f"diffview: warning: {name} has no pinned sha256 in HLJS; that language goes unhighlighted", file=sys.stderr)
        return None
    path = Path.home() / ".cache" / "diffview" / f"hljs-{HLJS_VERSION}" / name
    if path.exists():
        body = path.read_bytes()
        if hashlib.sha256(body).hexdigest() != pin:
            print(f"diffview: warning: {path} does not match its pinned sha256, so it is not used; "
                  "delete it to fetch it again", file=sys.stderr)
            return None
        return body.decode()
    # curl rather than urllib: uv's Python finds no CA bundle on NixOS
    run = subprocess.run(["curl", "-fsSL", "--max-time", "10", HLJS_BASE + name], capture_output=True, check=False)
    if run.returncode != 0:
        print(f"diffview: warning: could not fetch {HLJS_BASE + name} ({run.stderr.decode(errors='replace').strip()}); "
              "page will lack some syntax highlighting", file=sys.stderr)
        return None
    body = run.stdout
    if hashlib.sha256(body).hexdigest() != pin:
        print(f"diffview: warning: {HLJS_BASE + name} does not match its pinned sha256, so it is not used", file=sys.stderr)
        return None
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_bytes(body)
    os.replace(tmp, path)
    return body.decode()


if __name__ == "__main__":
    main(tyro.cli(Args, description=__doc__))
