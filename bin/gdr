#!/usr/bin/env bash
# Diff a range of commits, addressed by the numbers glog shows: 1 is HEAD, 2 the
# commit before it, and so on down the current branch's first-parent chain.
#
# Usage: gdr [--open] [SPEC] [ARGS...]
#
#   SPEC      commits         git range
#   (none)    1               HEAD~1..HEAD
#   5         1 to 5          HEAD~5..HEAD
#   2..5      2 to 5          HEAD~5..HEAD~1
#   4..4      4               HEAD~4..HEAD~3
#   abc123    after abc123    abc123..HEAD
#   a1..b2    as given        a1..b2
#
# ARGS go to git diff, or to diffview with --open, which renders the range as a
# page instead of printing it:  gdr 3 -- bin/   gdr 2..5 --stat   gdr --open 4
#
# The printed diff starts with one line per commit in the range, numbered as
# above; commits off the first-parent chain get no number.
set -eu

usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; }
die() { echo "gdr: $*" >&2; exit 1; }

open=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --open) open=1; shift ;;
    *) break ;;
  esac
done
spec=""
if [[ $# -gt 0 && "$1" != -* ]]; then spec=$1; shift; fi

if [[ -z $spec ]]; then range=HEAD~1..HEAD
elif [[ $spec =~ ^([0-9]+)\.\.([0-9]+)$ ]]; then
  a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
  (( lo = a < b ? a : b, hi = a > b ? a : b )) || true
  (( lo >= 1 )) || die "commit numbers start at 1"
  range="HEAD~$hi..HEAD~$((lo - 1))"
elif [[ $spec == *..* ]]; then range=$spec
elif [[ $spec =~ ^[0-9]+$ ]]; then range="HEAD~$spec..HEAD"
else range="$spec..HEAD"
fi

if (( open )); then exec diffview "$range" --open "$@"; fi

color=never
[[ -t 1 ]] && color=always

# Number each commit by its position in HEAD's first-parent chain. The chain is
# streamed and abandoned as soon as every commit in the range has been placed.
header=$(git rev-list --first-parent HEAD 2>/dev/null | awk -F $'\x1f' '
  FILENAME == ARGV[1] { m++; id[m] = $2; txt[m] = $1; want[$2] = 1; next }
  ($1 in want) { num[$1] = FNR; if (++found == m) exit }
  END {
    for (i = 1; i <= m; i++) if (id[i] in num && length(num[id[i]]) > w) w = length(num[id[i]])
    for (i = 1; i <= m; i++) {
      pre = w ? sprintf("%*s ", w, num[id[i]]) : ""
      print "# " pre txt[i]
    }
  }' <(git log --first-parent --reverse --color=$color --format='%C(auto)%h%d %s%C(reset)%x1f%H' "$range") -)

out=$(git diff --color=$color "$range" "$@")
[[ -n $header ]] && out="$header"$'\n\n'"$out"
if [[ -t 1 ]]; then
  LESS="${LESS:-FRX}" less -R <<<"$out"
else
  printf '%s\n' "$out"
fi
