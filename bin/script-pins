#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""List the scripts pages load from jsDelivr at a pinned version, beside each one's newest release.

A pin is a jsDelivr URL naming an exact version: cdn.jsdelivr.net/npm/<package>@<version>/...
or cdn.jsdelivr.net/gh/<user>/<repo>@<version>/... A version written {NAME} is read from a
NAME = "..." line in the same file. Files are searched with rg, so what a repo ignores is skipped.
The newest release is jsDelivr's answer for "latest"; a package it could not be asked about
shows "?" and exits 1.

JSON schema (--json):

    [{"package": "npm/mermaid", "pinned": "11.17.2", "latest": "12.1.0 | null", "where": ["path:line"]}]

Examples:

    script-pins
    script-pins ~/.dotfiles/bin --json | jq '.[] | select(.pinned != .latest)'
"""

import json
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Annotated

import tyro

HOME = Path.home()
PIN = r"cdn\.jsdelivr\.net/(npm/(?:@[\w.-]+/)?[\w.-]+|gh/[\w.-]+/[\w.-]+)@([0-9][\w.+-]*|\{\w+\})"
API = os.environ.get("SCRIPT_PINS_API", "https://data.jsdelivr.com/v1")


@dataclass
class Args:
    paths: Annotated[list[Path], tyro.conf.Positional] = field(
        default_factory=lambda: [HOME / ".dotfiles/bin", HOME / "repos/github/MaxWolf-01/agents"])
    """Files or directories to search; one that does not exist is skipped with a note on stderr."""
    json: bool = False
    """Emit JSON to stdout."""


def main(args: Args) -> int:
    for gone in (p for p in args.paths if not p.exists()):
        print(f"script-pins: {gone} does not exist, skipped", file=sys.stderr)
    pins = find_pins([p for p in args.paths if p.exists()])
    rows = [{"package": pkg, "pinned": ver, "latest": latest(pkg), "where": where} for (pkg, ver), where in sorted(pins.items())]
    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        for r in rows:
            state = "current" if r["latest"] == r["pinned"] else f"→ {r['latest'] or '?'}"
            print(f"{r['package']}  {r['pinned']}  {state}  {' '.join(r['where'])}")
    return 1 if any(r["latest"] is None for r in rows) else 0


def find_pins(paths: list[Path]) -> dict[tuple[str, str], list[str]]:
    """(package, version) → every path:line pinning it."""
    if not paths:
        return {}
    run = subprocess.run(["rg", "--null", "-n", "-o", "--no-heading", "-e", PIN, *map(str, paths)], capture_output=True, text=True)
    if run.returncode > 1:
        sys.exit(f"script-pins: rg failed: {run.stderr.strip()}")
    pins: dict[tuple[str, str], list[str]] = {}
    for hit in run.stdout.splitlines():
        path, rest = hit.split("\0", 1)
        line, match = rest.split(":", 1)
        pkg, ver = re.search(PIN, match).groups()
        if ver.startswith("{"):
            name = ver.strip("{}")
            found = re.search(rf'^\s*{name}\s*=\s*"([^"]+)"', Path(path).read_text(), re.M)
            ver = found[1] if found else ver
        pins.setdefault((pkg, ver), []).append(f"{path}:{line}")
    return pins


def latest(pkg: str) -> str | None:
    # curl rather than urllib: uv's Python finds no CA bundle on NixOS
    run = subprocess.run(["curl", "-fsS", "--max-time", "20", f"{API}/packages/{pkg}/resolved?specifier=latest"],
                         capture_output=True, text=True)
    if run.returncode != 0:
        print(f"script-pins: could not ask jsDelivr about {pkg}: {run.stderr.strip()}", file=sys.stderr)
        return None
    return json.loads(run.stdout).get("version")


if __name__ == "__main__":
    sys.exit(main(tyro.cli(Args, description=__doc__)))
