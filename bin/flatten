#!/usr/bin/env bash
# Move every file in a directory tree (default: current) to its top level and
# delete the emptied subdirectories. A file whose name already exists at the
# top level stays where it is.
# Usage: flatten [dir]
set -euo pipefail
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac
dir=${1:-.}
find "$dir" -mindepth 2 -type f -exec mv -n -t "$dir" {} +
find "$dir" -mindepth 1 -type d -empty -delete
