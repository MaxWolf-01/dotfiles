#!/usr/bin/env bash
# Pack the given paths into <first path>.tar.gz. Compresses with zopfli when
# the tar is under 50 MB and zopfli is installed, else pigz, else gzip.
# Usage: targz <path...>
set -euo pipefail
(( $# )) || { echo "Usage: targz <path...>" >&2; exit 1; }
tarfile="${1%/}.tar"
tar -cvf "$tarfile" -- "$@"
size=$(stat -c%s "$tarfile")
if (( size < 52428800 )) && command -v zopfli >/dev/null; then
  cmd=zopfli
elif command -v pigz >/dev/null; then
  cmd=pigz
else
  cmd=gzip
fi
echo "Compressing $tarfile ($((size / 1000)) kB) with $cmd…"
"$cmd" -v "$tarfile"
[[ -f "$tarfile" ]] && rm "$tarfile"
echo "$tarfile.gz ($(( $(stat -c%s "$tarfile.gz") / 1000 )) kB) created."
