#!/usr/bin/env bash
# Read the watchdog config and print one validated record per line.
#
# The config is the written answer to "unit X hasn't run in N days — is that a
# problem?". Four readers ask it that: bin/overdue-check, which alerts, and the
# three dashboard collectors in secrets/scripts, which draw the bounds it gives.
# The syntax lives here rather than in any of them, because a line one reader
# accepts and another silently drops leaves a unit watched by nothing.
#
# Output is tab separated, one record per line: the file that was read, then the
# settings and units in file order.
#
#   file<TAB>/home/max/.dotfiles/secrets/monitoring/overdue.conf
#   set<TAB>ntfy_topic<TAB><the topic, which stays in the config and out of here>
#   unit<TAB>phone-sync<TAB>pc<TAB>60<TAB>run-log
#
# Exits 2 on anything it cannot make sense of, naming the line: a config a
# reader has to guess at is how a unit ends up unwatched without anyone noticing.

set -uo pipefail

DEFAULT_CONFIG="$HOME/.dotfiles/secrets/monitoring/overdue.conf"

usage() {
    cat <<EOF
Usage: $(basename "$0") [FILE]

Prints the watchdog config as tab-separated records (default: $DEFAULT_CONFIG).

Config lines are '<unit> <host> <max_age_days> <run-log|systemd>', plus
'<setting>: <value>'; '#' starts a comment. The only setting is ntfy_topic.
See the comments in the config file itself for what the columns mean.
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
esac

config="${1:-$DEFAULT_CONFIG}"
if [ ! -f "$config" ]; then
    echo "No unit config at $config — nothing knows what 'overdue' means." >&2
    exit 2
fi

printf 'file\t%s\n' "$config"

while read -r line; do
    line="${line%%#*}"
    read -r unit host days witness <<<"$line"
    [ -n "$unit" ] || continue

    # "key: value" cannot collide with a unit name, which has no colon in it.
    if [[ "$unit" == *: ]]; then
        setting="${unit%:}"
        case "$setting" in
            ntfy_topic) printf 'set\t%s\t%s\n' "$setting" "$host" ;;
            *) echo "$config: unknown setting '$setting'" >&2; exit 2 ;;
        esac
        continue
    fi

    # The unit name reaches a filename and an ssh command line, and a typo in it
    # would otherwise surface as a permanent, mystifying "never ran". Same shape
    # bin/run-log accepts, so a name that works in one works in the other.
    if ! [[ "$unit" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
        echo "$config: bad unit name '$unit' (lowercase letters, digits, . _ -)" >&2
        exit 2
    fi

    if [ -z "$host" ] || ! [[ "$days" =~ ^[0-9]+$ ]] \
        || { [ "$witness" != "run-log" ] && [ "$witness" != "systemd" ]; }; then
        echo "$config: expected '<unit> <host> <max_age_days> <run-log|systemd>', got: $line" >&2
        exit 2
    fi

    printf 'unit\t%s\t%s\t%s\t%s\n' "$unit" "$host" "$days" "$witness"
done < "$config"
