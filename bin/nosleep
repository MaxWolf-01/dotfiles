#!/usr/bin/env bash
# Run a command with a systemd inhibitor held for its whole lifetime, so idle
# suspend cannot kill a long job.
#
# logind measures idleness as "no keyboard or mouse input" and knows nothing
# about CPU load. A training run in a detached tmux pane looks exactly as idle
# as an empty desk, and gets suspended on schedule. This takes a block inhibitor
# for the duration of the command and drops it the moment the command exits,
# crashes, or is interrupted -- nothing global to remember to switch back.
#
# The lid switch is inhibited too, so closing the laptop does not stop the job.
#
# -b detaches into a transient user service under a fixed name, so the hold can
# be cancelled later without finding the terminal that started it. Output goes
# to the journal, and only one detached hold exists at a time: a second -b
# replaces the first. For a job whose output you want to watch, run it in the
# foreground inside tmux instead.
#
# On a host without systemd there is no idle suspend to inhibit, so the command
# runs bare. -b has nothing to detach into there and fails instead.
#
# Usage:
#   nosleep <command> [args...]
#   nosleep uv run train.py
#   nosleep sleep 2h                keep the machine awake for two hours
#   nosleep -b sleep 2h             the same, detached and cancellable
#
#   systemctl --user stop nosleep   cancel a detached hold
#   journalctl --user -u nosleep    read its output
#
# See everything currently holding the machine awake: systemd-inhibit --list

set -euo pipefail

UNIT=nosleep
INHIBIT=(systemd-inhibit --what=idle:sleep:handle-lid-switch --mode=block --who=nosleep)

usage() { awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; }
has_systemd() { command -v systemd-inhibit >/dev/null && [ -d /run/systemd/system ]; }

detach() {
    has_systemd || { echo "nosleep: -b needs systemd, and this host has none" >&2; exit 1; }
    [ $# -gt 0 ] || { echo "nosleep: -b needs a command to run" >&2; exit 1; }

    # Replace any existing hold rather than failing on the unit name. --collect
    # covers the other way the name stays taken: a command that exited nonzero
    # leaves a failed unit behind unless systemd is told to reap it.
    systemctl --user is-active --quiet "$UNIT" && systemctl --user stop "$UNIT"
    systemd-run --user --quiet --collect --unit="$UNIT" --description="nosleep: $*" \
        "${INHIBIT[@]}" --why="$*" "$@"
    echo "holding: $*  (cancel: systemctl --user stop $UNIT)"
}

case "${1:-}" in
    ''|-h|--help) usage; exit 0 ;;
    -b|--bg) shift; detach "$@"; exit 0 ;;
esac

if ! has_systemd; then
    echo "nosleep: no systemd on this host, running without an inhibitor" >&2
    exec "$@"
fi

exec "${INHIBIT[@]}" --why="$*" "$@"
