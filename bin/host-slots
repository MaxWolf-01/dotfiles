#!/usr/bin/env bash
# This machine's worker slots: at most HOST_SLOTS dispatched runs at once,
# whichever of its worker users starts them. dispatch-ctl takes a slot for each
# spawn and hands it to the worker's runner; worker-hosts counts them.
#
# Usage:
#   host-slots take <pid> <word>
#                 takes a slot for process <pid>, held while that process lives
#                 and its command line carries <word>. Exit 3: every slot held.
#   host-slots hand <from-pid> <to-pid> <word>
#                 moves <from-pid>'s slot to <to-pid>, held as `take` holds it,
#                 with no slot freed between. Exit 1: <from-pid> holds none.
#   host-slots count
#                 the slots held and the machine's count: `<held> <slots>`.
#
# Environment: HOST_SLOTS (the count, set where home-manager installs this),
# HOST_SLOTS_DIR (the slots, /tmp/dispatch-slots by default).
#
# The slots are files in one directory every user can write, sticky as /tmp is:
# <user>.<pid>, holding the word. A file whose process is gone, or whose pid
# another process has since been given, holds nothing, so a holder killed
# without cleaning up frees its slot, and a reboot, which ends every run, frees
# them all. Taking and handing over are serialized by a lock, so two spawns
# that both see the last slot free cannot both take it.
set -uo pipefail

dir=${HOST_SLOTS_DIR:-/tmp/dispatch-slots}

usage() { sed -n '2,/^set -uo/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//;$d'; }
die() { echo "host-slots: $1" >&2; exit 2; }

# Whether the slot file <holder> is held: its process lives and carries its word.
held() { tr '\0' ' ' < "/proc/${1##*.}/cmdline" 2> /dev/null | grep -qF -- "$(cat "$1" 2> /dev/null)"; }

# Every slot held now; a file that holds none is removed where this user may.
live() {
    local holder
    for holder in "$dir"/*.*; do
        [ -e "$holder" ] || continue
        if held "$holder"; then echo "$holder"; else rm -f "$holder" 2> /dev/null; fi
    done
}

# Runs the rest under the lock. World-writable and opened read-only, so it
# opens for every user, whoever made it first.
lock() {
    mkdir -p -m 1777 "$dir" 2> /dev/null
    [ -e "$dir/lock" ] || ( umask 0; : >> "$dir/lock" )
    exec 8< "$dir/lock" || die "cannot open $dir/lock"
    flock 8
}

pid_arg() { [[ $1 =~ ^[1-9][0-9]*$ ]] || die "not a pid: $1"; }

case ${1:-} in
    -h|--help) usage; exit 0 ;;
    take|hand|count) ;;
    *) usage >&2; exit 2 ;;
esac
[[ ${HOST_SLOTS:-} =~ ^[0-9]+$ ]] || die "no slot count: HOST_SLOTS is ${HOST_SLOTS:-unset}"

case $1 in
    take)
        [ $# -eq 3 ] || die "take takes <pid> <word>"
        pid_arg "$2"
        lock
        used=$(live | wc -l)
        if [ "$used" -ge "$HOST_SLOTS" ]; then
            echo "host-slots: no slot free on $(uname -n): $used of $HOST_SLOTS held" >&2
            exit 3
        fi
        printf '%s\n' "$3" > "$dir/$(id -un).$2"
        echo "host-slots: slot $((used + 1)) of $HOST_SLOTS taken on $(uname -n)" >&2 ;;
    hand)
        [ $# -eq 4 ] || die "hand takes <from-pid> <to-pid> <word>"
        pid_arg "$2"; pid_arg "$3"
        lock
        from=$dir/$(id -un).$2
        [ -e "$from" ] && held "$from" || { echo "host-slots: process $2 holds no slot here" >&2; exit 1; }
        printf '%s\n' "$4" > "$dir/$(id -un).$3"
        rm -f "$from" ;;
    count)
        [ $# -eq 1 ] || die "count takes nothing"
        lock
        echo "$(live | wc -l) $HOST_SLOTS" ;;
esac
