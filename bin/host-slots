#!/usr/bin/env bash
# This machine's worker slots: at most HOST_SLOTS dispatched runs at once,
# whichever of its worker users starts them. Dispatch's host side (dispatch-ctl,
# in the agents repo) takes a slot for each spawn and hands it to the worker's
# runner; worker-hosts counts them.
#
# Usage:
#   host-slots take <pid> <word>
#                 takes a slot for process <pid>, held while that process lives
#                 and its command line carries <word>. Exit 3: every slot held.
#   host-slots hand <from-pid> <to-pid> <word>
#                 moves <from-pid>'s slot to <to-pid>, held as `take` holds it,
#                 with no slot freed between. Exit 1: <from-pid> holds none.
#   host-slots count
#                 the slots held and the machine's count: `<held> <slots>`.
#
# Environment: HOST_SLOTS (the count, set where home-manager installs this),
# HOST_SLOTS_DIR (the slots, /run/host-slots by default).
#
# A slot is a file <user>.<pid> holding the word, in a sticky directory every
# user can write, which the machine's NixOS config makes under /run, so a
# reboot frees them all. A file whose process is gone, or whose pid now runs a
# command without the word, holds nothing, so a holder killed without cleaning
# up frees its slot. A lock serializes taking and handing over, so two spawns
# that both see the last slot free cannot both take it.
set -uo pipefail

dir=${HOST_SLOTS_DIR:-/run/host-slots}

usage() { sed -n '2,/^set -uo/p' "${BASH_SOURCE[0]}" | sed 's/^# \?//;$d'; }
die() { echo "host-slots: $1" >&2; exit 2; }

# Whether the slot file <holder> is held: its process lives and carries its word.
held() { tr '\0' ' ' 2> /dev/null < "/proc/${1##*.}/cmdline" | grep -qF -- "$(cat "$1" 2> /dev/null)"; }

# Every slot held now; a file that holds none is removed where this user may.
live() {
    local holder
    for holder in "$dir"/*.*; do
        [ -e "$holder" ] || continue
        if held "$holder"; then echo "$holder"; else rm -f "$holder" 2> /dev/null; fi
    done
}

# Runs the rest under the lock, opened read-only so it opens for every user.
# The directory and its lock are root's, made at boot (nix/nixos/agent-user.nix,
# its tmpfiles rules): one a worker user made could be cleared by that user of
# every other's slots.
lock() {
    [ -d "$dir" ] && [ -r "$dir/lock" ] ||
        die "no slot directory with a lock at $dir; nix/nixos/agent-user.nix's tmpfiles rules make it, and HOST_SLOTS_DIR points a check elsewhere"
    exec 8< "$dir/lock" || die "cannot open $dir/lock"
    flock 8
}

pid_arg() { [[ $1 =~ ^[1-9][0-9]*$ ]] || die "not a pid: $1"; }

case ${1:-} in
    -h|--help) usage; exit 0 ;;
    take|hand|count) ;;
    *) usage >&2; exit 2 ;;
esac
[[ ${HOST_SLOTS:-} =~ ^[0-9]+$ ]] || die "no slot count: HOST_SLOTS is ${HOST_SLOTS:-unset}; the wrapper nix/nixos/agent-user.nix installs sets it from the machine's slots"

case $1 in
    take)
        [ $# -eq 3 ] || die "take takes <pid> <word>"
        pid_arg "$2"
        lock
        used=$(live | wc -l)
        if [ "$used" -ge "$HOST_SLOTS" ]; then
            echo "host-slots: no slot free on $(uname -n): $used of $HOST_SLOTS held" >&2
            exit 3
        fi
        printf '%s\n' "$3" > "$dir/$(id -un).$2"
        echo "host-slots: slot $((used + 1)) of $HOST_SLOTS taken on $(uname -n)" >&2 ;;
    hand)
        [ $# -eq 4 ] || die "hand takes <from-pid> <to-pid> <word>"
        pid_arg "$2"; pid_arg "$3"
        lock
        from=$dir/$(id -un).$2
        [ -e "$from" ] && held "$from" || { echo "host-slots: process $2 holds no slot here" >&2; exit 1; }
        printf '%s\n' "$4" > "$dir/$(id -un).$3"
        rm -f "$from" ;;
    count)
        [ $# -eq 1 ] || die "count takes nothing"
        lock
        echo "$(live | wc -l) $HOST_SLOTS" ;;
esac
