#!/usr/bin/env bash
# Deploy jarvis: on the jarvis host, pull master in /opt/jarvis, then rebuild and
# restart its docker compose stack.
#
# Usage: jarvis-deploy
set -euo pipefail
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac

ssh -t jarvis 'cd /opt/jarvis && git switch master && git pull && docker compose down && docker compose up -d --build'
