#!/usr/bin/env bash
# Schedule a one-off suspend some time from now.
#
# `sleep 2h; systemctl suspend` does the same thing but dies with the terminal
# that started it. This uses a transient systemd timer instead, so it survives
# closing the shell or the tmux pane, and can be inspected and cancelled later.
#
# The suspend is inhibitable: if a `nosleep` job is still running when the timer
# fires, logind refuses it and the machine stays awake. The timer is gone either
# way, so a refused suspend does not retry.
#
# Usage:
#   suspend-in 2h        suspend two hours from now
#   suspend-in 90m       any systemd time span works: 30s, 45min, 1h30m
#   suspend-in status    show when the pending suspend fires
#   suspend-in cancel    call it off

set -euo pipefail

UNIT=suspend-in

usage() { awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; }
pending() { systemctl --user is-active --quiet "$UNIT.timer" 2>/dev/null; }

case "${1:-}" in
    ''|-h|--help)
        usage
        ;;
    status)
        pending || { echo "no suspend scheduled"; exit 0; }
        systemctl --user list-timers --all --no-pager "$UNIT.timer"
        ;;
    cancel)
        pending || { echo "no suspend scheduled"; exit 0; }
        systemctl --user stop "$UNIT.timer"
        echo "cancelled"
        ;;
    *)
        # Replace any existing schedule rather than failing on the unit name.
        pending && systemctl --user stop "$UNIT.timer"
        systemd-run --user --quiet --unit="$UNIT" --on-active="$1" \
            --timer-property=RemainAfterElapse=no systemctl suspend
        systemctl --user list-timers --all --no-pager "$UNIT.timer"
        ;;
esac
