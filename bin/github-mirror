#!/usr/bin/env bash
# Mirror all GitHub repos for specified accounts to ~/repos/github/<owner>/
# Clones missing repos, fetches existing ones, and fast-forwards a checkout
# that has nothing local at stake. Safe for working copies: a branch with
# uncommitted or unpushed work is left where it is.
set -euo pipefail

BASE_DIR="$HOME/repos/github"
ACCOUNTS=("MaxWolf-01" "yapit-tts")

# Every run leaves one line in ~/logs/runs/github-mirror.jsonl (bin/run-log),
# the abort before the first fetch included. Recording the run must never
# decide whether the mirror succeeded: run-log explains itself on stderr and
# the mirror carries on. Reached by path: the timer's PATH has no ~/bin.
run_log_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-log"
log_run() {
    "$run_log_bin" github-mirror "$@" || true
}
logged=0
trap '[ "$logged" = 1 ] || log_run fail --reason "aborted with exit $?"' EXIT

cloned=0
fetched=0
forwarded=0
current=0
left=0
failed=0

# Fast-forward the checked-out branch to its upstream, or print why not.
# Only a branch with an upstream, no merge/rebase/cherry-pick in progress and
# no modified tracked files qualifies; untracked files are ambient and do not
# count, and git itself refuses a fast-forward that would overwrite one.
fast_forward() {
    local dir="$1" behind
    git -C "$dir" symbolic-ref -q HEAD >/dev/null || { echo "detached HEAD"; return 1; }
    git -C "$dir" rev-parse -q --verify '@{u}' >/dev/null 2>&1 || { echo "no upstream"; return 1; }
    local marker
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
        if [ -e "$(git -C "$dir" rev-parse --git-path "$marker")" ]; then
            echo "$marker in progress"; return 1
        fi
    done
    if [ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]; then
        echo "dirty"; return 1
    fi
    behind=$(git -C "$dir" rev-list --count 'HEAD..@{u}')
    if [ "$behind" -eq 0 ]; then
        echo "current"; return 2
    fi
    if ! git -C "$dir" merge --ff-only --quiet '@{u}' 2>/dev/null; then
        echo "not fast-forwardable ($behind behind, $(git -C "$dir" rev-list --count '@{u}..HEAD') ahead)"; return 1
    fi
    echo "fast-forwarded $behind"
}

for owner in "${ACCOUNTS[@]}"; do
    dir="$BASE_DIR/$owner"
    mkdir -p "$dir"

    echo "=== $owner ==="
    LIMIT=10000
    repos=$(gh repo list "$owner" --limit "$LIMIT" --json name --jq '.[].name')
    count=$(echo "$repos" | grep -c .)
    if [ "$count" -eq "$LIMIT" ]; then
        echo "  WARNING: got exactly $LIMIT repos — results may be truncated!" >&2
    fi
    echo "  $count repos on GitHub"

    while IFS= read -r repo; do
        [ -z "$repo" ] && continue
        repo_dir="$dir/$repo"

        if [ -d "$repo_dir/.git" ]; then
            printf "  fetch  %s ... " "$repo"
            if ! git -C "$repo_dir" fetch --all --quiet 2>&1; then
                echo "FAILED"
                ((failed++)) || true
                continue
            fi
            ((fetched++)) || true
            outcome=$(fast_forward "$repo_dir") && rc=0 || rc=$?
            echo "ok, $outcome"
            case $rc in
                0) ((forwarded++)) || true ;;
                2) ((current++)) || true ;;
                *) ((left++)) || true ;;
            esac
        else
            printf "  clone  %s ... " "$repo"
            if gh repo clone "$owner/$repo" "$repo_dir" -- --quiet 2>&1; then
                echo "ok"
                ((cloned++)) || true
            else
                echo "FAILED"
                ((failed++)) || true
            fi
        fi
    done <<< "$repos"
    echo
done

echo "Done: $cloned cloned, $fetched fetched ($forwarded fast-forwarded, $current current, $left left as they were), $failed failed"

stats=$(printf '{"cloned":%d,"fetched":%d,"fast_forwarded":%d,"current":%d,"left":%d,"failed":%d}' \
    "$cloned" "$fetched" "$forwarded" "$current" "$left" "$failed")
if [ "$failed" -eq 0 ]; then
    log_run ok --stats "$stats"
else
    log_run fail --reason "$failed repos failed to clone or fetch" --stats "$stats"
fi
logged=1
