#!/usr/bin/env bash
# Mirror GitHub repos to ~/repos/github/<owner>/<repo>: clone what the listed
# accounts have and this machine lacks, then fetch every clone under that tree,
# hand-cloned ones from any owner included, and fast-forward a checkout that
# has nothing local at stake. Safe for working copies: a branch with
# uncommitted or unpushed work is left where it is, and a repo that vanished
# upstream is left as it was.
set -euo pipefail

BASE_DIR="$HOME/repos/github"
ACCOUNTS=("MaxWolf-01" "yapit-tts")

# Every run leaves one line in ~/logs/runs/github-mirror.jsonl (bin/run-log):
# ok with the counters once the walk completes, failed repos included, and fail
# only when the script dies before its summary. Recording the run must never
# decide whether the mirror succeeded: run-log explains itself on stderr and
# the mirror carries on. Reached by path: the timer's PATH has no ~/bin.
run_log_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-log"
log_run() {
    "$run_log_bin" github-mirror "$@" || true
}
logged=0
trap '[ "$logged" = 1 ] || log_run fail --reason "aborted with exit $?"' EXIT

cloned=0
fetched=0
forwarded=0
current=0
left=0
failed=0

# Fast-forward the checked-out branch to its upstream, or print why not.
# Only a branch with an upstream, no merge/rebase/cherry-pick in progress and
# no modified tracked files qualifies; untracked files are ambient and do not
# count, and git itself refuses a fast-forward that would overwrite one.
fast_forward() {
    local dir="$1" behind
    git -C "$dir" symbolic-ref -q HEAD >/dev/null || { echo "detached HEAD"; return 1; }
    git -C "$dir" rev-parse -q --verify '@{u}' >/dev/null 2>&1 || { echo "no upstream"; return 1; }
    local marker
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
        if [ -e "$(git -C "$dir" rev-parse --git-path "$marker")" ]; then
            echo "$marker in progress"; return 1
        fi
    done
    if [ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]; then
        echo "dirty"; return 1
    fi
    behind=$(git -C "$dir" rev-list --count 'HEAD..@{u}')
    if [ "$behind" -eq 0 ]; then
        echo "current"; return 2
    fi
    if ! git -C "$dir" merge --ff-only --quiet '@{u}' 2>/dev/null; then
        echo "not fast-forwardable ($behind behind, $(git -C "$dir" rev-list --count '@{u}..HEAD') ahead)"; return 1
    fi
    echo "fast-forwarded $behind"
}

# Pass 1: clone what the listed accounts have and this tree lacks.
for owner in "${ACCOUNTS[@]}"; do
    dir="$BASE_DIR/$owner"
    mkdir -p "$dir"

    echo "=== $owner ==="
    LIMIT=10000
    if ! repos=$(gh repo list "$owner" --limit "$LIMIT" --json name --jq '.[].name'); then
        echo "  gh repo list failed; no clones for $owner this run" >&2
        ((failed++)) || true
        continue
    fi
    count=$(echo "$repos" | grep -c .)
    if [ "$count" -eq "$LIMIT" ]; then
        echo "  WARNING: got exactly $LIMIT repos — results may be truncated!" >&2
    fi
    echo "  $count repos on GitHub"

    while IFS= read -r repo; do
        [ -z "$repo" ] && continue
        [ -e "$dir/$repo/.git" ] && continue
        printf "  clone  %s ... " "$repo"
        if gh repo clone "$owner/$repo" "$dir/$repo" -- --quiet 2>&1; then
            echo "ok"
            ((cloned++)) || true
        else
            echo "FAILED"
            ((failed++)) || true
        fi
    done <<< "$repos"
    echo
done

# Pass 2: every clone in the tree, whichever owner. A worktree (.git is a file,
# not a directory) carries a branch of its own and is skipped. A fetch that
# fails on one remote still brings the others in, so the fast-forward is
# attempted either way; it finds nothing new when the failing remote was the
# upstream.
echo "=== fetch ==="
for repo_dir in "$BASE_DIR"/*/*/; do
    [ -d "$repo_dir/.git" ] || continue
    name="${repo_dir#"$BASE_DIR"/}"
    printf "  fetch  %s ... " "${name%/}"
    if git -C "$repo_dir" fetch --all --quiet 2>/dev/null; then
        ((fetched++)) || true
        printf "ok, "
    else
        ((failed++)) || true
        printf "FAILED for a remote, "
    fi
    outcome=$(fast_forward "$repo_dir") && rc=0 || rc=$?
    echo "$outcome"
    case $rc in
        0) ((forwarded++)) || true ;;
        2) ((current++)) || true ;;
        *) ((left++)) || true ;;
    esac
done
echo

echo "Done: $cloned cloned, $fetched fetched ($forwarded fast-forwarded, $current current, $left left as they were), $failed failed"

stats=$(printf '{"cloned":%d,"fetched":%d,"fast_forwarded":%d,"current":%d,"left":%d,"failed":%d}' \
    "$cloned" "$fetched" "$forwarded" "$current" "$left" "$failed")
log_run ok --stats "$stats"
logged=1
