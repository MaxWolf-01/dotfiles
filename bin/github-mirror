#!/usr/bin/env bash
# Clone what a GitHub account has and this machine lacks, then fetch the clones
# and fast-forward a checkout that has nothing local at stake: a branch with
# uncommitted or unpushed work is left where it is, no checkout changes branch,
# and a repo that vanished upstream is left as it was.
#
# Usage: github-mirror
#          Clones the accounts this script lists into ~/repos/github/<owner>/<repo>.
#          Fetches every clone in that tree, whatever its owner, from all its
#          remotes, without pruning. Logs as github-mirror.
#
#        github-mirror OWNER DIR [CLONE...]
#          Clones OWNER's unarchived repos into DIR/<repo>. Fetches only the
#          clones in DIR whose origin is OWNER's, and each CLONE, whatever its
#          owner and wherever it is (DIR itself, say), from origin alone, with
#          --prune. Logs as <owner, lowercased>-mirror.
set -euo pipefail
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac

case $# in
    1)
        echo "github-mirror: takes no arguments, or OWNER DIR [CLONE...]; see --help" >&2
        exit 2
        ;;
    0)
        unit=github-mirror
        base_dir="$HOME/repos/github"
        accounts=("MaxWolf-01" "yapit-tts")
        list_flags=()
        fetch_args=(--all)
        clone_dir() { echo "$base_dir/$1"; }
        walked_dirs() { printf '%s\n' "$base_dir"/*/*/; }
        in_scope() { true; }
        ;;
    *)
        unit="${1,,}-mirror"
        base_dir="${2%/}"
        accounts=("$1")
        extra_clones=()
        for clone in "${@:3}"; do extra_clones+=("${clone%/}/"); done
        list_flags=(--no-archived)
        fetch_args=(origin --prune)
        clone_dir() { echo "$base_dir"; }
        # The dotted pattern is for an org's .github repo. A CLONE inside DIR
        # is walked once.
        walked_dirs() {
            local -A seen=()
            local dir
            for dir in "$base_dir"/*/ "$base_dir"/.[!.]*/ "${extra_clones[@]}"; do
                [ -z "${seen[$dir]:-}" ] || continue
                seen[$dir]=1
                printf '%s\n' "$dir"
            done
        }
        # The raw setting, as `git remote get-url` would apply any insteadOf.
        in_scope() {
            local clone
            for clone in "${extra_clones[@]}"; do [ "$1" = "$clone" ] && return 0; done
            [[ $(git -C "$1" config --get remote.origin.url) == *github.com[:/]"${accounts[0]}"/* ]]
        }
        ;;
esac

# Every run leaves one line in ~/logs/runs/<unit>.jsonl (bin/run-log): ok with
# the counters once the walk completes, failed repos included; skip when no clone
# could be fetched because GitHub is out of reach; fail when none could be fetched
# with GitHub there, so a mirror that does nothing cannot pass for one that works,
# when the walk found no clone at all, and when the script dies before its summary. Recording the run must never decide
# whether the mirror succeeded: run-log explains itself on stderr and the mirror
# carries on. Reached by path: the timer's PATH has no ~/bin.
run_log_bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/run-log"
log_run() {
    "$run_log_bin" "$unit" "$@" || true
}
logged=0
trap '[ "$logged" = 1 ] || log_run fail --reason "aborted with exit $?"' EXIT

cloned=0
fetched=0
forwarded=0
current=0
left=0
failed=0

# Fast-forward the checked-out branch to its upstream, or print why not.
# Only a branch with an upstream, no merge/rebase/cherry-pick in progress and
# no modified tracked files qualifies; untracked files are ambient and do not
# count, and git itself refuses a fast-forward that would overwrite one.
fast_forward() {
    local dir="$1" behind
    git -C "$dir" symbolic-ref -q HEAD >/dev/null || { echo "detached HEAD"; return 1; }
    git -C "$dir" rev-parse -q --verify '@{u}' >/dev/null 2>&1 || { echo "no upstream"; return 1; }
    local marker
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
        if [ -e "$(git -C "$dir" rev-parse --git-path "$marker")" ]; then
            echo "$marker in progress"; return 1
        fi
    done
    if [ -n "$(git -C "$dir" status --porcelain --untracked-files=no)" ]; then
        echo "dirty"; return 1
    fi
    behind=$(git -C "$dir" rev-list --count 'HEAD..@{u}')
    if [ "$behind" -eq 0 ]; then
        echo "current"; return 2
    fi
    if ! git -C "$dir" merge --ff-only --quiet '@{u}' 2>/dev/null; then
        echo "not fast-forwardable ($behind behind, $(git -C "$dir" rev-list --count '@{u}..HEAD') ahead)"; return 1
    fi
    echo "fast-forwarded $behind"
}

# Pass 1: clone what the listed accounts have and this tree lacks.
for owner in "${accounts[@]}"; do
    dir=$(clone_dir "$owner")
    mkdir -p "$dir"

    echo "=== $owner ==="
    LIMIT=10000
    if ! repos=$(gh repo list "$owner" --limit "$LIMIT" "${list_flags[@]}" --json name --jq '.[].name'); then
        echo "  gh repo list failed; no clones for $owner this run" >&2
        ((failed++)) || true
        continue
    fi
    count=$(echo "$repos" | grep -c .)
    if [ "$count" -eq "$LIMIT" ]; then
        echo "  WARNING: got exactly $LIMIT repos — results may be truncated!" >&2
    fi
    echo "  $count repos on GitHub"

    while IFS= read -r repo; do
        [ -z "$repo" ] && continue
        [ -e "$dir/$repo/.git" ] && continue
        printf "  clone  %s ... " "$repo"
        if gh repo clone "$owner/$repo" "$dir/$repo" -- --quiet 2>&1; then
            echo "ok"
            ((cloned++)) || true
        else
            echo "FAILED"
            ((failed++)) || true
        fi
    done <<< "$repos"
    echo
done

# Pass 2: the clones in the tree. A worktree (.git is a file, not a directory)
# carries a branch of its own and is skipped. A fetch that fails on one remote
# still brings the others in, so the fast-forward is attempted either way; it
# finds nothing new when the failing remote was the upstream. git fetch itself
# waits forever on a remote that accepts the connection and never answers, so
# each fetch is cut off after five minutes and counted as failed.
echo "=== fetch ==="
while IFS= read -r repo_dir; do
    [ -d "$repo_dir/.git" ] || continue
    in_scope "$repo_dir" || continue
    name="${repo_dir#"$base_dir"/}"
    name="${name:-$base_dir}"
    printf "  fetch  %s ... " "${name%/}"
    if timeout 300 git -C "$repo_dir" fetch "${fetch_args[@]}" --quiet 2>/dev/null; then
        ((fetched++)) || true
        printf "ok, "
    else
        ((failed++)) || true
        printf "FAILED for a remote, "
    fi
    outcome=$(fast_forward "$repo_dir") && rc=0 || rc=$?
    echo "$outcome"
    case $rc in
        0) ((forwarded++)) || true ;;
        2) ((current++)) || true ;;
        *) ((left++)) || true ;;
    esac
done < <(walked_dirs)
echo

echo "Done: $cloned cloned, $fetched fetched ($forwarded fast-forwarded, $current current, $left left as they were), $failed failed"

stats=$(printf '{"cloned":%d,"fetched":%d,"fast_forwarded":%d,"current":%d,"left":%d,"failed":%d}' \
    "$cloned" "$fetched" "$forwarded" "$current" "$left" "$failed")
if [ "$fetched" -eq 0 ] && [ "$failed" -gt 0 ]; then
    # A public repo, so the answer says nothing about this machine's credentials.
    if timeout 30 git ls-remote --quiet https://github.com/git/git HEAD >/dev/null 2>&1; then
        log_run fail --reason "no clone could be fetched, though GitHub answers" --stats "$stats"
    else
        log_run skip --reason "GitHub not reachable" --stats "$stats"
    fi
elif [ "$fetched" -eq 0 ]; then
    log_run fail --reason "found no clone to fetch" --stats "$stats"
else
    log_run ok --stats "$stats"
fi
logged=1
