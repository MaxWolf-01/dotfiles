#!/usr/bin/env bash
# Unlock what a host keeps locked after a boot, from the machine that holds the
# secrets. Run it on zephylux, by hand or from an agent, after the host was
# rebooted (pc, xmg19).
#
# Usage:
#   host-unlock <host>
#
# The hosts with an unlock, and the steps each runs, are their entries'
# `unlock` in nix/home/machines.nix, read from the copy Home Manager writes
# out, ~/.config/machines.json (MACHINES_FILE points elsewhere). Each step runs
# a command on the host over ssh, handed a secret from secrets/creds/raw/ or
# the age key on stdin.
#
# Safe to run again: whatever is already unlocked is left as it is.
set -euo pipefail
case ${1:-} in -h|--help|'') awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac

SECRETS="$HOME/.dotfiles/secrets"
AGE_KEY="${SOPS_AGE_KEY_FILE:?is not set; the Home Manager config of this host, in nix/home/hosts/, sets it}"
MACHINES="${MACHINES_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/machines.json}"

[ -r "$MACHINES" ] || { echo "host-unlock: no machines list at $MACHINES; Home Manager writes it (nix/home/machines.nix)" >&2; exit 1; }
machine=$(jq -c --arg name "$1" '.[] | select(.name == $name and .unlock != [])' "$MACHINES")
if [ -z "$machine" ]; then
  echo "host-unlock: no unlock known for '$1' ($(jq -r '[.[] | select(.unlock != []) | .name] | join(", ")' "$MACHINES"))" >&2
  exit 1
fi
if jq -e 'any(.unlock[]; .ageKey)' <<<"$machine" >/dev/null && [ ! -r "$AGE_KEY" ]; then
  echo "host-unlock: no age key at $AGE_KEY" >&2
  exit 1
fi

dest=$(jq -r .ssh <<<"$machine")
# ssh joins its command's words with spaces, so the step's command goes as one.
# The secret comes last: read drops an empty field anywhere before the last.
while IFS=$'\t' read -r age_key run secret; do
  if [ -n "$secret" ]; then
    sops -d "$SECRETS/creds/raw/$secret" | ssh "$dest" "$run"
  elif [ "$age_key" = true ]; then
    ssh "$dest" "$run" < "$AGE_KEY"
  else
    ssh "$dest" "$run" < /dev/null
  fi
done < <(jq -r '.unlock[] | [.ageKey, (.run | join(" ")), .secret // ""] | @tsv' <<<"$machine")
