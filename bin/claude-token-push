#!/usr/bin/env bash
# Give every dispatch worker user the setup-token of its Claude account, and log
# out the browser login it signed in with before.
#
# A worker user's record, nix/home/hosts/<config>/HOST.md, names its account;
# the token is CLAUDE_CODE_OAUTH_TOKEN in secrets/creds/env/claude-<account>.env.
# A worker user is one made for workers alone (nix/home/worker.nix), whose
# record says isolated: true. max@zephylux names an account too, for placement,
# but is max's own user, whose login `claude-account` manages, so it never is.
# On each host:
#
#   1. `claude -p` has to answer on the new token before it replaces the one
#      the user held, in ~/.config/claude-token (mode 600), which its shell
#      exports (nix/home/worker-claude-token.zsh); a token claude refuses is
#      left out, and the run fails;
#   2. a fresh shell there has to export that token; otherwise the browser
#      login stays, and the run fails;
#   3. `claude auth logout` drops the browser login, unless a claude session
#      that started before the token is still running on it: that login stays
#      until the session ends, and the run fails, naming the host to push again.
#
# Run it on zephylux after minting an account's token, which the yearly renewal
# does, and after a worker's home is rebuilt. An account whose token is not
# minted yet is skipped, its workers left on their login. A host that is down
# is reported and the rest still pushed. The token is never printed.
#
# Usage:
#   claude-token-push                 every worker user
#   claude-token-push agent@pc ...    only these
set -uo pipefail

repo="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
creds="$HOME/.dotfiles/secrets/creds/env"
ssh_opts=(-o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new)

usage() { sed -n '2,/^set -uo/p' "${BASH_SOURCE[0]}" | sed 's/^# \?//;$d'; }
die() { echo "claude-token-push: $1" >&2; exit 2; }

case ${1:-} in -h|--help) usage; exit 0 ;; -*) die "unknown argument: $1" ;; esac

# A frontmatter field of a HOST.md record.
field() { sed -n '2,/^---$/p' "$1" | sed -n "s/^$2: *//p" | head -1; }

# Writes stdin, the token, in place of the old one in one rename, once claude
# answers on it. Prints why when it does not.
read -r -d '' install_token <<'REMOTE'
umask 077 && mkdir -p ~/.config && cat >~/.config/claude-token.new || exit 1
if ! out=$(CLAUDE_CODE_OAUTH_TOKEN="$(cat ~/.config/claude-token.new)" timeout 120 claude -p ping --model haiku \
    --strict-mcp-config --mcp-config '{"mcpServers":{}}' --no-session-persistence --disable-slash-commands 2>&1); then
  rm -f ~/.config/claude-token.new
  echo "claude -p fails on the new token, so it keeps the token and login it had: $out"
  exit 1
fi
mv ~/.config/claude-token.new ~/.config/claude-token
REMOTE

# Runs in the worker's own shell, which has read .zshenv: its environment is
# what every claude there starts with. Prints one line saying how it ended.
read -r -d '' check_and_logout <<'REMOTE'
if [ "${CLAUDE_CODE_OAUTH_TOKEN-}" != "$(cat ~/.config/claude-token)" ]; then
  echo "token written, but its shell does not export it, so the browser login stays: is nix/home/worker-claude-token.zsh switched in on this host (nswitch)?"
  exit 1
fi
on_login=0
for pid in $(pgrep -u "$(id -u)" -x claude); do
  tr '\0' '\n' </proc/$pid/environ 2>/dev/null | grep -q '^CLAUDE_CODE_OAUTH_TOKEN=' || on_login=$((on_login + 1))
done
if [ "$on_login" -gt 0 ]; then
  echo "on the token, but $on_login claude session(s) still run on the browser login, which stays until they end: push to this host again then"
  exit 1
fi
creds=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json
if [ -e "$creds" ]; then
  # Unset, so that logout sees only the browser login and never the account's token.
  env -u CLAUDE_CODE_OAUTH_TOKEN claude auth logout >/dev/null 2>&1
  rm -f "$creds"
  echo "on the token; browser login logged out"
else
  echo "on the token"
fi
REMOTE

# Every worker user whose record names an account: user@host and that account.
workers=()
for record in "$repo"/nix/home/hosts/*/HOST.md; do
  account=$(field "$record" account)
  [ -n "$account" ] && [ "$(field "$record" isolated)" = true ] && workers+=("$(field "$record" user)@$(field "$record" host) $account")
done
if [ $# -gt 0 ]; then
  chosen=()
  for target in "$@"; do
    match=$(printf '%s\n' "${workers[@]}" | awk -v t="$target" '$1 == t' | grep .) ||
      die "no worker user with an account: $target (have: $(printf '%s\n' "${workers[@]}" | cut -d' ' -f1 | paste -sd' ' -))"
    chosen+=("$match")
  done
  workers=("${chosen[@]}")
fi

declare -A token=()
failed=0
for worker in "${workers[@]}"; do
  read -r target account <<<"$worker"
  if [ -z "${token[$account]+set}" ]; then
    file="$creds/claude-$account.env"
    [ -f "$file" ] || die "no $file, so the $account account has no token to push"
    plain=$(sops decrypt --input-type dotenv --output-type dotenv "$file") ||
      die "could not decrypt $file (is the age key SOPS_AGE_KEY_FILE names, '${SOPS_AGE_KEY_FILE:-}', there?)"
    token[$account]=$(sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' <<<"$plain")
  fi
  if [ -z "${token[$account]}" ]; then
    echo "skipped: $target: the $account token is not minted yet, so it stays on its browser login"
    continue
  fi

  out=$(printf '%s\n' "${token[$account]}" | ssh "${ssh_opts[@]}" "$target" "$install_token" 2>&1)
  case $? in
    0) out=$(ssh "${ssh_opts[@]}" "$target" "$check_and_logout" </dev/null 2>&1) ;;
    255) out="could not reach it to write the token (host down, or its home locked?)"; false ;;
    *) out=${out:-could not write the token}; false ;;
  esac
  if [ $? -eq 0 ]; then
    echo "ok: $target ($account): $out"
  else
    echo "FAILED: $target ($account): ${out:-no answer}"
    failed=$((failed + 1))
  fi
done

[ "$failed" -eq 0 ] || { echo "claude-token-push: $failed worker user(s) not done; see above" >&2; exit 1; }
