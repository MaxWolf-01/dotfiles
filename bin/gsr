#!/usr/bin/env bash
# Pick a remote branch with fzf and switch to it. The first time, git creates a
# local branch of the same name that tracks it; after that it switches to that
# local branch, which `git pull` brings up to date. The preview shows the
# branch's own commits, the ones the current branch lacks.
#
# Usage: gsr [QUERY]
#   QUERY   prefills fzf's search
set -eu

case "${1:-}" in -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;; esac

# Newest first, which fzf draws at the bottom, next to its prompt.
ref=$(gbr --color=always | tac | fzf --ansi --no-sort --query="${1:-}" \
  --preview='git log --oneline --color=always HEAD..{1}' | awk '{ print $1 }')
[[ -n "$ref" ]] || exit 0

name=${ref#*/}
if git show-ref --verify --quiet "refs/heads/$name"; then
  git switch "$name"
else
  git switch --track "$ref"
fi
