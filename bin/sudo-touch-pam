#!/usr/bin/env bash
# sudo-touch-pam: put a YubiKey touch in front of the password in Ubuntu's sudo
# PAM stack, as `auth sufficient pam_u2f.so cue` above `@include common-auth`.
#
#   sudo-touch-pam [FILE]     FILE defaults to /etc/pam.d/sudo
#
# `sufficient` is what keeps the password: a touch ends the auth stack, and no
# key, no registered key, or no touch falls through to common-auth unchanged.
# A second run changes nothing. The file is replaced in one rename, and only by
# a version that still parses; anything it does not recognise (a pam_u2f line
# of another shape, no `@include common-auth`) it refuses to touch.
#
# `./setup ubuntu` runs it after installing libpam-u2f; docs/sudo-touch.md has
# the keys, the test and how to back out.

set -euo pipefail

case "${1:-}" in
    -h|--help)
        sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//;$d'
        exit 0
        ;;
esac

line='auth       sufficient pam_u2f.so cue'
file="${1:-/etc/pam.d/sudo}"

die() {
    echo "sudo-touch-pam: $*; $file is unchanged" >&2
    exit 1
}

[ -f "$file" ] || die "no such file"

# Line numbers of the uncommented lines naming pam_u2f, and of the include.
u2f=$(grep -nE '^[[:space:]]*[^#].*pam_u2f\.so' "$file" | cut -d: -f1 || true)
include=$(grep -nxE '[[:space:]]*@include[[:space:]]+common-auth[[:space:]]*' "$file" | cut -d: -f1 || true)

[ "$(wc -w <<<"$include")" -eq 1 ] || die "expected one '@include common-auth', found $(wc -w <<<"$include")"

if [ -n "$u2f" ]; then
    if [ "$(wc -w <<<"$u2f")" -eq 1 ] && [ "$(sed -n "${u2f}p" "$file")" = "$line" ] && [ "$u2f" -lt "$include" ]; then
        echo "sudo-touch-pam: $file already asks for a touch first"
        exit 0
    fi
    die "it already names pam_u2f in a way this does not manage (line $u2f); edit it by hand"
fi

new=$(mktemp "$(dirname "$file")/.sudo-touch-pam.XXXXXX")
trap 'rm -f "$new"' EXIT
awk -v at="$include" -v line="$line" 'NR == at { print line } { print }' "$file" >"$new"

# What PAM reads: blank lines, comments, @include, and `[-]type control module
# [args]` where control is a word or a bracketed list. A line of any other
# shape makes libpam drop the whole stack.
bad=$(grep -nvE '^[[:space:]]*($|#|@include[[:space:]]+[^[:space:]]+[[:space:]]*$|-?(auth|account|password|session)[[:space:]]+([a-z_]+|\[[^]]*\])[[:space:]]+[^[:space:]]+)' "$new" || true)
[ -z "$bad" ] || die "the edited version would not parse at: $bad"
[ "$(grep -cxF "$line" "$new")" -eq 1 ] || die "the edited version does not hold the line exactly once"

chmod --reference="$file" "$new"
chown --reference="$file" "$new"
mv "$new" "$file"
trap - EXIT
echo "sudo-touch-pam: $file now asks for a touch before the password"
