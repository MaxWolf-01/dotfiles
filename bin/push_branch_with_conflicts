#!/usr/bin/env bash
# Set aside a local master that has diverged from origin (on Android, say) so the
# conflict can be resolved later in an IDE: push it to a new branch, then reset
# master to origin/master. Asks for Enter before it starts; run it from inside
# the repo.
#
# The branch is meant to be tmp/merge-conflicts-<HHMM>, but `date + %H%M` fails
# on the stray space, so it is tmp/merge-conflicts- every time. Nothing stops on
# an error: a second run cannot create that branch, pushes nothing new, and
# still resets master, which throws away the local commits.
echo "This script will push local changes to an extra branch and reset master to remote"
echo "Make sure you are in the correct repo, otherwise press Ctrl+C"
echo "Current directory: $(pwd)"
echo "Press enter to continue"
read -r
git remote prune  # remove stale branches
git switch master
stamp="$(date + %H%M)"
git switch -c tmp/merge-conflicts-"$stamp"
git push -u origin tmp/merge-conflicts-"$stamp"
git switch master
git fetch --all
git reset --hard origin/master
