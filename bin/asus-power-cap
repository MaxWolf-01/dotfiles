#!/usr/bin/env bash
# Cap the CPU power limits the ASUS EC enforces (asus-armoury firmware attributes).
#
#   spl  (arg 1)  sustained limit — sets steady-state temperature and fan floor
#   sppt (arg 2)  boost limit for the first ~60s, then spl takes over
#
# Raise sppt if the machine feels slow: it drives short bursts and costs little
# heat. Raise spl only if long builds feel slow; that heat you pay all day. All-
# core load hits the thermal limit near 53W, so a high sppt only binds on the
# few-core bursts interactive work is made of.
#
# Two things override your cap, both handled by the installed udev rules:
#   battery — range collapses to 25-40W on both rails and the EC enforces values
#             of its own. Not yours to tune. Configuring therefore requires AC,
#             since an AC cap cannot be range-checked against the battery range.
#             Replugging restores your caps by itself.
#   profile — any quiet/balanced/performance switch silently drops the cap while
#             current_value still reports it. Measured 48W against a reported
#             35W. Only measured power proves a cap holds: cpu-power-bench.
#
# Once the cap holds, the profile is a noise dial, not a speed one. At spl=35W,
# all-core (GU603ZW, i9-12900H): balanced 89-92°C, performance 74-79°C, both at
# ~2250MHz. Same work, ~15°C apart.
#
# Applying installs a root-owned helper (/usr/local/sbin/asus-power-cap-apply),
# a service for boot and resume, and udev rules for AC and profile changes.
#
# Usage:
#   asus-power-cap <spl-watts> [sppt-watts]   apply caps + install units
#   asus-power-cap status                     show values, range, source, profile
#   asus-power-cap reset                      restore defaults, remove units
#
# Scenarios (stock is 60/135 on AC, which rides 95°C+):
#   asus-power-cap 35 105   # good daily default: cool sustained, hard bursts
#   asus-power-cap 28 45    # overheating, heavy bed use
#   asus-power-cap 45 90    # docked on a hard desk, sustained work
#   asus-power-cap reset    # back to stock

set -euo pipefail

ATTRS=/sys/class/firmware-attributes/asus-armoury/attributes
RAILS=(ppt_pl1_spl ppt_pl2_sppt)
HELPER_PATH=/usr/local/sbin/asus-power-cap-apply
UNIT_NAME=asus-power-cap.service
UNIT_PATH=/etc/systemd/system/$UNIT_NAME
RULE_PATH=/etc/udev/rules.d/99-asus-power-cap.rules

[ -d "$ATTRS/ppt_pl1_spl" ] || { echo "error: $ATTRS/ppt_pl1_spl not found (asus-armoury driver missing?)" >&2; exit 1; }

on_ac() {
    local ac
    for ac in /sys/class/power_supply/*/type; do
        if [ "$(cat "$ac")" = Mains ] && [ "$(cat "${ac%/type}/online")" = 1 ]; then return 0; fi
    done
    return 1
}

require_ac() {
    on_ac || { echo "error: on battery. The EC enforces its own limits there and the writable range shrinks to 25-40W, so an AC cap cannot be checked. Plug in and retry." >&2; exit 1; }
}

show() {
    if on_ac; then echo "source: AC"; else echo "source: battery (EC enforces its own limits)"; fi
    if [ -r /sys/firmware/acpi/platform_profile ]; then
        echo "profile: $(cat /sys/firmware/acpi/platform_profile)"
    fi
    local rail d
    for rail in "${RAILS[@]}"; do
        d=$ATTRS/$rail
        echo "$rail: current=$(cat "$d/current_value")W min=$(cat "$d/min_value")W max=$(cat "$d/max_value")W default=$(cat "$d/default_value")W"
    done
    if [ -f "$HELPER_PATH" ]; then
        echo "desired: $(sed -n 's/^# desired //p' "$HELPER_PATH")"
    fi
    if systemctl is-enabled --quiet $UNIT_NAME 2>/dev/null; then
        echo "unit: $UNIT_NAME enabled"
    else
        echo "unit: not installed"
    fi
    if [ -f "$RULE_PATH" ]; then
        echo "udev: $(basename "$RULE_PATH") installed"
    else
        echo "udev: not installed"
    fi
}

validate() { # rail watts
    local d=$ATTRS/$1 min max
    min=$(cat "$d/min_value"); max=$(cat "$d/max_value")
    echo "$2" | grep -Eq '^[0-9]+$' || { echo "error: $1 value '$2' is not a number" >&2; exit 1; }
    [ "$2" -ge "$min" ] && [ "$2" -le "$max" ] || { echo "error: $1 must be in [$min, $max], got $2" >&2; exit 1; }
}

# The driver rejects out-of-range writes without failing the shell redirect, so
# never trust a write — read it back.
write_rail() { # rail watts
    echo "$2" | sudo tee "$ATTRS/$1/current_value" >/dev/null
    local applied
    applied=$(cat "$ATTRS/$1/current_value")
    [ "$applied" = "$2" ] || { echo "error: EC left $1 at ${applied}W, asked for ${2}W" >&2; exit 1; }
}

install_helper() { # spl sppt
    sudo mkdir -p "$(dirname "$HELPER_PATH")"
    sudo tee "$HELPER_PATH" >/dev/null <<EOF
#!/bin/sh
# Generated by asus-power-cap. Edits are lost; re-run the script instead.
# desired spl=${1}W sppt=${2}W
set -eu
ATTRS=$ATTRS

# Clamp to the range the current power source allows: on battery the ceiling is
# 40W on both rails, and an unclamped write would be rejected outright.
clamp_write() {
    max=\$(cat "\$ATTRS/\$1/max_value")
    want=\$2
    [ "\$want" -le "\$max" ] || want=\$max
    echo "\$want" > "\$ATTRS/\$1/current_value"
    got=\$(cat "\$ATTRS/\$1/current_value")
    [ "\$got" = "\$want" ] || echo "asus-power-cap: \$1 left at \${got}W, wanted \${want}W" >&2
}

clamp_write ppt_pl1_spl $1
clamp_write ppt_pl2_sppt $2
EOF
    sudo chmod 755 "$HELPER_PATH"
}

install_unit() { # spl sppt
    sudo tee "$UNIT_PATH" >/dev/null <<EOF
[Unit]
Description=Cap ASUS EC CPU power limits (spl=${1}W sppt=${2}W)
After=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=$HELPER_PATH

[Install]
WantedBy=multi-user.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
EOF
    sudo systemctl daemon-reload
    sudo systemctl enable --quiet $UNIT_NAME
}

install_rule() {
    # Match Mains only: BAT0 emits change events on every capacity tick, which
    # would re-trigger the unit constantly.
    sudo tee "$RULE_PATH" >/dev/null <<EOF
ACTION=="change", SUBSYSTEM=="power_supply", ENV{POWER_SUPPLY_TYPE}=="Mains", TAG+="systemd", ENV{SYSTEMD_WANTS}="$UNIT_NAME"
ACTION=="change", SUBSYSTEM=="platform-profile", TAG+="systemd", ENV{SYSTEMD_WANTS}="$UNIT_NAME"
EOF
    sudo udevadm control --reload
}

uninstall() {
    if [ -f "$UNIT_PATH" ]; then
        sudo systemctl disable --quiet $UNIT_NAME
        sudo rm "$UNIT_PATH"
        sudo systemctl daemon-reload
    fi
    if [ -f "$RULE_PATH" ]; then
        sudo rm "$RULE_PATH"
        sudo udevadm control --reload
    fi
    [ -f "$HELPER_PATH" ] && sudo rm "$HELPER_PATH"
    return 0
}

case "${1:-}" in
    status)
        show
        ;;
    reset)
        require_ac
        for rail in "${RAILS[@]}"; do
            write_rail "$rail" "$(cat "$ATTRS/$rail/default_value")"
        done
        uninstall
        echo "restored firmware defaults, removed unit, udev rule and helper"
        show
        ;;
    ''|-h|--help)
        awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"
        ;;
    *)
        require_ac
        spl=$1
        sppt=${2:-$(cat "$ATTRS/ppt_pl2_sppt/current_value")}
        validate ppt_pl1_spl "$spl"
        validate ppt_pl2_sppt "$sppt"
        [ "$spl" -le "$sppt" ] || { echo "error: spl ($spl) must be <= sppt ($sppt)" >&2; exit 1; }

        write_rail ppt_pl1_spl "$spl"
        write_rail ppt_pl2_sppt "$sppt"

        install_helper "$spl" "$sppt"
        install_unit "$spl" "$sppt"
        install_rule
        echo "applied caps, installed $UNIT_NAME, udev rule and helper"
        show
        ;;
esac
