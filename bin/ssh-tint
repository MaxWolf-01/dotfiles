#!/usr/bin/env bash
# ssh with the terminal background tinted for the host it reaches, so a shell
# on another machine never looks like the one you are sitting at.
#
# The tints are in ~/.config/ssh-tint/hosts, one `<HostName> <colour>` line per
# host and a `*` line for every other host, written by nix/home/common.nix next
# to the ssh host blocks. A host is matched on the HostName ssh resolves it to
# (`ssh -G`), so `ssh pc`, `ssh max@pc` and pc's bare address get the same tint.
#
# The background is set with OSC 11 and reset with OSC 111 when ssh exits;
# inside tmux both apply to the one pane. On a host that was itself reached
# over ssh, the reset goes back to that host's tint instead, so leaving the
# second hop of laptop -> pc -> jarvis shows pc's tint again.
#
# When stdout is not a terminal (a pipe, a script) nothing is tinted and this
# is plain ssh.
#
# Usage:
#   ssh-tint [ssh args...]    zsh/functions makes interactive `ssh` this

set -uo pipefail

hosts=${SSH_TINT_HOSTS:-${XDG_CONFIG_HOME:-$HOME/.config}/ssh-tint/hosts}

tint_for() { # <hostname> -> its colour, the `*` colour, or nothing
    [ -r "$hosts" ] || return 0
    awk -v h="$1" '$1 == h { print $2; found = 1; exit }
                   $1 == "*" { fallback = $2 }
                   END { if (!found && fallback) print fallback }' "$hosts"
}

[ -t 1 ] || exec ssh "$@"

target=$(ssh -G "$@" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }')
tint=$([ -n "$target" ] && tint_for "$target")
[ -n "$tint" ] || exec ssh "$@"

restore() {
    local back=
    # SSH_CONNECTION is "<client ip> <client port> <server ip> <server port>":
    # the server ip is the address this host was reached on.
    [ -n "${SSH_CONNECTION:-}" ] && back=$(tint_for "$(awk '{ print $3 }' <<< "$SSH_CONNECTION")")
    if [ -n "$back" ]; then printf '\e]11;%s\e\\' "$back"; else printf '\e]111\e\\'; fi
}

printf '\e]11;%s\e\\' "$tint"
trap restore EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
ssh "$@"
