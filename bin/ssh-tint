#!/usr/bin/env bash
# Tint the terminal background for the host an ssh command reaches, so a shell
# on another machine never looks like the one you are sitting at. zsh/functions
# wraps interactive `ssh` in `ssh-tint on` and `ssh-tint off`.
#
# The tints are in ~/.config/ssh-tint/hosts, one `<HostName> <colour>` line per
# host and a `*` line for every other host, written by nix/home/common.nix next
# to the ssh host blocks. A host is matched on the HostName ssh resolves it to
# (`ssh -G`), so `ssh pc`, `ssh max@pc` and pc's bare address get the same tint.
#
# `on` sets the background with OSC 11 and `off` resets it with OSC 111; inside
# tmux both apply to the one pane. On a host that was itself reached over ssh,
# `off` goes back to that host's tint instead, so leaving the second hop of
# laptop -> pc -> jarvis shows pc's tint again.
#
# When stdout is not a terminal (a pipe, a script) both do nothing.
#
# Usage:
#   ssh-tint on <ssh args...>    tint for the host these ssh arguments reach
#   ssh-tint off                 back to the background before `on`

set -uo pipefail

hosts=${SSH_TINT_HOSTS:-${XDG_CONFIG_HOME:-$HOME/.config}/ssh-tint/hosts}

tint_for() { # <hostname> -> its colour, the `*` colour, or nothing
    [ -r "$hosts" ] || return 0
    awk -v h="$1" '$1 == h { print $2; found = 1; exit }
                   $1 == "*" { fallback = $2 }
                   END { if (!found && fallback) print fallback }' "$hosts"
}

on() {
    local target tint
    target=$(ssh -G "$@" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }')
    [ -n "$target" ] || return 0
    tint=$(tint_for "$target")
    [ -n "$tint" ] && printf '\e]11;%s\e\\' "$tint"
}

off() {
    local back=
    # SSH_CONNECTION is "<client ip> <client port> <server ip> <server port>":
    # the server ip is the address this host was reached on.
    [ -n "${SSH_CONNECTION:-}" ] && back=$(tint_for "$(awk '{ print $3 }' <<< "$SSH_CONNECTION")")
    if [ -n "$back" ]; then printf '\e]11;%s\e\\' "$back"; else printf '\e]111\e\\'; fi
}

case ${1:-} in
    on) shift; [ -t 1 ] && on "$@" ;;
    off) [ -t 1 ] && off ;;
    *) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0" >&2; exit 2 ;;
esac
exit 0
