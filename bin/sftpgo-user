#!/usr/bin/env bash
# Manage SFTPGo accounts on pc via the REST API.
#
# The API lives on the tailnet-only admin binding, so this needs tailnet access.
# Auth: sops-encrypted admin API key in ~/.dotfiles/secrets/api_keys/sftpgo.
#   Mint at http://pc.tail710178.ts.net:8081/web/admin/profile -> API keys
#   (scope: admin).
#   Override with SFTPGO_API_KEY, and the host with SFTPGO_URL.
#
# Usage:
#   sftpgo-user list                    # username, status, quota used/limit
#   sftpgo-user show <name>             # full account JSON
#   sftpgo-user add <name> [opts]       # create, print the generated password
#   sftpgo-user passwd <name> [--admin] # new password, printed once
#   sftpgo-user delete <name>           # really delete — see the note below
#   sftpgo-user dump                    # provider dump (accounts, shares, rules)
#
# add options:
#   --quota GB      storage limit, default 10
#   --sftp          also allow SFTP/SSH (default: web only)
#   --no-shares     forbid creating public share links
#
# Admins and users are separate namespaces, so the same name can exist as both
# with different passwords: `passwd <name>` and `passwd <name> --admin` reset
# different accounts. A reset needs no old password — the API key is enough.
#
# Deleting is the only complete revocation: a disabled account (status 0) blocks
# the owner's own login, but every public share link they created keeps working.
# It leaves the account's files on pc, and nothing expires them — delete prints
# the path.
set -euo pipefail

KEY_FILE="$HOME/.dotfiles/secrets/api_keys/sftpgo"

# The admin binding, addressed by its MagicDNS name. Not the bare `pc`: a router
# that answers for that name hands back pc's LAN address, and the admin port is
# firewalled off every interface but tailscale0, so requests to it hang until
# they time out. The bare name is still the right fallback — on pc itself it
# resolves to pc, where the port is open locally.
admin_host() {
  local suffix
  suffix=$(tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // ""')
  [ -n "$suffix" ] && echo "pc.$suffix" || echo "pc"
}
API="${SFTPGO_URL:-http://$(admin_host):8081}/api/v2"

api() {
  local key="${SFTPGO_API_KEY:-$(sops -d "$KEY_FILE")}"
  # Via --config, not -H: an argument would put the key in /proc/<pid>/cmdline,
  # which is world-readable on pc. The key is admin-scoped and bypasses TOTP.
  printf 'header = "X-SFTPGO-API-KEY: %s"\n' "$key" \
    | curl -sS --fail-with-body --config - "$@"
}

gen_password() {
  # head closes the pipe at 24 bytes, which SIGPIPEs tr reading an endless
  # /dev/urandom; pipefail would turn that into a script abort. Contained in a
  # subshell so the rest of the script keeps pipefail.
  ( set +o pipefail; LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24 )
}

gen_suffix() {
  ( set +o pipefail; LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 8 )
}

# Don't hardcode the tailnet name. MagicDNSSuffix reads the same from any node,
# unlike Self.DNSName, which would name whichever machine runs this.
public_url() {
  local suffix
  suffix=$(tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // ""')
  [ -n "$suffix" ] && echo "https://pc.$suffix/" || echo "(run 'tailscale funnel status' on pc)"
}

cmd="${1:-}"
case "$cmd" in
  list)
    api "$API/users?limit=500" \
      | jq -r '.[] | [.username, (if .status == 1 then "enabled" else "DISABLED" end),
                      "\(((.used_quota_size // 0) / 1073741824) | . * 100 | round / 100)G",
                      (if .quota_size > 0 then "\(.quota_size / 1073741824)G" else "unlimited" end)] | @tsv'
    ;;

  show)
    name="${2:?usage: sftpgo-user show <name>}"
    api "$API/users/$name" | jq .
    ;;

  add)
    name="${2:?usage: sftpgo-user add <name> [--quota GB] [--sftp] [--no-shares]}"
    shift 2
    quota_gb=10
    denied_protocols='["SSH","FTP","DAV"]'
    web_client='[]'
    while [ $# -gt 0 ]; do
      case "$1" in
        --quota)     quota_gb="${2:?--quota needs a value in GB}"; shift 2 ;;
        --sftp)      denied_protocols='["FTP","DAV"]'; shift ;;
        --no-shares) web_client='["shares-disabled"]'; shift ;;
        *) echo "sftpgo-user: unknown option $1" >&2; exit 1 ;;
      esac
    done

    password=$(gen_password)
    # An explicit, unguessable home rather than the users_base_dir default of
    # /srv/sftpgo/<name>. Deleting an account leaves its files behind, so with
    # the derived path a re-used username would inherit the previous holder's
    # files. The suffix makes every account a fresh directory.
    home_dir="/srv/sftpgo/$name-$(gen_suffix)"
    body=$(jq -n \
      --arg username "$name" \
      --arg password "$password" \
      --arg home "$home_dir" \
      --argjson quota "$((quota_gb * 1073741824))" \
      --argjson denied "$denied_protocols" \
      --argjson web "$web_client" \
      '{status: 1, username: $username, password: $password, home_dir: $home,
        quota_size: $quota,
        permissions: {"/": ["*"]},
        filters: {denied_protocols: $denied, web_client: $web}}')
    api -X POST -H "Content-Type: application/json" --data "$body" "$API/users" >/dev/null

    echo "created $name (${quota_gb}G quota)"
    echo "  url:      $(public_url)"
    echo "  username: $name"
    echo "  password: $password"
    echo "  files:    $home_dir"
    ;;

  passwd)
    name="${2:?usage: sftpgo-user passwd <name> [--admin]}"
    collection=users label=user
    case "${3:-}" in
      --admin) collection=admins label=admin ;;
      "") ;;
      *) echo "sftpgo-user: unknown option $3" >&2; exit 1 ;;
    esac

    password=$(gen_password)
    # PUT replaces the whole record, so send back what GET returned with the new
    # password merged in; a body carrying the password alone would reset home,
    # quota and permissions to their defaults. TOTP survives the round trip:
    # GET returns the secret and the recovery codes still encrypted, and SFTPGo
    # stores an already-encrypted secret unchanged.
    body=$(api "$API/$collection/$name" | jq --arg p "$password" '. + {password: $p}')
    api -X PUT -H "Content-Type: application/json" --data "$body" "$API/$collection/$name" >/dev/null

    echo "reset $label $name"
    echo "  password: $password"
    ;;

  delete)
    name="${2:?usage: sftpgo-user delete <name>}"
    # Read the home before the account goes: nothing else records it afterwards,
    # and retention only visits accounts that exist, so these files never expire.
    home_dir=$(api "$API/users/$name" | jq -r '.home_dir')
    api -X DELETE "$API/users/$name" >/dev/null
    echo "deleted $name — their share links stop working too"
    echo "  files left on pc: $home_dir"
    echo "  nothing expires them; remove with: ssh pc sudo rm -rf $home_dir"
    ;;

  dump)
    api "$API/dumpdata?output-data=1&indent=1"
    ;;

  *)
    # The header comment is the usage text; print it through to the first line
    # of code so editing one cannot silently truncate the other.
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
    exit 1
    ;;
esac
