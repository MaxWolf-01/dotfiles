#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro"]
# ///
"""CPU time per unit over the last N hours, largest first, with what no unit accounts for.

Two sources, merged: systemd's record of a unit's total CPU time when it stops
(the journal's "Consumed ... CPU time" lines, user and system), and
thermal-log's hourly counters for units still running (YYYY-MM-DD.counters.csv).
A unit is its name and the systemd manager that owns it: the system bus and the
session bus are both dbus.service, and a name both managers use is listed with
the manager beside it.
A unit that restarts, or a reboot, starts a new lifetime; each lifetime counts
only its CPU inside the window. Units that were already running when the
counters began count only from then. A unit known only from its stop record
(one thermal-log never scanned) whose life began before the window counts the
window's share of its CPU, by its wall-clock time, as if spent evenly. The last partial hour of a unit still
running is not counted until the next hourly counter.

systemd writes a stop record only for a run above 1 s of CPU, 64 MB of memory,
1 MB of disk I/O or any network traffic. A unit that stops, and whose runs all
stay below those, has no record and is not listed: a frequent cheap timer
counts only in the unattributed CPU. So does whatever ran in kernel threads
or in cgroups thermal-log does not scan. The last line gives it, from the root
cgroup's counter, once the counters span the whole window (total_cpu_s is
null until then).

JSON schema (--json):

    {"window_h": float, "total_cpu_s": float | null,
     "units": [{"unit": "str", "cpu_s": float, "core_pct": float, "lifetimes": int}]}

Examples:

    thermal-log-report
    thermal-log-report --hours 72 --top 40
    thermal-log-report --no-group --json | jq '.units[] | select(.cpu_s > 60)'
"""

import csv
import json
import re
import subprocess
import sys
import time
from collections import defaultdict
from dataclasses import asdict, dataclass, field
from datetime import date, timedelta
from pathlib import Path

import tyro


@dataclass
class Args:
    hours: float = 24
    """Window length, ending now."""
    top: int = 25
    """Units to print, largest first. 0 prints all."""
    group: bool = True
    """Sum instances of one kind into a single line: tmux-spawn-*.scope, docker-*.scope, app-*-*.scope,
    run-*.service."""
    json: bool = False
    """Emit JSON to stdout instead of a table."""
    logdir: Path = Path.home() / ".local/state/thermal-log"
    """Directory holding thermal-log's YYYY-MM-DD.counters.csv files."""


@dataclass
class UnitCpu:
    unit: str
    cpu_s: float
    core_pct: float
    lifetimes: int


@dataclass
class Lifetime:
    samples: list[tuple[float, int]] = field(default_factory=list)  # (epoch s, usage usec)
    stop: tuple[float, int, float] | None = None  # (epoch s, lifetime usage usec, wall-clock s) from the journal


INSTANCE_PATTERNS = [
    (re.compile(r"^tmux-spawn-[0-9a-f-]{36}\.scope$"), "tmux-spawn-*.scope"),
    (re.compile(r"^docker-[0-9a-f]{64}\.scope$"), "docker-*.scope"),
    (re.compile(r"^run-[0-9a-z]+\.(service|scope)$"), r"run-*.\1"),
    (re.compile(r"^(.*)-\d+\.scope$"), r"\1-*.scope"),
]

DURATION = re.compile(r"([\d.]+)(d|h|min|ms|us|s)")
DURATION_S = {"d": 86400, "h": 3600, "min": 60, "s": 1, "ms": 1e-3, "us": 1e-6}
STOP_LINE = re.compile(r"^(\S+): Consumed (.+?) CPU time")
WALL_CLOCK = re.compile(r"over (.+?) wall clock time")


def group_name(unit: str) -> str:
    for pattern, replacement in INSTANCE_PATTERNS:
        if pattern.match(unit):
            return pattern.sub(replacement, unit)
    return unit


Unit = tuple[str, str]  # (manager, unit name)


def read_counters(logdir: Path, since: float) -> tuple[dict[Unit, list[tuple[float, int]]], float | None]:
    """Every unit's hourly counter samples, from the day before `since` on, and the earliest sample time."""
    series: dict[Unit, list[tuple[float, int]]] = defaultdict(list)
    first_day = date.fromtimestamp(since) - timedelta(days=1)
    for path in sorted(logdir.glob("*.counters.csv")):
        try:
            if date.fromisoformat(path.name[:10]) < first_day:
                continue
        except ValueError:
            continue
        with path.open() as f:
            for row in csv.DictReader(f):
                t = time.mktime(time.strptime(row["time"], "%Y-%m-%d %H:%M:%S"))
                series[(row["manager"], row["unit"])].append((t, int(row["usage_usec"])))
    earliest = min((s[0][0] for s in series.values() if s), default=None)
    return series, earliest


def seconds(duration: str) -> float:
    return sum(float(v) * DURATION_S[u] for v, u in DURATION.findall(duration))


def read_stops(since: float) -> dict[Unit, list[tuple[float, int, float]]]:
    """Every unit stop the journal recorded since `since`: (epoch s, lifetime usage usec, wall-clock s)."""
    stops: dict[Unit, list[tuple[float, int, float]]] = defaultdict(list)
    for manager, scope in (("user", "--user"), ("system", "--system")):
        result = subprocess.run(
            ["journalctl", scope, "-o", "json", "--output-fields=MESSAGE", "--since", f"@{int(since)}",
             "--grep", "Consumed .* CPU time"],
            capture_output=True, text=True,
        )
        if result.returncode not in (0, 1):  # 1: no matching entries
            print(f"thermal-log-report: journalctl {scope} failed: {result.stderr.strip()}", file=sys.stderr)
        for line in result.stdout.splitlines():
            entry = json.loads(line)
            message = entry.get("MESSAGE")
            match = STOP_LINE.match(message) if isinstance(message, str) else None
            if not match:
                continue
            wall = WALL_CLOCK.search(message)
            stops[(manager, match.group(1))].append((int(entry["__REALTIME_TIMESTAMP"]) / 1e6,
                                          round(seconds(match.group(2)) * 1e6),
                                          seconds(wall.group(1)) if wall else 0.0))
    return stops


def lifetimes(samples: list[tuple[float, int]], stops: list[tuple[float, int, float]]) -> list[Lifetime]:
    """A unit's samples and stops in time order: a stop ends the current lifetime, and a sample after a stop,
    or one whose counter dropped (restart, reboot), begins a new one. A stop with no lifetime open is a unit
    that lived and ended between two samples."""
    runs: list[Lifetime] = []
    events = sorted([(t, 0, u, 0.0) for t, u in samples] + [(t, 1, u, wall) for t, u, wall in stops])
    for t, is_stop, usage, wall in events:
        current = runs[-1] if runs and runs[-1].stop is None else None
        if is_stop:
            if current:
                current.stop = (t, usage, wall)
            else:
                runs.append(Lifetime(stop=(t, usage, wall)))
        else:
            if current is None or usage < current.samples[-1][1]:
                current = Lifetime()
                runs.append(current)
            current.samples.append((t, usage))
    return runs


def usage_in_window(run: Lifetime, t0: float, t1: float, earliest: float | None) -> int:
    end_t, end = run.stop[:2] if run.stop else run.samples[-1]
    if end_t < t0:
        return 0
    if run.stop and not run.samples:
        # Known only from its stop record, a unit thermal-log never scanned: its wall-clock time says when it
        # started, and of a life begun before the window only the share inside counts, as if spent evenly.
        wall = run.stop[2]
        return round(end * (end_t - t0) / wall) if wall and end_t - wall < t0 else end
    before = [u for t, u in run.samples if t <= t0]
    if before:
        start = before[-1]
    elif run.samples and run.samples[0][0] == earliest:
        start = run.samples[0][1]  # already running when the counters began: its past is unknown
    else:
        start = 0  # born inside the window
    if not run.stop:
        inside = [u for t, u in run.samples if t <= t1]
        end = inside[-1] if inside else start
    return max(0, end - start)


def main(args: Args) -> None:
    t1 = time.time()
    t0 = t1 - args.hours * 3600
    counters, earliest = read_counters(args.logdir, t0)
    stops = read_stops(t0)

    per_unit: dict[Unit, int] = defaultdict(int)
    count: dict[Unit, int] = defaultdict(int)
    for manager, unit in set(counters) | set(stops):
        if unit == "(root)":
            continue
        key = (manager, group_name(unit) if args.group else unit)
        for run in lifetimes(counters.get((manager, unit), []), stops.get((manager, unit), [])):
            used = usage_in_window(run, t0, t1, earliest)
            if used:
                per_unit[key] += used
                count[key] += 1
    managers_of: dict[str, set[str]] = defaultdict(set)
    for manager, name in per_unit:
        managers_of[name].add(manager)

    def shown_name(key: Unit) -> str:
        manager, name = key
        return f"{name} ({manager})" if len(managers_of[name]) > 1 else name

    # The root counter only means something against the units once it spans the whole window: stop
    # records reach back to the window's start whether or not the counters do.
    root = counters.get(("system", "(root)"), [])
    spans = bool(root) and earliest is not None and earliest <= t0
    total = sum(usage_in_window(r, t0, t1, earliest) for r in lifetimes(root, [])) if spans else None

    window_s = t1 - t0
    rows = sorted(per_unit.items(), key=lambda kv: kv[1], reverse=True)
    units = [UnitCpu(shown_name(u), round(us / 1e6, 1), round(us / 1e6 / window_s * 100, 3), count[u])
             for u, us in rows]
    total_s = round(total / 1e6, 1) if total is not None else None

    if args.json:
        print(json.dumps({"window_h": args.hours, "total_cpu_s": total_s, "units": [asdict(u) for u in units]}))
        return
    shown = units[: args.top] if args.top else units
    print(f"{'cpu_min':>9} {'core_%':>7} {'lives':>6}  unit")
    for u in shown:
        print(f"{u.cpu_s / 60:9.1f} {u.core_pct:7.2f} {u.lifetimes:6d}  {u.unit}")
    listed = sum(u.cpu_s for u in units)
    hidden = len(units) - len(shown)
    tail = f", {hidden} smaller units not shown" if hidden else ""
    if total_s is not None:
        system = f" of {total_s / 60:.1f} system-wide, {(total_s - listed) / 60:.1f} unattributed"
    elif earliest is not None:
        started_h = (t1 - earliest) / 3600
        system = f"; no system-wide total until the counters span the window (they start {started_h:.0f} h ago)"
    else:
        system = "; no counters yet, so no system-wide total"
    print(f"\n{listed / 60:.1f} CPU-min across {len(units)} units over {args.hours:g} h{system}{tail}")


if __name__ == "__main__":
    main(tyro.cli(Args, description=__doc__, config=(tyro.conf.OmitArgPrefixes,)))
