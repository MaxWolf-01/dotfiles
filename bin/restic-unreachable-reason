#!/usr/bin/env bash
# Was this failure the target being unreachable, or something worse?
#
# Usage: restic-unreachable-reason [--repo REPO] [FILE]   (reads stdin when FILE is absent)
#
# Prints the line that says the target could not be reached and exits 0; exits 1
# when nothing matches. Callers use the answer to tell an outage, which ends by
# itself, from a failure that needs a person.
#
# With --repo, an sftp repository whose log names no cause is asked again: the
# ssh command restic runs for it is run once more, and ssh's own words are read
# instead. See probe_sftp for why the log alone is not enough.

set -uo pipefail

# Restic 0.19.1's own words for "the target could not be reached at all". Over
# sftp the cause is only in the line restic passes through from its ssh
# subprocess; restic's own message is the same generic "unable to start the sftp
# session ... unexpected EOF" whatever went wrong underneath. The last pattern
# is what ssh says when ServerAliveInterval tears down a link that stopped
# answering. Deliberately narrow — a rejected key, a changed host key, or a
# server that hung up on us is a person's problem and stays a failure.
patterns='could not resolve hostname|name or service not known|temporary failure in name resolution|no such host|connection refused|connection timed out|i/o timeout|no route to host|network is unreachable|timeout, server .* not responding'

repo=""
if [ "${1:-}" = --repo ]; then
    repo="${2:?--repo needs a repository}"
    shift 2
fi

# The last matching line, not the first: a hiccup restic retried past must not
# outvote the error it finally stopped on.
reason() {
    local line
    line=$(grep -Ei "$patterns" | tail -1)
    [ -n "$line" ] || return 1
    printf '%s\n' "${line#subprocess ssh: }"
}

# restic 0.19.1 copies ssh's stderr to its own from a goroutine it never waits
# for, so on a loaded host it can exit before ssh's line gets through, leaving
# only its generic message. ssh itself has written its reason before it exits,
# so running the same command (buildSSHCommand in restic's sftp backend:
# `ssh HOST [-p PORT] [-l USER] -s sftp`, through the same ssh config) and
# waiting for it cannot lose the line. A target that came back in between reads
# as a failure.
probe_sftp() {  # $1 repository
    local rest host port="" user="" authority
    case $1 in
        sftp://*)
            rest=${1#sftp://}
            authority=${rest%%/*}
            if [[ $authority == *@* ]]; then
                user=${authority%@*}
                authority=${authority##*@}
            fi
            if [[ $authority =~ ^\[(.*)\](:([0-9]+))?$ ]]; then
                host=${BASH_REMATCH[1]} port=${BASH_REMATCH[3]}
            elif [[ $authority == *:* ]]; then
                host=${authority%:*} port=${authority##*:}
            else
                host=$authority
            fi
            ;;
        sftp:*)
            rest=${1#sftp:}
            host=${rest%%:*}
            if [[ $host == *@* ]]; then
                user=${host%@*}
                host=${host##*@}
            fi
            ;;
        *) return 1 ;;
    esac
    [ -n "$host" ] || return 1

    local args=("$host")
    [ -n "$port" ] && args+=(-p "$port")
    [ -n "$user" ] && args+=(-l "$user")
    # stdout is the sftp stream, which nobody reads; stderr is the answer.
    timeout 30 ssh -o BatchMode=yes -o ConnectTimeout=10 "${args[@]}" -s sftp \
        2>&1 >/dev/null </dev/null
}

reason <"${1:-/dev/stdin}" && exit 0
[ -n "$repo" ] || exit 1
answer=$(probe_sftp "$repo") || true
reason <<<"$answer"
