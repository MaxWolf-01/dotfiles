#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""max's Claude accounts: which one each profile's next session runs on, switching the personal profile to another,
their quota, and their tokens on the worker users. With no subcommand, `clawd` is `clawd status`.

What an account and a profile are: nix/home/claude-accounts.sh, which clawd reaches every account and token
through. Which token `claude` hands each session on each host: the wrapper's header, nix/home/claude-token.sh.

Examples:

    clawd
    clawd use helferline
    clawd quota --json
    clawd push agent@pc
"""

import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.parse
import urllib.request
from dataclasses import dataclass
from datetime import date, datetime, timezone
from pathlib import Path
from typing import Annotated, NoReturn, Union

import tyro
from tyro.conf import Positional, arg, subcommand

REPO = Path(__file__).resolve().parents[1]
CORE = REPO / "nix/home/claude-accounts.sh"

# The cheapest claude round trip, which push tries a new token with: haiku, so it never eats the weekly Opus budget, and no MCP servers, saved session or skills.
CHEAPEST_PING = ["timeout", "120", "claude", "-p", "ping", "--model", "haiku", "--strict-mcp-config", "--mcp-config",
                 '{"mcpServers":{}}', "--no-session-persistence", "--disable-slash-commands"]


# --- the commands


@dataclass(frozen=True)
class Status:
    """One line per profile: the account its next session gets, and whether through its own login or a switch."""

    def run(self) -> None:
        mode = wrapper_mode()
        switched = core("claude_switched_account").stdout.strip()
        for profile in core("claude_profiles").stdout.splitlines():
            account = core('claude_profile_account "$1"', profile).stdout.strip()
            if mode == "switch" and account == "personal" and switched:
                if Path(account_file(switched)).is_file() and minted(switched):
                    says = f"{paint(switched, BOLD)}, {paint('switched', YELLOW)} (`clawd use personal` goes back to " \
                           "its own login)"
                else:
                    says = paint(f"switched to {switched}, which has no token: claude refuses to start", RED) + \
                        " (`clawd use personal` goes back)"
            elif mode == "profile" and minted(account):
                says = f"{paint(account, BOLD)}, on its token"
            else:
                says = f"{paint(account, BOLD)}, its own login"
            print(f"{paint(profile.replace(str(Path.home()), '~', 1) + ':', DIM)} {says}")


@dataclass(frozen=True)
class Use:
    """Put the personal profile's new sessions on ACCOUNT's token; `clawd use personal` brings them back to its
    own login. Only on a host whose claude has the switch (zephylux).

    Only the personal profile is ever switched; ~/.claude-helferline always runs on its own login. Sessions already
    running keep the login they started on, and the scheduled units that run claude (the retros) are
    never switched. pc's wrapper ignores the switch: there every profile always runs on its account's token.
    """

    account: Annotated[Positional[str], arg(metavar="ACCOUNT")]
    """The account, by its name in secrets/creds/env/claude-<account>.env, or personal."""

    def run(self) -> None:
        match wrapper_mode():
            case "switch":
                pass
            case "profile":
                die("this host's claude puts every profile on its own account's token, so there is no switch")
            case "":
                die(f"no claude wrapper here ({Path.home()}/.config/clawd/wrapper-mode is missing; "
                    "nix/home/claude-token.nix installs it)")
            case mode:
                die(f"this host's claude has a mode clawd does not know, '{mode}' "
                    f"({Path.home()}/.config/clawd/wrapper-mode; nix/home/claude-token.nix writes it)")
        switch_file = Path(core('printf "%s\\n" "$claude_switch_file"').stdout.strip())
        if self.account == "personal":
            switch_file.unlink(missing_ok=True)
            print("personal: new sessions on ~/.claude run on its own /login; running sessions keep theirs")
            return
        file = account_file(self.account)
        if not Path(file).is_file():
            die(f"no account '{self.account}': {file} does not exist "
                f"(accounts: {' '.join(core('claude_accounts').stdout.split())})")
        if not minted(self.account):
            die(f"'{self.account}' holds no token yet: mint one with `claude setup-token` and write it with "
                f"`sops {file}`")
        switch_file.parent.mkdir(parents=True, exist_ok=True)
        switch_file.write_text(f"{self.account}\n")
        print(f"{self.account}: new sessions on ~/.claude run on its token; running sessions keep theirs, and "
              "~/.claude-helferline keeps its own login")


@dataclass(frozen=True)
class Quota:
    """Every plan's quota and Console org's spend.

    For every profile that holds a login: how much of its plan's quota is used and when it resets, read from
    Anthropic's OAuth usage endpoint with the profile's current access token, never refreshed: a refresh rotates
    the token Claude Code holds. An expired one is reported, and opening claude in that profile renews it.

    Then each Console org that receives a Max plan's monthly API credits: what it has spent since the day of the
    month the grant arrives, CC_QUOTA_GRANT_DAY (default 10). No public API reads a grant or the balance left, so
    quota shows the spend and leaves the balance to the Console's Billing page. The spend comes from the Admin API's
    cost report, which counts whole days, so it runs through yesterday. An org is a with-secrets entry defining an
    organization-scoped API key. That key's name holds ORGANIZATION and ends in API_KEY, as ORGANIZATION_API_KEY
    and HELFERLINE_DEV_ORGANIZATION__ANTHROPIC_API_KEY do. The entry may set its own CC_QUOTA_GRANT_DAY.
    CC_QUOTA_ORG_KEY, when set, stands in for every entry (with CC_QUOTA_GRANT_DAY from the environment); set
    empty, it leaves the orgs out. A with-secrets that is missing or fails is listed among the orgs with its error,
    so it never reads as no org.

    JSON (--json): the same report as one line, for a history to append it to: at (UTC); profiles, each with name,
    plan and buckets (name, used in %, resets_at, dollars_left, dollars_limit), or with name and error; and
    consoles, each with entry, org, since and spent in dollars, counted through yesterday, or with entry and error.
    """

    as_json: Annotated[bool, arg(name="json")] = False
    """The report as one line of JSON."""

    def run(self) -> None:
        now = int(os.environ.get("CLAWD_QUOTA_NOW") or time.time())
        report = quota(now)
        if self.as_json:
            print(json.dumps(report, separators=(",", ":")))
        else:
            print(quota_text(report, now), end="")


@dataclass(frozen=True)
class Push:
    """Give the worker users their accounts' tokens: each named, or every one `hosts targets --json` names with an
    account.

    On each host: `claude -p` has to answer on the new token before it replaces the one the user held, in the
    file ~/.config/claude-token (mode 600), with the account's name beside it in ~/.config/claude-token-account;
    its shell exports both (nix/home/worker-claude-token.zsh). A token claude refuses is left out, and the run fails.
    Then a fresh shell there has to export that token and account; otherwise the browser login stays, and the run
    fails. Last, `claude auth logout` drops the browser login, unless a claude session that started before the
    token is still running on it: that login stays until the session ends, and the run fails, naming the host to
    push again.

    Run it on zephylux after minting an account's token, which the yearly renewal does, and after a worker's home
    is rebuilt. An account whose token is not minted yet is skipped, its workers left on their login. A host that
    is down is reported and the rest still pushed. The token is never printed.
    """

    targets: Annotated[Positional[tuple[str, ...]], arg(metavar="USER@HOST")] = ()
    """The worker users to push to; every one, when none is named."""

    def run(self) -> None:
        push(self.targets)


COMMANDS = {"status": Status, "use": Use, "quota": Quota, "push": Push}


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] not in (*COMMANDS, "-h", "--help"):
        args = ["status", *args]
    # The list of subcommands gives each one's first paragraph; its own --help, the whole of it.
    listing = args[0] in ("-h", "--help")
    command = Union[tuple(
        Annotated[kind, subcommand(name, prefix_name=False, description=summary(kind) if listing else None)]
        for name, kind in COMMANDS.items())]
    tyro.cli(command, args=args, description=__doc__).run()


def summary(kind: type) -> str:
    return " ".join((kind.__doc__ or "").split("\n\n")[0].split())


def die(message: str) -> NoReturn:
    print(f"clawd: {message}", file=sys.stderr)
    sys.exit(2)


# --- the account core


def core(script: str, *args: str) -> subprocess.CompletedProcess:
    """script run in bash with nix/home/claude-accounts.sh sourced and args as $1..., its stdout captured: the one
    way to an account, a profile or a token, so a token is decrypted in one place."""
    return subprocess.run(["bash", "-c", f'claude_accounts_who=clawd; . "$0"; {script}', str(CORE), *args],
                          stdout=subprocess.PIPE, text=True, check=False)


def account_file(account: str) -> str:
    return core('claude_account_file "$1"', account).stdout.strip()


def minted(account: str) -> bool:
    return core('claude_account_minted "$1"', account).returncode == 0


def wrapper_mode() -> str:
    """What `claude` on this host does with the switch: switch where `clawd use` applies, profile where every
    profile runs on its account's token, nothing where no wrapper is installed."""
    try:
        return (Path.home() / ".config/clawd/wrapper-mode").read_text().strip()
    except OSError:
        return ""


# --- quota


def quota(now: int) -> dict:
    api = os.environ.get("CLAWD_QUOTA_API") or "https://api.anthropic.com"
    profiles = []
    for profile in core("claude_profiles").stdout.splitlines():
        creds = Path(profile) / ".credentials.json"
        if not creds.is_file():
            continue
        name = core('claude_profile_account "$1"', profile).stdout.strip()
        oauth = json.loads(creds.read_text()).get("claudeAiOauth") or {}
        if (oauth.get("expiresAt") or 0) < now * 1000:
            profiles.append({"name": name, "error": "token expired; open claude in this profile to renew it"})
            continue
        try:
            usage = get(f"{api}/api/oauth/usage", {"Authorization": f"Bearer {oauth.get('accessToken')}",
                                                  "anthropic-beta": "oauth-2025-04-20"})
        except (OSError, ValueError):
            profiles.append({"name": name, "error": "the usage endpoint refused the request"})
            continue
        # Every bucket the reply fills in, so one Anthropic adds later shows up under its own name.
        profiles.append({"name": name, "plan": oauth.get("subscriptionType") or "?", "buckets": [
            {"name": key, "used": half_up(bucket["utilization"]), "resets_at": minute(bucket["resets_at"]),
             "dollars_left": bucket.get("remaining_dollars"), "dollars_limit": bucket.get("limit_dollars")}
            for key, bucket in usage.items()
            if isinstance(bucket, dict) and bucket.get("utilization") is not None
            and bucket.get("resets_at") is not None]})

    consoles = []
    if "CC_QUOTA_ORG_KEY" in os.environ:
        if key := os.environ["CC_QUOTA_ORG_KEY"]:
            consoles.append(console(api, now, "key", key, int(os.environ.get("CC_QUOTA_GRANT_DAY") or 10)))
    else:
        consoles = org_consoles(api, now)
    at = datetime.fromtimestamp(now, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return {"at": at, "profiles": profiles, "consoles": consoles}


def get(url: str, headers: dict[str, str]):
    with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=30) as reply:
        return json.load(reply)


def half_up(x: float) -> int:
    return math.floor(x + 0.5)


def minute(at: str) -> str:
    """A reset time rounded to the minute, in UTC: reset times jitter around it (04:59:59.85, then 05:00:00.24)."""
    seconds = int(datetime.fromisoformat(re.sub(r"\.[0-9]+", "", at).replace("Z", "+00:00")).timestamp()) + 30
    return datetime.fromtimestamp(seconds - seconds % 60, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def org_consoles(api: str, now: int) -> list[dict]:
    """Every with-secrets entry holding an organization key, as its console's report. A with-secrets that is missing
    or fails is a report of its own, naming the error, so it never reads as having no org."""
    def org_key(var: str) -> bool:
        return re.fullmatch(r".*ORGANIZATION.*API_KEY", var) is not None

    try:
        listed = with_secrets("--list")
    except SecretsFailed as e:
        return [{"entry": "with-secrets", "error": str(e)}]
    consoles = []
    for line in listed.splitlines():
        entry, *names = line.split()
        if not any(org_key(n) for n in names):
            continue
        try:
            env = dict(v.partition("=")[::2] for v in with_secrets(entry, "env").splitlines() if "=" in v)
        except SecretsFailed as e:
            consoles.append({"entry": entry, "error": str(e)})
            continue
        if key := next((value for var, value in env.items() if org_key(var)), ""):
            consoles.append(console(api, now, entry, key, int(env.get("CC_QUOTA_GRANT_DAY") or 10)))
    return consoles


class SecretsFailed(Exception):
    """with-secrets could not answer; the message says why."""


def with_secrets(*args: str) -> str:
    try:
        done = subprocess.run(["with-secrets", *args], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              check=False)
    except OSError as e:
        raise SecretsFailed(f"could not run with-secrets: {e.strerror}") from None
    if done.returncode:
        said = done.stderr.strip().splitlines()[-1:] or ["no message"]
        raise SecretsFailed(f"with-secrets {' '.join(args)} failed (exit {done.returncode}): {said[0]}")
    return done.stdout


def console(api: str, now: int, entry: str, key: str, day: int) -> dict:
    """One Console org's spend since its grant's day."""
    today = datetime.fromtimestamp(now).date()
    year, month = (today.year, today.month) if today.day >= day else \
        (today.year - (today.month == 1), today.month - 1 or 12)
    since = date(year, month, day).isoformat()
    admin = {"x-api-key": key, "anthropic-version": "2023-06-01"}
    try:
        org = get(f"{api}/v1/organizations/me", admin)["name"]
    except (OSError, ValueError, KeyError):
        return {"entry": entry, "error": "the Admin API refused the organization key"}
    cents = 0.0
    # A cycle that starts today has no whole day yet, and the report refuses an empty range.
    page = None
    while since != today.isoformat():
        query = {"starting_at": f"{since}T00:00:00Z", "limit": 31} | ({"page": page} if page else {})
        try:
            report = get(f"{api}/v1/organizations/cost_report?{urllib.parse.urlencode(query)}", admin)
        except (OSError, ValueError):
            return {"entry": entry, "org": org, "error": "the cost report refused the request"}
        cents += sum(float(result["amount"]) for day_ in report["data"] for result in day_["results"])
        page = report.get("next_page") if report.get("has_more") else None
        if not page:
            break
    spent = half_up(cents) / 100
    return {"entry": entry, "org": org, "since": since, "spent": int(spent) if spent.is_integer() else spent}


BOLD, DIM, RED, GREEN, YELLOW = "1", "2", "31", "32", "33"


def paint(text: str, *codes: str) -> str:
    """text in the SGR codes given, where a person reads it: on a terminal, and never with NO_COLOR set."""
    if not codes or not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{';'.join(codes)}m{text}\033[0m"


# A bucket's name as a person says it; one this list lacks keeps the endpoint's name.
LABELS = {"seven_day": "week", "seven_day_opus": "week, opus",
          "seven_day_sonnet": "week, sonnet", "iguana_necktie": "cloud credit"}


def quota_text(report: dict, now: int) -> str:
    """The report as text: a heading per profile or Console org, a row per bucket with a bar of how much is used."""
    out = ""
    for p in report["profiles"]:
        if "error" in p:
            out += f"{paint(p['name'], BOLD)} {paint(p['error'], RED)}\n"
            continue
        out += f"{paint(p['name'], BOLD)} {paint(p['plan'], DIM)}\n"
        for b in p["buckets"]:
            resets = int(datetime.fromisoformat(b["resets_at"].replace("Z", "+00:00")).timestamp())
            if b["dollars_left"] is not None:
                detail = f"${b['dollars_left']:.2f} of ${b['dollars_limit'] or 0:.0f} left" + \
                    paint(f", expires {when(resets, now)}", DIM)
            else:
                detail = paint(f"resets {when(resets, now)}", DIM)
            out += f"  {LABELS.get(b['name'], b['name']):<13} {bar(b['used'])} {str(b['used']) + '%':>4}  {detail}\n"
    for c in report["consoles"]:
        if "error" in c:
            out += f"{paint('console ' + c.get('org', c['entry']), BOLD)} {paint(c['error'], RED)}\n"
            continue
        since = date.fromisoformat(c["since"]).strftime("%a %d %b")
        out += f"{paint('console ' + c['org'], BOLD)} {paint(c['entry'], DIM)}\n"
        out += f"  {'API credits':<13} ${c['spent']:.2f} spent{paint(f' since {since}, through yesterday', DIM)}\n"
    return out


def bar(used: int) -> str:
    """20 cells, coloured by how close the bucket is to its limit."""
    full = min(used, 100) // 5
    colour = GREEN if used < 70 else YELLOW if used < 90 else RED
    return paint("█" * full, colour) + paint("░" * (20 - full), DIM)


def when(at: int, now: int) -> str:
    """When an instant is: its weekday and time within the week, its date beyond, and how far off it is."""
    left = at - now
    far = datetime.fromtimestamp(at).strftime("%a %H:%M" if left < 6 * 86400 else "%a %d %b")
    if left < 3600:
        return f"{far}, in {left // 60}m"
    if left < 86400:
        return f"{far}, in {left // 3600}h {left % 3600 // 60}m"
    return f"{far}, in {left // 86400}d {left % 86400 // 3600}h"


# --- push

SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=accept-new"]

# Writes stdin, the token, in place of the old one in one rename, once claude answers on it ($ping, the cheapest
# round trip), and $account beside it. Prints why when it does not.
INSTALL_TOKEN = """
umask 077 && mkdir -p ~/.config && cat >~/.config/claude-token.new || exit 1
if ! out=$(CLAUDE_CODE_OAUTH_TOKEN="$(cat ~/.config/claude-token.new)" "${ping[@]}" 2>&1); then
  rm -f ~/.config/claude-token.new
  echo "claude -p fails on the new token, so it keeps the token and login it had: $out"
  exit 1
fi
mv ~/.config/claude-token.new ~/.config/claude-token
echo "$account" >~/.config/claude-token-account
"""

# Runs in the worker's own shell, which has read .zshenv: its environment is what every claude there starts with.
# Prints one line saying how it ended.
CHECK_AND_LOGOUT = """
if [ "${CLAUDE_CODE_OAUTH_TOKEN-}" != "$(cat ~/.config/claude-token)" ] || [ "${CLAUDE_ACCOUNT-}" != "$account" ]; then
  echo "token written, but its shell does not export it and its account, so the browser login stays: is nix/home/worker-claude-token.zsh switched in on this host (nswitch)?"
  exit 1
fi
on_login=0
for pid in $(pgrep -u "$(id -u)" -x claude); do
  tr '\\0' '\\n' </proc/$pid/environ 2>/dev/null | grep -q '^CLAUDE_CODE_OAUTH_TOKEN=' || on_login=$((on_login + 1))
done
if [ "$on_login" -gt 0 ]; then
  echo "on the token, but $on_login claude session(s) still run on the browser login, which stays until they end: push to this host again then"
  exit 1
fi
creds=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json
if [ -e "$creds" ]; then
  # Unset, so that logout sees only the browser login and never the account's token.
  env -u CLAUDE_CODE_OAUTH_TOKEN claude auth logout >/dev/null 2>&1
  rm -f "$creds"
  echo "on the token; browser login logged out"
else
  echo "on the token"
fi
"""


def push(named: tuple[str, ...]) -> None:
    for target in named:
        if target.startswith("-"):
            die(f"push takes no {target}; clawd --help says what it takes")
    listed = subprocess.run([str(REPO / "bin/hosts"), "targets", "--json"], stdout=subprocess.PIPE, text=True,
                            check=False)
    if listed.returncode:
        die("`hosts targets --json` failed, so no worker user is known; see above")
    # Every worker user whose entry names an account: user@host and that account.
    workers = {w["target"]: w["account"] for w in json.loads(listed.stdout) if w.get("account")}
    for target in named:
        if target not in workers:
            die(f"no worker user with an account: {target} (have: {' '.join(workers)})")

    tokens: dict[str, str] = {}
    failed = 0
    for target in named or tuple(workers):
        account = workers[target]
        if account not in tokens:
            got = core('claude_account_token "$1"', account)
            if got.returncode == 3:
                die(f"no {account_file(account)}, so the {account} account has no token to push")
            if got.returncode:
                sys.exit(2)
            tokens[account] = got.stdout.rstrip("\n")
        if not tokens[account]:
            print(f"skipped: {target}: the {account} token is not minted yet, so it stays on its browser login")
            continue
        ok, said = install(target, account, tokens[account])
        if ok:
            print(f"ok: {target} ({account}): {said}")
        else:
            print(f"FAILED: {target} ({account}): {said or 'no answer'}")
            failed += 1
    if failed:
        print(f"clawd push: {failed} worker user(s) not done; see above", file=sys.stderr)
        sys.exit(1)


def install(target: str, account: str, token: str) -> tuple[bool, str]:
    """Whether target ended on the token with its browser login gone, and what it said."""
    def ssh(script: str, given: str | None) -> tuple[int, str]:
        done = subprocess.run(["ssh", *SSH_OPTS, target, script], input=given, stdout=subprocess.PIPE,
                              stderr=subprocess.STDOUT, stdin=None if given is not None else subprocess.DEVNULL,
                              text=True, check=False)
        return done.returncode, done.stdout.rstrip("\n")

    set_account = f"account={shlex.quote(account)}; "
    status, said = ssh(f"{set_account}ping=({shlex.join(CHEAPEST_PING)}); {INSTALL_TOKEN}", f"{token}\n")
    if status == 255:
        return False, "could not reach it to write the token (host down, or its home locked?)"
    if status:
        return False, said or "could not write the token"
    status, said = ssh(set_account + CHECK_AND_LOGOUT, None)
    return status == 0, said


if __name__ == "__main__":
    main()
