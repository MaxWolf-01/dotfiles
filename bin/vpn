CHROME_UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
)
CANARY = ("discord.com", "/api/v9/gateway")
"""Unauthenticated and tiny; the API is what Cloudflare blocks for the app."""
EGRESS = ("am.i.mullvad.net", "/json")

FALLBACK_COUNTRIES = ("Germany", "Austria", "Switzerland", "Netherlands")
MAX_TRIES = 8
"""The candidates a move probes at once, and so the most nodes it tries."""
CONFIRM_SECS = 45
"""Wait before the second check that confirms a 403.

A real IP block persists and a transient challenge clears. Every rotation is an
IP change Discord's session heuristics get to see, and rapid IP hopping is what
triggers its re-login prompts.
"""
RECHECK_SECS = 600
"""How often the watcher re-checks an unchanged node while Vesktop runs; catches a reputation flipping in place."""
FALLBACK_SECS = 15
"""Longest the watcher goes without looking while the event bus is down or tailscaled does not answer."""
HEARTBEAT_SECS = 3600
BLIND_SECS = 60
"""How long an exit node may be set with no engine update before the heartbeat calls the watcher blind."""
BACKOFF_SECS = 300
"""How long the watcher starts no recovery after one that did not leave a working node."""
LOOK_SECS = 10
"""How often the watcher looks while an exit node is set. Vesktop opening and the event bus going quiet send
nothing on the bus."""
ENGINE_SECS = 2
"""How often tailscaled pushes an engine update to a watcher that asked for them."""
STALE_SECS = 10
"""No engine update for this long counts as a closed stream."""
SAMPLES_KEPT = 64
"""Engine updates the liveness module keeps, about two minutes of them."""
SILENT_SECS = 20
"""How long traffic into the exit node may go unanswered before the node counts as silent.

A live WireGuard peer answers every data packet within 10 s: with traffic of its
own, or with an empty keepalive when it has none."""
KEEPALIVE_BYTES = 32
"""A WireGuard keepalive on the wire. Nothing answers one, and at most two go out
between two engine updates, so an update that sent no more than that expects no answer."""
PROBE_SECS = 8
"""How long the handshake probe waits for the nodes it probed to complete a handshake. A node that misses the
first one answers WireGuard's retry about 5 s after the datagram, and the engine update that shows it comes up
to ENGINE_SECS later."""
SESSION_SECS = 120
"""WireGuard's REKEY_AFTER_TIME. A session younger than this carries a probe's datagram without a new handshake."""
DISCARD_PORT = 9
PROOF_SECS = 5
"""How long the traffic proof gives a node to carry traffic."""
PROOF_TARGETS = ("1.1.1.1", "8.8.8.8")
PROOF_PORT = 443
PROOF_CONNECT_SECS = 1.0
"""The longest one of the traffic proof's connects waits."""
PROOF_RETRY_SECS = 0.5
"""How long the traffic proof waits before it connects again, unless an engine update shows bytes going to the
node sooner."""
PICK_SECS = 5
"""How long `vpn on`, and a move that stayed and put automatic mode back, wait for tailscaled to name the node
automatic mode picked."""
PICK_POLL_SECS = 0.25
"""How often they ask tailscaled for automatic mode's pick while they wait PICK_SECS."""
LOCALAPI_TIMEOUT_SECS = 10
BUS_DEBOUNCE_SECS = 1.0
"""A switch arrives as a burst of bus messages; one look after the burst is enough."""
BUS_RETRY_SECS = 5

SOCKET = os.environ.get("VPN_TAILSCALED_SOCKET", "/var/run/tailscale/tailscaled.sock")
"""tailscaled's LocalAPI. The tests point it at a socket of their own (tests/vpn_fakes.py)."""
ENGINE_UPDATES = 1 << 0
"""NotifyWatchEngineUpdates: every ENGINE_SECS, each live peer's byte counters and last handshake."""
INITIAL_PREFS = 1 << 2
"""NotifyInitialPrefs: the first message of every stream carries the prefs as they are, so a stream opened again
reports a change made while it was closed."""
PEER_PATCHES = 1 << 15
"""NotifyPeerPatches: per-peer Online changes, and (implied) peers added and removed."""
WATCH_MASK = ENGINE_UPDATES | INITIAL_PREFS | PEER_PATCHES
"""What the watcher reads from the event bus. Preference changes, the exit node among them, arrive whatever
the mask."""

