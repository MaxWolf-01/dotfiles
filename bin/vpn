"""Electron's single-instance marker: a symlink to "<hostname>-<pid>" for as long as an instance is up."""

NODE_UNIT = "vpn"
WATCH_UNIT = "vpn-watch"
RUN_LOG = Path(__file__).resolve().parent / "run-log"
"""Reached relative to this script, not through PATH: the systemd unit pins its own PATH and it does not carry ~/bin."""

Verdict = Literal["clean", "blocked", "unreachable"]
Cause = Literal["blocked", "offline"]
Stop = Literal["superseded", "cancelled", "outside"]
"""Why a running move must stop: a newer request, its client gone, an outside change."""
STOPPED: dict[Stop, str] = {"outside": "superseded by a change of exit node outside vpn",
                            "superseded": "superseded by a newer request", "cancelled": "cancelled"}
"""The words that begin the final line of a request that a stop ended."""
Event = Literal["clean", "rotated", "offline", "pinned", "changed", "off", "exhausted", "unreachable",
                "cancelled", "silent"]
State = Literal["up", "down", "off", "unknown"]
Asked = Literal["on", "off", "next", "to"]
"""What a client can ask the watcher for."""
Command = Literal[Asked, "watch"]
Mode = Literal["off", "automatic", "pinned"]
"""How the exit node is chosen."""


class VpnError(Exception):
    pass


# --------------------------------------------------------------------------
# reading tailscale's state
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Node:
    id: str
    """Stable node ID, the one ExitNodeStatus and the prefs name."""
    name: str
    """Short name, e.g. de-fra-wg-202."""
    country: str
    city: str
    online: bool
    ip: str = ""
    """Its tailnet IPv4 address, where the handshake probe sends its datagram."""

    @property
    def fqdn(self) -> str:
        return f"{self.name}.mullvad.ts.net"


@dataclass(frozen=True)
class ExitState:
    reachable: bool
    """Whether tailscaled answered at all."""
    id: str
    """The exit node's stable ID; empty when none is set."""
    online: bool | None


def mullvad_nodes(status: dict) -> list[Node]:
    """Every Mullvad exit node in a full status, sorted by country, city and name."""
    nodes = []
    for peer in (status.get("Peer") or {}).values():
        dns = peer.get("DNSName") or ""
        if not (peer.get("ExitNodeOption") and dns.endswith(".mullvad.ts.net.")):
            continue
        location = peer.get("Location") or {}
        nodes.append(
            Node(
                id=peer["ID"],
                name=dns.split(".")[0],
                country=location.get("Country", ""),
                city=location.get("City", ""),
                online=bool(peer.get("Online")),
                ip=next((ip.split("/")[0] for ip in peer.get("TailscaleIPs") or [] if "." in ip), ""),
            )
        )
    return sorted(nodes, key=lambda n: (n.country, n.city, n.name))


def exit_state(status: dict | None) -> ExitState:
    """The exit node as a status reading names it, with or without peers in it."""
    if status is None:
        return ExitState(reachable=False, id="", online=None)
    node = status.get("ExitNodeStatus") or {}
    return ExitState(reachable=True, id=node.get("ID") or "", online=node.get("Online"))


def exit_peer(status: dict) -> dict | None:
    """The peer a full status marks as the exit node in use."""
    return next((p for p in (status.get("Peer") or {}).values() if p.get("ExitNode")), None)


def current_node(status: dict | None) -> Node | None:
    """The Mullvad node a full status names as exit node."""
    if status is None:
        return None
    node_id = exit_state(status).id
    return next((n for n in mullvad_nodes(status) if n.id == node_id), None)


def mode(prefs: dict | None) -> Literal["off", "automatic", "pinned", "unknown"]:
    """How the exit node is chosen. AutoExitNode is omitted from prefs unless set."""
    if prefs is None:
        return "unknown"
    if prefs.get("AutoExitNode"):
        return "automatic"
    if prefs.get("ExitNodeID") or prefs.get("ExitNodeIP"):
        return "pinned"
    return "off"


def vpn_state(prefs: dict | None, status: dict | None, silent: bool) -> tuple[State, str]:
    """The state the dot shows, and why: what prefs ask for against what status delivers.

    Off comes from prefs alone. A status with no exit node while prefs name one
    is an outage, as when Tailnet Lock dropped every peer from the netmap.
    """
    if prefs is None or status is None:
        return "unknown", "tailscaled does not answer"
    if not prefs.get("WantRunning"):
        return "off", "tailscale is stopped"
    if mode(prefs) == "off":
        return "off", ""
    backend = status.get("BackendState")
    if backend != "Running":
        return "down", f"tailscale is {backend or 'not running'}"
    exit = exit_state(status)
    if not exit.id:
        return "down", "no exit node in the network map"
    if exit.online is False:
        return "down", "the node reports itself offline"
    if silent:
        return "down", "the node stopped answering"
    return "up", ""


def grown(new: int, old: int) -> int:
    """How far a counter moved. One lower than before counts from zero:
    tailscaled drops a peer that went idle and adds it back fresh."""
    return new - old if new >= old else new


def normalise(place: str) -> str:
    return place.strip().lower().removesuffix(".")


def resolve(place: str, nodes: list[Node]) -> list[Node]:
    """The nodes a place names, tried in this order: a node by short or full
    name, a country, a city. Case does not matter, and a US city matches with or
    without its state ("Ashburn" or "Ashburn, VA")."""
    want = normalise(place)
    matchers = (
        lambda n: want in (n.name, n.fqdn),
        lambda n: n.country.lower() == want,
        lambda n: want in (n.city.lower(), n.city.lower().split(",")[0]),
    )
    for matches in matchers:
        found = [n for n in nodes if matches(n)]
        if found:
            return found
    return []


def destinations(place: str, matched: list[Node], current: Node | None) -> list[Node]:
    """Where `vpn to` may go among the nodes `place` matched: the one node it
    names by name, whatever its state, or else the matched nodes that are online
    and not the node already in use, city by city in name order, each city in
    walk order from the start of its cycle."""
    if len(matched) == 1 and normalise(place) in (matched[0].name, matched[0].fqdn):
        return matched
    return [n for city in cities(matched) for n in walk_order(city, None, current)]


def candidates(current: Node | None, nodes: list[Node]) -> list[Node]:
    """Where to go from `current`, best first.

    The rest of its city in walk order, starting after it in the city's cycle,
    so repeated moves visit the whole city instead of bouncing between two
    nodes. Then the other cities of its country, then those of
    FALLBACK_COUNTRIES, each in walk order from the start of its cycle. The
    current node and nodes reporting themselves offline are left out.
    """
    order: list[Node] = []
    if current is not None:
        order += walk_order([n for n in nodes if (n.country, n.city) == (current.country, current.city)],
                            current, current)
        order += [n for city in cities([n for n in nodes if n.country == current.country and n.city != current.city])
                  for n in walk_order(city, None, current)]
    for country in FALLBACK_COUNTRIES:
        order += [n for city in cities([n for n in nodes if n.country == country])
                  for n in walk_order(city, None, current)]
    return list(dict.fromkeys(order))


def cities(nodes: list[Node]) -> list[list[Node]]:
    """`nodes` grouped by city, the cities in name order."""
    grouped: dict[tuple[str, str], list[Node]] = {}
    for node in sorted(nodes, key=lambda n: (n.country, n.city, n.name)):
        grouped.setdefault((node.country, node.city), []).append(node)
    return list(grouped.values())


def series(node: Node) -> str:
    """The node's provider series: the hundreds digit of its number, which within one city names one provider."""
    number = node.name.rsplit("-", 1)[-1]
    return str(int(number) // 100) if number.isdigit() else node.name


def cycle(city: list[Node]) -> list[Node]:
    """A city's nodes dealt round-robin by provider series, the series in order and each in name order:
    001 101 201 002 102 003 for three series of three, two and one nodes."""
    by_series: dict[str, list[Node]] = {}
    for node in sorted(city, key=lambda n: (series(n), n.name)):
        by_series.setdefault(series(node), []).append(node)
    rows = zip_longest(*by_series.values())
    return [n for row in rows for n in row if n is not None]


def walk_order(city: list[Node], after: Node | None, current: Node | None) -> list[Node]:
    """The order a move tries one city's online nodes in, `current` left out.

    The first is the node after `after` in the city's cycle, or the cycle's
    first. Each after it is the next untried node in the cycle, counting on from
    there, whose provider series differs from the last one tried, while the
    city has one; the cycle's own order resumes once it has none. `after` keeps
    its place in the cycle when it reports itself offline, so the cycle holds
    every node of the city and the offline ones are skipped.
    """
    ring = cycle(city)
    at = next((i + 1 for i, n in enumerate(ring) if after is not None and n.id == after.id), 0)
    pending = [n for n in ring[at:] + ring[:at] if n.online and (current is None or n.id != current.id)]
    order: list[Node] = []
    while pending:
        last = series(order[-1]) if order else None
        pick = next((n for n in pending if series(n) != last), pending[0])
        order.append(pick)
        pending.remove(pick)
    return order


def verdict(code: int) -> Verdict:
    """What the Discord check's HTTP status says about the node.

    Any 403 is a block: the endpoint is unauthenticated and its only legitimate
    answer is 200, and a Cloudflare block on this route arrives as Discord-styled
    JSON (code 40333), so the body cannot tell a block from a real Discord error.
    No answer at all, or a 5xx, says nothing about the node.
    """
    if code == 403:
        return "blocked"
    if code == 0 or code >= 500:
        return "unreachable"
    return "clean"


def vesktop_running(lock: Path = VESKTOP_LOCK) -> bool:
    """Whether a Vesktop instance is up: the lock names a pid, and a lock an
    unclean exit left behind names one that is gone."""
    try:
        pid = os.readlink(lock).rsplit("-", 1)[-1]
    except OSError:
        return False
    return pid.isdigit() and Path(f"/proc/{pid}").is_dir()


def heartbeat(poll: dict | None, exit_node: str | None, quiet: float, vesktop: bool,
              streaming: bool) -> tuple[str, str, dict]:
    """The watcher's hourly line: outcome, reason, stats. `quiet` is how long ago
    the last engine update arrived, and `streaming` whether one arrived within
    STALE_SECS, which the stats call `bus`.

    Always ok, because a machine with the VPN off or tailscaled down is not a
    watcher that stopped watching, and this line answers only that question. The
    one exception is the failure the watcher could otherwise not see, an exit
    node set, tailscaled answering, and no engine update for BLIND_SECS. The
    watcher then sees none of the exit node's traffic, so it can call no node
    silent, and `fail` puts that in front of overdue-check.
    """
    stats = {"vesktop": vesktop, "bus": streaming}
    if poll is None:
        return "ok", "", {"state": "tailscale-down", "exit_node": None} | stats
    if not exit_state(poll).id:
        return "ok", "", {"state": "no-exit-node", "exit_node": None} | stats
    if quiet > BLIND_SECS:
        return "fail", (f"an exit node is set and no engine update came for {quiet:.0f} s, so the watcher is blind "
                        f"to its traffic; `journalctl --user -u vpn-watch` says why the event bus was lost"), {}
    return "ok", "", {"state": "guarding", "exit_node": exit_node} | stats


# --------------------------------------------------------------------------
# the run log
# --------------------------------------------------------------------------


def log_run(unit: str, outcome: str, reason: str = "", stats: dict | None = None) -> None:
    """Record one outcome via bin/run-log. Recording a run never decides whether it succeeded."""
    argv = [str(RUN_LOG), unit, outcome]
    if reason:
        argv += ["--reason", reason]
    if stats is not None:
        argv += ["--stats", json.dumps(stats)]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError as e:
        print(f"vpn: could not write the run log for {unit}: {e}", file=sys.stderr)
        return
    if proc.returncode != 0:
        print(f"vpn: could not write the run log for {unit}: {proc.stderr.strip()}", file=sys.stderr)


def log_node(
    outcome: str,
    event: Event,
    command: Command,
    node: str | None = None,
    to: str | None = None,
    tried: int = 0,
    reason: str = "",
    secs: int | None = None,
) -> None:
    """One line about the exit node, in the shape the dns/vpn dashboard reads.
    `node` is the node the line is about, `to` the node it moved to, `secs` how
    long a silent node went unanswered."""
    stats = {"event": event, "command": command, "node": node, "rotated_to": to, "tried": tried}
    if secs is not None:
        stats["secs"] = secs
    log_run(NODE_UNIT, outcome, reason, stats)


# --------------------------------------------------------------------------
# the ports: what bin/vpn reaches and does not own
# --------------------------------------------------------------------------
#
# bin/vpn reaches tailscaled, the network, the clock and Vesktop only through
# these. The real ones are `real_ports`; the fakes are in tests/vpn_fakes.py.


@dataclass(frozen=True)
class Tailscaled:
    status: Callable[[], dict | None]
    """A full status reading; None when tailscaled does not answer."""
    peerless: Callable[[], dict | None]
    """A status reading without the peer list, which is nearly all of the full reading's size. It still names
    the backend state, and the exit node with its online flag. None when tailscaled does not answer."""
    prefs: Callable[[], dict | None]
    set_exit_node: Callable[[str], None]
    """`tailscale set`, with a node's full name, "auto:any", or "" for none. Raises VpnError when it fails."""
    bus: Callable[[int], Generator[dict, None, None]]
    """The event bus under a mask of NotifyWatchOpt bits, one message per item, until the stream closes.
    It is read on a thread of its own that only hands each message to the queue `Clock.wait` takes from."""


@dataclass(frozen=True)
class Network:
    probe: Callable[[str], None]
    """Send one UDP datagram to a tailnet IPv4 address's discard port, which makes tailscaled handshake with that node."""
    connect: Callable[[float], bool]
    """The traffic proof's TCP connect out. Returns whether it succeeded within the seconds given."""
    discord: Callable[[], Verdict]
    egress: Callable[[], dict]


@dataclass(frozen=True)
class Clock:
    now: Callable[[], float]
    wait: Callable[[float], "Arrival"]
    """Wait up to the seconds given for the next arrival, a bus message, a request or a hang-up, and return it, or
    None once they pass with nothing arriving. This is how the watcher and the moves wait for anything; only the
    bus reader behind the real one keeps time of its own."""


@dataclass(frozen=True)
class Ports:
    tailscaled: Tailscaled
    network: Network
    clock: Clock
    vesktop: Callable[[], bool]


# --------------------------------------------------------------------------
# liveness: what tailscaled's engine updates say
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Seen:
    """One peer in one engine update."""

    received: int
    sent: int
    handshake: float
    """When its last handshake completed; -inf for never."""


@dataclass(frozen=True)
class Sample:
    """When one engine update arrived, and the live peers in it by node key."""

    at: float
    peers: dict[str, Seen]


@dataclass
class Liveness:
    """Each peer's traffic and handshakes, from the engine updates tailscaled
    pushes every ENGINE_SECS, and from them whether the exit node is silent.

    Engine updates name peers by node key; a full status reading maps the keys
    to nodes. A peer missing from an update has sent and received nothing since
    the one before, because tailscaled drops idle peers from its WireGuard
    configuration. A peer added back starts its counters from zero.
    """

    clock: Clock
    arrived: deque = field(default_factory=deque)
    """What `wait` took in that was not an engine update, in arrival order, for the watcher."""
    keys: dict[str, str] = field(default_factory=dict)
    """Node key by stable node ID, for every peer the last full status reading listed."""
    known: set[str] = field(default_factory=set)
    """Every node key a full status reading listed or an engine update carried."""
    unknown: bool = False
    """Whether an engine update carried a key never met before; the watcher reads the full status then."""
    exit_id: str = ""
    """The exit node the last full status reading named; empty for none."""
    samples: deque[Sample] = field(default_factory=lambda: deque(maxlen=SAMPLES_KEPT))
    unanswered_since: float | None = None
    """The update that first saw traffic go into the exit node with nothing coming back since."""
    counted: Seen | None = None
    """The exit node's counters as of the last update that carried them."""
    started: float = field(init=False)

    def __post_init__(self) -> None:
        self.started = self.clock.now()

    def learn(self, status: dict) -> None:
        """Take the key-to-node map and the exit node from a full status reading.
        A new exit node starts the silence count over."""
        self.keys = {p["ID"]: p["PublicKey"] for p in (status.get("Peer") or {}).values() if p.get("PublicKey")}
        self.known |= set(self.keys.values())
        self.unknown = False
        exit_id = (exit_peer(status) or {}).get("ID") or ""
        if exit_id != self.exit_id:
            self.exit_id, self.counted, self.unanswered_since = exit_id, None, None

    def feed(self, message: dict) -> None:
        """Take in one bus message. Only engine updates change anything."""
        engine = message.get("Engine")
        if engine is None:
            return
        now = self.clock.now()
        peers = {
            key: Seen(p.get("RxBytes") or 0, p.get("TxBytes") or 0, instant(p.get("LastHandshake")))
            for key, p in (engine.get("LivePeers") or {}).items()
        }
        if not peers.keys() <= self.known:
            self.unknown = True
            self.known |= peers.keys()
        gap = bool(self.samples) and now - self.samples[-1].at > SILENT_SECS
        self.samples.append(Sample(now, peers))
        self.listen(peers, gap, now)

    def listen(self, peers: dict[str, Seen], gap: bool, now: float) -> None:
        """Note what the exit node's counters did since the last update.

        Anything coming back clears a silence. Traffic going in with nothing back
        starts one, unless it was only keepalives. A gap between updates longer
        than SILENT_SECS starts over. During a suspend nothing could come back,
        and the time slept is not time unanswered.
        """
        key = self.keys.get(self.exit_id)
        seen = peers.get(key, self.counted) if key else None
        last, self.counted = self.counted, seen
        if seen is None or last is None or gap:
            self.unanswered_since = None
            return
        if grown(seen.received, last.received):
            self.unanswered_since = None
        elif grown(seen.sent, last.sent) > 2 * KEEPALIVE_BYTES and self.unanswered_since is None:
            self.unanswered_since = now

    def wait(self, secs: float, until: Callable[[], bool] = lambda: False) -> None:
        """Wait up to `secs`, or until `until()` holds, feeding what arrives meanwhile."""
        deadline = self.clock.now() + secs
        while not until():
            left = deadline - self.clock.now()
            if left <= 0:
                return
            arrival = self.clock.wait(left)
            if arrival is None:
                return
            if engine_update(arrival):
                self.feed(arrival)
            else:
                self.arrived.append(arrival)

    def streaming(self) -> bool:
        """Whether engine updates are arriving. No update for STALE_SECS counts as a closed stream."""
        return bool(self.samples) and self.clock.now() - self.samples[-1].at <= STALE_SECS

    def quiet(self) -> float:
        """How long ago the last engine update arrived, or this liveness started when none has."""
        return self.clock.now() - (self.samples[-1].at if self.samples else self.started)

    def silent(self) -> bool:
        """Whether the exit node is silent. With the stream closed there are no samples, and so no verdict."""
        return (self.streaming() and self.unanswered_since is not None
                and self.clock.now() - self.unanswered_since >= SILENT_SECS)

    def handshake_since(self, node: Node, since: float) -> bool:
        """Whether `node` completed a handshake after `since`."""
        key = self.keys.get(node.id)
        return any(s.peers[key].handshake > since for s in self.samples if key in s.peers)

    def received_since(self, node: Node, since: float) -> bool:
        """Whether `node`'s received bytes grew after `since`."""
        return self.grew(node, since, "received")

    def sent_since(self, node: Node, since: float) -> bool:
        """Whether bytes went to `node` after `since`, which after a switch means traffic is routed to it."""
        return self.grew(node, since, "sent")

    def grew(self, node: Node, since: float, counter: Literal["received", "sent"]) -> bool:
        """Whether one of `node`'s counters grew after `since`.

        Measured from the last update at or before `since`. Without one, from the
        first update after it, which can miss growth but never invents it."""
        key = self.keys.get(node.id)
        if key is None:
            return False
        before = [s for s in self.samples if s.at <= since]
        after = [s for s in self.samples if s.at > since]
        if not before:
            before, after = after[:1], after[1:]
        if not before:
            return False

        def count(sample: Sample) -> int:
            seen = sample.peers.get(key)
            return getattr(seen, counter) if seen else 0

        start = count(before[-1])
        return any(grown(count(s), start) for s in after)


def engine_update(arrival: object) -> TypeGuard[dict]:
    """Whether a bus message is an engine update. tailscaled sends every field of every message, null where
    the message has nothing to say."""
    return isinstance(arrival, dict) and arrival.get("Engine") is not None


def instant(text: str | None) -> float:
    """A LocalAPI timestamp as epoch seconds; -inf for Go's zero time or anything unreadable."""
    try:
        t = datetime.fromisoformat(text or "")
    except ValueError:
        return float("-inf")
    return t.timestamp() if t.year > 1 else float("-inf")


def probe(nodes: list[Node], liveness: Liveness, ports: Ports, stop: Callable[[], Stop | None] = lambda: None) -> list[Node]:
    """Handshake-probe `nodes` at once and wait up to PROBE_SECS for them to
    answer. Returns the nodes that answered, in the order given. Changes no exit
    node, and waits no longer once `stop()` returns something.

    A node answers with a handshake newer than the datagram, or with one less
    than SESSION_SECS older: WireGuard carries the datagram over a session that
    young without a new handshake."""
    since = ports.clock.now()
    for node in nodes:
        ports.network.probe(node.ip)

    def answered(node: Node) -> bool:
        return liveness.handshake_since(node, since - SESSION_SECS)

    liveness.wait(PROBE_SECS, until=lambda: stop() is not None or all(answered(n) for n in nodes))
    return [n for n in nodes if answered(n)]


def traffic_proof(node: Node | None, liveness: Liveness, ports: Ports, stop: Callable[[], Stop | None] = lambda: None) -> bool:
    """Whether `node`, which the exit node was just set to, carries traffic. It
    does when, within PROOF_SECS, a TCP connect out through it succeeds and its
    received bytes grow. A node outside Mullvad (None) carries nothing this can see.
    Once `stop()` returns something the proof waits no longer, and fails unless
    it has already passed.

    Right after a switch a connect can still leave through the old route. So a
    connect counts only once an engine update has shown bytes going to `node`,
    and until one has, the connects go out again every PROOF_RETRY_SECS."""
    if node is None:
        return False
    clock = ports.clock
    since = clock.now()
    deadline = since + PROOF_SECS
    connected = False

    def proven() -> bool:
        return connected and liveness.received_since(node, since)

    while (left := deadline - clock.now()) > 0 and stop() is None:
        routed = liveness.sent_since(node, since)
        answered = ports.network.connect(min(left, PROOF_CONNECT_SECS))
        connected = connected or (answered and routed)
        if proven():
            return True
        liveness.wait(max(min(PROOF_RETRY_SECS, deadline - clock.now()), 0.0),
                      until=lambda: proven() or stop() is not None or (not routed and liveness.sent_since(node, since)))
    return proven()


# --------------------------------------------------------------------------
# moving the exit node
# --------------------------------------------------------------------------


Why = Literal["asked", "blocked", "offline", "silent"]


@dataclass(frozen=True)
class Start:
    """The exit node as it was before a move."""

    mode: Mode
    node: Node | None
    """The node in use, pinned or automatic mode's pick. None when off, and when the pinned node is outside
    Mullvad. A move that has moved the exit node off such a node cannot name it back, and puts automatic mode
    on instead."""
    id: str
    """The stable ID prefs name for a pinned node, one outside Mullvad included; empty when nothing is pinned."""
    name: str | None
    """The exit node's name, one outside Mullvad included. None when off, when automatic mode has picked no node
    yet, and when the network map does not list the node prefs name."""


@dataclass(frozen=True)
class Outcome:
    """How a move ended."""

    kind: Literal["moved", "stayed", "superseded"]
    """moved: `node` is now pinned. stayed: the exit node is as the move's start had it, or on automatic mode
    where the move had moved it off a node outside Mullvad. superseded: an outside change stopped the move,
    and nothing was undone."""
    node: Node | None
    because: Literal["unanswered", "failed", "cancelled", "superseded"] | None
    """Why a move stayed: no candidate answered, none passed, its client went, or a newer request came."""
    tried: int
    reason: str
    """How it ended, in words: the line its caller ends on."""
    why: Why
    carried: int = 0
    """How many of the nodes tried carried traffic."""


def start_of(prefs: dict, status: dict) -> Start:
    """The exit node as prefs and a full status reading have it."""
    how = mode(prefs)
    assert how != "unknown"
    if how == "off":
        return Start("off", None, "", None)
    node = current_node(status)
    pinned_id = (prefs.get("ExitNodeID") or "") if how == "pinned" else ""
    return Start(how, node, pinned_id, node.name if node else (exit_peer(status) or {}).get("HostName"))


def move(
    start: Start,
    candidates: list[Node],
    why: Why,
    discord: bool,
    say: Callable[[str], None],
    stop: Callable[[], Stop | None],
    liveness: Liveness,
    ports: Ports,
) -> Outcome:
    """Move the exit node off `start` to the first of `candidates`, in walk
    order, that answers the handshake probe, carries traffic, and passes the
    Discord check when `discord` is set; or put it back as `start` had it.

    It probes the first MAX_TRIES candidates at once, then takes the ones that
    answered in turn: `say` the node, set the exit node to it, run the traffic
    proof, and run the Discord check. A Discord check that gets no answer does
    not fail the node. `stop` is asked before every step and ends every wait.
    A newer request or a client gone puts the exit node back as `start` had it;
    an outside change is left in place. `why` the move is made goes into the
    Outcome, for the node log.
    """
    tried = carried = 0

    def halt(stopped: Stop) -> Outcome:
        if stopped == "outside":
            return Outcome("superseded", None, None, tried, STOPPED[stopped], why, carried)
        return Outcome("stayed", None, stopped, tried, f"{STOPPED[stopped]}; {put_back(start, ports)}", why, carried)

    if (stopped := stop()) is not None:
        return halt(stopped)
    batch = candidates[:MAX_TRIES]
    if not batch:
        return Outcome("stayed", None, "unanswered", 0, f"no online node to move to; {put_back(start, ports)}", why)
    answered = probe(batch, liveness, ports, stop)
    if (stopped := stop()) is not None:
        return halt(stopped)
    say(handshake_line(batch, answered))
    for node in answered:
        if (stopped := stop()) is not None:
            return halt(stopped)
        say(f"trying {node.name} ({node.city}, {node.country}) …")
        tried += 1
        try:
            ports.tailscaled.set_exit_node(node.fqdn)
        except VpnError as e:
            if (stopped := stop()) is not None:
                return halt(stopped)
            return Outcome("stayed", None, "failed", tried, f"{e}; {put_back(start, ports)}", why, carried)
        passed = traffic_proof(node, liveness, ports, stop)
        if (stopped := stop()) is not None:
            return halt(stopped)
        if not passed:
            continue
        carried += 1
        if discord and ports.network.discord() == "blocked":
            continue
        if (stopped := stop()) is not None:
            return halt(stopped)
        return Outcome("moved", node, None, tried, f"pinned: {node.name} ({node.city}, {node.country})", why, carried)

    if (stopped := stop()) is not None:
        return halt(stopped)
    back = put_back(start, ports)
    if not answered:
        return Outcome("stayed", None, "unanswered", 0, f"no node answered the handshake; {back}", why)
    failures = [f"{tried - carried} carried no traffic" if tried > carried else "",
                f"Cloudflare blocks {carried}" if carried else ""]
    return Outcome("stayed", None, "failed", tried,
                   f"none of the {tried} nodes tried passed ({', '.join(f for f in failures if f)}); {back}", why,
                   carried)


def handshake_line(batch: list[Node], answered: list[Node]) -> str:
    """The probe summary a move prints."""
    quiet = [n.name for n in batch if n not in answered]
    if len(batch) == 1:
        return f"handshake: {batch[0].name} {'answers' if answered else 'does not answer'}"
    if not answered:
        return f"handshake: none of the next {len(batch)} nodes answers; the network is down, or Mullvad refuses this device"
    line = f"handshake: {len(answered)} of the next {len(batch)} nodes answer"
    if quiet:
        line += f", {', '.join(quiet)} {'does' if len(quiet) == 1 else 'do'} not"
    return line


def put_back(start: Start, ports: Ports) -> str:
    """Put the exit node back as `start` had it, where prefs say it is not now, and say where it is.

    A start pinned to a node vpn cannot name back, one outside Mullvad or one
    the network map does not list, gets automatic mode once the exit node has
    left it, which may already be on. A `tailscale set` that fails is said too."""
    prefs = ports.tailscaled.prefs()
    now, pinned_to = mode(prefs), (prefs or {}).get("ExitNodeID")
    if start.mode == "off":
        target, there, where = "", now == "off", "off"
    elif start.mode == "automatic":
        target, there = "auto:any", now == "automatic"
        where = f"on {start.node.name} (automatic mode)" if start.node else "on automatic mode"
    elif start.node is None:
        unnamed = f"{start.name}, which is outside Mullvad" if start.name else "the node the network map does not list"
        if now == "pinned" and pinned_to == start.id:
            return f"the exit node is still on {unnamed}"
        target, there, where = "auto:any", now == "automatic", f"on automatic mode in place of {unnamed}"
    else:
        target, there, where = start.node.fqdn, now == "pinned" and pinned_to == start.node.id, f"on {start.node.name}"
    if not there:
        try:
            ports.tailscaled.set_exit_node(target)
        except VpnError as e:
            return f"putting the exit node back failed: {e}"
    return f"the exit node is {'still' if there else 'back'} {where}"


def check_confirmed(liveness: Liveness, ports: Ports, stop: Callable[[], Stop | None] = lambda: None) -> Verdict:
    """A Discord check whose 403 is confirmed after CONFIRM_SECS, a wait that ends once `stop()` returns something."""
    first = ports.network.discord()
    if first != "blocked":
        return first
    liveness.wait(CONFIRM_SECS, until=lambda: stop() is not None)
    return first if stop() is not None else ports.network.discord()


def automatic_pick(nodes: list[Node], liveness: Liveness, ports: Ports, stop: Callable[[], Stop | None]) -> Node | None:
    """The node of `nodes` automatic mode picked, once tailscaled names one, within PICK_SECS."""
    by_id = {n.id: n for n in nodes}
    deadline = ports.clock.now() + PICK_SECS
    while True:
        picked = by_id.get(exit_state(ports.tailscaled.peerless()).id)
        if picked is not None or ports.clock.now() >= deadline or stop() is not None:
            return picked
        liveness.wait(PICK_POLL_SECS)


# --------------------------------------------------------------------------
# the watcher
# --------------------------------------------------------------------------
#
# The watcher is the one process that changes the exit node. The vpn commands
# send it requests over REQUEST_SOCKET, and it tells its own changes from
# outside ones by the targets it set.


@dataclass(frozen=True)
class Setting:
    """The exit node as prefs set it."""

    mode: Mode
    node: str
    """The stable ID of its node; empty when off, and while automatic mode has picked none."""


@dataclass(frozen=True)
class Silence:
    node: str | None
    since: float
    """The engine update that first saw the traffic go unanswered."""
    seen: float
    """The last engine update that found the node still silent."""


@dataclass(frozen=True)
class Client:
    """The command that sent a request, at the other end of the request socket."""

    say: Callable[[str], None]
    """Stream one line of progress."""
    finish: Callable[[bool, str], None]
    """The request's final line, called exactly once per request, whether or not the client is still there."""
    connected: Callable[[], bool]
    """Whether the client still waits for the outcome. Ctrl-C at a command closes its sending side."""


@dataclass(frozen=True)
class Request:
    request: Asked
    place: str
    """Where `to` goes; empty for the others."""
    client: Client


@dataclass(frozen=True)
class Hangup:
    """A client closed its end of the request socket. It only wakes a waiting move, whose `stop` then finds the
    client gone."""


Arrival = dict | Request | Hangup | None
"""What the watcher handles: a bus message, a request, a hang-up, or None for a tick, time passing with nothing
arriving."""


@dataclass
class Watch:
    """What the watcher remembers between the things it handles."""

    live: Liveness
    """What the engine updates say."""
    begun: bool = False
    """Whether the watcher has taken its first step, which reads the full status and the prefs."""
    nodes: dict[str, Node] = field(default_factory=dict)
    """The Mullvad nodes by stable ID, as the last full status reading listed them."""
    names: dict[str, str] = field(default_factory=dict)
    """Every peer's host name by stable ID, Mullvad or not."""
    ids: dict[str, str] = field(default_factory=dict)
    """Every peer's stable ID by its full name and by each of its tailnet addresses."""
    at: Setting | None = None
    """The exit node as tailscaled last reported it; None until it answered."""
    mine: list[Setting] = field(default_factory=list)
    """What the watcher's own `tailscale set`s asked for that tailscaled has not reported yet, oldest first."""
    logged: str | None = None
    """The exit node's name as the node log has it."""
    outside: bool = False
    """Whether an outside change came since the running move, or the look's check, began."""
    backlog: deque[Request] = field(default_factory=deque)
    """Requests that arrived while the watcher was busy, oldest first."""
    moving: Command | None = None
    """Whose move set the exit node where the node log does not have it yet: the request's, or "watch" for the
    watcher's own."""
    verified_id: str = ""
    """The node the Discord check last passed, forgotten whenever Vesktop is seen closed."""
    last_check: float = 0.0
    last_beat: float = float("-inf")
    backoff_until: float = 0.0
    """No recovery starts before this."""
    due_at: float = 0.0
    """When the next look is due."""
    looked_silent: bool = False
    """The silence verdict as the last look had it."""
    silence: Silence | None = None
    """The silence in progress."""
    shown: dict = field(default_factory=dict)
    """What STATE_FILE says, apart from since when."""
    shown_since: float = 0.0


def handle(w: Watch, arrival: Arrival, ports: Ports) -> float:
    """Act on one arrival, and on whatever arrives while acting on it. Returns
    the seconds until the next tick is due.

    The first step reads the full status and the prefs, and looks. An engine
    update is taken in, and brings the next look forward only when the silence
    verdict changed. A request is served at once. Any other bus message starts
    a burst, and one look follows it. A tick is a look that came due, or the
    stream going quiet for STALE_SECS.
    """
    clock, live = ports.clock, w.live
    first = not w.begun
    if first:
        begin(w, ports)
    if engine_update(arrival):
        live.feed(arrival)
        if live.unknown:
            relearn(w, ports)
        record_silence(w, live)
        if not first and live.silent() == w.looked_silent and clock.now() < w.due_at:
            return next_wait(w, live)
    elif isinstance(arrival, Hangup):
        if not first:
            return next_wait(w, live)
    elif arrival is not None:
        live.arrived.append(arrival)
        settle(w, ports)
        if not first:
            live.wait(BUS_DEBOUNCE_SECS, until=lambda: any(isinstance(a, Request) for a in live.arrived))
    settle(w, ports)
    due = look(w, ports)
    if settle(w, ports):
        due = min(due, BUS_DEBOUNCE_SECS)  # something changed while the look ran
    w.due_at = clock.now() + due
    return next_wait(w, live)


def begin(w: Watch, ports: Ports) -> None:
    """The watcher's first step: the full status, and the exit node the node log starts from."""
    w.begun = True
    relearn(w, ports)
    prefs = ports.tailscaled.prefs()
    if prefs is not None:
        w.at = setting(w, prefs)
        w.logged = name_of(w, w.at.node, ports)


def settle(w: Watch, ports: Ports) -> bool:
    """Take in what arrived, in arrival order, and serve the requests among it,
    each superseding the one before it that has not started. Returns whether
    anything but an engine update or a hang-up arrived."""
    heard = drain(w, ports)
    while w.backlog:
        request = w.backlog.popleft()
        if w.backlog:
            request.client.finish(False, unstarted("superseded"))
        else:
            serve(w, request, ports)
        drain(w, ports)
        heard = True
    return heard


def drain(w: Watch, ports: Ports) -> bool:
    """Take in, in arrival order, everything that has arrived without waiting
    for more: engine updates are fed to the liveness module, prefs are compared
    with what the watcher set, and requests join the backlog. Returns whether
    anything but an engine update or a hang-up arrived."""
    live = w.live
    while (arrival := ports.clock.wait(0)) is not None:
        if engine_update(arrival):
            live.feed(arrival)
        else:
            live.arrived.append(arrival)
    heard = False
    while live.arrived:
        arrival = live.arrived.popleft()
        if isinstance(arrival, Request):
            w.backlog.append(arrival)
            heard = True
        elif isinstance(arrival, dict):
            heard = True
            if arrival.get("Prefs"):
                take(w, arrival["Prefs"], ports)
    return heard


def take(w: Watch, prefs: dict, ports: Ports) -> None:
    """Compare prefs tailscaled reported with what the watcher set. A report of
    one of its own targets settles that target and every one set before it. Any
    other change is an outside change. It is logged once and adopted, and it
    supersedes the running move and every request still waiting its turn."""
    now = setting(w, prefs)
    if w.at is None:
        w.at, w.logged = now, name_of(w, now.node, ports)
        return
    for i, want in enumerate(w.mine):
        if reported(want, now):
            picking = want.mode == "automatic" and not now.node
            del w.mine[:i if picking else i + 1]  # automatic mode reports once more, when it picks
            w.at = now
            return
    if now == w.at:
        return
    ours = w.mine[-1] if w.mine else w.at
    w.at, w.outside = now, True
    w.mine.clear()
    while w.backlog:
        w.backlog.popleft().client.finish(False, unstarted("outside"))
    left, name = name_of(w, ours.node, ports), name_of(w, now.node, ports)
    if w.moving is not None and left != w.logged:
        # The change a stopped move made before this one is the move's, and the log has not had it.
        log_line(w, "skip", "cancelled", w.moving, w.logged, left,
                 reason=f"stopped on {left or 'no exit node'} by a change of exit node outside vpn")
        w.moving = None
    print(f"exit node changed outside vpn: {left or 'none'} → {name or 'none'}")
    if name != w.logged:
        log_line(w, "ok", "changed", "watch", w.logged, name)


def setting(w: Watch, prefs: dict) -> Setting:
    """The exit node as prefs set it. Automatic mode names its pick in ExitNodeID, and "auto:any" there before it
    picks one; a node set by address carries ExitNodeIP until tailscaled resolves it."""
    how = mode(prefs)
    if how not in ("automatic", "pinned"):
        return Setting("off", "")
    node_id = prefs.get("ExitNodeID") or ""
    if node_id == "auto:any":
        node_id = ""
    if not node_id and prefs.get("ExitNodeIP"):
        # An address no peer has stays an address, so the next report of it compares equal.
        node_id = w.ids.get(prefs["ExitNodeIP"], f"ip:{prefs['ExitNodeIP']}")
    return Setting(how, node_id)


def wanted(w: Watch, target: str) -> Setting:
    """The setting a `tailscale set --exit-node=<target>` asks for. A move sets only nodes of a status reading
    the watcher has taken in."""
    if not target:
        return Setting("off", "")
    if target == "auto:any":
        return Setting("automatic", "")
    name = target.removesuffix(".")
    if name not in w.ids:
        raise VpnError(f"{name} is not in the network map vpn last read; not setting it")
    return Setting("pinned", w.ids[name])


def reported(want: Setting, now: Setting) -> bool:
    """Whether a setting tailscaled reports is the one asked for. Automatic mode is asked for, not its pick."""
    return now.mode == "automatic" if want.mode == "automatic" else now == want


def own(w: Watch, ports: Ports) -> Ports:
    """`ports` with a `tailscale set` the watcher remembers as its own until
    tailscaled reports it, and which refuses to set anything once an outside
    change came during the move, so that the outside change stays."""
    tailscaled = ports.tailscaled

    def set_exit_node(target: str) -> None:
        if interrupted(w, ports) == "outside":
            raise VpnError("the exit node was changed outside vpn; leaving it as it is")
        want = wanted(w, target)
        tailscaled.set_exit_node(target)
        expected = w.mine[-1] if w.mine else w.at
        if expected is None or not reported(want, expected):
            w.mine.append(want)

    return replace(ports, tailscaled=replace(tailscaled, set_exit_node=set_exit_node))


def interrupted(w: Watch, ports: Ports, client: Client | None = None) -> Stop | None:
    """Why a running move or check must stop, if it must: an outside change, its
    client gone, or a newer request. It first takes in what arrived, which logs
    an outside change and ends the requests waiting their turn (`take`)."""
    drain(w, ports)
    if w.outside:
        return "outside"
    if client is not None and not client.connected():
        return "cancelled"
    if w.backlog:
        return "superseded"
    return None


def unstarted(stopped: Stop) -> str:
    """The final line of a request that a stop ended before its move began."""
    return f"{STOPPED[stopped]}; nothing changed"


def begin_move(w: Watch, by: Command | None) -> None:
    """Start a move by `by`, or with None a request before its move or the look's check, with no outside change
    seen and none of its sets logged."""
    w.outside, w.moving = False, by


def serve(w: Watch, request: Request, ports: Ports) -> None:
    """Run one request to its end and send the client its final line. A request
    stopped before its first step changes nothing."""
    begin_move(w, None)
    client = request.client
    print(f"vpn {request.request} {request.place}".rstrip())
    stopped = interrupted(w, ports, client)
    if stopped is not None:
        ok, message = False, unstarted(stopped)
    else:
        try:
            ok, message = SERVED[request.request](w, request, ports, lambda: interrupted(w, ports, client))
        except VpnError as e:
            ok, message = False, str(e)
    print(message)
    client.finish(ok, message)


def reading(w: Watch, ports: Ports) -> tuple[dict, dict]:
    """Prefs and a full status reading, taken in; VpnError when tailscaled does not answer."""
    prefs, status = ports.tailscaled.prefs(), ports.tailscaled.status()
    if prefs is None or status is None:
        raise VpnError("tailscaled did not answer")
    learn(w, status)
    return prefs, status


def serve_on(w: Watch, request: Request, ports: Ports, stop: Callable[[], Stop | None]) -> tuple[bool, str]:
    """Turn on automatic mode, then run the traffic proof and the Discord check on
    its pick; move off a pick that fails either."""
    prefs, status = reading(w, ports)
    if not prefs.get("WantRunning"):
        raise VpnError("tailscale is stopped: `tailscale up` first")
    start, nodes, say = start_of(prefs, status), mullvad_nodes(status), request.client.say
    ports = own(w, ports)
    begin_move(w, "on")
    ports.tailscaled.set_exit_node("auto:any")
    picked = automatic_pick(nodes, w.live, ports, stop)
    verdict = None
    if picked is not None and stop() is None:
        say(f"trying {picked.name} ({picked.city}, {picked.country}), automatic mode's pick …")
        if traffic_proof(picked, w.live, ports, stop) and stop() is None:
            verdict = check_confirmed(w.live, ports, stop)
    if picked is not None and verdict in ("clean", "unreachable") and stop() is None:
        heard = ("Discord check clean" if verdict == "clean"
                 else "the Discord check got no answer, which says nothing about the node")
        w.moving = None
        log_line(w, "ok", "clean", "on", start.name, picked.name if picked.name != start.name else None,
                 reason="" if verdict == "clean" else heard)
        return True, f"exit node: {picked.name} (automatic, {heard})"
    if picked is None:
        leaving = f"automatic mode picked no node within {PICK_SECS} s"
    else:
        leaving = (f"Cloudflare blocks {picked.name}; moving off it" if verdict == "blocked"
                   else f"{picked.name} carries no traffic; moving off it")
    if stop() is None:
        say(leaving)
    # A stop that came while the pick was checked ends this move at its first step.
    outcome = move(start, candidates(picked, nodes), "blocked" if verdict == "blocked" else "offline", True, say,
                   stop, w.live, ports)
    record(w, "on", start, outcome, ports, moved="pinned", reason=leaving)
    if outcome.because == "unanswered":
        return False, f"egress never reached Mullvad, and {outcome.reason} (portal: run `portal`)"
    return outcome.kind == "moved", outcome.reason


def serve_to(w: Watch, request: Request, ports: Ports, stop: Callable[[], Stop | None]) -> tuple[bool, str]:
    prefs, status = reading(w, ports)
    start = start_of(prefs, status)
    matched = resolve(request.place, mullvad_nodes(status))
    if not matched:
        raise VpnError(f'no exit node matches "{request.place}"; see `vpn list`')
    return asked(w, request, start, destinations(request.place, matched, start.node), ports, stop)


def serve_next(w: Watch, request: Request, ports: Ports, stop: Callable[[], Stop | None]) -> tuple[bool, str]:
    prefs, status = reading(w, ports)
    start = start_of(prefs, status)
    return asked(w, request, start, candidates(start.node, mullvad_nodes(status)), ports, stop)


def asked(w: Watch, request: Request, start: Start, options: list[Node], ports: Ports,
          stop: Callable[[], Stop | None]) -> tuple[bool, str]:
    """The move `vpn next` or `vpn to` asks for, through `options`: run and recorded."""
    if not options:
        raise VpnError("no online node to move to")
    begin_move(w, request.request)
    outcome = move(start, options, "asked", True, request.client.say, stop, w.live, own(w, ports))
    record(w, request.request, start, outcome, ports)
    return outcome.kind == "moved", outcome.reason


def serve_off(w: Watch, request: Request, ports: Ports, stop: Callable[[], Stop | None]) -> tuple[bool, str]:
    prefs, status = reading(w, ports)
    left = start_of(prefs, status).name
    own(w, ports).tailscaled.set_exit_node("")
    log_line(w, "ok", "off", "off", left)
    return True, "exit node off"


SERVED = {"on": serve_on, "to": serve_to, "next": serve_next, "off": serve_off}


MOVED: dict[Why, Event] = {"asked": "pinned", "blocked": "rotated", "offline": "offline", "silent": "offline"}
"""The node-log event of a move that pinned a node, by why it was made."""


def record(w: Watch, by: Command, start: Start, outcome: Outcome, ports: Ports, moved: Event | None = None,
           reason: str = "") -> None:
    """The node-log line for a move's Outcome, in the events the dns/vpn
    dashboard reads, plus `cancelled` for a move that Ctrl-C or a newer request
    stopped. `moved` overrides the event of a move that pinned a node, and
    `reason` says why it was made. A move an outside change superseded writes
    none: `take` logged it with the outside change.

    A move that stayed names where the exit node landed when that is not where
    it started, as when automatic mode took the place of a node outside Mullvad.
    That is read from prefs, since tailscaled's report of the put-back may still
    be on its way, and automatic mode gets PICK_SECS to name its pick. Where an
    outside change came on the move's way back and `take` has logged the move's
    change with it, it writes none either."""
    if outcome.kind == "superseded":
        w.moving = None
        return
    if outcome.kind == "moved" and outcome.node is not None:
        w.moving = None
        log_line(w, "ok", moved or MOVED[outcome.why], by, start.name, outcome.node.name, outcome.tried, reason)
        return
    now = landing(w, ports)
    if w.outside and w.moving is None:
        return
    w.moving = None
    landed = start.name if now is None or w.outside else name_of(w, now.node, ports)
    to = landed if landed != start.name else None
    if outcome.because in ("cancelled", "superseded"):
        log_line(w, "skip", "cancelled", by, start.name, to, outcome.tried, outcome.reason)
    else:
        log_line(w, "fail", "exhausted" if outcome.carried else "unreachable", by, start.name, to, outcome.tried,
                 outcome.reason)


def landing(w: Watch, ports: Ports) -> Setting | None:
    """The exit node as prefs have it, once automatic mode has named its pick or PICK_SECS have passed. None when
    tailscaled does not answer, or when an outside change arrives meanwhile, which `take` then logs."""
    deadline = ports.clock.now() + PICK_SECS
    while True:
        drain(w, ports)
        if w.outside:
            return None
        prefs = ports.tailscaled.prefs()
        now = None if prefs is None else setting(w, prefs)
        if now is None or now.mode != "automatic" or now.node or ports.clock.now() >= deadline:
            return now
        w.live.wait(PICK_POLL_SECS)


def log_line(w: Watch, outcome: str, event: Event, by: Command, node: str | None, to: str | None = None,
             tried: int = 0, reason: str = "") -> None:
    """Write one node-log line, and keep where the log has the exit node."""
    log_node(outcome, event, by, node, to, tried, reason)
    if event == "off":
        w.logged = None
    elif event == "changed" or to is not None:
        w.logged = to


def name_of(w: Watch, node_id: str, ports: Ports) -> str | None:
    """The host name of the peer `node_id` names, reading the full status for one not met before; None for none,
    and for a peer the network map does not list."""
    if not node_id:
        return None
    if node_id not in w.names:
        relearn(w, ports)
    return w.names.get(node_id)


def next_wait(w: Watch, live: Liveness) -> float:
    """The seconds until the next look is due, or until the stream would count as closed, if that is sooner."""
    until = w.due_at
    if live.streaming():
        until = min(until, live.samples[-1].at + STALE_SECS + 0.1)
    return max(until - live.clock.now(), 0.0)


def relearn(w: Watch, ports: Ports) -> None:
    """Read the full status and take it in."""
    status = ports.tailscaled.status()
    if status is not None:
        learn(w, status)


def learn(w: Watch, status: dict) -> None:
    """Take in a full status reading: the nodes, their names and keys, and the exit node."""
    w.live.learn(status)
    w.nodes = {n.id: n for n in mullvad_nodes(status)}
    w.names, w.ids = {}, {}
    for peer in (status.get("Peer") or {}).values():
        w.names[peer["ID"]] = peer.get("HostName") or peer["ID"]
        for name in [(peer.get("DNSName") or "").removesuffix("."), *(peer.get("TailscaleIPs") or [])]:
            if name:
                w.ids[name.split("/")[0]] = peer["ID"]


def recover(w: Watch, cause: Cause, ports: Ports) -> None:
    """Move the exit node off a node that Cloudflare blocks or that stopped
    carrying traffic, from its place in the walk order.

    The Discord check runs on each node tried only while Vesktop runs, and a
    node pinned then is remembered as checked. A move that stays puts the node
    back, and no recovery starts for BACKOFF_SECS after it, unless a request or
    an outside change stopped it.
    """
    vesktop = ports.vesktop()
    try:
        prefs, status = reading(w, ports)
    except VpnError as e:
        print(f"recovery failed: {e}")
        w.backoff_until = ports.clock.now() + BACKOFF_SECS
        return
    start = start_of(prefs, status)
    if start.node is None:
        print("the exit node is not a Mullvad node tailscaled lists; leaving it alone")
        return
    print(f"moving off {start.node.name}: "
          f"{'Cloudflare blocks it' if cause == 'blocked' else 'it stopped carrying traffic'}")
    begin_move(w, "watch")
    outcome = move(start, candidates(start.node, mullvad_nodes(status)), cause, vesktop, print,
                   lambda: interrupted(w, ports), w.live, own(w, ports))
    record(w, "watch", start, outcome, ports)
    print(outcome.reason)
    if outcome.kind == "moved" and outcome.node is not None:
        if vesktop:
            checked(w, outcome.node, ports.clock.now())
        return
    if outcome.kind == "superseded" or outcome.because == "superseded":
        return
    w.backoff_until = ports.clock.now() + BACKOFF_SECS


def look(w: Watch, ports: Ports) -> float:
    """One look at the exit node, acting on what it finds. Returns the seconds
    until the next look is due; a bus message brings it forward."""
    live = w.live
    now = ports.clock.now()
    poll = ports.tailscaled.peerless()
    vesktop = ports.vesktop()
    if not vesktop:
        w.verified_id = ""
    state = exit_state(poll)
    if state.reachable and state.id != live.exit_id:
        relearn(w, ports)
    node = w.nodes.get(state.id)
    if now - w.last_beat >= HEARTBEAT_SECS:
        w.last_beat = now
        log_run(WATCH_UNIT, *heartbeat(poll, w.names.get(state.id), live.quiet(), vesktop, live.streaming()))

    if not state.reachable:
        publish(w, "unknown", "tailscaled does not answer", None, "unknown", now)
        return FALLBACK_SECS

    w.looked_silent = live.silent()
    prefs = ports.tailscaled.prefs()
    publish(w, *vpn_state(prefs, poll, w.looked_silent), node, mode(prefs), now)
    record_silence(w, live)

    if not state.id or now < w.backoff_until:
        return wait_until_due(w, now, live.streaming(), state)

    if state.online is False:
        recover(w, "offline", ports)
        return FALLBACK_SECS

    if vesktop and (state.id != w.verified_id or now - w.last_check >= RECHECK_SECS):
        w.last_check = now
        begin_move(w, None)

        def stop() -> Stop | None:
            return interrupted(w, ports)

        result = check_confirmed(live, ports, stop)
        if result == "clean":
            w.verified_id = state.id
        elif stop() is not None or exit_state(ports.tailscaled.peerless()).id != state.id:
            return 1.0  # the verdict is about a node no longer in use, or a request waits; look again after it
        elif result == "blocked" or not traffic_proof(node, live, ports, stop):
            if stop() is not None:
                return 1.0
            recover(w, "blocked" if result == "blocked" else "offline", ports)
            return FALLBACK_SECS
        else:
            print("Discord did not answer but the node carries traffic; not a node problem, staying")

    return wait_until_due(w, now, live.streaming(), state)


def checked(w: Watch, node: Node, now: float) -> None:
    """Remember the node a recovery checked clean."""
    w.verified_id, w.last_check = node.id, now


def record_silence(w: Watch, live: Liveness) -> None:
    """Record each time the exit node goes silent: printed when it starts, and
    one node-log line when it ends, saying how long it lasted up to the last
    engine update that found it silent."""
    since = live.unanswered_since if live.silent() else None
    if since is not None and w.silence is None:
        seen = live.samples[-1].at
        w.silence = Silence(w.names.get(live.exit_id), since, seen)
        print(f"{w.silence.node or 'the exit node'} stopped answering: nothing came back for {seen - since:.0f} s")
    elif since is not None and w.silence is not None:
        w.silence = replace(w.silence, seen=live.samples[-1].at)
    elif w.silence is not None:
        ended, w.silence = w.silence, None
        secs = round(ended.seen - ended.since)
        reason = f"{ended.node or 'the exit node'} answered nothing for at least {secs} s"
        print(reason)
        log_node("ok", "silent", "watch", ended.node, reason=reason, secs=secs)


def publish(w: Watch, state: State, reason: str, node: Node | None, how: str, now: float) -> None:
    """Write what the dot shows to STATE_FILE, when it changed. `since` moves
    only when the state does."""
    shown = {
        "state": state,
        "reason": reason,
        "mode": how,
        "node": node.name if node else None,
        "city": node.city if node else None,
        "country": node.country if node else None,
    }
    if shown == w.shown:
        return
    if state != w.shown.get("state"):
        w.shown_since = now
    w.shown = shown
    since = datetime.fromtimestamp(w.shown_since).astimezone().isoformat(timespec="seconds")
    partial = STATE_FILE.with_suffix(".partial")
    partial.write_text(json.dumps(shown | {"since": since}) + "\n")
    partial.replace(STATE_FILE)


def wait_until_due(w: Watch, now: float, streaming: bool, state: ExitState) -> float:
    due = [w.last_beat + HEARTBEAT_SECS - now]
    if not streaming:
        due.append(FALLBACK_SECS)
    if state.id:
        due.append(LOOK_SECS)
    return max(1.0, min(due))


# --------------------------------------------------------------------------
# the real ports: tailscaled's LocalAPI, the internet, the wall clock
# --------------------------------------------------------------------------


class LocalAPIConnection(http.client.HTTPConnection):
    """HTTP to tailscaled's LocalAPI over its unix socket."""

    def __init__(self, timeout: float | None):
        super().__init__("local-tailscaled.sock", timeout=timeout)

    def connect(self) -> None:
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(SOCKET)


def local_api(path: str) -> dict | None:
    """A LocalAPI GET as JSON; None when tailscaled does not answer."""
    conn = LocalAPIConnection(LOCALAPI_TIMEOUT_SECS)
    try:
        conn.request("GET", f"/localapi/v0/{path}")
        resp = conn.getresponse()
        return json.loads(resp.read()) if resp.status == 200 else None
    except (OSError, http.client.HTTPException, json.JSONDecodeError):
        return None
    finally:
        conn.close()


def full_status() -> dict | None:
    return local_api("status")


def peerless_status() -> dict | None:
    return local_api("status?peers=false")


def tailscale_set(target: str) -> None:
    argv = ["tailscale", "set", f"--exit-node={target}"]
    if target:
        argv.append("--exit-node-allow-lan-access=true")
    proc = subprocess.run(argv, capture_output=True, text=True)
    if proc.returncode != 0:
        raise VpnError(f"tailscale set {target or '(none)'} failed: {proc.stderr.strip()}")


def bus_stream(mask: int) -> Generator[dict, None, None]:
    """The event bus as tailscaled streams it, one JSON message per line. A read
    that waits STALE_SECS raises TimeoutError."""
    conn = LocalAPIConnection(timeout=STALE_SECS)
    try:
        conn.request("GET", f"/localapi/v0/watch-ipn-bus?mask={mask}")
        resp = conn.getresponse()
        if resp.status != 200:
            raise http.client.HTTPException(f"tailscaled answered {resp.status}")
        while line := resp.readline():
            yield json.loads(line)
    finally:
        conn.close()


def follow_bus(bus: Callable[[int], Generator[dict, None, None]], mask: int, hand: Callable[[dict], None],
               sleep: Callable[[float], None] = time.sleep, now: Callable[[], float] = time.monotonic) -> None:
    """The bus reader, on a thread of its own. It hands over each message of the
    event bus, and does nothing else that could make tailscaled wait.

    A stream that carries no engine update for STALE_SECS is closed, and a
    closed stream is opened again every BUS_RETRY_SECS. Losing the bus and
    getting it back are each printed once.
    """
    failing = False
    while True:
        problem = "the stream closed"
        stream = None
        try:
            stream = bus(mask)
            last = now()
            for message in stream:
                if failing:
                    print("event bus connected again")
                    failing = False
                hand(message)
                if engine_update(message):
                    last = now()
                elif now() - last > STALE_SECS:
                    problem = f"no engine update for {STALE_SECS} s"
                    break
        except TimeoutError:
            problem = f"nothing for {STALE_SECS} s"
        except (OSError, http.client.HTTPException, ValueError) as e:
            problem = f"{type(e).__name__}: {e}"
        finally:
            if stream is not None:
                stream.close()
        if not failing:
            print(f"event bus lost ({problem}); opening it again every {BUS_RETRY_SECS} s")
            failing = True
        sleep(BUS_RETRY_SECS)


class IPv4HTTPSConnection(http.client.HTTPSConnection):
    """HTTPS over IPv4 only. am.i.mullvad.net reports the IPv4 egress address,
    and Cloudflare judges each address separately, so the Discord check has to
    leave through that same address to be a verdict about it."""

    def connect(self) -> None:
        ip = socket.getaddrinfo(self.host, self.port, socket.AF_INET, socket.SOCK_STREAM)[0][4][0]
        sock = socket.create_connection((str(ip), self.port), self.timeout)
        self.sock = ssl.create_default_context().wrap_socket(sock, server_hostname=self.host)


def https_get(host: str, path: str, timeout: float, user_agent: str = "") -> tuple[int, bytes]:
    """Status and body of a GET; status 0 when nothing answered."""
    conn = IPv4HTTPSConnection(host, timeout=timeout)
    try:
        conn.request("GET", path, headers={"User-Agent": user_agent} if user_agent else {})
        resp = conn.getresponse()
        return resp.status, resp.read()
    except (OSError, http.client.HTTPException):
        return 0, b""
    finally:
        conn.close()


def discord_check() -> Verdict:
    """One Discord check of the current egress."""
    code, _ = https_get(*CANARY, timeout=10, user_agent=CHROME_UA)
    return verdict(code)


def egress() -> dict:
    """What am.i.mullvad.net says about this machine's egress; empty when it did not answer."""
    code, body = https_get(*EGRESS, timeout=8)
    if code != 200:
        return {}
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        return {}


def send_probe(ip: str) -> None:
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        try:
            sock.sendto(b"\0", (ip, DISCARD_PORT))
        except OSError:
            pass


def connect_out(timeout: float) -> bool:
    """Whether a TCP connect to one of PROOF_TARGETS succeeds within `timeout`, all of them tried at once."""
    selector = selectors.DefaultSelector()
    socks = []
    try:
        for host in PROOF_TARGETS:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            socks.append(sock)
            sock.setblocking(False)
            if sock.connect_ex((host, PROOF_PORT)) in (0, errno.EINPROGRESS):
                selector.register(sock, selectors.EVENT_WRITE)
        deadline = time.monotonic() + timeout
        while selector.get_map():
            left = deadline - time.monotonic()
            if left <= 0:
                return False
            for key, _ in selector.select(left):
                sock = key.fileobj
                assert isinstance(sock, socket.socket)
                if sock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR) == 0:
                    return True
                selector.unregister(sock)
        return False
    finally:
        selector.close()
        for sock in socks:
            sock.close()


def real_ports(mask: int | None = None, arrivals: "queue.Queue[Arrival] | None" = None) -> Ports:
    """The real ports. With `mask`, a bus reader thread feeds the event bus under
    that mask to `Clock.wait`, as do whatever else puts into `arrivals`; without,
    waiting only passes time."""
    tailscaled = Tailscaled(status=full_status, peerless=peerless_status, prefs=lambda: local_api("prefs"),
                            set_exit_node=tailscale_set, bus=bus_stream)
    arrived: queue.Queue[Arrival] = arrivals if arrivals is not None else queue.Queue()
    if mask is not None:
        threading.Thread(target=follow_bus, args=(tailscaled.bus, mask, arrived.put), daemon=True).start()

    def wait(secs: float) -> Arrival:
        try:
            return arrived.get(timeout=max(secs, 0.0))
        except queue.Empty:
            return None

    return Ports(
        tailscaled=tailscaled,
        network=Network(probe=send_probe, connect=connect_out, discord=discord_check, egress=egress),
        clock=Clock(now=time.time, wait=wait),
        vesktop=vesktop_running,
    )


# --------------------------------------------------------------------------
# the request channel
# --------------------------------------------------------------------------
#
# A client writes one JSON line, {"request": "on"|"off"|"next"|"to", "place":
# "<place>"}, `place` only on `to`. The watcher answers with JSON lines:
# {"say": "<line>"} for each line of progress, then one {"ok": bool,
# "message": "<line>"}.


NOT_RUNNING = ("vpn-watch is not running, and only it changes the exit node. "
               "`systemctl --user start vpn-watch` starts it; `vpn-off` turns the VPN off without it.")


def listen(path: Path, hand: Callable[[Arrival], None]) -> socket.socket:
    """Serve requests on a unix socket at `path`, handing each to `hand` as a
    Request, and a client that hangs up as a Hangup. A socket another watcher
    still answers on is an error; one left behind by a watcher that died is
    replaced."""
    other = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        other.connect(str(path))
        raise VpnError(f"another vpn watch already takes requests on {path}, perhaps one started by hand; "
                       f"`systemctl --user status vpn-watch` shows whether it is the unit's watcher")
    except (FileNotFoundError, ConnectionRefusedError):
        pass
    finally:
        other.close()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.unlink(missing_ok=True)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(str(path))
    server.listen(8)
    threading.Thread(target=accept_requests, args=(server, hand), daemon=True).start()
    return server


def accept_requests(server: socket.socket, hand: Callable[[Arrival], None]) -> None:
    """Take each connection on a thread of its own, until the socket closes."""
    while True:
        try:
            conn, _ = server.accept()
        except OSError:
            return
        threading.Thread(target=take_request, args=(conn, hand), daemon=True).start()


def take_request(conn: socket.socket, hand: Callable[[Arrival], None]) -> None:
    """Read one connection's request and hand it over, then wait for the client
    to hang up. A request that does not parse gets its final line here."""
    conn.settimeout(REQUEST_READ_SECS)
    try:
        with conn.makefile("rb") as stream:
            request = parse_request(stream.readline(4096))
    except (OSError, ValueError) as e:
        reply(conn, {"ok": False, "message": f"not a request vpn understands: {e}"})
        close(conn)
        return
    conn.settimeout(None)
    gone = threading.Event()

    def say(line: str) -> None:
        reply(conn, {"say": line})

    def finish(ok: bool, message: str) -> None:
        reply(conn, {"ok": ok, "message": message})
        close(conn)

    hand(Request(request=request[0], place=request[1],
                 client=Client(say=say, finish=finish, connected=lambda: not gone.is_set())))
    try:
        while conn.recv(1024):
            pass
    except OSError:
        pass
    gone.set()
    hand(Hangup())


def parse_request(raw: bytes) -> tuple[Asked, str]:
    message = json.loads(raw)
    kind, place = message.get("request"), message.get("place", "")
    if kind not in get_args(Asked) or not isinstance(place, str) or (kind == "to") != bool(place):
        raise ValueError(raw.decode(errors="replace").strip())
    return kind, place


def reply(conn: socket.socket, message: dict) -> None:
    """Send one JSON line, unless the client is gone."""
    try:
        conn.sendall((json.dumps(message) + "\n").encode())
    except OSError:
        pass


def close(conn: socket.socket) -> None:
    """Close a connection, waking the thread that waits for its hang-up."""
    try:
        conn.shutdown(socket.SHUT_RDWR)
    except OSError:
        pass
    conn.close()


def ask(request: Asked, place: str = "", path: Path = REQUEST_SOCKET) -> None:
    """Send the watcher one request and print what it streams back. Raises
    VpnError with the final message when the request did not succeed.

    Ctrl-C closes the sending side, which cancels the request; the watcher's
    final line still arrives and is printed. A second Ctrl-C leaves at once.
    One press can arrive twice, from the terminal and forwarded by `uv run`,
    so a press within CTRL_C_ECHO_SECS of the first counts as the same."""
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        conn.connect(str(path))
    except (FileNotFoundError, ConnectionRefusedError):
        conn.close()
        raise VpnError(NOT_RUNNING) from None
    conn.sendall((json.dumps({"request": request} | ({"place": place} if place else {})) + "\n").encode())

    first: float | None = None

    def cancel(*_) -> None:
        nonlocal first
        if first is not None and time.monotonic() - first > CTRL_C_ECHO_SECS:
            raise SystemExit(130)
        first = first or time.monotonic()
        try:
            conn.shutdown(socket.SHUT_WR)
        except OSError:
            pass

    previous = signal.signal(signal.SIGINT, cancel)
    try:
        with conn, conn.makefile("r", encoding="utf-8") as lines:
            for text in lines:
                message = json.loads(text)
                if "say" in message:
                    print(message["say"], flush=True)
                    continue
                if not message["ok"]:
                    raise VpnError(message["message"])
                print(message["message"], flush=True)
                return
    finally:
        signal.signal(signal.SIGINT, previous)
    raise VpnError("vpn-watch hung up without an answer; `journalctl --user -u vpn-watch` says why")


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------


@app.command(name="on")
def on() -> None:
    """Turn on automatic mode, then run the traffic proof and the Discord check on Tailscale's pick.

    When the pick carries no traffic, or Cloudflare blocks it (confirmed after a
    second check), move off it as `vpn --help` describes. When that move pins
    nothing, or Ctrl-C stops it, the exit node goes back to what it was before
    the command. With tailscale stopped it changes nothing and fails.
    """
    ask("on")


@dataclass
class ToArgs:
    place: Annotated[str, tyro.conf.Positional, tyro.conf.arg(metavar="PLACE")]
    """A country ("Germany"), a city ("Berlin"), or a node ("de-fra-wg-202"). Case does not matter; `vpn list` shows what exists."""


@app.command(name="to")
def to(args: ToArgs) -> None:
    """Pin a node in a country or city, or one node by name.

    A move as `vpn --help` describes, through the place's cities in name order,
    each from the start of its cycle. When a country or city is named, the node
    already in use and offline nodes are skipped. When the move pins nothing, or
    Ctrl-C stops it, the exit node goes back to what it was before the command.
    """
    ask("to", args.place)


@app.command(name="next")
def next_() -> None:
    """Move to the next node, in the order `vpn --help` describes.

    For when a site blocks the node in use. With no exit node set, it starts at
    the first fallback country. When the move pins nothing, or Ctrl-C stops it,
    the exit node goes back to what it was before the command.
    """
    ask("next")


@app.command(name="off")
def off() -> None:
    """Drop the exit node: traffic leaves this machine directly."""
    ask("off")


@dataclass
class StatusArgs:
    json: bool = False
    """Print JSON instead of text."""


@app.command(name="status")
def status(args: StatusArgs) -> None:
    """Show the exit node, how it was chosen, the public IP, the Discord check's verdict, and whether the watcher runs.

    The public IP and the Discord check go over the network; the rest is read from tailscaled.

    JSON schema (--json):

        {"node": "str|null", "country": "str|null", "city": "str|null",
         "mode": "off|automatic|pinned|unknown", "online": bool|null,
         "egress": {"ip": "str", "country": "str", "city": "str", "node": "str|null"} | null,
         "discord": "clean|blocked|unreachable|null", "watcher": "str"}
    """
    ports = real_ports()
    reading = ports.tailscaled.status()
    node = current_node(reading)
    seen = ports.network.egress()
    through_mullvad = bool(seen.get("mullvad_exit_ip_hostname"))
    report = {
        "node": node.name if node else None,
        "country": node.country if node else None,
        "city": node.city if node else None,
        "mode": mode(ports.tailscaled.prefs()),
        "online": exit_state(reading).online,
        "egress": {
            "ip": seen.get("ip"),
            "country": seen.get("country"),
            "city": seen.get("city"),
            "node": seen.get("mullvad_exit_ip_hostname"),
        }
        if seen
        else None,
        "discord": ports.network.discord() if through_mullvad else None,
        "watcher": watcher_state(),
    }
    if args.json:
        print(json.dumps(report, indent=2))
        return

    if reading is None:
        print("exit node  unknown, tailscaled did not answer")
    elif node is None:
        print("exit node  none, traffic leaves this machine directly")
    else:
        offline = " · reporting itself offline" if report["online"] is False else ""
        print(f"exit node  {node.name} · {node.city}, {node.country} · {report['mode']}{offline}")
    if report["egress"]:
        e = report["egress"]
        print(f"egress     {e['ip']} · {e['city']}, {e['country']} · {e['node'] or 'not a Mullvad node'}")
    else:
        print("egress     unknown, am.i.mullvad.net did not answer")
    print(f"discord    {report['discord'] or 'not checked: egress is not through Mullvad'}")
    print(f"watcher    {report['watcher']}")


def watcher_state() -> str:
    proc = subprocess.run(["systemctl", "--user", "is-active", WATCH_UNIT], capture_output=True, text=True)
    return proc.stdout.strip() or "unknown"


@dataclass
class ListArgs:
    place: Annotated[str, tyro.conf.Positional, tyro.conf.arg(metavar="PLACE")] = ""
    """A country or a city: list its nodes instead of every country and city."""
    json: bool = False
    """Print JSON instead of text."""


@app.command(name="list")
def list_(args: ListArgs) -> None:
    """List countries and cities with their node counts, or the nodes of one country or city.

    JSON schema (--json), without a place:

        [{"country": "str", "city": "str", "nodes": int, "online": int}]

    with a place:

        [{"name": "str", "country": "str", "city": "str", "online": bool, "selected": bool}]
    """
    reading = real_ports().tailscaled.status()
    if reading is None:
        raise VpnError("tailscaled did not answer")
    nodes = mullvad_nodes(reading)
    if not args.place:
        rows = [
            {"country": ns[0].country, "city": ns[0].city, "nodes": len(ns), "online": sum(n.online for n in ns)}
            for ns in cities(nodes)
        ]
        if args.json:
            print(json.dumps(rows, indent=2))
            return
        for row in rows:
            print(f"{row['country']:18s} {row['city']:22s} {row['online']}/{row['nodes']} online")
        return

    matched = resolve(args.place, nodes)
    if not matched:
        raise VpnError(f'no country or city matches "{args.place}"')
    selected = exit_state(reading).id
    rows = [
        {"name": n.name, "country": n.country, "city": n.city, "online": n.online, "selected": n.id == selected}
        for n in matched
    ]
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    for row in rows:
        mark = "*" if row["selected"] else " "
        print(f"{mark} {row['name']:18s} {row['city']:22s} {'online' if row['online'] else 'offline'}")


@app.command(name="watch")
def watch() -> None:
    """Keep the exit node working: the long-running watcher, not a one-off check.

    tailscaled tells the watcher the moment the exit node changes or goes offline, over its event bus, and pushes every 2 seconds how many bytes went into each live peer's tunnel and came back out. The watcher reads the exit node's state from tailscaled's local socket, which sends nothing over the network. It reads the full status, every peer included, only when it starts, when the exit node changes, and when a peer it does not know shows up. While an exit node is set it also looks every 10 seconds. With no engine update for 10 seconds, it counts the stream as closed. It opens it again every 5 seconds, and looks every 15 until the stream is back.

    `vpn on`, `to`, `next` and `off` send it their request over $XDG_RUNTIME_DIR/vpn.sock and print the lines it streams back. It serves one request at a time: a newer request, the client going away (Ctrl-C) or a change of exit node made outside vpn stops the move a request is running, before its next step. A newer request or a client going away puts the exit node back as it was before the request; an outside change is left in place. The watcher's own moves stop the same way.

    - No exit node set: it only records changes.
    - The exit node reports itself offline: it moves off it, as `vpn --help` describes, with the Discord check only while Vesktop runs.
    - While Vesktop runs: it runs the Discord check on every new node and every 10 minutes. When a 403 persists past the confirmation wait, or the check gets no answer and the node fails the traffic proof, it moves off the node.
    - The exit node goes silent (traffic went into its tunnel 20 s ago and nothing has come back since): it records how long that lasted as one line in ~/logs/runs/vpn.jsonl, and moves nothing. A gap between engine updates longer than 20 s, a suspend for one, starts the count over, and while the stream is closed no node counts as silent.

    After a move of its own that pinned nothing, it starts no other for 5 minutes. It records every exit-node change it did not make itself, once, and writes an hourly heartbeat, which fails when an exit node is set and no engine update has come for 60 seconds.

    It publishes the state for the top-bar dot to $XDG_RUNTIME_DIR/vpn-state.json whenever it changes:

        {"state": "up|down|off|unknown", "reason": "str", "mode": "off|automatic|pinned|unknown",
         "node": "str|null", "city": "str|null", "country": "str|null", "since": "ISO 8601"}

    off: no exit node set, or tailscale stopped. down: an exit node is set, and tailscale is not running, or the node is missing from its status, reports itself offline, or is silent. unknown: tailscaled does not answer. Nothing is published while a move runs.
    """
    arrivals: queue.Queue[Arrival] = queue.Queue()
    ports = real_ports(WATCH_MASK, arrivals)
    server = listen(REQUEST_SOCKET, arrivals.put)
    w = Watch(live=Liveness(ports.clock))
    due = 0.0
    try:
        while True:
            due = handle(w, ports.clock.wait(due), ports)
    finally:
        server.close()
        REQUEST_SOCKET.unlink(missing_ok=True)


if __name__ == "__main__":
    try:
        app.cli(prog="vpn", description=__doc__, config=(tyro.conf.OmitArgPrefixes,))
    except VpnError as e:
        sys.exit(f"vpn: {e}")
