#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Control the Mullvad exit node: pick one, pin one, move off one, drop it, and keep it working.

Tailscale's automatic mode (auto:any) ranks exit nodes by latency and nothing else. Two failures stay invisible to it:

- Cloudflare scores each egress IP on its own and hard-blocks some Mullvad IPs for Chrome-family clients (every Electron app: Vesktop, ...), while a browser on the same IP passes. The app shows "Temporary Network Error" and Tailscale sees nothing wrong.
- A pinned node has no failover of its own: when it dies, all egress dies with it.

Every command that moves the exit node checks the node against Discord's API with a Chrome user agent before keeping it, and `vpn watch` keeps checking. A site that blocks one node for its own reasons (YouTube does, for some Mullvad IPs) is not checked for: `vpn next` is the way off such a node.

Where `vpn next` and the watcher's recovery go: the nodes after the current one in its city, by name and wrapping around, then the rest of its country, then Germany, Austria, Switzerland and the Netherlands. Nodes reporting themselves offline are skipped. A recovery keeps the exit node pinned; `vpn on` returns to automatic mode.

Every change a vpn command makes, and every change the watcher sees anything else make, is one line in ~/logs/runs/vpn.jsonl (bin/run-log). The watcher also writes an hourly heartbeat to ~/logs/runs/vpn-watch.jsonl.

The zsh alias `vpn-off` (`tailscale set --exit-node=`) needs neither uv nor DNS, which makes it the way out when the tunnel, DNS and the uv cache are all gone.

Needs the tailscale operator grant (no sudo).

Examples:

    vpn status
    vpn list
    vpn list Germany
    vpn to Berlin
    vpn to de-fra-wg-202
    vpn next
    vpn on
    vpn off
"""

import fcntl
import http.client
import json
import os
import queue
import socket
import ssl
import subprocess
import sys
import threading
import time
from collections.abc import Iterator
from contextlib import contextmanager
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Annotated, Literal

import tyro
from tyro.extras import SubcommandApp

app = SubcommandApp()

CHROME_UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
)
CANARY = ("discord.com", "/api/v9/gateway")
"""Unauthenticated and tiny; the API is what Cloudflare blocks for the app."""
EGRESS = ("am.i.mullvad.net", "/json")

FALLBACK_COUNTRIES = ("Germany", "Austria", "Switzerland", "Netherlands")
MAX_TRIES = 8
"""Nodes a single pick tries before it gives up."""
CONFIRM_SECS = 45
"""Wait before the second check that confirms a 403.

A real IP block persists and a transient challenge clears. Every rotation is an
IP change Discord's session heuristics get to see, and rapid IP hopping is what
triggers its re-login prompts.
"""
RECHECK_SECS = 600
"""How often the watcher re-checks an unchanged node while Vesktop runs; catches a reputation flipping in place."""
FALLBACK_SECS = 15
"""Longest the watcher goes without looking while it cannot rely on the event bus:
the bus is down, or Vesktop is closed on a node nobody has checked, and Vesktop
opening sends nothing on the bus."""
HEARTBEAT_SECS = 3600
BACKOFF_SECS = 300
"""Pause after a recovery that found no usable node."""
SETTLE_SECS = 20
"""How long a switch may take before egress goes through the new node."""
LOCK_WAIT_SECS = 90
BUS_DEBOUNCE_SECS = 1.0
"""A switch arrives as a burst of bus messages; one look after the burst is enough."""
BUS_RETRY_SECS = 5
EXPLAIN_SECS = 120
"""How recent a vpn line must be to account for an exit-node change the watcher sees."""

SOCKET = "/var/run/tailscale/tailscaled.sock"
BUS_MASK = 1 << 15
"""NotifyPeerPatches: per-peer Online changes, and (implied) peers added and removed.
Preference changes, the exit node among them, arrive whatever the mask."""

LOCKFILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "vpn.lock"
VESKTOP_LOCK = Path.home() / ".config/vesktop/SingletonLock"
"""Electron's single-instance marker: a symlink to "<hostname>-<pid>" for as long as an instance is up."""

NODE_UNIT = "vpn"
WATCH_UNIT = "vpn-watch"
RUN_LOG = Path(__file__).resolve().parent / "run-log"
"""Reached relative to this script, not through PATH: the systemd unit pins its own PATH and it does not carry ~/bin."""

Verdict = Literal["clean", "blocked", "unreachable"]
Cause = Literal["blocked", "offline"]


class VpnError(Exception):
    pass


# --------------------------------------------------------------------------
# reading tailscale's state
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Node:
    id: str
    """Stable node ID, the one ExitNodeStatus and the prefs name."""
    name: str
    """Short name, e.g. de-fra-wg-202."""
    country: str
    city: str
    online: bool

    @property
    def fqdn(self) -> str:
        return f"{self.name}.mullvad.ts.net"


@dataclass(frozen=True)
class ExitState:
    reachable: bool
    """Whether tailscaled answered at all."""
    id: str
    """The exit node's stable ID; empty when none is set."""
    online: bool | None


def mullvad_nodes(status: dict) -> list[Node]:
    """Every Mullvad exit node in a full status, sorted by country, city and name."""
    nodes = []
    for peer in (status.get("Peer") or {}).values():
        dns = peer.get("DNSName") or ""
        if not (peer.get("ExitNodeOption") and dns.endswith(".mullvad.ts.net.")):
            continue
        location = peer.get("Location") or {}
        nodes.append(
            Node(
                id=peer["ID"],
                name=dns.split(".")[0],
                country=location.get("Country", ""),
                city=location.get("City", ""),
                online=bool(peer.get("Online")),
            )
        )
    return sorted(nodes, key=lambda n: (n.country, n.city, n.name))


def exit_state(status: dict | None) -> ExitState:
    """The exit node as a status reading names it, with or without peers in it."""
    if status is None:
        return ExitState(reachable=False, id="", online=None)
    node = status.get("ExitNodeStatus") or {}
    return ExitState(reachable=True, id=node.get("ID") or "", online=node.get("Online"))


def exit_peer(status: dict) -> dict | None:
    """The peer a full status marks as the exit node in use."""
    return next((p for p in (status.get("Peer") or {}).values() if p.get("ExitNode")), None)


def mode(prefs: dict | None) -> Literal["off", "automatic", "pinned", "unknown"]:
    """How the exit node is chosen. AutoExitNode is omitted from prefs unless set."""
    if prefs is None:
        return "unknown"
    if prefs.get("AutoExitNode"):
        return "automatic"
    if prefs.get("ExitNodeID") or prefs.get("ExitNodeIP"):
        return "pinned"
    return "off"


def resolve(place: str, nodes: list[Node]) -> list[Node]:
    """The nodes a place names, tried in this order: a node by short or full
    name, a country, a city. Case does not matter, and a US city matches with or
    without its state ("Ashburn" or "Ashburn, VA")."""
    want = place.strip().lower().removesuffix(".")
    matchers = (
        lambda n: want in (n.name, n.fqdn),
        lambda n: n.country.lower() == want,
        lambda n: want in (n.city.lower(), n.city.lower().split(",")[0]),
    )
    for matches in matchers:
        found = [n for n in nodes if matches(n)]
        if found:
            return found
    return []


def candidates(current: Node | None, nodes: list[Node]) -> list[Node]:
    """Where to go from `current`, best first.

    The rest of its city, starting after it by name and wrapping around, so
    repeated moves walk the whole city instead of bouncing between two nodes.
    Then the rest of its country, then FALLBACK_COUNTRIES. The current node and
    nodes reporting themselves offline are left out.
    """
    order: list[Node] = []
    if current is not None:
        city = [n for n in nodes if (n.country, n.city) == (current.country, current.city)]
        after = next((i for i, n in enumerate(city) if n.name > current.name), len(city))
        order += city[after:] + city[:after]
        order += [n for n in nodes if n.country == current.country and n.city != current.city]
    for country in FALLBACK_COUNTRIES:
        order += [n for n in nodes if n.country == country]

    seen: set[str] = set()
    picked = []
    for node in order:
        if node.name in seen or not node.online or (current and node.id == current.id):
            continue
        seen.add(node.name)
        picked.append(node)
    return picked


def verdict(code: int) -> Verdict:
    """What the Discord check's HTTP status says about the node.

    Any 403 is a block: the endpoint is unauthenticated and its only legitimate
    answer is 200, and a Cloudflare block on this route arrives as Discord-styled
    JSON (code 40333), so the body cannot tell a block from a real Discord error.
    No answer at all, or a 5xx, says nothing about the node.
    """
    if code == 403:
        return "blocked"
    if code == 0 or code >= 500:
        return "unreachable"
    return "clean"


def vesktop_running(lock: Path = VESKTOP_LOCK) -> bool:
    """Whether a Vesktop instance is up: the lock names a pid, and a lock an
    unclean exit left behind names one that is gone."""
    try:
        pid = os.readlink(lock).rsplit("-", 1)[-1]
    except OSError:
        return False
    return pid.isdigit() and Path(f"/proc/{pid}").is_dir()


def heartbeat(poll: dict | None, full: dict | None, vesktop: bool, bus: bool) -> tuple[str, str, dict]:
    """The watcher's hourly line: outcome, reason, stats.

    Always ok, because a machine with the VPN off or tailscaled down is not a
    watcher that stopped watching, and this line answers only that question. The
    one exception is the failure the watcher could otherwise not see: its looks
    read ExitNodeStatus from a status without peers. Were a tailscale release to
    stop filling that field there, every look would read a live exit node as
    none, a pinned node would sit with no failover, and the heartbeat would go
    on saying ok. The peer list is the independent witness: a peer acting as
    exit node while ExitNodeStatus is empty means the looks are blind, and
    `fail` puts that in front of overdue-check.
    """
    if poll is None:
        return "ok", "", {"state": "tailscale-down", "exit_node": None, "vesktop": vesktop, "bus": bus}
    peer = exit_peer(full or {})
    if not exit_state(poll).id:
        if peer is not None:
            return "fail", "a peer is acting as exit node but ExitNodeStatus was empty — the watcher is blind to it", {}
        return "ok", "", {"state": "no-exit-node", "exit_node": None, "vesktop": vesktop, "bus": bus}
    name = peer.get("HostName") if peer else None
    return "ok", "", {"state": "guarding", "exit_node": name, "vesktop": vesktop, "bus": bus}


ANYWHERE = "*"


def landed(stats: dict) -> str | None:
    """The node a vpn line left the exit node on: a name, None for no exit node,
    or ANYWHERE when it left the exit node wherever automatic mode or a restore put it."""
    event = stats.get("event")
    if event in ("changed", "pinned", "rotated", "offline"):
        return stats.get("rotated_to")
    if event in ("clean", "canary-unreachable"):
        return stats.get("node")
    if event == "off":
        return None
    return ANYWHERE


def explains(record: dict | None, node: str | None, now: float) -> bool:
    """Whether a vpn line accounts for the exit node now being `node`: it is
    recent, and it left the exit node there."""
    if not record:
        return False
    try:
        age = now - datetime.fromisoformat(record["ts"]).timestamp()
    except (KeyError, TypeError, ValueError):
        return False
    if age > EXPLAIN_SECS:
        return False
    where = landed(record.get("stats") or {})
    return where == ANYWHERE or where == node


# --------------------------------------------------------------------------
# talking to tailscaled and the internet
# --------------------------------------------------------------------------


class LocalAPIConnection(http.client.HTTPConnection):
    """HTTP to tailscaled's LocalAPI over its unix socket."""

    def __init__(self, timeout: float | None):
        super().__init__("local-tailscaled.sock", timeout=timeout)

    def connect(self) -> None:
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(SOCKET)


def local_api(path: str, timeout: float = 10) -> dict | None:
    """A LocalAPI GET as JSON; None when tailscaled does not answer."""
    conn = LocalAPIConnection(timeout)
    try:
        conn.request("GET", f"/localapi/v0/{path}")
        resp = conn.getresponse()
        return json.loads(resp.read()) if resp.status == 200 else None
    except (OSError, http.client.HTTPException, json.JSONDecodeError):
        return None
    finally:
        conn.close()


def full_status() -> dict | None:
    return local_api("status")


def peerless_status() -> dict | None:
    """Status without the peer list, which is nearly all of the full reading's size."""
    return local_api("status?peers=false")


class IPv4HTTPSConnection(http.client.HTTPSConnection):
    """HTTPS over IPv4 only. am.i.mullvad.net reports the IPv4 egress address,
    and Cloudflare judges each address separately, so the Discord check has to
    leave through that same address to be a verdict about it."""

    def connect(self) -> None:
        ip = socket.getaddrinfo(self.host, self.port, socket.AF_INET, socket.SOCK_STREAM)[0][4][0]
        sock = socket.create_connection((str(ip), self.port), self.timeout)
        self.sock = ssl.create_default_context().wrap_socket(sock, server_hostname=self.host)


def https_get(host: str, path: str, timeout: float, user_agent: str = "") -> tuple[int, bytes]:
    """Status and body of a GET; status 0 when nothing answered."""
    conn = IPv4HTTPSConnection(host, timeout=timeout)
    try:
        conn.request("GET", path, headers={"User-Agent": user_agent} if user_agent else {})
        resp = conn.getresponse()
        return resp.status, resp.read()
    except (OSError, http.client.HTTPException):
        return 0, b""
    finally:
        conn.close()


def check() -> Verdict:
    """One Discord check of the current egress."""
    code, _ = https_get(*CANARY, timeout=10, user_agent=CHROME_UA)
    return verdict(code)


def check_confirmed() -> Verdict:
    """A Discord check whose 403 is confirmed after CONFIRM_SECS."""
    first = check()
    if first != "blocked":
        return first
    time.sleep(CONFIRM_SECS)
    return check()


def egress() -> dict:
    """What am.i.mullvad.net says about this machine's egress; empty when it did not answer."""
    code, body = https_get(*EGRESS, timeout=8)
    if code != 200:
        return {}
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        return {}


def egress_node() -> str:
    """The Mullvad node egress goes through; empty when it goes through none, or nothing answered."""
    return egress().get("mullvad_exit_ip_hostname") or ""


def settle(want: str | None) -> bool:
    """Wait until egress goes through the node named `want`, or through any Mullvad node when None."""
    deadline = time.monotonic() + SETTLE_SECS
    while True:
        got = egress_node()
        if got and (want is None or got == want):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(1)


def set_exit_node(target: str) -> None:
    """`target`: a node's full name, "auto:any", or "" for no exit node."""
    argv = ["tailscale", "set", f"--exit-node={target}"]
    if target:
        argv.append("--exit-node-allow-lan-access=true")
    proc = subprocess.run(argv, capture_output=True, text=True)
    if proc.returncode != 0:
        raise VpnError(f"tailscale set {target or '(none)'} failed: {proc.stderr.strip()}")


@contextmanager
def node_lock(wait: float = LOCK_WAIT_SECS) -> Iterator[None]:
    """Held while the exit node is being changed, so a command and the watcher never change it at the same time."""
    LOCKFILE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCKFILE, "a") as f:
        deadline = time.monotonic() + wait
        while True:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise VpnError("another vpn command is still changing the exit node") from None
                time.sleep(0.5)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def run_log_dir() -> Path:
    return Path(os.environ.get("RUN_LOG_DIR", Path.home() / "logs/runs"))


def log_run(unit: str, outcome: str, reason: str = "", stats: dict | None = None) -> None:
    """Record one outcome via bin/run-log. Recording a run never decides whether it succeeded."""
    argv = [str(RUN_LOG), unit, outcome]
    if reason:
        argv += ["--reason", reason]
    if stats is not None:
        argv += ["--stats", json.dumps(stats)]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True)
    except OSError as e:
        print(f"vpn: could not write the run log for {unit}: {e}", file=sys.stderr)
        return
    if proc.returncode != 0:
        print(f"vpn: could not write the run log for {unit}: {proc.stderr.strip()}", file=sys.stderr)


def log_node(
    outcome: str,
    event: str,
    command: str,
    node: str | None = None,
    to: str | None = None,
    tried: int = 0,
    reason: str = "",
) -> None:
    """One line about the exit node, in the shape the dns/vpn dashboard reads.
    `node` is the node the line is about, `to` the node it moved to."""
    stats = {"event": event, "command": command, "node": node, "rotated_to": to, "tried": tried}
    log_run(NODE_UNIT, outcome, reason, stats)


def last_node_record() -> dict | None:
    """The newest readable line of the node log."""
    try:
        lines = (run_log_dir() / f"{NODE_UNIT}.jsonl").read_text().splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            return json.loads(line)
        except json.JSONDecodeError:
            continue
    return None


# --------------------------------------------------------------------------
# moving the exit node
# --------------------------------------------------------------------------


def current_node(status: dict | None) -> Node | None:
    """The Mullvad node a full status names as exit node."""
    if status is None:
        return None
    node_id = exit_state(status).id
    return next((n for n in mullvad_nodes(status) if n.id == node_id), None)


def walk(options: list[Node]) -> tuple[Node | None, int]:
    """Pin the first of `options` that carries traffic and that Cloudflare does not block.

    Returns the node pinned (None when none was) and how many were tried. A
    Discord check that got no answer says nothing about the node, so a node that
    carries traffic is kept then.
    """
    tried = 0
    for node in options[:MAX_TRIES]:
        tried += 1
        set_exit_node(node.fqdn)
        if not settle(node.name):
            print(f"  {node.name}: no traffic through it, skipping")
            continue
        result = check()
        if result == "blocked":
            print(f"  {node.name}: Cloudflare blocks it too")
            continue
        if result == "unreachable":
            print(f"  {node.name}: Discord did not answer, keeping the node without the check")
        return node, tried
    return None, tried


def restore(prefs: dict | None, nodes: list[Node]) -> None:
    """Put the exit node back the way `prefs` had it. A pinned node outside
    Mullvad cannot be named back, and gets automatic mode instead."""
    how = mode(prefs)
    if how == "off":
        set_exit_node("")
        return
    pinned = next((n for n in nodes if how == "pinned" and n.id == (prefs or {}).get("ExitNodeID")), None)
    set_exit_node(pinned.fqdn if pinned else "auto:any")


def move(options: list[Node], command: str, start: Node | None, nodes: list[Node]) -> Node:
    """Pin the first usable node of `options`, or put the exit node back and fail."""
    if not options:
        raise VpnError("no online node to move to")
    prefs = local_api("prefs")
    node, tried = walk(options)
    if node is None:
        restore(prefs, nodes)
        reason = f"none of the {tried} nodes tried carried traffic past Cloudflare; the exit node was put back"
        log_node("fail", "exhausted", command, start.name if start else None, None, tried, reason)
        raise VpnError(reason)
    log_node("ok", "pinned", command, start.name if start else None, node.name, tried)
    print(f"pinned: {node.name} ({node.city}, {node.country})")
    return node


def recover(cause: Cause) -> Node | None:
    """Move the exit node off a node that is blocked or stopped carrying traffic.

    Stays pinned: the walk starts next to the node being left, the way
    `vpn next` does. Only when no node works does it fall back to automatic
    mode, which beats a dead pinned node.
    """
    try:
        with node_lock():
            status = full_status()
            start = current_node(status)
            if start is None:
                return None
            print(f"moving off {start.name}: {'Cloudflare blocks it' if cause == 'blocked' else 'it stopped carrying traffic'}")
            node, tried = walk(candidates(start, mullvad_nodes(status or {})))
            event = "rotated" if cause == "blocked" else "offline"
            if node is not None:
                log_node("ok", event, "watch", start.name, node.name, tried)
                print(f"pinned: {node.name}")
                return node
            set_exit_node("auto:any")
            reason = f"left {start.name} ({cause}) and none of {tried} nodes tried worked; back on automatic mode"
            log_node("fail", "exhausted", "watch", start.name, None, tried, reason)
            print(reason)
    except VpnError as e:
        print(f"recovery failed: {e}")
    time.sleep(BACKOFF_SECS)
    return None


# --------------------------------------------------------------------------
# the watcher
# --------------------------------------------------------------------------


@dataclass
class Watch:
    """What the watcher remembers between looks."""

    node_id: str | None = None
    """The exit node at the last look; None before the first."""
    node_name: str | None = None
    verified_id: str = ""
    """The node the Discord check last passed."""
    last_check: float = 0.0
    last_beat: float = float("-inf")


def lock_busy() -> bool:
    """Whether a vpn command holds the node lock right now."""
    LOCKFILE.parent.mkdir(parents=True, exist_ok=True)
    with open(LOCKFILE, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(f, fcntl.LOCK_UN)
        return False


def look(w: Watch, now: float, bus_up: bool) -> float:
    """One look at the exit node, acting on what it finds. Returns the seconds
    until the next look is due; a bus message brings it forward."""
    poll = peerless_status()
    vesktop = vesktop_running()
    if now - w.last_beat >= HEARTBEAT_SECS:
        w.last_beat = now
        outcome, reason, stats = heartbeat(poll, full_status() if poll is not None else None, vesktop, bus_up)
        log_run(WATCH_UNIT, outcome, reason, stats)

    state = exit_state(poll)
    if not state.reachable:
        return FALLBACK_SECS

    if state.id != w.node_id:
        if lock_busy():
            return 1.0  # a vpn command is mid-change and will record it; look once it is done
        node = current_node(full_status()) if state.id else None
        name = node.name if node else None
        if w.node_id is not None and not explains(last_node_record(), name, time.time()):
            print(f"exit node changed outside vpn: {w.node_name or 'none'} → {name or 'none'}")
            log_node("ok", "changed", "watch", w.node_name, name)
        w.node_id, w.node_name = state.id, name

    if not state.id:
        return wait_until_due(w, now, vesktop, bus_up, state)

    if state.online is False:
        moved = recover("offline")
        if moved is not None:
            w.verified_id, w.last_check = moved.id, time.time()
        return 0.0

    if vesktop and (state.id != w.verified_id or now - w.last_check >= RECHECK_SECS):
        w.last_check = now
        result = check_confirmed()
        if result == "clean":
            w.verified_id = state.id
        elif result == "blocked" or not egress_node():
            moved = recover("blocked" if result == "blocked" else "offline")
            if moved is not None:
                w.verified_id, w.last_check = moved.id, time.time()
            return 0.0
        else:
            print("Discord did not answer but egress is fine — not a node problem, staying")

    return wait_until_due(w, now, vesktop, bus_up, state)


def wait_until_due(w: Watch, now: float, vesktop: bool, bus_up: bool, state: ExitState) -> float:
    due = [w.last_beat + HEARTBEAT_SECS - now]
    if not bus_up:
        due.append(FALLBACK_SECS)
    if state.id and vesktop:
        due.append(w.last_check + RECHECK_SECS - now)
    elif state.id and state.id != w.verified_id:
        due.append(FALLBACK_SECS)
    return max(1.0, min(due))


def follow_bus(events: queue.Queue) -> None:
    """Put "up", one "message" per tailscaled bus message, and "down" into
    `events`, reconnecting whenever the stream closes (tailscaled restarting).
    "down" is sent once per lost connection, not on every failed reconnect."""
    while True:
        conn = LocalAPIConnection(timeout=None)
        connected = False
        try:
            conn.request("GET", f"/localapi/v0/watch-ipn-bus?mask={BUS_MASK}")
            resp = conn.getresponse()
            if resp.status == 200:
                connected = True
                events.put("up")
                while resp.readline():
                    events.put("message")
        except (OSError, http.client.HTTPException):
            pass
        finally:
            conn.close()
        if connected:
            events.put("down")
        time.sleep(BUS_RETRY_SECS)


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------


@app.command(name="on")
def on() -> None:
    """Turn on automatic mode, then run the Discord check.

    When Cloudflare blocks the node Tailscale picked (confirmed after a second
    check), walk the nodes next to it and pin the first clean one.
    """
    with node_lock():
        set_exit_node("auto:any")
        if not settle(None):
            reason = "egress never reached Mullvad — tailscale down, or a captive portal"
            log_node("fail", "unreachable", "on", reason=reason)
            raise VpnError(f"{reason} (portal: run `portal`)")
        picked = egress_node()
        result = check_confirmed()
        if result == "clean":
            log_node("ok", "clean", "on", picked)
            print(f"exit node: {picked} (automatic, Discord check clean)")
            return
        if result == "unreachable":
            reason = f"the Discord check got no answer through {picked} — network trouble, not a blocked node"
            log_node("skip", "canary-unreachable", "on", picked, reason=reason)
            raise VpnError(reason)

        print(f"Tailscale picked {picked} and Cloudflare blocks it — trying nodes next to it")
        status = full_status() or {}
        nodes = mullvad_nodes(status)
        start = next((n for n in nodes if n.name == picked), None)
        node, tried = walk(candidates(start, nodes))
        if node is None:
            set_exit_node("auto:any")
            reason = f"Cloudflare blocks {picked} and every one of {tried} nodes tried; left on automatic mode, so Discord and other Electron apps stay broken"
            log_node("fail", "exhausted", "on", picked, None, tried, reason)
            raise VpnError(reason)
        log_node("ok", "rotated", "on", picked, node.name, tried)
        print(f"pinned: {node.name} (automatic mode off — the watcher is the failover; `vpn on` to return)")


@app.command(name="to")
def to(place: Annotated[str, tyro.conf.Positional]) -> None:
    """Pin a node in a country or city, or one node by name.

    Tries the place's nodes in name order and keeps the first that carries
    traffic and passes the Discord check. When a country or city is named, the
    node already in use is skipped. When none works, the exit node goes back to
    how it was.

    Args:
        place: A country ("Germany"), a city ("Berlin"), or a node ("de-fra-wg-202"). Case does not matter; `vpn list` shows what exists.
    """
    with node_lock():
        status = full_status()
        if status is None:
            raise VpnError("tailscaled did not answer")
        nodes = mullvad_nodes(status)
        matched = resolve(place, nodes)
        if not matched:
            raise VpnError(f'no exit node matches "{place}" — see `vpn list`')
        start = current_node(status)
        one_node = len(matched) == 1 and place.strip().lower().removesuffix(".") in (matched[0].name, matched[0].fqdn)
        options = matched if one_node else [n for n in matched if n.online and (start is None or n.id != start.id)]
        move(options, "to", start, nodes)


@app.command(name="next")
def next_() -> None:
    """Move to the next node: the rest of this city, then this country, then Germany, Austria, Switzerland, the Netherlands.

    For when a site blocks the node in use. Keeps the first node that carries
    traffic and passes the Discord check; when none works, the exit node goes
    back to how it was.
    """
    with node_lock():
        status = full_status()
        if status is None:
            raise VpnError("tailscaled did not answer")
        start = current_node(status)
        nodes = mullvad_nodes(status)
        move(candidates(start, nodes), "next", start, nodes)


@app.command(name="off")
def off() -> None:
    """Drop the exit node: traffic leaves this machine directly.

    Needs uv and a warm cache like every vpn command; the zsh alias `vpn-off`
    does the same with tailscale alone.
    """
    with node_lock():
        start = current_node(full_status())
        set_exit_node("")
        log_node("ok", "off", "off", start.name if start else None)
        print("exit node off")


@dataclass
class StatusArgs:
    json: bool = False
    """Print JSON instead of text."""


@app.command(name="status")
def status(args: StatusArgs) -> None:
    """Show the exit node, how it was chosen, the public IP, the Discord check's verdict, and whether the watcher runs.

    The public IP and the Discord check go over the network; the rest is read from tailscaled.

    JSON schema (--json):

        {"node": "str|null", "country": "str|null", "city": "str|null",
         "mode": "off|automatic|pinned|unknown", "online": bool|null,
         "egress": {"ip": "str", "country": "str", "city": "str", "node": "str|null"} | null,
         "discord": "clean|blocked|unreachable|null", "watcher": "str"}
    """
    reading = full_status()
    node = current_node(reading)
    seen = egress()
    through_mullvad = bool(seen.get("mullvad_exit_ip_hostname"))
    report = {
        "node": node.name if node else None,
        "country": node.country if node else None,
        "city": node.city if node else None,
        "mode": mode(local_api("prefs")),
        "online": exit_state(reading).online,
        "egress": {
            "ip": seen.get("ip"),
            "country": seen.get("country"),
            "city": seen.get("city"),
            "node": seen.get("mullvad_exit_ip_hostname"),
        }
        if seen
        else None,
        "discord": check() if through_mullvad else None,
        "watcher": watcher_state(),
    }
    if args.json:
        print(json.dumps(report, indent=2))
        return

    if reading is None:
        print("exit node  unknown — tailscaled did not answer")
    elif node is None:
        print("exit node  none — traffic leaves this machine directly")
    else:
        offline = " · reporting itself offline" if report["online"] is False else ""
        print(f"exit node  {node.name} · {node.city}, {node.country} · {report['mode']}{offline}")
    if report["egress"]:
        e = report["egress"]
        print(f"egress     {e['ip']} · {e['city']}, {e['country']} · {e['node'] or 'not a Mullvad node'}")
    else:
        print("egress     unknown — am.i.mullvad.net did not answer")
    print(f"discord    {report['discord'] or 'not checked: egress is not through Mullvad'}")
    print(f"watcher    {report['watcher']}")


def watcher_state() -> str:
    proc = subprocess.run(["systemctl", "--user", "is-active", "vpn-watch"], capture_output=True, text=True)
    return proc.stdout.strip() or "unknown"


@dataclass
class ListArgs:
    place: Annotated[str, tyro.conf.Positional] = ""
    """A country or a city: list its nodes instead of every country and city."""
    json: bool = False
    """Print JSON instead of text."""


@app.command(name="list")
def list_(args: ListArgs) -> None:
    """List countries and cities with their node counts, or the nodes of one country or city.

    JSON schema (--json), without a place:

        [{"country": "str", "city": "str", "nodes": int, "online": int}]

    with a place:

        [{"name": "str", "country": "str", "city": "str", "online": bool, "selected": bool}]
    """
    reading = full_status()
    if reading is None:
        raise VpnError("tailscaled did not answer")
    nodes = mullvad_nodes(reading)
    if not args.place:
        places: dict[tuple[str, str], list[Node]] = {}
        for node in nodes:
            places.setdefault((node.country, node.city), []).append(node)
        rows = [
            {"country": c, "city": city, "nodes": len(ns), "online": sum(n.online for n in ns)}
            for (c, city), ns in places.items()
        ]
        if args.json:
            print(json.dumps(rows, indent=2))
            return
        for row in rows:
            print(f"{row['country']:18s} {row['city']:22s} {row['online']}/{row['nodes']} online")
        return

    matched = resolve(args.place, nodes)
    if not matched:
        raise VpnError(f'no country or city matches "{args.place}"')
    selected = exit_state(reading).id
    rows = [
        {"name": n.name, "country": n.country, "city": n.city, "online": n.online, "selected": n.id == selected}
        for n in matched
    ]
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    for row in rows:
        mark = "*" if row["selected"] else " "
        print(f"{mark} {row['name']:18s} {row['city']:22s} {'online' if row['online'] else 'offline'}")


@app.command(name="watch")
def watch() -> None:
    """Keep the exit node working; what the vpn-watch user service runs.

    Waits on tailscaled's event bus and looks at the exit node whenever
    anything changes, reading tailscaled's state over its local socket. While no
    exit node is set it only watches. When the exit node reports itself offline,
    or egress stops going through it, it moves to the next node. While Vesktop
    runs it runs the Discord check on every new node and every 10 minutes, and
    moves on when a 403 persists past the confirmation wait.

    Records every exit-node change something other than vpn made, and an hourly
    heartbeat. Until the bus connects, and while Vesktop is closed on a node
    nobody has checked, it also looks every 15 seconds.
    """
    events: queue.Queue[str] = queue.Queue()
    threading.Thread(target=follow_bus, args=(events,), daemon=True).start()
    w = Watch()
    bus_up = False
    wait = 0.0
    while True:
        try:
            item = events.get(timeout=wait)
            deadline = time.monotonic() + BUS_DEBOUNCE_SECS
            while True:
                bus_up = {"up": True, "down": False}.get(item, bus_up)
                left = deadline - time.monotonic()
                if left <= 0:
                    break
                try:
                    item = events.get(timeout=left)
                except queue.Empty:
                    break
        except queue.Empty:
            pass
        wait = look(w, time.time(), bus_up)


if __name__ == "__main__":
    try:
        app.cli(prog="vpn", description=__doc__, config=(tyro.conf.OmitArgPrefixes,))
    except VpnError as e:
        sys.exit(f"vpn: {e}")
