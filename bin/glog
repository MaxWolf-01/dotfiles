#!/usr/bin/env bash
# Commit graph across all branches, with a gutter numbering the current branch's
# first-parent chain: 1 is HEAD, 2 the commit before it, and so on. Commits on
# other branches get no number. gdr takes these numbers (gdr 2..5).
#
# Usage: glog [N] [git-log args...]
#   N   how many numbered commits to show (default 15). The graph runs until
#       the Nth one, so other branches' commits come along but never crowd it out.
set -eu

usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; }

n=15
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
if [[ $# -gt 0 && $1 =~ ^[0-9]+$ ]]; then n=$1; shift; fi

color=never dim='' reset=''
if [[ -t 1 ]]; then color=always dim=$'\e[2m' reset=$'\e[0m'; fi

# The log is cut right after this commit: the Nth on the chain that the given
# filters let through. Empty when a filter is one rev-list rejects; then the
# whole log runs.
stop=$(git rev-list --first-parent -n "$n" HEAD "$@" 2>/dev/null | tail -1)

# The chain is read down to the stop commit for the numbers, then the log is
# streamed and abandoned once the stop commit has been printed.
out=$(git rev-list --first-parent HEAD 2>/dev/null | awk -F $'\x1f' -v dim="$dim" -v reset="$reset" -v stop="$stop" '
  FILENAME == ARGV[1] { num[$1] = ++k; w = length(k); if ($1 == stop) nextfile; next }
  NF > 1 && ($2 in num) { printf "%s%*d%s %s\n", dim, w, num[$2], reset, $1 }
  NF < 2 || !($2 in num) { printf "%*s %s\n", w, "", $1 }
  NF > 1 && $2 == stop { exit }
  ' - <(git log --all --graph --color=$color --date='format:%m-%d %H:%M' \
        --format='%C(auto)%h %C(dim)%ad%C(reset)%C(auto)%d%C(reset) %s%x1f%H' "$@"))

if [[ -t 1 ]]; then
  LESS="${LESS:-FRX}" less -R <<<"$out"
else
  printf '%s\n' "$out"
fi
