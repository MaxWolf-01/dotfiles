#!/usr/bin/env bash
# Commit graph across all branches, with a gutter numbering the current branch's
# first-parent chain: 1 is HEAD, 2 the commit before it, and so on. Commits on
# other branches get no number. gdr takes these numbers (gdr 2..5).
#
# Usage: glog [N] [git-log args...]
#   N   how many commits to show (default 15)
set -eu

usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; }

n=15
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
if [[ $# -gt 0 && $1 =~ ^[0-9]+$ ]]; then n=$1; shift; fi

color=never dim='' reset=''
if [[ -t 1 ]]; then color=always dim=$'\e[2m' reset=$'\e[0m'; fi

# Number each commit by its position in HEAD's first-parent chain. The chain is
# streamed; it stops early only when every shown commit sits on it, so with
# side branches in view the whole chain is read. That is still cheap.
out=$(git rev-list --first-parent HEAD 2>/dev/null | awk -F $'\x1f' -v dim="$dim" -v reset="$reset" '
  FILENAME == ARGV[1] { m++; txt[m] = $1; id[m] = $2; if (NF > 1) want[$2] = 1; next }
  ($1 in want) { num[$1] = FNR; if (++found == length(want)) exit }
  END {
    for (i = 1; i <= m; i++) if (id[i] in num && length(num[id[i]]) > w) w = length(num[id[i]])
    for (i = 1; i <= m; i++) {
      if (id[i] in num) printf "%s%*d%s %s\n", dim, w, num[id[i]], reset, txt[i]
      else printf "%*s %s\n", w, "", txt[i]
    }
  }' <(git log --all --graph --color=$color -"$n" --date='format:%m-%d %H:%M' \
        --format='%C(auto)%h %C(dim)%ad%C(reset)%C(auto)%d%C(reset) %s%x1f%H' "$@") -)

if [[ -t 1 ]]; then
  LESS="${LESS:-FRX}" less -R <<<"$out"
else
  printf '%s\n' "$out"
fi
