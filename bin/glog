#!/usr/bin/env bash
# Commit graph, with a gutter numbering the current branch's first-parent chain:
# 1 is HEAD, 2 the commit before it, and so on. Commits off that chain get no
# number. gdr takes these numbers (gdr 2..5), and they mean the same position in
# every view below.
#
# Usage: glog [N] [REV...] [git-log args...]
#   N     how many numbered commits to show (default: all). The graph runs until
#         the Nth one, so other branches' commits come along but never crowd it
#         out. May sit anywhere among the arguments, and the last one wins, so an
#         alias can carry a default that a later N overrides.
#   REV   what to walk, as git log takes it. Without one the graph shows every
#         branch (--all).
#
# The three views:
#   glog                       every commit, every branch
#   glog --first-parent        merges stay closed, every branch
#   glog HEAD --first-parent   this branch's chain, nothing else
set -eu

usage() { awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; }

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

# Arguments are sorted into the count, the revisions to walk, and everything git
# log gets verbatim. A bare integer is the count; a bare word naming a commit is
# a revision; from `--` on, arguments are pathspecs and are never either.
n='' revs=() args=()
sorting=1
for a in "$@"; do
  if [[ $sorting == 1 && $a == '--' ]]; then sorting=0
  elif [[ $sorting == 1 && $a =~ ^[0-9]+$ ]]; then n=$a; continue
  elif [[ $sorting == 1 && $a != -* ]] && git rev-parse --verify --quiet "$a^{commit}" >/dev/null 2>&1; then
    revs+=("$a"); continue
  fi
  args+=("$a")
done
scope=(--all); [[ ${#revs[@]} -eq 0 ]] || scope=("${revs[@]}")

color=never dim='' reset=''
pager() { cat; }
if [[ -t 1 ]]; then
  color=always dim=$'\e[2m' reset=$'\e[0m'
  pager() { LESS="${LESS:-FRX}" less -R; }
fi

# With N, the log is cut right after this commit: the Nth on the chain that the
# given filters let through. It is found with git log rather than rev-list so
# that every flag the graph accepts (--stat, -p, ...) is accepted here too; the
# separator byte keeps hashes apart from any diff output those flags add. The
# scope is left out, since the numbers follow HEAD's chain whatever is walked.
# Nothing on the chain matching the filters falls back to a plain row count.
stop='' limit=()
if [[ -n $n ]]; then
  stop=$(git log --first-parent -n "$n" --format='%x1f%H' HEAD "${args[@]}" 2>/dev/null \
    | awk -F $'\x1f' 'NF > 1 { h = $2 } END { print h }')
  [[ -n $stop ]] || limit=(-"$n")
fi

# The chain is read down to the stop commit for the numbers, then the log is
# streamed into the pager and abandoned at the first commit after the stop
# commit, so the stop commit's own stat or patch lines still make it out.
# Streaming is what keeps an unbounded log cheap: less shows the first screen
# while git is still rendering, and quitting it ends the pipeline.
git rev-list --first-parent HEAD 2>/dev/null | awk -F $'\x1f' -v dim="$dim" -v reset="$reset" -v stop="$stop" '
  FILENAME == ARGV[1] { num[$1] = ++k; w = length(k); if ($1 == stop) nextfile; next }
  NF > 1 && done { exit }
  NF > 1 && ($2 in num) { printf "%s%*d%s %s\n", dim, w, num[$2], reset, $1 }
  NF < 2 || !($2 in num) { printf "%*s %s\n", w, "", $1 }
  NF > 1 && $2 == stop { done = 1 }
  ' - <(git log "${scope[@]}" --graph --color=$color "${limit[@]}" --date='format:%m-%d %H:%M' \
        --format='%C(auto)%h %C(dim)%ad%C(reset)%C(auto)%d%C(reset) %s%x1f%H' "${args[@]}") | pager
