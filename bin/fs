#!/usr/bin/env bash
# Size of each given file or directory (apparent size, human-readable).
# With no arguments: every entry in the current directory, hidden ones included.
# Usage: fs [path...]
set -euo pipefail
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac
shopt -s nullglob dotglob
(( $# )) || set -- *
du -sbh -- "$@"
