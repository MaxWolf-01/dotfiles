#!/usr/bin/env bash
# Recently modified files under a directory (default: current), newest first.
# Usage: recent [count] [dir]        (count defaults to 20)
set -eu
n=20 dir=.
[[ "${1:-}" =~ ^[0-9]+$ ]] && { n=$1; shift; }
[[ -n "${1:-}" ]] && dir=$1
fd -t f . "$dir" -x stat -c '%Y %.16y %n' | sort -rn | head -n "$n" | cut -d' ' -f2-
