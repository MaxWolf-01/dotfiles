#!/usr/bin/env bash
# Drive bin/diffview end to end and check the generated page. Run it directly; no framework.
#
# The contract under test: both source modes (git range, OLD=NEW paths) produce a
# self-contained page whose embedded JSON carries the right files, statuses and
# commits — and, when chromium is available, whose JS actually renders the tree,
# the diff gutters, and the comment machinery it promises.

set -uo pipefail

diffview="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/diffview"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# --- OLD=NEW: two plain files, no git metadata

printf 'alpha\nbeta\ngamma\n' > "$work/old.txt"
printf 'alpha\nBETA\ngamma\ndelta\n' > "$work/new.txt"
out=$("$diffview" "$work/old.txt=$work/new.txt" -o "$work/files.html" --no-auto-summary)
check "file=file exits 0" 0 $?
check "file=file counts" "1 files, +2 -1" "$(grep -o '[0-9]* files, +[0-9]* -[0-9]*' <<<"$out")"
check "changed line is in the page" 1 "$(grep -c 'BETA' "$work/files.html")"
check "basename survives path stripping" yes "$(grep -q '"path": "new.txt"' "$work/files.html" && echo yes)"

# --- git range: a real repo with an edit, a rename, and two commits

repo="$work/repo"
git init -q "$repo"
git -C "$repo" -c user.name=t -c user.email=t@t commit -q --allow-empty -m base
printf 'one\ntwo\n' > "$repo/a.txt"
git -C "$repo" add a.txt
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m "add a.txt"
git -C "$repo" mv a.txt b.txt
printf 'one\ntwo\nthree\n' > "$repo/b.txt"
git -C "$repo" add b.txt
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m "rename and extend"

out=$("$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --summary "test summary paragraph")
check "git range exits 0" 0 $?
check "both commits embedded" 2 "$(grep -o '"subject": "' "$work/range.html" | wc -l)"
check "summary embedded" yes "$(grep -q 'test summary paragraph' "$work/range.html" && echo yes)"

"$diffview" "$repo@HEAD~1..HEAD" -o "$work/rename.html" --no-auto-summary >/dev/null
check "rename detected over the renaming range" yes "$(grep -q '"status": "renamed"' "$work/rename.html" && echo yes)"

# --- worktree range: trailing '..' includes uncommitted changes

printf 'four\n' >> "$repo/b.txt"
"$diffview" "$repo@HEAD.." -o "$work/worktree.html" --no-auto-summary >/dev/null
check "worktree range exits 0" 0 $?
check "uncommitted line is in the page" yes "$(grep -q '"four"' "$work/worktree.html" && echo yes)"
check "detail names the worktree" yes "$(grep -q 'HEAD..worktree' "$work/worktree.html" && echo yes)"
git -C "$repo" checkout -q -- b.txt

# --- agent notes: inline annotations and agent-side resolutions from --notes

cat > "$work/notes.json" <<'EOF'
{"notes": [{"id": 1, "path": "b.txt", "line": "3", "text": "kept the old order on purpose"},
           {"id": 7, "path": "b.txt", "text": "this file carries the feature"}],
 "resolved": ["C2", 5]}
EOF
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/notes.html" --no-auto-summary --notes "$work/notes.json" >/dev/null
check "notes generation exits 0" 0 $?
check "notes embedded" yes "$(grep -q 'kept the old order on purpose' "$work/notes.html" && echo yes)"
check "string line was coerced to a number" yes "$(grep -q '"line": 3' "$work/notes.html" && echo yes)"
check "gapped ids survive verbatim" yes "$(grep -q '"id": 7' "$work/notes.html" && echo yes)"
check "agent resolutions normalise to numbers" yes "$(grep -q '"agentResolved": \[2, 5\]' "$work/notes.html" && echo yes)"
echo 'not json' > "$work/bad.json"
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary --notes "$work/bad.json" >/dev/null 2>&1
check "malformed notes fail loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"path": "b.txt", "text": "no id"}]}') >/dev/null 2>&1
check "a note without an id fails loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 1, "path": "b.txt", "text": "a"}, {"id": 1, "path": "b.txt", "text": "b"}]}') >/dev/null 2>&1
check "duplicate note ids fail loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [], "resolved": ["nope"]}') >/dev/null 2>&1
check "a bad resolved id fails loud" 1 $?
"$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '[{"id": 1, "path": "b.txt", "text": "old bare-list schema"}]') >/dev/null 2>&1
check "the old bare-list schema fails loud" 1 $?
err=$("$diffview" "$repo@HEAD~1..HEAD" -o "$work/x.html" --no-auto-summary \
    --notes <(echo '{"notes": [{"id": 1, "path": "nope.txt", "text": "hi"}]}') 2>&1 >/dev/null)
check "unmatched note path warns" yes "$(grep -q 'matches no changed file' <<<"$err" && echo yes)"

# --- '@..' and '..' resolve to HEAD..worktree instead of crashing

printf 'five\n' >> "$repo/b.txt"
"$diffview" "$repo@.." -o "$work/atwt.html" --no-auto-summary >/dev/null
check "empty-base worktree range works" 0 $?
check "empty base means HEAD" yes "$(grep -q 'HEAD..worktree' "$work/atwt.html" && echo yes)"
git -C "$repo" checkout -q -- b.txt

# --- saved review state beside the page is baked into rebuilds

cat > "$work/range.html.state.json" <<EOF
{"key": "diffview:repo@HEAD~2..HEAD", "savedAt": 1, "nextId": 2, "viewed": [],
 "comments": [{"id": 1, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 3, "end": 3,
               "text": "state survives a rebuild", "excerpt": ["+ three"]}]}
EOF
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null
check "saved comments baked into the page" yes "$(grep -q 'state survives a rebuild' "$work/range.html" && echo yes)"
sed -i 's/"key": "diffview:repo@HEAD~2..HEAD"/"key": "diffview:other@x..y"/' "$work/range.html.state.json"
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null
check "state from a different review is not baked" yes "$(grep -q 'state survives a rebuild' "$work/range.html" || echo yes)"
echo '[]' > "$work/range.html.state.json"
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null 2>&1
check "non-object state file does not crash the build" 0 $?
cat > "$work/range.html.state.json" <<EOF
{"key": "diffview:repo@HEAD~2..HEAD", "savedAt": 2, "nextId": 2, "viewed": [],
 "comments": [{"id": 1, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 3, "end": 3,
               "text": "sneaky <!--<script> comment", "excerpt": ["+ three"]}]}
EOF
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null
check "comment openers cannot break the page script" 0 "$(grep -c '<!--<script' "$work/range.html")"
rm -f "$work/range.html.state.json"
"$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --no-auto-summary --summary "test summary paragraph" >/dev/null

# --- rendered DOM, when a browser is around

if command -v chromium >/dev/null; then
    # file cards render lazily on scroll; force them so the DOM snapshot is deterministic
    sed 's#</body>#<script>setTimeout(() => document.querySelectorAll(".main .fcard").forEach(c => c.dispatchEvent(new Event("render"))), 300)</script></body>#' \
        "$work/range.html" > "$work/dom.html"
    dom=$(chromium --headless --disable-gpu --virtual-time-budget=8000 \
        --dump-dom "file://$work/dom.html" 2>/dev/null)
    check "tree renders one row per file" 1 "$(grep -o 'class="tree-file' <<<"$dom" | wc -l)"
    check "diff hunks render" yes "$([ "$(grep -o 'tbody class="hunk"' <<<"$dom" | wc -l)" -ge 1 ] && echo yes)"
    check "comment gutters present" yes "$([ "$(grep -o 'data-no=' <<<"$dom" | wc -l)" -ge 3 ] && echo yes)"
    check "copy button present" yes "$(grep -q 'copy 0 comments' <<<"$dom" && echo yes)"

    # annotations end to end: ids on the boxes, the agent's resolution folding a comment
    # away, m landing on the next unresolved one, and what the copy button would produce
    cat > "$work/ann-notes.json" <<'EOF'
{"notes": [{"id": 1, "path": "b.txt", "line": 3, "text": "kept the old order on purpose"}],
 "resolved": ["C1"]}
EOF
    cat > "$work/ann.html.state.json" <<'EOF'
{"key": "diffview:repo@HEAD~1..HEAD", "savedAt": 1, "nextId": 3, "viewed": [], "verdict": [],
 "comments": [{"id": 1, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 3, "end": 3,
               "text": "first thought", "excerpt": ["+ three"]},
              {"id": 2, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 3, "end": 3,
               "text": "second thought", "excerpt": ["+ three"], "re": 1}]}
EOF
    "$diffview" "$repo@HEAD~1..HEAD" -o "$work/ann.html" --no-auto-summary --notes "$work/ann-notes.json" >/dev/null
    sed 's#</body>#<script>setTimeout(() => { document.querySelectorAll(".main .fcard").forEach(c => c.dispatchEvent(new Event("render"))); document.dispatchEvent(new KeyboardEvent("keydown", { key: "m", bubbles: true })); document.body.append(Object.assign(document.createElement("pre"), { id: "exp", textContent: commentsMarkdown() })); }, 300)</script></body>#' \
        "$work/ann.html" > "$work/anndom.html"
    dom=$(chromium --headless --disable-gpu --virtual-time-budget=8000 --dump-dom "file://$work/anndom.html" 2>/dev/null)
    check "the agent note carries its id" yes "$(grep -q 'data-ann="a1"' <<<"$dom" && echo yes)"
    check "comments carry their ids" yes "$(grep -q 'data-ann="c2"' <<<"$dom" && echo yes)"
    check "the agent's resolution folds C1 away" yes "$(grep -q 'class="cbox resolved" data-ann="c1"' <<<"$dom" && echo yes)"
    check "the copy button counts only unresolved" yes "$(grep -q 'copy 1 comment<' <<<"$dom" && echo yes)"
    check "m lands on the next unresolved comment" yes "$(grep -q 'class="cbox focus-ann" data-ann="c2"' <<<"$dom" && echo yes)"
    check "the export names the comment id" yes "$(grep -q '\*\*C2\*\*' <<<"$dom" && echo yes)"
    check "the export marks a reply to a note" yes "$(grep -q 're A1' <<<"$dom" && echo yes)"
    check "the export leaves the resolved comment out" yes "$(grep -q '\*\*C1\*\*' <<<"$dom" || echo yes)"
    check "the jump prompt is on the page" yes "$(grep -q 'id="jump"' <<<"$dom" && echo yes)"

    # the subtle one: Ctrl+k reaches a comment the agent called resolved, r overrides that
    # claim, and the override is what gets persisted — so the next rebuild cannot reinstate it
    cat > "$work/probe.js" <<'EOF'
const key = (k, extra) => document.dispatchEvent(new KeyboardEvent("keydown", { key: k, bubbles: true, ...extra }));
setTimeout(() => {
  document.querySelectorAll(".main .fcard").forEach(c => c.dispatchEvent(new Event("render")));
  key("k", { ctrlKey: true });
  const input = document.querySelector("#jump input");
  input.value = "c1";
  input.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
  key("r");
  key("D");
  key("u");
  document.body.append(Object.assign(document.createElement("pre"), { id: "probe", textContent:
    "at=" + (S.ann && S.ann.kind + S.ann.id) + " resolved=" + isResolved(1)
    + " comments=" + S.comments.length + " stored=" + localStorage.getItem(STORE_KEY) }));
}, 300);
EOF
    sed 's#</body>#<script src="probe.js"></script></body>#' "$work/ann.html" > "$work/probe.html"
    dom=$(chromium --headless --disable-gpu --virtual-time-budget=8000 --dump-dom "file://$work/probe.html" 2>/dev/null)
    check "ctrl+k reaches a resolved comment by id" yes "$(grep -q 'at=comment1' <<<"$dom" && echo yes)"
    check "r overrides the agent's resolution" yes "$(grep -q 'resolved=false' <<<"$dom" && echo yes)"
    check "the override is persisted, not just drawn" yes "$(grep -q '"verdict":\[\[1,false\]\]' <<<"$dom" && echo yes)"
    check "u restores a deleted comment" yes "$(grep -q 'comments=2' <<<"$dom" && echo yes)"

    # resolving the comment you stand on has to look like it did something: focus keeps a
    # resolved comment open, so it must leave — and a click is the way back into a folded one
    cat > "$work/fold.js" <<'EOF'
const key = (k, extra) => document.dispatchEvent(new KeyboardEvent("keydown", { key: k, bubbles: true, ...extra }));
setTimeout(() => {
  document.querySelectorAll(".main .fcard").forEach(c => c.dispatchEvent(new Event("render")));
  key("m");
  key("r");
  const folded = getComputedStyle(document.querySelector('[data-ann="c2"] .ctext')).display === "none";
  const left = S.ann ? S.ann.kind + S.ann.id : "none";
  document.querySelector('[data-ann="c2"]').click();
  const reopened = getComputedStyle(document.querySelector('[data-ann="c2"] .ctext')).display !== "none";
  document.body.append(Object.assign(document.createElement("pre"), { id: "fold", textContent:
    "folded=" + folded + " focus=" + left + " reopened=" + reopened }));
}, 300);
EOF
    sed 's#</body>#<script src="fold.js"></script></body>#' "$work/ann.html" > "$work/fold.html"
    dom=$(chromium --headless --disable-gpu --virtual-time-budget=8000 --dump-dom "file://$work/fold.html" 2>/dev/null)
    check "resolving folds the comment and lets focus go" yes "$(grep -q 'folded=true focus=none' <<<"$dom" && echo yes)"
    check "clicking a folded comment opens it back up" yes "$(grep -q 'reopened=true' <<<"$dom" && echo yes)"

    # a focused comment must not capture Space: it stays the review-progress key everywhere,
    # which is why resolve lives on its own letter
    cat > "$work/space.js" <<'EOF'
const key = (k, extra) => document.dispatchEvent(new KeyboardEvent("keydown", { key: k, bubbles: true, ...extra }));
setTimeout(() => {
  document.querySelectorAll(".main .fcard").forEach(c => c.dispatchEvent(new Event("render")));
  key("m");
  key(" ");
  document.body.append(Object.assign(document.createElement("pre"), { id: "space", textContent:
    "resolved=" + isResolved(2) + " viewed=" + S.viewed.size + " focus=" + (S.ann ? "held" : "none") }));
}, 300);
EOF
    sed 's#</body>#<script src="space.js"></script></body>#' "$work/ann.html" > "$work/space.html"
    dom=$(chromium --headless --disable-gpu --virtual-time-budget=8000 --dump-dom "file://$work/space.html" 2>/dev/null)
    check "space on a focused comment marks the file viewed, never resolves" "resolved=false viewed=1 focus=none" "$(grep -o 'id="space">[^<]*' <<<"$dom" | cut -d'>' -f2)"

    # motion runs on document position, not on an index into the ring being walked: notes
    # sorted however the JSON happened to list them, and every hop taken from somewhere the
    # ring does not contain — a comment you just resolved, a note while m walks comments
    cat > "$work/order-notes.json" <<'EOF'
{"notes": [{"id": 9, "path": "b.txt", "line": 3, "text": "listed first, sits last"},
           {"id": 2, "path": "b.txt", "line": 1, "text": "listed second, sits first"}],
 "resolved": []}
EOF
    cat > "$work/order.html.state.json" <<'EOF'
{"key": "diffview:repo@HEAD~1..HEAD", "savedAt": 1, "nextId": 4, "viewed": [], "verdict": [],
 "comments": [{"id": 1, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 1, "end": 1, "text": "one", "excerpt": ["  one"]},
              {"id": 2, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 2, "end": 2, "text": "two", "excerpt": ["  two"]},
              {"id": 3, "fileKey": "0:b.txt", "hi": 0, "side": "new", "start": 2, "end": 2, "text": "three", "excerpt": ["  two"]}]}
EOF
    "$diffview" "$repo@HEAD~1..HEAD" -o "$work/order.html" --no-auto-summary --notes "$work/order-notes.json" >/dev/null
    cat > "$work/order.js" <<'EOF'
const key = (k, extra) => document.dispatchEvent(new KeyboardEvent("keydown", { key: k, bubbles: true, ...extra }));
const trace = [];
const mark = () => trace.push(S.ann ? (S.ann.kind === "note" ? "A" : "C") + S.ann.id : "-");
setTimeout(() => {
  document.querySelectorAll(".main .fcard").forEach(c => c.dispatchEvent(new Event("render")));
  key("n"); mark();                 // notes walk the file, not the JSON: A2 before A9
  key("n"); mark();
  key("k", { ctrlKey: true });      // stand on C2, resolve it, and carry on to the next one
  const input = document.querySelector("#jump input");
  input.value = "c2";
  input.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
  key("r"); mark();
  key("n"); mark();                 // and across kinds, forward from where you stand
  key("m"); mark();                 // entering a ring with nothing ahead still lands: nearest behind
  key("m"); mark();                 // but walking one stops at its end
  document.body.append(Object.assign(document.createElement("pre"), { id: "trace", textContent: trace.join(" ") }));
}, 300);
EOF
    sed 's#</body>#<script src="order.js"></script></body>#' "$work/order.html" > "$work/order-dom.html"
    dom=$(chromium --headless --disable-gpu --virtual-time-budget=8000 --dump-dom "file://$work/order-dom.html" 2>/dev/null)
    check "motion follows document order, not ring position" "A2 A9 C3 A9 C3 C3" "$(grep -o 'id="trace">[^<]*' <<<"$dom" | cut -d'>' -f2)"
else
    echo "skip chromium not found — DOM checks not run"
fi

echo
if [ "$failures" -eq 0 ]; then echo "all checks passed"; else echo "$failures check(s) FAILED"; exit 1; fi
