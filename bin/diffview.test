#!/usr/bin/env bash
# Drive bin/diffview end to end and check the generated page. Run it directly; no framework.
#
# The contract under test: both source modes (git range, OLD=NEW paths) produce a
# self-contained page whose embedded JSON carries the right files, statuses and
# commits — and, when chromium is available, whose JS actually renders the tree,
# the diff gutters, and the comment machinery it promises.

set -uo pipefail

diffview="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/diffview"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

failures=0
check() {
    local what="$1" expected="$2" actual="$3"
    if [ "$expected" = "$actual" ]; then
        echo "ok   $what"
    else
        echo "FAIL $what"
        echo "       expected: $expected"
        echo "       actual:   $actual"
        failures=$((failures + 1))
    fi
}

# --- OLD=NEW: two plain files, no git metadata

printf 'alpha\nbeta\ngamma\n' > "$work/old.txt"
printf 'alpha\nBETA\ngamma\ndelta\n' > "$work/new.txt"
out=$("$diffview" "$work/old.txt=$work/new.txt" -o "$work/files.html" --no-auto-summary)
check "file=file exits 0" 0 $?
check "file=file counts" "1 files, +2 -1" "$(grep -o '[0-9]* files, +[0-9]* -[0-9]*' <<<"$out")"
check "changed line is in the page" 1 "$(grep -c 'BETA' "$work/files.html")"
check "basename survives path stripping" yes "$(grep -q '"path": "new.txt"' "$work/files.html" && echo yes)"

# --- git range: a real repo with an edit, a rename, and two commits

repo="$work/repo"
git init -q "$repo"
git -C "$repo" -c user.name=t -c user.email=t@t commit -q --allow-empty -m base
printf 'one\ntwo\n' > "$repo/a.txt"
git -C "$repo" add a.txt
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m "add a.txt"
git -C "$repo" mv a.txt b.txt
printf 'one\ntwo\nthree\n' > "$repo/b.txt"
git -C "$repo" add b.txt
git -C "$repo" -c user.name=t -c user.email=t@t commit -q -m "rename and extend"

out=$("$diffview" "$repo@HEAD~2..HEAD" -o "$work/range.html" --summary "test summary paragraph")
check "git range exits 0" 0 $?
check "both commits embedded" 2 "$(grep -o '"subject": "' "$work/range.html" | wc -l)"
check "summary embedded" yes "$(grep -q 'test summary paragraph' "$work/range.html" && echo yes)"

"$diffview" "$repo@HEAD~1..HEAD" -o "$work/rename.html" --no-auto-summary >/dev/null
check "rename detected over the renaming range" yes "$(grep -q '"status": "renamed"' "$work/rename.html" && echo yes)"

# --- rendered DOM, when a browser is around

if command -v chromium >/dev/null; then
    # file cards render lazily on scroll; force them so the DOM snapshot is deterministic
    sed 's#</body>#<script>setTimeout(() => document.querySelectorAll(".main .fcard").forEach(c => c.dispatchEvent(new Event("render"))), 300)</script></body>#' \
        "$work/range.html" > "$work/dom.html"
    dom=$(chromium --headless --disable-gpu --virtual-time-budget=8000 \
        --dump-dom "file://$work/dom.html" 2>/dev/null)
    check "tree renders one row per file" 1 "$(grep -o 'class="tree-file' <<<"$dom" | wc -l)"
    check "diff hunks render" yes "$([ "$(grep -o 'tbody class="hunk"' <<<"$dom" | wc -l)" -ge 1 ] && echo yes)"
    check "comment gutters present" yes "$([ "$(grep -o 'data-no=' <<<"$dom" | wc -l)" -ge 3 ] && echo yes)"
    check "copy button present" yes "$(grep -q 'copy 0 comments' <<<"$dom" && echo yes)"
else
    echo "skip chromium not found — DOM checks not run"
fi

echo
if [ "$failures" -eq 0 ]; then echo "all checks passed"; else echo "$failures check(s) FAILED"; exit 1; fi
