#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro"]
# ///
"""The container hub: one local server for every page an agent opens, each page a member of its container.

A STUB: it binds its port and answers every request with 501. The API below is the one
tests/properties/work-containers.test checks; pages-open-into-containers builds it.

    POST /api/open        {"target", "session"?}: a path, file:// URL or URL becomes a member of
                          the container the hub derives for it, or is opened again if it is one.
                          Answers {"container", "id"}.
    POST /api/close       {"container", "id"}: hide a member; it stays a member.
    POST /api/seen        {"container", "url", "seen"}: the user's seen mark on a member.
    GET  /api/c/<key>     the container: {"members": [{"id", "url", "closed"}], "seen": {url: when}}.
                          A member's url is where the hub serves it, relative to the hub's origin.
    GET  /.health         {"saves": true} once a diffview page served here can save its comments.

Examples:

    container-hub
    container-hub --port 18377 --state /tmp/hub-state
"""

import json
import re
from dataclasses import dataclass
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

import tyro


@dataclass
class Args:
    port: int = 8377
    """Port to serve on, on 127.0.0.1."""
    state: Path = Path("~/.local/state/container-hub")
    """Directory the hub keeps its state in."""


ROUTES = [
    ("POST", r"/api/open"),
    ("POST", r"/api/close"),
    ("POST", r"/api/seen"),
    ("GET", r"/api/c/[^/]+"),
    ("GET", r"/\.health"),
]


class Handler(BaseHTTPRequestHandler):
    def answer(self) -> None:
        path = self.path.split("?")[0]
        known = any(method == self.command and re.fullmatch(pattern, path) for method, pattern in ROUTES)
        body = json.dumps(
            {"error": "container-hub is a stub; pages-open-into-containers builds it" if known else "no such route"}
        ).encode()
        self.send_response(501 if known else 404)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    do_GET = do_POST = answer

    def log_message(self, *_):
        pass


def main(args: Args) -> None:
    args.state.expanduser().mkdir(parents=True, exist_ok=True)
    ThreadingHTTPServer(("127.0.0.1", args.port), Handler).serve_forever()


if __name__ == "__main__":
    main(tyro.cli(Args, description=__doc__))
