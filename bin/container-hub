"""A unit's lanes, left to right: from the highest level of abstraction to the lowest."""
FIGURE = re.compile(r"\.(svg|png|jpe?g|gif|webp|avif)$", re.IGNORECASE)


@dataclass
class Args:
    port: int = int(os.environ.get("CONTAINER_HUB_PORT") or 8377)
    """Port to serve on, on 127.0.0.1; claude-browser looks for the hub on $CONTAINER_HUB_PORT too."""
    state: Path = Path("~/.local/state/container-hub")
    """Directory the hub keeps each unit's members and the user's marks in."""
    tmux_socket: Path | None = None
    """Socket of the tmux server the sessions run under; tmux's default one ($TMUX_TMPDIR) when unset."""


# --------------------------------------------------------------------------
# what the files on disk say: trackers, the tickets sessions committed on, and which sessions run
# --------------------------------------------------------------------------


@dataclass
class Tracker:
    """One repo's tracker, as `tracker data` reads it."""

    root: Path
    """`agent/tickets` in the repo's main checkout, whichever worktree asked."""
    tickets: dict[str, dict]
    signature: tuple

    @property
    def agent(self) -> Path:
        return self.root.parent

    @property
    def repo(self) -> str:
        """The code repo's name, `.dotfiles` read as `dotfiles`."""
        return self.root.parent.parent.name.lstrip(".") or self.root.parent.parent.name

    def ancestors(self, slug: str):
        """The ticket's parent, its parent's, and so on up to its tree's root; a cycle ends the walk."""
        seen = {slug}
        while (slug := self.tickets.get(slug, {}).get("parent")) in self.tickets and slug not in seen:
            seen.add(slug)
            yield slug

    def tree(self, slug: str) -> str:
        return [slug, *self.ancestors(slug)][-1]


ROOTS: dict[Path, Path] = {}  # an agent directory -> the root of its tracker, which does not move
TRACKERS: dict[Path, Tracker] = {}


def tracker_command() -> str | None:
    """`tracker` from the mx plugin: on PATH inside a Claude Code session, under the plugin cache otherwise."""
    if found := shutil.which("tracker"):
        return found
    scripts = HOME.glob(".claude*/plugins/cache/*/mx/*/skills/tracker/tracker.py")
    version = lambda p: tuple(int(x) if x.isdigit() else 0 for x in p.parents[2].name.split("."))
    return str(max(scripts, key=version, default="")) or None


def signature(root: Path) -> tuple:
    try:
        return tuple(sorted((e.name, e.stat().st_mtime_ns, e.stat().st_size) for e in os.scandir(root) if e.name.endswith(".md")))
    except OSError:
        return ()


def tracker_at(agent: Path | None) -> Tracker | None:
    """The tracker an agent directory belongs to, read again only once a ticket file has changed. None when
    there is none, or `tracker` refuses to read it."""
    if agent is None:
        return None
    if (root := ROOTS.get(agent)) and (hit := TRACKERS.get(root)) and hit.signature == signature(root):
        return hit
    command = tracker_command()
    if not command or not agent.parent.is_dir():
        return None
    run = subprocess.run([command, "data"], cwd=agent.parent, capture_output=True, text=True, check=False)
    if run.returncode != 0:
        print(f"tracker data in {agent.parent} failed: {run.stderr.strip()[:300]}", file=sys.stderr, flush=True)
        return None
    data = json.loads(run.stdout)
    root = Path(data["root"]).resolve()
    stats = {e.name: e.stat().st_mtime for e in os.scandir(root) if e.name.endswith(".md")}
    tickets = {t["slug"]: {"status": t["status"], "parent": t.get("parent"), "title": t.get("title") or t["slug"],
                           "diff": t.get("diff") or [], "mtime": stats.get(f"{t['slug']}.md", 0)}
               for t in data["tickets"]}
    ROOTS[agent] = root
    TRACKERS[root] = Tracker(root, tickets, signature(root))
    return TRACKERS[root]


SESSION_LOGS: dict[Path, tuple[str, dict[str, list[str]]]] = {}
TICKET_PATH = re.compile(r"(?:tickets/([^/]+)\.md|(?:show|prototypes)/([^/]+)/.*|diffviews/([^/]+)\.html)$")


def git(cwd: Path, *args: str) -> str:
    run = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True, check=False)
    return run.stdout if run.returncode == 0 else ""


def session_tickets(agent: Path, session: str, memo: dict | None = None) -> list[str]:
    """The tickets a session's commits in an agent repo touched, the most recent first, from the `Session:`
    trailers on every branch. `memo` holds the refs of each repo already asked, for a read of every unit at once."""
    if memo is not None and agent in memo:
        refs, common = memo[agent]
    else:
        refs = git(agent, "for-each-ref", "--format=%(objectname)")
        common = Path(git(agent, "rev-parse", "--path-format=absolute", "--git-common-dir").strip() or agent) if refs else agent
        if memo is not None:
            memo[agent] = refs, common
    if not refs:
        return []
    cached = SESSION_LOGS.get(common)
    if not cached or cached[0] != refs:
        by: dict[str, list[tuple[int, str]]] = {}
        out = git(agent, "log", "--all", "--format=%x1e%ct%x1f%(trailers:key=Session,valueonly,separator=%x20)", "--name-only")
        for record in out.split("\x1e")[1:]:
            head, _, names = record.partition("\n")
            when, _, sids = head.partition("\x1f")
            slugs = [next(g for g in m.groups() if g) for n in names.split("\n") if (m := TICKET_PATH.match(n.strip()))]
            for sid in sids.split():
                by.setdefault(sid, []).extend((int(when), s) for s in slugs)
        ordered = {sid: list(dict.fromkeys(s for _, s in sorted(pairs, key=lambda p: -p[0]))) for sid, pairs in by.items()}
        SESSION_LOGS[common] = cached = (refs, ordered)
    return cached[1].get(session, [])


WORKING = ("busy", "shell")
"""A registry status of a session at work. The others are `idle`, and `waiting` on something in its terminal, which
`waitingFor` names: "permission prompt", "input needed", "dialog open". As Claude Code 2.1.289 writes them."""


def registry() -> dict[str, dict]:
    """Every session whose process runs, by its id, from Claude Code's session registry: one file per process,
    `~/.claude*/sessions/<pid>.json`. A file whose process is gone, or whose pid another process has taken
    since, names no session."""
    found = {}
    for path in HOME.glob(".claude*/sessions/*.json"):
        try:
            entry = json.loads(path.read_text())
            sid, pid = str(entry["sessionId"]), int(entry["pid"])
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if running(pid, entry.get("procStart")):
            found[sid] = {**entry, "account": account_of(path.parent.parent)}
    return found


def account_of(config_dir: Path | str) -> str:
    """An account as the hub names it: its config dir, spelled one way whether `~/.claude-work/` or a link to it."""
    return str(Path(config_dir).expanduser().resolve())


TITLE_LINE = re.compile(rb'^\{"type":"(?:ai|custom)-title".*$', re.MULTILINE)
transcripts: dict[str, Path] = {}
"""Every session's transcript, by its id, as the last look under `~/.claude*/projects/` found them."""
looked_at: tuple = ()
"""What `~/.claude*/projects/` held at that look: each project directory and when it last changed, which a new
transcript changes."""
titles: dict[Path, tuple] = {}
"""What a transcript's title lines said, by its path: (size, mtime, bytes read, the user's title, the AI's title)."""


def transcript(session: str, memo: dict) -> Path | None:
    """A session's transcript, where Claude Code still keeps one."""
    global looked_at
    if session in transcripts and not transcripts[session].exists():  # cleaned away, or moved to another account
        del transcripts[session]
    if session not in transcripts and not memo.get("transcripts looked"):
        memo["transcripts looked"] = True  # one look per read of the hub, however many sessions have no transcript
        # a session whose transcript Claude Code has cleaned away would otherwise walk every project at every read
        projects = tuple((d.path, d.stat().st_mtime_ns) for root in HOME.glob(".claude*/projects") for d in os.scandir(root)
                         if d.is_dir())
        if projects != looked_at:
            looked_at = projects
            transcripts.update({p.stem: p for p in HOME.glob(".claude*/projects/*/*.jsonl")})
    return transcripts.get(session)


def claude_title(session: str, memo: dict) -> str | None:
    """The title Claude Code keeps for a session in its transcript: the last one the user gave it with /rename (a
    `custom-title` line), else the last it made up itself (`ai-title`). A transcript only grows, so what was read
    of it is kept while it grows, and a read takes only what was added since."""
    path = transcript(session, memo)
    try:
        st = path.stat() if path else None
    except OSError:
        transcripts.pop(session, None)
        st = None
    if not st:
        return None
    size, mtime, read, custom, ai = titles.get(path, (0, 0, 0, None, None))
    if (st.st_size, st.st_mtime) != (size, mtime):
        if st.st_size < read:  # rewritten, not grown
            read, custom, ai = 0, None, None
        with path.open("rb") as f:
            f.seek(read)
            added = f.read(st.st_size - read)
        whole = added[:added.rfind(b"\n") + 1]  # a line still being written is read again once it is whole
        for m in TITLE_LINE.finditer(whole):
            try:
                line = json.loads(m[0])
            except ValueError:
                continue
            if line["type"] == "custom-title":
                custom = line.get("customTitle") or custom
            else:
                ai = line.get("aiTitle") or ai
        titles[path] = (st.st_size, st.st_mtime, read + len(whole), custom, ai)
    return custom or ai


def statusline_inputs() -> list[dict]:
    """What Claude Code last handed each session's statusline, which the statusline keeps as
    `~/.cache/claude-statusline/<session id>.json` with `config_dir` (the account's `CLAUDE_CONFIG_DIR`) and
    `written_at` added. Claude Code keeps these numbers nowhere else."""
    found = []
    for path in STATUSLINE.glob("*.json"):
        try:
            data = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(data, dict):
            found.append(data)
    return found


def context_use(inputs: list[dict]) -> dict[str, dict]:
    """Each session's context use, by its id: `used_percentage` and `total_input_tokens`."""
    found = {}
    for d in inputs:
        window = d.get("context_window")
        if isinstance(d.get("session_id"), str) and isinstance(window, dict):
            found[d["session_id"]] = {k: window.get(k) for k in ("used_percentage", "total_input_tokens")}
    return found


def usage(inputs: list[dict]) -> list[dict]:
    """Each account's 5h and weekly usage, from its newest statusline input: [{"account", "at", "five_hour",
    "seven_day"}], each window {"used_percentage", "resets_at"}, or null where the input carries none."""
    newest = {}
    for d in inputs:
        at = d.get("written_at")
        if not isinstance(d.get("config_dir"), str) or not isinstance(at, (int, float)):
            continue
        account = account_of(d["config_dir"])
        if at > newest.get(account, {}).get("written_at", -1):
            newest[account] = d
    window = lambda w: {k: w.get(k) for k in ("used_percentage", "resets_at")} if isinstance(w, dict) else None
    return [{"account": account, "at": d["written_at"],
             **{name: window((d.get("rate_limits") or {}).get(name)) for name in ("five_hour", "seven_day")}}
            for account, d in sorted(newest.items())]


def running(pid: int, started: str | None) -> bool:
    """The process runs, and is the one that started at `started` (in clock ticks, as /proc has it) where that is
    known."""
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
    except OSError:
        return False
    # the fields after the command's name, which may hold spaces, start at the third; the start time is the 22nd
    return started is None or stat.rsplit(")", 1)[1].split()[19] == str(started)


# --------------------------------------------------------------------------
# what a page is, read off how it was named
# --------------------------------------------------------------------------


@dataclass
class Page:
    url: str
    """Where the hub tab loads it: /f/<path> for a file, the URL itself otherwise. One page, one url."""
    path: Path | None = None
    """The file, where there is one; a page whose file is gone leaves its unit."""
    agent: Path | None = None
    """The agent directory it sits in, or the one of the repo it sits in."""
    slug: str | None = None
    kind: str = "page"
    session: str | None = None
    """The session a session page is of."""


def agent_of(directory: Path | None) -> tuple[Path | None, tuple[str, ...]]:
    """The agent directory a path sits in or under, and the path's parts below it."""
    if directory is None:
        return None, ()
    for d in (directory, *directory.parents):
        if d.name == "agent" and (d / "tickets").is_dir():
            return d, directory.relative_to(d).parts
        if (d / "agent" / "tickets").is_dir():
            return d / "agent", ()
    return None, ()


def page_of_path(path: Path, query: str = "") -> Page:
    path = path.resolve()
    agent, rel = agent_of(path)
    page = Page(url="/f" + urllib.parse.quote(str(path)) + (f"?{query}" if query else ""), path=path, agent=agent)
    match rel:
        case ("show", slug, *_):
            page.slug, page.kind = slug, "show"
        case ("prototypes", slug, *_):
            page.slug, page.kind = slug, "prototype"
        case ("diffviews", name) if name.endswith(".html"):
            page.slug, page.kind = name.removesuffix(".html"), "diff"
        case ("tickets", name) if name.endswith(".md"):
            page.slug = name.removesuffix(".md")
        case ("sessions", session, *_):
            page.kind, page.session = "session", session
        case ("board.html",):
            page.kind = "board"
    return page


def read_target(target: str, cwd: str | None, port: int) -> Page:
    """A path, a file:// URL, one of this hub's URLs or any other URL, as the page it names."""
    parts = urllib.parse.urlsplit(target)
    if parts.scheme in ("http", "https") and parts.netloc in (f"127.0.0.1:{port}", f"localhost:{port}"):
        return read_target(urllib.parse.urlunsplit(("", "", parts.path, parts.query, "")), cwd, port)
    if parts.scheme == "file":
        return page_of_path(Path(urllib.parse.unquote(parts.path)), parts.query)
    if not parts.scheme and target.startswith("/f/"):
        return page_of_path(Path(urllib.parse.unquote(parts.path.removeprefix("/f"))), parts.query)
    if not parts.scheme and (key := stand_in_key(parts.path)):
        return Page(url=stand_in_url(key), kind="session", session=key)
    if not parts.scheme and parts.path == "/diff":
        query = urllib.parse.parse_qs(parts.query)
        tracker, ticket = query.get("tracker", [""])[0], query.get("ticket", [""])[0]
        return Page(url=diff_url(Path(tracker), ticket), agent=Path(tracker).parent, slug=ticket, kind="diff")
    if parts.scheme:
        return page_of_url(target)
    path = Path(target).expanduser()
    if not path.is_absolute():
        path = Path(cwd or ".") / path
    return page_of_path(path)


def page_of_url(url: str) -> Page:
    """A page on another origin, spelled as a browser spells it, so a link to it in a page names the same member. The
    fragment stays: in a running app it is often the screen the app opens at."""
    parts = urllib.parse.urlsplit(url)
    return Page(url=urllib.parse.urlunsplit((parts.scheme.lower(), parts.netloc.lower(), parts.path or "/", parts.query, parts.fragment)))


def diff_url(tracker_root: Path, ticket: str) -> str:
    return "/diff?" + urllib.parse.urlencode({"tracker": str(tracker_root), "ticket": ticket})


DATA_MARK = b"const DATA = "


def diffview_payload(page: bytes) -> dict | None:
    """The data a diffview page carries, None for any other page."""
    at = page.find(DATA_MARK)
    if at < 0:
        return None
    try:
        data, _ = json.JSONDecoder().raw_decode(page[at + len(DATA_MARK):].decode(errors="replace"))
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


DIFFVIEWS: dict[Path, tuple[tuple[int, int], bool]] = {}


def is_diffview(path: Path | None) -> bool:
    """A diffview page, wherever it was written; read again only once the file has changed."""
    if not path or path.suffix != ".html" or not path.is_file():
        return False
    stat = path.stat()
    if (hit := DIFFVIEWS.get(path)) and hit[0] == (stat.st_mtime_ns, stat.st_size):
        return hit[1]
    found = diffview_payload(path.read_bytes()) is not None
    DIFFVIEWS[path] = (stat.st_mtime_ns, stat.st_size), found
    return found


def lane_of(page: Page) -> str:
    """The lane a page goes to, from what it is, as the module's docstring gives it."""
    if page.kind == "session":
        return "session"
    if page.kind == "diff" or is_diffview(page.path):
        return "code"
    if FIGURE.search(urllib.parse.urlsplit(page.url).path) or page.kind == "show":
        return "concept"
    return "output"


def member_lane(member: dict) -> str:
    """The lane an agent put a member in, else the one it follows from what it is."""
    return member.get("lane") or lane_of(Page(url=member["url"], path=Path(member["path"]) if member.get("path") else None,
                                              kind=member.get("kind", "page")))


def agent_facing(page: Page) -> str | None:
    """Why a page is for agents and never opens in front of the user, or None."""
    if page.kind == "show" and page.path and page.path.name == "report.md" and page.path.parent.name == page.slug:
        return "a worker's report is for agents"
    payload = diffview_payload(page.path.read_bytes()) if page.path and page.path.suffix == ".html" and page.path.is_file() else None
    sources = (payload or {}).get("sources") or []
    files = [(s, f) for s in sources for f in s.get("files") or []]
    if files and all(s.get("kind") == "git" and (Path(s.get("root", "/")) / "tickets").is_dir()
                     and f.get("path", "").startswith("tickets/") for s, f in files):
        return "a diffview of tracker files is for agents"
    return None


def ticket_of(page: Page, session: str | None, cwd: str | None) -> tuple[str | None, Tracker | None]:
    """The ticket a page is of: the one its path names; else the one its session last committed on. And the
    tracker of the repo the page or its opener sits in. Read from files alone."""
    opener = agent_of(Path(cwd).resolve() if cwd else None)[0]
    tracker = tracker_at(page.agent) or tracker_at(opener)
    if tracker and page.slug in tracker.tickets:
        return page.slug, tracker
    if session and tracker:
        for slug in session_tickets(tracker.agent, session):
            if slug in tracker.tickets:
                return slug, tracker
    return None, tracker


# --------------------------------------------------------------------------
# a unit's own state: its members and the user's marks on it, one file each
# --------------------------------------------------------------------------

STATE = Path()
lock = threading.RLock()
listeners: list[queue.Queue] = []
# The digests of the hub each listener last saw, taken when it starts listening and moved on by every round of the
# disk watch: a listener hears of every change made since it started, and of nothing else. What changed before is
# the listener's to read once its stream is open.
seen_by: weakref.WeakKeyDictionary[queue.Queue, tuple[str, str]] = weakref.WeakKeyDictionary()
launched_at = 0.0
"""When an open last had its caller open the hub tab: a tab just opened has not listened yet."""
unheard: list[tuple[float, dict]] = []
"""The boards handed to the hub while a tab just opened had not listened yet. A board is in no state that tab reads,
so its stream starts with them."""


def key_path(key: str) -> str:
    """A unit's key as it is spelled in its address and its state file's name."""
    return urllib.parse.quote(key, safe="@.-_")


def state_file(key: str) -> Path:
    return STATE / "units" / (key_path(key) + ".json")


OPENED: set[Path] = set()
"""Every page an agent opened or a local tool asked to have served: what /f/ serves outside an agent directory."""
SHARED: set[Path] = set()
"""The directories a local tool asked to have served whole (`POST /api/serve`)."""


def servable(path: Path) -> bool:
    """What /f/ serves: the agent directories, the files git tracks in the repos around them, the hub's own
    renders, a directory a local tool shared, and a page an agent opened or a tool shared with what sits beside
    it, though never all of $HOME or the temp dir for a page opened from there. A page the hub tab shows shares
    the hub's origin, so whatever is served here, every page in the tab can read."""
    agent, inside = agent_of(path)
    if path.is_relative_to(STATE) or inside or any(path.is_relative_to(d) for d in SHARED):
        return True
    if agent and path.is_file() and git(agent.parent, "ls-files", "--error-unmatch", "--", str(path)):
        return True
    if any(path == f or (not too_broad(base := f if f.is_dir() else f.parent) and path.is_relative_to(base)) for f in OPENED):
        return True
    # what diffview keeps beside a page goes where the page goes, so a page served on its own still saves
    beside = diffview.page_beside(path) if diffview else None
    return beside is not None and servable(beside)


def too_broad(directory: Path) -> bool:
    """A directory holding all of $HOME or the temp dir, which /f/ never serves whole."""
    return HOME.is_relative_to(directory) or TEMP.is_relative_to(directory)


def shared_file() -> Path:
    return STATE / "served.json"


def share(body: dict) -> tuple[int, dict]:
    """Serve a page, or a directory of them, for a local tool. Kept on disk, so a page left open in a tab
    still saves once the hub has restarted."""
    path = Path(body["path"]).expanduser().resolve()
    if not path.exists():
        return 404, {"error": f"{path} does not exist"}
    if path.is_dir() and too_broad(path):
        return 403, {"error": f"{path} holds all of your home or the temp dir, which the hub never serves whole"}
    with lock:
        if path not in OPENED | SHARED:
            write_json(shared_file(), [*load_shared(), str(path)])  # first, so a share that cannot be kept is not served either
            (SHARED if path.is_dir() else OPENED).add(path)
    return 200, {"url": "/f" + urllib.parse.quote(str(path)) + ("/" if path.is_dir() else "")}


def load_shared() -> list[str]:
    listed = read_json(shared_file())
    return [p for p in listed if isinstance(p, str)] if isinstance(listed, list) else []


def load(key: str) -> dict | None:
    data = read_json(state_file(key))
    return data if isinstance(data, dict) else None


def read_json(path: Path):
    """A file the hub keeps, None when there is none. One that does not parse is moved aside rather than left for
    the next save to overwrite, since the marks in it are the one thing nothing else on disk can give back. One
    that cannot be read at all raises: what is in it is unknown, so nothing may write over it."""
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return None
    except ValueError as e:
        aside = path.with_name(f"{path.name}.unreadable-{time.time_ns()}")
        try:
            os.replace(path, aside)
        except OSError:
            aside = None
        print(f"{path} could not be read ({e}); " + (f"moved to {aside}, and started anew" if aside else "left where it is"),
              file=sys.stderr, flush=True)
        return None


def write_json(path: Path, data) -> None:
    """Atomically, and before the request is answered: a crash keeps everything already answered."""
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{threading.get_ident()}.tmp")
    tmp.write_text(json.dumps(data, indent=1) + "\n")
    os.replace(tmp, path)


def save(data: dict) -> None:
    write_json(state_file(data["key"]), data)


def new_unit(key: str) -> dict:
    return {"key": key, "session": None if key == LOOSE else key, "roots": {}, "members": [], "visited": 0, "dismissed": 0}


def broadcast(event: dict) -> int:
    with lock:
        qs = list(listeners)
    for q in qs:
        q.put(event)
    return len(qs)


def member_id(url: str) -> str:
    return "m" + hashlib.sha1(url.encode()).hexdigest()[:10]


def title_of(page: Page) -> str:
    if not page.path:
        return urllib.parse.urlsplit(page.url).path.rsplit("/", 1)[-1] or page.url
    if page.kind == "session":
        return session_title(page.path.parent) or f"session {page.session[:8]}"
    if page.slug and page.kind in ("show", "prototype"):
        return str(page.path.relative_to(page.agent / {"show": "show", "prototype": "prototypes"}[page.kind] / page.slug))
    return page.path.name


def session_title(directory: Path) -> str | None:
    """A session's title: the heading of the session.md its session page is rendered from."""
    md = directory / "session.md"
    return next((line[2:] for line in md.read_text().splitlines() if line.startswith("# ")), None) if md.is_file() else None


def open_page(body: dict, port: int, from_page: bool) -> tuple[int, dict]:
    """from_page says the hub tab asked, for a link clicked in a page in it. The tab may open only what it could
    already read, so no page can widen what /f/ serves."""
    if (lane := body.get("lane")) is not None and lane not in LANES:
        return 400, {"error": f"no lane {lane}; the lanes are {', '.join(LANES)}"}
    page = read_target(body["target"], body.get("cwd"), port)
    refused = framing_refusal(page.url, port) if not page.path and not page.url.startswith("/") else None
    if refused and from_page:  # a link the user clicked, and a click is what may open a tab
        return 200, {"tab": refused, "say": f"opens as a browser tab, since {refused}", "open": body["target"]}
    if page.path and not page.path.exists():
        return 404, {"error": f"{page.path} does not exist"}
    if page.path and from_page and not (page.path.is_file() and servable(page.path)):
        return 403, {"error": f"{page.path} is not a page the hub serves"}
    if why := agent_facing(page):
        return 200, {"skipped": why, "say": f"not opened, {why}", "open": None}
    session = body.get("session") or None
    # the hub tab names the unit a link was clicked in; anything else goes to the session's
    key = (from_page and body.get("unit")) or page.session or session or LOOSE
    by = body.get("by") or "agent"
    if page.kind == "board":
        return 200, open_board(page, key, port, by)
    ticket, tracker = ticket_of(page, key if key != LOOSE else None, body.get("cwd"))
    mid = member_id(page.url)
    with lock:
        now = time.time()
        data = load(key) or new_unit(key)
        member = next((m for m in data["members"] if m["id"] == mid), None)
        action = "reopened" if member else "added"
        if not member:
            member = {"id": mid, "url": page.url, "path": str(page.path) if page.path else None,
                      "tracker": str(tracker.root) if tracker else None,
                      # a session page heads its unit, under no ticket
                      "ticket": None if page.kind == "session" else ticket,
                      "kind": page.kind, "title": body.get("title") or title_of(page), "first": now}
            data["members"].append(member)
        member.update(closed=False, at=now, by=by)
        if refused:
            member["tab"] = refused
        else:  # asked again at every open: a server restarted may have changed its mind
            member.pop("tab", None)
        if lane:
            member["lane"] = lane
        if not from_page:
            member["agent"] = True  # what an agent opened is served with what sits beside it: see servable
        save(data)
        if page.path and not from_page:
            OPENED.add(page.path)
        launch = announce({"type": action, "unit": key, "id": mid, "by": by})
    view = "/u/" + key_path(key)
    if refused:
        say = (f"in unit {key}, listed on its session page, where a click opens it as a browser tab ({refused}); "
               + ("the hub tab opens at the unit" if launch else "the open hub tab lists it"))
    else:
        say = f"in unit {key}, lane {member_lane(member)}; " + ("the hub tab opens at the page" if launch else "the open hub tab shows the page")
    return 200, {"unit": key, "id": mid, "action": action, "launch": launch, "view": view, "say": say,
                 "open": f"http://127.0.0.1:{port}{view}#{mid}" if launch else None}


def framing_refusal(url: str, port: int) -> str | None:
    """Why a page on another origin refuses to be framed in the hub tab, read off the headers it answers with, since
    the browser tells the tab nothing of a frame it refused. None where it allows framing, and where it does not
    answer at all: a server not up yet is framed, and shows once it is opened again."""
    if urllib.parse.urlsplit(url).scheme not in ("http", "https"):
        return "a frame shows only a page at an http or https address"
    try:  # curl rather than urllib: uv's Python finds no CA bundle on NixOS
        run = subprocess.run(["curl", "-sS", "-L", "--max-redirs", "5", "--max-time", "4", "-o", os.devnull, "-D", "-", url],
                             capture_output=True, text=True, check=False, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    # a block of headers per response, a redirect's before the page's own
    last = next((b for b in reversed(re.split(r"\r?\n\r?\n", run.stdout.strip())) if b.startswith("HTTP/")), "")
    fields = [(k.strip().lower(), v.strip()) for k, _, v in (line.partition(":") for line in last.splitlines()[1:])]
    ancestors = [d.split()[1:] for k, v in fields if k == "content-security-policy"
                 for d in re.split(r"[;,]", v) if d.split()[:1] and d.split()[0].lower() == "frame-ancestors"]
    if ancestors:  # where a page sets frame-ancestors, the browser ignores its X-Frame-Options
        shut = next((s for s in ancestors if not any(admits_hub(x, port) for x in s)), None)
        return None if shut is None else f"its Content-Security-Policy has frame-ancestors {' '.join(shut) or "'none'"}"
    options = [v for k, v in fields if k == "x-frame-options"]
    refuses = {o.strip().lower() for v in options for o in v.split(",")} & {"deny", "sameorigin"}
    return f"its X-Frame-Options is {', '.join(options)}" if refuses else None


ANCESTOR = re.compile(r"(?:(?P<scheme>[a-z][a-z0-9+.-]*)://)?(?P<host>[^/:]+)(?::(?P<port>\*|\d+))?(?:/.*)?")


def admits_hub(source: str, port: int) -> bool:
    """A frame-ancestors source the hub tab's origin, http://127.0.0.1:<port>, matches. Read loosely where CSP is
    strict: a source with no scheme counts whatever the page's own scheme, and a path never narrows it."""
    source = source.lower()
    found = ANCESTOR.fullmatch(source)
    return source in ("*", "http:") or bool(found and found["scheme"] in (None, "http") and found["host"] == "127.0.0.1"
                                              and found["port"] in ("*", str(port)))


def announce(event: dict) -> bool:
    """Tell every listening hub tab of an open, and answer whether the caller opens one instead. It does when none
    listens and none was opened in the last ten seconds, since a tab that new has not listened yet."""
    global launched_at
    with lock:
        now = time.time()
        heard = broadcast(event)
        launch = not heard and now - launched_at > 10
        if launch:
            launched_at = now
        elif not heard and event["type"] == "board":
            unheard.append((now, event))
    return launch


def open_board(page: Page, key: str, port: int, by: str) -> dict:
    """A board handed to the hub: shown over the hub tab, with the opener's unit, whose tickets it marks where it is
    that unit's tree's board."""
    launch = announce({"type": "board", "unit": key, "url": page.url, "by": by})
    return {"board": page.url, "launch": launch,
            "say": "the board opens over the hub tab" if launch else "the open hub tab shows the board over it",
            "open": f"http://127.0.0.1:{port}/u/{key_path(key)}#board:{page.url}" if launch else None}


def mark(what: str, body: dict) -> tuple[int, dict]:
    with lock:
        key = body["unit"]
        data = load(key)
        if data is None:
            return 404, {"error": f"no unit {key}"}
        if what == "close":
            found = [m for m in data["members"] if m["id"] == body["id"]]
            if not found:
                return 404, {"error": f"no member {body['id']} in {key}"}
            found[0].update(closed=True, closed_at=time.time())
        elif what == "visit":
            data["visited"] = time.time()
        elif what == "dismiss":
            data["dismissed"] = time.time()
        save(data)
    broadcast({"type": what, **body})
    return 200, {"ok": True}


# --------------------------------------------------------------------------
# a unit as the hub tab draws it, derived again on every read
# --------------------------------------------------------------------------

# The column of a session page that lists every artefact its turns link, and the attribute each link to an artefact
# carries there: the absolute path of the file it opens, or the URL as written. The renderer is the mx plugin's.
COLUMN = re.compile(rb'<aside\b[^>]*\bid="artefacts"[^>]*>(.*?)</aside>', re.DOTALL)
ARTEFACT = re.compile(rb'\bdata-artefact="([^"]*)"')
SESSION_LINKS: dict[Path, tuple[tuple[int, int], list[tuple[str, Page]]]] = {}


def session_links(path: Path | None) -> list[tuple[str, Page]]:
    """What a session page's artefact column links, in its order, once each: every `data-artefact` value with the
    page it names. Read again only once the file has changed; nothing for a page with no column."""
    if not path or not path.is_file():
        return []
    stat = path.stat()
    if (hit := SESSION_LINKS.get(path)) and hit[0] == (stat.st_mtime_ns, stat.st_size):
        return hit[1]
    column = COLUMN.search(path.read_bytes())
    values = dict.fromkeys(html.unescape(v.decode(errors="replace")) for v in ARTEFACT.findall(column[1] if column else b""))
    found = [(v, page_of_path(Path(v)) if v.startswith("/") else page_of_url(v)) for v in values if v]
    SESSION_LINKS[path] = (stat.st_mtime_ns, stat.st_size), found
    return found


def unit_pages(session_page: Path | None, members: list[dict]) -> list[dict]:
    """Every page of a unit as its session page lists it: the column's links in the column's order, opened or not,
    then the members no turn links, in the order they were opened. The session page itself is the list, and is
    not on it."""
    by_url = {m["url"]: m for m in members}
    tab = lambda m: {"tab": m["tab"]} if m and m.get("tab") else {}  # why it refuses to be framed, where it does
    pages = []
    for value, page in session_links(session_page):
        if page.kind == "board":  # the rail's, never a unit's
            continue
        m = by_url.get(page.url)
        pages.append({"url": page.url, "id": member_id(page.url), "artefact": value, "linked": True,
                      "title": m["title"] if m else title_of(page), "kind": page.kind,
                      "lane": m["lane"] if m else lane_of(page), "ticket": m["ticket"] if m else None,
                      **tab(m)})
    linked = {p["url"] for p in pages}
    pages += [{"url": m["url"], "id": m["id"], "artefact": m.get("path") or m["url"], "linked": False, "title": m["title"],
               "kind": m["kind"], "lane": m["lane"], "ticket": m["ticket"], **tab(m)}
              for m in sorted(members, key=lambda m: m["first"]) if m["url"] not in linked and m["kind"] != "session"]
    return pages


def resume_command(session: str) -> str:
    return diffview.resume_command(session) if diffview else f"claude --resume {session}"


def stays(member: dict) -> bool:
    """A member is one still: its file is there."""
    return not member.get("path") or present(Path(member["path"]))


def present(path: Path) -> bool:
    """A member's file is still there, and when it is a watched diffview, so is every repo it watched: a live
    diff belongs in its unit while its worktree exists."""
    return path.exists() and not (diffview and diffview.watched_repo_gone(path))


def unit_view(key: str, live: dict[str, dict], memo: dict, contexts: dict[str, dict]) -> dict | None:
    """Everything the hub tab draws of a unit, but its number, which hub_view gives it among the others. None
    once the unit is gone: its tree retired, or every page of it deleted. A member whose file is gone leaves it
    here."""
    data = load(key)
    if data is None:
        return None
    session = data.get("session")
    kept = [m for m in data["members"] if stays(m)]
    tracker, gone = unit_tracker(kept, session, memo)
    committed = [s for s in session_tickets(tracker.agent, session, memo) if s in tracker.tickets] if tracker and session else []
    # a session with no commits there works on the tree of the ticket whose page changed last
    ticketed = [m["ticket"] for m in sorted(kept, key=lambda m: (-modified(m), m["url"]))
                if tracker and m.get("tracker") == str(tracker.root) and m["ticket"] in tracker.tickets]
    tree = tracker.tree((committed or ticketed)[0]) if committed or ticketed else None
    with lock:
        data = load(key)
        if data is None:
            return None
        kept = [m for m in data["members"] if stays(m)]
        roots = data.setdefault("roots", {})
        # a tree once known and no longer in its tracker is retired; a tracker that refuses to read retires nothing.
        # The loose pages belong to no session's tree, and go only once every one of them is deleted.
        known = roots.get(str(tracker.root)) if tracker else None
        retired = session and (gone or (tracker and known and not tree and known not in tracker.tickets))
        if retired or not [m for m in kept if not stand_in(m)]:
            state_file(key).unlink(missing_ok=True)
            return None
        if len(kept) != len(data["members"]) or (tree and tree != known):
            data["members"] = kept
            if tree:
                roots[str(tracker.root)] = tree
            save(data)
    home = str(tracker.root) if tracker else None
    slugs = list(dict.fromkeys([*committed, *(m["ticket"] for m in kept if m["ticket"] and m.get("tracker") == home)]))
    session_dir = tracker.agent / "sessions" / session if tracker and session else None
    session_page = session_dir / "index.html" if session_dir else None
    if session and not (session_page and session_page.is_file()):  # opened from a repo whose tracker is not the unit's
        session_page = next((Path(m["path"]) for m in kept if m["kind"] == "session" and m.get("path")
                             and Path(m["path"]).parent.name == session), session_page)
    if session_page and session_page.is_file() and any(map(stand_in, kept)):
        # the stand-in goes once the session page is there, which takes its place as it stood, open or minimized
        real = page_of_path(session_page)
        with lock:
            if held := load(key):
                was = next((m for m in held["members"] if stand_in(m)), None)
                held["members"] = [m for m in held["members"] if not stand_in(m)]
                if was and all(m["url"] != real.url for m in held["members"]):
                    held["members"].append({**was, "id": member_id(real.url), "url": real.url, "path": str(real.path),
                                            "title": title_of(real), "tracker": str(tracker.root) if tracker else was.get("tracker")})
                save(held)
                kept = [m for m in held["members"] if stays(m)]
    members = [{**m, "lane": member_lane(m)} for m in kept]
    pages = unit_pages(session_page, members)
    tickets = [{"slug": s, **({k: tracker.tickets[s][k] for k in ("status", "title", "diff")} if tracker and s in tracker.tickets
                               else {"status": "gone", "title": s, "diff": []})} for s in slugs]
    entry = live.get(session) if session else None
    kept_at = transcript(session, memo) if session and not entry else None
    account = entry["account"] if entry else account_of(kept_at.parent.parent.parent) if kept_at else None
    state = None if not session else entry.get("status", "idle") if entry else "ended"
    last = last_turn(session_page, entry)
    title = ((session_dir and session_title(session_dir)) or (session and claude_title(session, memo)) or (entry or {}).get("name")
             or (f"session {session[:8]}" if session else "loose pages"))
    board = tracker.agent / "board.html" if tracker else None
    return {"unit": key, "session": session, "account": account, "title": title,
            "short": (entry or {}).get("name") or (session or "")[:8],
            "tree": tree, "repo": tracker.repo if tracker else "",
            "state": state, "waiting_for": (entry or {}).get("waitingFor"), "pane": (entry or {}).get("tmux"),
            "context": contexts.get(session) if entry else None,
            "last": last, "number": None, "dismissed": bool(data.get("dismissed")) and data["dismissed"] >= last,
            "first": min(m["first"] for m in kept), "visited": data.get("visited") or 0,
            "resume": resume_command(session) if session else "", "tickets": tickets, "pages": pages, "members": members,
            "board": page_of_path(board).url if board and board.is_file() else None,
            "worked_on": [s for s in committed if tracker.tickets[s]["status"] != "done"],  # what is done is worked on no more
            "session_page": session_entry(session_page) or {"url": stand_in_url(key), "id": member_id(stand_in_url(key))}}


def session_entry(path: Path | None) -> dict | None:
    """Where a unit's session page is served, and the id it has as a member, before anyone opened it."""
    if not path or not path.is_file():
        return None
    url = page_of_path(path).url
    return {"url": url, "id": member_id(url)}


STAND_IN = "/pages/"


def stand_in_url(key: str) -> str:
    return STAND_IN + key_path(key)


def stand_in_key(path: str) -> str | None:
    return urllib.parse.unquote(path.removeprefix(STAND_IN)) if path.startswith(STAND_IN) else None


def stand_in(member: dict) -> bool:
    return member["url"].startswith(STAND_IN)


def stand_in_page(view: dict) -> bytes:
    """The page that lists a unit's pages while it has no session page. It is the session page's column, empty, for
    the hub tab to fill."""
    why = ("Pages no session opened. The hub lists them here, as a session page lists its own." if not view["session"]
           else "This session has rendered no session page yet. The hub lists its pages here until it does.")
    where = " · ".join(x for x in (view["tree"], view["repo"]) if x)
    return (STAND_IN_PAGE.replace("__TITLE__", html.escape(view["title"])).replace("__WHERE__", html.escape(where))
            .replace("__WHY__", html.escape(why)).encode())


STAND_IN_PAGE = """<!doctype html><meta charset="utf-8"><title>__TITLE__</title>
<style>
  :root { color-scheme: light dark; --ground: light-dark(#f4e4cd, #1a1714); --body: light-dark(#37261d, #ede3d2);
    --muted: light-dark(#5e5650, #b0a89e); --accent: light-dark(#426724, #6ea444); --edge: light-dark(#cfbca3, #4a433b); }
  body { margin: 0; padding: 2rem 1.5rem; background: var(--ground); color: var(--body); font: 15px/1.6 Newsreader, Georgia, serif; }
  h1 { font: 600 17px/1.4 Newsreader, Georgia, serif; margin: 0; }
  .meta { font: 12px/1.5 "IBM Plex Mono", ui-monospace, monospace; color: var(--muted); margin: 2px 0 1.25rem; }
  #artefacts { font: 13px/1.5 "IBM Plex Mono", ui-monospace, monospace; max-width: 40rem; }
  #artefacts .group { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); align-items: baseline; }
  #artefacts .turn-ref { color: var(--muted); }
  #artefacts ol { list-style: none; padding: 0; margin: 4px 0 0; }
  #artefacts li { display: grid; grid-template-columns: 1.2rem minmax(0, 1fr); gap: 0 6px; align-items: baseline; padding: 4px 0;
    border-bottom: 1px solid var(--edge); }
  #artefacts a { color: var(--accent); text-decoration: none; overflow-wrap: anywhere; } #artefacts a:hover { text-decoration: underline; }
</style>
<h1>__TITLE__</h1>
<p class="meta">__WHERE__<br>__WHY__</p>
<aside class="column" id="artefacts"></aside>
"""


def unit_tracker(kept: list[dict], session: str | None, memo: dict) -> tuple[Tracker | None, bool]:
    """The tracker a unit's tree is read from, and whether every tracker its pages sat in is gone. Of the trackers
    its pages sit in, the first in which its session committed, else the one holding the page that changed last,
    so that the same pages on the same disk give the same tracker whatever order they were opened in."""
    roots = sorted({m.get("tracker") for m in kept} - {None})
    there = [r for r in roots if Path(r).is_dir()]
    trackers = [t for r in there if (t := tracker_at(Path(r).parent))]
    if not trackers:
        return None, bool(roots) and not there
    committed = lambda t: bool(session) and any(s in t.tickets for s in session_tickets(t.agent, session, memo))
    newest = lambda t: max((modified(m) for m in kept if m.get("tracker") == str(t.root)), default=0)
    return min(trackers, key=lambda t: (not committed(t), -newest(t), str(t.root))), False


def modified(member: dict) -> float:
    try:
        return Path(member["path"]).stat().st_mtime if member.get("path") else 0
    except OSError:
        return 0


def last_turn(session_page: Path | None, entry: dict | None) -> float:
    """When a session last finished a turn: its page's last render, which the Stop hook writes at every turn's end,
    or the registry marking it idle. 0 when neither says."""
    times = [session_page.stat().st_mtime] if session_page and session_page.is_file() else []
    if entry and entry.get("status") == "idle" and isinstance(entry.get("statusUpdatedAt"), (int, float)):
        times.append(entry["statusUpdatedAt"] / 1000)
    return max(times, default=0)


def hub_view() -> dict:
    """Every unit that is still there, in the rail's order, as the module's docstring gives it."""
    live, memo, inputs = registry(), {}, statusline_inputs()
    contexts = context_use(inputs)
    units = []
    for path in sorted((STATE / "units").glob("*.json")):
        try:
            view = unit_view(urllib.parse.unquote(path.stem), live, memo, contexts)
        except OSError as e:
            print(f"listing {path}: {e}", file=sys.stderr, flush=True)
            continue
        if view:
            units.append(view)
    numbered = sorted((u for u in units if u["session"] and u["state"] != "ended" and not u["dismissed"]),
                      key=lambda u: (u["state"] in WORKING, -u["last"]))
    for n, u in enumerate(numbered, 1):
        u["number"] = n
    # the dismissed, then the loose pages, then the ended, each the latest first
    rest = sorted((u for u in units if u["number"] is None),
                  key=lambda u: (2 if u["state"] == "ended" else 0 if u["dismissed"] else 1, -u["last"]))
    return {"units": [*numbered, *rest], "usage": usage(inputs)}


def listing(directory: Path) -> bytes:
    """Every page under a directory, linked relative to it, so a directory's address is somewhere to start."""
    pages = sorted(directory.rglob("*.html"))
    rows = "".join(f'<li><a href="{urllib.parse.quote(str(p.relative_to(directory)))}">{html.escape(str(p.relative_to(directory)))}</a></li>'
                   for p in pages) or "<li>no pages here yet</li>"
    return LISTING.replace("__TITLE__", html.escape(directory.name)).replace("__HEAD__", html.escape(str(directory))).replace("__ROWS__", rows).encode()


LISTING = """<!doctype html><meta charset="utf-8"><title>__TITLE__</title>
<style>
  :root { color-scheme: light dark; --ground: light-dark(#f4e4cd, #1a1714); --body: light-dark(#37261d, #ede3d2);
    --accent: light-dark(#426724, #6ea444); --edge: light-dark(#cfbca3, #4a433b); }
  body { margin: 0; padding: 3rem 2rem; background: var(--ground); color: var(--body); font: 15px/1.6 "IBM Plex Mono", ui-monospace, monospace; }
  h1 { font: 600 17px/1.4 Newsreader, Georgia, serif; margin: 0 0 1rem; }
  ul { list-style: none; padding: 0; margin: 0; max-width: 60rem; }
  li { padding: 6px 0; border-bottom: 1px solid var(--edge); }
  a { color: var(--accent); text-decoration: none; font-weight: 500; } a:hover { text-decoration: underline; }
</style>
<h1>__HEAD__</h1><ul>__ROWS__</ul>
"""


# --------------------------------------------------------------------------
# answering a session from its unit: what the user types in the hub tab goes into the session's tmux pane
# --------------------------------------------------------------------------

TOKEN = ""
"""What the hub tab sends with every write that acts with the user's authority; kept in --state, so a tab left
open across a restart of the hub still sends."""
PANE = re.compile(r"%\d+$")  # the registry names a pane as session:@window.%pane; the pane's id alone survives a move
DROP_LIMIT = 200 * 2**20


def load_token() -> str:
    """The token kept in --state, made anew where there is none, or one too short to guard anything."""
    path = STATE / "token"
    try:
        if len(token := path.read_text().strip()) >= 24:
            return token
    except FileNotFoundError:
        pass
    token = secrets.token_urlsafe(24)
    tmp = path.with_name(".token.tmp")
    tmp.unlink(missing_ok=True)
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(token)
    os.replace(tmp, path)
    return token


def top_level(headers) -> bool:
    """A load of the hub tab itself, not a fetch or a frame from a page it shows: the browser says which, in a header
    no page can set. A client that says nothing is no page either."""
    return headers.get("Sec-Fetch-Dest") in (None, "document")


TMUX_SOCKET: Path | None = None
TMUX_COMMANDS = {"display-message", "load-buffer", "paste-buffer", "delete-buffer", "send-keys"}
"""All the hub ever asks of tmux. It types into a pane, and nothing it runs can end a server, a session or a pane."""


def tmux(command: str, *args: str, given: str | None = None) -> subprocess.CompletedProcess:
    """A command to the server --tmux-socket names, else tmux's default one. Never the server in $TMUX: a hub
    started from inside a pane would reach that pane's server whatever it was told."""
    if command not in TMUX_COMMANDS:
        raise ValueError(f"the hub does not run tmux {command}")
    socket_args = ["-S", str(TMUX_SOCKET)] if TMUX_SOCKET else []
    env = {k: v for k, v in os.environ.items() if k not in ("TMUX", "TMUX_PANE")}
    return subprocess.run(["tmux", *socket_args, command, *args], input=given, env=env, capture_output=True, text=True,
                          check=False, timeout=10)


def descends(pid: int, ancestor: int) -> bool:
    seen = set()
    while pid > 1 and pid not in seen:
        if pid == ancestor:
            return True
        seen.add(pid)
        try:
            pid = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return False
    return False


def pane_of(key: str) -> tuple[str | None, str]:
    """The tmux pane a unit's session takes the user's words in, or None and why it takes none now."""
    entry = registry().get(key) if key != LOOSE else None
    if not entry:
        return None, "the session has ended"
    if entry.get("status") == "waiting":
        return None, f"the session is blocked in its terminal ({entry.get('waitingFor') or 'waiting'}); answer it in its pane"
    if not (found := PANE.search(str(entry.get("tmux") or ""))):
        return None, "the session runs in no tmux pane"
    pane = found[0]
    # a pane id is reused once tmux restarts, so the pane has to hold the session's own process
    shown = tmux("display-message", "-p", "-t", pane, "#{pane_pid}")
    if shown.returncode != 0 or not shown.stdout.strip().isdigit() or not descends(int(entry["pid"]), int(shown.stdout)):
        return None, f"tmux pane {pane} no longer holds the session"
    return pane, ""


def type_into(body: dict) -> tuple[int, dict]:
    text = body["text"]
    if not isinstance(text, str) or not text.strip():
        return 400, {"error": "nothing to send"}
    try:
        pane, why = pane_of(body["unit"])
        if not pane:
            return 409, {"error": why}
        # a paste, so a newline stays a newline rather than sending the message early; tmux types it as plain keys
        # where the program asked for no bracketed paste
        buffer = f"container-hub-{secrets.token_hex(4)}"
        for args, given in ((("load-buffer", "-b", buffer, "-"), text), (("paste-buffer", "-p", "-d", "-b", buffer, "-t", pane), None),
                            (("send-keys", "-t", pane, "Enter"), None)):
            run = tmux(*args, given=given)
            if run.returncode != 0:
                tmux("delete-buffer", "-b", buffer)
                return 502, {"error": f"tmux {args[0]} into {pane}: {run.stderr.strip()}"}
    except (OSError, subprocess.TimeoutExpired) as e:  # no tmux on PATH, or a server that does not answer
        return 502, {"error": f"tmux: {e}"}
    return 200, {"ok": True, "pane": pane}


def drop(key: str, name: str, data: bytes) -> tuple[int, dict]:
    """A file pasted or dropped into a unit's box, saved where the session can read it, under the name it had."""
    if key == LOOSE or load(key) is None:
        return 404, {"error": f"no unit {key}"}
    directory = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "container-hub" / "drops" / key_path(key)
    stem = re.sub(r"[^\w.+-]+", "-", Path(name).name).strip(".-") or "pasted"  # a path typed bare, with no quoting
    directory.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    path = directory / f"{stamp}-{stem}"
    n = 1
    while path.exists():  # several files of one name in one second
        n += 1
        path = directory / f"{stamp}-{n}-{stem}"
    path.write_bytes(data)
    return 200, {"path": str(path)}


# --------------------------------------------------------------------------
# rendering a ticket's code ranges, and trellis, on first use
# --------------------------------------------------------------------------


def code_ranges(tracker: Tracker, ticket: str) -> list[str]:
    """The `code@` ranges a ticket's `diff:` field records. Its `agent@` ranges are left out: on a worker's branch
    they hold its report and its show files, which are pages of their own."""
    return [r for r in tracker.tickets.get(ticket, {}).get("diff") or [] if r.startswith("code@")]


def render_diff(tracker_root: Path, ticket: str) -> tuple[Path | None, int, str]:
    """The page of a ticket's recorded code ranges, rendered on first use; else None, the status to answer, and why."""
    tracker = tracker_at(tracker_root.parent)
    ranges = code_ranges(tracker, ticket) if tracker else []
    if not ranges:
        return None, 404, "no code range recorded for this ticket"
    code = tracker_root.parent.parent
    specs = [f"{code}@{r.removeprefix('code@')}" for r in ranges]
    out = STATE / "diffs" / f"{ticket}-{hashlib.sha1(' '.join(specs).encode()).hexdigest()[:8]}.html"
    if out.exists():
        return out, 200, ""
    out.parent.mkdir(parents=True, exist_ok=True)
    command = [str(HERE / "diffview"), *specs, "-o", str(out), "--no-auto-summary", "--title", f"{ticket} · diff"]
    try:
        run = subprocess.run(command, cwd=code, capture_output=True, text=True, check=False, timeout=300)
    except subprocess.TimeoutExpired:
        why = f"diffview {' '.join(specs)} took over 300 s"
    else:
        if out.exists():
            return out, 200, ""
        why = f"diffview {' '.join(specs)} failed: {run.stderr.strip()[-500:]}"
    print(f"rendering {ticket}'s diff: {why}", file=sys.stderr, flush=True)
    return None, 502, why


def trellis(name: str) -> Path | None:
    """A cached file is checked on every use, and one that fails stays put: it is refused, never fetched over."""
    cache = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "container-hub" / f"trellis-{TRELLIS_VERSION}"
    path = cache / name
    if path.is_file():
        if hashlib.sha256(path.read_bytes()).hexdigest() != TRELLIS[name]:
            raise OSError(f"{path} does not match its pinned sha256; delete it to fetch it again")
    else:
        cache.mkdir(parents=True, exist_ok=True)
        # curl rather than urllib: uv's Python finds no CA bundle on NixOS
        run = subprocess.run(["curl", "-fsSL", "--max-time", "30", TRELLIS_URL + name], capture_output=True, check=False)
        body = run.stdout
        if run.returncode != 0:
            raise OSError(f"curl {TRELLIS_URL}{name}: {run.stderr.decode(errors='replace').strip()}")
        if hashlib.sha256(body).hexdigest() != TRELLIS[name]:
            raise OSError(f"{TRELLIS_URL}{name} does not match the pinned sha256")
        tmp = path.with_suffix(".tmp")
        tmp.write_bytes(body)
        os.replace(tmp, path)
    return path


# --------------------------------------------------------------------------
# the server
# --------------------------------------------------------------------------


def load_diffview():
    """diffview's own module, beside this script, so a page served here saves through the same code."""
    path = HERE / "diffview"
    if not path.is_file():
        return None
    loader = importlib.machinery.SourceFileLoader("diffview", str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("diffview", loader))
    sys.dont_write_bytecode = True  # its cache would land in bin/, which is on PATH
    loader.exec_module(module)
    return module


diffview = load_diffview()


# First in every page the hub serves, so the hub tab (wcCatch) has the page's links before any of them can be clicked.
# Outside the hub tab it does nothing.
CATCH_LINKS = b"<script>try{top.wcCatch?.(window)}catch{}</script>"
# The call goes after a byte order mark and a doctype; ahead of either, it would put the page in quirks mode.
FIRST = re.compile(rb"(?:\xef\xbb\xbf)?(?:(?:\s|<!--.*?-->)*<!doctype[^>]*>)?", re.I | re.S)


def with_links_caught(page: bytes) -> bytes:
    at = FIRST.match(page).end()
    return page[:at] + CATCH_LINKS + page[at:]


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def send(self, code: int, body: bytes, ctype: str, headers: dict | None = None) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def send_page(self, page: bytes, ctype: str = "text/html; charset=utf-8") -> None:
        """A page the hub tab may frame."""
        self.send(200, with_links_caught(page), ctype)

    def send_json(self, obj, code: int = 200) -> None:
        self.send(code, json.dumps(obj).encode(), "application/json")

    def send_file(self, path: Path) -> None:
        # a shared directory with no index.html lists its pages
        if path.is_dir() and not (path / "index.html").is_file() and any(path.is_relative_to(d) for d in SHARED):
            return self.send_page(listing(path))
        if path.is_dir():
            path = path / "index.html"
        if not path.is_file():
            return self.send(404, f"{path} does not exist".encode(), "text/plain")
        ctype = "text/plain; charset=utf-8" if path.suffix == ".md" else mimetypes.guess_type(path.name)[0] or "application/octet-stream"
        if ctype == "text/html":
            return self.send_page(path.read_bytes(), ctype)
        self.send(200, path.read_bytes(), ctype)

    def port(self) -> int:
        return self.server.server_address[1]

    def local(self) -> bool:
        """A web page can point a name at 127.0.0.1, so only these Host headers are answered."""
        return (self.headers.get("Host") or "").lower() in (f"127.0.0.1:{self.port()}", f"localhost:{self.port()}")

    def do_GET(self):
        if not self.local():
            return self.send(403, b"forbidden", "text/plain")
        parts = urllib.parse.urlsplit(self.path)
        path = parts.path
        if path == "/.health":  # a diffview page asks this before it offers its comment controls
            return self.send_json({"saves": diffview is not None})
        if path.startswith("/c/"):  # a container view's address, from before units
            return self.send(302, b"", "text/plain", {"Location": "/"})
        if path == "/" or path.startswith("/u/"):
            tab = (HERE / "container-hub.html").read_text().replace('"__RESTART__"', json.dumps(restart_command()))
            tab = tab.replace("__TOKEN__", TOKEN if top_level(self.headers) else "")
            return self.send(200, tab.encode(), "text/html; charset=utf-8")
        if path.startswith("/static/trellis/") and (name := path.rsplit("/", 1)[-1]) in TRELLIS:
            try:
                return self.send_file(trellis(name))
            except OSError as e:
                print(f"trellis {name}: {e}", file=sys.stderr, flush=True)
                return self.send(502, f"trellis could not be served: {e}".encode(), "text/plain")
        if path == "/api/hub":
            return self.send_json(hub_view())
        if path.startswith("/api/u/"):
            key = urllib.parse.unquote(path.removeprefix("/api/u/"))
            view = next((u for u in hub_view()["units"] if u["unit"] == key), None)
            return self.send_json(view) if view else self.send_json({"error": "no such unit"}, 404)
        if path == "/events":
            return self.stream()
        if key := stand_in_key(path):
            view = next((u for u in hub_view()["units"] if u["unit"] == key), None)
            return self.send_page(stand_in_page(view)) if view else self.send(404, b"no such unit", "text/plain")
        if path == "/diff":
            query = urllib.parse.parse_qs(parts.query)
            page, status, why = render_diff(Path(query.get("tracker", [""])[0]), query.get("ticket", [""])[0])
            if not page:
                return self.send(status, why.encode(), "text/plain; charset=utf-8")
            return self.send(302, b"", "text/plain", {"Location": "/f" + urllib.parse.quote(str(page))})
        if path.startswith("/f/"):
            target = Path(urllib.parse.unquote(path.removeprefix("/f"))).resolve()
            if not servable(target):
                return self.send(403, b"not a page the hub serves", "text/plain")
            if diffview and (page := diffview.page_beside(target, (".watch.json",))) and page.is_file():
                return self.send_json(diffview.watch_record(page))  # with whether its watcher still runs
            if not target.exists() and diffview and diffview.is_beside_page(target):
                return self.send(200, b"null", "application/json")  # nothing saved beside the page yet
            if target.is_dir() and not path.endswith("/"):  # the pages in it link relative to it
                return self.send(301, b"", "text/plain", {"Location": path + "/" + (f"?{parts.query}" if parts.query else "")})
            return self.send_file(target)
        self.send(404, b"not found", "text/plain")

    def stream(self) -> None:
        """A listener counts as a hub tab, which decides whether claude-browser opens one, so it goes the moment its
        tab closes rather than at the next write that fails. A tab that starts listening has the hub tab it was
        opened as: the next open with none listening may open another at once."""
        global launched_at
        q: queue.Queue = queue.Queue()
        try:
            seen_by[q] = view_digest()
        except Exception as e:  # without a digest, the disk watch's first round tells this listener to read again
            print(f"listening: {e}", file=sys.stderr, flush=True)
        with lock:
            listeners.append(q)
            launched_at = 0.0
            for when, event in unheard:
                if time.time() - when < 10:
                    q.put(event)
            unheard.clear()
        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(b"retry: 1000\n: connected\n\n")  # a dropped stream is back within a second
            self.wfile.flush()
            quiet = 0
            while not self.peer_gone():
                try:
                    self.wfile.write(f"data: {json.dumps(q.get(timeout=1))}\n\n".encode())
                except queue.Empty:
                    if (quiet := quiet + 1) < 15:
                        continue
                    self.wfile.write(b": keepalive\n\n")
                quiet = 0
                self.wfile.flush()
        except OSError:
            pass
        finally:
            with lock:
                listeners.remove(q)

    def peer_gone(self) -> bool:
        """An event stream's client sends nothing after its request, so its socket turning readable means it closed."""
        if not select.select([self.connection], [], [], 0)[0]:
            return False
        try:
            return self.connection.recv(1, socket.MSG_PEEK) == b""
        except OSError:
            return True

    def do_POST(self):
        if not self.local():
            return self.send(403, b"forbidden", "text/plain")
        path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
        if path.startswith("/f/") and diffview:
            if refused := diffview.write_refusal(self):
                return self.send(refused[0], refused[1], "text/plain")
            raw = self.rfile.read(int(self.headers["Content-Length"]))
            target = Path(path.removeprefix("/f")).resolve()
            if servable(target) and diffview.is_beside_page(target, (".summary.json",)):
                # a watched page asking its watcher for a new summary
                if diffview.request_summary(diffview.page_beside(target)):
                    return self.send(204, b"", "text/plain")
                return self.send(409, b"no diffview watcher runs for this page", "text/plain")
            if not servable(target) or not diffview.is_state_file(target):
                return self.send(403, b"forbidden", "text/plain")
            code, body = diffview.write_state(target, raw)
            return self.send(code, body, "application/json" if code == 409 else "text/plain")
        # a page on another site can POST to loopback; only this origin's pages and local tools (no Origin) may write
        if self.headers.get("Origin") not in (None, f"http://127.0.0.1:{self.port()}", f"http://localhost:{self.port()}"):
            return self.send(403, b"forbidden", "text/plain")
        if path in ("/api/type", "/api/drop") and not secrets.compare_digest(self.headers.get("X-Hub-Token") or "", TOKEN):
            return self.send_json({"error": "only the hub tab itself types into a session; reload the tab if it is one"}, 403)
        if path == "/api/drop":
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            size = int(self.headers.get("Content-Length") or 0)
            if size > DROP_LIMIT:
                return self.send_json({"error": f"over {DROP_LIMIT // 2**20} MB; give the session its path instead"}, 413)
            if not query.get("unit"):
                return self.send_json({"error": "no unit"}, 400)
            try:
                code, answer = drop(query["unit"][0], query.get("name", [""])[0], self.rfile.read(size))
            except OSError as e:
                code, answer = 500, {"error": f"{type(e).__name__}: {e}"}
            return self.send_json(answer, code)
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            if path == "/api/open":
                code, answer = open_page(body, self.port(), from_page=self.headers.get("Origin") is not None)
            elif path == "/api/serve":
                # a page in the hub tab must not widen what it can read
                code, answer = (403, {"error": "only a local tool may share"}) if self.headers.get("Origin") else share(body)
            elif path == "/api/type":
                code, answer = type_into(body)
            elif path in ("/api/close", "/api/visit", "/api/dismiss"):
                code, answer = mark(path.removeprefix("/api/"), body)
            else:
                code, answer = 404, {"error": "no such route"}
        except (KeyError, ValueError, TypeError) as e:
            code, answer = 400, {"error": f"{type(e).__name__}: {e}"}
        except OSError as e:  # the hub's own disk failed it, a file it keeps unreadable or a write refused
            code, answer = 500, {"error": f"{type(e).__name__}: {e}"}
        self.send_json(answer, code)


def view_digest() -> tuple[str, str]:
    """The hub's digest in two parts: what the layout is built from, and the statusline's numbers, which change at
    every step of a session's turn and redraw only the rail."""
    view = hub_view()
    numbers = {"usage": view.pop("usage"), "context": {u["unit"]: u.pop("context") for u in view["units"]}}
    return tuple(hashlib.sha1(json.dumps(x, sort_keys=True).encode()).hexdigest() for x in (view, numbers))


def restart_command() -> str:
    """What brings this hub back once it is gone: its user service where it runs as one, else the command that
    started it."""
    try:
        service = Path("/proc/self/cgroup").read_text().strip().endswith("/container-hub.service")
    except OSError:
        service = False
    return "systemctl --user restart container-hub" if service else shlex.join(["setsid", "-f", str(Path(sys.argv[0]).resolve()), *sys.argv[1:]])


def watch_disk() -> None:
    """A hub tab that is showing hears when the disk under it changes: a ticket's status, a page deleted, a new
    artefact, a session finishing a turn. Read only while a tab listens."""
    while True:
        time.sleep(2)
        with lock:
            watching = list(listeners)
        if not watching:
            continue
        try:
            digest = view_digest()
        except Exception as e:  # a ticket or page changing under the read: the next round reads it again
            print(f"watching: {e}", file=sys.stderr, flush=True)
            continue
        for q in watching:
            heard = seen_by.get(q)
            if not heard or heard[0] != digest[0]:
                q.put({"type": "disk"})
            elif heard[1] != digest[1]:
                q.put({"type": "numbers"})
            seen_by[q] = digest


def migrate() -> None:
    """Move the pages of the containers the hub kept before units into the units of the sessions that opened them;
    then set the containers aside. Their other marks are dropped: the closes and visits of a container's groups are
    the units' now, and its key and name follow from disk."""
    old = STATE / "containers"
    if not old.is_dir():
        return
    units, unread = {}, []
    for path in sorted(old.glob("*.json")):
        try:
            data = read_json(path)
        except OSError as e:
            unread.append(f"{path}: {e}")
            continue
        if not isinstance(data, dict):
            continue
        for m in data.get("members") or []:
            if m.get("kind") == "board":  # the rail's, never a unit's
                continue
            key = m.get("group") or LOOSE
            unit = units.get(key) or load(key) or new_unit(key)
            if all(x["id"] != m["id"] for x in unit["members"]):
                unit["members"].append({**{k: v for k, v in m.items() if k != "group"}, "tracker": m.get("tracker") or data.get("tracker")})
            unit["visited"] = max(unit.get("visited") or 0, (data.get("visited") or {}).get(key, 0))
            units[key] = unit
    for unit in units.values():
        save(unit)
    if unread:  # left where they are, to be moved in on a start that can read them
        print("starting without the pages of " + "; ".join(unread), file=sys.stderr, flush=True)
        return
    os.replace(old, STATE / f"containers.before-units-{time.time_ns()}")
    print(f"moved the containers' pages into {len(units)} units, and set {old} aside", file=sys.stderr, flush=True)


def repair(data: dict) -> bool:
    """Bring a unit an earlier hub kept to the shape this one reads: no board among its pages, the board being the
    rail's, and the tracker on each page rather than on the unit. True where it changed."""
    tracker = data.pop("tracker", None)
    members = [{**m, "tracker": m.get("tracker") or tracker} for m in data["members"] if m.get("kind") != "board"]
    changed = tracker is not None or members != data["members"]
    data["members"] = members
    return changed


def main(args: Args) -> None:
    global STATE, TOKEN, TMUX_SOCKET
    STATE = args.state.expanduser().resolve()
    TMUX_SOCKET = args.tmux_socket
    STATE.mkdir(parents=True, exist_ok=True)
    TOKEN = load_token()
    (STATE / "seen.json").unlink(missing_ok=True)  # the seen marks an earlier hub kept
    try:
        migrate()
    except OSError as e:  # the hub starts on what units there are; the containers stay where they are
        print(f"moving the containers into units: {e}", file=sys.stderr, flush=True)
    for path in (STATE / "units").glob("*.json"):
        try:
            data = load(urllib.parse.unquote(path.stem)) or {"members": []}
        except OSError as e:  # the hub starts without that unit's pages; the file is left as it is
            print(f"starting without {path}: {e}", file=sys.stderr, flush=True)
            continue
        if data.get("key") and repair(data):
            save(data)
        OPENED.update(Path(m["path"]) for m in data["members"] if m.get("path") and m.get("agent"))
    try:
        listed = load_shared()
    except OSError as e:  # left as it is, like an unreadable unit
        print(f"starting without what {shared_file()} shares: {e}", file=sys.stderr, flush=True)
    else:
        kept = [p for p in listed if Path(p).exists()]  # a page deleted since stops being served
        for path in map(Path, kept):
            (SHARED if path.is_dir() else OPENED).add(path)
        if kept != listed:
            write_json(shared_file(), kept)
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    server.daemon_threads = True
    threading.Thread(target=watch_disk, daemon=True).start()
    print(f"container-hub on http://127.0.0.1:{args.port}/, state in {STATE}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main(tyro.cli(Args, description=__doc__))
