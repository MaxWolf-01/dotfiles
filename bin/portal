#!/usr/bin/env bash
# Get past a captive portal, then restore the VPN. Self-contained: it must
# work with DNS and the tunnel both dead, because looking up instructions is
# not an option at exactly the moment this runs.
#
# The exit node goes first: pre-login the portal blocks the tunnel, so all
# traffic routed into it dies before DNS even matters.
set -uo pipefail

tailscale set --exit-node=

gw=$(ip route show default | awk '{print $3; exit}')
[[ -n $gw ]] || { echo "portal: no default route — connect to the wifi first" >&2; exit 1; }

# neverssl.com is plain HTTP that never upgrades to HTTPS, so the portal can
# hijack it into its login page. That needs the portal to answer DNS; when it
# doesn't, the gateway IP is where portals live or redirect from.
if curl -4 -s -m 4 -o /dev/null http://neverssl.com; then
  xdg-open http://neverssl.com
else
  xdg-open "http://$gw"
fi

echo "portal: log in in the browser — VPN comes back by itself once the internet works"
for _ in $(seq 1 60); do
  sleep 5
  # 204 means a real answer from the detector; a portal intercepting the
  # request returns its login page (200/30x), and dead DNS returns 000.
  code=$(curl -4 -s -m 3 -o /dev/null -w '%{http_code}' http://connectivity-check.ubuntu.com)
  if [[ $code == 204 ]]; then
    exec vpn-pick
  fi
done
echo "portal: still captive after 5 min — once you're through, run: vpn-on" >&2
exit 1
