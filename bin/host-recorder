#!/usr/bin/env bash
# The host recorder: every few seconds, what this machine's memory, CPU and
# sensors are doing, into a daily CSV.
#
# Exists to answer "why did it die?" after the fact. A hang or a hard power cut
# leaves nothing in the journal, so these samples are the only record of what
# the machine was doing in its last seconds. No explicit fsync: ext4's journal
# commit (5s default) already lands the tail within ~2 samples of a power cut,
# so per-line fsync bought one extra sample for 17k forced flushes a day.
#
# Every host records the same core: the fastest CPU core's clock, load,
# available memory, used swap, and memory pressure, the share of the last 10 s
# in which some task (mem_some_avg10) or every task (mem_full_avg10) stalled
# waiting for memory. Pressure rises before a machine locks up for lack of
# memory, while available memory can still look fine.
#
# The rest of a row is the host's sensor set, picked by host name rather than
# by what is present, so a host's columns never change and a sensor missing at
# start is an empty field like one that vanishes later:
#
# - zephylux, the ASUS Zephyrus: CPU and board temperatures, fans, the two ASUS
#   EC power rails (see asus-power-cap: a profile switch can silently drop the
#   cap, and that shows up here as the rails moving), mains and battery, and
#   whether the dGPU is powered. The dGPU shares the CPU's heatpipes but not
#   its power cap, so the recorder logs the ASUS firmware switch that cuts it
#   off (dgpu_disable), the power state of the PCIe port feeding it (D3cold:
#   its power rail is off), and whether a driver holds it. Its temperature is
#   not logged: only the NVIDIA driver can report it, and any query through
#   the driver wakes a sleeping GPU, so polling it every sample would keep
#   awake the heat source it is meant to catch.
# - pc: k10temp's Tctl and CCD temperatures, the NVMe drive's composite
#   temperature, the six board temperatures gigabyte_wmi reports (the driver
#   names none of them, so they are columns wmi1_c to wmi6_c), and acpitz.
#
# Any other host records the core alone.
#
# Once a minute it also writes whose memory and CPU it is, one row per cgroup
# (one per app, tmux pane or service): every cgroup holding over 512 MB the
# kernel cannot simply drop (anonymous, shared and swapped), at most ten, and
# every one that used over 10% of a core in the last minute, at most five. A
# tmux pane over 512 MB is a row whatever the cap: on pc each pane is one
# worker, and which one grew is the question the ranking answers. A (rest) row
# carries everything else, so the rows add up to the system's total. Each row
# names the systemd manager that owns the cgroup (system or user@<uid>), its
# largest process and that process's working directory, which is what tells
# one agent pane from another, and the cgroup's memory pressure over the last
# minute. A pane's cgroup (tmux-spawn-*.scope) sits in its user manager's
# app.slice on a laptop and directly under the user manager on pc; the walk
# takes both.
#
# Once an hour it writes every cgroup's cumulative CPU counter as well. The
# ranking shows what burned in a given minute; the counters, with systemd's
# per-unit totals for units that stopped, give every unit's CPU over any window,
# down to the smallest (host-recorder-report).
#
# The sampling loop is bash-builtin only — no command substitutions, no awk,
# no date, no children. This runs 17k times a day forever; forks made it cost
# ~1% of a core (measured 49 ms CPU per sample), builtins take it to ~5 ms —
# the floor set by the sysfs/EC sensor reads themselves. On pc a sample costs
# ~4 ms, and the core's own reads under 1 ms of it: gigabyte_wmi's six board
# temperatures are an ACPI method call each (~0.4 ms). A ranking costs ~22 ms
# there, 2 ms a sample spread over the minute.
#
# HOST_RECORDER_ROOT stands in for / : every /sys and /proc path is read under
# it, which is how tests/properties/host-recorder.test runs the recorder on a
# machine it makes up.
#
# Usage:   host-recorder [interval-seconds]     default 5
# Output:  $STATE_DIRECTORY when systemd gives one, else
#          ~/.local/state/host-recorder: YYYY-MM-DD.csv, YYYY-MM-DD.top.csv for
#          the per-minute ranking, YYYY-MM-DD.counters.csv for the hourly
#          counters; all pruned after 14 days
# Read it: host-recorder-report (--help), or by hand in that directory:
#          column -s, -t $(date +%F).csv | less -S
set -uo pipefail
shopt -s nullglob

INTERVAL=${1:-5}
ROOT=${HOST_RECORDER_ROOT:-}
LOGDIR=${STATE_DIRECTORY:-${XDG_STATE_HOME:-$HOME/.local/state}/host-recorder}
KEEP_DAYS=14
TOP_EVERY=12   # samples between rankings: once a minute at 5 s
MEM_MIN_MB=512
MEM_ROWS=10
CPU_MIN_PCT=10 # of one core, averaged since the previous ranking
CPU_ROWS=5
TOP_HEADER="time,manager,unit,cpu_pct,anon_mb,shmem_mb,swap_mb,procs,process,cwd,mem_some_avg60,mem_full_avg60"
# cpu.stat usage per cgroup, kept in two tables that swap roles each ranking
# (the previous one's and this one's), so nothing is copied; plus when the
# previous ranking ran and the root's usage then.
# shellcheck disable=SC2034  # used through write_top's namerefs
declare -A CPU_A=() CPU_B=()
CPU_FLIP=0
CPU_PREV_T=0
ROOT_CPU_PREV=0
CPU_HEADER="time,manager,unit,usage_usec"
CPU_DUMP_HOUR=  # "YYYY-MM-DD HH" of the last counter dump
CORE_HEADER="time,mhz_max,load1,mem_avail_mb,swap_used_mb,mem_some_avg10,mem_full_avg10"

# A sensor set <set> is sensors_<set>_find, which looks its devices up by name,
# sensors_<set>_read, which sets SENSORS to its fields, and its columns here.
# SENSOR_SET maps the kernel's host name to a set, named as the repo names the
# host (nix/home/hosts/<name>): the laptop is zephylux to the kernel.
declare -A SENSOR_SET=([zephylux]=zephyrus [pc]=pc)
declare -A SENSOR_COLUMNS=(
    [zephyrus]="pkg_c,cpu_c,board_c,cpu_rpm,gpu_rpm,profile,spl_w,sppt_w,ac,bat_pct,bat_w,dgpu_disable,dgpu_port,dgpu_drv"
    [pc]="cpu_c,ccd1_c,nvme_c,board_c,wmi1_c,wmi2_c,wmi3_c,wmi4_c,wmi5_c,wmi6_c"
)

ATTRS=$ROOT/sys/class/firmware-attributes/asus-armoury/attributes
# Fixed addresses rather than a lookup: in Integrated mode the dGPU is off the
# bus, so at startup there is often nothing to find.
DGPU=$ROOT/sys/bus/pci/devices/0000:01:00.0
DGPU_PORT=$ROOT/sys/bus/pci/devices/0000:00:01.0

main() {
    local host=
    read -r host 2>/dev/null < "$ROOT/proc/sys/kernel/hostname"
    SET=${host:+${SENSOR_SET[$host]:-}}
    HEADER=$CORE_HEADER${SET:+,${SENSOR_COLUMNS[$SET]}}
    mkdir -p "$LOGDIR" || { echo "host-recorder: cannot create $LOGDIR" >&2; exit 1; }
    find "$LOGDIR" -name '*.csv' -mtime "+$KEEP_DAYS" -delete
    # A pipe nothing ever writes to: read -t on it is a builtin sleep, saving a
    # fork+exec (~4 ms) per sample.
    exec {idle}<> <(:)
    local today
    printf -v today '%(%F)T' -1
    continue_day "$LOGDIR/$today.csv" "$HEADER"
    continue_day "$LOGDIR/$today.top.csv" "$TOP_HEADER"
    continue_day "$LOGDIR/$today.counters.csv" "$CPU_HEADER"
    find_sensors
    local n=0
    while :; do
        write_sample
        if ! ((n++ % TOP_EVERY)); then
            write_top
            find_sensors
        fi
        read -rt "$INTERVAL" -u "$idle" || :
    done
}

# continue_day <file> <header>: readies a day file this run appends to. A power
# cut can leave its last row cut short: it is marked ,torn and its line ended
# here, or the next row would be glued onto it. A file begun under other
# columns (an older recorder, a sensor added to the set) gets this run's header
# below its rows, and the reader takes each row by the header above it.
continue_day() {
    local line last=
    [ -f "$1" ] || return 0
    while IFS= read -r line; do
        [[ $line == time,* ]] && last=$line
    done < "$1"
    # read fails on a last line with no newline, leaving it in line.
    [ -z "$line" ] || echo ,torn >> "$1"
    [ "$last" = "$2" ] || echo "$2" >> "$1"
}

# At start and after every ranking: a device's number is not stable across
# boots, and a driver that loads after the recorder starts still gets found.
find_sensors() {
    [ -z "$SET" ] || "sensors_${SET}_find"
}

write_sample() {
    local today file
    printf -v today '%(%F)T' -1
    file="$LOGDIR/$today.csv"
    [ -f "$file" ] || echo "$HEADER" > "$file"
    row
    printf '%s\n' "$ROW" >> "$file"
}

# Sets ROW. Every field lands in a global set by a builtin — a $(…) here would
# fork, which is what this loop exists to avoid.
row() {
    local stamp
    printf -v stamp '%(%F %T)T' -1
    cpu_mhz_max
    load1
    memory
    psi "$ROOT/proc/pressure/memory" avg10
    ROW="$stamp,$MHZ_MAX,$LOAD1,$MEM_AVAIL_MB,$SWAP_USED_MB,$PSI_SOME,$PSI_FULL"
    [ -z "$SET" ] && return
    "sensors_${SET}_read"
    ROW+=",$SENSORS"
}

# --- zephyrus's sensor set ---

sensors_zephyrus_find() {
    zone_by_type x86_pkg_temp ZONE_PKG
    zone_by_type TCPU         ZONE_CPU
    zone_by_type acpitz       ZONE_BOARD
    mains_online AC_ONLINE
    hwmon_by_name asus ASUS
}

sensors_zephyrus_read() {
    millideg "$ZONE_PKG"    PKG_C
    millideg "$ZONE_CPU"    CPU_C
    millideg "$ZONE_BOARD"  BOARD_C
    rd "${ASUS:+$ASUS/fan1_input}"                  CPU_RPM
    rd "${ASUS:+$ASUS/fan2_input}"                  GPU_RPM
    rd "$ROOT/sys/firmware/acpi/platform_profile"   PROFILE
    rd "$ATTRS/ppt_pl1_spl/current_value"           SPL_W
    rd "$ATTRS/ppt_pl2_sppt/current_value"          SPPT_W
    rd "$AC_ONLINE"                                 AC
    rd "$ROOT/sys/class/power_supply/BAT0/capacity" BAT_PCT
    microwatts "$ROOT/sys/class/power_supply/BAT0/power_now" BAT_W
    rd "$ATTRS/dgpu_disable/current_value"          DGPU_DISABLE
    rd "$DGPU_PORT/power_state"                     DGPU_PORT_PM
    dgpu_driver
    SENSORS="$PKG_C,$CPU_C,$BOARD_C,$CPU_RPM,$GPU_RPM,$PROFILE,$SPL_W,$SPPT_W,$AC,$BAT_PCT,$BAT_W,$DGPU_DISABLE,$DGPU_PORT_PM,$DGPU_DRV"
}

# DGPU_DRV: 1 when a driver holds the dGPU, 0 when it is on the bus without one
# (powered, with nothing to put it to sleep), empty when it is off the bus.
dgpu_driver() {
    DGPU_DRV=
    [ -e "$DGPU" ] || return 0
    if [ -e "$DGPU/driver" ]; then DGPU_DRV=1; else DGPU_DRV=0; fi
}

# --- pc's sensor set ---

sensors_pc_find() {
    hwmon_by_name k10temp      K10TEMP
    hwmon_by_name nvme         NVME
    hwmon_by_name gigabyte_wmi WMI
    zone_by_type  acpitz       ZONE_BOARD
}

# k10temp's temp1 is Tctl and temp3 the first CCD; the NVMe driver's temp1 is
# the drive's composite, the one it throttles on.
sensors_pc_read() {
    local i t wmi=
    millideg "${K10TEMP:+$K10TEMP/temp1_input}" CPU_C
    millideg "${K10TEMP:+$K10TEMP/temp3_input}" CCD1_C
    millideg "${NVME:+$NVME/temp1_input}"       NVME_C
    millideg "$ZONE_BOARD"                      BOARD_C
    for i in 1 2 3 4 5 6; do
        millideg "${WMI:+$WMI/temp${i}_input}" t
        wmi+=",$t"
    done
    SENSORS="$CPU_C,$CCD1_C,$NVME_C,$BOARD_C$wmi"
}

# --- the core ---

memory() {
    local key kb avail=0 swap_total=0 swap_free=0
    while read -r key kb _; do
        case $key in
            MemAvailable:) avail=$kb ;;
            SwapTotal:)    swap_total=$kb ;;
            SwapFree:)     swap_free=$kb; break ;;
        esac
    done < "$ROOT/proc/meminfo"
    MEM_AVAIL_MB=$((avail / 1024))
    SWAP_USED_MB=$(((swap_total - swap_free) / 1024))
}

# psi <pressure file> <avg10|avg60>: PSI_SOME and PSI_FULL, the percent of that
# window in which some task or every task stalled; empty if it is unreadable.
psi() {
    local kind avg10 avg60 v
    PSI_SOME='' PSI_FULL=''
    [ -r "$1" ] || return 0
    while read -r kind avg10 avg60 _; do
        if [ "$2" = avg10 ]; then v=${avg10#avg10=}; else v=${avg60#avg60=}; fi
        case $kind in
            some) PSI_SOME=$v ;;
            full) PSI_FULL=$v ;;
        esac
    done 2>/dev/null < "$1"
}

# Memory is ranked in two passes because memory.stat costs ~5x a memory.current
# read: every cgroup by memory.current + swap, which also counts droppable file
# cache, then the largest few by what memory.stat says cannot be dropped. CPU is
# each cgroup's cpu.stat usage since the previous ranking; the first ranking
# after a start has nothing to compare against and leaves cpu_pct empty.
write_top() {
    local today stamp file d cur swp use prev v now elapsed=0 cpu_min unit pct line key val root_use out=
    local listed_anon=0 listed_shmem=0 listed_swap=0 listed_cpu=0
    local rest_anon=0 rest_shmem=0 rest_swap rest_cpu=
    local pool_max=$((2 * MEM_ROWS))
    local -a panes=()
    local -A used=() m_anon=() m_shmem=() m_swap=() listed=()
    local prev_table=CPU_A next_table=CPU_B
    ((CPU_FLIP)) && prev_table=CPU_B next_table=CPU_A
    local -n cpu_prev=$prev_table cpu_next=$next_table
    cpu_next=()
    printf -v today '%(%F)T' -1
    printf -v stamp '%(%F %T)T' -1
    file="$LOGDIR/$today.top.csv"
    [ -f "$file" ] || echo "$TOP_HEADER" > "$file"

    now=${EPOCHREALTIME/[.,]/}
    ((CPU_PREV_T)) && elapsed=$((now - CPU_PREV_T))
    cpu_min=$((elapsed * CPU_MIN_PCT / 100))

    # ~190 cgroups: plain reads and early size checks, since a call to rd or
    # insert_top per cgroup costs more than the reads themselves. memory.current
    # + swap bounds what memory.stat can report, so a cgroup under MEM_MIN_MB
    # here cannot make the list and is never read in full.
    POOL_V=() POOL_I=() BURN_V=() BURN_I=()
    for d in "$ROOT"/sys/fs/cgroup/system.slice/*/ \
             "$ROOT"/sys/fs/cgroup/user.slice/user-*.slice/session-*.scope/ \
             "$ROOT"/sys/fs/cgroup/user.slice/user-*.slice/user@*.service/*.slice/*/ \
             "$ROOT"/sys/fs/cgroup/user.slice/user-*.slice/user@*.service/*.scope/; do
        read -r cur 2>/dev/null < "${d}memory.current" || continue
        read -r swp 2>/dev/null < "${d}memory.swap.current" || swp=0
        read -r _ use 2>/dev/null < "${d}cpu.stat" || use=0
        # shellcheck disable=SC2034  # a nameref: read back next ranking as cpu_prev
        cpu_next[$d]=$use
        # A cgroup born or restarted since the last ranking used all of its
        # time within it.
        prev=${cpu_prev[$d]:-0}
        ((use >= prev)) && use=$((use - prev))
        if ((elapsed && use >= cpu_min)); then
            used[$d]=$use
            ((${#BURN_V[@]} < CPU_ROWS || use > BURN_V[CPU_ROWS - 1])) \
                && insert_top BURN_V BURN_I "$CPU_ROWS" "$use" "$d"
        fi
        v=$((cur + swp))
        ((v >> 20 >= MEM_MIN_MB)) || continue
        used[$d]=$use
        if [[ $d == */tmux-spawn-*.scope/ ]]; then
            panes+=("$d")
        elif ((${#POOL_V[@]} < pool_max || v > POOL_V[pool_max - 1])); then
            insert_top POOL_V POOL_I "$pool_max" "$v" "$d"
        fi
    done
    CPU_FLIP=$((!CPU_FLIP)) CPU_PREV_T=$now

    # shellcheck disable=SC2034  # filled through insert_top's nameref
    HOLD_V=() HOLD_I=() PANE_V=() PANE_I=()
    for d in "${POOL_I[@]}" "${panes[@]}"; do
        mem_stat "$d"
        m_anon[$d]=$ANON m_shmem[$d]=$SHMEM m_swap[$d]=$SWP
        v=$((ANON + SHMEM + SWP))
        ((v >> 20 >= MEM_MIN_MB)) || continue
        if [[ $d == */tmux-spawn-*.scope/ ]]; then
            insert_top PANE_V PANE_I "${#panes[@]}" "$v" "$d"
        else
            insert_top HOLD_V HOLD_I "$MEM_ROWS" "$v" "$d"
        fi
    done

    # Memory holders first, then the CPU users not already among them.
    for d in "${HOLD_I[@]}" "${PANE_I[@]}" "${BURN_I[@]}"; do
        [ -n "${listed[$d]:-}" ] && continue
        listed[$d]=1
        if [ -z "${m_anon[$d]:-}" ]; then
            mem_stat "$d"
            m_anon[$d]=$ANON m_shmem[$d]=$SHMEM m_swap[$d]=$SWP
        fi
        pct=
        if ((elapsed)); then
            pct=$((${used[$d]} * 100 / elapsed))
            listed_cpu=$((listed_cpu + ${used[$d]}))
        fi
        biggest_process "$d"
        psi "${d}memory.pressure" avg60
        unit=${d%/} unit=${unit##*/}
        manager_of "$d"
        printf -v line '%s,%s,%s,%s,%d,%d,%d,%d,%s,%s,%s,%s\n' "$stamp" "$MANAGER" "$unit" "$pct" \
            $((${m_anon[$d]} >> 20)) $((${m_shmem[$d]} >> 20)) $((${m_swap[$d]} >> 20)) \
            "$PROCS" "$PROC" "$CWD" "$PSI_SOME" "$PSI_FULL"
        out+=$line
        listed_anon=$((listed_anon + ${m_anon[$d]}))
        listed_shmem=$((listed_shmem + ${m_shmem[$d]}))
        listed_swap=$((listed_swap + ${m_swap[$d]}))
    done

    # (rest): the root cgroup's totals, and the system's swap from the sample
    # written just before, minus the rows above. The root's CPU time also holds
    # whatever ran in cgroups that ended within the minute.
    while read -r key val; do
        case $key in
            anon)  rest_anon=$((val - listed_anon)) ;;
            shmem) rest_shmem=$((val - listed_shmem)); break ;;
        esac
    done < "$ROOT/sys/fs/cgroup/memory.stat"
    rest_swap=$(((SWAP_USED_MB << 20) - listed_swap))
    read -r _ root_use < "$ROOT/sys/fs/cgroup/cpu.stat"
    if ((elapsed)); then
        rest_cpu=$(((root_use - ROOT_CPU_PREV - listed_cpu) * 100 / elapsed))
        ((rest_cpu > 0)) || rest_cpu=0
    fi
    ROOT_CPU_PREV=$root_use
    printf -v line '%s,,(rest),%s,%d,%d,%d,,,,,\n' "$stamp" "$rest_cpu" \
        $((rest_anon >> 20)) $((rest_shmem >> 20)) $((rest_swap > 0 ? rest_swap >> 20 : 0))
    printf '%s' "$out$line" >> "$file"

    # The first ranking of each hour also writes every counter it just read.
    [ "${stamp:0:13}" = "$CPU_DUMP_HOUR" ] && return 0
    CPU_DUMP_HOUR=${stamp:0:13}
    file="$LOGDIR/$today.counters.csv"
    [ -f "$file" ] || echo "$CPU_HEADER" > "$file"
    out="$stamp,system,(root),$root_use"$'\n'
    for d in "${!cpu_next[@]}"; do
        unit=${d%/} unit=${unit##*/}
        manager_of "$d"
        out+="$stamp,$MANAGER,$unit,${cpu_next[$d]}"$'\n'
    done
    printf '%s' "$out" >> "$file"
}

# manager_of <cgroup dir>: MANAGER, the systemd manager that owns the unit:
# system, or user@<uid> for that user's manager. A unit's name alone is
# ambiguous: the system bus and every user's session bus are all dbus.service,
# and on pc each worker runs its own docker.service.
manager_of() {
    if [[ $1 == */user@*.service/* ]]; then
        MANAGER=${1#*/user@} MANAGER=user@${MANAGER%%.service/*}
    else
        MANAGER=system
    fi
}

# insert_top <values> <items> <max> <value> <item>: keeps the two named arrays
# sorted by value, largest first, at most <max> long. A sort would fork.
insert_top() {
    local -n tv=$1 ti=$2
    local i=${#tv[@]}
    while ((i > 0 && $4 > tv[i - 1])); do
        tv[i]=${tv[i - 1]} ti[i]=${ti[i - 1]}
        ((i--))
    done
    ((i < $3)) || return 0
    tv[i]=$4 ti[i]=$5
    ((${#tv[@]} <= $3)) || unset 'tv[-1]' 'ti[-1]'
}

# mem_stat <cgroup dir>: ANON, SHMEM and SWP in bytes; 0 for a cgroup that has
# gone. memory.stat lists anon first and shmem tenth, so reading stops there.
mem_stat() {
    local key val
    ANON=0 SHMEM=0 SWP=0
    [ -r "${1}memory.stat" ] || return 0
    while read -r key val; do
        case $key in
            anon)  ANON=$val ;;
            shmem) SHMEM=$val; break ;;
        esac
    done < "${1}memory.stat"
    rd "${1}memory.swap.current" SWP
    SWP=${SWP:-0}
}

# biggest_process <cgroup dir>: PROCS, how many processes it holds; PROC, the
# name of the one with the largest resident set; CWD, that one's working
# directory. Together they say what a tmux pane or service was running. The
# pick ignores swap: reading a process's swap (/proc/PID/status) costs 27x its
# resident set (statm).
biggest_process() {
    local pid rss best=0 bestpid=
    PROCS=0 PROC='' CWD=''
    [ -r "${1}cgroup.procs" ] || return 0
    while read -r pid; do
        ((++PROCS))
        read -r _ rss _ 2>/dev/null < "$ROOT/proc/$pid/statm" || continue
        ((rss > best)) && best=$rss bestpid=$pid
    done < "${1}cgroup.procs"
    [ -n "$bestpid" ] || return 0
    read -r PROC 2>/dev/null < "$ROOT/proc/$bestpid/comm"
    # cd resolves the cwd link without forking a readlink. A system service
    # may have no HOME, and an empty one would prefix every path with ~.
    if cd -P "$ROOT/proc/$bestpid/cwd" 2>/dev/null; then
        CWD=$PWD
        [ -n "${HOME:-}" ] && CWD=${PWD/#"$HOME"/\~}
    fi
    cd / || :
    # One field each, on one line: a directory or a process can name itself
    # with a comma or a line break.
    PROC=${PROC//[$'\n\r',]/ } CWD=${CWD//[$'\n\r',]/ }
}

# --- device lookups and readings ---

# Zone and hwmon numbering is not stable across boots, so these match on names.
# Each sets the variable it is given to what it found, or empty.

zone_by_type() {  # zone_by_type <type> <var>: that zone's temp file
    local zone t
    printf -v "$2" ''
    for zone in "$ROOT"/sys/class/thermal/thermal_zone*; do
        rd "$zone/type" t
        [ "$t" = "$1" ] && { printf -v "$2" '%s' "$zone/temp"; return 0; }
    done
}

hwmon_by_name() {  # hwmon_by_name <name> <var>: that device's directory
    local mon n
    printf -v "$2" ''
    for mon in "$ROOT"/sys/class/hwmon/hwmon*; do
        rd "$mon/name" n
        [ "$n" = "$1" ] && { printf -v "$2" '%s' "$mon"; return 0; }
    done
}

mains_online() {  # mains_online <var>: the mains supply's online file
    local supply t
    printf -v "$1" ''
    for supply in "$ROOT"/sys/class/power_supply/*; do
        rd "$supply/type" t
        [ "$t" = Mains ] && { printf -v "$1" '%s' "$supply/online"; return 0; }
    done
}

millideg() {  # millideg <path> <var>: °C, or empty if the sensor vanished
    local raw
    rd "$1" raw
    printf -v "$2" '%s' "${raw:+$((raw / 1000))}"
}

microwatts() {  # microwatts <path> <var>: watts with one decimal
    local raw
    rd "$1" raw
    printf -v "$2" '%s' "${raw:+$((raw / 1000000)).$(((raw / 100000) % 10))}"
}

# Peak of the per-policy current frequencies, kHz → MHz. Cheaper than parsing
# /proc/cpuinfo, which the kernel regenerates (35 KB) on every read.
cpu_mhz_max() {
    local f khz peak=0
    for f in "$ROOT"/sys/devices/system/cpu/cpufreq/policy*/scaling_cur_freq; do
        read -r khz < "$f" 2>/dev/null || continue
        ((khz > peak)) && peak=$khz
    done
    MHZ_MAX=$((peak / 1000))
}

load1() {
    local rest
    read -r LOAD1 rest < "$ROOT/proc/loadavg"
}

# rd <path> <var>: never fail on a sensor that vanished — a missing reading is
# an empty field, not a dead recorder.
rd() {
    printf -v "$2" ''
    [ -n "${1:-}" ] && [ -r "$1" ] && read -r "$2" < "$1"
    return 0
}

main "$@"
