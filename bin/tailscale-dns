#!/usr/bin/env bash
# Manage tailnet-wide DNS via the Tailscale API (the CLI is read-only: `tailscale dns status`).
#
# Config source of truth: ~/.dotfiles/secrets/tailscale/dns.json (versioned).
#
# Token: passed in TS_API_TOKEN, never stored. A tailnet API token is full
# access — it can mint auth keys, which admit nodes with no interactive login.
# Mint one for the push at https://login.tailscale.com/admin/settings/keys and
# revoke it after:
#   TS_API_TOKEN=tskey-api-... tailscale-dns push
#
# Why this endpoint: /dns/nameservers takes a flat list of IPs and cannot express
# useWithExitNode, which is what keeps our resolvers in effect while a Mullvad
# exit node is up. /dns/config takes the structured dnstype.Resolver shape.
# It is undocumented but stable enough to be the only way to set that field
# outside the admin console. See docs/dns.md.
#
# GOTCHA: POST replaces the whole document. Omitting "proxied": true disables
# MagicDNS tailnet-wide. Always push the full file, never a partial object.
#
# Usage:
#   tailscale-dns get     # fetch live config
#   tailscale-dns diff    # live vs local file
#   tailscale-dns push    # upload local file (full replace)
set -euo pipefail

API=https://api.tailscale.com/api/v2
CONFIG="$HOME/.dotfiles/secrets/tailscale/dns.json"

api() {
  local token="${TS_API_TOKEN:?mint one at https://login.tailscale.com/admin/settings/keys, pass as TS_API_TOKEN, revoke after}"
  curl -sS --fail-with-body -H "Authorization: Bearer $token" "$@"
}

live() { api "$API/tailnet/-/dns/config" | jq -S .; }

require_config() {
  [ -f "$CONFIG" ] || { echo "tailscale-dns: config not found: $CONFIG" >&2; exit 1; }
  jq -e '.proxied == true' "$CONFIG" > /dev/null \
    || { echo "tailscale-dns: refusing to push, \"proxied\": true missing (would disable MagicDNS)" >&2; exit 1; }
}

case "${1:-}" in
  get)
    live
    ;;
  diff)
    require_config
    # Live echoes back keys we don't set (routes, domains, nameservers); compare
    # only the keys the file declares, so unset keys don't show as spurious drift.
    diff -u <(live | jq -S --slurpfile want "$CONFIG" '. as $g | $want[0] | keys | map({(.): $g[.]}) | add') \
            <(jq -S . "$CONFIG") \
      && echo "tailnet DNS matches $CONFIG"
    ;;
  push)
    require_config
    api -X POST -H "Content-Type: application/json" --data-binary "@$CONFIG" "$API/tailnet/-/dns/config" > /dev/null
    echo "tailnet DNS pushed"
    ;;
  *)
    sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
