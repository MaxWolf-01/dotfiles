#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["tyro"]
# ///
"""Index and search Claude Code sessions by AI-generated names and tags.

Scans ~/.claude/projects, and for every session with at least one user message
and one assistant reply, generates a descriptive dash-keyword name plus tags
from a fixed vocabulary via `claude -p`. Maintains a TSV index at ~/.claude/session-index.tsv
with columns: session_id, project, date, indexed_at, n_msgs, n_subst, chars,
duration_min, slug, tags, name.

Sessions touched after indexing (file mtime > indexed_at) are re-indexed on the
next run. Sessions modified within --settle-hours are deferred so active
sessions aren't named mid-flight.

Examples:

    session-index --days 7
    session-index --workers 4
    session-index --dry-run --days 3
    session-index --reindex cf75dab2-4df0-446b-9ea1-fe6702d9434d
    session-index --grep "evergreen distill"
    session-index --grep backup --tag infra
    session-index --tag junk
"""

import importlib.util
import json
import os
import re
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass
from datetime import datetime, timedelta
from pathlib import Path

import tyro

PROJECTS_DIR = Path.home() / ".claude" / "projects"
INDEX_PATH = Path.home() / ".claude" / "session-index.tsv"
COLUMNS = (
    "session_id", "project", "date", "indexed_at", "n_msgs", "n_subst",
    "chars", "duration_min", "slug", "tags", "name",
)
HEADER = "\t".join(COLUMNS)
CAP_CHARS = 100_000  # transcript cap: first half + last half around a truncation marker
SUBSTANTIVE_MIN_CHARS = 15  # user messages longer than this count as substantive

TAG_DESCRIPTIONS = {
    "dev": "building features or code",
    "debug": "diagnosing or fixing something broken",
    "infra": "system config, nix, dotfiles, backups, machine setup",
    "research": "investigating, learning, exploring a topic or codebase",
    "writing": "docs, notes, prose",
    "meta": "working on agent tooling itself — skills, prompts, CLAUDE.md, workflows",
    "qa": "one-shot or short question-and-answer",
    "personal": "personal life — health, journaling, self-reflection, life admin",
    "junk": "aborted, noise, no real work done",
    "other": "none of the above fit",
}

NAMING_PROMPT = f"""\
Name and tag this Claude Code session based on what was discussed and accomplished.

Output exactly two lines:
1. The name: lowercase keywords separated by dashes. Cover every major topic — detail differentiates similar sessions in a searchable index. If the session works a ticket/task file, lead with its name. If work was left unfinished, name what was actually done.
2. The tags: one or more of the following, comma-separated, most fitting first:
{chr(10).join(f"   {tag}: {desc}" for tag, desc in TAG_DESCRIPTIONS.items())}

Example outputs:

auth-migration-research-jwt-vs-sessions-decision
research,dev

nixos-pc-migration-zfs-gpu-timers-full-install
infra

garbled-keyboard-mash-no-actual-task
junk
"""


def _load_extractor():
    """Import extract-conversation.py (sibling script) as a module."""
    path = Path(__file__).resolve().parent / "extract-conversation.py"
    spec = importlib.util.spec_from_file_location("extract_conversation", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


XC = _load_extractor()


@dataclass
class Args:
    grep: str | None = None
    """Search the index: all terms must match against name+slug+tags."""

    tag: str | None = None
    """Search the index for sessions carrying this tag (combines with --grep)."""

    days: int | None = None
    """Only process sessions modified within the last N days."""

    project: str | None = None
    """Filter to projects whose directory name contains this string."""

    reindex: str | None = None
    """Force re-indexing of a specific session ID (ignores --settle-hours)."""

    model: str = "sonnet"
    """Model for naming/tagging (passed to claude -p --model)."""

    workers: int = 2
    """Concurrent claude -p calls."""

    settle_hours: float = 24.0
    """Skip sessions modified more recently than this, so active sessions aren't named mid-flight."""

    dry_run: bool = False
    """Show what would be indexed without calling the model."""


def main(args: Args) -> None:
    if args.grep or args.tag:
        do_search(args.grep, args.tag, args.project)
        return

    index = load_index()

    if args.reindex:
        sessions = [s for s in discover_sessions(None, None) if s[0] == args.reindex]
        if not sessions:
            print(f"Session not found: {args.reindex}", file=sys.stderr)
            sys.exit(1)
    else:
        sessions = discover_sessions(args.days, args.project)

    now = time.time()
    settle_cutoff = now - args.settle_hours * 3600
    candidates: list[tuple[str, str, Path]] = []
    deferred = up_to_date = 0
    for sid, proj, path in sessions:
        mtime = path.stat().st_mtime
        if args.reindex is None:
            if mtime > settle_cutoff:
                deferred += 1
                continue
            row = index.get(sid)
            if row and mtime <= iso_to_epoch(row["indexed_at"]) + 60:
                up_to_date += 1
                continue
        candidates.append((sid, proj, path))

    print(f"{len(candidates)} to index ({up_to_date} up to date, {deferred} deferred by --settle-hours)")
    if not candidates:
        return

    if args.dry_run:
        do_dry_run(candidates, index)
        return

    lock = threading.Lock()
    counters = {"done": 0, "ineligible": 0, "failed": 0, "reindexed": 0}
    total = len(candidates)

    def worker(sid: str, proj: str, path: Path) -> None:
        row, status = index_one(sid, proj, path, args.model)
        with lock:
            n = counters["done"] = counters["done"] + 1
            prefix = f"[{n}/{total}] {sid} ({proj})"
            if status != "ok":
                counters["failed" if status == "failed" else "ineligible"] += 1
                print(f"{prefix} — skipped ({status})")
                return
            if sid in index:
                remove_entry(sid)
                counters["reindexed"] += 1
            save_entry(row)
            print(f"{prefix} — {row['name']} [{row['tags']}]")

    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = [pool.submit(worker, *c) for c in candidates]
        for f in as_completed(futures):
            f.result()  # propagate exceptions

    print(
        f"\nIndexed {counters['done'] - counters['ineligible'] - counters['failed']} "
        f"({counters['reindexed']} re-indexed), "
        f"{counters['ineligible']} ineligible, {counters['failed']} failed."
    )


def index_one(sid: str, proj: str, path: Path, model: str) -> tuple[dict | None, str]:
    """Analyze one session and generate its index row. Returns (row, status)."""
    try:
        messages = XC.extract_conversation(path)
    except OSError as e:
        print(f"  read failed for {sid}: {e}", file=sys.stderr)
        return None, "failed"
    if not any(r == "user" for r, _ in messages) or not any(r == "assistant" for r, _ in messages):
        return None, "no user+assistant exchange"

    transcript = XC.format_xml(messages, path, len(messages))
    chars = len(transcript)
    if chars > CAP_CHARS:
        half = CAP_CHARS // 2
        transcript = transcript[:half] + "\n\n[... middle truncated ...]\n\n" + transcript[-half:]

    first_ts, last_ts, slug = scan_meta(path)
    duration_min = 0
    if first_ts and last_ts:
        duration_min = max(0, round((last_ts - first_ts).total_seconds() / 60))

    generated = generate_name_and_tags(transcript, model)
    if generated is None:
        return None, "failed"
    name, tags = generated

    return {
        "session_id": sid,
        "project": proj,
        "date": datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d"),
        "indexed_at": datetime.now().isoformat(timespec="seconds"),
        "n_msgs": str(len(messages)),
        "n_subst": str(sum(1 for r, t in messages if r == "user" and len(t) > SUBSTANTIVE_MIN_CHARS)),
        "chars": str(chars),
        "duration_min": str(duration_min),
        "slug": slug,
        "tags": tags,
        "name": name,
    }, "ok"


MAX_NAME_LEN = 100


def generate_name_and_tags(transcript: str, model: str) -> tuple[str, str] | None:
    """Call claude -p; parse name (line 1) and validated tags (line 2).

    Retries once if the model narrates instead of naming (name too long after
    sanitization); truncates as a last resort.
    """
    for _ in range(2):
        parsed = _call_model(transcript, model)
        if parsed is None:
            return None
        name, tags = parsed
        if name and len(name) <= MAX_NAME_LEN:
            return name, tags
    name = name[:MAX_NAME_LEN].rsplit("-", 1)[0] or name[:MAX_NAME_LEN]
    return (name, tags) if name else None


def _call_model(transcript: str, model: str) -> tuple[str, str] | None:
    result = subprocess.run(
        # Bare-metal call: our instructions replace the default system prompt,
        # no settings/skills/tools (skills contaminated names — the model
        # invoked mx:session-name and output the literal skill name), and no
        # session persistence (each call would otherwise write a session file
        # that the next indexing run picks up as a session to name).
        [
            "claude", "-p", "--model", model,
            "--system-prompt", NAMING_PROMPT,
            "--setting-sources", "",
            "--tools", "",
            "--disable-slash-commands",
            "--no-session-persistence",
            transcript,
        ],
        capture_output=True,
        text=True,
        env={**os.environ, "CLAUDECODE": ""},  # unset to allow nested invocation
    )
    if result.returncode != 0:
        print(f"  claude -p failed: {result.stderr.strip()}", file=sys.stderr)
        return None

    lines = [ln.strip().strip("`\"' ") for ln in result.stdout.splitlines() if ln.strip()]
    if not lines:
        return None
    name = re.sub(r"\s+", "-", lines[0].lower())
    name = re.sub(r"-{2,}", "-", re.sub(r"[^a-z0-9-]", "", name)).strip("-")
    raw = lines[1] if len(lines) > 1 else ""
    tags = [t for t in (s.strip().lower() for s in raw.split(",")) if t in TAG_DESCRIPTIONS]
    return name, ",".join(tags or ["other"])


def scan_meta(path: Path) -> tuple[datetime | None, datetime | None, str]:
    """One pass over the JSONL for first/last timestamp and slug."""
    slug = ""
    first_line = last_line = None
    try:
        for line in path.open():
            if not slug and '"slug"' in line:
                try:
                    slug = json.loads(line).get("slug") or ""
                except json.JSONDecodeError:
                    pass
            if '"timestamp"' in line:
                if first_line is None:
                    first_line = line
                last_line = line
    except OSError:
        return None, None, slug

    def parse_ts(line: str | None) -> datetime | None:
        if line is None:
            return None
        try:
            ts = json.loads(line).get("timestamp")
            return datetime.fromisoformat(ts.replace("Z", "+00:00")) if ts else None
        except (json.JSONDecodeError, ValueError, AttributeError):
            return None

    return parse_ts(first_line), parse_ts(last_line), slug


def discover_sessions(days: int | None, project_filter: str | None) -> list[tuple[str, str, Path]]:
    """Discover session files. Returns [(session_id, project_name, path)]."""
    if not PROJECTS_DIR.exists():
        return []

    cutoff = (datetime.now() - timedelta(days=days)).timestamp() if days else 0
    sessions = []
    for project_dir in sorted(PROJECTS_DIR.iterdir()):
        if not project_dir.is_dir():
            continue
        if project_filter and project_filter not in project_dir.name:
            continue
        for jsonl in project_dir.glob("*.jsonl"):
            if len(jsonl.stem) < 30:  # skip non-UUID filenames
                continue
            if jsonl.stem.startswith("agent-"):  # skip subagent transcripts
                continue
            if days and jsonl.stat().st_mtime < cutoff:
                continue
            sessions.append((jsonl.stem, project_dir.name, jsonl))

    # The same session file can exist in several project dirs (copied
    # fixtures); keep only the most recently modified copy per session id.
    by_sid: dict[str, tuple[str, str, Path]] = {}
    for sid, proj, path in sessions:
        if sid not in by_sid or path.stat().st_mtime > by_sid[sid][2].stat().st_mtime:
            by_sid[sid] = (sid, proj, path)
    return list(by_sid.values())


def do_dry_run(candidates: list[tuple[str, str, Path]], index: dict[str, dict]) -> None:
    ineligible = 0
    for sid, proj, path in candidates:
        messages = XC.extract_conversation(path)
        if not any(r == "user" for r, _ in messages) or not any(r == "assistant" for r, _ in messages):
            ineligible += 1
            continue
        chars = len(XC.format_xml(messages, path, len(messages)))
        date = datetime.fromtimestamp(path.stat().st_mtime).strftime("%Y-%m-%d")
        marker = "re-index" if sid in index else "new"
        print(f"  {sid}  {proj:<45} {date}  {len(messages):3d}msgs {chars:7,}ch  {marker}")
    print(f"\n{len(candidates) - ineligible} would be indexed, {ineligible} ineligible (no user+assistant exchange).")


def do_search(query: str | None, tag: str | None, project_filter: str | None) -> None:
    rows = load_index()
    if not rows:
        print("No index found. Run session-index first to build it.", file=sys.stderr)
        sys.exit(1)

    terms = query.lower().split() if query else []
    print(f"{'SESSION ID':<38} {'PROJECT':<38} {'DATE':<11} {'TAGS':<15} NAME")
    matches = 0
    for row in rows.values():
        if project_filter and project_filter not in row["project"]:
            continue
        if tag and tag not in row["tags"].split(","):
            continue
        searchable = f"{row['name']} {row['slug']} {row['tags']}".lower()
        if not all(t in searchable for t in terms):
            continue
        matches += 1
        display = row["name"] + (f" (slug: {row['slug']})" if row["slug"] else "")
        print(f"{row['session_id']:<38} {row['project']:<38} {row['date']:<11} {row['tags']:<15} {display}")
    if not matches:
        print("(no matches)", file=sys.stderr)


def load_index() -> dict[str, dict]:
    """Load the index as {session_id: row dict}. Backs up and discards pre-tags-format files."""
    if not INDEX_PATH.exists():
        return {}
    lines = INDEX_PATH.read_text().splitlines()
    if not lines or lines[0] != HEADER:
        backup = INDEX_PATH.with_suffix(".tsv.bak")
        INDEX_PATH.rename(backup)
        print(f"Old-format index moved to {backup}; starting fresh.", file=sys.stderr)
        return {}
    entries = {}
    for line in lines[1:]:
        parts = line.split("\t")
        if len(parts) == len(COLUMNS):
            entries[parts[0]] = dict(zip(COLUMNS, parts))
    return entries


def save_entry(row: dict) -> None:
    if not INDEX_PATH.exists():
        INDEX_PATH.write_text(HEADER + "\n")
    with INDEX_PATH.open("a") as f:
        f.write("\t".join(row[c] for c in COLUMNS) + "\n")


def remove_entry(session_id: str) -> None:
    if not INDEX_PATH.exists():
        return
    lines = INDEX_PATH.read_text().splitlines()
    filtered = [ln for ln in lines if ln.split("\t", 1)[0] != session_id]
    INDEX_PATH.write_text("\n".join(filtered) + "\n")


def iso_to_epoch(iso: str) -> float:
    try:
        return datetime.fromisoformat(iso).timestamp()
    except ValueError:
        return 0.0


if __name__ == "__main__":
    main(tyro.cli(Args, description=__doc__ + "\nTags: " + ", ".join(TAG_DESCRIPTIONS)))
