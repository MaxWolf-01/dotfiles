#!/usr/bin/env bash
# Apply the home-manager config for this host, then reload tmux's config.
# A script rather than a zsh alias, so agents' bash shells find it too.
set -euo pipefail
case ${1:-} in -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;; esac
# warn-dirty off: the checkout always carries someone's uncommitted work, so the warning says nothing.
home-manager switch --flake ~/.dotfiles#"${NIX_HOST:-$(hostname)}" --option accept-flake-config true --option warn-dirty false
tmux source ~/.config/tmux/tmux.conf
