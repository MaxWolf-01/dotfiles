#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["tyro>=1.0.14", "numpy", "opencv-python-headless>=5"]
# ///
"""Yoink a recorded talk from YouTube: its transcript with the slides in it, notes, and a report.

The talk lands in <output-dir>/<slug>/, the slug made from the video's title,
as a scribe folder (`scribe --help`): <slug>.md is the transcript with each
slide where it appeared, analysis.md the notes and statistics, report.html both
with the audio.
yoink-talk adds:

- slides/: one JPEG per slide, named <slug>-<number>-<time it appeared>.jpg, so
  a wikilink to one is unique across the vault
- figures.json: every appearance of a slide in order, which scribe places

A slide is a stretch of at least two seconds in which the picture holds still.
A camera inset that keeps moving beside the slide throughout the talk, as
conference recordings carry, is found and ignored, and so is a moving cursor.
A slide that is built up in steps, animates or has a line highlighted is saved
once, finished, at the time it first appeared. A slide shown again later is
referenced again, not saved twice. Video playing inside a slide, a blank
screen and camera footage of people, the speaker filling the frame or a
podcast's hosts, give no slide; a portrait on a slide does. Faces are found
with OpenCV's YuNet model, which the first run downloads into ~/.cache.
With --no-slides only the audio is downloaded, for a talk whose picture adds
nothing.

ElevenLabs Scribe transcribes, through `with-secrets elevenlabs scribe run`,
which charges by the hour of audio; scribe.log records what each run cost.
The downloaded audio is deleted once scribe has made audio.opus from it.
A second run skips each step that already has its output, a download included;
on a folder with notes it only renders the folder again.

YouTube refuses some VPN addresses. When the download fails here, it is
retried on pc, which leaves through the home connection, and copied back.

Examples:

    yoink-talk https://www.youtube.com/watch?v=-9IUXzQN_Sc
    yoink-talk https://youtu.be/-9IUXzQN_Sc --names "Jeff Clune" --keyterms MAP-Elites POET
    yoink-talk https://youtu.be/-9IUXzQN_Sc --via pc --keep-video
    yoink-talk https://youtu.be/ZAzWPE9CItg --no-slides
"""

import hashlib
import json
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Annotated, Literal

import cv2
import numpy as np
import tyro

LIBRARY = Path.home() / "Documents" / "library"
SCRIBE = Path(__file__).resolve().parent / "scribe"
REMOTE_HOST = "pc"
VIDEO_FORMAT = "bv*[height<=1080][vcodec^=avc1]/bv*[height<=1080]"
"""H.264 first: it decodes several times faster than AV1 or VP9 at the same size."""
AUDIO_FORMAT = "ba[ext=m4a]/ba"


@dataclass
class Args:
    url: Annotated[str, tyro.conf.Positional]
    """The talk's YouTube URL."""
    output_dir: Path = LIBRARY
    """Parent directory. The talk lands in <output-dir>/<slug>/."""
    name: str = ""
    """Directory and file name to use instead of the slug of the video's title."""
    names: list[str] = field(default_factory=list)
    """People likely speaking, spelled right; passed to `scribe run --names`."""
    keyterms: list[str] = field(default_factory=list)
    """Words the transcription should expect; passed to `scribe run --keyterms`, which then costs 20% more."""
    yes: bool = False
    """Accept Claude's speaker names without asking; passed to `scribe run --yes`."""
    via: Literal["auto", "here", "pc"] = "auto"
    """Where to download from. auto tries here, then pc."""
    keep_video: bool = False
    """Keep the downloaded video in cache/ once the slides are out of it."""
    slides: bool = True
    """Find the slides in the video. --no-slides skips the video and transcribes the audio alone."""


def main() -> None:
    args = tyro.cli(Args, description=__doc__)
    meta, where = video_meta(args.url, args.via)
    folder = args.output_dir.expanduser() / (args.name or slug(meta["title"]))
    claim(folder, meta)
    say(f"{meta['title']} ({hms(meta['duration'])}) -> {folder}")

    figures = folder / "figures.json"
    if args.slides and not figures.exists():
        video = cached(folder / "cache", "video")
        if not video:
            say("downloading the video")
            video = download(meta, VIDEO_FORMAT, folder / "cache", "video", where)
        say("finding the slides")
        write_slides(video, find_slides(video), folder)
        if not args.keep_video:
            video.unlink()
    if figures.exists():
        shown = json.loads(figures.read_text())
        say(f"{len(shown)} slides shown, {len({s['file'] for s in shown})} distinct")

    if (folder / "analysis.json").exists():
        run([str(SCRIBE), "render", str(folder)], "rendering the folder")
        print(folder)
        return
    audio = cached(folder / "cache", "audio")
    if not audio:
        say("downloading the audio")
        audio = download(meta, AUDIO_FORMAT, folder / "cache", "audio", where)
    up = meta["upload_date"]
    scribe = ["with-secrets", "elevenlabs", str(SCRIBE), "run", str(audio), "--out", str(folder), "--no-copy-recording",
              "--url", meta["webpage_url"], "--date", f"{up[:4]}-{up[4:6]}-{up[6:]}"]
    scribe += [*(["--names", *args.names] if args.names else []), *(["--keyterms", *args.keyterms] if args.keyterms else [])]
    scribe += ["--yes"] if args.yes else []
    if subprocess.run(scribe, stdout=subprocess.DEVNULL).returncode:
        die(f"scribe failed; its message is above, and {folder / 'scribe.log'} has the details. "
            "Run yoink-talk again once it is fixed: the slides and the audio are kept, and a transcription scribe received is cached.")
    audio.unlink()
    print(folder)


# ---------------------------------------------------------------- the video


def video_meta(url: str, via: str) -> tuple[dict, str]:
    """The video's title, upload date, duration, channel and canonical URL, and the host YouTube
    answered on: here, unless via says pc or YouTube refuses this machine."""
    cmd = ["yt-dlp", "-J", "--no-warnings", url]
    if via != "pc":
        r = subprocess.run(cmd, capture_output=True, text=True)
        if r.returncode == 0:
            return pick_meta(r.stdout), "here"
        why = r.stderr.strip().splitlines()[-1] if r.stderr.strip() else f"yt-dlp exited {r.returncode}"
        if via == "here":
            die(f"reading the video's details failed: {why}")
        say(f"YouTube refused this machine ({why}); downloading on {REMOTE_HOST}")
    return pick_meta(run(["ssh", REMOTE_HOST, shlex.join(cmd)], f"reading the video's details on {REMOTE_HOST}")), REMOTE_HOST


def pick_meta(info: str) -> dict:
    data = json.loads(info)
    return {k: data.get(k) or "" for k in ("id", "title", "upload_date", "duration", "channel", "webpage_url")}


def claim(folder: Path, meta: dict) -> None:
    """The folder belongs to this video from now on; one holding another video is refused."""
    record = folder / "cache" / "talk.json"
    if record.exists():
        other = json.loads(record.read_text())
        if other["id"] != meta["id"]:
            die(f"{folder} holds another talk, {other['webpage_url']}. Pick another --name.")
    elif folder.exists() and any(folder.iterdir()):
        die(f"{folder} exists and is not a yoink-talk folder. Pick another --name.")
    record.parent.mkdir(parents=True, exist_ok=True)
    record.write_text(json.dumps(meta, ensure_ascii=False, indent=1))


def cached(into: Path, stem: str) -> Path | None:
    """The stream an earlier run downloaded as into/stem.<ext>; an interrupted download does not count."""
    return next((p for p in into.glob(f"{stem}.*") if p.suffix not in (".part", ".ytdl")), None)


def download(meta: dict, fmt: str, into: Path, stem: str, where: str) -> Path:
    """One stream of the video, saved as into/stem.<ext>; downloaded on `where` and copied here."""
    into.mkdir(parents=True, exist_ok=True)
    cmd = ["yt-dlp", "-q", "--no-warnings", "--no-simulate", "--print", "after_move:filepath", "-f", fmt]
    if where == "here":
        out = run([*cmd, "-o", f"{into / stem}.%(ext)s", meta["webpage_url"]], f"downloading {fmt}")
        return Path(out.strip().splitlines()[-1])
    remote_dir = f"/var/tmp/yoink-talk-{meta['id']}"
    out = run(["ssh", where, shlex.join([*cmd, "-o", f"{remote_dir}/{stem}.%(ext)s", meta["webpage_url"]])],
              f"downloading {fmt} on {where}")
    remote = out.strip().splitlines()[-1]
    local = into / Path(remote).name
    part = local.with_name(local.name + ".part")
    run(["scp", "-q", f"{where}:{remote}", str(part)], f"copying {local.name} from {where}")
    part.replace(local)
    run(["ssh", where, shlex.join(["rm", "-r", remote_dir])], f"removing {remote_dir} on {where}")
    return local


# ---------------------------------------------------------------- slides

FPS = 2
"""Frames a second compared; a slide shown for less than HOLD frames of these is missed."""
WIDTH = 320
"""Frames are compared at this width, which keeps a cursor to a few pixels."""
CELL = 10
"""Pixels per side of the squares the inset is located by."""
NOISE = 20
"""A pixel has changed when its grey level moves by more than this; less is compression noise."""
STILL = 0.002
"""A frame holds still when less than this share of the pixels outside the inset changed."""
HOLD = 4
"""Frames a picture must hold still to count as a slide."""
SAME = 0.01
"""Two pictures are the same slide when less than this share of their pixels differ."""
INK = 20
"""A pixel is ink (text, lines, the edge of a shape) when the grey levels around it spread this much."""
BLANK = 0.002
"""A picture with less than this share of ink, a black or white screen, is no slide."""
LOST = 0.25
"""A picture continues the slide before it when less than this share of that slide's ink changed:
an animation step, a highlight or a build. A new slide replaces most of the ink."""
INSET = 0.03
"""A square belongs to the inset when it changes in more than this share of the frames in which only a few squares change."""
SPREAD = (10, 4)
"""The talk is cut into the first number of parts; an inset square is busy in at least the second number of them,
which tells the inset, there all along, from an animation that plays on one slide."""
FACE = 0.15
"""A face at least this share of the frame's height can make a frame camera footage; a speaker's inset shows a smaller one."""
FLAT = 0.6
"""Around a filmed person less than this share of the picture is flat; around a portrait on a slide, more."""
FACE_EVERY = 4
"""Frames between two looked at for faces; those between take the verdict of the nearer one."""
CUT = 0.3
"""A frame in which more than this share of the pixels changed starts a new shot."""
FACE_MODEL = Path.home() / ".cache" / "yoink-talk" / "face_detection_yunet_2023mar.onnx"
FACE_MODEL_URL = ("https://github.com/opencv/opencv_zoo/raw/f12e12798e8314f7c074a6656816c048dcc95b7a"
                  "/models/face_detection_yunet/face_detection_yunet_2023mar.onnx")
FACE_MODEL_SHA256 = "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4"


def find_slides(video: Path) -> list[dict]:
    """Every appearance of a slide: when it appeared (s), the time of the frame that shows it whole
    (frame_s), and for a slide shown before, the index of its first appearance (again)."""
    frames = decode(video)
    cv2.utils.logging.setLogLevel(cv2.utils.logging.LOG_LEVEL_ERROR)  # else every run warns about a backend it does not use
    faces = cv2.FaceDetectorYN.create(str(face_model()), "", (2 * frames.shape[2], 2 * frames.shape[1]), 0.6)
    keep = ~inset_mask(frames, footage_shots(frames, faces))
    if not keep.any():
        return []
    area = keep.sum()

    def share(a: np.ndarray, b: np.ndarray) -> float:
        return float(((np.abs(a.astype(np.int16) - b) > NOISE) & keep).sum() / area)

    moved = np.ones(len(frames))
    for i in range(1, len(frames)):
        moved[i] = share(frames[i], frames[i - 1])

    # a slide: a run of still frames; it appeared with the frame before the run, which changed
    runs, i = [], 0
    while i < len(frames):
        if moved[i] < STILL:
            j = i
            while j + 1 < len(frames) and moved[j + 1] < STILL:
                j += 1
            if j - i + 2 >= HOLD and (ink(frames[j]) & keep).sum() / area >= BLANK and not footage(frames[j], faces):
                runs.append([max(i - 1, 0), j])
            i = j + 1
        else:
            i += 1

    # a run broken only by something passing through, such as a cursor, is one slide;
    # so is a slide that animates, is highlighted or built up in steps
    content = keep & ~chrome(np.stack([frames[r[1]] for r in runs])) if runs else keep
    slides: list[list[int]] = []  # when it appeared, and the last run of still frames that shows it
    for r in runs:
        if slides and (share(frames[slides[-1][2]], frames[r[1]]) < SAME or continues(frames[slides[-1][2]], frames[r[1]], content)):
            slides[-1][1:] = r
        else:
            slides.append([r[0], *r])

    shown: list[dict] = []
    for start, still_from, still_to in slides:
        # a slide that fades out slowly still holds still by the frame; the frame with the most ink shows it whole
        frame = max(np.linspace(still_from + 1, still_to, min(still_to - still_from, 16)).astype(int),
                    key=lambda i: (ink(frames[i]) & keep).sum())
        first = next((k for k, s in enumerate(shown) if s["again"] is None and share(frames[s["frame"]], frames[frame]) < SAME), None)
        shown.append({"s": start / FPS, "frame_s": frame / FPS, "frame": frame, "again": first})
    return shown


def decode(video: Path) -> np.ndarray:
    """Grey frames, FPS a second, WIDTH wide; the height is rounded to whole CELLs."""
    probe = run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
                 "-of", "csv=p=0", str(video)], "reading the video's size")
    w, h = map(int, probe.strip().split(","))
    height = max(CELL, round(WIDTH * h / w / CELL) * CELL)
    proc = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-threads", "4", "-i", str(video),
                           "-vf", f"fps={FPS},scale={WIDTH}:{height},format=gray", "-f", "rawvideo", "-"],
                          capture_output=True)
    if proc.returncode:
        die(f"decoding {video} failed (ffmpeg exited {proc.returncode}): {proc.stderr.decode()[-800:]}")
    return np.frombuffer(proc.stdout, np.uint8).reshape(-1, height, WIDTH)


def footage(frame: np.ndarray, faces: "cv2.FaceDetectorYN") -> bool:
    """The frame is camera footage of people, a podcast's or the speaker filling the frame: a face at
    least FACE of the frame's height, with texture around the person. A slide's portrait sits on a flat
    background, and so does a speaker's inset, whose face is smaller anyway."""
    h, w = frame.shape
    frame = np.ascontiguousarray(frame)
    _, found = faces.detect(cv2.cvtColor(cv2.resize(frame, (2 * w, 2 * h)), cv2.COLOR_GRAY2BGR))
    boxes = [] if found is None else found[:, :4] / 2
    if not any(fh >= FACE * h for _, _, _, fh in boxes):
        return False
    around = np.ones((h, w), bool)  # all but the people: each face, the shoulders beside it and the body below
    for x, y, fw, fh in boxes:
        around[max(int(y - fh / 2), 0):, max(int(x - fw), 0):max(int(x + 2 * fw), 0)] = False
    return bool(around.any()) and (local_std(frame, 2) < 1)[around].mean() < FLAT


def footage_shots(frames: np.ndarray, faces: "cv2.FaceDetectorYN") -> np.ndarray:
    """Which frames belong to camera footage: the shots, frames between two cuts, in most of whose
    frames looked at a person is filmed, so including those where the person looks down or away."""
    n = len(frames)
    looked = np.array([footage(frames[i], faces) for i in range(0, n, FACE_EVERY)])
    camera = np.zeros(n, bool)
    cuts = [0, *(i for i in range(1, n) if (np.abs(frames[i].astype(np.int16) - frames[i - 1]) > NOISE).mean() > CUT), n]
    for a, b in zip(cuts, cuts[1:]):
        seen = looked[-(-a // FACE_EVERY):-(-b // FACE_EVERY)]
        if seen.size and seen.mean() >= 0.5:
            camera[a:b] = True
    return camera


def face_model() -> Path:
    """OpenCV's YuNet face detector, downloaded once into ~/.cache."""
    if not FACE_MODEL.exists():
        FACE_MODEL.parent.mkdir(parents=True, exist_ok=True)
        part = FACE_MODEL.with_name(FACE_MODEL.name + ".part")
        run(["curl", "-fsSL", "-o", str(part), FACE_MODEL_URL], "downloading the face detector")
        if hashlib.sha256(part.read_bytes()).hexdigest() != FACE_MODEL_SHA256:
            part.unlink()
            die(f"the face detector downloaded from {FACE_MODEL_URL} is not the expected file (its sha256 differs).")
        part.replace(FACE_MODEL)
    return FACE_MODEL


def inset_mask(frames: np.ndarray, ignore: np.ndarray) -> np.ndarray:
    """The pixels of a camera inset or anything else that keeps moving while the slide holds still.

    Found in squares of CELL pixels: those that change again and again in frames where only a
    few squares change, so that a new slide, which changes many, does not count, and do so
    throughout the talk, so that an animation on one slide does not count either. Frames marked
    in ignore, camera footage, are left out. Grown by one square on each side, to cover the inset's edge."""
    n, h, w = len(frames) - 1, frames.shape[1] // CELL, frames.shape[2] // CELL
    parts, busy_in = SPREAD
    hits, lone = np.zeros((parts, h, w)), np.zeros(parts)
    for i in range(n):
        if ignore[i] or ignore[i + 1]:
            continue
        d = np.abs(frames[i + 1].astype(np.int16) - frames[i]) > NOISE
        cells = d.reshape(h, CELL, w, CELL).mean((1, 3)) > 0.02
        if 1 <= cells.sum() <= 6:
            hits[i * parts // n] += cells
            lone[i * parts // n] += 1
    hot = (hits / np.maximum(lone, 1)[:, None, None] > INSET).sum(0) >= busy_in
    grown = hot.copy()
    grown[1:] |= hot[:-1]
    grown[:-1] |= hot[1:]
    hot = grown.copy()
    hot[:, 1:] |= grown[:, :-1]
    hot[:, :-1] |= grown[:, 1:]
    return np.kron(hot, np.ones((CELL, CELL), bool))


def chrome(pictures: np.ndarray) -> np.ndarray:
    """The ink that stays put on nearly every slide: a template's logos, frames and labels."""
    median = np.median(pictures, 0)
    return ink(median) & ((np.abs(pictures.astype(np.int16) - median) <= NOISE).mean(0) >= 0.9)


def continues(a: np.ndarray, b: np.ndarray, content: np.ndarray) -> bool:
    """b is a later state of slide a: less than LOST of a's ink in content changed."""
    mine = ink(a) & content
    return bool(mine.any()) and (np.abs(a.astype(np.int16) - b) > NOISE)[mine].mean() < LOST


def ink(a: np.ndarray) -> np.ndarray:
    return local_std(a) >= INK


def local_std(a: np.ndarray, r: int = 3) -> np.ndarray:
    """Each pixel's standard deviation over the square of side 2r+1 around it."""

    def mean(x: np.ndarray) -> np.ndarray:
        s = np.pad(np.pad(x, r, mode="edge").cumsum(0).cumsum(1), ((1, 0), (1, 0)))
        k = 2 * r + 1
        return (s[k:, k:] - s[:-k, k:] - s[k:, :-k] + s[:-k, :-k]) / (k * k)

    a = a.astype(np.float64)
    return np.sqrt(np.maximum(mean(a * a) - mean(a) ** 2, 0))


def write_slides(video: Path, shown: list[dict], folder: Path) -> None:
    """Each distinct slide as a full-size JPEG in slides/, and figures.json listing every
    appearance. A slide shown again points at the file saved the first time."""
    (folder / "slides").mkdir(parents=True, exist_ok=True)
    files: list[str] = []
    saved = 0
    for s in shown:
        if s["again"] is not None:
            files.append(files[s["again"]])
            continue
        saved += 1
        name = f"slides/{folder.name}-{saved:03}-{hms(s['s']).replace(':', '-')}.jpg"
        run(["ffmpeg", "-nostdin", "-v", "error", "-y", "-ss", f"{s['frame_s']:.2f}", "-i", str(video), "-frames:v", "1", "-q:v", "2",
             str(folder / name)], f"saving slide {name}")
        files.append(name)
    index = [{"s": s["s"], "file": f} for s, f in zip(shown, files)]
    (folder / "figures.json").write_text(json.dumps(index, indent=1))


# ---------------------------------------------------------------- helpers


def run(cmd: list[str], what: str) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        die(f"{what} failed: {cmd[0]} is not on PATH.")
    if r.returncode:
        die(f"{what} failed ({cmd[0]} exited {r.returncode}): {r.stderr.strip()[-800:]}")
    return r.stdout


def say(text: str) -> None:
    print(text, file=sys.stderr, flush=True)


def die(text: str):
    sys.exit(f"yoink-talk: {text}")


def hms(t: float) -> str:
    """Seconds as m:ss or h:mm:ss, rounded down as a player's clock is."""
    t = int(t)
    h, m, s = t // 3600, t % 3600 // 60, t % 60
    return f"{h}:{m:02}:{s:02}" if h else f"{m}:{s:02}"


def slug(text: str) -> str:
    return "-".join(re.sub(r"[^a-z0-9]+", " ", text.lower()).split()) or "talk"


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        die("interrupted; a second run picks up where this one stopped")
